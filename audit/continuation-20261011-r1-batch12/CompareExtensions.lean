open Lean Meta Elab Command

namespace HironakaCompare

/-- Read imported theorem bodies from module data; ordinary environment lookup may omit them. -/
def fullConstantInfo? (env : Environment) (c : Name) : Option ConstantInfo :=
  match env.getModuleIdxFor? c with
  | some idx => env.header.moduleData[idx.toNat]!.constants.find? (fun ci => ci.name == c)
  | none => env.find? c

structure RenameData where
  /-- ordered prefix rewrites of names (component-wise), from tools/names.py -/
  rules : Array (Name × Name)
  /-- original module -> library module (for private names `_private.<Module>.0.<decl>`) -/
  mods : Std.HashMap Name Name
  /-- Actual private constant copies in additive fragments with different module names. -/
  consts : Std.HashMap Name Name := {}

def loadData (rulesFile modsFile : String) : IO RenameData := do
  let mut rules : Array (Name × Name) := #[]
  for l in ← IO.FS.lines rulesFile do
    match l.splitOn "\t" with
    | [a, b] => rules := rules.push (a.toName, b.toName)
    | _ => pure ()
  let mut mods : Std.HashMap Name Name := {}
  for l in ← IO.FS.lines modsFile do
    match l.splitOn "\t" with
    | [a, b] => mods := mods.insert a.toName b.toName
    | _ => pure ()
  return { rules, mods }

def renNs (d : RenameData) (n : Name) : Name := Id.run do
  for (a, b) in d.rules do
    if a.isPrefixOf n then return n.replacePrefix a b
  return n

/-- the rename of the extraction, including private names `_private.<Mod>.0.<decl>` -/
def renBase (d : RenameData) (n : Name) : Name :=
  if (`_private).isPrefixOf n then
    let cs := n.components
    let rec go : List Name → List Name → Name
      | _, [] => n
      | acc, c :: rest =>
        if c == .num .anonymous 0 || c == Name.mkSimple "0" then
          let modN := (acc.reverse.drop 1).foldl (· ++ ·) .anonymous
          let restN := rest.foldl (· ++ ·) .anonymous
          (`_private ++ (d.mods.getD modN modN)) ++ (Name.num .anonymous 0) ++ renNs d restN
        else go (c :: acc) rest
    go [] cs
  else renNs d n

def ren (d : RenameData) (n : Name) : Name :=
  d.consts.getD n (renBase d n)

partial def renExpr (d : RenameData) (e : Expr) : Expr :=
  e.replace fun
    | .const c us => some (.const (ren d c) us)
    | .proj s i b => some (.proj (ren d s) i (renExpr d b))
    | _ => none

/-- decode an expression that builds a `Name` from literals (`Name.mkStr*`, `Name.str`, `Name.num`, `Name.anonymous`) -/
partial def decodeName? (e : Expr) : Option Name :=
  let f := e.getAppFn
  let args := e.getAppArgs
  match f with
  | .const c _ =>
    if c == ``Lean.Name.anonymous && args.isEmpty then some .anonymous
    else if (c == ``Lean.Name.str || c == ``Lean.Name.mkStr) && args.size == 2 then
      match args[1]! with
      | .lit (.strVal s) => (decodeName? args[0]!).map (·.str s)
      | _ => none
    else if (c == ``Lean.Name.num || c == ``Lean.Name.mkNum) && args.size == 2 then
      match args[1]! with
      | .lit (.natVal k) => (decodeName? args[0]!).map (·.num k)
      | _ => none
    else if c.getPrefix == ``Lean.Name && (c.toString.startsWith "Lean.Name.mkStr") && !args.isEmpty then
      args.foldlM (init := Name.anonymous) fun acc a =>
        match a with
        | .lit (.strVal s) => some (acc.str s)
        | _ => none
    else none
  | _ => none

/-- the rename applied to a name literal (also `_private.<prefix>` without a module separator) -/
def litRen (d : RenameData) (n : Name) : Name :=
  if (`_private).isPrefixOf n && !(n.components.contains (.num .anonymous 0)) then
    `_private ++ renNs d (n.replacePrefix `_private .anonymous)
  else ren d n

/-- replace every name literal by a marker constant carrying `f` of the name -/
def normNames (f : Name → Name) (e : Expr) : Expr :=
  e.replace fun s => (decodeName? s).map fun n => .const (`__nameLit ++ f n) []

/-- erase the numbering of auxiliary proofs `foo._proof_N` (re-elaboration may number them differently) -/
def eraseProofNums (e : Expr) : Expr :=
  e.replace fun
    | .const c us =>
      match c with
      | .str p s => if s.startsWith "_proof_" then some (.const (p.str "_proof") us) else none
      | _ => none
    | _ => none

def proofEq (d : RenameData) (env : Environment) (c : Name) : Bool :=
  match fullConstantInfo? env c, fullConstantInfo? env (ren d c) with
  | some (.thmInfo x), some (.thmInfo y) => renExpr d x.value == y.value
  | _, _ => false

/-- compare one constant with its renamed copy; `none` if equal -/
def cmp1 (d : RenameData) (env : Environment) (c c' : Name) : Option String :=
  match fullConstantInfo? env c, fullConstantInfo? env c' with
  | none, _ => some s!"original missing {c}"
  | _, none => some s!"MISSING copy {c'} of {c}"
  | some a, some b =>
    if a.levelParams.length != b.levelParams.length then some s!"LEVELS {c}" else
    if !(renExpr d a.type == b.type) then some s!"TYPE DIFFERS {c}" else
    match a, b with
    | .defnInfo x, .defnInfo y => if renExpr d x.value == y.value then none else some s!"VALUE DIFFERS (def) {c}"
    | .thmInfo _, .thmInfo _ => none
    | .inductInfo x, .inductInfo y =>
        if x.ctors.map (ren d) == y.ctors && x.numParams == y.numParams && x.numIndices == y.numIndices then none
        else some s!"INDUCTIVE DIFFERS {c}"
    | .ctorInfo _, .ctorInfo _ => none
    | .recInfo _, .recInfo _ => none
    | .opaqueInfo x, .opaqueInfo y => if renExpr d x.value == y.value then none else some s!"VALUE DIFFERS (opaque) {c}"
    | .axiomInfo _, .axiomInfo _ => some s!"AXIOM {c}"
    | .quotInfo _, .quotInfo _ => none
    | _, _ => some s!"KIND DIFFERS {c}"

def isRealizable (c : Name) : Bool :=
  match c with
  | .str _ s => s == "eq_def" || s == "congr_simp" || s == "splitter" || s == "eq_unfold" || s == "injEq" || s == "inj"
                || s == "sizeOf_spec" || s == "noConfusion" || s == "noConfusionType" || s.startsWith "eq_"
  | _ => false

def defeqCheck (d : RenameData) (c c' : Name) : CommandElabM Bool := do
  let env ← getEnv
  match fullConstantInfo? env c, fullConstantInfo? env c' with
  | some a, some b =>
    liftTermElabM do
      let ty ← Meta.isDefEq (renExpr d a.type) b.type
      if !ty then return false
      match a, b with
      | .defnInfo x, .defnInfo y => Meta.isDefEq (renExpr d x.value) y.value
      | _, _ => return true
  | _, _ => return false

def run (rulesFile modsFile closureFile apiFile outFile : String) : CommandElabM Unit := do
  let d ← loadData rulesFile modsFile
  let env ← getEnv
  let mut ok : Nat := 0
  let mut defeq : Array String := #[]
  let mut bad : Array String := #[]
  let mut realizable : Nat := 0
  let mut skipped : Nat := 0
  let mut seenCopies : NameSet := {}
  let mut thms : Nat := 0
  let mut sameProof : Nat := 0
  for l in ← IO.FS.lines closureFile do
    let c := (l.splitOn "\t").head!.toName
    if c.isAnonymous then continue
    let user := (privateToUserName? c).getD c
    if user.isInternalDetail then skipped := skipped + 1; continue
    let c' := ren d c
    seenCopies := seenCopies.insert c'
    if (fullConstantInfo? env c).any (·.isTheorem) then
      thms := thms + 1
      if proofEq d env c then sameProof := sameProof + 1
    match cmp1 d env c c' with
    | none => ok := ok + 1
    | some msg =>
      if msg.startsWith "MISSING" && isRealizable user then realizable := realizable + 1; continue
      if msg.startsWith "MISSING" then bad := bad.push msg; continue
      let auxOnly := match fullConstantInfo? env c, fullConstantInfo? env c' with
        | some (.defnInfo x), some (.defnInfo y) =>
            renExpr d x.type == y.type && eraseProofNums (renExpr d x.value) == eraseProofNums y.value
        | _, _ => false
      let de ← (try defeqCheck d c c' catch _ => pure false)
      if de then defeq := defeq.push (if auxOnly then msg ++ " [equal up to the numbering of `_proof_N` auxiliaries]" else msg)
      else bad := bad.push msg
  -- the public theorems
  let mut pubOk : Nat := 0
  let mut pubN : Nat := 0
  let mut pubBad : Array String := #[]
  for l in ← IO.FS.lines apiFile do
    let c := (l.splitOn "\t").head!.toName
    if c.isAnonymous then continue
    pubN := pubN + 1
    match cmp1 d env c (ren d c) with
    | none => pubOk := pubOk + 1
    | some m => pubBad := pubBad.push m
  -- the other direction: every declaration of the library has an original with the same statement
  let mut inv : Std.HashMap Name Name := {}
  for i in [0:env.header.moduleNames.size] do
    let m := env.header.moduleNames[i]!
    unless (`TranscendentalNakamaye).isPrefixOf m do continue
    for c in env.header.moduleData[i]!.constNames do
      inv := inv.insert (ren d c) c
  let mut extra : Nat := 0
  let mut extraOk : Nat := 0
  let mut extraBad : Array String := #[]
  let mut litOnly : Array String := #[]
  let mut libConsts : Nat := 0
  for i in [0:env.header.moduleNames.size] do
    let m := env.header.moduleNames[i]!
    unless (`Hironaka).isPrefixOf m do continue
    for c' in env.header.moduleData[i]!.constNames do
      let user := (privateToUserName? c').getD c'
      if user.isInternalDetail then continue
      libConsts := libConsts + 1
      if seenCopies.contains c' then continue
      extra := extra + 1
      match inv.get? c' with
      | some c =>
        match cmp1 d env c c' with
        | none => extraOk := extraOk + 1
        | some msg =>
          let litEq := match fullConstantInfo? env c, fullConstantInfo? env c' with
            | some (.defnInfo x), some (.defnInfo y) =>
                renExpr d x.type == y.type && normNames (litRen d) (renExpr d x.value) == normNames id y.value
            | _, _ => false
          if litEq then extraOk := extraOk + 1; litOnly := litOnly.push msg
          else if (← (try defeqCheck d c c' catch _ => pure false)) then extraOk := extraOk + 1
          else extraBad := extraBad.push msg
      | none => extraBad := extraBad.push s!"NO ORIGINAL {c'}"
  let summary := s!"compared {ok + defeq.size + bad.size} closure constants: {ok} syntactically equal, {defeq.size} equal only up to definitional unfolding, {bad.size} problems; {realizable} lazily realized auxiliaries absent; {skipped} internal auxiliaries skipped; theorems with identical proof terms {sameProof}/{thms}; public theorems with equal statements {pubOk}/{pubN}; library declarations {libConsts}, of which {extra} outside the closure list: {extraOk} equal to their original ({litOnly.size} of them only after renaming the name literals of the generator), {extraBad.size} without an equal original"
  logInfo m!"{summary}"
  logInfo m!"DEFEQ-ONLY:\n{String.intercalate "\n" defeq.toList}"
  logInfo m!"PROBLEMS:\n{String.intercalate "\n" (bad.toList.take 100)}"
  logInfo m!"PUBLIC PROBLEMS:\n{String.intercalate "\n" pubBad.toList}"
  logInfo m!"EQUAL ONLY AFTER RENAMING NAME LITERALS:\n{String.intercalate "\n" litOnly.toList}"
  logInfo m!"EXTRA PROBLEMS:\n{String.intercalate "\n" (extraBad.toList.take 100)}"
  let num (k : String) (v : Nat) : String × Json := (k, toJson v)
  let js := Json.mkObj [num "syntactic" ok, num "defeq_only" defeq.size, num "problems" bad.size,
    num "realizable_absent" realizable, num "internal_skipped" skipped, num "theorems" thms,
    num "identical_proofs" sameProof, num "public" pubN, num "public_equal" pubOk,
    num "library_declarations" libConsts, num "extra" extra, num "extra_equal" extraOk,
    num "extra_problems" extraBad.size, ("literal_only", toJson litOnly),
    ("defeq_list", toJson defeq), ("problem_list", toJson (bad.toList.take 200)), ("public_problems", toJson pubBad),
    ("extra_problem_list", toJson (extraBad.toList.take 200)), ("summary", toJson summary)]
  IO.FS.writeFile outFile js.pretty

end HironakaCompare

run_cmd do
  let mut d ← HironakaCompare.loadData "audit/continuation-20261011-r1-batch12/nsrules.tsv" "audit/continuation-20261011-r1-batch12/modmap.tsv"
  let env ← getEnv
  let mut copiesByUser : Std.HashMap Name Name := {}
  for i in [0:env.header.moduleNames.size] do
    unless (`Hironaka).isPrefixOf env.header.moduleNames[i]! do continue
    for c in env.header.moduleData[i]!.constNames do
      copiesByUser := copiesByUser.insert ((privateToUserName? c).getD c) c
  for i in [0:env.header.moduleNames.size] do
    unless (`TranscendentalNakamaye).isPrefixOf env.header.moduleNames[i]! do continue
    for c in env.header.moduleData[i]!.constNames do
      if let some user := privateToUserName? c then
        if (HironakaCompare.fullConstantInfo? env (HironakaCompare.renBase d c)).isSome then continue
        if let some copy := copiesByUser.get? (HironakaCompare.renNs d user) then
          d := { d with consts := d.consts.insert c copy }
  let modules : List Name := [`Hironaka.Resolution.HironakaRelativeNormalIdealMatrices, `Hironaka.Resolution.HironakaSmoothSubmersionDivisorExponents, `Hironaka.Resolution.HironakaNormalCrossingsOriginalExponents, `Hironaka.Invariant.MonomialAmbientDataExact, `Hironaka.Invariant.MemberNonContainedPullbackExact, `Hironaka.MarkedIdeal.ControlledProductTransformExact, `Hironaka.Invariant.MemberPrincipalPullbackExact, `Hironaka.Blowup.ControlledTransformZeroExact]
  let mut originals : Std.HashMap Name Name := {}
  for i in [0:env.header.moduleNames.size] do
    unless (`TranscendentalNakamaye).isPrefixOf env.header.moduleNames[i]! do continue
    for c in env.header.moduleData[i]!.constNames do
      originals := originals.insert (HironakaCompare.renBase d c) c
      originals := originals.insert (HironakaCompare.ren d c) c
  let mut total : Nat := 0
  let mut direct : Nat := 0
  let mut unfolded : Nat := 0
  let mut theoremN : Nat := 0
  let mut proofEqual : Nat := 0
  let mut bad : Array String := #[]
  for i in [0:env.header.moduleNames.size] do
    unless modules.contains env.header.moduleNames[i]! do continue
    for c' in env.header.moduleData[i]!.constNames do
      let user := (privateToUserName? c').getD c'
      if user.isInternalDetail then continue
      total := total + 1
      match originals.get? c' with
      | none => bad := bad.push s!"NO ORIGINAL {c'}"
      | some c =>
        let equal := HironakaCompare.cmp1 d env c c'
        match equal with
        | none => direct := direct + 1
        | some msg =>
          if ← HironakaCompare.defeqCheck d c c' then unfolded := unfolded + 1
          else bad := bad.push msg
        if (env.find? c).any (·.isTheorem) then
          theoremN := theoremN + 1
          if HironakaCompare.proofEq d env c then proofEqual := proofEqual + 1
        logInfo m!"{c'}: {if equal.isNone then "syntactically equal type/definition" else "checked up to definitional unfolding"}"
  logInfo m!"Extensions compared: {total}; syntactically equal: {direct}; definitional unfolding: {unfolded}; problems: {bad.size}; identical theorem proof terms: {proofEqual}/{theoremN}"
  let js := Json.mkObj [("compared", toJson total), ("syntactic", toJson direct), ("defeq", toJson unfolded), ("problems", toJson bad), ("theorems", toJson theoremN), ("identical_proofs", toJson proofEqual)]
  IO.FS.writeFile "audit/continuation-20261011-r1-batch12/faithfulness.json" js.pretty
  unless bad.isEmpty do throwError m!"comparison problems: {bad.toList}"
