      ideal :=
        Hironaka.RestrictedIdealExtension.sumIdeal (Hironaka.IdealWeightPowers.idealPow 𝔪₁.ideal 𝔪₂.d)
          (Hironaka.IdealWeightPowers.idealPow 𝔪₂.ideal 𝔪₁.d),
      d := 𝔪₁.d * 𝔪₂.d }
