import Hironaka.Resolution.HironakaActualCylinderVanishingIdealExtension
import Hironaka.Analytic.IdealSpanCalculus
import Hironaka.MarkedIdeal.InvertibleIdealQuotient

/-!
# Actual functional singular cylinder pullback at the origin

Finite functional spans, including infinite original generating families,
are identified with their whole literal holomorphic germ spans. Applying
this dictionary to the actual original composed-function family and the
proved whole product ideal equality gives the independently defined original
GermIdeal pullback membership, with no coherence or equality certificate.
Blueprint: `hironaka-actual-cylinder-pullback-origin-extension.tex`.
-/
set_option autoImplicit false
open Set Filter Classical
open scoped Topology Manifold ContDiff BigOperators
namespace Hironaka.HironakaActualCylinderPullbackOrigin
noncomputable section
open Hironaka.HolomorphicIdealSheaves HolGerm RelativePrincipalizationSpan
  InvertibleIdealQuotient HironakaRelativeNormalIdeal HironakaActualCylinderRelativeHadamard
  HironakaActualCylinderVanishingIdealExtension HironakaHolomorphicJetChartInvariance
variable {n : ℕ}

private theorem ordinaryHol {F : ComplexModel n → ℂ} (hF : HolomorphicAt n F 0) :
    ∀ᶠ z in 𝓝 (0 : ComplexModel n),DifferentiableAt ℂ F z :=
  hF.mono fun _ hz => mdifferentiableAt_iff_differentiableAt.mp hz

/-- The entire ideal generated by the literal original functions, without a finite-family certificate. -/
def actualFunctionGermSpan (S : (ComplexModel n → ℂ) → Prop)
    (hS : ∀ s,S s → HolomorphicAt n s 0) : Ideal (HolGerm (ComplexModel n)) :=
  Ideal.span {g | ∃ (s : ComplexModel n → ℂ) (hs : S s),g=HolGerm.mk s (ordinaryHol (hS s hs))}

/-- Actual finite holomorphic spans equal the WHOLE literal germ ideal, even for infinite generating families. -/
theorem isInSpanAt_zero_iff_mem_actual_germ_span
    (S : (ComplexModel n → ℂ) → Prop) (hS : ∀ s,S s → HolomorphicAt n s 0)
    (F : ComplexModel n → ℂ) (hF : ∀ᶠ z in 𝓝 (0 : ComplexModel n),DifferentiableAt ℂ F z) :
    IsInSpanAt (n := n) S 0 F ↔ HolGerm.mk F hF∈actualFunctionGermSpan S hS := by
  constructor
  · rintro ⟨_hF,N,s,a,hs,ha,he⟩
    let hs' := fun i : Fin N => ordinaryHol (hS (s i) (hs i))
    let ha' := fun i : Fin N => ordinaryHol (ha i)
    have hmul : ∀ i : Fin N,∀ᶠ z in 𝓝 (0 : ComplexModel n),DifferentiableAt ℂ (fun z => a i z*s i z) z :=
      fun i => (ha' i).and (hs' i) |>.mono fun _ hz => hz.1.mul hz.2
    have hsum : HolGerm.mk F hF=∑ i : Fin N,HolGerm.mk (a i) (ha' i)*HolGerm.mk (s i) (hs' i) := by
      calc
        _ = HolGerm.mk (fun z => ∑ i : Fin N,a i z*s i z)
            (eventually_differentiableAt_sum Finset.univ hmul) := HolGerm.mk_eq_mk_iff.mpr he
        _ = ∑ i : Fin N,HolGerm.mk (fun z => a i z*s i z) (hmul i) := HolGerm.mk_sum Finset.univ _ hmul
        _ = _ := Finset.sum_congr rfl fun i _ => HolGerm.mk_mul _ _ _ _
    rw [hsum]
    apply Ideal.sum_mem
    intro i _
    apply Ideal.mul_mem_left
    exact Ideal.subset_span ⟨s i,hs i,rfl⟩
  · intro hmem
    have hrep : ∃ (f : ComplexModel n → ℂ) (hf : ∀ᶠ z in 𝓝 (0 : ComplexModel n),DifferentiableAt ℂ f z),
        HolGerm.mk F hF=HolGerm.mk f hf ∧ IsInSpanAt (n := n) S 0 f := by
      apply Submodule.span_induction
        (p := fun g _ => ∃ (f : ComplexModel n → ℂ) (hf : ∀ᶠ z in 𝓝 (0 : ComplexModel n),DifferentiableAt ℂ f z),
          g=HolGerm.mk f hf ∧ IsInSpanAt (n := n) S 0 f) ?_ ?_ ?_ ?_ hmem
      · rintro _ ⟨s,hs,rfl⟩
        exact ⟨s,ordinaryHol (hS s hs),rfl,isInSpanAt_self hs (hS s hs)⟩
      · refine ⟨fun _ => 0,eventually_differentiableAt_zero,HolGerm.mk_zero.symm,?_⟩
        exact ⟨holomorphicAt_const 0,0,Fin.elim0,Fin.elim0,fun i => i.elim0,fun i => i.elim0,
          Eventually.of_forall fun _ => by simp⟩
      · intro g h _hg _hh hg hh
        obtain ⟨f,hf,rfl,hfS⟩ := hg
        obtain ⟨g,hg,rfl,hgS⟩ := hh
        exact ⟨fun z => f z+g z,eventually_differentiableAt_add hf hg,(HolGerm.mk_add _ _ _ _).symm,RelativePrincipalizationSpan.IsInSpanAt.add hfS hgS⟩
      · intro c g _hg hg
        obtain ⟨a,ha,rfl⟩ := HolGerm.exists_eq_mk c
        obtain ⟨f,hf,rfl,hfS⟩ := hg
        refine ⟨fun z => a z*f z,eventually_differentiableAt_mul ha hf,(HolGerm.mk_mul _ _ _ _).symm,?_⟩
        exact RelativePrincipalizationSpan.IsInSpanAt.mul_left (ha.mono fun _ hz => hz.mdifferentiableAt) hfS
    obtain ⟨f,hf,he,hspan⟩ := hrep
    exact InvertibleIdealQuotient.IsInSpanAt.congr' hspan ((HolGerm.mk_eq_mk_iff.mp he).symm)

/-- Literal original pullback functions, with original vanishing membership at the source point. -/
def actualPullbackFunctionFamily (k t : ℕ) (W : Set (ComplexModel k)) :
    (ComplexModel (k+t) → ℂ) → Prop :=
  fun f => ∃ a : ComplexModel k → ℂ,(vanishingIdeal (n := k) W).mem 0 a ∧ f=a∘tangentProjection k t

private theorem actual_pullback_functions_holomorphic (k t : ℕ) (W : Set (ComplexModel k)) :
    ∀ f,actualPullbackFunctionFamily k t W f → HolomorphicAt (k+t) f 0 := by
  rintro f ⟨a,ha,rfl⟩
  have hh : HolomorphicAt k a (tangentProjection k t 0) := by simpa only [map_zero] using ha.1
  exact hh.comp_contMDiff (Eventually.of_forall fun z => (tangentProjection k t).contDiff.contMDiff.contMDiffAt)

/-- ENTIRE composed-function germ span equals the actual original ideal extension, independently of coherence. -/
theorem actual_pullback_function_germ_span_eq (k t : ℕ) (W : Set (ComplexModel k)) :
    actualFunctionGermSpan (actualPullbackFunctionFamily k t W) (actual_pullback_functions_holomorphic k t W)=
      Ideal.map (tangentPullback k t).toRingHom (AnalyticGermDecomposition.vanishingIdeal W) := by
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro _ ⟨f,hf,rfl⟩
    obtain ⟨a,ha,rfl⟩ := hf
    have hg : HolGerm.mk a (ordinaryHol ha.1)∈AnalyticGermDecomposition.vanishingIdeal W :=
      AnalyticGermDecomposition.mem_vanishingIdeal_mk.mpr ha.2
    exact Ideal.mem_map_of_mem (tangentPullback k t).toRingHom hg
  · apply Ideal.map_le_iff_le_comap.mpr
    intro g hg
    obtain ⟨a,ha,rfl⟩ := HolGerm.exists_eq_mk g
    have hactual : (vanishingIdeal (n := k) W).mem 0 a :=
      ⟨ha.mono (fun _ hz => hz.mdifferentiableAt),AnalyticGermDecomposition.mem_vanishingIdeal_mk.mp hg⟩
    exact Ideal.subset_span ⟨a∘tangentProjection k t,⟨a,hactual,rfl⟩,rfl⟩

/-- The independently defined original functional pullback equals literal singular-product vanishing membership at the actual origin. -/
theorem pullback_vanishingIdeal_mem_zero_iff (k t : ℕ) (W : Set (ComplexModel k))
    (F : ComplexModel (k+t) → ℂ) :
    (GermIdeal.pullback (m := k+t) (tangentProjection k t) (vanishingIdeal (n := k) W)).mem 0 F ↔
      (vanishingIdeal (n := k+t) (cylinderCarrier k t W)).mem 0 F := by
  change IsInSpanAt (n := k+t)
    (fun f => ∃ a,(vanishingIdeal (n := k) W).mem (tangentProjection k t 0) a ∧ f=a∘tangentProjection k t) 0 F ↔ _
  rw [map_zero]
  change IsInSpanAt (n := k+t) (actualPullbackFunctionFamily k t W) 0 F ↔ _
  constructor
  · intro hF
    have hg := (isInSpanAt_zero_iff_mem_actual_germ_span _ (actual_pullback_functions_holomorphic k t W) F
      (ordinaryHol hF.1)).mp hF
    rw [actual_pullback_function_germ_span_eq,← cylinder_vanishingIdeal_eq_base_extension] at hg
    exact ⟨hF.1,AnalyticGermDecomposition.mem_vanishingIdeal_mk.mp hg⟩
  · intro hF
    apply (isInSpanAt_zero_iff_mem_actual_germ_span _ (actual_pullback_functions_holomorphic k t W) F
      (ordinaryHol hF.1)).mpr
    rw [actual_pullback_function_germ_span_eq,← cylinder_vanishingIdeal_eq_base_extension]
    exact AnalyticGermDecomposition.mem_vanishingIdeal_mk.mpr hF.2

end
end Hironaka.HironakaActualCylinderPullbackOrigin
