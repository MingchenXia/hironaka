import Hironaka.Resolution.HironakaActualTaylorFaithfullyFlat
import Mathlib.RingTheory.MvPowerSeries.Equiv
import Mathlib.RingTheory.AdicCompletion.AsTensorProduct

/-!
# Actual whole polynomial-to-holomorphic flatness and genuine analytic syzygies

Faithful target tensor descent, the actual polynomial variables-adic completion,
and the existing faithfully flat original Taylor map prove flatness of literal
polynomial evaluation in the ENTIRE actual original analytic germ ring. The
finite flatness relation criterion then internally expresses EVERY analytic
relation on polynomial functions by true whole polynomial syzygies and actual
analytic multipliers. No flatness, completion compatibility or relation-generation
certificate is an input of either original endpoint.

Blueprint: `hironaka-actual-polynomial-analytic-flatness-extension.tex`.
-/
set_option autoImplicit false
open Set Classical TensorProduct
open scoped BigOperators
namespace Hironaka.HironakaActualPolynomialAnalyticFlatness
noncomputable section

/-- Genuine tensor cancellation and faithful injectivity reflection descend flatness through a faithfully flat target. -/
theorem flat_of_faithfully_flat_target (P R S : Type*) [CommRing P] [CommRing R] [CommRing S]
    [Algebra P R] [Algebra P S] [Algebra R S] [IsScalarTower P R S]
    [Module.Flat P S] [Module.FaithfullyFlat R S] : Module.Flat P R := by
  rw [Module.Flat.iff_lTensor_injectiveₛ]
  intro M _ _ N
  rw [←AlgebraTensorModule.coe_lTensor (A := R)]
  apply (Module.FaithfullyFlat.lTensor_injective_iff_injective R S
    (AlgebraTensorModule.lTensor R R N.subtype)).mp
  have h := Module.Flat.lTensor_preserves_injective_linearMap (M := S) N.subtype Subtype.val_injective
  rw [←AlgebraTensorModule.coe_lTensor (A := S)] at h
  rw [←AlgebraTensorModule.coe_lTensor (A := S)]
  rw [←EquivLike.comp_injective _ (AlgebraTensorModule.cancelBaseChange P R S S M),
    ←LinearEquiv.coe_coe,←LinearMap.coe_comp,←AlgebraTensorModule.lTensor_comp_cancelBaseChange,
    LinearMap.coe_comp,LinearEquiv.coe_coe]
  exact h.comp (AlgebraTensorModule.cancelBaseChange P R S S N).injective



open HolGerm HironakaActualOriginalFormalTaylor
  HironakaActualOriginalTaylorPolynomial HironakaRelativeNormalMonomialBasis HironakaRelativeNormalIdeal
  HironakaActualTaylorFaithfullyFlat

private theorem originalTaylor_polynomial {n : ℕ} (p : MvPolynomial (Fin n) ℂ) :
    originalTaylorAlgHom n (originalPolynomialEval n p)=(p : MvPowerSeries (Fin n) ℂ) := by
  induction p using MvPolynomial.induction_on with
  | C c =>
      rw [originalPolynomialEval,MvPolynomial.aeval_C,MvPolynomial.coe_C]
      exact (originalTaylorAlgHom n).commutes c
  | add p q hp hq => simpa only [map_add,MvPolynomial.coe_add] using congrArg₂ (·+·) hp hq
  | mul_X p i hp =>
      simp only [map_mul,MvPolynomial.coe_mul,hp]
      rw [show originalPolynomialEval n (MvPolynomial.X i)=normalCoordinate 0 n i from MvPolynomial.aeval_X _ i,
        originalTaylorAlgHom_coordinate,MvPolynomial.coe_X]

private theorem polynomial_formal_flat (n : ℕ) :
    Module.Flat (MvPolynomial (Fin n) ℂ) (MvPowerSeries (Fin n) ℂ) := by
  have : Module.Flat (MvPolynomial (Fin n) ℂ)
      (AdicCompletion (MvPolynomial.idealOfVars (Fin n) ℂ) (MvPolynomial (Fin n) ℂ)) := inferInstance
  exact Module.Flat.of_linearEquiv (MvPowerSeries.toAdicCompletionAlgEquiv (Fin n) ℂ).toLinearEquiv

/-- The actual ENTIRE original polynomial evaluation is flat; the real polynomial completion and faithfully flat Taylor map supply the proof. -/
theorem originalPolynomialEval_flat (n : ℕ) : (originalPolynomialEval n).toRingHom.Flat := by
  let P := MvPolynomial (Fin n) ℂ
  let R := HolGerm (ComplexModel (0+n))
  let S := MvPowerSeries (Fin n) ℂ
  let : Algebra P R := (originalPolynomialEval n).toRingHom.toAlgebra
  let : Algebra R S := (originalTaylorAlgHom n).toRingHom.toAlgebra
  let : IsScalarTower P R S := IsScalarTower.of_algebraMap_eq fun p => by
    change (p : MvPowerSeries (Fin n) ℂ)=originalTaylorAlgHom n (originalPolynomialEval n p)
    exact (originalTaylor_polynomial p).symm
  let : Module.Flat P S := polynomial_formal_flat n
  let : Module.FaithfullyFlat R S := originalTaylorAlgHom_faithfullyFlat n
  change Module.Flat P R
  exact flat_of_faithfully_flat_target P R S

/-- EVERY true whole analytic relation on literal polynomial functions is generated by internally produced actual polynomial syzygies. -/
theorem actual_analytic_polynomial_relation_iff_polynomial_syzygies (n r : ℕ)
    (p : Fin r → MvPolynomial (Fin n) ℂ) (A : Fin r → HolGerm (ComplexModel (0+n))) :
    (∑ i,originalPolynomialEval n (p i)*A i)=0 ↔
      ∃ (k : ℕ) (c : Fin r → Fin k → MvPolynomial (Fin n) ℂ)
        (B : Fin k → HolGerm (ComplexModel (0+n))),
        (∀ i,A i=∑ j,originalPolynomialEval n (c i j)*B j) ∧
        ∀ j,∑ i,p i*c i j=0 := by
  let P := MvPolynomial (Fin n) ℂ
  let R := HolGerm (ComplexModel (0+n))
  let : Algebra P R := (originalPolynomialEval n).toRingHom.toAlgebra
  have : Module.Flat P R := originalPolynomialEval_flat n
  constructor
  · intro h
    have hs : (∑ i,p i • A i)=0 := by
      simpa only [Algebra.smul_def,RingHom.algebraMap_toAlgebra,
        AlgHom.toRingHom_eq_coe,AlgHom.coe_toRingHom] using h
    obtain ⟨k,c,B,hc,hp⟩ := (Module.Flat.iff_forall_isTrivialRelation (R := P) (M := R)).mp
      ‹Module.Flat P R› (f := p) (x := A) hs
    refine ⟨k,c,B,?_,hp⟩
    intro i
    simpa only [Algebra.smul_def,RingHom.algebraMap_toAlgebra,
      AlgHom.toRingHom_eq_coe,AlgHom.coe_toRingHom] using hc i
  · rintro ⟨k,c,B,hc,hp⟩
    have ht : Module.IsTrivialRelation p A := ⟨k,c,B,
      fun i => by simpa only [Algebra.smul_def,RingHom.algebraMap_toAlgebra,
        AlgHom.toRingHom_eq_coe,AlgHom.coe_toRingHom] using hc i,hp⟩
    simpa only [Algebra.smul_def,RingHom.algebraMap_toAlgebra,
      AlgHom.toRingHom_eq_coe,AlgHom.coe_toRingHom] using Module.sum_smul_eq_zero_of_isTrivialRelation ht

end
end Hironaka.HironakaActualPolynomialAnalyticFlatness
