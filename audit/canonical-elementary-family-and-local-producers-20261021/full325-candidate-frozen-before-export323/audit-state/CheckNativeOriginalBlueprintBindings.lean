import TranscendentalNakamaye.Pending.HironakaSmoothSubmersionOriginalGlobalIntrinsicUniqueness
import TranscendentalNakamaye.Pending.HironakaSmoothSubmersionOriginalGlobalFunctor
import Lean
open Lean
run_cmd do
  let env ← getEnv
  let folder := "/workspace/hironaka/audit/canonical-elementary-family-and-local-producers-20261021/"
  let input ← IO.FS.lines (folder ++ "native-blueprint-original-binding-pairs.tsv")
  let mut rows : Array Json := #[]
  let mut found : Nat := 0
  let mut missing : Nat := 0
  for line in input do
    let parts := line.splitOn "\t"
    unless parts.length == 2 do throwError "Malformed exact binding pair"
    let canonical := parts[0]!
    let original := parts[1]!
    let name := original.toName
    if env.contains name then
      let some owner := env.getModuleIdxFor? name | throwError "Bound original has no actual owner: {name}"
      let axioms ← collectAxioms name
      for a in axioms do
        unless #[``propext,``Classical.choice,``Quot.sound].contains a do
          throwError "Nonstandard actual original axiom {a} in binding {name}"
      rows := rows.push (Json.mkObj [("canonical_standalone_binding",toJson canonical),
        ("original_binding",toJson original),("status",toJson "ACTUAL_ORIGINAL_EXPORT_STANDARD_AXIOMS_ONLY"),
        ("actual_owner",toJson env.header.moduleNames[owner.toNat]!.toString),
        ("transitive_axioms",toJson (axioms.map Name.toString))])
      found := found+1
    else
      rows := rows.push (Json.mkObj [("canonical_standalone_binding",toJson canonical),
        ("original_binding",toJson original),("status",toJson "ABSENT_FROM_ALREADY_BUILT_NATIVE_IMPORT_CONE_NOT_INFERRED_FALSE_OR_VERIFIED")])
      missing := missing+1
  IO.FS.writeFile (folder ++ "native-blueprint-original-binding-inventory.json") (Json.pretty (Json.arr rows))
  logInfo m!"NATIVE_ORIGINAL_BLUEPRINT_BINDINGS {input.size} ACTUAL_STANDARD_ONLY {found} ABSENT_IN_CURRENT_CONE {missing}; no cold build or kernel replay"
