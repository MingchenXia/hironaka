    for ci in roots do
      ownCount := ownCount + 1
      ownNames := ownNames.insert ci.name
    logInfo m!"ACTUAL_NEW_MODULE {target}: {roots.size} compiled roots"
  let mut newBindings : Nat := 0
  let mut oldBindings : Nat := 0
  let mut missingBindings : Array Name := #[]
  for binding in bindings do
    if !(allNames.contains binding) then
      logInfo m!"MISSING_ACTUAL_BLUEPRINT_BINDING {binding}"
      missingBindings := missingBindings.push binding
    else if ownNames.contains binding then newBindings := newBindings + 1
    else oldBindings := oldBindings + 1
  unless missingBindings.isEmpty do throwError "Missing {missingBindings.size} actual compiled blueprint bindings"
  logInfo m!"STANDALONE_MODULES {targets.size}; NEW_ACTUAL_ROOTS {ownCount}; ALL_LIBRARY_ACTUAL_ROOTS {allCount}; EXACT_BINDINGS {bindings.size}; BINDINGS_IN_NEW_MODULES {newBindings}; BINDINGS_IN_PRECEDING_LIBRARY {oldBindings}; STANDARD_THREE_ONLY"
