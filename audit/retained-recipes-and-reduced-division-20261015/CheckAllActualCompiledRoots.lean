    `Hironaka.HironakaSmoothSubmersionOrderedGlobalTrace.holomorphicSquarePullback_open_comp,
    `Hironaka.HironakaSmoothSubmersionOrderedGlobalTrace.holomorphicSquarePullback_restrict,
    `Hironaka.HironakaSmoothSubmersionOrderedGlobalTrace.isSubmersionOfComplement_val_comp,
    `Hironaka.HironakaSmoothSubmersionOrderedGlobalTrace.isSubmersion_val,
    `Hironaka.HironakaSmoothSubmersionOrderedGlobalTrace.isSubmersion_val_comp,
    `Hironaka.HironakaSmoothSubmersionOrderedGlobalTrace.smoothTrace_globalize,
    `Hironaka.HironakaSmoothSubmersionOrderedGlobalTrace.smoothTrace_of_open_pullback,
    `Hironaka.HironakaSmoothSubmersionOrderedGlobalTrace.sourceImageMarked_whole_global
  ]
  let mut allCount : Nat := 0
  let mut newCount : Nat := 0
  let mut modules : Nat := 0
  let mut allNames : NameSet := {}
  for i in [0:env.header.moduleNames.size] do
    let m := env.header.moduleNames[i]!
    unless (`Hironaka).isPrefixOf m do continue
    modules := modules + 1
    let roots := env.header.moduleData[i]!.constants
    for ci in roots do
      allCount := allCount + 1
      allNames := allNames.insert ci.name
      for ax in (← collectAxioms ci.name) do
        unless #[``propext, ``Classical.choice, ``Quot.sound].contains ax do
          throwError "Nonstandard transitive axiom {ax} at {ci.name}"
  for target in targets do
    let some idx := env.header.moduleNames.findIdx? (· == target)
      | throwError "Missing actual new module {target}"
    let roots := env.header.moduleData[idx]!.constants
    newCount := newCount + roots.size
    logInfo m!"ACTUAL_NEW_MODULE {target}: {roots.size} compiled roots"
  let mut missing : Nat := 0
  for binding in bindings do
    unless allNames.contains binding do
      missing := missing + 1
      logInfo m!"MISSING_BINDING {binding}"
  logInfo m!"ALL_LIBRARY_MODULES {modules}; ALL_LIBRARY_ACTUAL_ROOTS {allCount}; NEW_MODULES {targets.size}; NEW_ACTUAL_ROOTS {newCount}; EXACT_BINDINGS {bindings.size}; MISSING {missing}; STANDARD_THREE_ONLY"
