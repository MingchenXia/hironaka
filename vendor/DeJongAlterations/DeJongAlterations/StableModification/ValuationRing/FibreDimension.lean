import DeJongAlterations.StableModification.Abhyankar
import Mathlib.RingTheory.Valuation.LocalSubring
import Mathlib.AlgebraicGeometry.ResidueField
import Mathlib.AlgebraicGeometry.Stalk
import Mathlib.AlgebraicGeometry.AffineScheme
import Mathlib.Topology.Inseparable

/-!
# Fibre dimension along specializations over a valuation ring

Let `V` be a valuation ring and `φ : X → S = Spec V` a morphism of schemes. For a point `x ∈ X`
over `s = φ(x)` write `trdeg_s(x) = trdeg (κ(x)/κ(s))`. For `X` locally of finite type over `S`
this is the dimension of the closure of `x` in the fibre `X_s` (Noether normalization; this
translation is not formalized here), so for a relative curve the generic points of the fibres
are the points with `trdeg_s(x) = 1` and the closed points of the fibres those with
`trdeg_s(x) = 0`. The
main result is the **dimension inequality**: if `x'` is a generization of `x`, then
`trdeg_s(x) ≤ trdeg_{s'}(x')`, `s' = φ(x')`. Consequently the set of points with
`trdeg_s(x) ≥ n` is stable under generization, the set with `trdeg_s(x) = 0` is stable under
specialization, and for a relative curve (all `trdeg_s(x) ≤ 1`) the set `(X/S)⁰` of points with
`trdeg_s(x) = 1` (the generic points of the fibres) is stable under generization.

This is Temkin, *Stable modification of relative curves*, J. Algebraic Geom. 19 (2010),
Lemma 3.5.3 (`genlem`, `semi-stable.tex` lines 2607–2622), in the case of a valuation ring base
used in §4.2 (lines 2872–2873, 2898 and 2916–2922). Temkin proves `genlem` for flat
finitely presented morphisms by noetherian approximation over `ℤ`, dimension theory of
universally catenary rings and going down. We replace this by a valuation-theoretic argument
which needs neither flatness nor finite presentation, only that the local rings of the base are
valuation rings: a valuation ring `W` of `κ(x')` dominating the image of `𝒪_{X,x}` meets
`κ(s')` in a valuation ring with residue field `κ(s)`, so by Abhyankar's inequality
(`relRatRank_add_trdeg_le`) `trdeg (κ(x)/κ(s)) ≤ trdeg (κ(W)/κ(s)) ≤ trdeg (κ(x')/κ(s'))`.
Blueprint chapter `sm-valuation-geometry.tex`, node `lem:sm-curve-fibre-generic`.

## Main definitions

* `fiberTrdeg f x`: the transcendence degree of `κ(x)` over `κ(f x)`.

## Main results

* `trdeg_residueField_le`: the dimension inequality for a local homomorphism `A → R` of local
  rings whose source maps onto a valuation ring of a field `K`, and a field `F ⊇ K` under `R`.
* `exists_eq_or_mul_eq_one`, `preValuationRing_of_isLocalization`: the image of a valuation ring
  in a field it generates by fractions is a valuation ring of that field; localizations of
  valuation rings are valuation rings.
* `exists_valuationSubring_dominates`: a valuation ring dominating the image of a local ring.
* `exists_mul_eq_of_specializes`: residue fields at generizations are generated by fractions.
* `fiberTrdeg_le_of_specializes`: the dimension inequality for schemes over a base whose local
  rings are valuation rings, e.g. `Spec V` (`preValuationRing_stalk_spec`).
* `stableUnderGeneralization_le_fiberTrdeg`, `stableUnderSpecialization_fiberTrdeg_eq_zero`,
  `stableUnderGeneralization_fiberTrdeg_eq_one` (Temkin's `genlem` for curves).
-/

noncomputable section

open IsLocalRing

universe u

namespace DeJongAlterations.StableModification.ValuationRing

section Algebra

/-- The image of a ring `A` in which divisibility is total (e.g. a valuation ring) under a ring
homomorphism `h : A → K` to a field, such that every element of `K` is a fraction of elements of
the image, is a valuation ring of `K`: every `y ∈ K` or its inverse lies in the image. -/
theorem exists_eq_or_mul_eq_one {A K : Type*} [CommRing A] [PreValuationRing A] [Field K]
    (h : A →+* K) (hfrac : ∀ y : K, ∃ a b : A, h b ≠ 0 ∧ y * h b = h a) (y : K) :
    (∃ a, h a = y) ∨ ∃ a, h a * y = 1 := by
  obtain ⟨a, b, hb, hy⟩ := hfrac y
  obtain ⟨c, hc | hc⟩ := PreValuationRing.cond a b
  · -- `b = a c`, so `y = 1 / h c`
    have hyb : y * (h a * h c) = h a := by rw [← map_mul, hc]; exact hy
    have ha : h a ≠ 0 := by
      intro ha
      apply hb
      rw [← hc, map_mul, ha, zero_mul]
    right
    refine ⟨c, ?_⟩
    apply mul_left_cancel₀ ha
    linear_combination hyb
  · -- `a = b c`, so `y = h c`
    left
    refine ⟨c, ?_⟩
    have hyb : y * h b = h b * h c := by rw [← map_mul, hc]; exact hy
    exact mul_left_cancel₀ hb (by linear_combination -hyb)

/-- A localization of a ring in which divisibility is total has total divisibility; in
particular localizations of valuation rings are valuation rings. -/
theorem preValuationRing_of_isLocalization {V L : Type*} [CommRing V] [PreValuationRing V]
    [CommRing L] [Algebra V L] (M : Submonoid V) [IsLocalization M L] : PreValuationRing L := by
  constructor
  intro x y
  obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective M x
  obtain ⟨⟨b, t⟩, rfl⟩ := IsLocalization.mk'_surjective M y
  have hmul : ∀ (a : V) (s : M) (c : V),
      IsLocalization.mk' L a s * algebraMap V L c = IsLocalization.mk' L (a * c) s := by
    intro a s c
    rw [IsLocalization.mk'_eq_mul_mk'_one, IsLocalization.mk'_eq_mul_mk'_one (a * c), map_mul]
    ring
  obtain ⟨c, hc | hc⟩ := PreValuationRing.cond (a * t) (b * s)
  · refine ⟨algebraMap V L c, Or.inl ?_⟩
    rw [hmul, IsLocalization.mk'_eq_iff_eq]
    congr 1
    linear_combination hc
  · refine ⟨algebraMap V L c, Or.inr ?_⟩
    rw [hmul, IsLocalization.mk'_eq_iff_eq]
    congr 1
    linear_combination hc

/-- A ring homomorphism `g` from a local ring `R` to a field `F` factors through a valuation ring
`W` of `F` dominating `R`: `g(R) ⊆ W` and `g(r)` is a nonunit of `W` iff `r` is a nonunit of `R`. -/
theorem exists_valuationSubring_dominates {R F : Type*} [CommRing R] [IsLocalRing R] [Field F]
    (g : R →+* F) :
    ∃ W : ValuationSubring F,
      (∀ r, W.valuation (g r) ≤ 1) ∧ ∀ r, W.valuation (g r) < 1 ↔ r ∈ maximalIdeal R := by
  obtain ⟨W, hW, hloc⟩ := IsLocalRing.exists_factor_valuationRing g
  refine ⟨W, fun r ↦ (W.valuation_le_one_iff _).mpr (hW r), fun r ↦ ?_⟩
  refine (ValuationSubring.valuation_lt_one_iff W ⟨g r, hW r⟩).symm.trans ?_
  change g.codRestrict W.toSubring hW r ∈ maximalIdeal W ↔ _
  exact ⟨fun h hu ↦ h (hu.map _), fun h hu ↦ h (hloc.map_nonunit r hu)⟩

variable {A K : Type*} [CommRing A] [IsLocalRing A] [Field K]
  {R F : Type u} [CommRing R] [IsLocalRing R] [Field F] [Algebra K F]

/-- **The dimension inequality over a valuation ring** (field form). Let `φ : A → R` be a local
homomorphism of local rings, `h : A → K` and `g : R → F` ring homomorphisms to fields with
`K ⊆ F` compatibly (`g ∘ φ = h` in `F`), and assume that the image of `A` in `K` is a valuation
ring of `K` (every element of `K` or its inverse is in the image). Then
`trdeg (κ(R)/κ(A)) ≤ trdeg (F/K)`. -/
theorem trdeg_residueField_le (φ : A →+* R) [IsLocalHom φ] (h : A →+* K) (g : R →+* F)
    (hcomm : ∀ a, algebraMap K F (h a) = g (φ a))
    (hval : ∀ y : K, (∃ a, h a = y) ∨ ∃ a, h a * y = 1) :
    letI := (ResidueField.map φ).toAlgebra
    Algebra.trdeg (ResidueField A) (ResidueField R) ≤ Algebra.trdeg K F := by
  let := (ResidueField.map φ).toAlgebra
  obtain ⟨W, hWle, hWlt⟩ := exists_valuationSubring_dominates g
  set v := W.valuation with hv
  set vK := v.comap (algebraMap K F) with hvK
  -- the valuation rings `O = v.valuationSubring ⊆ F` and `O₀ = O ∩ K`
  have hmemO₀ : ∀ y : K, y ∈ vK.valuationSubring ↔ v (algebraMap K F y) ≤ 1 := fun y ↦ by
    rw [Valuation.mem_valuationSubring_iff, hvK, Valuation.comap_apply]
  have hhO₀ : ∀ a, h a ∈ vK.valuationSubring := fun a ↦ by
    rw [hmemO₀, hcomm]
    exact hWle _
  have hgO : ∀ r, g r ∈ v.valuationSubring := fun r ↦ hWle r
  let h₀ : A →+* vK.valuationSubring := h.codRestrict _ hhO₀
  let g₀ : R →+* v.valuationSubring := g.codRestrict _ hgO
  have hunitO : ∀ (w : F) (hw : w ∈ v.valuationSubring),
      IsUnit (⟨w, hw⟩ : v.valuationSubring) ↔ v w = 1 := fun w hw ↦
    (Valuation.valuationSubring.integers v).isUnit_iff_valuation_eq_one
  have hunitO₀ : ∀ (y : K) (hy : y ∈ vK.valuationSubring),
      IsUnit (⟨y, hy⟩ : vK.valuationSubring) ↔ vK y = 1 := fun y hy ↦
    (Valuation.valuationSubring.integers vK).isUnit_iff_valuation_eq_one
  have hlocg : ∀ r, v (g r) = 1 → IsUnit r := by
    intro r hr
    by_contra hnu
    exact ((hWlt r).mpr ((mem_maximalIdeal r).mpr hnu)).ne hr
  have hloch : ∀ a, vK (h a) = 1 → IsUnit a := by
    intro a ha
    apply hlocg (φ a) _ |>.of_map
    rw [← hcomm]
    exact ha
  have : IsLocalHom g₀ := ⟨fun r hr ↦ hlocg r ((hunitO _ (hgO r)).mp hr)⟩
  have : IsLocalHom h₀ := ⟨fun a ha ↦ hloch a ((hunitO₀ _ (hhO₀ a)).mp ha)⟩
  let α : ResidueField A →+* ResidueField vK.valuationSubring := ResidueField.map h₀
  let β : ResidueField R →+* ResidueField v.valuationSubring := ResidueField.map g₀
  -- the residue field of `O₀` is the image of the residue field of `A`
  have hαsurj : Function.Surjective α := by
    intro z
    obtain ⟨⟨y, hy⟩, rfl⟩ := residue_surjective z
    rcases hval y with ⟨a, rfl⟩ | ⟨a, ha⟩
    · exact ⟨residue A a, rfl⟩
    · have hy0 : y ≠ 0 := by rintro rfl; simp at ha
      have hv1 : vK (h a) * vK y = 1 := by rw [← map_mul, ha, map_one]
      have hvy : vK y ≤ 1 := hy
      have hva : vK (h a) ≤ 1 := hhO₀ a
      have hva1 : vK (h a) = 1 := by
        by_contra hne
        have hlt : vK (h a) < 1 := lt_of_le_of_ne hva hne
        have := mul_lt_one_of_lt_of_le hlt hvy
        rw [hv1] at this
        exact lt_irrefl _ this
      obtain ⟨a', ha'⟩ := isUnit_iff_exists_inv.mp (hloch a hva1)
      refine ⟨residue A a', ?_⟩
      change residue _ (h₀ a') = _
      congr 1
      apply Subtype.ext
      change h a' = y
      calc h a' = h a' * (h a * y) := by rw [ha, mul_one]
        _ = h (a * a') * y := by rw [map_mul]; ring
        _ = y := by rw [ha', map_one, one_mul]
  -- compatibility of the residue field maps
  have hcomm' : (algebraMap (ResidueField vK.valuationSubring)
      (ResidueField v.valuationSubring)).comp α = β.comp (algebraMap (ResidueField A)
        (ResidueField R)) := by
    ext z
    obtain ⟨a, rfl⟩ := residue_surjective z
    change residue _ (algebraMap vK.valuationSubring v.valuationSubring (h₀ a)) =
      residue _ (g₀ (φ a))
    congr 1
    exact Subtype.ext (hcomm a)
  -- Abhyankar's inequality for `F/K` with the valuation `v`
  have hAbh : Algebra.trdeg (ResidueField vK.valuationSubring) (ResidueField v.valuationSubring) ≤
      Algebra.trdeg K F :=
    le_add_self.trans (relRatRank_add_trdeg_le vK v)
  refine ciSup_le' fun s ↦ ?_
  exact (s.2.ringHom_of_comp_eq α β hαsurj β.injective hcomm').cardinalMk_le_trdeg.trans hAbh

end Algebra

section Scheme

open AlgebraicGeometry CategoryTheory

variable {X S : Scheme.{u}} (f : X ⟶ S)

/-- The transcendence degree `trdeg (κ(x)/κ(f x))` of the residue field extension at `x`. For
`f` locally of finite type it is the dimension of the closure of `x` in the fibre over `f x`. -/
def fiberTrdeg (x : X) : Cardinal.{u} :=
  letI := (f.residueFieldMap x).hom.toAlgebra
  Algebra.trdeg (S.residueField (f x)) (X.residueField x)

/-- Every element of the residue field at a generization `t` of `s` is a fraction of images of
elements of the local ring at `s`. -/
theorem exists_mul_eq_of_specializes {t s : S} (hts : t ⤳ s) (y : S.residueField t) :
    ∃ a b : S.presheaf.stalk s,
      S.residue t (S.presheaf.stalkSpecializes hts b) ≠ 0 ∧
        y * S.residue t (S.presheaf.stalkSpecializes hts b) =
          S.residue t (S.presheaf.stalkSpecializes hts a) := by
  obtain ⟨_, ⟨U, hU, rfl⟩, hsU, -⟩ :=
    S.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ s) isOpen_univ
  have htU : t ∈ U := hts.mem_open U.2 hsU
  let : Algebra Γ(S, U) (S.presheaf.stalk t) := (S.presheaf.germ U t htU).hom.toAlgebra
  have := hU.isLocalization_stalk ⟨t, htU⟩
  obtain ⟨z, rfl⟩ := S.residue_surjective t y
  obtain ⟨⟨a, ⟨b, hb⟩⟩, rfl⟩ := IsLocalization.mk'_surjective
    (hU.primeIdealOf ⟨t, htU⟩).asIdeal.primeCompl z
  have hga : S.presheaf.stalkSpecializes hts (S.presheaf.germ U s hsU a) =
      algebraMap Γ(S, U) (S.presheaf.stalk t) a := by
    rw [TopCat.Presheaf.germ_stalkSpecializes_apply]
    rfl
  have hgb : S.presheaf.stalkSpecializes hts (S.presheaf.germ U s hsU b) =
      algebraMap Γ(S, U) (S.presheaf.stalk t) b := by
    rw [TopCat.Presheaf.germ_stalkSpecializes_apply]
    rfl
  refine ⟨S.presheaf.germ U s hsU a, S.presheaf.germ U s hsU b, ?_, ?_⟩
  · rw [hgb]
    have hu : IsUnit (algebraMap Γ(S, U) (S.presheaf.stalk t) b) :=
      IsLocalization.map_units _ (⟨b, hb⟩ : (hU.primeIdealOf ⟨t, htU⟩).asIdeal.primeCompl)
    exact (hu.map (S.residue t).hom).ne_zero
  · rw [hga, hgb, ← map_mul]
    congr 1
    exact IsLocalization.mk'_spec _ a ⟨b, hb⟩

/-- **The dimension inequality** (Temkin, Lemma 3.5.3 `genlem`, over a valuation ring). If the
local ring of `S` at `f x` is a valuation ring and `x'` is a generization of `x`, then
`trdeg (κ(x)/κ(f x)) ≤ trdeg (κ(x')/κ(f x'))`. -/
theorem fiberTrdeg_le_of_specializes {x' x : X} (hx : x' ⤳ x)
    [PreValuationRing (S.presheaf.stalk (f x))] :
    fiberTrdeg f x ≤ fiberTrdeg f x' := by
  have hfx : f x' ⤳ f x := hx.map f.continuous
  let := (f.residueFieldMap x').hom.toAlgebra
  let h : S.presheaf.stalk (f x) →+* S.residueField (f x') :=
    (S.residue (f x')).hom.comp (S.presheaf.stalkSpecializes hfx).hom
  let g : X.presheaf.stalk x →+* X.residueField x' :=
    (X.residue x').hom.comp (X.presheaf.stalkSpecializes hx).hom
  have hcomm : ∀ a, algebraMap (S.residueField (f x')) (X.residueField x') (h a) =
      g ((f.stalkMap x).hom a) := by
    intro a
    change (f.residueFieldMap x').hom ((S.residue (f x')).hom _) = _
    rw [← CommRingCat.comp_apply, Scheme.residue_residueFieldMap, CommRingCat.comp_apply]
    change (X.residue x').hom _ = (X.residue x').hom _
    congr 1
    exact Scheme.Hom.stalkSpecializes_stalkMap_apply f x' x hx a
  have hval := exists_eq_or_mul_eq_one h (fun y ↦ exists_mul_eq_of_specializes hfx y)
  exact trdeg_residueField_le (f.stalkMap x).hom h g hcomm hval

/-- The local rings of the spectrum of a valuation ring are valuation rings. -/
instance preValuationRing_stalk_spec (R : CommRingCat.{u}) [PreValuationRing R] (p : Spec R) :
    PreValuationRing ((Spec R).presheaf.stalk p) := by
  let : Algebra R ((Spec R).presheaf.stalk p) := StructureSheaf.stalkAlgebra R p
  exact @preValuationRing_of_isLocalization R _ _ _ _ _ _
    (StructureSheaf.IsLocalization.to_stalk R p)

/-- Over a base whose local rings are valuation rings, the set of points `x` with
`trdeg (κ(x)/κ(f x)) ≥ n` is stable under generization. -/
theorem stableUnderGeneralization_le_fiberTrdeg
    [∀ s : S, PreValuationRing (S.presheaf.stalk s)] (n : Cardinal.{u}) :
    StableUnderGeneralization {x : X | n ≤ fiberTrdeg f x} :=
  fun _ _ hyx hx ↦ le_trans hx (fiberTrdeg_le_of_specializes f hyx)

/-- Over a base whose local rings are valuation rings, the set of points that are algebraic over
the base point (closed points of their fibres, for `f` locally of finite type) is stable under
specialization. -/
theorem stableUnderSpecialization_fiberTrdeg_eq_zero
    [∀ s : S, PreValuationRing (S.presheaf.stalk s)] :
    StableUnderSpecialization {x : X | fiberTrdeg f x = 0} :=
  fun _ _ hxy hx ↦ le_antisymm ((fiberTrdeg_le_of_specializes f hxy).trans_eq hx) zero_le

/-- **Temkin, Lemma 3.5.3 (`genlem`), for relative curves over a valuation ring.** If every
residue field extension `κ(x)/κ(f x)` has transcendence degree at most one, the set `(X/S)⁰` of
points of transcendence degree one (the generic points of the fibres) is stable under
generization. -/
theorem stableUnderGeneralization_fiberTrdeg_eq_one
    [∀ s : S, PreValuationRing (S.presheaf.stalk s)] (hdim : ∀ x : X, fiberTrdeg f x ≤ 1) :
    StableUnderGeneralization {x : X | fiberTrdeg f x = 1} := by
  intro x y hyx hx
  exact le_antisymm (hdim y) (hx.symm.le.trans (fiberTrdeg_le_of_specializes f hyx))

end Scheme

end DeJongAlterations.StableModification.ValuationRing
