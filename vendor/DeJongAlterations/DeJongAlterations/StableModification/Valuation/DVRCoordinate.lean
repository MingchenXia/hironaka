import DeJongAlterations.StableModification.Valuation.Decompletion
import DeJongAlterations.StableModification.Valuation.InterfaceStatement
import DeJongAlterations.StableModification.Valuation.RankOneBridge
import Mathlib.FieldTheory.PurelyInseparable.Exponent
import Mathlib.FieldTheory.PurelyInseparable.PerfectClosure
import Mathlib.RingTheory.DiscreteValuationRing.Basic
import Mathlib.Topology.Algebra.Field

/-!
# The étale coordinate at a smooth point

This file formalizes the unbounded case of the proof of Theorem 2.1.8 (`valunif`) of M. Temkin,
*Stable modification of relative curves*, J. Algebraic Geom. 19 (2010), §2.2 (`semi-stable.tex`,
lines 2188–2196), together with the separability criterion for transcendence bases used in that
proof (lines 2204–2206). Plan `PLAN-SM-VAL.md`, node M1; blueprint `sm-val-uniformization-dec.tex`.

Temkin argues geometrically: if the valuation ring `K·O` is the local ring of a smooth closed
point of the normal projective model of `L/K`, a uniformizer `x` induces an étale map to the
affine line, and the composition criterion gives that `L/K(x)` is unramified. Here the hypothesis
is the algebraic form of the centre condition of the interface statement
(`UniformizationHypotheses`): `K·O` is a discrete valuation ring `D` containing `K` whose residue
field is `K`. The étale coordinate is then proved by decompletion: `K(x)` is dense in the
completion `L̂` of `L` (`exists_mem_adjoin_valuation_sub_le`, `denseRange_adjoin`), so the
decompletion criterion `Decompletion.exists_isStdUnramifiedGenerator_of_finrank_le` applies to
`L/K(x)` with `E = M = L̂`, and the composition criterion transports the generator to `O ⊆ D`.

## Main results

* `isSeparable_of_adjoin_pow_eq_top`: a finite extension `F'/F` of exponential characteristic
  `q` with `F' = F(F'^q)` is separable (the finite case of the converse of Mathlib's
  `IntermediateField.adjoin_eq_adjoin_pow_expChar_of_isSeparable'`).
* `isSeparable_adjoin_iff_notMem` (**Temkin, l. 2204–2206**): if `L/K` is finitely generated of
  characteristic `q > 0` and separable over `K(t)` for some transcendental `t`, then for `x`
  transcendental over `K`, `L/K(x)` is separable iff `x ∉ K Lᵠ`.
* `finiteDimensional_isSeparable_of_irreducible`: a uniformizer `x` of `D` is transcendental over
  `K`, and `L/K(x)` is finite and separable.
* `exists_isStdUnramifiedGenerator_dvr`, `isStdUnramifiedGenerator_of_le`,
  `exists_isStdUnramifiedGenerator_forall_le` (**the étale coordinate**): `L/K(x)` has a
  standard-unramified generator at `D` with residue `1` and adapted reduction, which is also a
  standard-unramified generator at every valuation ring `O ⊆ D`.
* `UniformizationHypotheses.exists_isStdUnramified_of_isDiscreteValuationRing`: the unbounded case
  of the interface statement.
-/

noncomputable section

open IsLocalRing Polynomial IntermediateField

namespace DeJongAlterations.StableModification.Valuation.DVRCoordinate

open Analytic Decompletion

/-! ### Separability and `q`-th powers -/

section Separability

/-- **A finite extension generated by `q`-th powers is separable** (blueprint
`lem:sm-val-sep-adjoin-pow`): if `F'/F` is finite of exponential characteristic `q` and
`F' = F(F'^q)`, then `F'/F` is separable. -/
theorem isSeparable_of_adjoin_pow_eq_top {F E : Type*} [Field F] [Field E] [Algebra F E]
    [FiniteDimensional F E] (q : ℕ) [ExpChar F q]
    (h : adjoin F (Set.range fun a : E ↦ a ^ q) = ⊤) : Algebra.IsSeparable F E := by
  have : ExpChar E q := expChar_of_injective_algebraMap (algebraMap F E).injective q
  set S := separableClosure F E
  have : ExpChar S q := expChar_of_injective_algebraMap (algebraMap F S).injective q
  obtain ⟨e, he⟩ : ∃ e, ∀ a : E, a ^ q ^ e ∈ (algebraMap S E).range :=
    ⟨IsPurelyInseparable.exponent S E, IsPurelyInseparable.exponent_def' S q⟩
  have key : ∀ n : ℕ, adjoin F (Set.range fun a : E ↦ a ^ q ^ n) = ⊤ := by
    intro n
    induction n with
    | zero => simp
    | succ n ih =>
      rw [eq_top_iff, ← ih, adjoin_le_iff]
      rintro _ ⟨a, rfl⟩
      change a ^ q ^ n ∈ (adjoin F (Set.range fun a : E ↦ a ^ q ^ (n + 1)) : Set E)
      have ha : a ∈ adjoin F (Set.range fun a : E ↦ a ^ q) := h ▸ mem_top
      induction ha using IntermediateField.adjoin_induction with
      | mem x hx =>
        obtain ⟨b, rfl⟩ := hx
        exact subset_adjoin F _ ⟨b, by beta_reduce; rw [← pow_mul, ← pow_succ']⟩
      | algebraMap c =>
        rw [← map_pow]
        exact IntermediateField.algebraMap_mem _ _
      | add x y _ _ hx hy =>
        rw [add_pow_expChar_pow]
        exact add_mem hx hy
      | inv x _ hx =>
        rw [inv_pow]
        exact inv_mem hx
      | mul x y _ _ hx hy =>
        rw [mul_pow]
        exact mul_mem hx hy
  have hS : ⊤ ≤ S := by
    rw [← key e, adjoin_le_iff]
    rintro _ ⟨a, rfl⟩
    obtain ⟨s, hs⟩ := he a
    change a ^ q ^ e ∈ S
    rw [← hs]
    exact s.2
  exact (separableClosure.eq_top_iff F E).mp (top_le_iff.mp hS)

variable {K L : Type*} [Field K] [Field L] [Algebra K L]

/-- A transcendental element whose adjunction makes `L` algebraic shows `trdeg (L/K) = 1`. -/
theorem trdeg_eq_one_of_isAlgebraic {t : L} (ht : Transcendental K t)
    (halg : Algebra.IsAlgebraic K⟮t⟯ L) : Algebra.trdeg K L = 1 := by
  have hind : AlgebraicIndependent K (fun _ : Unit ↦ t) :=
    algebraicIndependent_unique_type_iff.mpr ht
  have halg' : Algebra.IsAlgebraic (Algebra.adjoin K (Set.range fun _ : Unit ↦ t)) L := by
    rw [Set.range_const, ← IntermediateField.isAlgebraic_adjoin_iff_top]
    exact halg
  have hb : IsTranscendenceBasis K (fun _ : Unit ↦ t) :=
    hind.isTranscendenceBasis_iff_isAlgebraic.mpr halg'
  simpa using hb.lift_cardinalMk_eq_trdeg.symm

/-- **Algebraicity over a transcendental element** (blueprint
`lem:sm-val-transcendental-finite`): if `L/K(t)` is algebraic for a transcendental `t`, then
`L/K(y)` is algebraic for every `y` transcendental over `K`. -/
theorem isAlgebraic_adjoin_of_transcendental {t : L} (ht : Transcendental K t)
    (halg : Algebra.IsAlgebraic K⟮t⟯ L) {y : L} (hy : Transcendental K y) :
    Algebra.IsAlgebraic K⟮y⟯ L := by
  have htr := trdeg_eq_one_of_isAlgebraic ht halg
  have hind : AlgebraicIndependent K (fun _ : Unit ↦ y) :=
    algebraicIndependent_unique_type_iff.mpr hy
  have hb : IsTranscendenceBasis K (fun _ : Unit ↦ y) :=
    hind.isTranscendenceBasis_of_lift_trdeg_le_of_finite (by simp [htr])
  have := hb.isAlgebraic
  rwa [Set.range_const, ← IntermediateField.isAlgebraic_adjoin_iff_top] at this

/-- **Finiteness over a transcendental element** (blueprint `lem:sm-val-transcendental-finite`):
if `L/K` is finitely generated and `L/K(y)` is algebraic, then `L/K(y)` is finite. -/
theorem finiteDimensional_adjoin_of_transcendental (hfg : (⊤ : IntermediateField K L).FG)
    {y : L} [Algebra.IsAlgebraic K⟮y⟯ L] : FiniteDimensional K⟮y⟯ L := by
  obtain ⟨S, hS⟩ := hfg
  have htop : adjoin K⟮y⟯ (S : Set L) = ⊤ := by
    rw [eq_top_iff]
    intro z _
    have hz : z ∈ adjoin K (S : Set L) := hS ▸ mem_top
    have hle : adjoin K (S : Set L) ≤ (adjoin K⟮y⟯ (S : Set L)).restrictScalars K :=
      adjoin_le_iff.mpr (subset_adjoin K⟮y⟯ (S : Set L))
    exact hle hz
  have : FiniteDimensional K⟮y⟯ (adjoin K⟮y⟯ (S : Set L)) :=
    finiteDimensional_adjoin fun z _ ↦ (Algebra.IsAlgebraic.isAlgebraic z).isIntegral
  rw [htop] at this
  exact topEquiv.toLinearEquiv.finiteDimensional

/-- **An expansion computation** (blueprint `lem:sm-val-expand-coeff`): the coefficient of
`X^(q a + 1)` in `X Q(X^q) - P(X^q)` is the coefficient of `X^a` in `Q`. -/
theorem coeff_X_mul_expand_sub_expand {q : ℕ} (hq : 1 < q) (P Q : K[X]) (a : ℕ) :
    (X * expand K q Q - expand K q P).coeff (q * a + 1) = Q.coeff a := by
  rw [coeff_sub, coeff_X_mul, coeff_expand (by omega), coeff_expand (by omega)]
  have h1 : q ∣ q * a := dvd_mul_right q a
  have h2 : ¬ q ∣ q * a + 1 := by
    intro h
    have := (Nat.dvd_add_right h1).mp h
    exact absurd (Nat.le_of_dvd one_pos this) (by omega)
  rw [if_pos h1, if_neg h2, Nat.mul_div_cancel_left a (by omega), sub_zero]

/-- A transcendental `t` does not lie in `K(t^q)` for `q > 1` (blueprint
`lem:sm-val-expand-coeff`). -/
theorem notMem_adjoin_pow_of_transcendental {t : L} (ht : Transcendental K t) {q : ℕ}
    (hq : 1 < q) : t ∉ K⟮t ^ q⟯ := by
  intro hmem
  obtain ⟨r, s, hrs⟩ := (mem_adjoin_simple_iff K t).mp hmem
  by_cases hs : aeval (t ^ q) s = 0
  · rw [hs, div_zero] at hrs
    exact ht (hrs ▸ isAlgebraic_zero)
  · have hs0 : s ≠ 0 := by
      rintro rfl
      simp at hs
    have h2 : t * aeval (t ^ q) s = aeval (t ^ q) r := by
      rw [eq_div_iff hs] at hrs
      exact hrs
    have heq : aeval t (X * expand K q s - expand K q r) = 0 := by
      rw [map_sub, map_mul, aeval_X, expand_aeval, expand_aeval, h2, sub_self]
    have hne : X * expand K q s - expand K q r ≠ 0 := by
      intro h0
      have := coeff_X_mul_expand_sub_expand hq r s s.natDegree
      rw [h0, coeff_zero] at this
      exact (leadingCoeff_ne_zero.mpr hs0) this.symm
    exact ht ⟨_, hne, heq⟩

variable (q : ℕ) [hq : Fact q.Prime] [CharP K q]

/-- If `L/K(t)` is finite separable, then `L` is generated by `t` over `K Lᵠ`; in particular
`[L : K Lᵠ] ≤ q` (first step of the proof of `prop:sm-val-separability-criterion`). -/
theorem adjoin_adjoin_pow_eq_top_of_isSeparable {t : L} [Algebra.IsSeparable K⟮t⟯ L] :
    adjoin (adjoin K (Set.range fun a : L ↦ a ^ q)) {t} = ⊤ := by
  set KLq := adjoin K (Set.range fun a : L ↦ a ^ q)
  have hsep := adjoin_eq_adjoin_pow_expChar_of_isSeparable' K⟮t⟯ L Set.univ q
  rw [adjoin_univ, Set.image_univ] at hsep
  have hle : K⟮t⟯ ≤ (adjoin KLq {t}).restrictScalars K :=
    adjoin_simple_le_iff.mpr (mem_adjoin_simple_self KLq t)
  rw [eq_top_iff]
  intro z _
  have hz : z ∈ adjoin K⟮t⟯ (Set.range fun a : L ↦ a ^ q) := hsep ▸ mem_top
  have hle' : adjoin K⟮t⟯ (Set.range fun a : L ↦ a ^ q) ≤ extendScalars hle := by
    rw [adjoin_le_iff]
    intro w hw
    rw [SetLike.mem_coe, mem_extendScalars, mem_restrictScalars]
    exact IntermediateField.algebraMap_mem (adjoin KLq {t}) ⟨w, subset_adjoin K _ hw⟩
  have := hle' hz
  rwa [mem_extendScalars, mem_restrictScalars] at this

/-- `[L : K Lᵠ] ≤ q` when `L/K(t)` is finite separable. -/
theorem finrank_le_of_isSeparable {t : L} [Algebra.IsSeparable K⟮t⟯ L] :
    FiniteDimensional (adjoin K (Set.range fun a : L ↦ a ^ q)) L ∧
      Module.finrank (adjoin K (Set.range fun a : L ↦ a ^ q)) L ≤ q := by
  set KLq := adjoin K (Set.range fun a : L ↦ a ^ q)
  have htq : t ^ q ∈ KLq := subset_adjoin K _ ⟨t, rfl⟩
  have hroot : aeval t (X ^ q - C (⟨t ^ q, htq⟩ : KLq)) = 0 := by
    simp
  have hmon : (X ^ q - C (⟨t ^ q, htq⟩ : KLq)).Monic := monic_X_pow_sub_C _ hq.out.ne_zero
  have hint : IsIntegral KLq t := ⟨_, hmon, by rw [← aeval_def]; exact hroot⟩
  have htop := adjoin_adjoin_pow_eq_top_of_isSeparable (K := K) q (t := t)
  have hfin : FiniteDimensional KLq KLq⟮t⟯ := adjoin.finiteDimensional hint
  have hfin' : FiniteDimensional KLq L := by
    rw [htop] at hfin
    exact topEquiv.toLinearEquiv.finiteDimensional
  refine ⟨hfin', ?_⟩
  rw [← finrank_top', ← htop, adjoin.finrank hint]
  calc (minpoly KLq t).natDegree ≤ (X ^ q - C (⟨t ^ q, htq⟩ : KLq)).natDegree :=
        natDegree_le_of_dvd (minpoly.dvd _ _ hroot) hmon.ne_zero
    _ = q := natDegree_X_pow_sub_C

/-- **Separability criterion, "if" direction** (Temkin, `semi-stable.tex` l. 2204–2206;
blueprint `prop:sm-val-separability-criterion`): if `L/K` is finitely generated, `L/K(t)` is
separable algebraic for a transcendental `t`, and `x` is transcendental with `x ∉ K Lᵠ`, then
`L/K(x)` is finite and separable. -/
theorem isSeparable_adjoin_of_notMem (hfg : (⊤ : IntermediateField K L).FG) {t : L}
    (ht : Transcendental K t) [Algebra.IsSeparable K⟮t⟯ L] {x : L} (hx : Transcendental K x)
    (hxq : x ∉ adjoin K (Set.range fun a : L ↦ a ^ q)) :
    FiniteDimensional K⟮x⟯ L ∧ Algebra.IsSeparable K⟮x⟯ L := by
  set KLq := adjoin K (Set.range fun a : L ↦ a ^ q)
  have : Algebra.IsAlgebraic K⟮x⟯ L :=
    isAlgebraic_adjoin_of_transcendental ht (Algebra.IsSeparable.isAlgebraic _ _) hx
  have hfin : FiniteDimensional K⟮x⟯ L := finiteDimensional_adjoin_of_transcendental hfg
  refine ⟨hfin, ?_⟩
  obtain ⟨hfinq, hle⟩ := finrank_le_of_isSeparable (K := K) q (t := t)
  have : ExpChar L q := expChar_of_injective_algebraMap (algebraMap K L).injective q
  -- `L = K Lᵠ (x)`
  have hxq' : x ^ q ∈ KLq := subset_adjoin K _ ⟨x, rfl⟩
  have hirr : Irreducible (X ^ q - C (⟨x ^ q, hxq'⟩ : KLq)) := by
    refine X_pow_sub_C_irreducible_of_prime hq.out fun b hb ↦ hxq ?_
    have : (b : L) ^ q = x ^ q := by
      have := congrArg Subtype.val hb
      simpa using this
    have hbx : (b : L) = x := frobenius_inj L q this
    rw [← hbx]
    exact b.2
  have hroot : aeval x (X ^ q - C (⟨x ^ q, hxq'⟩ : KLq)) = 0 := by
    simp
  have hmin := minpoly.eq_of_irreducible_of_monic hirr hroot
    (monic_X_pow_sub_C _ hq.out.ne_zero)
  have hint : IsIntegral KLq x := Algebra.IsIntegral.isIntegral x
  have htop : KLq⟮x⟯ = ⊤ := by
    refine eq_of_le_of_finrank_le le_top ?_
    rw [finrank_top', adjoin.finrank hint, ← hmin, natDegree_X_pow_sub_C]
    exact hle
  -- hence `L = K(x)(Lᵠ)`
  have hgen : adjoin K⟮x⟯ (Set.range fun a : L ↦ a ^ q) = ⊤ := by
    set T := adjoin K⟮x⟯ (Set.range fun a : L ↦ a ^ q)
    have hKLq : KLq ≤ T.restrictScalars K :=
      adjoin_le_iff.mpr fun w hw ↦ subset_adjoin K⟮x⟯ _ hw
    rw [eq_top_iff]
    intro z _
    have hz : z ∈ KLq⟮x⟯ := htop ▸ mem_top
    have hle' : KLq⟮x⟯ ≤ extendScalars hKLq := by
      rw [adjoin_simple_le_iff, mem_extendScalars, mem_restrictScalars]
      exact IntermediateField.algebraMap_mem T (⟨x, mem_adjoin_simple_self K x⟩ : K⟮x⟯)
    have := hle' hz
    rwa [mem_extendScalars, mem_restrictScalars] at this
  exact isSeparable_of_adjoin_pow_eq_top q hgen

/-- **Separability criterion, "only if" direction** (Temkin, `semi-stable.tex` l. 2204–2206): if
`L/K(x)` is finite and separable, then `x ∉ K Lᵠ`. -/
theorem notMem_of_isSeparable_adjoin (hfg : (⊤ : IntermediateField K L).FG) {t : L}
    (ht : Transcendental K t) [Algebra.IsSeparable K⟮t⟯ L] {x : L}
    [FiniteDimensional K⟮x⟯ L] [Algebra.IsSeparable K⟮x⟯ L] :
    x ∉ adjoin K (Set.range fun a : L ↦ a ^ q) := by
  set KLq := adjoin K (Set.range fun a : L ↦ a ^ q)
  intro hx
  -- `L = K Lᵠ`
  have hsepx := adjoin_eq_adjoin_pow_expChar_of_isSeparable' K⟮x⟯ L Set.univ q
  rw [adjoin_univ, Set.image_univ] at hsepx
  have hxle : K⟮x⟯ ≤ KLq := adjoin_simple_le_iff.mpr hx
  have hKLq : KLq = ⊤ := by
    rw [eq_top_iff]
    intro z _
    have hz : z ∈ adjoin K⟮x⟯ (Set.range fun a : L ↦ a ^ q) := hsepx ▸ mem_top
    have hle' : adjoin K⟮x⟯ (Set.range fun a : L ↦ a ^ q) ≤ extendScalars hxle := by
      rw [adjoin_le_iff]
      intro w hw
      rw [SetLike.mem_coe, mem_extendScalars]
      exact subset_adjoin K _ hw
    have := hle' hz
    rwa [mem_extendScalars] at this
  -- so `L/K(tᵠ)` is separable
  have htq : Transcendental K (t ^ q) := ht.pow hq.out.pos
  have : Algebra.IsAlgebraic K⟮t ^ q⟯ L :=
    isAlgebraic_adjoin_of_transcendental ht (Algebra.IsSeparable.isAlgebraic _ _) htq
  have : FiniteDimensional K⟮t ^ q⟯ L := finiteDimensional_adjoin_of_transcendental hfg
  have hgen : adjoin K⟮t ^ q⟯ (Set.range fun a : L ↦ a ^ q) = ⊤ := by
    rw [eq_top_iff]
    intro z _
    have hz : z ∈ KLq := hKLq ▸ mem_top
    have hle : KLq ≤ (adjoin K⟮t ^ q⟯ (Set.range fun a : L ↦ a ^ q)).restrictScalars K :=
      adjoin_le_iff.mpr fun w hw ↦ subset_adjoin K⟮t ^ q⟯ _ hw
    exact hle hz
  have := isSeparable_of_adjoin_pow_eq_top q hgen
  -- then `t ∈ K(tᵠ)`, a contradiction
  set F := K⟮t ^ q⟯
  have : Algebra.IsSeparable F F⟮t⟯ :=
    (isSeparable_adjoin_simple_iff_isSeparable F L).mpr (Algebra.IsSeparable.isSeparable F t)
  have : IsPurelyInseparable F F⟮t⟯ :=
    (isPurelyInseparable_adjoin_simple_iff_pow_mem F L q).mpr
      ⟨1, ⟨⟨t ^ q, mem_adjoin_simple_self K (t ^ q)⟩, by simp⟩⟩
  have ht' := mem_adjoin_simple_self F t
  rw [F⟮t⟯.eq_bot_of_isPurelyInseparable_of_isSeparable, mem_bot] at ht'
  obtain ⟨y, hy⟩ := ht'
  have hyF : algebraMap F L y ∈ F := y.2
  rw [hy] at hyF
  exact notMem_adjoin_pow_of_transcendental ht hq.out.one_lt hyF

/-- **Separability criterion** (Temkin, `semi-stable.tex` l. 2204–2206; blueprint
`prop:sm-val-separability-criterion`): if `L/K` is finitely generated of characteristic `q > 0`
and separable algebraic over `K(t)` for a transcendental `t`, then for `x` transcendental over `K`,
`L/K(x)` is separable iff `x ∉ K Lᵠ`. -/
theorem isSeparable_adjoin_iff_notMem (hfg : (⊤ : IntermediateField K L).FG) {t : L}
    (ht : Transcendental K t) [Algebra.IsSeparable K⟮t⟯ L] {x : L} (hx : Transcendental K x) :
    Algebra.IsSeparable K⟮x⟯ L ↔ x ∉ adjoin K (Set.range fun a : L ↦ a ^ q) := by
  have : Algebra.IsAlgebraic K⟮x⟯ L :=
    isAlgebraic_adjoin_of_transcendental ht (Algebra.IsSeparable.isAlgebraic _ _) hx
  have : FiniteDimensional K⟮x⟯ L := finiteDimensional_adjoin_of_transcendental hfg
  exact ⟨fun _ ↦ notMem_of_isSeparable_adjoin q hfg ht,
    fun hxq ↦ (isSeparable_adjoin_of_notMem q hfg ht hx hxq).2⟩

end Separability

/-! ### Discrete valuation rings containing `K` -/

section DVR

variable {K L : Type*} [Field K] [Field L] [Algebra K L] {D : ValuationSubring L}
  (hK : ∀ c : K, algebraMap K L c ∈ D)

include hK

/-- Nonzero elements of `K ⊆ D` are units of `D`. -/
theorem valuation_algebraMap_eq_one {c : K} (hc : c ≠ 0) : D.valuation (algebraMap K L c) = 1 := by
  have hu : IsUnit (⟨algebraMap K L c, hK c⟩ : D) :=
    isUnit_iff_exists_inv.mpr ⟨⟨algebraMap K L c⁻¹, hK _⟩, Subtype.ext (by
      change algebraMap K L c * algebraMap K L c⁻¹ = 1
      rw [← map_mul, mul_inv_cancel₀ hc, map_one])⟩
  exact (D.valuation_eq_one_iff _).mp hu

/-- Polynomials over `K ⊆ D` map `D` to `D`. -/
theorem aeval_mem {z : L} (hz : z ∈ D) (S : K[X]) : aeval z S ∈ D := by
  rw [aeval_eq_sum_range]
  refine sum_mem fun i _ ↦ ?_
  rw [Algebra.smul_def]
  exact mul_mem (hK _) (pow_mem hz _)

/-- **Values of polynomials** (blueprint `lem:sm-val-dvr-polynomial-value`): if `K ⊆ D`,
`v_D(z) < 1` and `R ∈ K[X]` is nonzero with lowest monomial of degree `a`, then
`v_D(R(z)) = v_D(z)^a`. -/
theorem valuation_aeval_eq_pow_natTrailingDegree {z : L} (hz : D.valuation z < 1) {R : K[X]}
    (hR : R ≠ 0) : D.valuation (aeval z R) = D.valuation z ^ R.natTrailingDegree := by
  set a := R.natTrailingDegree
  have hdvd : X ^ a ∣ R := X_pow_dvd_iff.mpr fun d hd ↦ coeff_eq_zero_of_lt_natTrailingDegree hd
  obtain ⟨R₁, hR₁⟩ := hdvd
  have hr : R₁.coeff 0 ≠ 0 := by
    have h := coeff_X_pow_mul' R₁ a a
    rw [← hR₁, if_pos le_rfl, Nat.sub_self] at h
    rw [← h]
    exact trailingCoeff_nonzero_iff_nonzero.mpr hR
  have hzD : z ∈ D := (D.valuation_le_one_iff _).mp hz.le
  have hval : D.valuation (aeval z R₁) = 1 := by
    rw [← X_mul_divX_add R₁, map_add, map_mul, aeval_X, aeval_C, add_comm,
      Valuation.map_add_eq_of_lt_left, valuation_algebraMap_eq_one hK hr]
    rw [valuation_algebraMap_eq_one hK hr, map_mul]
    exact mul_lt_one_of_lt_of_le' hz ((D.valuation_le_one_iff _).mpr (aeval_mem hK hzD _))
  rw [hR₁, map_mul, map_mul, map_pow, aeval_X, hval, mul_one, map_pow]

/-- **A uniformizer is far from `K(xᵠ)`** (blueprint `lem:sm-val-dvr-polynomial-value`): if
`K ⊆ D`, `x ≠ 0` with `v_D(x) < 1` and `q > 1`, then `v_D(x - w) ≥ v_D(x)` for all
`w ∈ K(xᵠ)`. -/
theorem valuation_sub_ge_of_mem_adjoin_pow {x : L} (hx0 : x ≠ 0) (hx1 : D.valuation x < 1)
    {q : ℕ} (hq : 1 < q) {w : L} (hw : w ∈ K⟮x ^ q⟯) : D.valuation x ≤ D.valuation (x - w) := by
  obtain ⟨r, s, hrs⟩ := (mem_adjoin_simple_iff K w).mp hw
  by_cases hs : aeval (x ^ q) s = 0
  · rw [hrs, hs, div_zero, sub_zero]
  have hs0 : s ≠ 0 := by
    rintro rfl
    simp at hs
  set a := s.natTrailingDegree
  set N := X * expand K q s - expand K q r
  have hN : N.coeff (q * a + 1) ≠ 0 := by
    rw [coeff_X_mul_expand_sub_expand hq]
    exact trailingCoeff_nonzero_iff_nonzero.mpr hs0
  have hN0 : N ≠ 0 := fun h ↦ hN (by rw [h, coeff_zero])
  have hNx : aeval x N = (x - w) * aeval (x ^ q) s := by
    rw [hrs, map_sub, map_mul, aeval_X, expand_aeval, expand_aeval, sub_mul,
      div_mul_cancel₀ _ hs]
  have hγ0 : D.valuation x ≠ 0 := (Valuation.ne_zero_iff _).mpr hx0
  have hxq : D.valuation (x ^ q) < 1 := by
    rw [map_pow]
    exact (pow_lt_one_iff (by omega)).mpr hx1
  have hden : D.valuation (aeval (x ^ q) s) = D.valuation x ^ (q * a) := by
    rw [valuation_aeval_eq_pow_natTrailingDegree hK hxq hs0, map_pow, ← pow_mul]
  have hnum : D.valuation x ^ (q * a + 1) ≤ D.valuation (aeval x N) := by
    rw [valuation_aeval_eq_pow_natTrailingDegree hK hx1 hN0]
    exact pow_le_pow_right_of_le_one' hx1.le (natTrailingDegree_le_of_ne_zero hN)
  rw [hNx, map_mul, hden, pow_succ, mul_comm] at hnum
  have hpos : D.valuation x ^ (q * a) ≠ 0 := pow_ne_zero _ hγ0
  calc D.valuation x = D.valuation x * D.valuation x ^ (q * a) * (D.valuation x ^ (q * a))⁻¹ := by
        rw [mul_assoc, mul_inv_cancel₀ hpos, mul_one]
    _ ≤ D.valuation (x - w) * D.valuation x ^ (q * a) * (D.valuation x ^ (q * a))⁻¹ :=
        mul_le_mul_left hnum _
    _ = D.valuation (x - w) := by rw [mul_assoc, mul_inv_cancel₀ hpos, mul_one]

/-- A nonzero element `x` of `L` with `v_D(x) < 1` is transcendental over `K ⊆ D` (blueprint
`lem:sm-val-dvr-separating`). -/
theorem transcendental_of_valuation_lt_one {x : L} (hx0 : x ≠ 0) (hx1 : D.valuation x < 1) :
    Transcendental K x := by
  rintro ⟨R, hR, hRx⟩
  have h := valuation_aeval_eq_pow_natTrailingDegree hK hx1 hR
  rw [hRx, map_zero] at h
  exact pow_ne_zero _ ((Valuation.ne_zero_iff _).mpr hx0) h.symm

variable [IsDiscreteValuationRing D] {x : L} (hx : x ∈ D) (hirr : Irreducible (⟨x, hx⟩ : D))

omit hK [IsDiscreteValuationRing D] in
include hirr in
/-- A uniformizer is nonzero. -/
theorem ne_zero_of_irreducible : x ≠ 0 := fun h ↦ hirr.ne_zero (Subtype.ext h)

omit hK [IsDiscreteValuationRing D] in
include hirr in
/-- A uniformizer has value `< 1`. -/
theorem valuation_lt_one_of_irreducible : D.valuation x < 1 := by
  rw [← D.valuation_lt_one_iff ⟨x, hx⟩, mem_maximalIdeal, mem_nonunits_iff]
  exact hirr.not_isUnit

omit hK in
include hirr in
/-- Elements of the maximal ideal have value at most that of a uniformizer. -/
theorem valuation_le_of_mem_maximalIdeal {u : D} (hu : u ∈ maximalIdeal D) :
    D.valuation (u : L) ≤ D.valuation x := by
  rw [(IsDiscreteValuationRing.irreducible_iff_uniformizer _).mp hirr,
    Ideal.mem_span_singleton'] at hu
  obtain ⟨d, rfl⟩ := hu
  change D.valuation ((d : L) * x) ≤ _
  rw [map_mul]
  exact mul_le_of_le_one_left' ((D.valuation_le_one_iff _).mpr d.2)

omit hK in
include hirr in
/-- Every element of `L` becomes integral after multiplication by a power of a uniformizer. -/
theorem exists_mul_pow_mem (y : L) : ∃ m : ℕ, y * x ^ m ∈ D := by
  rcases D.mem_or_inv_mem y with hy | hy
  · exact ⟨0, by simpa using hy⟩
  by_cases hy0 : y = 0
  · exact ⟨0, by simp [hy0]⟩
  have hne : (⟨y⁻¹, hy⟩ : D) ≠ 0 := fun h ↦ inv_ne_zero hy0 (congrArg Subtype.val h)
  obtain ⟨m, u, hu⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hne hirr
  refine ⟨m, ?_⟩
  have h1 : y⁻¹ = ((u : D) : L) * x ^ m := congrArg Subtype.val hu
  have hu1 : ((u : D) : L) * (((u⁻¹ : Dˣ) : D) : L) = 1 := congrArg Subtype.val u.mul_inv
  have hu0 : ((u : D) : L) ≠ 0 := left_ne_zero_of_mul_eq_one hu1
  have hyx : y * x ^ m = (((u⁻¹ : Dˣ) : D) : L) := by
    rw [← (mul_eq_one_iff_inv_eq₀ hu0).mp hu1]
    have hxm : x ^ m = ((u : D) : L)⁻¹ * y⁻¹ := by
      rw [h1, ← mul_assoc, inv_mul_cancel₀ hu0, one_mul]
    rw [hxm, ← mul_assoc, mul_comm y, mul_assoc, mul_inv_cancel₀ hy0, mul_one]
  rw [hyx]
  exact ((u⁻¹ : Dˣ) : D).2

variable (hres : ∀ z : ResidueField D, ∃ c : K, residue D ⟨algebraMap K L c, hK c⟩ = z)

include hirr hres in
/-- **Polynomials in the uniformizer are dense in `D`** (blueprint
`lem:sm-val-dvr-approximation`): if `K ⊆ D` maps onto the residue field, every `u ∈ D` is
approximated by polynomials in a uniformizer `x` with coefficients in `K`. -/
theorem exists_polynomial_valuation_sub_le {u : L} (hu : u ∈ D) (N : ℕ) :
    ∃ P : K[X], D.valuation (u - aeval x P) ≤ D.valuation x ^ N := by
  have hx0 := ne_zero_of_irreducible hx hirr
  have hγ0 : D.valuation x ≠ 0 := (Valuation.ne_zero_iff _).mpr hx0
  induction N with
  | zero => exact ⟨0, by simpa using (D.valuation_le_one_iff _).mpr hu⟩
  | succ N ih =>
    obtain ⟨P, hP⟩ := ih
    set u' := (u - aeval x P) * (x ^ N)⁻¹
    have hu' : u' ∈ D := by
      rw [← D.valuation_le_one_iff, map_mul, map_inv₀, map_pow]
      calc D.valuation (u - aeval x P) * (D.valuation x ^ N)⁻¹ ≤
            D.valuation x ^ N * (D.valuation x ^ N)⁻¹ := mul_le_mul_left hP _
        _ = 1 := mul_inv_cancel₀ (pow_ne_zero _ hγ0)
    obtain ⟨c, hc⟩ := hres (residue D ⟨u', hu'⟩)
    have hmem : (⟨u', hu'⟩ - ⟨algebraMap K L c, hK c⟩ : D) ∈ maximalIdeal D := by
      rw [← residue_eq_zero_iff, map_sub, hc, sub_self]
    have hle := valuation_le_of_mem_maximalIdeal hx hirr hmem
    refine ⟨P + C c * X ^ N, ?_⟩
    have hxN : x ^ N ≠ 0 := pow_ne_zero _ hx0
    have heq : u - aeval x (P + C c * X ^ N) = x ^ N * (u' - algebraMap K L c) := by
      simp only [u', map_add, map_mul, aeval_C, map_pow, aeval_X]
      field_simp
      ring
    rw [heq, map_mul, map_pow, pow_succ]
    exact mul_le_mul_right hle _

include hirr hres in
/-- **`K(x)` is dense in `L`** (blueprint `lem:sm-val-dvr-approximation`): every `y ∈ L` is
approximated by elements of `K(x)` to any order. -/
theorem exists_mem_adjoin_valuation_sub_le (y : L) (N : ℕ) :
    ∃ w ∈ K⟮x⟯, D.valuation (y - w) ≤ D.valuation x ^ N := by
  have hx0 := ne_zero_of_irreducible hx hirr
  have hγ0 : D.valuation x ≠ 0 := (Valuation.ne_zero_iff _).mpr hx0
  obtain ⟨m, hm⟩ := exists_mul_pow_mem hx hirr y
  obtain ⟨P, hP⟩ := exists_polynomial_valuation_sub_le hK hx hirr hres hm (N + m)
  refine ⟨aeval x P / x ^ m, (mem_adjoin_simple_iff K _).mpr ⟨P, X ^ m, by simp⟩, ?_⟩
  have hxm : x ^ m ≠ 0 := pow_ne_zero _ hx0
  have heq : y - aeval x P / x ^ m = (y * x ^ m - aeval x P) * (x ^ m)⁻¹ := by
    field_simp
  rw [heq, map_mul, map_inv₀, map_pow]
  calc D.valuation (y * x ^ m - aeval x P) * (D.valuation x ^ m)⁻¹ ≤
        D.valuation x ^ (N + m) * (D.valuation x ^ m)⁻¹ := mul_le_mul_left hP _
    _ = D.valuation x ^ N := by
        rw [pow_add, mul_assoc, mul_inv_cancel₀ (pow_ne_zero _ hγ0), mul_one]

include hirr hres in
/-- **`K(x)` is dense in the completion** (blueprint `lem:sm-val-dvr-completion`): for a
non-archimedean normed field `M` with a dense map `L → M` inducing `D`, `K(x)` is dense in `M`. -/
theorem denseRange_adjoin {M : Type*} [NormedField M] [IsUltrametricDist M] [Algebra L M]
    (hD : ∀ y, y ∈ D ↔ ‖algebraMap L M y‖ ≤ 1) (hdL : DenseRange (algebraMap L M))
    [Algebra K⟮x⟯ M] (hcomp : ∀ w : K⟮x⟯, algebraMap K⟮x⟯ M w = algebraMap L M w) :
    DenseRange (algebraMap K⟮x⟯ M) := by
  have hx0 := ne_zero_of_irreducible hx hirr
  have hγ0 : D.valuation x ≠ 0 := (Valuation.ne_zero_iff _).mpr hx0
  have hxlt : ‖algebraMap L M x‖ < 1 :=
    (valuation_lt_one_iff_of_forall_mem_iff hD x).mp (valuation_lt_one_of_irreducible hx hirr)
  have hxpos : 0 < ‖algebraMap L M x‖ := norm_pos_iff.mpr ((_root_.map_ne_zero _).mpr hx0)
  rw [Metric.denseRange_iff]
  intro m ε hε
  obtain ⟨l, hl⟩ := Metric.denseRange_iff.mp hdL m ε hε
  obtain ⟨N, hN⟩ := exists_pow_lt_of_lt_one hε hxlt
  obtain ⟨w, hw, hwv⟩ := exists_mem_adjoin_valuation_sub_le hK hx hirr hres l N
  refine ⟨⟨w, hw⟩, ?_⟩
  have h1 : ‖algebraMap L M (l - w)‖ ≤ ‖algebraMap L M x‖ ^ N := by
    have hmem : (l - w) * (x ^ N)⁻¹ ∈ D := by
      rw [← D.valuation_le_one_iff, map_mul, map_inv₀, map_pow]
      calc D.valuation (l - w) * (D.valuation x ^ N)⁻¹ ≤
            D.valuation x ^ N * (D.valuation x ^ N)⁻¹ := mul_le_mul_left hwv _
        _ = 1 := mul_inv_cancel₀ (pow_ne_zero _ hγ0)
    have := (hD _).mp hmem
    rw [map_mul, map_inv₀, map_pow, norm_mul, norm_inv, norm_pow,
      mul_inv_le_iff₀ (pow_pos hxpos N), one_mul] at this
    exact this
  rw [dist_eq_norm] at hl ⊢
  have heq : m - algebraMap K⟮x⟯ M ⟨w, hw⟩ = (m - algebraMap L M l) + algebraMap L M (l - w) := by
    rw [hcomp, map_sub]
    ring
  rw [heq]
  exact (IsUltrametricDist.norm_add_le_max _ _).trans_lt (max_lt hl (h1.trans_lt hN))

end DVR

/-! ### The uniformizer is a separating element -/

section Separating

variable {K L : Type*} [Field K] [Field L] [Algebra K L]

/-- In characteristic `q`, the Frobenius maps `K(x)` into `K(xᵠ)`. -/
theorem pow_mem_adjoin_pow (q : ℕ) [Fact q.Prime] [CharP L q] {x w : L} (hw : w ∈ K⟮x⟯) :
    w ^ q ∈ K⟮x ^ q⟯ := by
  induction hw using IntermediateField.adjoin_induction with
  | mem y hy =>
    rw [Set.mem_singleton_iff.mp hy]
    exact mem_adjoin_simple_self K _
  | algebraMap c =>
    rw [← map_pow]
    exact IntermediateField.algebraMap_mem _ _
  | add y z _ _ hy hz =>
    rw [add_pow_char]
    exact add_mem hy hz
  | inv y _ hy =>
    rw [inv_pow]
    exact inv_mem hy
  | mul y z _ _ hy hz =>
    rw [mul_pow]
    exact mul_mem hy hz

variable {D : ValuationSubring L} (hK : ∀ c : K, algebraMap K L c ∈ D) [IsDiscreteValuationRing D]
  (hres : ∀ z : ResidueField D, ∃ c : K, residue D ⟨algebraMap K L c, hK c⟩ = z)
  {x : L} (hx : x ∈ D) (hirr : Irreducible (⟨x, hx⟩ : D))

include hirr hres in
/-- **The uniformizer is not in `K Lᵠ`** (blueprint `lem:sm-val-dvr-separating`): in
characteristic `q`, the closure in `L̂` of `K(xᵠ)` contains `K Lᵠ` but not `x`. -/
theorem notMem_adjoin_pow_of_irreducible (q : ℕ) [hq : Fact q.Prime] [CharP K q] :
    x ∉ adjoin K (Set.range fun a : L ↦ a ^ q) := by
  have : CharP L q := charP_of_injective_algebraMap (algebraMap K L).injective q
  have hx0 := ne_zero_of_irreducible hx hirr
  have hxv := valuation_lt_one_of_irreducible hx hirr
  let : D.valuation.RankOne :=
    rankOneOfRingKrullDimEqOne D (IsDiscreteValuationRing.ringKrullDim_eq_one D)
  let φ := toCompletion D.valuation
  let : Algebra L D.valuation.Completion := φ.toAlgebra
  let : Algebra K⟮x⟯ D.valuation.Completion := (φ.comp (algebraMap K⟮x⟯ L)).toAlgebra
  have hD : ∀ y, y ∈ D ↔ ‖algebraMap L D.valuation.Completion y‖ ≤ 1 := fun y ↦ by
    rw [← D.valuation_le_one_iff]
    exact (norm_toCompletion_le_one_iff D.valuation).symm
  have hdense := denseRange_adjoin hK hx hirr hres hD (denseRange_toCompletion D.valuation)
    (fun _ ↦ rfl)
  set S : Subfield D.valuation.Completion := ((K⟮x ^ q⟯).toSubfield.map φ).topologicalClosure
  have hS : ∀ z ∈ adjoin K (Set.range fun a : L ↦ a ^ q), φ z ∈ S := by
    intro z hz
    induction hz using IntermediateField.adjoin_induction with
    | mem y hy =>
      obtain ⟨b, rfl⟩ := hy
      rw [map_pow]
      have hb : φ b ∈ closure (Set.range (algebraMap K⟮x⟯ D.valuation.Completion)) := by
        rw [hdense.closure_range]
        trivial
      refine map_mem_closure (f := fun a : D.valuation.Completion ↦ a ^ q) (continuous_pow q) hb ?_
      rintro _ ⟨w, rfl⟩
      refine ⟨(w : L) ^ q, pow_mem_adjoin_pow q w.2, ?_⟩
      change φ ((w : L) ^ q) = (φ w) ^ q
      rw [map_pow]
    | algebraMap c =>
      exact Subfield.le_topologicalClosure _
        ⟨algebraMap K L c, IntermediateField.algebraMap_mem _ c, rfl⟩
    | add y z _ _ hy hz =>
      rw [map_add]
      exact add_mem hy hz
    | inv y _ hy =>
      rw [map_inv₀]
      exact inv_mem hy
    | mul y z _ _ hy hz =>
      rw [map_mul]
      exact mul_mem hy hz
  intro hxq
  have hxS : φ x ∈ closure (((K⟮x ^ q⟯).toSubfield.map φ : Subfield _) : Set _) := hS x hxq
  have hxpos : 0 < ‖φ x‖ := norm_pos_iff.mpr ((_root_.map_ne_zero φ).mpr hx0)
  obtain ⟨b, hb, hdist⟩ := Metric.mem_closure_iff.mp hxS ‖φ x‖ hxpos
  obtain ⟨w, hw, rfl⟩ := hb
  rw [dist_eq_norm, ← map_sub] at hdist
  have hge := valuation_sub_ge_of_mem_adjoin_pow hK hx0 hxv hq.out.one_lt hw
  rw [← norm_toCompletion_le_iff D.valuation] at hge
  exact absurd hdist (not_lt.mpr hge)

include hirr hres in
/-- **The uniformizer is a separating element** (blueprint `lem:sm-val-dvr-separating`): if
`L/K` is finitely generated and separable algebraic over `K(t)` for a transcendental `t`, then a
uniformizer `x` of `D` is transcendental over `K` and `L/K(x)` is finite and separable. -/
theorem finiteDimensional_isSeparable_of_irreducible (hfg : (⊤ : IntermediateField K L).FG)
    {t : L} (ht : Transcendental K t) [Algebra.IsSeparable K⟮t⟯ L] :
    Transcendental K x ∧ FiniteDimensional K⟮x⟯ L ∧ Algebra.IsSeparable K⟮x⟯ L := by
  have hx0 := ne_zero_of_irreducible hx hirr
  have hxv := valuation_lt_one_of_irreducible hx hirr
  have htx := transcendental_of_valuation_lt_one hK hx0 hxv
  have : Algebra.IsAlgebraic K⟮x⟯ L :=
    isAlgebraic_adjoin_of_transcendental ht (Algebra.IsSeparable.isAlgebraic _ _) htx
  have hfin : FiniteDimensional K⟮x⟯ L := finiteDimensional_adjoin_of_transcendental hfg
  refine ⟨htx, hfin, ?_⟩
  obtain ⟨q, hq⟩ := ExpChar.exists K
  rcases hq with _ | ⟨hprime⟩
  · have : CharZero K⟮x⟯ := charZero_of_injective_algebraMap (algebraMap K K⟮x⟯).injective
    exact Algebra.IsAlgebraic.isSeparable_of_perfectField
  · have : Fact q.Prime := ⟨hprime⟩
    exact (isSeparable_adjoin_of_notMem q hfg ht htx
      (notMem_adjoin_pow_of_irreducible hK hres hx hirr q)).2

end Separating

/-! ### The étale coordinate -/

section Coordinate

variable {K L : Type*} [Field K] [Field L] [Algebra K L]

/-- If `K ⊆ D` maps onto `κ(D)`, then for every intermediate field `F` of `L/K` the residue
extension `κ(D)/κ(D ∩ F)` is trivial. -/
theorem surjective_algebraMap_residueField {D : ValuationSubring L}
    (hK : ∀ c : K, algebraMap K L c ∈ D)
    (hres : ∀ z : ResidueField D, ∃ c : K, residue D ⟨algebraMap K L c, hK c⟩ = z)
    (F : IntermediateField K L) :
    Function.Surjective
      (algebraMap (ResidueField (D.comap (algebraMap F L))) (ResidueField D)) := by
  intro z
  obtain ⟨c, hc⟩ := hres z
  have hmem : algebraMap K F c ∈ D.comap (algebraMap F L) := by
    rw [ValuationSubring.mem_comap]
    exact hK c
  refine ⟨residue _ ⟨algebraMap K F c, hmem⟩, ?_⟩
  rw [← hc]
  rfl

/-- If the field extension `E/F` is trivial, `E = F(1)`. -/
theorem adjoin_one_eq_top_of_surjective {F E : Type*} [Field F] [Field E] [Algebra F E]
    (h : Function.Surjective (algebraMap F E)) : adjoin F {(1 : E)} = ⊤ := by
  rw [eq_top_iff]
  intro z _
  obtain ⟨a, rfl⟩ := h z
  exact IntermediateField.algebraMap_mem _ a

variable {D : ValuationSubring L} (hK : ∀ c : K, algebraMap K L c ∈ D) [IsDiscreteValuationRing D]
  (hres : ∀ z : ResidueField D, ∃ c : K, residue D ⟨algebraMap K L c, hK c⟩ = z)
  {x : L} (hx : x ∈ D) (hirr : Irreducible (⟨x, hx⟩ : D))

include hirr hres in
/-- **The étale coordinate, at the discrete valuation ring** (blueprint
`thm:sm-val-dvr-coordinate`): let `D` be a discrete valuation ring of `L` containing `K` with
residue field `K`, and `x` a uniformizer with `L/K(x)` finite separable. Then `L/K(x)` has a
standard-unramified generator `y` at `D` with residue `1` whose minimal polynomial over
`D ∩ K(x)` reduces to `(X - 1) X^m`. The proof applies the decompletion criterion with
`E = M = L̂`, in which `K(x)` is dense. -/
theorem exists_isStdUnramifiedGenerator_dvr [FiniteDimensional K⟮x⟯ L]
    [Algebra.IsSeparable K⟮x⟯ L] :
    ∃ y : L, ∃ hy : IsStdUnramifiedGenerator K⟮x⟯ D y, residue D ⟨y, hy.mem⟩ = 1 ∧
      ∃ m : ℕ, (minpoly (D.comap (algebraMap K⟮x⟯ L)) y).map
          (residue (D.comap (algebraMap K⟮x⟯ L))) =
        minpoly (ResidueField (D.comap (algebraMap K⟮x⟯ L))) (1 : ResidueField D) * X ^ m := by
  let : D.valuation.RankOne :=
    rankOneOfRingKrullDimEqOne D (IsDiscreteValuationRing.ringKrullDim_eq_one D)
  let φ := toCompletion D.valuation
  let : Algebra L D.valuation.Completion := φ.toAlgebra
  let : Algebra K⟮x⟯ D.valuation.Completion := (φ.comp (algebraMap K⟮x⟯ L)).toAlgebra
  have : @IsScalarTower K⟮x⟯ L D.valuation.Completion Algebra.toSMul Algebra.toSMul
      Algebra.toSMul := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  have hD : ∀ y, y ∈ D ↔ ‖algebraMap L D.valuation.Completion y‖ ≤ 1 := fun y ↦ by
    rw [← D.valuation_le_one_iff]
    exact (norm_toCompletion_le_one_iff D.valuation).symm
  have hdense := denseRange_adjoin hK hx hirr hres hD (denseRange_toCompletion D.valuation)
    (fun _ ↦ rfl)
  have hsurj := surjective_algebraMap_residueField hK hres K⟮x⟯
  have hgen := adjoin_one_eq_top_of_surjective hsurj
  have hdeg : Module.finrank D.valuation.Completion D.valuation.Completion ≤
      Module.finrank (ResidueField (D.comap (algebraMap K⟮x⟯ L))) (ResidueField D) := by
    have h1 : (X - C (1 : ResidueField (D.comap (algebraMap K⟮x⟯ L)))).natDegree = 1 :=
      natDegree_X_sub_C _
    rw [map_one] at h1
    rw [Module.finrank_self, ← finrank_top', ← hgen, adjoin.finrank isIntegral_one, minpoly.one,
      h1]
  have hsep1 : IsSeparable (ResidueField (D.comap (algebraMap K⟮x⟯ L))) (1 : ResidueField D) := by
    rw [← map_one (algebraMap (ResidueField (D.comap (algebraMap K⟮x⟯ L))) (ResidueField D))]
    exact isSeparable_algebraMap 1
  exact exists_isStdUnramifiedGenerator_of_finrank_le (E := D.valuation.Completion)
    (M := D.valuation.Completion) D hD hdense hdeg one_ne_zero hgen hsep1

omit [IsDiscreteValuationRing D] in
include hres in
/-- **Transport to smaller valuation rings** (composition step of blueprint
`thm:sm-val-dvr-coordinate`): a standard-unramified generator `y` of `L/K(x)` at `D` with residue
`1` and reduced minimal polynomial `(X - 1) X^m` is a standard-unramified generator at every
valuation ring `O ⊆ D` (composition criterion, Temkin 2.2.2, adapted form). -/
theorem isStdUnramifiedGenerator_of_le {y : L} (hy : IsStdUnramifiedGenerator K⟮x⟯ D y)
    (hy1 : residue D ⟨y, hy.mem⟩ = 1)
    (hfac : ∃ m : ℕ, (minpoly (D.comap (algebraMap K⟮x⟯ L)) y).map
        (residue (D.comap (algebraMap K⟮x⟯ L))) =
      minpoly (ResidueField (D.comap (algebraMap K⟮x⟯ L))) (1 : ResidueField D) * X ^ m)
    {O : ValuationSubring L} (hO : O ≤ D) : IsStdUnramifiedGenerator K⟮x⟯ O y := by
  obtain ⟨m, hfac⟩ := hfac
  set B' := decompose D hO
  have hgen := adjoin_one_eq_top_of_surjective (surjective_algebraMap_residueField hK hres K⟮x⟯)
  have h1 : IsStdUnramifiedGenerator (ResidueField (D.comap (algebraMap K⟮x⟯ L))) B'
      (residue D ⟨y, hy.mem⟩) := by
    rw [hy1]
    refine ⟨hgen, isIntegral_one, ?_⟩
    rw [minpoly.one, derivative_sub, derivative_X, derivative_one, sub_zero, map_one, map_one]
  have h2 : B'.valuation (residue D ⟨y, hy.mem⟩) = 1 := by
    rw [hy1, map_one]
  have h3 := hy.compose_of_adapted h1 h2 ⟨m, by rw [hy1]; exact hfac⟩
  rwa [compose_decompose D hO] at h3

include hirr hres in
/-- **The étale coordinate** (Temkin, proof of Theorem 2.1.8, `semi-stable.tex` l. 2188–2196;
blueprint `thm:sm-val-dvr-coordinate`): let `D` be a discrete valuation ring of `L` containing `K`
with residue field `K`, and `x` a uniformizer. If `L/K` is finitely generated and separable
algebraic over `K(t)` for some transcendental `t`, then `x` is transcendental, `L/K(x)` is finite
separable, and some `y` is a standard-unramified generator of `L/K(x)` at every valuation ring
`O ⊆ D` of `L` (in particular at `D` itself). -/
theorem exists_isStdUnramifiedGenerator_forall_le (hfg : (⊤ : IntermediateField K L).FG)
    {t : L} (ht : Transcendental K t) [Algebra.IsSeparable K⟮t⟯ L] :
    Transcendental K x ∧ FiniteDimensional K⟮x⟯ L ∧ Algebra.IsSeparable K⟮x⟯ L ∧
      ∃ y : L, ∀ O : ValuationSubring L, O ≤ D → IsStdUnramifiedGenerator K⟮x⟯ O y := by
  obtain ⟨htx, hfin, hsep⟩ := finiteDimensional_isSeparable_of_irreducible hK hres hx hirr hfg ht
  obtain ⟨y, hy, hy1, hfac⟩ := exists_isStdUnramifiedGenerator_dvr hK hres hx hirr
  exact ⟨htx, hfin, hsep, y, fun O hO ↦ isStdUnramifiedGenerator_of_le hK hres hy hy1 hfac hO⟩

end Coordinate

end DeJongAlterations.StableModification.Valuation.DVRCoordinate

namespace DeJongAlterations.StableModification.Valuation.UniformizationHypotheses

open DVRCoordinate

/-- **The unbounded case of the uniformization statement** (Temkin, proof of Theorem 2.1.8,
`semi-stable.tex` l. 2188–2196; blueprint `cor:sm-val-dvr-coordinate-interface`): under the
uniformization hypotheses, if `K·O` is a discrete valuation ring with residue field `K` and `x` is
a uniformizer of `K·O`, then `x` is transcendental over `K` and `L/K(x)` is standard-unramified at
`O`. -/
theorem exists_isStdUnramified_of_isDiscreteValuationRing {K L : Type*} [Field K] [Field L]
    [Algebra K L] {O : ValuationSubring L} (h : UniformizationHypotheses K L O)
    (hdvr : IsDiscreteValuationRing (baseLocalization K O))
    (hres : Function.Bijective ((residue (baseLocalization K O)).comp (toBaseLocalization K O)))
    {x : L} (hx : x ∈ baseLocalization K O)
    (hirr : Irreducible (⟨x, hx⟩ : baseLocalization K O)) :
    Transcendental K x ∧ IsStdUnramified K⟮x⟯ O := by
  have hK : ∀ c : K, algebraMap K L c ∈ baseLocalization K O :=
    algebraMap_mem_baseLocalization K O
  have hres' : ∀ z, ∃ c : K, residue (baseLocalization K O) ⟨algebraMap K L c, hK c⟩ = z :=
    fun z ↦ hres.2 z
  obtain ⟨t, ht, hsep⟩ := h.exists_separating
  obtain ⟨htx, -, -, y, hy⟩ := exists_isStdUnramifiedGenerator_forall_le hK hres' hx hirr h.fg ht
  exact ⟨htx, y, hy O (le_baseLocalization K O)⟩

end DeJongAlterations.StableModification.Valuation.UniformizationHypotheses
