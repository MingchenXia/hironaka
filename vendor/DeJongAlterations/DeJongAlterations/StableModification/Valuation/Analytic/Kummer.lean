import DeJongAlterations.StableModification.Valuation.Analytic.Inertia
import DeJongAlterations.StableModification.Valuation.Analytic.Annulus

/-!
# The tame quotient and the Kummer step

Let `K` be an analytic field, `N/K` a finite Galois extension of normed fields, and `T ⊇ V` the
inertia and wild inertia subgroups of `Gal(N/K)` (`Analytic/Inertia.lean`). This file proves the
"tame" half of plan simplification S5 (`PLAN-SM-VAL.md`), which replaces Temkin's use of the
maximal moderately ramified extension `K^mr` in *Stable modification of relative curves*,
J. Algebraic Geom. 19 (2010), proof of Theorem 6.3.1 (`semi-stable.tex`, lines 4041–4111): the
quotient `T/V` has no `p`-torsion, and when `T = Gal(N/K)` the fixed field `W = N^V` is a totally
ramified Cartesian extension of `K` of degree prime to `p`. For an annulus field `K` (type 3)
`W` is generated by an `m`-th root of the annulus generator.

## Main definitions

* `tameChar σ w`: the residue of `σ w / w`, the tame character of `σ`.

## Main results

* `mem_wildInertiaSubgroup_of_pow_char_mem`: `σ ∈ T`, `σ ^ p ∈ V ⇒ σ ∈ V`.
* `eq_one_of_pow_eq_one_of_norm_sub_lt`, `wildInertiaSubgroup_apply_eq_of_pow_mem`: `V` fixes every
  `y` with `y ^ m ∈ K`, `‖m‖ = 1`.
* `mem_wildInertiaSubgroup_of_forall_norm_sub_lt`: an automorphism acting on `N^V` like an element
  of `V` lies in `V` (when `T = Gal(N/K)`).
* `norm_finrank_fixedField_wildInertiaSubgroup`, `not_dvd_finrank_fixedField_wildInertiaSubgroup`,
  `ramificationIndex_fixedField_wildInertiaSubgroup`: when `T = Gal(N/K)`, `[N^V : K]` is prime to
  `p` and equal to `e_{N^V/K}`.
* `exists_pow_eq_and_fixedField_eq_adjoin` (**the Kummer step**): for an annulus field `K` over an
  algebraically closed `k` and `N` with residue field that of `k`, `N^V = K(y)` with
  `y ^ m = z`, `m = [N^V : K]`.

## References

Blueprint chapter `sm-val-ramification.tex`: `lem:sm-an-tame-quotient`, `lem:sm-an-kummer-fixed`,
`lem:sm-an-tame-cartesian`, `lem:sm-an-kummer-step`.
-/

noncomputable section

open IsLocalRing Polynomial IntermediateField
open scoped NNReal

namespace DeJongAlterations.StableModification.Valuation.Analytic

/-! ### Roots of unity close to one -/

/-- An `m`-th root of unity at distance `< 1` from `1` is `1`, if `‖m‖ = 1`. -/
theorem eq_one_of_pow_eq_one_of_norm_sub_lt {F : Type*} [NormedField F] [IsUltrametricDist F]
    {m : ℕ} (hm : ‖(m : F)‖ = 1) {ζ : F} (hζ : ζ ^ m = 1) (h : ‖ζ - 1‖ < 1) : ζ = 1 := by
  have hζ1 : ‖ζ‖ = 1 := by
    have := norm_eq_of_norm_sub_lt (x := (1 : F)) (y := ζ) (by rwa [norm_sub_rev, norm_one])
    rwa [norm_one] at this
  set g : (unitBall F)[X] := X ^ m - 1
  set y' : unitBall F := ⟨ζ, mem_unitBall.mpr hζ1.le⟩
  have h1 : g.IsRoot 1 := by simp [g]
  have h2 : g.IsRoot y' := by
    apply Subtype.ext
    simp [g, y', hζ]
  have hd : ‖((g.derivative.eval 1 : unitBall F) : F)‖ = 1 := by
    simp [g, derivative_X_pow, hm]
  have := eq_of_isRoot_of_norm_sub_lt_one g h1 h2 (by simpa [y', norm_sub_rev] using h) hd
  exact (congrArg Subtype.val this).symm

/-! ### The tame character -/

section TameChar

variable {K N : Type*} [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
  [NormedField N] [IsUltrametricDist N] [NormedAlgebra K N] [Algebra.IsAlgebraic K N]

local notation "Ñ" => ResidueField (unitBall N)

omit [IsUltrametricDist N] in
theorem norm_algEquiv_apply_div_le_one (σ : N ≃ₐ[K] N) (w : N) : ‖σ w / w‖ ≤ 1 := by
  rw [norm_div, norm_algEquiv_apply]
  exact div_self_le_one _

/-- The **tame character** of `σ`: `w ↦ (σ w / w)~ ∈ Ñ`. -/
def tameChar (σ : N ≃ₐ[K] N) (w : N) : Ñ :=
  residue (unitBall N) ⟨σ w / w, mem_unitBall.mpr (norm_algEquiv_apply_div_le_one σ w)⟩

theorem tameChar_eq_one_iff {σ : N ≃ₐ[K] N} {w : N} (hw : w ≠ 0) :
    tameChar σ w = 1 ↔ ‖σ w - w‖ < ‖w‖ := by
  rw [tameChar, ← map_one (residue (unitBall N)), residue_eq_residue_iff]
  change ‖σ w / w - 1‖ < 1 ↔ _
  rw [div_sub_one hw, norm_div, div_lt_one (norm_pos_iff.mpr hw)]

theorem tameChar_mul_right (σ : N ≃ₐ[K] N) (w w' : N) :
    tameChar σ (w * w') = tameChar σ w * tameChar σ w' := by
  rw [tameChar, tameChar, tameChar, ← map_mul]
  congr 1
  apply Subtype.ext
  change σ (w * w') / (w * w') = σ w / w * (σ w' / w')
  rw [map_mul, mul_div_mul_comm]

theorem tameChar_algebraMap_mul (σ : N ≃ₐ[K] N) {c : K} (hc : c ≠ 0) (w : N) :
    tameChar σ (algebraMap K N c * w) = tameChar σ w := by
  rw [tameChar, tameChar]
  congr 2
  rw [map_mul, AlgEquiv.commutes, mul_div_mul_left _ _ ((_root_.map_ne_zero _).mpr hc)]

theorem tameChar_apply_one (σ : N ≃ₐ[K] N) : tameChar σ 1 = 1 := by
  rw [tameChar, ← map_one (residue (unitBall N))]
  congr 1
  apply Subtype.ext
  change σ 1 / 1 = 1
  rw [map_one, div_one]

theorem tameChar_one_apply {w : N} (hw : w ≠ 0) : tameChar (1 : N ≃ₐ[K] N) w = 1 :=
  (tameChar_eq_one_iff hw).mpr (by simpa using norm_pos_iff.mpr hw)

theorem tameChar_eq_one_of_norm_eq_one {σ : N ≃ₐ[K] N} (hσ : σ ∈ inertiaSubgroup K N) {u : N}
    (hu : ‖u‖ = 1) : tameChar σ u = 1 := by
  have hu0 : u ≠ 0 := by
    rintro rfl
    simp at hu
  rw [tameChar_eq_one_iff hu0, hu]
  exact hσ u hu.le

/-- For `σ` in the inertia subgroup, `tameChar σ w` only depends on the class of `‖w‖` modulo
`|K^×|`. -/
theorem tameChar_eq_of_norm_eq {σ : N ≃ₐ[K] N} (hσ : σ ∈ inertiaSubgroup K N) {w w' : N}
    (hw : w ≠ 0) (c : K) (h : ‖w'‖ = ‖c‖ * ‖w‖) (hw' : w' ≠ 0) :
    tameChar σ w' = tameChar σ w := by
  have hc : c ≠ 0 := by
    rintro rfl
    rw [norm_zero, zero_mul] at h
    exact hw' (norm_eq_zero.mp h)
  have hcw : algebraMap K N c * w ≠ 0 := mul_ne_zero ((_root_.map_ne_zero _).mpr hc) hw
  set u := w' / (algebraMap K N c * w)
  have hu : ‖u‖ = 1 := by
    rw [norm_div, norm_mul, norm_algebraMap', ← h, div_self (norm_ne_zero_iff.mpr hw')]
  have hw'eq : w' = (algebraMap K N c * w) * u := by
    rw [mul_div_cancel₀ _ hcw]
  rw [hw'eq, tameChar_mul_right, tameChar_algebraMap_mul σ hc, tameChar_eq_one_of_norm_eq_one hσ hu,
    mul_one]

/-- The tame character is multiplicative in `σ` on the inertia subgroup. -/
theorem tameChar_mul {σ : N ≃ₐ[K] N} (hσ : σ ∈ inertiaSubgroup K N) (τ : N ≃ₐ[K] N) {w : N}
    (hw : w ≠ 0) : tameChar (σ * τ) w = tameChar σ w * tameChar τ w := by
  have hτw : τ w ≠ 0 := (_root_.map_ne_zero τ).mpr hw
  have h1 : tameChar σ (τ w) = tameChar σ w :=
    tameChar_eq_of_norm_eq hσ hw 1 (by rw [norm_one, one_mul, norm_algEquiv_apply]) hτw
  rw [← h1, tameChar, tameChar, tameChar, ← map_mul]
  congr 1
  apply Subtype.ext
  change (σ * τ) w / w = σ (τ w) / τ w * (τ w / w)
  rw [AlgEquiv.mul_apply, div_mul_div_cancel₀ hτw]

theorem tameChar_pow {σ : N ≃ₐ[K] N} (hσ : σ ∈ inertiaSubgroup K N) (n : ℕ) {w : N}
    (hw : w ≠ 0) : tameChar (σ ^ n) w = tameChar σ w ^ n := by
  induction n with
  | zero => rw [pow_zero, pow_zero, tameChar_one_apply hw]
  | succ n ih => rw [pow_succ', tameChar_mul hσ _ hw, ih, pow_succ']

/-- **The tame quotient has no `p`-torsion** (plan S5): if `σ ∈ T` and `σ ^ p ∈ V`, where `p` is
the characteristic of the residue field, then `σ ∈ V`. -/
theorem mem_wildInertiaSubgroup_of_pow_char_mem (p : ℕ) [Fact p.Prime]
    [CharP (ResidueField (unitBall K)) p] {σ : N ≃ₐ[K] N} (hσ : σ ∈ inertiaSubgroup K N)
    (hσp : σ ^ p ∈ wildInertiaSubgroup K N) : σ ∈ wildInertiaSubgroup K N := by
  have : CharP Ñ p :=
    charP_of_injective_algebraMap (algebraMap (ResidueField (unitBall K)) Ñ).injective p
  intro x hx
  have h1 : tameChar (σ ^ p) x = 1 := (tameChar_eq_one_iff hx).mpr (hσp x hx)
  rw [tameChar_pow hσ p hx] at h1
  have h2 : (tameChar σ x - 1) ^ p = 0 := by rw [sub_pow_char, h1, one_pow, sub_self]
  exact (tameChar_eq_one_iff hx).mp (sub_eq_zero.mp (pow_eq_zero_iff (Fact.out : p.Prime).ne_zero
    |>.mp h2))

/-- **Wild inertia fixes tame radicals**: if `y ^ m ∈ K` with `‖m‖ = 1`, then every `σ ∈ V`
fixes `y`. -/
theorem wildInertiaSubgroup_apply_eq_of_pow_mem {σ : N ≃ₐ[K] N}
    (hσ : σ ∈ wildInertiaSubgroup K N) {m : ℕ} (hm : ‖(m : K)‖ = 1) {y : N} {c : K}
    (hy : y ^ m = algebraMap K N c) : σ y = y := by
  rcases eq_or_ne y 0 with rfl | hy0
  · simp
  have hmN : ‖(m : N)‖ = 1 := by rw [← map_natCast (algebraMap K N), norm_algebraMap', hm]
  have hζ : (σ y / y) ^ m = 1 := by
    rw [div_pow, ← map_pow, hy, AlgEquiv.commutes, div_self]
    rw [← hy]
    exact pow_ne_zero _ hy0
  have hlt : ‖σ y / y - 1‖ < 1 := by
    rw [div_sub_one hy0, norm_div, div_lt_one (norm_pos_iff.mpr hy0)]
    exact hσ y hy0
  have := eq_one_of_pow_eq_one_of_norm_sub_lt hmN hζ hlt
  rwa [div_eq_one_iff_eq hy0] at this

end TameChar

/-- Automorphisms preserve the fixed field of a normal subgroup. -/
theorem apply_mem_fixedField_of_normal {F E : Type*} [Field F] [Field E] [Algebra F E]
    (H : Subgroup (E ≃ₐ[F] E)) [H.Normal] (σ : E ≃ₐ[F] E) {x : E} (hx : x ∈ fixedField H) :
    σ x ∈ fixedField H := by
  refine (mem_fixedField_iff _ _).mpr fun τ hτ => ?_
  have hconj : σ⁻¹ * τ * σ ∈ H := by
    have := Subgroup.Normal.conj_mem ‹_› τ hτ σ⁻¹
    rwa [inv_inv] at this
  have := (mem_fixedField_iff _ _).mp hx _ hconj
  rw [AlgEquiv.mul_apply, AlgEquiv.mul_apply] at this
  calc τ (σ x) = σ (σ⁻¹ (τ (σ x))) := by
        rw [AlgEquiv.aut_inv, AlgEquiv.apply_symm_apply]
    _ = σ x := by rw [this]

section TameCartesian

variable {K N : Type*} [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
  [NormedField N] [IsUltrametricDist N] [NormedAlgebra K N] [FiniteDimensional K N]
  [IsGalois K N]

local notation "Ñ" => ResidueField (unitBall N)

/-- When `T = Gal(N/K)`, an automorphism which moves every nonzero element of `N^V` by less than
its absolute value lies in `V` (the trace argument on `N^V` and the absence of `p`-torsion in
`T/V`). -/
theorem mem_wildInertiaSubgroup_of_forall_norm_sub_lt (hT : inertiaSubgroup K N = ⊤)
    {ρ : N ≃ₐ[K] N}
    (hρ : ∀ w ∈ fixedField (wildInertiaSubgroup K N), w ≠ 0 → ‖ρ w - w‖ < ‖w‖) :
    ρ ∈ wildInertiaSubgroup K N := by
  set V := wildInertiaSubgroup K N with hV_def
  set W := fixedField V with hW_def
  have hWρ : ∀ i : ℕ, ∀ x ∈ W, (ρ ^ i) x ∈ W :=
    fun i _ hx => apply_mem_fixedField_of_normal V _ hx
  have hpow : ∀ i : ℕ, ∀ y ∈ W, y ≠ 0 → ‖(ρ ^ i) y - y‖ < ‖y‖ := by
    intro i
    induction i with
    | zero => intro y _ hy; simpa using norm_pos_iff.mpr hy
    | succ n ih =>
      intro y hy hy0
      have hρy : (ρ ^ n) y ∈ W := hWρ n y hy
      have hρy0 : (ρ ^ n) y ≠ 0 := (_root_.map_ne_zero _).mpr hy0
      have h1 := hρ _ hρy hρy0
      rw [norm_algEquiv_apply] at h1
      calc ‖(ρ ^ (n + 1)) y - y‖ = ‖(ρ ((ρ ^ n) y) - (ρ ^ n) y) + ((ρ ^ n) y - y)‖ := by
            rw [pow_succ', AlgEquiv.mul_apply]; ring_nf
        _ ≤ max ‖ρ ((ρ ^ n) y) - (ρ ^ n) y‖ ‖(ρ ^ n) y - y‖ :=
            IsUltrametricDist.norm_add_le_max _ _
        _ < ‖y‖ := max_lt h1 (ih y hy hy0)
  set S : AddSubgroup N := W.toSubalgebra.toSubmodule.toAddSubgroup
  have key : ∀ j d : ℕ, ‖(d : N)‖ = 1 → (ρ ^ j) ^ d = 1 → ρ ^ j ∈ V := by
    intro j d hd hτd
    have hfix : ∀ x ∈ W, (ρ ^ j) x = x := by
      intro x hx
      refine eq_of_forall_norm_pow_sub_lt (ρ ^ j) S (fun y hy => hWρ j y hy) hd
        (fun y _ => by rw [hτd, AlgEquiv.one_apply]) (fun i y hy hy0 => ?_) hx
      rw [← pow_mul]
      exact hpow (j * i) y hy hy0
    have : ρ ^ j ∈ W.fixingSubgroup := (mem_fixingSubgroup_iff _ _).mpr hfix
    rwa [hW_def, fixingSubgroup_fixedField] at this
  have hfin : IsOfFinOrder ρ := isOfFinOrder_of_finite ρ
  have hn : orderOf ρ ≠ 0 := (orderOf_pos_iff.mpr hfin).ne'
  have hNorm : ∀ d : ℕ, (d : ResidueField (unitBall K)) ≠ 0 → ‖(d : N)‖ = 1 := fun d hd => by
    rw [← map_natCast (algebraMap K N), norm_algebraMap', norm_natCast_eq_one_iff]
    exact hd
  obtain ⟨p, hp⟩ : ∃ p, ExpChar (ResidueField (unitBall K)) p :=
    ⟨_, ringExpChar.expChar _⟩
  cases hp with
  | zero =>
    have := key 1 (orderOf ρ) (hNorm _ (Nat.cast_ne_zero.mpr hn))
      (by rw [pow_one, pow_orderOf_eq_one])
    rwa [pow_one] at this
  | prime hprime =>
    have : Fact p.Prime := ⟨hprime⟩
    obtain ⟨k, m, hpm, hnm⟩ := Nat.exists_eq_pow_mul_and_not_dvd hn p hprime.ne_one
    have hk : ρ ^ p ^ k ∈ V := by
      refine key (p ^ k) m (hNorm m ?_) ?_
      · rwa [Ne, CharP.cast_eq_zero_iff _ p]
      · rw [← pow_mul, ← hnm, pow_orderOf_eq_one]
    have hdesc : ∀ j : ℕ, ρ ^ p ^ j ∈ V → ρ ∈ V := by
      intro j
      induction j with
      | zero => intro h; rwa [pow_zero, pow_one] at h
      | succ j ih =>
        intro h
        apply ih
        refine mem_wildInertiaSubgroup_of_pow_char_mem p (by rw [hT]; trivial) ?_
        rwa [← pow_mul, ← pow_succ]
    exact hdesc k hk

omit [FiniteDimensional K N] in
theorem tameChar_inv_mul {σ τ : N ≃ₐ[K] N} (hT : inertiaSubgroup K N = ⊤) {w : N} (hw : w ≠ 0)
    (h : tameChar σ w = tameChar τ w) : tameChar (σ⁻¹ * τ) w = 1 := by
  have hmem : ∀ ρ : N ≃ₐ[K] N, ρ ∈ inertiaSubgroup K N := fun ρ => by rw [hT]; trivial
  rw [tameChar_mul (hmem _) _ hw, ← h, ← tameChar_mul (hmem _) _ hw, inv_mul_cancel,
    tameChar_one_apply hw]

/-- **The tame part is totally ramified** (counting by characters): when `T = Gal(N/K)`,
`[N^V : K] ≤ e_{N^V/K}`. -/
theorem finrank_le_ramificationIndex_fixedField (hT : inertiaSubgroup K N = ⊤) :
    Module.finrank K (fixedField (wildInertiaSubgroup K N)) ≤
      ramificationIndex K (fixedField (wildInertiaSubgroup K N)) := by
  classical
  set V := wildInertiaSubgroup K N with hV_def
  set W := fixedField V with hW_def
  have hmem : ∀ ρ : N ≃ₐ[K] N, ρ ∈ inertiaSubgroup K N := fun ρ => by rw [hT]; trivial
  set Q := ValueGroupQuotient K W
  have : Fintype Q := Fintype.ofFinite Q
  set s : Q → Wˣ := Function.surjInv (valueClass_surjective (K := K) (L := W)) with hs_def
  have hs : ∀ q, valueClass K W (s q) = q :=
    Function.surjInv_eq (valueClass_surjective (K := K) (L := W))
  -- the tame character only depends on the value class
  have hinv : ∀ (σ : N ≃ₐ[K] N) (w w' : Wˣ), valueClass K W w = valueClass K W w' →
      tameChar σ ((w' : W) : N) = tameChar σ ((w : W) : N) := by
    intro σ w w' h
    obtain ⟨c, hc⟩ := valueClass_eq_valueClass_iff.mp h
    have hw : ((w : W) : N) ≠ 0 := fun h0 => w.ne_zero (Subtype.ext h0)
    have hw' : ((w' : W) : N) ≠ 0 := fun h0 => w'.ne_zero (Subtype.ext h0)
    exact tameChar_eq_of_norm_eq (hmem σ) hw c hc hw'
  -- characters of `Q`
  let U : (N ≃ₐ[K] N) → (Q →* Ñ) := fun σ =>
    { toFun := fun q => tameChar σ ((s q : W) : N)
      map_one' := by
        rw [hinv σ 1 (s 1) (by rw [hs, map_one])]
        exact tameChar_apply_one σ
      map_mul' := fun q q' => by
        rw [hinv σ (s q * s q') (s (q * q')) (by rw [hs, map_mul, hs, hs])]
        simp only [Units.val_mul, MulMemClass.coe_mul]
        exact tameChar_mul_right σ _ _ }
  have hU : ∀ (σ : N ≃ₐ[K] N) (w : Wˣ), U σ (valueClass K W w) = tameChar σ ((w : W) : N) :=
    fun σ w => hinv σ w (s (valueClass K W w)) (by rw [hs])
  set F : (N ≃ₐ[K] N) ⧸ V → (Q →* Ñ) := fun c => U c.out
  have hF : Function.Injective F := by
    intro c₁ c₂ h12
    have hchar : ∀ w : Wˣ, tameChar c₁.out ((w : W) : N) = tameChar c₂.out ((w : W) : N) := by
      intro w
      rw [← hU, ← hU]
      exact congrArg (fun f : Q →* Ñ => f (valueClass K W w)) h12
    have hρ : c₁.out⁻¹ * c₂.out ∈ V := by
      refine mem_wildInertiaSubgroup_of_forall_norm_sub_lt hT fun w hw hw0 => ?_
      have hwW : (⟨w, hw⟩ : W) ≠ 0 := fun h0 => hw0 (congrArg Subtype.val h0)
      have := tameChar_inv_mul hT hw0 (hchar (Units.mk0 ⟨w, hw⟩ hwW))
      exact (tameChar_eq_one_iff hw0).mp this
    rw [← QuotientGroup.out_eq' c₁, ← QuotientGroup.out_eq' c₂]
    exact QuotientGroup.eq.mpr hρ
  have hli : LinearIndependent Ñ (fun c => (F c : Q → Ñ)) :=
    (linearIndependent_monoidHom Q Ñ).comp F hF
  have hcard := hli.fintype_card_le_finrank
  rw [Module.finrank_fintype_fun_eq_card] at hcard
  have hidx : Module.finrank K W = V.index := by
    rw [finrank_eq_fixingSubgroup_index, hW_def, fixingSubgroup_fixedField]
  rw [ramificationIndex_eq_card, Nat.card_eq_fintype_card, hidx, Subgroup.index,
    Nat.card_eq_fintype_card]
  exact hcard


/-- **The tame part is totally ramified and Cartesian** (plan S5): when `T = Gal(N/K)`,
`e_{N^V/K} = [N^V : K]`. -/
theorem ramificationIndex_fixedField_wildInertiaSubgroup (hT : inertiaSubgroup K N = ⊤) :
    ramificationIndex K (fixedField (wildInertiaSubgroup K N)) =
      Module.finrank K (fixedField (wildInertiaSubgroup K N)) :=
  le_antisymm ramificationIndex_le_finrank (finrank_le_ramificationIndex_fixedField hT)

/-- When `T = Gal(N/K)`, the degree `[N^V : K]` is prime to the residue characteristic. -/
theorem not_dvd_finrank_fixedField_wildInertiaSubgroup (hT : inertiaSubgroup K N = ⊤) (p : ℕ)
    [Fact p.Prime] [CharP (ResidueField (unitBall K)) p] :
    ¬ p ∣ Module.finrank K (fixedField (wildInertiaSubgroup K N)) := by
  intro hdvd
  set V := wildInertiaSubgroup K N with hV_def
  have hidx : Module.finrank K (fixedField V) = Nat.card ((N ≃ₐ[K] N) ⧸ V) := by
    rw [finrank_eq_fixingSubgroup_index, fixingSubgroup_fixedField, Subgroup.index]
  rw [hidx] at hdvd
  obtain ⟨x, hx⟩ := exists_prime_orderOf_dvd_card' p hdvd
  obtain ⟨σ, rfl⟩ := QuotientGroup.mk_surjective x
  have h1 : σ ^ p ∈ V := by
    rw [← QuotientGroup.eq_one_iff, QuotientGroup.mk_pow, ← hx, pow_orderOf_eq_one]
  have h2 : σ ∈ V := mem_wildInertiaSubgroup_of_pow_char_mem p (by rw [hT]; trivial) h1
  have h3 : ((σ : (N ≃ₐ[K] N) ⧸ V)) = 1 := (QuotientGroup.eq_one_iff σ).mpr h2
  rw [h3, orderOf_one] at hx
  exact (Fact.out : p.Prime).one_lt.ne hx

/-- When `T = Gal(N/K)`, `‖[N^V : K]‖ = 1`. -/
theorem norm_finrank_fixedField_wildInertiaSubgroup (hT : inertiaSubgroup K N = ⊤) :
    ‖(Module.finrank K (fixedField (wildInertiaSubgroup K N)) : K)‖ = 1 := by
  rw [norm_natCast_eq_one_iff]
  obtain ⟨p, hp⟩ : ∃ p, ExpChar (ResidueField (unitBall K)) p := ⟨_, ringExpChar.expChar _⟩
  cases hp with
  | zero => exact Nat.cast_ne_zero.mpr Module.finrank_pos.ne'
  | prime hprime =>
    have : Fact p.Prime := ⟨hprime⟩
    rw [Ne, CharP.cast_eq_zero_iff _ p]
    exact not_dvd_finrank_fixedField_wildInertiaSubgroup hT p

/-- When `T = Gal(N/K)`, the residue field of `N^V` is that of `K`: `f_{N^V/K} = 1`. -/
theorem inertiaDegree_fixedField_wildInertiaSubgroup (hT : inertiaSubgroup K N = ⊤) :
    inertiaDegree K (fixedField (wildInertiaSubgroup K N)) = 1 := by
  have h1 := ramificationIndex_mul_inertiaDegree_le (K := K)
    (L := fixedField (wildInertiaSubgroup K N))
  rw [ramificationIndex_fixedField_wildInertiaSubgroup hT] at h1
  have hpos : 0 < Module.finrank K (fixedField (wildInertiaSubgroup K N)) := Module.finrank_pos
  have hf : 0 < inertiaDegree K (fixedField (wildInertiaSubgroup K N)) := by
    rw [inertiaDegree_def]
    exact Module.finrank_pos
  nlinarith

/-- When `T = Gal(N/K)`, `N^V / K` is Cartesian. -/
theorem isCartesian_fixedField_wildInertiaSubgroup (hT : inertiaSubgroup K N = ⊤) :
    IsCartesian K (fixedField (wildInertiaSubgroup K N)) := by
  unfold IsCartesian
  rw [ramificationIndex_fixedField_wildInertiaSubgroup hT,
    inertiaDegree_fixedField_wildInertiaSubgroup hT, mul_one]
end TameCartesian

end DeJongAlterations.StableModification.Valuation.Analytic

/-! ### The Kummer step for annulus fields -/

namespace DeJongAlterations.StableModification.Valuation

section Annulus

variable {k K : Type*} [NormedField k] [IsAlgClosed k] [NormedField K] [IsUltrametricDist K]
  [NormedAlgebra k K] {z : K}

/-- In an annulus field every nonzero absolute value is `‖a‖ ‖z‖ ^ j` with `a ∈ k^×`. -/
theorem IsAnnulusGenerator.exists_norm_eq_mul_zpow (hz : IsAnnulusGenerator k z) {c : K}
    (hc : c ≠ 0) : ∃ a : k, a ≠ 0 ∧ ∃ j : ℤ, ‖c‖ = ‖a‖ * ‖z‖ ^ j := by
  obtain ⟨a, j, h⟩ := hz.exists_norm_sub_lt hc
  have h1 : ‖a • z ^ j‖ = ‖c‖ := norm_eq_of_norm_sub_lt_norm h
  rw [norm_smul, norm_zpow] at h1
  refine ⟨a, ?_, j, h1.symm⟩
  rintro rfl
  rw [norm_zero, zero_mul] at h1
  exact hc (norm_eq_zero.mp h1.symm)

omit [IsUltrametricDist K] in
/-- The exponent `j` in `‖a‖ ‖z‖ ^ j` is unique. -/
theorem IsAnnulusGenerator.eq_of_norm_mul_zpow_eq (hz : IsAnnulusGenerator k z) {a a' : k}
    (ha : a ≠ 0) {j j' : ℤ} (h : ‖a‖ * ‖z‖ ^ j = ‖a'‖ * ‖z‖ ^ j') : j = j' := by
  by_contra hne
  have hpos := hz.norm_pos
  have hapos : 0 < ‖a‖ := norm_pos_iff.mpr ha
  apply hz.norm_zpow_ne (sub_ne_zero.mpr hne) (a' / a)
  rw [norm_div, zpow_sub₀ hpos.ne', eq_div_iff hapos.ne', div_mul_eq_mul_div, div_eq_iff
    (zpow_pos hpos _).ne', mul_comm, h]

open DeJongAlterations.StableModification.Valuation.Analytic in
/-- **An `m`-th root of `‖z‖`** (Step 1 of the Kummer step): if `L/K` is a finite extension of
an annulus field with `e_{L/K} = m`, then `‖z‖ = ‖x‖ ^ m` for some `x ∈ L`. -/
theorem IsAnnulusGenerator.exists_norm_pow_eq {L : Type*} [NormedField L] [IsUltrametricDist L]
    [NormedAlgebra K L] [FiniteDimensional K L] (hz : IsAnnulusGenerator k z) {m : ℕ}
    (hm : 0 < m) (he : ramificationIndex K L = m) : ∃ x : L, ‖x‖ ^ m = ‖z‖ := by
  classical
  have : NeZero m := ⟨hm.ne'⟩
  have hzpos : 0 < ‖z‖ := hz.norm_pos
  set Q := ValueGroupQuotient K L
  have : Fintype Q := Fintype.ofFinite Q
  have hQ : Fintype.card Q = m := by
    rw [← Nat.card_eq_fintype_card, ← ramificationIndex_eq_card, he]
  -- `‖w‖ ^ m ∈ |K^×|`
  have hpowK : ∀ w : Lˣ, ∃ c : K, c ≠ 0 ∧ ‖(w : L)‖ ^ m = ‖c‖ := by
    intro w
    have h1 : valueClass K L (w ^ m) = 1 := by rw [map_pow, ← hQ, pow_card_eq_one]
    have h2 : valueClass K L 1 = valueClass K L (w ^ m) := by rw [map_one, h1]
    obtain ⟨c, hc⟩ := valueClass_eq_valueClass_iff.mp h2
    simp only [Units.val_pow_eq_pow_val, norm_pow, Units.val_one, norm_one, mul_one] at hc
    refine ⟨c, ?_, hc⟩
    rintro rfl
    rw [norm_zero] at hc
    exact w.ne_zero (norm_eq_zero.mp (pow_eq_zero_iff hm.ne' |>.mp hc))
  have hj : ∀ w : Lˣ, ∃ a : k, a ≠ 0 ∧ ∃ j : ℤ, ‖(w : L)‖ ^ m = ‖a‖ * ‖z‖ ^ j := fun w => by
    obtain ⟨c, hc0, hc⟩ := hpowK w
    obtain ⟨a, ha, j, hja⟩ := hz.exists_norm_eq_mul_zpow hc0
    exact ⟨a, ha, j, hc.trans hja⟩
  choose a ha j hjw using hj
  -- the class of `w` is determined by `j w mod m`
  have hclass : ∀ w w' : Lˣ, ((j w : ℤ) : ZMod m) = ((j w' : ℤ) : ZMod m) →
      valueClass K L w = valueClass K L w' := by
    intro w w' h
    rw [ZMod.intCast_eq_intCast_iff_dvd_sub] at h
    obtain ⟨i, hi⟩ := h
    obtain ⟨b, hb⟩ := IsAlgClosed.exists_pow_nat_eq (a w' / a w) hm
    refine valueClass_eq_valueClass_iff.mpr ⟨algebraMap k K b * z ^ i, ?_⟩
    have hw0 : 0 < ‖(w : L)‖ := norm_pos_iff.mpr w.ne_zero
    refine (pow_left_inj₀ (norm_nonneg _) (by positivity) hm.ne').mp ?_
    have hapos : 0 < ‖a w‖ := norm_pos_iff.mpr (ha w)
    have hj' : j w' = j w + m * i := by linarith
    have hbm : ‖b‖ ^ m = ‖a w'‖ / ‖a w‖ := by rw [← norm_pow, hb, norm_div]
    have hzi : (‖z‖ ^ i) ^ m = ‖z‖ ^ ((m : ℤ) * i) := by
      rw [← zpow_natCast, ← zpow_mul, mul_comm]
    calc ‖(w' : L)‖ ^ m = ‖a w'‖ * ‖z‖ ^ j w' := hjw w'
      _ = (‖b‖ ^ m) * (‖z‖ ^ i) ^ m * (‖a w‖ * ‖z‖ ^ j w) := by
          rw [hbm, hzi, hj', zpow_add₀ hzpos.ne']
          field_simp
      _ = (‖algebraMap k K b * z ^ i‖ * ‖(w : L)‖) ^ m := by
          rw [norm_mul, norm_algebraMap', norm_zpow, mul_pow, mul_pow, hjw w]
  -- the induced map `Q → ZMod m` is injective, hence bijective
  set s : Q → Lˣ := Function.surjInv (valueClass_surjective (K := K) (L := L)) with hs_def
  have hs : ∀ q, valueClass K L (s q) = q :=
    Function.surjInv_eq (valueClass_surjective (K := K) (L := L))
  set f : Q → ZMod m := fun q => ((j (s q) : ℤ) : ZMod m)
  have hfinj : Function.Injective f := fun q q' h => by
    rw [← hs q, ← hs q']
    exact hclass _ _ h
  have hfbij : Function.Bijective f :=
    (Fintype.bijective_iff_injective_and_card f).mpr ⟨hfinj, by rw [hQ, ZMod.card]⟩
  obtain ⟨q, hq⟩ := hfbij.2 1
  set w := s q
  have h1 : ((j w : ℤ) : ZMod m) = ((1 : ℤ) : ZMod m) := by rw [Int.cast_one]; exact hq
  rw [ZMod.intCast_eq_intCast_iff_dvd_sub] at h1
  obtain ⟨i, hi⟩ := h1
  obtain ⟨b, hb⟩ := IsAlgClosed.exists_pow_nat_eq (a w) hm
  have hb0 : b ≠ 0 := by
    rintro rfl
    rw [zero_pow hm.ne'] at hb
    exact ha w hb.symm
  set c : K := (algebraMap k K b)⁻¹ * z ^ i
  refine ⟨algebraMap K L c * (w : L), ?_⟩
  have hj' : j w = 1 - m * i := by linarith
  have hapos : 0 < ‖a w‖ := norm_pos_iff.mpr (ha w)
  have hbm : ‖b‖ ^ m = ‖a w‖ := by rw [← norm_pow, hb]
  have hzi : (‖z‖ ^ i) ^ m = ‖z‖ ^ ((m : ℤ) * i) := by
    rw [← zpow_natCast, ← zpow_mul, mul_comm]
  calc ‖algebraMap K L c * (w : L)‖ ^ m = (‖b‖ ^ m)⁻¹ * (‖z‖ ^ i) ^ m * ‖(w : L)‖ ^ m := by
        rw [norm_mul, norm_algebraMap', norm_mul, norm_inv, norm_algebraMap', norm_zpow, mul_pow,
          mul_pow, inv_pow]
    _ = ‖z‖ := by
        rw [hbm, hzi, hjw w, hj', zpow_sub₀ hzpos.ne', zpow_one]
        field_simp


open DeJongAlterations.StableModification.Valuation.Analytic in
/-- If `‖y‖ ^ m = ‖z‖` for an annulus generator `z`, then `1, y, …, y^{m-1}` are linearly
independent over `K`. -/
theorem IsAnnulusGenerator.linearIndependent_pow {L : Type*} [NormedField L]
    [IsUltrametricDist L] [NormedAlgebra K L] (hz : IsAnnulusGenerator k z) {m : ℕ} {y : L}
    (hy0 : y ≠ 0) (hy : ‖y‖ ^ m = ‖z‖) :
    LinearIndependent K (fun p : Unit × Fin m => ((1 : unitBall L) : L) *
      ((Units.mk0 y hy0 ^ (p.2 : ℕ) : Lˣ) : L)) := by
  refine linearIndependent_reps (K := K) (fun i : Fin m => Units.mk0 y hy0 ^ (i : ℕ))
    fun i i' h => ?_
  have hzpos := hz.norm_pos
  have hypos : 0 < ‖y‖ := norm_pos_iff.mpr hy0
  obtain ⟨c, hc⟩ := valueClass_eq_valueClass_iff.mp h
  simp only [Units.val_pow_eq_pow_val, Units.val_mk0, norm_pow] at hc
  have hc0 : c ≠ 0 := by
    rintro rfl
    rw [norm_zero, zero_mul] at hc
    exact (pow_pos hypos _).ne' hc
  obtain ⟨a, ha, j, hja⟩ := hz.exists_norm_eq_mul_zpow hc0
  -- raise to the `m`-th power
  have h1 : (‖y‖ ^ (i' : ℕ)) ^ m = (‖c‖ * ‖y‖ ^ (i : ℕ)) ^ m := by rw [hc]
  have h2 : (‖y‖ ^ (i' : ℕ)) ^ m = ‖z‖ ^ ((i' : ℕ) : ℤ) := by
    rw [← pow_mul, mul_comm, pow_mul, hy, zpow_natCast]
  have h3 : (‖c‖ * ‖y‖ ^ (i : ℕ)) ^ m = ‖a ^ m‖ * ‖z‖ ^ ((m : ℤ) * j + ((i : ℕ) : ℤ)) := by
    have e1 : (‖y‖ ^ (i : ℕ)) ^ m = ‖z‖ ^ ((i : ℕ) : ℤ) := by
      rw [← pow_mul, mul_comm, pow_mul, hy, zpow_natCast]
    have e2 : (‖z‖ ^ j) ^ m = ‖z‖ ^ ((m : ℤ) * j) := by
      rw [← zpow_natCast, ← zpow_mul, mul_comm]
    rw [mul_pow, e1, hja, mul_pow, e2, norm_pow, zpow_add₀ hzpos.ne']
    ring
  have key : ‖(1 : k)‖ * ‖z‖ ^ ((i' : ℕ) : ℤ) =
      ‖a ^ m‖ * ‖z‖ ^ ((m : ℤ) * j + ((i : ℕ) : ℤ)) := by
    rw [norm_one, one_mul, ← h2, h1, h3]
  have hj := hz.eq_of_norm_mul_zpow_eq one_ne_zero key
  have hi1 := i.2
  have hi2 := i'.2
  have : (i : ℕ) = (i' : ℕ) := by
    rcases lt_trichotomy j 0 with hj0 | hj0 | hj0
    · nlinarith
    · subst hj0; omega
    · nlinarith
  exact Fin.ext this

end Annulus

end DeJongAlterations.StableModification.Valuation

namespace DeJongAlterations.StableModification.Valuation.Analytic

section KummerStepMain

variable {k K N : Type*} [NormedField k] [IsAlgClosed k] [NontriviallyNormedField K]
  [IsUltrametricDist K] [CompleteSpace K] [NormedAlgebra k K] {z : K} [NormedField N]
  [IsUltrametricDist N] [NormedAlgebra K N] [FiniteDimensional K N] [IsGalois K N]
  [NormedAlgebra k N] [IsScalarTower k K N]

/-- **The Kummer step for annulus fields** (plan S5(e)). Let `k ⊆ K` be an algebraically closed
subfield, `z` an annulus generator of `K` over `k`, and `N/K` finite Galois such that every
element of `N°` is congruent modulo `N°°` to an element of `k°`. Then `m = [N^V : K]` satisfies
`‖m‖ = 1`, and `N^V = K(y)` with `y ^ m = z`. -/
theorem exists_pow_eq_and_fixedField_eq_adjoin (hz : IsAnnulusGenerator k z)
    (hres : ∀ x : N, ‖x‖ ≤ 1 → ∃ c : k, ‖c‖ ≤ 1 ∧ ‖x - algebraMap k N c‖ < 1) :
    ‖(Module.finrank K (fixedField (wildInertiaSubgroup K N)) : K)‖ = 1 ∧
      ∃ y : N, y ^ Module.finrank K (fixedField (wildInertiaSubgroup K N)) = algebraMap K N z ∧
        fixedField (wildInertiaSubgroup K N) = K⟮y⟯ := by
  have hT : inertiaSubgroup K N = ⊤ := by
    refine inertiaSubgroup_eq_top_of_forall fun x hx => ?_
    obtain ⟨c, hc1, hc⟩ := hres x hx
    refine ⟨algebraMap k K c, by rwa [norm_algebraMap'], ?_⟩
    rwa [← IsScalarTower.algebraMap_apply]
  set V := wildInertiaSubgroup K N with hV_def
  set W := fixedField V with hW_def
  set m := Module.finrank K W with hm_def
  have hm : ‖(m : K)‖ = 1 := norm_finrank_fixedField_wildInertiaSubgroup hT
  have hmpos : 0 < m := Module.finrank_pos
  have he : ramificationIndex K W = m := ramificationIndex_fixedField_wildInertiaSubgroup hT
  have hzpos := hz.norm_pos
  have : CompleteSpace N := FiniteDimensional.complete K N
  -- Step 1: `x ∈ W` with `‖x‖ ^ m = ‖z‖`
  obtain ⟨x, hx⟩ := hz.exists_norm_pow_eq (L := W) hmpos he
  have hxN : ‖(x : N)‖ ^ m = ‖z‖ := hx
  have hx0 : (x : N) ≠ 0 := by
    intro h0
    rw [h0, norm_zero, zero_pow hmpos.ne'] at hxN
    exact hzpos.ne hxN
  -- Step 2: an `m`-th root of `z`
  set zN := algebraMap K N z with hzN_def
  have hzN : ‖zN‖ = ‖z‖ := norm_algebraMap' N z
  have hzN0 : zN ≠ 0 := by
    intro h0
    rw [h0, norm_zero] at hzN
    exact hzpos.ne' hzN.symm
  set u := (x : N) ^ m / zN with hu_def
  have hu : ‖u‖ = 1 := by
    rw [hu_def, norm_div, norm_pow, hxN, hzN, div_self hzpos.ne']
  have hu0 : u ≠ 0 := fun h0 => by rw [h0, norm_zero] at hu; exact zero_ne_one hu
  obtain ⟨a₀, -, ha₀⟩ := hres u hu.le
  have ha₀n : ‖a₀‖ = 1 := by
    have := norm_eq_of_norm_sub_lt (x := u) (y := algebraMap k N a₀) (by rwa [hu])
    rwa [norm_algebraMap', hu] at this
  obtain ⟨c, hc⟩ := IsAlgClosed.exists_pow_nat_eq a₀ hmpos
  have hcn : ‖c‖ = 1 := by
    have : ‖c‖ ^ m = 1 := by rw [← norm_pow, hc, ha₀n]
    exact (pow_eq_one_iff_of_nonneg (norm_nonneg _) hmpos.ne').mp this
  set cN := algebraMap k N c with hcN_def
  have hcN : ‖cN‖ = 1 := by rw [hcN_def, norm_algebraMap', hcn]
  have hcN0 : cN ≠ 0 := fun h0 => by rw [h0, norm_zero] at hcN; exact zero_ne_one hcN
  have hcNm : cN ^ m = algebraMap k N a₀ := by rw [hcN_def, ← map_pow, hc]
  set v := u / cN ^ m with hv_def
  have hvn : ‖v‖ = 1 := by rw [hv_def, norm_div, norm_pow, hcN, one_pow, div_one, hu]
  have hv : ‖v - 1‖ < 1 := by
    rw [hv_def, div_sub_one (pow_ne_zero _ hcN0), norm_div, norm_pow, hcN, one_pow, div_one,
      hcNm]
    exact ha₀
  -- Hensel's lemma for `X ^ m - v`
  set v₁ : unitBall N := ⟨v, mem_unitBall.mpr hvn.le⟩
  set F : (unitBall N)[X] := X ^ m - C v₁ with hF_def
  have hFmonic : F.Monic := by
    rw [hF_def]
    exact monic_X_pow_sub_C _ hmpos.ne'
  have hF1 : ‖((F.eval 1 : unitBall N) : N)‖ < 1 := by
    simpa [hF_def, v₁, norm_sub_rev] using hv
  have hFd : IsUnit (F.derivative.eval 1) := by
    rw [isUnit_unitBall_iff]
    have : ((F.derivative.eval 1 : unitBall N) : N) = (m : N) := by
      simp [hF_def, derivative_X_pow]
    rw [this, ← map_natCast (algebraMap K N), norm_algebraMap', hm]
  obtain ⟨t, ht, -⟩ := exists_isRoot_norm_sub_le F hFmonic 1 hF1 hFd
  have htN : (t : N) ^ m = v := by
    have := congrArg Subtype.val ht.eq_zero
    simpa [hF_def, v₁, sub_eq_zero] using this
  have ht0 : (t : N) ≠ 0 := by
    intro h0
    rw [h0, zero_pow hmpos.ne'] at htN
    rw [← htN, norm_zero] at hvn
    exact zero_ne_one hvn
  set y := (x : N) / (cN * t) with hy_def
  have hy : y ^ m = zN := by
    rw [hy_def, div_pow, mul_pow, htN, hv_def, mul_div_cancel₀ _ (pow_ne_zero _ hcN0), hu_def,
      div_div_cancel₀ (pow_ne_zero _ hx0)]
  have hyW : y ∈ W := (mem_fixedField_iff _ _).mpr fun σ hσ =>
    wildInertiaSubgroup_apply_eq_of_pow_mem hσ hm hy
  -- Step 3: `[K(y) : K] ≥ m`
  have hy0 : y ≠ 0 := by
    rw [hy_def]
    exact div_ne_zero hx0 (mul_ne_zero hcN0 ht0)
  have hyn : ‖y‖ ^ m = ‖z‖ := by rw [← norm_pow, hy, hzN]
  have hli := hz.linearIndependent_pow (K := K) hy0 hyn
  have hge : m ≤ Module.finrank K K⟮y⟯ := by
    set g : Unit × Fin m → K⟮y⟯ := fun p => AdjoinSimple.gen K y ^ (p.2 : ℕ)
    have hcomp : (K⟮y⟯.val : K⟮y⟯ →ₐ[K] N).toLinearMap ∘ g = fun p : Unit × Fin m =>
        ((1 : unitBall N) : N) * ((Units.mk0 y hy0 ^ (p.2 : ℕ) : Nˣ) : N) := by
      funext p
      simp [g]
    have hlig : LinearIndependent K g := LinearIndependent.of_comp _ (hcomp ▸ hli)
    have := hlig.fintype_card_le_finrank
    simpa using this
  refine ⟨hm, y, hy, (IntermediateField.eq_of_le_of_finrank_le (adjoin_simple_le_iff.mpr hyW)
    ?_).symm⟩
  exact hge
end KummerStepMain

end DeJongAlterations.StableModification.Valuation.Analytic
