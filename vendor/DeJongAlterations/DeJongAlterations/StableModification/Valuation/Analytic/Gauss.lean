import DeJongAlterations.StableModification.Valuation.Analytic.CoefficientField

/-!
# Gauss generators: the type 2 field `\widehat{k(z)}`

Let `k` be a non-archimedean field and `K` a non-archimedean extension of `k`. An element `z ∈ K` is
a *Gauss element* over `k` if `‖z‖ ≤ 1` and `‖g(z)‖ = maxᵢ ‖gᵢ‖` for every `g = ∑ gᵢ Xⁱ ∈ k[X]`
(the absolute value induced on `k[z]` is the Gauss norm), and a *Gauss generator* of `K` if moreover
`k(z)` is dense in `K`. This is the type 2 field `K ≅ \widehat{Frac(k{T})}` of Temkin, *Stable
modification of relative curves*, J. Algebraic Geom. 19 (2010), §6.2 (`semi-stable.tex`, lines
3709–3712), whose norm on `k[T]` is the Gauss norm. Neither field is assumed complete.

## Main definitions

* `IsGaussElement k z`, `IsGaussGenerator k z`.

## Main results

* `IsGaussElement.norm_aeval_le`, `IsGaussElement.norm_aeval_lt`,
  `IsGaussElement.exists_norm_aeval_eq`, `IsGaussElement.norm_sub_algebraMap`
  (`‖z - a‖ = max 1 ‖a‖`), `IsGaussElement.transcendental`, `IsGaussElement.map`: the Gauss
  formula and its consequences.
* `IsGaussElement.transcendental_residue`, `isGaussElement_of_transcendental_residue`: `z` is a
  Gauss element iff `‖z‖ ≤ 1` and `z̃` is transcendental over `k̃`.
* `IsGaussElement.adjoin_le_unitBall`, `IsGaussElement.residue_mem_adjoin`: for a subfield
  `k₀ ⊆ k°`, the field `k₀(z)` lies in `K°` and its residues lie in `k̃(z̃)`.
* `IsGaussGenerator.isCoefficientField_adjoin`, `IsGaussGenerator.adjoin_residue_eq_top`: if `k₀`
  is a coefficient field of `k`, then `k₀(z)` is a coefficient field of `K`; so `K̃ = k̃(z̃)`.
* `IsGaussGenerator.exists_norm_eq`: `|K^×| = |k^×|`.
* `inv_sub_mem_topologicalClosure`, `dense_adjoin_of_isCoefficientField`: in a finite extension
  `L` of `K` with `[L : K] = [L̃ : K̃]`, the `k`-algebra generated by a coefficient field `L₀ ∋ z`
  containing a coefficient field `k₀` of `k` is dense (it contains the inverses `(z - a)⁻¹`, hence
  `k(z)`, hence `K`, and a lift to `L₀` of a `K̃`-basis of `L̃`). This replaces Temkin's
  `L₀ ⊗̂_{k₀} k ≅ L` (lines 3808–3810).

## References

Blueprint `sm-val-onedim-type2.tex`: `def:sm-an-gauss-generator`, `lem:sm-an-gauss-field`,
`lem:sm-an-type2-dense`.
-/

noncomputable section

open IsLocalRing Polynomial Module
open scoped IntermediateField

namespace DeJongAlterations.StableModification.Valuation.Analytic

section Defs

variable (k : Type*) {K : Type*} [NormedField k] [NormedField K] [NormedAlgebra k K]

/-- `z` is a **Gauss element** of `K` over `k`: `‖z‖ ≤ 1` and `‖gᵢ‖ ≤ ‖g(z)‖` for every
polynomial `g = ∑ gᵢ Xⁱ ∈ k[X]`; in a non-archimedean `K` this says `‖g(z)‖ = maxᵢ ‖gᵢ‖`. -/
structure IsGaussElement (z : K) : Prop where
  /-- `‖z‖ ≤ 1`. -/
  norm_le_one : ‖z‖ ≤ 1
  /-- Every coefficient of `g` is bounded by `‖g(z)‖`. -/
  norm_coeff_le : ∀ (g : k[X]) (i : ℕ), ‖g.coeff i‖ ≤ ‖aeval z g‖

/-- `z` is a **Gauss generator** of `K` over `k`: a Gauss element such that `k(z)` is dense in
`K` (Temkin's type 2 field `K ≅ \widehat{Frac(k{T})}`, `z = T`). -/
structure IsGaussGenerator (z : K) : Prop extends IsGaussElement k z where
  /-- `k(z)` is dense in `K`. -/
  dense_adjoin : Dense (k⟮z⟯ : Set K)

end Defs

/-! ### Polynomials over the unit ball -/

section UnitBallPolynomial

variable {k K : Type*} [NormedField k] [IsUltrametricDist k] [NormedField K] [IsUltrametricDist K]
  [NormedAlgebra k K]

/-- A polynomial over `k°` evaluated in `K°`, computed in `K`. -/
theorem coe_aeval_unitBall (G : (unitBall k)[X]) (x : unitBall K) :
    ((aeval x G : unitBall K) : K) = aeval (x : K) (G.map (unitBall k).subtype) := by
  change (unitBall K).subtype (aeval x G) = _
  rw [aeval_def, hom_eval₂, aeval_def, eval₂_map]
  rfl

/-- Evaluation commutes with the residue maps. -/
theorem residue_aeval_unitBall (G : (unitBall k)[X]) (x : unitBall K) :
    residue (unitBall K) (aeval x G) =
      aeval (residue (unitBall K) x) (G.map (residue (unitBall k))) := by
  rw [aeval_def, hom_eval₂, aeval_def, eval₂_map]
  rfl

/-- A polynomial over `k` with coefficients in `k°` comes from `k°[X]`. -/
theorem exists_map_unitBall_eq (g : k[X]) (hg : ∀ n, ‖g.coeff n‖ ≤ 1) :
    ∃ G : (unitBall k)[X], G.map (unitBall k).subtype = g :=
  (mem_lifts g).mp ((lifts_iff_coeff_lifts g).mpr fun n ↦
    ⟨⟨g.coeff n, mem_unitBall.mpr (hg n)⟩, rfl⟩)

end UnitBallPolynomial

namespace IsGaussElement

/-! ### The Gauss formula -/

section Formula

variable {k K : Type*} [NormedField k] [NormedField K] [IsUltrametricDist K] [NormedAlgebra k K]
  {z : K} (hz : IsGaussElement k z)
include hz

omit [IsUltrametricDist K] in
/-- A monomial `c zⁱ` has norm at most `‖c‖`. -/
theorem norm_smul_pow_le (c : k) (i : ℕ) : ‖c • z ^ i‖ ≤ ‖c‖ := by
  rw [norm_smul, norm_pow]
  calc ‖c‖ * ‖z‖ ^ i ≤ ‖c‖ * 1 :=
        mul_le_mul_of_nonneg_left (pow_le_one₀ (norm_nonneg z) hz.norm_le_one) (norm_nonneg _)
    _ = ‖c‖ := mul_one _

/-- **The Gauss formula, upper bound**: `‖g(z)‖ ≤ r` if all coefficients have norm `≤ r`. -/
theorem norm_aeval_le (g : k[X]) {r : ℝ} (hr : 0 ≤ r) (h : ∀ i, ‖g.coeff i‖ ≤ r) :
    ‖aeval z g‖ ≤ r := by
  rw [aeval_eq_sum_range]
  exact IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg hr fun i _ ↦
    (hz.norm_smul_pow_le _ i).trans (h i)

/-- **The Gauss formula, strict upper bound**: `‖g(z)‖ < r` if all coefficients have norm
`< r`. -/
theorem norm_aeval_lt (g : k[X]) {r : ℝ} (hr : 0 < r) (h : ∀ i, ‖g.coeff i‖ < r) :
    ‖aeval z g‖ < r := by
  rw [aeval_eq_sum_range]
  exact norm_finset_sum_lt hr fun i _ ↦ (hz.norm_smul_pow_le _ i).trans_lt (h i)

/-- **The Gauss formula**: `‖g(z)‖` is the norm of a coefficient of `g`, namely of one of maximal
norm. -/
theorem exists_norm_aeval_eq (g : k[X]) : ∃ i, ‖aeval z g‖ = ‖g.coeff i‖ := by
  obtain ⟨i, -, hi⟩ := Finset.exists_max_image (Finset.range (g.natDegree + 1))
    (fun i ↦ ‖g.coeff i‖) ⟨0, by simp⟩
  refine ⟨i, le_antisymm (hz.norm_aeval_le g (norm_nonneg _) fun j ↦ ?_) (hz.norm_coeff_le g i)⟩
  by_cases hj : j ≤ g.natDegree
  · exact hi j (Finset.mem_range.mpr (Nat.lt_succ_of_le hj))
  · rw [coeff_eq_zero_of_natDegree_lt (not_le.mp hj), norm_zero]
    exact norm_nonneg _

/-- `‖z - a‖ = max 1 ‖a‖` for `a ∈ k`. -/
theorem norm_sub_algebraMap (a : k) : ‖z - algebraMap k K a‖ = max 1 ‖a‖ := by
  have h : aeval z (X - C a) = z - algebraMap k K a := by simp
  refine le_antisymm ?_ (max_le ?_ ?_)
  · rw [← h]
    refine hz.norm_aeval_le _ (le_max_of_le_left zero_le_one) fun i ↦ ?_
    rw [coeff_sub, coeff_X, coeff_C]
    split_ifs with h1 h2
    · omega
    · simp
    · simp
    · simp
  · have := hz.norm_coeff_le (X - C a) 1
    rwa [coeff_sub, coeff_X_one, coeff_C, if_neg one_ne_zero, sub_zero, norm_one, h] at this
  · have := hz.norm_coeff_le (X - C a) 0
    rwa [coeff_sub, coeff_X_zero, coeff_C_zero, zero_sub, norm_neg, h] at this

omit [IsUltrametricDist K] in
/-- A Gauss element is transcendental. -/
theorem transcendental : Transcendental k z := by
  rintro ⟨g, hg, h0⟩
  obtain ⟨i, hi⟩ : ∃ i, g.coeff i ≠ 0 := by
    by_contra h
    simp only [ne_eq, not_exists, not_not] at h
    exact hg (Polynomial.ext fun i ↦ by simp [h i])
  have := hz.norm_coeff_le g i
  rw [h0, norm_zero] at this
  exact hi (norm_le_zero_iff.mp this)

omit [IsUltrametricDist K] in
/-- The image of a Gauss element in an extension is a Gauss element. -/
theorem map (L : Type*) [NormedField L] [NormedAlgebra k L] [NormedAlgebra K L]
    [IsScalarTower k K L] : IsGaussElement k (algebraMap K L z) where
  norm_le_one := by
    rw [norm_algebraMap']
    exact hz.norm_le_one
  norm_coeff_le g i := by
    rw [aeval_algebraMap_apply, norm_algebraMap']
    exact hz.norm_coeff_le g i

/-- For a subfield `k₀ ⊆ k°`, every nonzero `g ∈ k₀[X]` has `‖g(z)‖ = 1`. -/
theorem norm_aeval_subfield_eq_one (k₀ : Subfield k) (hk₀ : ∀ x ∈ k₀, ‖x‖ ≤ 1) {g : k₀[X]}
    (hg : g ≠ 0) : ‖aeval z g‖ = 1 := by
  rw [← aeval_map_algebraMap k z g]
  obtain ⟨j, hj⟩ : ∃ j, g.coeff j ≠ 0 := by
    by_contra h
    simp only [ne_eq, not_exists, not_not] at h
    exact hg (Polynomial.ext fun i ↦ by simp [h i])
  refine le_antisymm (hz.norm_aeval_le _ zero_le_one fun n ↦ ?_) ?_
  · rw [coeff_map]
    exact hk₀ _ (g.coeff n).2
  · have := hz.norm_coeff_le (g.map (algebraMap k₀ k)) j
    rw [coeff_map] at this
    have hj' : algebraMap k₀ k (g.coeff j) ≠ 0 := by simpa using hj
    have h1 : ‖algebraMap k₀ k (g.coeff j)‖ = 1 :=
      norm_eq_one_of_mem_of_le_one hk₀ (g.coeff j).2 hj'
    rwa [h1] at this

/-- For a subfield `k₀ ⊆ k°`, the field `k₀(z)` lies in the unit ball of `K`. -/
theorem adjoin_le_unitBall (k₀ : Subfield k) (hk₀ : ∀ x ∈ k₀, ‖x‖ ≤ 1) :
    ∀ y ∈ k₀⟮z⟯, ‖y‖ ≤ 1 :=
  adjoin_le_unitBall_of_norm_aeval_eq_one fun _ hg ↦ hz.norm_aeval_subfield_eq_one k₀ hk₀ hg

end Formula

/-! ### Residues -/

section Residue

variable {k K : Type*} [NormedField k] [IsUltrametricDist k] [NormedField K]
  [IsUltrametricDist K] [NormedAlgebra k K] {z : K} (hz : IsGaussElement k z)
include hz

/-- The residue `z̃` of a Gauss element is transcendental over `k̃`. -/
theorem transcendental_residue :
    Transcendental (ResidueField (unitBall k))
      (residue (unitBall K) ⟨z, mem_unitBall.mpr hz.norm_le_one⟩) := by
  rintro ⟨g, hg, h0⟩
  obtain ⟨G, rfl⟩ := Polynomial.map_surjective (residue (unitBall k)) residue_surjective g
  set x : unitBall K := ⟨z, mem_unitBall.mpr hz.norm_le_one⟩
  have hres : residue (unitBall K) (aeval x G) = 0 := by
    rw [residue_aeval_unitBall]
    exact h0
  have hlt : ‖((aeval x G : unitBall K) : K)‖ < 1 := residue_eq_zero_iff_norm_lt_one.mp hres
  rw [coe_aeval_unitBall] at hlt
  obtain ⟨i, hi⟩ : ∃ i, (G.map (residue (unitBall k))).coeff i ≠ 0 := by
    by_contra h
    simp only [ne_eq, not_exists, not_not] at h
    exact hg (Polynomial.ext fun i ↦ by simp [h i])
  rw [coeff_map] at hi
  have h1 : ‖((G.coeff i : unitBall k) : k)‖ = 1 := norm_eq_one_of_residue_ne_zero hi
  have h2 := hz.norm_coeff_le (G.map (unitBall k).subtype) i
  rw [coeff_map] at h2
  change ‖((G.coeff i : unitBall k) : k)‖ ≤ _ at h2
  rw [h1] at h2
  exact absurd (h2.trans_lt hlt) (lt_irrefl 1)

/-- For a subfield `k₀ ⊆ k°`, the residues of the elements of `k₀(z)` lie in `k̃(z̃)`. -/
theorem residue_mem_adjoin (k₀ : Subfield k) (hk₀ : ∀ x ∈ k₀, ‖x‖ ≤ 1) {y : K}
    (hy : y ∈ k₀⟮z⟯) :
    residue (unitBall K) ⟨y, mem_unitBall.mpr (hz.adjoin_le_unitBall k₀ hk₀ y hy)⟩ ∈
      (ResidueField (unitBall k))⟮residue (unitBall K) ⟨z, mem_unitBall.mpr hz.norm_le_one⟩⟯ := by
  set E := (ResidueField (unitBall k))⟮residue (unitBall K) ⟨z, mem_unitBall.mpr hz.norm_le_one⟩⟯
  set x : unitBall K := ⟨z, mem_unitBall.mpr hz.norm_le_one⟩
  have hmem : ∀ G : (unitBall k)[X], residue (unitBall K) (aeval x G) ∈ E := fun G ↦ by
    rw [residue_aeval_unitBall]
    exact IntermediateField.algebra_adjoin_le_adjoin _ _
      (Polynomial.aeval_mem_adjoin_singleton _ _)
  have hcoe : ∀ r : k₀[X],
      ((aeval x (r.map (subfieldToUnitBall k₀ hk₀)) : unitBall K) : K) = aeval z r := fun r ↦ by
    rw [coe_aeval_unitBall, Polynomial.map_map, unitBall_subtype_comp_subfieldToUnitBall,
      aeval_map_algebraMap]
  obtain ⟨r, s, hrs⟩ := (IntermediateField.mem_adjoin_simple_iff k₀ y).mp hy
  rcases eq_or_ne s 0 with rfl | hs
  · have : (⟨y, mem_unitBall.mpr (hz.adjoin_le_unitBall k₀ hk₀ y hy)⟩ : unitBall K) = 0 :=
      Subtype.ext (by simp [hrs])
    rw [this, map_zero]
    exact zero_mem E
  set A := aeval x (r.map (subfieldToUnitBall k₀ hk₀))
  set B := aeval x (s.map (subfieldToUnitBall k₀ hk₀))
  have hB : ‖(B : K)‖ = 1 := by
    rw [hcoe]
    exact hz.norm_aeval_subfield_eq_one k₀ hk₀ hs
  have hB0 : residue (unitBall K) B ≠ 0 := by
    rw [residue_ne_zero_iff_isUnit]
    exact isUnit_unitBall_iff.mpr hB
  have hyB : (⟨y, mem_unitBall.mpr (hz.adjoin_le_unitBall k₀ hk₀ y hy)⟩ : unitBall K) * B = A := by
    apply Subtype.ext
    change y * (B : K) = (A : K)
    have hB' : (B : K) ≠ 0 := by
      intro h0
      rw [h0, norm_zero] at hB
      exact zero_ne_one hB
    rw [hrs, hcoe, hcoe, div_mul_cancel₀]
    rwa [← hcoe]
  have hres := congrArg (residue (unitBall K)) hyB
  rw [map_mul] at hres
  rw [eq_div_of_mul_eq hB0 hres]
  exact div_mem (hmem _) (hmem _)

end Residue

end IsGaussElement

/-- **Converse of `IsGaussElement.transcendental_residue`**: if `‖z‖ ≤ 1` and `z̃` is transcendental
over `k̃`, then `z` is a Gauss element. -/
theorem isGaussElement_of_transcendental_residue {k K : Type*} [NormedField k]
    [IsUltrametricDist k] [NormedField K] [IsUltrametricDist K] [NormedAlgebra k K] {z : K}
    (hz : ‖z‖ ≤ 1)
    (htr : Transcendental (ResidueField (unitBall k))
      (residue (unitBall K) ⟨z, mem_unitBall.mpr hz⟩)) :
    IsGaussElement k z := by
  refine ⟨hz, fun g i ↦ ?_⟩
  rcases eq_or_ne g 0 with rfl | hg
  · simp
  obtain ⟨j, hjs, hj⟩ := Finset.exists_max_image g.support (fun i ↦ ‖g.coeff i‖)
    (nonempty_support_iff.mpr hg)
  set c := g.coeff j
  have hc : c ≠ 0 := mem_support_iff.mp hjs
  have hle : ∀ n, ‖g.coeff n‖ ≤ ‖c‖ := fun n ↦ by
    by_cases hn : n ∈ g.support
    · exact hj n hn
    · rw [notMem_support_iff.mp hn, norm_zero]
      exact norm_nonneg _
  have hcpos : 0 < ‖c‖ := norm_pos_iff.mpr hc
  have hcoeffs : ∀ n, ‖(C c⁻¹ * g).coeff n‖ ≤ 1 := fun n ↦ by
    rw [coeff_C_mul, norm_mul, norm_inv]
    exact (inv_mul_le_one₀ hcpos).mpr (hle n)
  obtain ⟨H, hH⟩ := exists_map_unitBall_eq _ hcoeffs
  have hHj : ((H.coeff j : unitBall k) : k) = 1 := by
    have := congrArg (fun P ↦ P.coeff j) hH
    simp only [coeff_map, coeff_C_mul] at this
    change ((H.coeff j : unitBall k) : k) = _ at this
    rw [this, inv_mul_cancel₀ hc]
  have hne : H.map (residue (unitBall k)) ≠ 0 := by
    intro h0
    have := congrArg (fun P ↦ P.coeff j) h0
    simp only [coeff_map, coeff_zero] at this
    have := residue_eq_zero_iff_norm_lt_one.mp this
    rw [hHj, norm_one] at this
    exact lt_irrefl _ this
  set x : unitBall K := ⟨z, mem_unitBall.mpr hz⟩
  have hres : residue (unitBall K) (aeval x H) ≠ 0 := by
    rw [residue_aeval_unitBall]
    exact fun h0 ↦ htr ⟨_, hne, h0⟩
  have h1 := norm_eq_one_of_residue_ne_zero hres
  rw [coe_aeval_unitBall, hH, map_mul, aeval_C, norm_mul, norm_algebraMap', norm_inv] at h1
  have h2 : ‖aeval z g‖ = ‖c‖ := by
    field_simp at h1
    linarith
  rw [h2]
  exact hle i

/-! ### Gauss generators -/

namespace IsGaussElement

variable {k K : Type*} [NormedField k] [IsUltrametricDist k] [NormedField K]
  [IsUltrametricDist K] [NormedAlgebra k K] {z : K} (hz : IsGaussElement k z)
include hz

/-- Coefficientwise approximation by a coefficient field: if all coefficients of `f ∈ k[X]` lie in
`k°`, there is `f₀ ∈ k₀[X]` with `‖f(z) - f₀(z)‖ < 1`. -/
theorem exists_subfield_approx {k₀ : Subfield k} (hk₀ : IsCoefficientField k₀) (f : k[X])
    (hf : ∀ n, ‖f.coeff n‖ ≤ 1) : ∃ f₀ : k₀[X], ‖aeval z f - aeval z f₀‖ < 1 := by
  obtain ⟨G, rfl⟩ := exists_map_unitBall_eq f hf
  refine ⟨G.map hk₀.toUnitBallHom, ?_⟩
  rw [← aeval_map_algebraMap k z (G.map hk₀.toUnitBallHom), ← map_sub]
  refine hz.norm_aeval_lt _ one_pos fun n ↦ ?_
  rw [coeff_sub, coeff_map, coeff_map, coeff_map]
  exact hk₀.norm_sub_toUnitBallHom_lt_one (G.coeff n)

/-- **Approximation in `k(z) ∩ K°` by `k₀(z)`**: if `k₀` is a coefficient field of `k`, every
`w ∈ k(z)` with `‖w‖ ≤ 1` satisfies `‖w - w₀‖ < 1` for some `w₀ ∈ k₀(z)`. -/
theorem exists_mem_adjoin_norm_sub_lt_one {k₀ : Subfield k} (hk₀ : IsCoefficientField k₀)
    {w : K} (hw : w ∈ k⟮z⟯) (hn : ‖w‖ ≤ 1) : ∃ w₀ ∈ k₀⟮z⟯, ‖w - w₀‖ < 1 := by
  obtain ⟨g, h, rfl⟩ := (IntermediateField.mem_adjoin_simple_iff k _).mp hw
  rcases eq_or_ne (aeval z h) 0 with hh | hh
  · exact ⟨0, zero_mem _, by simp [hh]⟩
  obtain ⟨j, hj⟩ := hz.exists_norm_aeval_eq h
  set c := h.coeff j
  have hc : c ≠ 0 := by
    intro h0
    rw [h0, norm_zero, norm_eq_zero] at hj
    exact hh hj
  have hcz : algebraMap k K c⁻¹ ≠ 0 := by simpa using hc
  have hdiv : aeval z g / aeval z h = aeval z (C c⁻¹ * g) / aeval z (C c⁻¹ * h) := by
    simp only [map_mul, aeval_C]
    rw [mul_div_mul_left _ _ hcz]
  have hB : ‖aeval z (C c⁻¹ * h)‖ = 1 := by
    rw [map_mul, aeval_C, norm_mul, norm_algebraMap', norm_inv, hj]
    exact inv_mul_cancel₀ (norm_ne_zero_iff.mpr hc)
  have hA : ‖aeval z (C c⁻¹ * g)‖ ≤ 1 := by
    have : ‖aeval z (C c⁻¹ * g)‖ = ‖aeval z g / aeval z h‖ := by
      rw [hdiv, norm_div, hB, div_one]
    rw [this]
    exact hn
  obtain ⟨g₀, hg₀⟩ := hz.exists_subfield_approx hk₀ (C c⁻¹ * g)
    fun n ↦ (hz.norm_coeff_le _ n).trans hA
  obtain ⟨h₀, hh₀⟩ := hz.exists_subfield_approx hk₀ (C c⁻¹ * h)
    fun n ↦ (hz.norm_coeff_le _ n).trans hB.le
  refine ⟨aeval z g₀ / aeval z h₀,
    (IntermediateField.mem_adjoin_simple_iff k₀ _).mpr ⟨g₀, h₀, rfl⟩, ?_⟩
  set A := aeval z (C c⁻¹ * g)
  set B := aeval z (C c⁻¹ * h)
  set A₀ := aeval z g₀
  set B₀ := aeval z h₀
  have hB₀ : ‖B₀‖ = 1 := by
    rw [norm_eq_of_norm_sub_lt (hB.symm ▸ hh₀ : ‖B - B₀‖ < ‖B‖), hB]
  have hBne : B ≠ 0 := norm_ne_zero_iff.mp (by rw [hB]; exact one_ne_zero)
  have hB₀ne : B₀ ≠ 0 := norm_ne_zero_iff.mp (by rw [hB₀]; exact one_ne_zero)
  rw [hdiv, div_sub_div _ _ hBne hB₀ne, norm_div, norm_mul, hB, hB₀, mul_one, div_one]
  have heq : A * B₀ - B * A₀ = A * (B₀ - B) + B * (A - A₀) := by ring
  rw [heq]
  refine (IsUltrametricDist.norm_add_le_max _ _).trans_lt (max_lt ?_ ?_)
  · rw [norm_mul, norm_sub_rev]
    calc ‖A‖ * ‖B - B₀‖ ≤ 1 * ‖B - B₀‖ := mul_le_mul_of_nonneg_right hA (norm_nonneg _)
      _ < 1 := by rw [one_mul]; exact hh₀
  · rw [norm_mul, hB, one_mul]
    exact hg₀

end IsGaussElement

namespace IsGaussGenerator

variable {k K : Type*} [NormedField k] [IsUltrametricDist k] [NormedField K]
  [IsUltrametricDist K] [NormedAlgebra k K] {z : K} (hz : IsGaussGenerator k z)
include hz

/-- **The residue field of a Gauss generator**: if `k₀` is a coefficient field of `k`, then
`k₀(z)` is a coefficient field of `K`. -/
theorem isCoefficientField_adjoin {k₀ : Subfield k} (hk₀ : IsCoefficientField k₀) :
    IsCoefficientField (k₀⟮z⟯).toSubfield where
  norm_le_one := hz.adjoin_le_unitBall k₀ hk₀.norm_le_one
  surjective := by
    intro y
    obtain ⟨x, rfl⟩ := residue_surjective y
    obtain ⟨w, hw, hxw⟩ := hz.dense_adjoin.exists_dist_lt (x : K) one_pos
    rw [dist_eq_norm] at hxw
    have hwn : ‖w‖ ≤ 1 := by
      calc ‖w‖ = ‖(x : K) - ((x : K) - w)‖ := by rw [sub_sub_cancel]
        _ ≤ max ‖(x : K)‖ ‖(x : K) - w‖ := norm_sub_le_max _ _
        _ ≤ 1 := max_le (norm_coe_unitBall_le_one x) hxw.le
    obtain ⟨w₀, hw₀, hww₀⟩ := hz.toIsGaussElement.exists_mem_adjoin_norm_sub_lt_one hk₀ hw hwn
    refine ⟨⟨w₀, hw₀⟩, ?_⟩
    rw [subfieldResidue_apply, residue_eq_residue_iff]
    change ‖w₀ - (x : K)‖ < 1
    calc ‖w₀ - (x : K)‖ = ‖((x : K) - w) + (w - w₀)‖ := by rw [norm_sub_rev]; ring_nf
      _ ≤ max ‖(x : K) - w‖ ‖w - w₀‖ := IsUltrametricDist.norm_add_le_max _ _
      _ < 1 := max_lt hxw hww₀

/-- `K̃ = k̃(z̃)` for a Gauss generator `z` (given a coefficient field of `k`). -/
theorem adjoin_residue_eq_top {k₀ : Subfield k} (hk₀ : IsCoefficientField k₀) :
    (ResidueField (unitBall k))⟮residue (unitBall K) ⟨z, mem_unitBall.mpr hz.norm_le_one⟩⟯ = ⊤ := by
  refine eq_top_iff.mpr fun y _ ↦ ?_
  obtain ⟨⟨w, hw⟩, rfl⟩ := (hz.isCoefficientField_adjoin hk₀).surjective y
  exact hz.toIsGaussElement.residue_mem_adjoin k₀ hk₀.norm_le_one hw

omit [IsUltrametricDist k] in
/-- **The value group of a Gauss generator**: `|K^×| = |k^×|`. -/
theorem exists_norm_eq (x : K) : ∃ c : k, ‖c‖ = ‖x‖ := by
  rcases eq_or_ne x 0 with rfl | hx
  · exact ⟨0, by simp⟩
  obtain ⟨w, hw, hxw⟩ := hz.dense_adjoin.exists_dist_lt x (norm_pos_iff.mpr hx)
  rw [dist_eq_norm] at hxw
  have hwx : ‖w‖ = ‖x‖ := norm_eq_of_norm_sub_lt hxw
  obtain ⟨g, h, rfl⟩ := (IntermediateField.mem_adjoin_simple_iff k _).mp hw
  obtain ⟨i, hi⟩ := hz.toIsGaussElement.exists_norm_aeval_eq g
  obtain ⟨j, hj⟩ := hz.toIsGaussElement.exists_norm_aeval_eq h
  exact ⟨g.coeff i / h.coeff j, by rw [norm_div, ← hi, ← hj, ← norm_div, hwx]⟩

end IsGaussGenerator

/-! ### Density of the span of a coefficient field -/

section Density

variable {k K L : Type*} [NormedField k] [IsUltrametricDist k] [IsAlgClosed k] [NormedField K]
  [IsUltrametricDist K] [NormedAlgebra k K] [NormedField L] [IsUltrametricDist L]
  [NormedAlgebra k L] [NormedAlgebra K L] [IsScalarTower k K L]

omit [IsAlgClosed k] [IsUltrametricDist K] [NormedAlgebra k K] [NormedAlgebra K L]
  [IsScalarTower k K L] in
/-- **Mittag-Leffler inverses**: let `k₀` be a coefficient field of `k`, `z ∈ L` a Gauss element and
`L₀` a subfield of `L` containing `k₀` and `z`. Then `(z - a)⁻¹` lies in the closure of
the `k`-algebra generated by `L₀`, for every `a ∈ k`. -/
theorem inv_sub_mem_topologicalClosure {k₀ : Subfield k} (hk₀ : IsCoefficientField k₀) {z : L}
    (hz : IsGaussElement k z) {L₀ : Subfield L}
    (hk₀L₀ : k₀.map (algebraMap k L) ≤ L₀) (hzL₀ : z ∈ L₀) (a : k) :
    (z - algebraMap k L a)⁻¹ ∈ (Algebra.adjoin k (L₀ : Set L)).topologicalClosure := by
  set A := Algebra.adjoin k (L₀ : Set L)
  have hL₀A : ∀ x ∈ L₀, x ∈ A := fun x hx ↦ Algebra.subset_adjoin hx
  have hzA : z ∈ A := hL₀A z hzL₀
  have hyA : z - algebraMap k L a ∈ A.toSubring := A.sub_mem hzA (A.algebraMap_mem a)
  have key : (z - algebraMap k L a)⁻¹ ∈ closure (A.toSubring : Set L) := by
    rcases le_or_gt ‖a‖ 1 with ha | ha
    · obtain ⟨a₀, ha₀, haa₀⟩ := hk₀.exists_mem_norm_sub_lt_one ha
      have ha₀L₀ : algebraMap k L a₀ ∈ L₀ := hk₀L₀ ⟨a₀, ha₀, rfl⟩
      have hcL₀ : z - algebraMap k L a₀ ∈ L₀ := L₀.sub_mem hzL₀ ha₀L₀
      have hc : ‖z - algebraMap k L a₀‖ = 1 := by
        rw [hz.norm_sub_algebraMap, max_eq_left (hk₀.norm_le_one a₀ ha₀)]
      refine inv_mem_closure_of_norm_sub_lt hyA (hL₀A _ hcL₀) (hL₀A _ (L₀.inv_mem hcL₀)) ?_
      rw [hc, sub_sub_sub_cancel_left, ← map_sub, norm_algebraMap', norm_sub_rev]
      exact haa₀
    · have hc : algebraMap k L (-a) ∈ A.toSubring := A.algebraMap_mem _
      have hc' : (algebraMap k L (-a))⁻¹ ∈ A.toSubring := by
        rw [← map_inv₀]
        exact A.algebraMap_mem _
      refine inv_mem_closure_of_norm_sub_lt hyA hc hc' ?_
      rw [map_neg, sub_neg_eq_add, sub_add_cancel, norm_neg, norm_algebraMap']
      exact hz.norm_le_one.trans_lt ha
  rw [← SetLike.mem_coe, Subalgebra.topologicalClosure_coe]
  exact key

/-- **Density of the span of a coefficient field** (replaces Temkin's `L₀ ⊗̂_{k₀} k ≅ L`, lines
3808–3810). Let `k₀` be a coefficient field of `k`, `z` a Gauss generator of `K`, `L/K` finite with
`[L : K] ≤ [L̃ : K̃]`, and `L₀` a coefficient field of `L` containing `k₀` and `z`. Then the
`k`-algebra generated by `L₀` (its `k`-span) is dense in `L`. -/
theorem dense_adjoin_of_isCoefficientField {k₀ : Subfield k} (hk₀ : IsCoefficientField k₀)
    {z : K} (hz : IsGaussGenerator k z) [FiniteDimensional K L]
    (hf : finrank K L ≤ inertiaDegree K L) {L₀ : Subfield L} (hL₀ : IsCoefficientField L₀)
    (hk₀L₀ : k₀.map (algebraMap k L) ≤ L₀) (hzL₀ : algebraMap K L z ∈ L₀) :
    Dense (Algebra.adjoin k (L₀ : Set L) : Set L) := by
  set A := Algebra.adjoin k (L₀ : Set L)
  set Abar := A.topologicalClosure
  have hL₀A : ∀ x ∈ L₀, x ∈ Abar := fun x hx ↦ A.le_topologicalClosure (Algebra.subset_adjoin hx)
  set z' := algebraMap K L z
  have hz' : IsGaussElement k z' := hz.toIsGaussElement.map L
  -- (b) `k(z) ⊆ Abar`
  have hinv : ∀ h : k[X], (aeval z' h)⁻¹ ∈ Abar := by
    intro h
    induction h using induction_on_X_sub_C_mul with
    | hC c =>
      rw [aeval_C, ← map_inv₀]
      exact Abar.algebraMap_mem _
    | hmul a g ih =>
      rw [map_mul, mul_inv, map_sub, aeval_X, aeval_C]
      exact Abar.mul_mem (inv_sub_mem_topologicalClosure hk₀ hz' hk₀L₀ hzL₀ a) ih
  have haeval : ∀ g : k[X], aeval z' g ∈ Abar := fun g ↦
    A.le_topologicalClosure (Algebra.adjoin_mono (Set.singleton_subset_iff.mpr hzL₀)
      (Polynomial.aeval_mem_adjoin_singleton k z'))
  -- (c) `K ⊆ Abar`
  have hK : ∀ x : K, algebraMap K L x ∈ Abar := by
    intro x
    have hcl : algebraMap K L x ∈ closure (Abar : Set L) := by
      refine map_mem_closure (algebraMap_isometry K L).continuous (hz.dense_adjoin x) ?_
      intro w hw
      obtain ⟨g, h, rfl⟩ := (IntermediateField.mem_adjoin_simple_iff k w).mp hw
      rw [map_div₀, ← aeval_algebraMap_apply, ← aeval_algebraMap_apply, div_eq_mul_inv]
      exact Abar.mul_mem (haeval g) (hinv h)
    rwa [A.isClosed_topologicalClosure.closure_eq] at hcl
  -- (d) a lift to `L₀` of a `K̃`-basis of `L̃` is a `K`-basis of `L`
  set n := finrank (ResidueField (unitBall K)) (ResidueField (unitBall L))
  set β := Module.finBasis (ResidueField (unitBall K)) (ResidueField (unitBall L))
  have hlift : ∀ i : Fin n, ∃ e : unitBall L, (e : L) ∈ L₀ ∧ residue (unitBall L) e = β i := by
    intro i
    obtain ⟨⟨x, hx⟩, hxβ⟩ := hL₀.surjective (β i)
    exact ⟨⟨x, mem_unitBall.mpr (hL₀.norm_le_one x hx)⟩, hx, hxβ⟩
  choose e heL₀ heβ using hlift
  have hli : LinearIndependent K (fun i ↦ (e i : L)) := by
    refine linearIndependent_of_residue e ?_
    simpa only [heβ] using β.linearIndependent
  have hcard : Fintype.card (Fin n) = finrank K L := by
    refine le_antisymm hli.fintype_card_le_finrank ?_
    rw [Fintype.card_fin]
    exact hf
  have hne : Nonempty (Fin n) := by
    rw [← Fintype.card_pos_iff, hcard]
    exact Module.finrank_pos
  have hspan := hli.span_eq_top_of_card_eq_finrank hcard
  have hall : ∀ x : L, x ∈ Abar := by
    intro x
    have hx : x ∈ Submodule.span K (Set.range fun i ↦ (e i : L)) := by
      rw [hspan]
      exact Submodule.mem_top
    obtain ⟨c, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun K).mp hx
    refine Abar.sum_mem fun i _ ↦ ?_
    rw [Algebra.smul_def]
    exact Abar.mul_mem (hK (c i)) (hL₀A _ (heL₀ i))
  rw [dense_iff_closure_eq, Set.eq_univ_iff_forall]
  intro x
  rw [← Subalgebra.topologicalClosure_coe]
  exact hall x

end Density

end DeJongAlterations.StableModification.Valuation.Analytic
