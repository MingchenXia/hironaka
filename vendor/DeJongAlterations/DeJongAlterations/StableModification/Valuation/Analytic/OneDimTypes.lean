import DeJongAlterations.StableModification.Valuation.Analytic.TypeTwo

/-!
# Uniformization of one-dimensional analytic fields by type

Let `k` be an algebraically closed analytic field of equal characteristic. This file proves the
three cases of the uniformization of one-dimensional analytic fields, M. Temkin, *Stable
modification of relative curves*, J. Algebraic Geom. 19 (2010), Theorem 6.3.1(i)
(`semi-stable.tex`, statement lines 3987–3996, proof lines 4051–4112), in the form produced by
the proof structure of plan simplification S5 (`PLAN-SM-VAL.md`):

* `exists_dense_adjoin_of_step` (**the type 4 step**): a degree-`p` Artin–Schreier or purely
  inseparable extension of a `k`-immediate field topologically generated by one element is again
  topologically generated by one element (Temkin, lines 4094–4112).
* `IsTypeFourGenerator.exists_isTypeFourGenerator` (**type 4**): every finite extension of a
  field with a type 4 generator has a type 4 generator.
* `IsAnnulusGenerator.finrank_eq_one_of_isImmediate` (**type 3**): a field with an annulus
  generator has no nontrivial finite immediate extensions.
* `IsAnnulusGenerator.exists_forall_norm_eq_zpow_mul`: a finite extension of an annulus field
  has a generator `z` of its value group modulo `|k^×|`.
* `IsGaussGenerator.isUnramified` (**type 2**): a finite extension of a field with a Gauss
  generator with separable residue field extension is unramified.

The Galois parts use the Galois closure (`galoisClosure_induction`), the tame part of the inertia
(the Kummer step `exists_pow_eq_and_fixedField_eq_adjoin`, resp. the inertia field
`exists_inertiaField_generator`), base change of immediate extensions
(`isImmediate_sup_of_isCartesian`) and the absence of immediate `p`-towers over fields with
minimal elements in special cosets (`eq_bot_of_isImmediate_of_isPGroup`, Temkin's Proposition
6.2.4 in the form of `IsAnnulusGenerator.exists_isMinimalInCoset` and
`IsGaussGenerator.exists_isMinimalInCoset`, which are stated for special cosets only).

## References

Blueprint chapter `sm-val-onedim.tex`: `lem:sm-an-type4-step`, `prop:sm-an-type4-generated`,
`prop:sm-an-type3-no-immediate`, `lem:sm-an-type3-value-generator`,
`prop:sm-an-type2-unramified`.
-/

noncomputable section

open IsLocalRing Polynomial Module Topology
open scoped IntermediateField

namespace DeJongAlterations.StableModification.Valuation.Analytic

/-! ### Helpers -/

section Helpers

/-- Membership in a coset is preserved by isometric field embeddings. -/
theorem MemCoset.map {E F : Type*} [NormedField E] [NormedField F] [NormedAlgebra E F] {p : ℕ}
    {a b x : E} {s : ℝ} (h : MemCoset p a s b x) :
    MemCoset p (algebraMap E F a) s (algebraMap E F b) (algebraMap E F x) := by
  obtain ⟨c, d, hd, hcd⟩ := h
  refine ⟨algebraMap E F c, algebraMap E F d, by rwa [norm_algebraMap'], ?_⟩
  simp only [asMap] at hcd ⊢
  rw [← map_sub, ← hcd]
  simp [map_add, map_sub, map_mul, map_pow]

variable {k E F : Type*} [NormedField k] [NormedField E] [NormedField F] [NormedAlgebra k E]
  [NormedAlgebra E F] [NormedAlgebra k F] [IsScalarTower k E F]

/-- If `k(z)` is dense in the complete field `E`, the image of `E` in `F` is the closure of
`k(z)` in `F`. -/
theorem range_algebraMap_eq_closureAdjoin [CompleteSpace E] {z : E}
    (hz : Dense (k⟮z⟯ : Set E)) :
    Set.range (algebraMap E F) = (closureAdjoin k (algebraMap E F z) : Set F) := by
  have hiso : Isometry (algebraMap E F) :=
    AddMonoidHomClass.isometry_of_norm _ fun x ↦ norm_algebraMap' F x
  have himage : algebraMap E F '' (k⟮z⟯ : Set E) = (k⟮algebraMap E F z⟯ : Set F) := by
    have := IntermediateField.adjoin_map k {z} (IsScalarTower.toAlgHom k E F)
    rw [Set.image_singleton] at this
    exact congrArg (fun T : IntermediateField k F ↦ (T : Set F)) this
  apply le_antisymm
  · rintro _ ⟨x, rfl⟩
    have hx : x ∈ closure (k⟮z⟯ : Set E) := by rw [hz.closure_eq]; trivial
    rw [coe_closureAdjoin, ← himage]
    exact image_closure_subset_closure_image hiso.continuous ⟨x, hx, rfl⟩
  · rw [coe_closureAdjoin]
    refine closure_minimal ?_ hiso.isUniformInducing.isComplete_range.isClosed
    rw [← himage]
    exact Set.image_subset_range _ _

omit [NormedAlgebra k E] [IsScalarTower k E F] in
/-- A closed intermediate field `C` of `F/k` containing the image of `E` and an element `α` with
`E(α) = F` is all of `F`. -/
theorem eq_top_of_range_subset {C : IntermediateField k F} (hC : Set.range (algebraMap E F) ⊆ C)
    {α : F} (hα : α ∈ C) (htop : IntermediateField.adjoin E {α} = ⊤) : (C : Set F) = Set.univ := by
  let C' : IntermediateField E F :=
    Subfield.toIntermediateField C.toSubfield fun e ↦ hC ⟨e, rfl⟩
  have hle : IntermediateField.adjoin E {α} ≤ C' := IntermediateField.adjoin_simple_le_iff.mpr hα
  rw [htop] at hle
  ext x
  simp only [Set.mem_univ, iff_true]
  exact hle (IntermediateField.mem_top : x ∈ (⊤ : IntermediateField E F))


omit [NormedAlgebra k E] [IsScalarTower k E F] in
/-- An intermediate field `C` of `F/k` containing the image of `E` and an element `α` contains
`E(α)`. -/
theorem adjoin_subset_of_range_subset {C : IntermediateField k F}
    (hC : Set.range (algebraMap E F) ⊆ C) {α : F} (hα : α ∈ C) :
    (IntermediateField.adjoin E {α} : Set F) ⊆ C := by
  let C' : IntermediateField E F :=
    Subfield.toIntermediateField C.toSubfield fun e ↦ hC ⟨e, rfl⟩
  exact IntermediateField.adjoin_simple_le_iff.mpr (show α ∈ C' from hα)


/-- In an extension of prime degree, every element outside the base generates. -/
theorem adjoin_eq_top_of_finrank_eq_prime {E' F' : Type*} [Field E'] [Field F'] [Algebra E' F']
    {p : ℕ} (hp : p.Prime) (hdeg : finrank E' F' = p) {α : F'}
    (hα : α ∉ Set.range (algebraMap E' F')) : IntermediateField.adjoin E' {α} = ⊤ := by
  have : FiniteDimensional E' F' := Module.finite_of_finrank_pos (by rw [hdeg]; exact hp.pos)
  have hmul := Module.finrank_mul_finrank E' (IntermediateField.adjoin E' {α}) F'
  rw [hdeg] at hmul
  have hdvd : finrank E' (IntermediateField.adjoin E' {α}) ∣ p := ⟨_, hmul.symm⟩
  rcases hp.eq_one_or_self_of_dvd _ hdvd with h1 | h1
  · rw [IntermediateField.finrank_eq_one_iff, IntermediateField.adjoin_simple_eq_bot_iff] at h1
    exact absurd (IntermediateField.mem_bot.mp h1) hα
  · exact IntermediateField.eq_of_le_of_finrank_eq le_top
      (by rw [IntermediateField.finrank_top', h1, hdeg])

/-- The image of a finite extension `E → F` is a subfield over which `F` has the same degree. -/
theorem finrank_fieldRange_eq {k E F : Type*} [Field k] [Field E] [Field F] [Algebra k E]
    [Algebra E F] [Algebra k F] [IsScalarTower k E F] [FiniteDimensional E F] :
    FiniteDimensional (IsScalarTower.toAlgHom k E F).fieldRange F ∧
      finrank (IsScalarTower.toAlgHom k E F).fieldRange F = finrank E F := by
  set f := IsScalarTower.toAlgHom k E F
  have h : finrank f.fieldRange F = finrank E F :=
    (Algebra.finrank_eq_of_equiv_equiv f.equivFieldRange.toRingEquiv (RingEquiv.refl F)
      (by ext e; rfl)).symm
  refine ⟨Module.finite_of_finrank_pos ?_, h⟩
  rw [h]
  exact Module.finrank_pos

end Helpers

/-! ### The type 4 step -/

section TypeFourStep

variable {k E F : Type*} [NontriviallyNormedField k] [IsUltrametricDist k] [CompleteSpace k]
  [IsAlgClosed k] [NontriviallyNormedField E] [IsUltrametricDist E] [CompleteSpace E]
  [NormedAlgebra k E] [NormedField F] [IsUltrametricDist F] [NormedAlgebra E F]
  [NormedAlgebra k F] [IsScalarTower k E F] [FiniteDimensional E F]

omit [IsUltrametricDist k] [CompleteSpace k] [IsUltrametricDist E] [CompleteSpace E]
  [IsUltrametricDist F] in
/-- If `k → E` is surjective, `k` is algebraically closed and `F/E` is finite, then
`E → F` is surjective. -/
theorem mem_range_algebraMap_of_surjective (hsurj : ∀ e : E, e ∈ Set.range (algebraMap k E))
    (y : F) : y ∈ Set.range (algebraMap E F) := by
  have h1 : Algebra.IsIntegral k E :=
    ⟨fun e ↦ by obtain ⟨c, rfl⟩ := hsurj e; exact isIntegral_algebraMap⟩
  have h2 : Algebra.IsIntegral E F := Algebra.IsIntegral.of_finite E F
  have h3 : Algebra.IsIntegral k F := Algebra.IsIntegral.trans E
  obtain ⟨c, rfl⟩ := (IsAlgClosed.algebraMap_bijective_of_isIntegral (k := k) (K := F)).2 y
  exact ⟨algebraMap k E c, (IsScalarTower.algebraMap_apply k E F c).symm⟩

/-- **The type 4 step** (Temkin, proof of Theorem 6.3.1, type 4, lines 4094–4112; blueprint
`lem:sm-an-type4-step`). Let `E` be a complete `k`-immediate field with `k(z)` dense, and `F/E`
an extension of prime degree `p = char k` generated by an Artin–Schreier element or a `p`-th
root. Then `F` is topologically generated over `k` by one element. -/
theorem exists_dense_adjoin_of_step (p : ℕ) [hpf : Fact p.Prime] [CharP k p]
    (hE : IsImmediateOver k E) {z : E} (hz : Dense (k⟮z⟯ : Set E)) (hdeg : finrank E F = p)
    (hstep : (∃ γ : F, γ ∉ Set.range (algebraMap E F) ∧ γ ^ p ∈ Set.range (algebraMap E F)) ∨
      (∃ α : F, α ∉ Set.range (algebraMap E F) ∧ α ^ p - α ∈ Set.range (algebraMap E F))) :
    ∃ x : F, Dense (k⟮x⟯ : Set F) := by
  have hp := hpf.out
  have : CharP E p := charP_of_injective_algebraMap (algebraMap k E).injective p
  have : CharP F p := charP_of_injective_algebraMap (algebraMap k F).injective p
  have : CompleteSpace F := FiniteDimensional.complete E F
  have hF : IsImmediateOver k F := hE.of_finiteDimensional
  have hFE : IsImmediate E F := hF.isImmediate
  -- `z ∉ k`
  have hzk : z ∉ Set.range (algebraMap k E) := by
    rintro ⟨c, rfl⟩
    have hsurj : ∀ e : E, e ∈ Set.range (algebraMap k E) := by
      have hbot : k⟮algebraMap k E c⟯ = ⊥ :=
        IntermediateField.adjoin_simple_eq_bot_iff.mpr (IntermediateField.algebraMap_mem _ _)
      have hcl : IsClosed (Set.range (algebraMap k E)) :=
        (algebraMap_isometry k E).isUniformInducing.isComplete_range.isClosed
      intro e
      have he : e ∈ closure (k⟮algebraMap k E c⟯ : Set E) := by rw [hz.closure_eq]; trivial
      rwa [hbot, IntermediateField.coe_bot, hcl.closure_eq] at he
    rcases hstep with ⟨γ, hγ, -⟩ | ⟨γ, hγ, -⟩ <;>
      exact hγ (mem_range_algebraMap_of_surjective hsurj γ)
  have hz4 : IsTypeFourGenerator k z := hE.isTypeFourGenerator hzk hz
  -- a special coset of `E` which splits over `F`, with a type 4 generator `b'` in it
  obtain ⟨a, s, b, ha, hsp, -, hsplit⟩ := hFE.exists_isSpecialCoset p hstep
  obtain ⟨β₀, β₁, hmem⟩ := hz4.exists_linear_memCoset hsp
  set b' := algebraMap k E β₀ + algebraMap k E β₁ * z with hb'
  have hsp' : IsSpecialCoset p a s b' := hmem.isSpecialCoset_iff.mpr hsp
  have hsplit' : IsSplitCoset p (algebraMap E F a) s (algebraMap E F b') :=
    (MemCoset.map (F := F) hmem).isSplitCoset_iff.mpr hsplit
  have hs : 0 < s := hsp'.1.1
  have hns : ¬ IsSplitCoset p a s b' := hsp'.1.2.1
  obtain ⟨a₀, rfl⟩ : ∃ a₀ : k, algebraMap k E a₀ = a := by
    rcases ha with rfl | ⟨rfl, -⟩
    · exact ⟨0, map_zero _⟩
    · exact ⟨1, map_one _⟩
  have hβ₁ : β₁ ≠ 0 := by
    rintro rfl
    apply hns
    have hdeg' : (X ^ p - C a₀ * X + C β₀ : k[X]).natDegree = p := by
      have h1 : (C a₀ * X : k[X]).natDegree < p :=
        (natDegree_C_mul_le _ _).trans_lt (by rw [natDegree_X]; exact hp.one_lt)
      have h2 : (C β₀ : k[X]).natDegree < p := by rw [natDegree_C]; exact hp.pos
      rw [sub_eq_add_neg, add_assoc, natDegree_add_eq_left_of_natDegree_lt, natDegree_X_pow]
      rw [natDegree_X_pow]
      refine lt_of_le_of_lt (natDegree_add_le _ _) (max_lt ?_ h2)
      rwa [natDegree_neg]
    obtain ⟨c, hc⟩ := IsAlgClosed.exists_root (X ^ p - C a₀ * X + C β₀ : k[X])
      (by
        rw [degree_eq_natDegree (by
          intro h0
          rw [h0, natDegree_zero] at hdeg'
          exact hp.ne_zero hdeg'.symm), hdeg']
        exact_mod_cast hp.ne_zero)
    refine ⟨algebraMap k E c, 0, by rw [norm_zero]; exact hs, ?_⟩
    simp only [IsRoot, eval_add, eval_sub, eval_pow, eval_X, eval_mul, eval_C] at hc
    have : algebraMap k E (c ^ p - a₀ * c + β₀) = 0 := by rw [hc, map_zero]
    simp only [asMap, map_add, map_sub, map_pow, map_mul] at this ⊢
    rw [hb', map_zero, zero_mul, add_zero, add_zero]
    linear_combination this
  have hb'4 : IsTypeFourGenerator k b' := hz4.affine β₀ hβ₁
  have hrange : Set.range (algebraMap E F) = (closureAdjoin k (algebraMap E F b') : Set F) :=
    range_algebraMap_eq_closureAdjoin hb'4.dense_adjoin
  rcases ha with ha0 | ⟨ha1, hs1⟩
  · -- Case `a = 0`
    have ha₀ : a₀ = 0 := (algebraMap k E).injective (by rw [ha0, map_zero])
    subst ha₀
    simp only [map_zero] at hns hsplit'
    obtain ⟨c, d, hd, hcd⟩ := hsplit'
    rw [asMap_zero_left] at hcd
    set b'F := algebraMap E F b' with hb'F
    set b'' := -c ^ p with hb''
    have hdist : ‖b'F - b''‖ = ‖d‖ := by
      rw [hb'', sub_neg_eq_add, show b'F + c ^ p = -d by linear_combination hcd, norm_neg]
    -- `s ≤ r(b')`
    have hrad : s ≤ radius k b'F := by
      refine le_ciInf fun a' ↦ ?_
      obtain ⟨e, he⟩ := IsAlgClosed.exists_pow_nat_eq (-a') hp.pos
      have hmem' : MemCoset p 0 s b' (b' + asMap p 0 (algebraMap k E e)) :=
        (memCoset_self hs b').add_asMap _
      have h1 := le_norm_of_not_isSplitCoset hns hmem'
      rw [asMap_zero_left, ← map_pow, he, map_neg, ← sub_eq_add_neg] at h1
      calc s ≤ ‖b' - algebraMap k E a'‖ := h1
        _ = ‖b'F - algebraMap k F a'‖ := by
          rw [← norm_algebraMap' F, map_sub, ← IsScalarTower.algebraMap_apply]
    -- `ε` with `‖b' - b''‖ < ε r(b')`
    set ε := (1 + ‖d‖ / s) / 2 with hε
    have hds : ‖d‖ / s < 1 := (div_lt_one hs).mpr hd
    have hε0 : 0 < ε := by rw [hε]; have := div_nonneg (norm_nonneg d) hs.le; linarith
    have hε1 : ε < 1 := by rw [hε]; linarith
    have hεd : ‖b'F - b''‖ < ε * radius k b'F := by
      rw [hdist]
      have h1 : ‖d‖ < ε * s := by
        rw [hε]
        have : ‖d‖ = ‖d‖ / s * s := by field_simp
        nlinarith
      exact h1.trans_le (mul_le_mul_of_nonneg_left hrad hε0.le)
    -- `F` is finite of degree `p` over `\overline{k(b'')}`
    have hfr : (IsScalarTower.toAlgHom k E F).fieldRange = closureAdjoin k b'F := by
      apply SetLike.ext'
      rw [AlgHom.coe_fieldRange, ← hrange]
      rfl
    obtain ⟨hfin0, hdeg0⟩ := finrank_fieldRange_eq (k := k) (E := E) (F := F)
    rw [hfr, hdeg] at hdeg0
    rw [hfr] at hfin0
    obtain ⟨hfin', hdeg'⟩ := finiteDimensional_closureAdjoin_of_norm_sub_lt hε0 hε1 hεd
    rw [hdeg0] at hdeg'
    set E' := closureAdjoin k b'' with hE'
    -- `-b''` is a type 4 generator of `E'` without `p`-th root
    have hE'imm : IsImmediateOver k E' := fun x hx ↦ by
      obtain ⟨c', hc'⟩ := hF x (fun h0 ↦ hx (Subtype.ext h0))
      exact ⟨c', hc'⟩
    have hb''k : b'' ∉ Set.range (algebraMap k F) := notMem_range_of_norm_sub_lt hε1.le hεd
    set b''E : E' := ⟨b'', mem_closureAdjoin_self b''⟩
    have hb''Ek : b''E ∉ Set.range (algebraMap k E') := by
      rintro ⟨c', hc'⟩
      exact hb''k ⟨c', congrArg Subtype.val hc'⟩
    have hb''4 : IsTypeFourGenerator k b''E :=
      hE'imm.isTypeFourGenerator hb''Ek (dense_adjoin_closureAdjoin b'')
    have hnb4 := hb''4.affine 0 (neg_ne_zero.mpr (one_ne_zero (α := k)))
    rw [map_zero, map_neg, map_one, zero_add, neg_one_mul] at hnb4
    have hcE' : c ∉ Set.range (algebraMap E' F) := by
      rintro ⟨y, hy⟩
      apply hnb4.pow_char_ne (p := p) y
      apply Subtype.ext
      change (y : F) ^ p = -b''
      rw [show (y : F) = c from hy, hb'', neg_neg]
    have hcp : algebraMap E' F ⟨-b'', neg_mem (mem_closureAdjoin_self b'')⟩ = c ^ p := by
      change -b'' = c ^ p
      rw [hb'', neg_neg]
    have hdegc := finrank_adjoin_of_pow_char_mem p hcE' hcp
    have htop : IntermediateField.adjoin E' {c} = ⊤ :=
      IntermediateField.eq_of_le_of_finrank_eq le_top
        (by rw [IntermediateField.finrank_top', hdegc, hdeg'])
    refine ⟨c, ?_⟩
    have hC : Set.range (algebraMap E' F) ⊆ closureAdjoin k c := by
      rintro _ ⟨y, rfl⟩
      refine closureAdjoin_le_closureAdjoin ?_ y.2
      apply adjoin_le_closureAdjoin
      rw [hb'']
      exact neg_mem (pow_mem (IntermediateField.mem_adjoin_simple_self k c) p)
    have := eq_top_of_range_subset hC (mem_closureAdjoin_self c) htop
    rw [coe_closureAdjoin] at this
    exact dense_iff_closure_eq.mpr this
  · -- Case `a = 1`, `s = 1`
    subst hs1
    have ha₀ : a₀ = 1 := (algebraMap k E).injective (by rw [ha1, map_one])
    subst ha₀
    rw [map_one, map_one] at hsplit'
    obtain ⟨α', hα'⟩ := exists_root_of_isSplitCoset_one p hsplit'
    have hα'E : α' ∉ Set.range (algebraMap E F) := by
      rintro ⟨e, rfl⟩
      apply hns
      refine ⟨e, 0, by rw [norm_zero]; exact one_pos, ?_⟩
      have h0 : e ^ p - e + b' = 0 := (algebraMap E F).injective (by simpa using hα')
      rw [map_one, asMap_one_left]
      linear_combination h0
    have htop := adjoin_eq_top_of_finrank_eq_prime hp hdeg hα'E
    refine ⟨α', ?_⟩
    have hC : Set.range (algebraMap E F) ⊆ closureAdjoin k α' := by
      rw [hrange]
      apply closureAdjoin_le_closureAdjoin
      apply adjoin_le_closureAdjoin
      have : algebraMap E F b' = α' - α' ^ p := by linear_combination hα'
      rw [this]
      exact sub_mem (IntermediateField.mem_adjoin_simple_self k α')
        (pow_mem (IntermediateField.mem_adjoin_simple_self k α') p)
    have := eq_top_of_range_subset hC (mem_closureAdjoin_self α') htop
    rw [coe_closureAdjoin] at this
    exact dense_iff_closure_eq.mpr this

end TypeFourStep

/-! ### Auxiliary structures -/

section Aux

/-- The composite normed `k`-algebra structure on `N` for normed algebras `k → K → N`. Not an
instance; introduce it with `letI` where needed. -/
abbrev normedAlgebraComp (k K N : Type*) [NormedField k] [NormedField K] [NormedField N]
    [NormedAlgebra k K] [NormedAlgebra K N] : NormedAlgebra k N :=
  { ((algebraMap K N).comp (algebraMap k K)).toAlgebra with
    norm_smul_le := fun c x ↦ by
      change ‖(algebraMap K N (algebraMap k K c)) * x‖ ≤ ‖c‖ * ‖x‖
      rw [norm_mul, norm_algebraMap', norm_algebraMap'] }

theorem isScalarTower_normedAlgebraComp (k K N : Type*) [NormedField k] [NormedField K]
    [NormedField N] [NormedAlgebra k K] [NormedAlgebra K N] :
    letI := normedAlgebraComp k K N
    IsScalarTower k K N := by
  let := normedAlgebraComp k K N
  exact IsScalarTower.of_algebraMap_eq fun _ ↦ rfl

/-- The residue field of a normed algebra over `k` has the exponential characteristic of `k̃`. -/
theorem expChar_residueField_of_normedAlgebra {k K : Type*} [NormedField k] [IsUltrametricDist k]
    [NormedField K] [IsUltrametricDist K] [NormedAlgebra k K] (p : ℕ)
    [ExpChar (ResidueField (unitBall k)) p] : ExpChar (ResidueField (unitBall K)) p :=
  expChar_of_injective_algebraMap
    (algebraMap (ResidueField (unitBall k)) (ResidueField (unitBall K))).injective p

/-- If `N/K` is immediate (`e = f = 1`), its Galois group is a `p`-group. -/
theorem isPGroup_of_isImmediate {K N : Type*} [NontriviallyNormedField K] [IsUltrametricDist K]
    [CompleteSpace K] [NormedField N] [IsUltrametricDist N] [NormedAlgebra K N]
    [FiniteDimensional K N] (p : ℕ) [ExpChar (ResidueField (unitBall K)) p]
    (h : IsImmediate K N) : IsPGroup p (N ≃ₐ[K] N) := by
  have hV : wildInertiaSubgroup K N = ⊤ := by
    rw [wildInertiaSubgroup_eq_inertiaSubgroup h.1, inertiaSubgroup_eq_top h.2]
  have := isPGroup_wildInertiaSubgroup (K := K) (N := N) p
  rw [hV] at this
  exact this.of_equiv Subgroup.topEquiv

/-- The image of `L` under an isometric embedding `ι : L → N` of a field topologically generated by
one element: if `ι(L) ⊆ closure k(ι x)`, then `L ⊆ closure k(x)`. -/
theorem subset_closure_of_isometry {k B L N : Type*} [Field k] [Field B] [NormedField L]
    [NormedField N] [Algebra k L] [Algebra k N] [Algebra B L] [Algebra k B] [IsScalarTower k B L]
    (S : IntermediateField B L) (ι : S →ₐ[k] N) (hι : Isometry ι) {x : S}
    (h : ∀ w : S, ι w ∈ closure (k⟮ι x⟯ : Set N)) :
    (S : Set L) ⊆ closure (k⟮(x : L)⟯ : Set L) := by
  rw [← dense_adjoin_iff S x.2]
  have himage : ι '' (k⟮x⟯ : Set S) = (k⟮ι x⟯ : Set N) := by
    have := IntermediateField.adjoin_map k {x} ι
    rw [Set.image_singleton] at this
    exact congrArg (fun T : IntermediateField k N ↦ (T : Set N)) this
  have hind := hι.isUniformInducing.isInducing
  rw [dense_iff_closure_eq, hind.closure_eq_preimage_closure_image, himage]
  ext w
  simpa using h w

end Aux

/-! ### Type 4 fields -/

section TypeFour

variable {k K L : Type*} [NontriviallyNormedField k] [IsUltrametricDist k] [CompleteSpace k]
  [IsAlgClosed k] [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
  [NormedAlgebra k K] [NormedField L] [IsUltrametricDist L] [NormedAlgebra K L]
  [NormedAlgebra k L] [IsScalarTower k K L] [FiniteDimensional K L]

set_option linter.style.haveILetI false in
/-- **Type 4 fields** (Temkin, Theorem 6.3.1(i), type 4, lines 4089–4112; blueprint
`prop:sm-an-type4-generated`): if `K` has a type 4 generator over the algebraically closed
`k` (equal characteristic `p`), every finite extension `L/K` has a type 4 generator. -/
theorem IsTypeFourGenerator.exists_isTypeFourGenerator (p : ℕ) [hk : ExpChar k p]
    [ExpChar (ResidueField (unitBall k)) p] {z : K} (hz : IsTypeFourGenerator k z) :
    ∃ x : L, IsTypeFourGenerator k x := by
  have hK : IsImmediateOver k K := fun x hx ↦ hz.exists_norm_sub_lt hx
  have hL : IsImmediateOver k L := hK.of_finiteDimensional
  have hzk : algebraMap K L z ∉ Set.range (algebraMap k L) := by
    rintro ⟨c, hc⟩
    have hz0 : z = algebraMap k K c := (algebraMap K L).injective (by
      rw [← hc, IsScalarTower.algebraMap_apply k K L])
    have := hz.radius_pos
    rw [hz0] at this
    exact notMem_range_of_radius_pos this ⟨c, rfl⟩
  suffices h : ∃ x : L, Dense (k⟮x⟯ : Set L) by
    obtain ⟨x, hx⟩ := h
    refine ⟨x, hL.isTypeFourGenerator ?_ hx⟩
    rintro ⟨c, rfl⟩
    have hbot : k⟮algebraMap k L c⟯ = ⊥ :=
      IntermediateField.adjoin_simple_eq_bot_iff.mpr (IntermediateField.algebraMap_mem _ _)
    have hcl : IsClosed (Set.range (algebraMap k L)) :=
      (algebraMap_isometry k L).isUniformInducing.isComplete_range.isClosed
    apply hzk
    have hmem : algebraMap K L z ∈ closure (k⟮algebraMap k L c⟯ : Set L) := by
      rw [hx.closure_eq]; trivial
    rwa [hbot, IntermediateField.coe_bot, hcl.closure_eq] at hmem
  have : ExpChar (ResidueField (unitBall K)) p := expChar_residueField_of_normedAlgebra (k := k) p
  set Ls := separableClosure K L with hLs
  refine galoisClosure_induction (K := K) (M := Ls) fun N _ _ _ _ _ _ _ ↦ ?_
  letI := normedAlgebraComp k K N
  haveI := isScalarTower_normedAlgebraComp k K N
  have hN : IsImmediateOver k N := hK.of_finiteDimensional
  have hG : IsPGroup p (N ≃ₐ[K] N) := isPGroup_of_isImmediate p hN.isImmediate
  set ι := IsScalarTower.toAlgHom K Ls N with hι
  have hιiso : Isometry ι := AddMonoidHomClass.isometry_of_norm ι fun x ↦ norm_algebraMap' N x
  obtain _ | ⟨hprime⟩ := hk
  · -- characteristic zero: `N = K`
    have hcard : Nat.card (N ≃ₐ[K] N) = 1 := by
      rw [Nat.card_eq_one_iff_unique]
      refine ⟨⟨fun σ τ ↦ ?_⟩, inferInstance⟩
      obtain ⟨n, hn⟩ := hG σ
      obtain ⟨m, hm⟩ := hG τ
      rw [one_pow, pow_one] at hn hm
      rw [hn, hm]
    have hNK : finrank K N = 1 := by rw [← IsGalois.card_aut_eq_finrank, hcard]
    have hLs1 : finrank K Ls ≤ 1 :=
      hNK ▸ LinearMap.finrank_le_finrank_of_injective (f := ι.toLinearMap) ι.injective
    have hLsbot : Ls = ⊥ := by
      have := Module.finrank_pos (R := K) (M := Ls)
      exact IntermediateField.finrank_eq_one_iff.mp (by omega)
    have : CharZero K := charZero_of_injective_algebraMap (algebraMap k K).injective
    have : Algebra.IsSeparable K L := Algebra.IsAlgebraic.isSeparable_of_perfectField
    have hLstop : Ls = ⊤ := (separableClosure.eq_top_iff K L).mpr inferInstance
    have hLK : finrank K L = 1 := by
      rw [← IntermediateField.finrank_top', ← hLstop, hLsbot, IntermediateField.finrank_bot]
    refine ⟨algebraMap K L z, ?_⟩
    have hrange := range_algebraMap_eq_closureAdjoin (F := L) hz.dense_adjoin
    have hsurj : Set.range (algebraMap K L) = Set.univ := by
      have := (IntermediateField.bot_eq_top_iff_finrank_eq_one (F := K) (E := L)).mpr hLK
      ext y
      simp only [Set.mem_range, Set.mem_univ, iff_true]
      have hy : y ∈ (⊥ : IntermediateField K L) := this ▸ IntermediateField.mem_top
      exact IntermediateField.mem_bot.mp hy
    rw [hsurj, coe_closureAdjoin] at hrange
    exact dense_iff_closure_eq.mpr hrange.symm
  · -- characteristic `p`
    have : Fact p.Prime := ⟨hprime⟩
    have : CharP K p := charP_of_injective_algebraMap (algebraMap k K).injective p
    have : CharP N p := charP_of_injective_algebraMap (algebraMap K N).injective p
    have : CharP L p := charP_of_injective_algebraMap (algebraMap K L).injective p
    -- the Galois part: every intermediate field of `N/K` is topologically generated
    have hgal : ∀ M : IntermediateField K N,
        ∃ x : N, x ∈ M ∧ (M : Set N) ⊆ closure (k⟮x⟯ : Set N) := by
      refine IsPGroup.induction_intermediateField hG
        (P := fun M ↦ ∃ x : N, x ∈ M ∧ (M : Set N) ⊆ closure (k⟮x⟯ : Set N)) ?_ ?_
      · refine ⟨algebraMap K N z, IntermediateField.algebraMap_mem _ _, ?_⟩
        have := range_algebraMap_eq_closureAdjoin (F := N) hz.dense_adjoin
        rw [IntermediateField.coe_bot, this, coe_closureAdjoin]
      · rintro E F hEF hgalEF hdeg ⟨x, hxE, hxcl⟩
        letI := normedAlgebraOfTower k E
        haveI : IsScalarTower k E N := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
        letI := normedAlgebraOfTower k (IntermediateField.extendScalars hEF)
        haveI : IsScalarTower k E (IntermediateField.extendScalars hEF) :=
          IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
        haveI : CompleteSpace E := FiniteDimensional.complete K E
        have hEimm : IsImmediateOver k E := fun y hy ↦ by
          obtain ⟨c, hc⟩ := hN y (fun h0 ↦ hy (Subtype.ext h0))
          exact ⟨c, hc⟩
        have hEd : Dense (k⟮(⟨x, hxE⟩ : E)⟯ : Set E) := (dense_adjoin_iff E hxE).mpr hxcl
        obtain ⟨α, hα, hαp, -⟩ := exists_artinSchreier_generator (M := E)
          (L := IntermediateField.extendScalars hEF) p hdeg
        obtain ⟨x', hx'⟩ := exists_dense_adjoin_of_step (E := E)
          (F := IntermediateField.extendScalars hEF) p hEimm hEd hdeg
          (Or.inr ⟨α, fun h ↦ hα h, hαp⟩)
        refine ⟨x', (IntermediateField.mem_extendScalars hEF).mp x'.2, ?_⟩
        have := (dense_adjoin_iff (IntermediateField.extendScalars hEF) x'.2).mp hx'
        intro w hw
        exact this ((IntermediateField.mem_extendScalars hEF).mpr hw)
    -- `L_s` is topologically generated
    obtain ⟨_, ⟨x₀, rfl⟩, hxcl⟩ := hgal ι.fieldRange
    have hLsd : (Ls : Set L) ⊆ closure (k⟮(x₀ : L)⟯ : Set L) :=
      subset_closure_of_isometry Ls (ι.restrictScalars k) hιiso fun w ↦ hxcl ⟨w, rfl⟩
    -- the inseparable part
    haveI : IsScalarTower k Ls L := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
    have hins : ∀ M : IntermediateField Ls L,
        ∃ x : L, x ∈ M ∧ (M : Set L) ⊆ closure (k⟮x⟯ : Set L) := by
      refine induction_intermediateField_of_isPurelyInseparable p
        (P := fun M ↦ ∃ x : L, x ∈ M ∧ (M : Set L) ⊆ closure (k⟮x⟯ : Set L)) ?_ ?_
      · refine ⟨(x₀ : L), ⟨x₀, rfl⟩, ?_⟩
        intro w hw
        obtain ⟨w', rfl⟩ := IntermediateField.mem_bot.mp hw
        exact hLsd w'.2
      · rintro E γ hγE hγp ⟨x, hxE, hxcl⟩
        letI := normedAlgebraOfTower k E
        haveI : IsScalarTower k E L := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
        letI := normedAlgebraOfTower k (IntermediateField.adjoin E {γ})
        haveI : IsScalarTower k E (IntermediateField.adjoin E {γ}) :=
          IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
        haveI : CompleteSpace Ls := FiniteDimensional.complete K Ls
        haveI : CompleteSpace E := FiniteDimensional.complete Ls E
        have hEimm : IsImmediateOver k E := fun y hy ↦ by
          obtain ⟨c, hc⟩ := hL y (fun h0 ↦ hy (Subtype.ext h0))
          exact ⟨c, hc⟩
        have hEd : Dense (k⟮(⟨x, hxE⟩ : E)⟯ : Set E) := (dense_adjoin_iff E hxE).mpr hxcl
        have hγE' : γ ∉ (algebraMap E L).range := fun ⟨e, he⟩ ↦ hγE (he ▸ e.2)
        have hdeg := finrank_adjoin_of_pow_char_mem p hγE'
          (c := ⟨γ ^ p, hγp⟩) rfl
        set γ' : IntermediateField.adjoin E {γ} := ⟨γ, IntermediateField.mem_adjoin_simple_self E γ⟩
        obtain ⟨x', hx'⟩ := exists_dense_adjoin_of_step (E := E)
          (F := IntermediateField.adjoin E {γ}) p hEimm hEd hdeg
          (Or.inl ⟨γ', fun ⟨e, he⟩ ↦ hγE' ⟨e, congrArg Subtype.val he⟩,
            ⟨⟨γ ^ p, hγp⟩, Subtype.ext rfl⟩⟩)
        refine ⟨x', x'.2, ?_⟩
        exact (dense_adjoin_iff (IntermediateField.adjoin E {γ}) x'.2).mp hx'
    obtain ⟨x, -, hx⟩ := hins ⊤
    refine ⟨x, dense_iff_closure_eq.mpr (Set.eq_univ_of_univ_subset ?_)⟩
    intro w _
    exact hx (IntermediateField.mem_top : w ∈ (⊤ : IntermediateField Ls L))

end TypeFour

/-! ### Type 3 fields -/

section PurelyInseparable

/-- In a purely inseparable extension `L/K` of exponential characteristic `p`, every `x ∉ K` has a
power `γ = x ^ p ^ n ∉ K` with `γ ^ p ∈ K`. -/
theorem exists_pow_char_mem_of_isPurelyInseparable {K L : Type*} [Field K] [Field L]
    [Algebra K L] (p : ℕ) [ExpChar K p] [IsPurelyInseparable K L] {x : L}
    (hx : x ∉ Set.range (algebraMap K L)) :
    ∃ γ : L, γ ∉ Set.range (algebraMap K L) ∧ γ ^ p ∈ Set.range (algebraMap K L) := by
  classical
  have hex : ∃ n : ℕ, x ^ p ^ n ∈ Set.range (algebraMap K L) := by
    obtain ⟨n, hn⟩ := IsPurelyInseparable.pow_mem K p x
    exact ⟨n, hn⟩
  obtain ⟨n, hn⟩ : ∃ n, n = Nat.find hex := ⟨_, rfl⟩
  have hspec : x ^ p ^ n ∈ Set.range (algebraMap K L) := hn ▸ Nat.find_spec hex
  have hn0 : n ≠ 0 := by
    rintro rfl
    rw [pow_zero, pow_one] at hspec
    exact hx hspec
  obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hn0
  refine ⟨x ^ p ^ m, Nat.find_min hex (by omega), ?_⟩
  rwa [← pow_mul, ← pow_succ]

end PurelyInseparable

section TypeThree

variable {k K L : Type*} [NontriviallyNormedField k] [IsUltrametricDist k] [IsAlgClosed k]
  [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K] [NormedAlgebra k K]
  [NormedField L] [IsUltrametricDist L] [NormedAlgebra K L] [FiniteDimensional K L]

set_option linter.style.haveILetI false in
/-- **Type 3 fields have no immediate extensions** (Temkin, Theorem 6.3.1(i), types 2 and 3, lines
4052–4065, along the proof structure of plan S5; blueprint `prop:sm-an-type3-no-immediate`): if `K`
has an annulus generator over the algebraically closed field `k` (equal characteristic), every
finite immediate extension of `K` is trivial. -/
theorem IsAnnulusGenerator.finrank_eq_one_of_isImmediate (p : ℕ) [hk : ExpChar k p]
    [ExpChar (ResidueField (unitBall k)) p] {z : K} (hz : IsAnnulusGenerator k z)
    (hL : IsImmediate K L) : finrank K L = 1 := by
  have hKres : IsResidueTrivial k K := fun x hx ↦ hz.exists_norm_sub_lt_one hx
  have : ExpChar (ResidueField (unitBall K)) p := expChar_residueField_of_normedAlgebra (k := k) p
  have : ExpChar K p := expChar_of_injective_algebraMap (algebraMap k K).injective p
  set Ls := separableClosure K L with hLs
  have hLsimm : IsImmediate K Ls := hL.of_isScalarTower_left
  -- the separable part: `L_s = K`
  have hLsbot : Ls = ⊥ := by
    refine galoisClosure_induction (K := K) (M := Ls) fun N _ _ _ _ _ _ _ ↦ ?_
    letI := normedAlgebraComp k K N
    haveI := isScalarTower_normedAlgebraComp k K N
    have hres : IsResidueTrivial k N := hKres.of_finiteDimensional
    have hT : inertiaSubgroup K N = ⊤ := by
      refine inertiaSubgroup_eq_top_of_forall fun x hx ↦ ?_
      obtain ⟨c, hc1, hc⟩ := hres x hx
      refine ⟨algebraMap k K c, by rwa [norm_algebraMap'], ?_⟩
      rwa [← IsScalarTower.algebraMap_apply]
    obtain ⟨-, y, hy, hWy⟩ := exists_pow_eq_and_fixedField_eq_adjoin hz hres
    have hVp : IsPGroup p (wildInertiaSubgroup K N) := isPGroup_wildInertiaSubgroup p
    have hGW : IsPGroup p (N ≃ₐ[IntermediateField.fixedField (wildInertiaSubgroup K N)] N) :=
      (hVp.of_equiv (MulEquiv.subgroupCongr
        (IntermediateField.fixingSubgroup_fixedField (wildInertiaSubgroup K N)).symm)).of_equiv
        (IntermediateField.fixingSubgroupEquiv _)
    have hWcart := isCartesian_fixedField_wildInertiaSubgroup hT
    obtain ⟨W, hW⟩ : ∃ W, W = IntermediateField.fixedField (wildInertiaSubgroup K N) := ⟨_, rfl⟩
    rw [← hW] at hy hWy hGW hWcart
    haveI : IsGalois K W := by rw [hW]; infer_instance
    -- `L' = ι(L_s)` is immediate over `K`
    set ι := IsScalarTower.toAlgHom K Ls N with hι
    obtain ⟨L', hL'⟩ : ∃ L', L' = ι.fieldRange := ⟨_, rfl⟩
    have hL'K : ∀ x ∈ L', x ≠ 0 → ∃ c : K, ‖x - algebraMap K N c‖ < ‖x‖ := by
      intro x hx hx0
      rw [hL'] at hx
      obtain ⟨u, rfl⟩ := AlgHom.mem_fieldRange.mp hx
      have hu0 : u ≠ 0 := by rintro rfl; exact hx0 (map_zero ι)
      obtain ⟨c, hc⟩ := hLsimm.exists_norm_sub_lt hu0
      refine ⟨c, ?_⟩
      have e1 : ι u - algebraMap K N c = algebraMap Ls N (u - algebraMap K Ls c) := by
        rw [map_sub, ← IsScalarTower.algebraMap_apply]; rfl
      have e2 : ι u = algebraMap Ls N u := rfl
      rw [e1, e2, norm_algebraMap', norm_algebraMap']
      exact hc
    -- `L'W/W` is immediate
    have hsup := isImmediate_sup_of_isCartesian (L' := L') (W := W) hWcart fun x hx hx0 ↦ by
      obtain ⟨c, hc⟩ := hL'K x hx hx0
      exact ⟨algebraMap K N c, IntermediateField.mem_inf.mpr
        ⟨L'.algebraMap_mem c, W.algebraMap_mem c⟩, hc⟩
    -- `L' ⊆ W`
    have hL'W : L' ≤ W := by
      obtain _ | ⟨hprime⟩ := hk
      · -- `p = 1`: `V = 1` and `W = N`
        have hV : wildInertiaSubgroup K N = ⊥ := by
          refine eq_bot_iff.mpr fun σ hσ ↦ ?_
          obtain ⟨n, hn⟩ := hVp ⟨σ, hσ⟩
          rw [one_pow, pow_one] at hn
          exact Subgroup.mem_bot.mpr (congrArg Subtype.val hn)
        rw [hW, hV, IntermediateField.fixedField_bot]
        exact le_top
      · have : Fact p.Prime := ⟨hprime⟩
        have : CharP K p := charP_of_injective_algebraMap (algebraMap k K).injective p
        have : CharP W p := charP_of_injective_algebraMap (algebraMap K W).injective p
        haveI : CompleteSpace W := FiniteDimensional.complete K W
        letI := normedAlgebraOfTower k W
        have hyW : y ∈ W := by rw [hWy]; exact IntermediateField.mem_adjoin_simple_self K y
        -- `y` is an annulus generator of `W`
        have hC : Set.range (algebraMap K N) ⊆ closureAdjoin k y := by
          rw [range_algebraMap_eq_closureAdjoin (F := N) hz.dense_adjoin, ← hy]
          exact SetLike.coe_subset_coe.mpr
            (closureAdjoin_le_closureAdjoin (pow_mem (mem_closureAdjoin_self y) _))
        have hWsub : (W : Set N) ⊆ closure (k⟮y⟯ : Set N) := by
          rw [hWy, ← coe_closureAdjoin]
          exact adjoin_subset_of_range_subset hC (mem_closureAdjoin_self y)
        have hyann : IsAnnulusGenerator k (⟨y, hyW⟩ : W) := by
          refine ⟨(dense_adjoin_iff W hyW).mpr hWsub, fun c hc ↦ ?_⟩
          apply hz.norm_ne (c ^ finrank K W)
          have h1 : ‖y‖ = ‖c‖ := hc
          rw [norm_pow, ← h1, ← norm_pow, hy, norm_algebraMap']
        have hcm : ∀ (a : W) (s : ℝ) (b : W), IsSpecialCoset p a s b →
            ∃ x, IsMinimalInCoset p a s b x := fun a s b hsp ↦ by
          obtain ⟨v, -, hv⟩ := hyann.exists_isMinimalInCoset hsp
          exact ⟨v, hv⟩
        have hle : W ≤ L' ⊔ W := le_sup_right
        have hbot := eq_bot_of_isImmediate_of_isPGroup (W := W) (N := N) p hGW hcm
          (M := IntermediateField.extendScalars hle)
          (isImmediate_of_forall_exists_norm_sub_lt fun x hx ↦ by
            obtain ⟨c, hcW, hc⟩ := hsup x ((IntermediateField.mem_extendScalars hle).mp x.2)
              fun h0 ↦ hx (Subtype.ext h0)
            exact ⟨⟨c, hcW⟩, hc⟩)
        have heq : L' ⊔ W = W := by
          have := congrArg (IntermediateField.restrictScalars K) hbot
          rwa [IntermediateField.extendScalars_restrictScalars,
            IntermediateField.restrictScalars_bot_eq_self] at this
        exact heq ▸ le_sup_left
    -- `L' ⊆ W` is immediate and `W/K` is Cartesian, so `L' = K`
    letI := normedAlgebraOfLE hL'W
    haveI : IsScalarTower K L' W := isScalarTower_base_normedAlgebraOfLE hL'W
    have : FiniteDimensional L' W := FiniteDimensional.right K L' W
    have hL'imm : IsImmediate K L' := isImmediate_of_forall_exists_norm_sub_lt fun x hx ↦
      hL'K x x.2 fun h0 ↦ hx (Subtype.ext h0)
    have hL'cart : IsCartesian K L' := ((isCartesian_iff_of_tower K L' W).mp hWcart).1
    have h1 : finrank K L' = 1 := by
      have h := hL'cart
      unfold IsCartesian at h
      rw [hL'imm.1, hL'imm.2] at h
      omega
    have h2 : finrank K Ls = finrank K L' := by
      rw [hL']
      exact ι.equivFieldRange.toLinearEquiv.finrank_eq
    exact IntermediateField.finrank_eq_one_iff.mp (h2.trans h1)
  -- the inseparable part
  have : Algebra.IsAlgebraic K L := Algebra.IsAlgebraic.of_finite K L
  have hpi : IsPurelyInseparable K L := (separableClosure.eq_bot_iff).mp hLsbot
  by_contra hne
  obtain ⟨x, hx⟩ : ∃ x : L, x ∉ Set.range (algebraMap K L) := by
    by_contra h
    push Not at h
    apply hne
    refine IntermediateField.bot_eq_top_iff_finrank_eq_one.mp (eq_top_iff.mpr fun y _ ↦ ?_)
    obtain ⟨c, rfl⟩ := h y
    exact IntermediateField.algebraMap_mem _ c
  obtain ⟨γ, hγ, hγp⟩ := exists_pow_char_mem_of_isPurelyInseparable (K := K) p hx
  obtain _ | ⟨hprime⟩ := hk
  · rw [pow_one] at hγp
    exact hγ hγp
  · have : Fact p.Prime := ⟨hprime⟩
    have : CharP K p := charP_of_injective_algebraMap (algebraMap k K).injective p
    exact IsImmediate.not_pow_char_mem_of_critMinZero p
      (fun s b hsp ↦ by obtain ⟨v, -, hv⟩ := hz.exists_isMinimalInCoset hsp; exact ⟨v, hv⟩)
      hL hγ hγp

end TypeThree

section ValueGenerator

variable {k K L : Type*} [NormedField k] [IsAlgClosed k] [NormedField K] [IsUltrametricDist K]
  [NormedAlgebra k K] [NormedField L] [IsUltrametricDist L] [NormedAlgebra K L]
  [FiniteDimensional K L]

/-- **A generator of the value group** (blueprint `lem:sm-an-type3-value-generator`; used in
Temkin's proof of Theorem 6.3.1(i), type 3, lines 4053–4054): if `K` has an annulus generator `w`
over the algebraically closed field `k` and `L/K` is finite, there is `z ∈ L` with `‖z‖ ∉ |k|`
such that every `x ∈ L^×` satisfies `‖x‖ = ‖z‖ ^ j ‖c‖` for some `j ∈ ℤ` and `c ∈ k`. -/
theorem IsAnnulusGenerator.exists_forall_norm_eq_zpow_mul {w : K} (hw : IsAnnulusGenerator k w) :
    ∃ z : L, (∀ c : k, ‖z‖ ≠ ‖c‖) ∧
      ∀ x : L, x ≠ 0 → ∃ (j : ℤ) (c : k), ‖x‖ = ‖z‖ ^ j * ‖c‖ := by
  classical
  set m := Nat.card (ValueGroupQuotient K L) with hm_def
  have hm : 0 < m := Nat.card_pos
  have hR : ‖w‖ ≠ 0 := hw.norm_pos.ne'
  -- `‖x‖ ^ m = ‖a‖ ‖w‖ ^ j` with `a ∈ k^×`
  have hj : ∀ x : L, x ≠ 0 → ∃ a : k, a ≠ 0 ∧ ∃ j : ℤ, ‖x‖ ^ m = ‖a‖ * ‖w‖ ^ j := by
    intro x hx
    set u : Lˣ := Units.mk0 x hx
    have h1 : valueClass K L 1 = valueClass K L (u ^ m) := by
      rw [map_one, map_pow, hm_def, pow_card_eq_one']
    obtain ⟨c, hc⟩ := valueClass_eq_valueClass_iff.mp h1
    simp only [Units.val_pow_eq_pow_val, Units.val_mk0, norm_pow, Units.val_one, norm_one,
      mul_one, u] at hc
    have hc0 : c ≠ 0 := by
      rintro rfl
      rw [norm_zero] at hc
      exact hx (norm_eq_zero.mp (pow_eq_zero_iff hm.ne' |>.mp hc))
    obtain ⟨a, ha, j, hja⟩ := hw.exists_norm_eq_mul_zpow hc0
    exact ⟨a, ha, j, hc.trans hja⟩
  -- the smallest positive exponent `d`
  have hS : ∃ n : ℕ, 0 < n ∧ ∃ x : L, x ≠ 0 ∧ ∃ a : k, a ≠ 0 ∧
      ‖x‖ ^ m = ‖a‖ * ‖w‖ ^ (n : ℤ) := by
    refine ⟨m, hm, algebraMap K L w, (_root_.map_ne_zero _).mpr hw.ne_zero, 1, one_ne_zero, ?_⟩
    rw [norm_algebraMap', norm_one, one_mul, zpow_natCast]
  obtain ⟨d, hd⟩ : ∃ d, d = Nat.find hS := ⟨_, rfl⟩
  obtain ⟨hdpos, z, hz0, az, haz, hz⟩ := hd ▸ Nat.find_spec hS
  have hZ : ‖z‖ ≠ 0 := norm_ne_zero_iff.mpr hz0
  -- the exponent of `x z ^ (-q)`
  have key : ∀ (x : L) (a : k) (j q : ℤ), ‖x‖ ^ m = ‖a‖ * ‖w‖ ^ j →
      ‖x * z ^ (-q)‖ ^ m = ‖a * az ^ (-q)‖ * ‖w‖ ^ (j - d * q) := by
    intro x a j q hx
    have hZq : (‖z‖ ^ q) ^ m = ‖az‖ ^ q * ‖w‖ ^ ((d : ℤ) * q) := by
      rw [← zpow_natCast, ← zpow_mul, mul_comm q, zpow_mul, zpow_natCast, hz, mul_zpow,
        zpow_mul]
    rw [norm_mul, norm_mul, norm_zpow, norm_zpow, zpow_neg, zpow_neg, mul_pow, inv_pow, hx, hZq,
      zpow_sub₀ hR, mul_inv]
    ring
  refine ⟨z, fun c hc ↦ ?_, fun x hx ↦ ?_⟩
  · have h1 : ‖az‖ * ‖w‖ ^ (d : ℤ) = ‖c ^ m‖ * ‖w‖ ^ (0 : ℤ) := by
      rw [← hz, zpow_zero, mul_one, norm_pow, hc]
    have := hw.eq_of_norm_mul_zpow_eq haz h1
    omega
  · obtain ⟨a, ha, j, hja⟩ := hj x hx
    have hd0 : (d : ℤ) ≠ 0 := by omega
    obtain ⟨r, hr⟩ := Int.eq_ofNat_of_zero_le (Int.emod_nonneg j hd0)
    have hrd : (r : ℤ) < d := hr ▸ Int.emod_lt_of_pos j (by omega)
    have hjr : j - d * (j / d) = r := by have := Int.mul_ediv_add_emod j d; omega
    have hy := key x a j (j / d) hja
    rw [hjr] at hy
    have hr0 : r = 0 := by
      by_contra hr0
      refine Nat.find_min hS (show r < Nat.find hS by omega) ⟨by omega, x * z ^ (-(j / d)),
        mul_ne_zero hx (zpow_ne_zero _ hz0), a * az ^ (-(j / d)),
        mul_ne_zero ha (zpow_ne_zero _ haz), hy⟩
    rw [hr0, Nat.cast_zero, zpow_zero, mul_one] at hy
    obtain ⟨c, hc⟩ := IsAlgClosed.exists_pow_nat_eq (a * az ^ (-(j / d))) hm
    refine ⟨j / d, c, ?_⟩
    have h1 : ‖x * z ^ (-(j / d))‖ = ‖c‖ := by
      have : ‖x * z ^ (-(j / d))‖ ^ m = ‖c‖ ^ m := by rw [hy, ← norm_pow, hc]
      exact (pow_left_inj₀ (norm_nonneg _) (norm_nonneg _) hm.ne').mp this
    rw [norm_mul, norm_zpow, zpow_neg] at h1
    have hZq : ‖z‖ ^ (j / d) ≠ 0 := zpow_ne_zero _ hZ
    rw [← h1]
    field_simp

end ValueGenerator

/-! ### Type 2 fields -/

section Invariance

variable {K A B : Type*} [NormedField K] [IsUltrametricDist K] [NormedField A]
  [IsUltrametricDist A] [NormedField B] [IsUltrametricDist B] [NormedAlgebra K A]
  [NormedAlgebra K B]

/-- An isometric `K`-isomorphism `A ≃ B` restricts to an isomorphism of unit balls. -/
def unitBallEquivOfIsometry (φ : A ≃ₐ[K] B) (hφ : ∀ a, ‖φ a‖ = ‖a‖) :
    unitBall A ≃+* unitBall B where
  toFun x := ⟨φ (x : A), mem_unitBall.mpr ((hφ x).trans_le (norm_coe_unitBall_le_one x))⟩
  invFun y := ⟨φ.symm (y : B), mem_unitBall.mpr (by
    rw [← hφ, φ.apply_symm_apply]; exact norm_coe_unitBall_le_one y)⟩
  left_inv x := Subtype.ext (φ.symm_apply_apply (x : A))
  right_inv y := Subtype.ext (φ.apply_symm_apply (y : B))
  map_mul' x y := Subtype.ext (map_mul φ (x : A) (y : A))
  map_add' x y := Subtype.ext (map_add φ (x : A) (y : A))

/-- The residue degree is invariant under isometric `K`-isomorphisms. -/
theorem inertiaDegree_eq_of_algEquiv (φ : A ≃ₐ[K] B) (hφ : ∀ a, ‖φ a‖ = ‖a‖) :
    inertiaDegree K A = inertiaDegree K B := by
  rw [inertiaDegree_def, inertiaDegree_def]
  refine Algebra.finrank_eq_of_equiv_equiv (RingEquiv.refl _)
    (ResidueField.mapEquiv (unitBallEquivOfIsometry φ hφ)) (RingHom.ext fun w ↦ ?_)
  obtain ⟨c, rfl⟩ := residue_surjective w
  simp only [RingHom.coe_comp, Function.comp_apply, RingEquiv.toRingHom_eq_coe,
    RingEquiv.coe_toRingHom, RingEquiv.refl_apply, algebraMap_residue,
    ResidueField.mapEquiv_apply, ResidueField.map_residue]
  congr 1
  exact Subtype.ext (φ.commutes (c : K)).symm

omit [NormedAlgebra K B] in
/-- If every element of `B` has the absolute value of an element of `K`, then `e_{B/K} = 1`. -/
theorem ramificationIndex_eq_one_of_forall_exists_norm_eq
    (h : ∀ x : B, ∃ c : K, ‖c‖ = ‖x‖) : ramificationIndex K B = 1 := by
  refine Subgroup.relIndex_eq_one.mpr fun γ hγ ↦ ?_
  obtain ⟨x, hx⟩ := mem_valueGroup_iff.mp hγ
  obtain ⟨c, hc⟩ := h x
  refine mem_valueGroup_iff.mpr ⟨c, ?_⟩
  rw [← hx]
  ext
  simp [hc]

/-- A purely inseparable extension has a purely inseparable residue field extension. -/
theorem isPurelyInseparable_residueField (q : ℕ) [ExpChar K q] [IsPurelyInseparable K B]
    [ExpChar (ResidueField (unitBall K)) q] :
    IsPurelyInseparable (ResidueField (unitBall K)) (ResidueField (unitBall B)) := by
  rw [isPurelyInseparable_iff_pow_mem _ q]
  intro w
  obtain ⟨y, rfl⟩ := residue_surjective w
  obtain ⟨n, c, hc⟩ := IsPurelyInseparable.pow_mem K q (y : B)
  have hc1 : ‖c‖ ≤ 1 := by
    rw [← norm_algebraMap' B c, hc, norm_pow]
    exact pow_le_one₀ (norm_nonneg _) (norm_coe_unitBall_le_one y)
  refine ⟨n, residue (unitBall K) ⟨c, mem_unitBall.mpr hc1⟩, ?_⟩
  rw [algebraMap_residue, ← map_pow]
  congr 1
  apply Subtype.ext
  rw [coe_algebraMap_unitBall, SubmonoidClass.coe_pow]
  exact hc

end Invariance

section HenselApprox

variable {K M N : Type*} [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
  [NormedField M] [IsUltrametricDist M] [CompleteSpace M] [NormedAlgebra K M]
  [NormedField N] [IsUltrametricDist N] [NormedAlgebra K N] [FiniteDimensional K N]

/-- **Hensel lifts of separable residues lie in the inertia field** (the Hensel step in the proof
of blueprint `prop:sm-an-type2-unramified`): let `ι : M → N` be an isometric `K`-embedding of a
complete field into a finite extension `N/K`, and `u ∈ M°` with residue separable over `K̃`. There
is `v ∈ M` with `‖v - u‖ < 1` and `ι v` in the inertia field of `N/K`. -/
theorem exists_norm_sub_lt_one_and_mem_fixedField (ι : M →ₐ[K] N) (hι : ∀ x, ‖ι x‖ = ‖x‖)
    {u : M} (hu : ‖u‖ ≤ 1)
    (hsep : IsSeparable (ResidueField (unitBall K))
      (residue (unitBall M) ⟨u, mem_unitBall.mpr hu⟩)) :
    ∃ v : M, ‖v - u‖ < 1 ∧ ι v ∈ IntermediateField.fixedField (inertiaSubgroup K N) := by
  set θb := residue (unitBall M) ⟨u, mem_unitBall.mpr hu⟩ with hθb
  set gb := minpoly (ResidueField (unitBall K)) θb with hgb_def
  have hgbsep : gb.Separable := hsep
  have hθbint : IsIntegral (ResidueField (unitBall K)) θb := hsep.isIntegral
  have hgbmonic : gb.Monic := minpoly.monic hθbint
  obtain ⟨g₀, hg₀⟩ := Polynomial.map_surjective (residue (unitBall K)) residue_surjective gb
  obtain ⟨g, hgmap, -, hgmonic⟩ := Polynomial.lifts_and_natDegree_eq_and_monic
    ((Polynomial.mem_lifts gb).mpr ⟨g₀, hg₀⟩) hgbmonic
  set G := g.map (algebraMap (unitBall K) (unitBall M)) with hG_def
  have hGmonic : G.Monic := hgmonic.map _
  have hGres : G.map (residue (unitBall M)) =
      gb.map (algebraMap (ResidueField (unitBall K)) (ResidueField (unitBall M))) := by
    rw [hG_def, Polynomial.map_map, ← hgmap, Polynomial.map_map]
    congr 1
  have hroot : aeval θb G = 0 := by
    rw [aeval_def, ResidueField.algebraMap_eq, ← eval_map, hGres, eval_map, ← aeval_def,
      minpoly.aeval]
  have hroot' : aeval θb (derivative G) ≠ 0 := by
    rw [aeval_def, ResidueField.algebraMap_eq, ← eval_map, ← Polynomial.derivative_map, hGres,
      Polynomial.derivative_map, eval_map, ← aeval_def]
    exact hgbsep.aeval_derivative_ne_zero (minpoly.aeval _ θb)
  obtain ⟨θ, hθroot, hθres⟩ := exists_isRoot_residue_eq G hGmonic θb hroot hroot'
  have hθ1 : ‖(θ : M)‖ ≤ 1 := norm_coe_unitBall_le_one θ
  have hθM : aeval (θ : M) g = 0 := by
    rw [← coe_eval_map_unitBall, ← hG_def, hθroot.eq_zero]
    rfl
  have hθd : ‖aeval (θ : M) (derivative g)‖ = 1 := by
    rw [← coe_eval_map_unitBall, ← Polynomial.derivative_map, ← hG_def]
    apply norm_eq_one_of_residue_ne_zero
    rw [hG_def, Polynomial.derivative_map, residue_eval_map_unitBall, ← Polynomial.derivative_map,
      hgmap, hθres]
    exact hgbsep.aeval_derivative_ne_zero (minpoly.aeval _ θb)
  refine ⟨θ, ?_, ?_⟩
  · have h := hθres
    rw [hθb, residue_eq_residue_iff] at h
    exact h
  · set ι' : M →ₐ[unitBall K] N := ι.restrictScalars (unitBall K)
    have h1 : aeval (ι θ) g = 0 := by
      have := Polynomial.aeval_algHom_apply ι' (θ : M) g
      rw [hθM, map_zero] at this
      exact this
    have h2 : ‖aeval (ι θ) (derivative g)‖ = 1 := by
      have e : aeval (ι θ) (derivative g) = ι (aeval (θ : M) (derivative g)) :=
        Polynomial.aeval_algHom_apply ι' (θ : M) (derivative g)
      rw [e, hι, hθd]
    exact mem_fixedField_inertiaSubgroup_of_isRoot g (by rw [hι]; exact hθ1) h1 h2

end HenselApprox

section TypeTwo

variable {k K L : Type*} [NontriviallyNormedField k] [IsUltrametricDist k] [IsAlgClosed k]
  [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K] [NormedAlgebra k K]
  [NormedField L] [IsUltrametricDist L] [NormedAlgebra K L] [FiniteDimensional K L]

set_option linter.style.haveILetI false in
/-- **Unramifiedness over type 2 fields** (Temkin, Theorem 6.3.1(i), types 2 and 3, lines 4052–4065,
along the proof structure of plan S5; blueprint `prop:sm-an-type2-unramified`): if `K` has a
Gauss generator over the algebraically closed field `k` (equal characteristic) and `L/K` is a
finite extension with separable residue field extension, then `L/K` is unramified. -/
theorem IsGaussGenerator.isUnramified (p : ℕ) [hk : ExpChar k p]
    [ExpChar (ResidueField (unitBall k)) p] {z : K} (hz : IsGaussGenerator k z)
    [hsep : Algebra.IsSeparable (ResidueField (unitBall K)) (ResidueField (unitBall L))] :
    IsUnramified K L := by
  have hKval : IsValueTrivial k K := fun x ↦ hz.exists_norm_eq x
  have : ExpChar (ResidueField (unitBall K)) p := expChar_residueField_of_normedAlgebra (k := k) p
  have : ExpChar K p := expChar_of_injective_algebraMap (algebraMap k K).injective p
  haveI : CompleteSpace L := FiniteDimensional.complete K L
  letI := normedAlgebraComp k K L
  haveI := isScalarTower_normedAlgebraComp k K L
  set Ls := separableClosure K L with hLs
  haveI : CompleteSpace Ls := FiniteDimensional.complete K Ls
  letI := normedAlgebraOfTower k Ls
  haveI : IsScalarTower k K Ls := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  have hLsval : IsValueTrivial k Ls := hKval.of_finiteDimensional
  have hsepLs : Algebra.IsSeparable (ResidueField (unitBall K)) (ResidueField (unitBall Ls)) :=
    Algebra.isSeparable_tower_bot_of_isSeparable _ _ (ResidueField (unitBall L))
  -- the separable part: `f_{L_s/K} = [L_s : K]`
  have hLsf : inertiaDegree K Ls = finrank K Ls := by
    refine galoisClosure_induction (K := K) (M := Ls) fun N _ _ _ _ _ _ _ ↦ ?_
    letI := normedAlgebraComp k K N
    haveI := isScalarTower_normedAlgebraComp k K N
    have hNval : IsValueTrivial k N := hKval.of_finiteDimensional
    have hNK' : ∀ x : N, ∃ c : K, ‖c‖ = ‖x‖ := fun x ↦ by
      obtain ⟨c, hc⟩ := hNval x
      exact ⟨algebraMap k K c, by rw [norm_algebraMap', hc]⟩
    have hTV : inertiaSubgroup K N = wildInertiaSubgroup K N :=
      le_antisymm (inertiaSubgroup_le_wildInertiaSubgroup fun x _ ↦ hNK' x)
        wildInertiaSubgroup_le_inertiaSubgroup
    have hTp : IsPGroup p (inertiaSubgroup K N) := by
      rw [hTV]
      exact isPGroup_wildInertiaSubgroup p
    have hGZ : IsPGroup p (N ≃ₐ[IntermediateField.fixedField (inertiaSubgroup K N)] N) :=
      (hTp.of_equiv (MulEquiv.subgroupCongr
        (IntermediateField.fixingSubgroup_fixedField (inertiaSubgroup K N)).symm)).of_equiv
        (IntermediateField.fixingSubgroupEquiv _)
    have hZf := inertiaDegree_inertiaField (K := K) (N := N)
    have hZsep := isSeparable_residueField_inertiaField (K := K) (N := N)
    obtain ⟨Z, hZ⟩ : ∃ Z, Z = IntermediateField.fixedField (inertiaSubgroup K N) := ⟨_, rfl⟩
    rw [← hZ] at hGZ hZf hZsep
    haveI : IsGalois K Z := by rw [hZ]; infer_instance
    have hZe : ramificationIndex K Z = 1 :=
      ramificationIndex_eq_one_of_forall_exists_norm_eq fun x ↦ hNK' x
    have hZcart : IsCartesian K Z := by
      unfold IsCartesian
      rw [hZe, one_mul, hZf]
    -- `L' = ι(L_s)` is approximated by `L' ∩ Z` (Hensel's lemma)
    set ι := IsScalarTower.toAlgHom K Ls N with hι
    have hιn : ∀ x, ‖ι x‖ = ‖x‖ := fun x ↦ norm_algebraMap' N x
    obtain ⟨L', hL'⟩ : ∃ L', L' = ι.fieldRange := ⟨_, rfl⟩
    have hL'B : ∀ x ∈ L', x ≠ 0 → ∃ c ∈ L' ⊓ Z, ‖x - c‖ < ‖x‖ := by
      intro x hx hx0
      rw [hL'] at hx
      obtain ⟨v, rfl⟩ := AlgHom.mem_fieldRange.mp hx
      have hv0 : v ≠ 0 := by rintro rfl; exact hx0 (map_zero ι)
      obtain ⟨d, hd⟩ := hLsval v
      set c : K := algebraMap k K d with hc_def
      have hc : ‖algebraMap K Ls c‖ = ‖v‖ := by rw [norm_algebraMap', norm_algebraMap', hd]
      have hc0 : algebraMap K Ls c ≠ 0 := by
        intro h0
        rw [h0, norm_zero] at hc
        exact hv0 (norm_eq_zero.mp hc.symm)
      set u := v / algebraMap K Ls c with hu_def
      have hu : ‖u‖ ≤ 1 := by
        rw [hu_def, norm_div, hc, div_self (norm_ne_zero_iff.mpr hv0)]
      obtain ⟨u₁, hu₁, hu₁Z⟩ := exists_norm_sub_lt_one_and_mem_fixedField ι hιn hu
        (Algebra.IsSeparable.isSeparable _ _)
      rw [← hZ] at hu₁Z
      refine ⟨ι (algebraMap K Ls c * u₁), IntermediateField.mem_inf.mpr ⟨?_, ?_⟩, ?_⟩
      · rw [hL']
        exact AlgHom.mem_fieldRange.mpr ⟨_, rfl⟩
      · rw [map_mul, AlgHom.commutes]
        exact Z.mul_mem (Z.algebraMap_mem c) hu₁Z
      · rw [← map_sub, hιn]
        have : v - algebraMap K Ls c * u₁ = algebraMap K Ls c * (u - u₁) := by
          rw [hu_def, mul_sub, mul_div_cancel₀ _ hc0]
        rw [this, norm_mul, hc, hιn, norm_sub_rev]
        exact mul_lt_of_lt_one_right (norm_pos_iff.mpr hv0) hu₁
    -- `L'Z/Z` is immediate
    have hsup := isImmediate_sup_of_isCartesian (L' := L') (W := Z) hZcart hL'B
    -- `L' ⊆ Z`
    have hL'Z : L' ≤ Z := by
      obtain _ | ⟨hprime⟩ := hk
      · -- `p = 1`: `T = 1` and `Z = N`
        have hT : inertiaSubgroup K N = ⊥ := by
          refine eq_bot_iff.mpr fun σ hσ ↦ ?_
          obtain ⟨n, hn⟩ := hTp ⟨σ, hσ⟩
          rw [one_pow, pow_one] at hn
          exact Subgroup.mem_bot.mpr (congrArg Subtype.val hn)
        rw [hZ, hT, IntermediateField.fixedField_bot]
        exact le_top
      · have : Fact p.Prime := ⟨hprime⟩
        have : CharP K p := charP_of_injective_algebraMap (algebraMap k K).injective p
        have : CharP Z p := charP_of_injective_algebraMap (algebraMap K Z).injective p
        haveI : CompleteSpace Z := FiniteDimensional.complete K Z
        letI := normedAlgebraOfTower k Z
        haveI : IsScalarTower k K Z := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
        obtain ⟨U, -, -, hmin⟩ := IsGaussGenerator.exists_isMinimalInCoset (L := Z) p hz hZf.ge
        have hcm : ∀ (a : Z) (s : ℝ) (b : Z), IsSpecialCoset p a s b →
            ∃ x, IsMinimalInCoset p a s b x := fun a s b hsp ↦ by
          obtain ⟨v, -, hv, -⟩ := hmin hsp
          exact ⟨v, hv⟩
        have hle : Z ≤ L' ⊔ Z := le_sup_right
        have hbot := eq_bot_of_isImmediate_of_isPGroup (W := Z) (N := N) p hGZ hcm
          (M := IntermediateField.extendScalars hle)
          (isImmediate_of_forall_exists_norm_sub_lt fun x hx ↦ by
            obtain ⟨c, hcZ, hc⟩ := hsup x ((IntermediateField.mem_extendScalars hle).mp x.2)
              fun h0 ↦ hx (Subtype.ext h0)
            exact ⟨⟨c, hcZ⟩, hc⟩)
        have heq : L' ⊔ Z = Z := by
          have := congrArg (IntermediateField.restrictScalars K) hbot
          rwa [IntermediateField.extendScalars_restrictScalars,
            IntermediateField.restrictScalars_bot_eq_self] at this
        exact heq ▸ le_sup_left
    -- `L' ⊆ Z` and `Z/K` is Cartesian, so `f_{L'/K} = [L' : K]`
    letI := normedAlgebraOfLE hL'Z
    haveI : IsScalarTower K L' Z := isScalarTower_base_normedAlgebraOfLE hL'Z
    have : FiniteDimensional L' Z := FiniteDimensional.right K L' Z
    have hL'cart : IsCartesian K L' := ((isCartesian_iff_of_tower K L' Z).mp hZcart).1
    have hL'e : ramificationIndex K L' = 1 :=
      ramificationIndex_eq_one_of_forall_exists_norm_eq fun x ↦ hNK' x
    have h1 : inertiaDegree K L' = finrank K L' := by
      have h := hL'cart
      unfold IsCartesian at h
      rwa [hL'e, one_mul] at h
    have h2 : finrank K Ls = finrank K L' := by
      rw [hL']
      exact ι.equivFieldRange.toLinearEquiv.finrank_eq
    have h3 : inertiaDegree K Ls = inertiaDegree K L' := by
      rw [hL']
      exact inertiaDegree_eq_of_algEquiv ι.equivFieldRange fun x ↦ hιn x
    rw [h3, h1, h2]
  -- the inseparable part: `L = L_s`
  have : ExpChar Ls p := expChar_of_injective_algebraMap (algebraMap K Ls).injective p
  have : ExpChar (ResidueField (unitBall Ls)) p :=
    expChar_of_injective_algebraMap
      (algebraMap (ResidueField (unitBall K)) (ResidueField (unitBall Ls))).injective p
  have hres_pi : IsPurelyInseparable (ResidueField (unitBall Ls)) (ResidueField (unitBall L)) :=
    isPurelyInseparable_residueField p
  have hres_sep : Algebra.IsSeparable (ResidueField (unitBall Ls)) (ResidueField (unitBall L)) :=
    Algebra.isSeparable_tower_top_of_isSeparable (ResidueField (unitBall K)) _ _
  have hf1 : inertiaDegree Ls L = 1 := by
    rw [inertiaDegree_def]
    refine IntermediateField.bot_eq_top_iff_finrank_eq_one.mp (eq_top_iff.mpr fun y _ ↦ ?_)
    obtain ⟨c, rfl⟩ := IsPurelyInseparable.surjective_algebraMap_of_isSeparable
      (ResidueField (unitBall Ls)) (ResidueField (unitBall L)) y
    exact IntermediateField.algebraMap_mem _ c
  have hLval : IsValueTrivial k L := hKval.of_finiteDimensional
  have he1 : ramificationIndex Ls L = 1 :=
    ramificationIndex_eq_one_of_forall_exists_norm_eq fun x ↦ by
      obtain ⟨c, hc⟩ := hLval x
      exact ⟨algebraMap k Ls c, by rw [norm_algebraMap', hc]⟩
  have himm : IsImmediate Ls L := ⟨he1, hf1⟩
  have hLsL : finrank Ls L = 1 := by
    by_contra hne
    obtain ⟨x, hx⟩ : ∃ x : L, x ∉ Set.range (algebraMap Ls L) := by
      by_contra h
      push Not at h
      apply hne
      refine IntermediateField.bot_eq_top_iff_finrank_eq_one.mp (eq_top_iff.mpr fun y _ ↦ ?_)
      obtain ⟨c, rfl⟩ := h y
      exact IntermediateField.algebraMap_mem _ c
    obtain ⟨γ, hγ, hγp⟩ := exists_pow_char_mem_of_isPurelyInseparable (K := Ls) p hx
    obtain _ | ⟨hprime⟩ := hk
    · rw [pow_one] at hγp
      exact hγ hγp
    · have : Fact p.Prime := ⟨hprime⟩
      have : CharP Ls p := charP_of_injective_algebraMap (algebraMap k Ls).injective p
      obtain ⟨U, -, -, hmin⟩ := IsGaussGenerator.exists_isMinimalInCoset (L := Ls) p hz hLsf.ge
      exact IsImmediate.not_pow_char_mem_of_critMinZero p
        (fun s b hsp ↦ by obtain ⟨v, -, hv, -⟩ := hmin hsp; exact ⟨v, hv⟩) himm hγ hγp
  refine ⟨inferInstance, ?_, hsep⟩
  rw [← inertiaDegree_mul_inertiaDegree K Ls L, ← Module.finrank_mul_finrank K Ls L, hLsf, hf1,
    hLsL]

end TypeTwo

end DeJongAlterations.StableModification.Valuation.Analytic
