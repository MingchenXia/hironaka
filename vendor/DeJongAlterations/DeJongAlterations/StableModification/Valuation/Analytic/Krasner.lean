import DeJongAlterations.StableModification.Valuation.Analytic.Basic
import Mathlib.Analysis.Normed.Field.Approximation
import Mathlib.Analysis.Normed.Field.Krasner
import Mathlib.FieldTheory.IsAlgClosed.AlgebraicClosure
import Mathlib.FieldTheory.PrimitiveElement

/-!
# Krasner's lemma and dense subfields

Let `L` be a complete nontrivially normed non-archimedean field and `K → L` a dense subfield (for
instance `L = K̂`). This file proves the approximation statements behind the decompletion
arguments of Temkin, *Stable modification of relative curves*, §2.2 (`semi-stable.tex`,
lines 2100–2140) and behind line 2208 ("since `k₁` is separably closed, its completion is
algebraically closed").

## Main results

* `exists_separable_monic_approx`: every monic separable `f ∈ L[X]` is approximated, coefficient by
  coefficient, by a monic *separable* `g ∈ K[X]` of the same degree. This is the TODO of Mathlib's
  `Mathlib/Analysis/Normed/Field/Approximation.lean`. The proof avoids discriminants: once the
  coefficients are close enough, distinct roots of `f` have distinct nearby roots of `g`, so `g`
  has `deg g` distinct roots.
* `exists_adjoin_eq_top_of_denseRange` (**Krasner density**): every finite separable extension `M`
  of `L` is `L(α)` where the minimal polynomial of `α` over `L` is the image of a monic separable
  polynomial over `K`.
* `isClosed_adjoin_simple`: over a complete field `F`, the field `F⟮y⟯` generated by an integral
  element is closed; hence the closure of `E(y)` for a subfield `E` dense in `F` is `F⟮y⟯`, of
  degree at most `[E(y) : E]`.
* `image_pow_char_closure`, `image_pow_char_closure_insert`: in characteristic `p` the Frobenius
  map commutes with closures, and maps `k(y)` onto `k(yᵖ)` for a perfect subfield `k`; together:
  `(k(y))‾ᵖ = (k(yᵖ))‾`.
-/

noncomputable section

open Polynomial IntermediateField

namespace DeJongAlterations.StableModification.Valuation.Analytic

variable {K L : Type*} [Field K] [NontriviallyNormedField L] [CompleteSpace L]
  [IsUltrametricDist L] [Algebra K L]

/-- Distinct roots of a nonzero polynomial over a normed field are uniformly separated. -/
theorem exists_pos_le_norm_sub_of_mem_roots {C : Type*} [NormedField C] (p : C[X]) :
    ∃ δ > 0, ∀ a ∈ p.roots, ∀ b ∈ p.roots, a ≠ b → δ ≤ ‖a - b‖ := by
  classical
  set D := (p.roots.toFinset.offDiag).image (fun x ↦ ‖x.1 - x.2‖)
  by_cases hD : D.Nonempty
  · refine ⟨D.min' hD, ?_, fun a ha b hb hab ↦ D.min'_le _ ?_⟩
    · change 0 < D.min' hD
      rw [Finset.lt_min'_iff]
      intro d hd
      obtain ⟨⟨a, b⟩, hab, rfl⟩ := Finset.mem_image.mp hd
      rw [Finset.mem_offDiag] at hab
      exact norm_pos_iff.mpr (sub_ne_zero.mpr hab.2.2)
    · exact Finset.mem_image.mpr ⟨(a, b), Finset.mem_offDiag.mpr
        ⟨Multiset.mem_toFinset.mpr ha, Multiset.mem_toFinset.mpr hb, hab⟩, rfl⟩
  · refine ⟨1, one_pos, fun a ha b hb hab ↦ absurd ?_ hD⟩
    exact ⟨_, Finset.mem_image.mpr ⟨(a, b), Finset.mem_offDiag.mpr
        ⟨Multiset.mem_toFinset.mpr ha, Multiset.mem_toFinset.mpr hb, hab⟩, rfl⟩⟩

/-- Every root of a polynomial over a normed field has norm bounded by a common constant. -/
theorem exists_forall_mem_roots_max_le {C : Type*} [NormedField C] (p : C[X]) :
    ∃ M ≥ (1 : ℝ), ∀ a ∈ p.roots, max ‖a‖ 1 ≤ M := by
  refine ⟨1 + (p.roots.map (‖·‖)).sum, ?_, fun a ha ↦ max_le ?_ ?_⟩
  · have : 0 ≤ (p.roots.map (‖·‖)).sum :=
      Multiset.sum_nonneg fun x hx ↦ by
        obtain ⟨y, -, rfl⟩ := Multiset.mem_map.mp hx
        exact norm_nonneg y
    linarith
  · have h0 : ∀ x ∈ p.roots.map (‖·‖), (0 : ℝ) ≤ x := fun x hx ↦ by
      obtain ⟨y, -, rfl⟩ := Multiset.mem_map.mp hx
      exact norm_nonneg y
    have := Multiset.single_le_sum h0 _ (Multiset.mem_map_of_mem _ ha)
    linarith
  · have : 0 ≤ (p.roots.map (‖·‖)).sum :=
      Multiset.sum_nonneg fun x hx ↦ by
        obtain ⟨y, -, rfl⟩ := Multiset.mem_map.mp hx
        exact norm_nonneg y
    linarith

/-- **Separable approximation.** If `K` is dense in the complete non-archimedean field `L`, every
monic separable `f ∈ L[X]` is approximated coefficientwise by a monic separable `g ∈ K[X]` of the
same degree. -/
theorem exists_separable_monic_approx (hd : DenseRange (algebraMap K L)) {f : L[X]}
    (hf : f.Monic) (hs : f.Separable) {ε : ℝ} (hε : 0 < ε) :
    ∃ g : K[X], g.Monic ∧ g.natDegree = f.natDegree ∧ g.Separable ∧
      ∀ i, ‖(g.map (algebraMap K L)).coeff i - f.coeff i‖ < ε := by
  classical
  set n := f.natDegree with hn
  rcases Nat.eq_zero_or_pos n with h0 | hpos
  · refine ⟨1, monic_one, by rw [natDegree_one, h0], separable_one, fun i ↦ ?_⟩
    rw [Polynomial.map_one, Polynomial.eq_one_of_monic_natDegree_zero hf h0, sub_self, norm_zero]
    exact hε
  let C := AlgebraicClosure L
  let : NontriviallyNormedField C := spectralNorm.nontriviallyNormedField L C
  let : NormedAlgebra L C := spectralNorm.normedAlgebra L C
  have : IsUltrametricDist C := IsUltrametricDist.of_normedAlgebra L
  obtain ⟨δ, hδ, hsep⟩ := exists_pos_le_norm_sub_of_mem_roots (f.map (algebraMap L C))
  obtain ⟨M, hM1, hM⟩ := exists_forall_mem_roots_max_le (f.map (algebraMap L C))
  have hMpos : 0 < M := lt_of_lt_of_le one_pos hM1
  set ε' := (δ / 2 / M) ^ n / (n + 1) with hε'
  have hε'pos : 0 < ε' := by positivity
  have hε₀ : 0 < min ε ε' := lt_min hε hε'pos
  obtain ⟨g, hgm, hgdeg, hgc⟩ :=
    exists_monic_and_natDegree_eq_and_norm_map_algebraMap_coeff_sub_lt hd hf hε₀
  refine ⟨g, hgm, hgdeg.symm, ?_, fun i ↦ (hgc i).trans_le (min_le_left _ _)⟩
  set G := g.map (algebraMap K L) with hG
  have hGm : G.Monic := hgm.map _
  have hGdeg : G.natDegree = n := by rw [hG, natDegree_map, ← hgdeg]
  -- the radius of root continuity is at most `δ / 2`
  have hrad : ∀ a : C, max ‖a‖ 1 ≤ M →
      ((n + 1 : ℝ) * min ε ε') ^ (n : ℝ)⁻¹ * max ‖a‖ 1 ≤ δ / 2 := by
    intro a ha
    have h1 : (n + 1 : ℝ) * min ε ε' ≤ (δ / 2 / M) ^ n := by
      calc (n + 1 : ℝ) * min ε ε' ≤ (n + 1) * ε' :=
            mul_le_mul_of_nonneg_left (min_le_right _ _) (by positivity)
        _ = (δ / 2 / M) ^ n := by rw [hε']; field_simp
    calc ((n + 1 : ℝ) * min ε ε') ^ (n : ℝ)⁻¹ * max ‖a‖ 1
        ≤ ((δ / 2 / M) ^ n) ^ (n : ℝ)⁻¹ * M := by
          gcongr
      _ = δ / 2 := by
          rw [Real.pow_rpow_inv_natCast (by positivity) hpos.ne']
          field_simp
  -- every root of `f` has a root of `G` within `δ / 2`
  have hnear : ∀ a ∈ f.aroots C, ∃ b ∈ G.aroots C, ‖a - b‖ < δ / 2 := by
    intro a ha
    have haf : f.aeval a = 0 := (mem_aroots.mp ha).2
    obtain ⟨b, hb, hab⟩ := exists_aroots_norm_sub_lt_of_norm_coeff_sub_lt hε₀ haf hf hGm
      (by rw [hGdeg]) hgc (IsAlgClosed.splits _)
    exact ⟨b, hb, hab.trans_le (hrad a (hM a ha))⟩
  choose! φ hφmem hφ using hnear
  -- `φ` is injective on the roots of `f`
  have hinj : Set.InjOn φ ((f.aroots C).toFinset : Set C) := by
    intro a ha a' ha' h
    by_contra hne
    rw [Finset.mem_coe, Multiset.mem_toFinset] at ha ha'
    have h1 := hsep a ha a' ha' hne
    have h2 : ‖a - a'‖ ≤ max ‖a - φ a‖ ‖a' - φ a‖ := by
      have := norm_sub_le_max (a - φ a) (a' - φ a)
      rwa [sub_sub_sub_cancel_right] at this
    have h3 : max ‖a - φ a‖ ‖a' - φ a‖ < δ / 2 := max_lt (hφ a ha) (h ▸ hφ a' ha')
    linarith
  have hfcard : (f.aroots C).toFinset.card = n := by
    rw [Multiset.toFinset_card_of_nodup (nodup_roots hs.map),
      ← (IsAlgClosed.splits (f.map (algebraMap L C))).natDegree_eq_card_roots, natDegree_map]
  have hGcard : (G.aroots C).card = n := by
    rw [aroots, ← (IsAlgClosed.splits (G.map (algebraMap L C))).natDegree_eq_card_roots,
      natDegree_map, hGdeg]
  have hle : n ≤ (G.aroots C).toFinset.card := by
    rw [← hfcard]
    refine Finset.card_le_card_of_injOn φ (fun a ha ↦ ?_) hinj
    rw [Finset.mem_coe, Multiset.mem_toFinset] at ha ⊢
    exact hφmem a ha
  have hnodup : (G.aroots C).Nodup := by
    rw [← Multiset.toFinset_card_eq_card_iff_nodup]
    exact le_antisymm (Multiset.toFinset_card_le _) (hGcard ▸ hle)
  have hGsep : G.Separable :=
    (nodup_aroots_iff_of_splits hGm.ne_zero (IsAlgClosed.splits _)).mp hnodup
  exact (separable_map (algebraMap K L)).mp hGsep

omit [CompleteSpace L] [IsUltrametricDist L] in
/-- Root continuity with an explicit radius: if `a` is a root of the monic `f` of degree `n ≥ 1`
and `g` is monic of degree `n` with coefficients `ε`-close to those of `f`, where
`ε = (δ / max ‖a‖ 1) ^ n / (n + 1)`, then `g` has a root within `δ` of `a`. -/
theorem exists_aroots_norm_sub_lt {C : Type*} [NormedField C] [NormedAlgebra L C] {f g : L[X]}
    (hfm : f.Monic) (hgm : g.Monic) (hdeg : g.natDegree = f.natDegree) (hn : f.natDegree ≠ 0)
    {a : C} (ha : f.aeval a = 0) {δ : ℝ} (hδ : 0 < δ)
    (hc : ∀ i, ‖g.coeff i - f.coeff i‖ < (δ / max ‖a‖ 1) ^ f.natDegree / (f.natDegree + 1))
    (hsplit : (g.map (algebraMap L C)).Splits) :
    ∃ b ∈ g.aroots C, ‖a - b‖ < δ := by
  have hm : 0 < max ‖a‖ 1 := lt_of_lt_of_le one_pos (le_max_right _ _)
  have hε : 0 < (δ / max ‖a‖ 1) ^ f.natDegree / (f.natDegree + 1) := by positivity
  obtain ⟨b, hb, hab⟩ := exists_aroots_norm_sub_lt_of_norm_coeff_sub_lt hε ha hfm hgm hdeg hc hsplit
  refine ⟨b, hb, hab.trans_eq ?_⟩
  have : ((f.natDegree + 1 : ℝ) * ((δ / max ‖a‖ 1) ^ f.natDegree / (f.natDegree + 1))) =
      (δ / max ‖a‖ 1) ^ f.natDegree := by field_simp
  rw [this, Real.pow_rpow_inv_natCast (by positivity) hn]
  field_simp

/-- **Krasner density.** Let `K` be dense in the complete non-archimedean field `L`. Every finite
separable extension `M` of `L` is generated by an element `α` whose minimal polynomial over `L` is
the image of a monic separable polynomial over `K`. -/
theorem exists_adjoin_eq_top_of_denseRange (hd : DenseRange (algebraMap K L)) (M : Type*)
    [Field M] [Algebra L M] [FiniteDimensional L M] [Algebra.IsSeparable L M] :
    ∃ (α : M) (g : K[X]), g.Monic ∧ g.Separable ∧ minpoly L α = g.map (algebraMap K L) ∧
      L⟮α⟯ = ⊤ := by
  classical
  obtain ⟨β, hβ⟩ := Field.exists_primitive_element L M
  have hβint : IsIntegral L β := Algebra.IsIntegral.isIntegral β
  set f := minpoly L β with hf
  have hfm : f.Monic := minpoly.monic hβint
  have hfs : f.Separable := Algebra.IsSeparable.isSeparable L β
  have hn : f.natDegree ≠ 0 := (minpoly.natDegree_pos hβint).ne'
  let C := AlgebraicClosure L
  let : NontriviallyNormedField C := spectralNorm.nontriviallyNormedField L C
  let : NormedAlgebra L C := spectralNorm.normedAlgebra L C
  have : IsUltrametricDist C := IsUltrametricDist.of_normedAlgebra L
  let ι : M →ₐ[L] C := IsAlgClosed.lift
  set a := ι β with ha
  have hmina : minpoly L a = f := minpoly.algHom_eq ι ι.injective β
  have haf : f.aeval a = 0 := by rw [← hmina, minpoly.aeval]
  have haint : IsIntegral L a := hβint.map ι
  obtain ⟨δ, hδ, hsep⟩ := exists_pos_le_norm_sub_of_mem_roots (f.map (algebraMap L C))
  obtain ⟨g, hgm, hgdeg, hgs, hgc⟩ := exists_separable_monic_approx hd hfm hfs
    (show 0 < (δ / max ‖a‖ 1) ^ f.natDegree / (f.natDegree + 1) by
      have : 0 < max ‖a‖ 1 := lt_of_lt_of_le one_pos (le_max_right _ _)
      positivity)
  set G := g.map (algebraMap K L) with hG
  have hGm : G.Monic := hgm.map _
  have hGdeg : G.natDegree = f.natDegree := by rw [hG, natDegree_map, hgdeg]
  obtain ⟨b, hb, hab⟩ :=
    exists_aroots_norm_sub_lt hfm hGm hGdeg hn haf hδ hgc (IsAlgClosed.splits _)
  have hbG : G.aeval b = 0 := (mem_aroots.mp hb).2
  have hbint : IsIntegral L b := ⟨G, hGm, by rwa [← aeval_def]⟩
  -- Krasner's lemma: `a ∈ L⟮b⟯`
  have haLb : a ∈ L⟮b⟯ := by
    refine IsKrasner.krasner (hmina ▸ hfs) (IsAlgClosed.splits _) hbint fun x' hx' hne ↦ ?_
    have hx'f : f.aeval x' = 0 := hmina ▸ hx'.aeval_eq_zero
    refine hab.trans_le (hsep a ?_ x' ?_ hne)
    · exact mem_aroots.mpr ⟨hfm.ne_zero, haf⟩
    · exact mem_aroots.mpr ⟨hfm.ne_zero, hx'f⟩
  -- degree comparison: `L⟮a⟯ = L⟮b⟯`
  have hle : L⟮a⟯ ≤ L⟮b⟯ := IntermediateField.adjoin_simple_le_iff.mpr haLb
  have hfa : Module.finrank L L⟮a⟯ = f.natDegree := by
    rw [IntermediateField.adjoin.finrank haint, hmina]
  have hminb_dvd : minpoly L b ∣ G := minpoly.dvd L b hbG
  have hfb : Module.finrank L L⟮b⟯ ≤ f.natDegree := by
    rw [IntermediateField.adjoin.finrank hbint, ← hGdeg]
    exact natDegree_le_of_dvd hminb_dvd hGm.ne_zero
  have : FiniteDimensional L L⟮b⟯ := IntermediateField.adjoin.finiteDimensional hbint
  have hab_eq : L⟮a⟯ = L⟮b⟯ := IntermediateField.eq_of_le_of_finrank_le hle (hfa ▸ hfb)
  -- `b` lies in the image of `M`
  have hbrange : b ∈ ι.fieldRange := by
    have : L⟮a⟯ ≤ ι.fieldRange :=
      IntermediateField.adjoin_simple_le_iff.mpr (AlgHom.mem_fieldRange.mpr ⟨β, rfl⟩)
    exact this (hab_eq ▸ IntermediateField.mem_adjoin_simple_self L b)
  obtain ⟨α, hα⟩ := AlgHom.mem_fieldRange.mp hbrange
  have hminα : minpoly L α = minpoly L b := by
    rw [← hα, minpoly.algHom_eq ι ι.injective α]
  have hminbG : minpoly L b = G := by
    refine (eq_of_monic_of_dvd_of_natDegree_le (minpoly.monic hbint) hGm hminb_dvd ?_).symm
    rw [hGdeg, ← hfa, hab_eq, IntermediateField.adjoin.finrank hbint]
  refine ⟨α, g, hgm, hgs, hminα.trans hminbG, ?_⟩
  have hαint : IsIntegral L α := Algebra.IsIntegral.isIntegral α
  refine IntermediateField.eq_of_le_of_finrank_le le_top ?_
  rw [IntermediateField.finrank_top', IntermediateField.adjoin.finrank hαint, hminα, hminbG,
    hGdeg, ← IntermediateField.finrank_top', ← hβ, IntermediateField.adjoin.finrank hβint]

/-! ### Closures, Frobenius and finite adjunctions -/

section Closure

/-- In a normed algebra over a complete nontrivially normed field `F`, the field `F⟮y⟯` generated by
an integral element is closed (it is a finite-dimensional subspace). -/
theorem isClosed_adjoin_simple {F M : Type*} [NontriviallyNormedField F] [CompleteSpace F]
    [NormedField M] [NormedAlgebra F M] {y : M} (hy : IsIntegral F y) :
    IsClosed (F⟮y⟯ : Set M) := by
  have : FiniteDimensional F F⟮y⟯ := IntermediateField.adjoin.finiteDimensional hy
  have : FiniteDimensional F (Subalgebra.toSubmodule F⟮y⟯.toSubalgebra) := this
  exact (Subalgebra.toSubmodule F⟮y⟯.toSubalgebra).closed_of_finiteDimensional

variable {M : Type*} [NormedField M] (p : ℕ) [hp : Fact p.Prime] [CharP M p]

theorem norm_pow_char_sub_pow_char (x y : M) : ‖x ^ p - y ^ p‖ = ‖x - y‖ ^ p := by
  rw [← sub_pow_char, norm_pow]

/-- In characteristic `p`, `x ↦ xᵖ` is a uniform embedding: `‖xᵖ - yᵖ‖ = ‖x - y‖ᵖ`. -/
theorem isUniformInducing_pow_char : IsUniformInducing (fun x : M ↦ x ^ p) := by
  have hp0 : p ≠ 0 := hp.out.ne_zero
  rw [Metric.isUniformInducing_iff]
  refine ⟨Metric.uniformContinuous_iff.mpr fun ε hε ↦ ⟨min 1 ε, by positivity, fun {a b} h ↦ ?_⟩,
    fun δ hδ ↦ ⟨δ ^ p, by positivity, fun {a b} h ↦ ?_⟩⟩
  · rw [dist_eq_norm] at h ⊢
    rw [norm_pow_char_sub_pow_char]
    have h1 : ‖a - b‖ < 1 := h.trans_le (min_le_left _ _)
    calc ‖a - b‖ ^ p ≤ ‖a - b‖ := pow_le_of_le_one (norm_nonneg _) h1.le hp0
      _ < ε := h.trans_le (min_le_right _ _)
  · rw [dist_eq_norm, norm_pow_char_sub_pow_char] at h
    rw [dist_eq_norm]
    exact (pow_lt_pow_iff_left₀ (norm_nonneg _) hδ.le hp0).mp h

/-- In a complete field of characteristic `p`, the Frobenius map commutes with closures:
`(S̄)ᵖ = (Sᵖ)‾`. -/
theorem image_pow_char_closure [CompleteSpace M] (S : Set M) :
    (fun x ↦ x ^ p) '' closure S = closure ((fun x ↦ x ^ p) '' S) := by
  refine le_antisymm (image_closure_subset_closure_image (continuous_pow p)) ?_
  refine closure_minimal (Set.image_mono subset_closure) ?_
  exact ((isComplete_image_iff (isUniformInducing_pow_char p)).mpr
    isClosed_closure.isComplete).isClosed

/-- If `k` is a perfect subfield of a field of characteristic `p`, then the Frobenius image of
`k(y)` is `k(yᵖ)`. -/
theorem image_pow_char_closure_insert (k : Subfield M)
    (hk : ∀ c ∈ k, ∃ d ∈ k, d ^ p = c) (y : M) :
    (fun x ↦ x ^ p) '' (Subfield.closure (insert y (k : Set M)) : Set M) =
      Subfield.closure (insert (y ^ p) (k : Set M)) := by
  have hfrob : (fun x ↦ x ^ p) = (frobenius M p : M → M) := by
    ext x
    rfl
  have himg : (frobenius M p : M → M) '' (k : Set M) = k := by
    ext c
    constructor
    · rintro ⟨d, hd, rfl⟩
      exact k.pow_mem hd p
    · intro hc
      obtain ⟨d, hd, rfl⟩ := hk c hc
      exact ⟨d, hd, rfl⟩
  rw [hfrob, ← Subfield.coe_map, RingHom.map_field_closure, Set.image_insert_eq, himg,
    frobenius_def]

end Closure

end DeJongAlterations.StableModification.Valuation.Analytic
