import DeJongAlterations.StableModification.DeJong.FibrationGeneric
import DeJongAlterations.Geometry.ProjectiveCurveFibration
import DeJongAlterations.Geometry.SteinGeometricIntegrality
import DeJongAlterations.Geometry.NormalizationProjective
import DeJongAlterations.Geometry.VarietyFunctionFieldDimension

/-!
# A normal curve fibration with geometrically integral generic fibre

The first half of the Temkin-ready fibration (blueprint chapter `sm-dj-fibration`, node
`thm:sm-dj-normal-curve-fibration`; the generic part of de Jong, *Smoothness, semi-stability and
alterations*, 1996, 4.11–4.12, `dejong96-alterations:page-0018`–`page-0020`).

De Jong obtains his fibration `X' → ℙ^{d-1}` from a general linear projection (2.11) and a
Bertini argument, and passes to the Stein factorization in 4.12. Here only the generic fibre
matters, and the fibration is built from a separating transcendence basis instead:

* `functionFieldSeparablyGenerated_of_perfectField`, `transcendental_functionField`: over a
  perfect field the function field of a variety of dimension `n + 1 ≥ 1` has a separating
  transcendence basis `r₀, …, rₙ`.
* `chartCoordinate`, `functionFieldMap_graphFibration_chartCoordinate`: on the graph model
  `Γ ⊆ X × ℙⁿ` of the rational map `(r₀ : ⋯ : r_{n-1})` (Codex's `ProjectiveCurveFibration`), the
  projection to `ℙⁿ` pulls the affine coordinates `x_i / x_0` back to the `r_i`.
* `isIso_functionFieldMap_of_isModification`: modifications induce isomorphisms of function
  fields.
* `functionFieldSeparablyGenerated_graphFibration`: for any modification `X' → Γ`, the function
  field extension `K(X')/K(ℙⁿ)` is separably generated by `rₙ`.
* `exists_normal_curve_fibration`: normalizing `Γ` and taking the Stein factor `X' → Y → ℙⁿ`
  (Codex's `SteinCurveFactor`, base the normalization of `ℙⁿ` in the algebraic closure of
  `K(ℙⁿ)` in `K(X')`) gives a projective modification `X' → X` with `X'` normal and a proper
  dominant `f : X' → Y` to a normal projective variety of dimension `n` whose generic fibre is
  geometrically integral of dimension one (Codex's `SteinGeometricIntegrality`).
-/

noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace

namespace DeJongAlterations.StableModification.DeJong

universe u

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

open Geometry
open Geometry.NormalizationInExtension (functionFieldMap functionFieldMap_comp)

section FunctionField

/-- The function field map only depends on the morphism. -/
theorem functionFieldMap_congr {X Y : Scheme.{u}} [IsIntegral X] [IsIntegral Y] {f g : X ⟶ Y}
    [IsDominant f] [IsDominant g] (h : f = g) : functionFieldMap f = functionFieldMap g := by
  subst h
  rfl

/-- A modification induces an isomorphism of function fields. -/
theorem isIso_functionFieldMap_of_isModification {X Y : Scheme.{u}} (f : X ⟶ Y)
    [hf : IsModification f] :
    letI := hf.sourceIntegral
    letI := hf.targetIntegral
    IsIso (functionFieldMap f) := by
  let := hf.sourceIntegral
  let := hf.targetIntegral
  obtain ⟨e, he⟩ := hf.birational
  have heq : e.iso.hom ≫ e.target.ι = e.source.ι ≫ f := by
    simpa only [Scheme.PartialIso.IsOver, Category.comp_id] using he
  have : Nonempty e.source := Set.nonempty_coe_sort.mpr e.dense_source.nonempty
  have : Nonempty e.target := Set.nonempty_coe_sort.mpr e.dense_target.nonempty
  have : IsIntegral e.source := isIntegral_of_isOpenImmersion e.source.ι
  have : IsIntegral e.target := isIntegral_of_isOpenImmersion e.target.ι
  have : IsDominant e.source.ι := ⟨by rw [DenseRange, Scheme.Opens.range_ι]; exact e.dense_source⟩
  have : IsDominant e.target.ι := ⟨by rw [DenseRange, Scheme.Opens.range_ι]; exact e.dense_target⟩
  have h1 : IsIso (functionFieldMap (e.iso.hom ≫ e.target.ι)) := by
    rw [functionFieldMap_comp]
    have := NormalizationInExtension.functionFieldMap_isIso e.target.ι
    have := NormalizationInExtension.functionFieldMap_isIso e.iso.hom
    infer_instance
  rw [functionFieldMap_congr heq, functionFieldMap_comp] at h1
  have := NormalizationInExtension.functionFieldMap_isIso e.source.ι
  exact IsIso.of_isIso_comp_right _ (functionFieldMap e.source.ι)

end FunctionField

section Coordinates

open ProjectiveCurveFibration RationalCoordinateMap

/-- The canonical map from a domain to the function field of its spectrum. -/
abbrev specFunctionFieldMap (R : CommRingCat.{u}) [IsDomain R] : R ⟶ (Spec R).functionField :=
  CommRingCat.ofHom (algebraMap R (Spec R).functionField)

variable (k : Type u) [Field k] (n : ℕ)

local instance : IsDominant (affineChart k n) := affineChart_isDominant k n

local instance : IsIso (functionFieldMap (affineChart k n)) :=
  NormalizationInExtension.functionFieldMap_isIso _

/-- The `i`-th affine coordinate `x_i / x_0` of projective space, as an element of its function
field (through the standard chart `𝔸ⁿ ≅ D₊(x₀) ⊆ ℙⁿ`). -/
def chartCoordinate (i : Fin n) : (projectiveSpace k n).functionField :=
  inv (functionFieldMap (affineChart k n))
    (specFunctionFieldMap (.of (MvPolynomial (Fin n) k)) (MvPolynomial.X i))

theorem functionFieldMap_affineChart_chartCoordinate (i : Fin n) :
    functionFieldMap (affineChart k n) (chartCoordinate k n i) =
      specFunctionFieldMap (.of (MvPolynomial (Fin n) k)) (MvPolynomial.X i) := by
  simp [chartCoordinate]

variable {k n} {X : Scheme.{u}} (p : X ⟶ Spec (.of k)) [IsVariety p] (r : Fin n → X.functionField)

/-- **The graph fibration pulls the chart coordinates back to the given rational functions.**
On the function field of the graph model `Γ ⊆ X × ℙⁿ` of the rational map
`(r₁ : ⋯ : rₙ) : X ⇢ ℙⁿ`, the projection to `ℙⁿ` sends the coordinate `x_i / x_0` to the function
`r_i`, transported by the projection `Γ → X`. -/
theorem functionFieldMap_graphFibration_chartCoordinate
    (hr : letI := SeparableGenericSmoothness.functionFieldAlgebra p; AlgebraicIndependent k r)
    [IsDominant (graphFibration p r)] (i : Fin n) :
    functionFieldMap (graphFibration p r) (chartCoordinate k n i) =
      functionFieldMap (graphProjection p r) (r i) := by
  let U := coordinateOpen r
  let A := Γ(X, U.1)
  let φc : CommRingCat.of (MvPolynomial (Fin n) k) ⟶ A :=
    CommRingCat.ofHom (coordinateRingMap p r)
  have : IsDomain A := IsIntegral.component_integral U.1
  let ι' : Spec A ⟶ graphModel p r := U.2.isoSpec.inv ≫ graphOpenInclusion p r
  have h1 : ι' ≫ graphProjection p r = U.2.fromSpec := by
    simp only [ι', Category.assoc, graphOpenInclusion_projection]
    rfl
  have h2 : ι' ≫ graphFibration p r = Spec.map φc ≫ affineChart k n := by
    simp only [ι', Category.assoc, graphOpenInclusion_fibration, projectiveCoordinateMap,
      coordinateMap, Iso.inv_hom_id_assoc]
    rfl
  have : IsDominant (graphOpenInclusion p r) := inferInstance
  have : IsDominant (Spec.map φc) := by
    have hc := coordinateMap_isDominant p r hr
    have : Spec.map φc = U.2.isoSpec.inv ≫ coordinateMap p r := by
      simp [coordinateMap, φc]
    rw [this]
    infer_instance
  have := NormalizationFinite.affineCoordinate_isDominant U
  have hF := congrArg (fun g ↦ g (chartCoordinate k n i))
    (functionFieldMap_congr h2)
  have hP := congrArg (fun g ↦ g (r i)) (functionFieldMap_congr h1)
  simp only [functionFieldMap_comp, CommRingCat.comp_apply] at hF hP
  apply (functionFieldMap ι').hom.injective
  change (functionFieldMap ι') _ = (functionFieldMap ι') _
  rw [hF, hP, functionFieldMap_affineChart_chartCoordinate]
  have hs : functionFieldMap (Spec.map φc)
      (specFunctionFieldMap (.of (MvPolynomial (Fin n) k)) (MvPolynomial.X i)) =
      specFunctionFieldMap A (φc (MvPolynomial.X i)) :=
    ConcreteCategory.congr_hom
      (NormalizationInExtension.functionFieldMap_spec_coeff φc) (MvPolynomial.X i)
  have hg : functionFieldMap U.2.fromSpec (X.germToFunctionField U.1 (coordinateSection r i)) =
      specFunctionFieldMap A (coordinateSection r i) :=
    ConcreteCategory.congr_hom
      (NormalizationInExtension.functionFieldMap_fromSpec_coeff U) (coordinateSection r i)
  have hX : φc (MvPolynomial.X i) = coordinateSection r i := coordinateRingMap_X p r i
  rw [hs, hX, ← hg, coordinateSection_germ]

end Coordinates

section Separable

open ProjectiveCurveFibration RationalCoordinateMap
open scoped IntermediateField.algebraAdjoinAdjoin

variable {k : Type u} [Field k] {n : ℕ} {X : Scheme.{u}} (p : X ⟶ Spec (.of k)) [IsVariety p]

/-- **The separating projection gives a separably generated relative function field.** Let
`r₀, …, rₙ` be a separating transcendence basis of `K(X)/k` and `Γ ⊆ X × ℙⁿ` the graph model of
`(r₀ : ⋯ : r_{n-1}) : X ⇢ ℙⁿ` (in affine coordinates). For any modification `ν : X' ⟶ Γ`
(e.g. the normalization), the extension `K(X') / K(ℙⁿ)` given by `X' ⟶ Γ ⟶ ℙⁿ` is separably
generated by the transported last coordinate `rₙ`: the coordinates `x_i/x_0` of `ℙⁿ` are sent
to the `r_i` (`functionFieldMap_graphFibration_chartCoordinate`), so `K(ℙⁿ)(rₙ) ⊇ k(r₀, …, rₙ)`,
over which `K(X') = K(X)` is separable; `rₙ` is transcendental over `K(ℙⁿ)` because the
generic fibre has dimension one. -/
theorem functionFieldSeparablyGenerated_graphFibration (r : Fin (n + 1) → X.functionField)
    (hb : letI := SeparableGenericSmoothness.functionFieldAlgebra p; IsTranscendenceBasis k r)
    (hsep : letI := SeparableGenericSmoothness.functionFieldAlgebra p
      Algebra.IsSeparable (IntermediateField.adjoin k (Set.range r)) X.functionField)
    {X' : Scheme.{u}} [IsIntegral X'] (ν : X' ⟶ graphModel p (fun i : Fin n ↦ r i.castSucc))
    [IsModification ν] [IsDominant (graphFibration p (fun i : Fin n ↦ r i.castSucc))]
    [LocallyOfFiniteType (ν ≫ graphFibration p (fun i : Fin n ↦ r i.castSucc))]
    (hdim : topologicalKrullDim ((ν ≫ graphFibration p (fun i : Fin n ↦ r i.castSucc)).fiber
      (genericPoint (projectiveSpace k n))) = 1) :
    RelativeGenericSmoothness.FunctionFieldSeparablyGenerated
      (ν ≫ graphFibration p (fun i : Fin n ↦ r i.castSucc)) := by
  let := SeparableGenericSmoothness.functionFieldAlgebra p
  let r' := fun i : Fin n ↦ r i.castSucc
  have hr' : AlgebraicIndependent k r' := hb.1.comp Fin.castSucc (Fin.castSucc_injective n)
  let F := graphFibration p r'
  let π := graphProjection p r'
  let F₂ := ν ≫ F
  let L := X'.functionField
  let Kℙ := (projectiveSpace k n).functionField
  let : Algebra Kℙ L := (functionFieldMap F₂).hom.toAlgebra
  have : IsModification (ν ≫ π) := IsModification.comp ν π
  have hiso : IsIso (functionFieldMap (ν ≫ π)) := isIso_functionFieldMap_of_isModification _
  let e : X.functionField ≃+* L := (asIso (functionFieldMap (ν ≫ π))).commRingCatIsoToRingEquiv
  have he : ∀ x, e x = functionFieldMap (ν ≫ π) x := fun _ ↦ rfl
  have he' : ∀ i : Fin n, e (r i.castSucc) = algebraMap Kℙ L (chartCoordinate k n i) := by
    intro i
    rw [he]
    change functionFieldMap (ν ≫ π) (r' i) = functionFieldMap (ν ≫ F) (chartCoordinate k n i)
    rw [functionFieldMap_comp, functionFieldMap_comp, CommRingCat.comp_apply,
      CommRingCat.comp_apply, functionFieldMap_graphFibration_chartCoordinate p r' hr']
  let s := e (r (Fin.last n))
  -- the `k`-structures
  let kL : Algebra k L := SeparableGenericSmoothness.functionFieldAlgebra ((ν ≫ π) ≫ p)
  let kP : Algebra k Kℙ :=
    SeparableGenericSmoothness.functionFieldAlgebra (projectiveSpaceStructure k n)
  let : Algebra X.functionField L := (functionFieldMap (ν ≫ π)).hom.toAlgebra
  have tow1 : IsScalarTower k X.functionField L :=
    VarietyFunctionFieldDimension.functionFieldScalarTower p (ν ≫ π)
  have hstr : F₂ ≫ projectiveSpaceStructure k n = (ν ≫ π) ≫ p := by
    simp only [F₂, F, π, Category.assoc, graphFibration_structure]
  have tow2 : IsScalarTower k Kℙ L := by
    have h := VarietyFunctionFieldDimension.functionFieldScalarTower
      (projectiveSpaceStructure k n) F₂
    rw [hstr] at h
    exact h
  let eₐ : X.functionField ≃ₐ[k] L :=
    { e with
      commutes' := fun c ↦ by
        change e (algebraMap k X.functionField c) = algebraMap k L c
        rw [he, IsScalarTower.algebraMap_apply k X.functionField L c]
        rfl }
  let E₀ := IntermediateField.adjoin k (Set.range r)
  let E₀' := E₀.map eₐ.toAlgHom
  have hsep' : Algebra.IsSeparable E₀' L := by
    refine Algebra.IsSeparable.of_equiv_equiv (E₀.equivMap eₐ.toAlgHom).toRingEquiv e ?_
    ext x
    rfl
  let M := IntermediateField.adjoin Kℙ {s}
  have hle : E₀' ≤ M.restrictScalars k := by
    change E₀.map eₐ.toAlgHom ≤ _
    rw [IntermediateField.adjoin_map, IntermediateField.adjoin_le_iff]
    rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
    induction i using Fin.lastCases with
    | last => exact IntermediateField.mem_adjoin_simple_self Kℙ s
    | cast j =>
      change e (r j.castSucc) ∈ M
      rw [he' j]
      exact M.algebraMap_mem _
  let ι := IntermediateField.inclusion hle
  let : Algebra E₀' M := ι.toRingHom.toAlgebra
  have : IsScalarTower E₀' M L := IsScalarTower.of_algebraMap_eq (fun _ ↦ rfl)
  have hMsep : Algebra.IsSeparable M L := Algebra.isSeparable_tower_top_of_isSeparable E₀' M L
  have hMalg : Algebra.IsAlgebraic M L := Algebra.IsSeparable.isAlgebraic _ _
  have htrdeg : Algebra.trdeg Kℙ L = 1 := by
    obtain ⟨d, hd, htr⟩ := SteinGenericFiber.exists_dimension_and_trdeg F₂
    have hd1 : d = 1 := by exact_mod_cast hd.symm.trans hdim
    rw [hd1] at htr
    exact_mod_cast htr
  have htrans : Transcendental Kℙ s := by
    intro hs
    have : Algebra.IsAlgebraic Kℙ M := IntermediateField.isAlgebraic_adjoin_simple hs.isIntegral
    have : Algebra.IsAlgebraic Kℙ L := Algebra.IsAlgebraic.trans Kℙ M L
    have h0 := trdeg_eq_zero (R := Kℙ) (A := L)
    rw [htrdeg] at h0
    exact one_ne_zero h0
  refine ⟨{s}, ?_, ?_⟩
  · have hind : AlgebraicIndependent Kℙ ((↑) : ({s} : Finset L) → L) :=
      algebraicIndependent_unique_type_iff.mpr htrans
    apply hind.isTranscendenceBasis_iff_isAlgebraic.mpr
    have hrange : Set.range ((↑) : ({s} : Finset L) → L) = {s} := by simp
    rw [hrange]
    exact IntermediateField.isAlgebraic_adjoin_iff_top.mp hMalg
  · rw [Finset.coe_singleton]
    exact hMsep

end Separable

section Model

open ProjectiveCurveFibration RationalCoordinateMap

variable {k : Type u} [Field k] {X : Scheme.{u}}

/-- Over a perfect field, the function field of a variety is separably generated (Mathlib's
`exists_isTranscendenceBasis_and_isSeparable_of_perfectField`). -/
theorem functionFieldSeparablyGenerated_of_perfectField [PerfectField k]
    (p : X ⟶ Spec (.of k)) [IsVariety p] :
    SeparableGenericSmoothness.FunctionFieldSeparablyGenerated p := by
  let := SeparableGenericSmoothness.functionFieldAlgebra p
  have : Algebra.EssFiniteType k X.functionField := by
    let e := SeparableGenericSmoothness.baseStalkAlgEquiv p
    have he : e.toRingHom =
        algebraMap k ((Spec.structureSheaf k).presheaf.stalk (p (genericPoint X))) := by
      ext x
      exact e.commutes x
    have h := (RingHom.EssFiniteType.respectsIso.cancel_left_isIso
      e.toRingEquiv.toCommRingCatIso.hom (p.stalkMap (genericPoint X))).mpr
      (LocallyOfFiniteType.stalkMap p (genericPoint X))
    change ((p.stalkMap (genericPoint X)).hom.comp e.toRingHom).EssFiniteType at h
    rw [he] at h
    exact h
  exact exists_isTranscendenceBasis_and_isSeparable_of_perfectField k X.functionField

/-- The function field of a variety of positive dimension is transcendental over `k`. -/
theorem transcendental_functionField (p : X ⟶ Spec (.of k)) [IsVariety p] (n : ℕ)
    (hdim : topologicalKrullDim X = (n + 1 : ℕ)) :
    letI := SeparableGenericSmoothness.functionFieldAlgebra p
    Algebra.Transcendental k X.functionField := by
  let := SeparableGenericSmoothness.functionFieldAlgebra p
  obtain ⟨d, hd, htr⟩ := FunctionFieldDimension.exists_dimension_and_trdeg p
  have hdn : d = n + 1 := by exact_mod_cast hd.symm.trans hdim
  rw [Algebra.transcendental_iff_not_isAlgebraic]
  intro halg
  have h0 := trdeg_eq_zero (R := k) (A := X.functionField)
  rw [htr, hdn] at h0
  exact absurd (by exact_mod_cast h0 : n + 1 = 0) (Nat.succ_ne_zero n)

/-- Projective `n`-space has dimension `n` (its standard affine chart is `𝔸ⁿ`). -/
theorem topologicalKrullDim_projectiveSpace (k : Type u) [Field k] (n : ℕ) :
    topologicalKrullDim (projectiveSpace k n) = n := by
  rw [← FunctionFieldDimension.topologicalKrullDim_eq_of_openImmersion
    (projectiveSpaceStructure k n) (affineChart k n)]
  change topologicalKrullDim (PrimeSpectrum (MvPolynomial (Fin n) k)) = n
  rw [PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim]
  simp [MvPolynomial.ringKrullDim_of_isNoetherianRing]

/-- **A normal curve fibration with geometrically integral generic fibre** (generic part of de
Jong 4.11–4.12, `dejong96-alterations:page-0018`–`page-0020`). Let `X` be a projective variety of
dimension `n + 1` over a perfect field `k`. Then there are a projective modification
`φ : X' ⟶ X` with `X'` normal, a normal projective variety `Y` of dimension `n` and a proper
dominant `f : X' ⟶ Y` over `k` whose generic fibre is geometrically integral of dimension one.

Construction: a separating transcendence basis `r₀, …, rₙ` of `K(X)/k`; the graph model
`Γ ⊆ X × ℙⁿ` of `(r₀ : ⋯ : r_{n-1})` (Codex, `ProjectiveCurveFibration`); its normalization
`X'`; the Stein factor `X' ⟶ Y ⟶ ℙⁿ` with `Y` the normalization of `ℙⁿ` in the algebraic
closure of `K(ℙⁿ)` in `K(X')` (Codex, `SteinCurveFactor`). The generic fibre of `X' ⟶ Y` is
geometrically integral because `K(X')/K(ℙⁿ)` is separably generated
(`functionFieldSeparablyGenerated_graphFibration`, Codex `SteinGeometricIntegrality`). -/
theorem exists_normal_curve_fibration [PerfectField k] (p : X ⟶ Spec (.of k)) [IsVariety p]
    (hp : IsProjectiveOver p) (n : ℕ) (hdim : topologicalKrullDim X = (n + 1 : ℕ)) :
    ∃ (X' : Scheme.{u}) (φ : X' ⟶ X) (Y : Scheme.{u}) (pY : Y ⟶ Spec (.of k))
      (_ : IsVariety pY) (f : X' ⟶ Y),
      IsModification φ ∧ IsVariety (φ ≫ p) ∧ IsProjectiveOver (φ ≫ p) ∧ IsNormalScheme X' ∧
      IsProjectiveOver pY ∧ IsNormalScheme Y ∧ topologicalKrullDim Y = n ∧
      f ≫ pY = φ ≫ p ∧ IsDominant f ∧ IsProper f ∧
      GeometricallyIntegral (f.fiberToSpecResidueField (genericPoint Y)) ∧
      topologicalKrullDim (f.fiber (genericPoint Y)) = 1 := by
  have hsep := functionFieldSeparablyGenerated_of_perfectField p
  have htr := transcendental_functionField p n hdim
  let := SeparableGenericSmoothness.functionFieldAlgebra p
  obtain ⟨m, r, hb, hs, -, -, -⟩ := exists_separating_projection p hsep htr
  have hm : m = n := by
    obtain ⟨d, hd, htrd⟩ := FunctionFieldDimension.exists_dimension_and_trdeg p
    have hdn : d = n + 1 := by exact_mod_cast hd.symm.trans hdim
    have h := hb.lift_cardinalMk_eq_trdeg
    rw [htrd, hdn] at h
    have : m + 1 = n + 1 := by simpa using h
    omega
  subst hm
  let r' := fun i : Fin m ↦ r i.castSucc
  have hr' : AlgebraicIndependent k r' := hb.1.comp Fin.castSucc (Fin.castSucc_injective m)
  let G := graphModel p r'
  let π := graphProjection p r'
  let F := graphFibration p r'
  let pℙ := projectiveSpaceStructure k m
  have : IsDominant F := graphFibration_isDominant p r' hr'
  have : IsProper F := graphFibration_isProper p hp r'
  have : IsVariety (π ≫ p) := graphModel_isVariety p r'
  have hGproj : IsProjectiveOver (π ≫ p) := graphModel_isProjective p hp r'
  let X' := NormalizationGluing.normalization G
  let ν := NormalizationGluing.normalizationStructure G
  have : IsVariety (ν ≫ π ≫ p) := NormalizationFiniteArbitraryField.normalization_isVariety (π ≫ p)
  have hX'proj : IsProjectiveOver (ν ≫ π ≫ p) :=
    NormalizationProjective.normalization_isProjectiveOver (π ≫ p) hGproj
  have hnormal : IsNormalScheme X' := NormalizationGluing.normalization_isNormalScheme G
  have : IsFinite ν := NormalizationFiniteArbitraryField.normalizationStructure_isFinite (π ≫ p)
  have : IsModification ν :=
    NormalizationFiniteArbitraryField.normalizationStructure_isModification (π ≫ p)
  have hφ : IsModification (ν ≫ π) := IsModification.comp ν π
  let F₂ := ν ≫ F
  have : IsProper F₂ := inferInstance
  have : AlgebraicGeometry.IsNoetherian X' := variety_isNoetherian (ν ≫ π ≫ p)
  have hdimX' : topologicalKrullDim X' = (m + 1 : ℕ) := by
    rw [topologicalKrullDim_eq_of_isAlteration p (ν ≫ π), hdim]
  have hdimF₂ : topologicalKrullDim (F₂.fiber (genericPoint (projectiveSpace k m))) = 1 := by
    have := topologicalKrullDim_genericFiber_eq F₂ pℙ m 1 hdimX'
      (topologicalKrullDim_projectiveSpace k m)
    exact_mod_cast this
  have hsepF₂ := functionFieldSeparablyGenerated_graphFibration p r hb hs ν hdimF₂
  have hdim' : topologicalKrullDim (F₂.fiber (genericPoint (projectiveSpace k m))) ≤ 1 :=
    hdimF₂.le
  let Y := SteinCurveFactor.base F₂
  let bm := SteinCurveFactor.baseMap F₂
  have : IsIntegral Y := SteinCurveFactor.base_isIntegral F₂ hdim'
  have : IsFinite bm := SteinCurveFactor.baseMap_isFinite F₂ hdim' pℙ
  have : IsDominant bm := SteinCurveFactor.baseMap_isDominant F₂ hdim'
  let pY := bm ≫ pℙ
  have hYvar : IsVariety pY := .mk
  let f := SteinCurveFactor.factor F₂ hdim' pℙ hnormal
  have hfac : f ≫ bm = F₂ := SteinCurveFactor.factor_structure F₂ hdim' pℙ hnormal
  have : IsDominant f := SteinCurveFactor.factor_isDominant F₂ hdim' pℙ hnormal
  have hfp : IsProper f := SteinCurveFactor.factor_isProper F₂ hdim' pℙ inferInstance hnormal
  have : LocallyOfFiniteType f := inferInstance
  have hdimY : topologicalKrullDim Y = m := by
    rw [VarietyFunctionFieldDimension.dimension_eq_of_isFinite pℙ bm,
      topologicalKrullDim_projectiveSpace]
  refine ⟨X', ν ≫ π, Y, pY, hYvar, f, hφ, ?_, ?_, hnormal,
    FiniteProjective.isProjectiveOver_comp_of_isFinite pℙ
      (isProjectiveOver_projectiveSpaceStructure k m) bm,
    SteinCurveFactor.base_isNormalScheme F₂ hdim', hdimY, ?_, inferInstance, hfp,
    SteinGeometricIntegrality.factor_genericFiber_geometricallyIntegral F₂ hdim' pℙ hnormal
      hsepF₂, ?_⟩
  · simpa only [Category.assoc] using (inferInstance : IsVariety (ν ≫ π ≫ p))
  · simpa only [Category.assoc] using hX'proj
  · change f ≫ bm ≫ pℙ = (ν ≫ π) ≫ p
    rw [← Category.assoc, hfac]
    change (ν ≫ F) ≫ projectiveSpaceStructure k m = _
    rw [Category.assoc, graphFibration_structure, Category.assoc]
  · have := topologicalKrullDim_genericFiber_eq f pY m 1 hdimX' hdimY
    exact_mod_cast this

end Model

end DeJongAlterations.StableModification.DeJong
