/-!
# Sections on the fibre over a closed point

Blueprint `sm-projectivity-relative.tex`, `lem:sm-ltg-fibre-functions` and
`lem:sm-ltg-fibre-twist` (PLAN-OM3 §3 step 1). Let `β : X ⟶ Y`, `y ∈ Y` a closed point, `W ∋ y` an
affine open of `Y` and `ι : X_y ⟶ X` the scheme-theoretic fibre. Let
`ρ = fibreResidue : Γ(Y, W) → Γ(Spec κ(y), ⊤)` be the residue map and `𝔪 = ker ρ`.

* `isPushout_fiberι_appLE`: for an affine open `V ⊆ β⁻¹ W` the square of rings
  `Γ(Y, W) → Γ(X, V)`, `Γ(Y, W) → κ(y)`, `Γ(X, V) → Γ(X_y, ι⁻¹ V)` is a pushout
  (Mathlib's `isIso_pushoutSection_of_isAffineOpen`), hence
  `surjective_fiberι_app` (`ι^♯` is onto) and `ker_fiberι_app_le`
  (`ker ι^♯ ⊆ 𝔪 Γ(X, V)`), because `ρ` is onto (`y` is closed).
* `LineBundleData.surjective_pullback_fiberι`, `LineBundleData.ker_pullback_fiberι_le`: the same
  for the sections of `𝓛^m` over an affine open `U ⊆ β⁻¹ W`, by localization at a finite cover of
  `U` by basic opens inside charts (`isLocalizedModule_sectionsRestrict`).

No flatness of `β` is used. These are the base-change inputs of the lifting lemma
`lem:sm-ltg-onto` (Temkin, *Stable modification of relative curves*, Thm 1.1; our replacement of
the fibrewise criterion of EGA IV₃ 9.6.5).
-/

universe u

open CategoryTheory Opposite AlgebraicGeometry TopologicalSpace Limits

namespace DeJongAlterations.StableModification.Projectivity

noncomputable section

set_option backward.isDefEq.respectTransparency false

/-! ### Pushouts of rings along surjections -/

/-- In a pushout square of commutative rings, the leg opposite to a surjection is surjective with
kernel generated by the image of the kernel. -/
theorem surjective_and_ker_le_of_isPushout {A B C P : CommRingCat.{u}} {f : A ⟶ C} {g : A ⟶ B}
    {inl : C ⟶ P} {inr : B ⟶ P} (h : IsPushout f g inl inr) (hg : Function.Surjective g) :
    Function.Surjective inl ∧ RingHom.ker inl.hom ≤ Ideal.map f.hom (RingHom.ker g.hom) := by
  set I : Ideal C := Ideal.map f.hom (RingHom.ker g.hom)
  have hIinl : I ≤ RingHom.ker inl.hom := by
    rw [Ideal.map_le_iff_le_comap]
    intro a ha
    change inl.hom (f.hom a) = 0
    rw [← CommRingCat.comp_apply, h.w, CommRingCat.comp_apply]
    rw [RingHom.mem_ker] at ha
    change inr.hom (g.hom a) = 0
    rw [ha, map_zero]
  -- the map `B → C ⧸ I`
  have hker : RingHom.ker g.hom ≤ RingHom.ker ((Ideal.Quotient.mk I).comp f.hom) := by
    intro a ha
    rw [RingHom.mem_ker, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.mem_map_of_mem _ ha
  let φ : B →+* C ⧸ I := (Ideal.Quotient.lift (RingHom.ker g.hom) ((Ideal.Quotient.mk I).comp f.hom)
    hker).comp (RingHom.quotientKerEquivOfSurjective hg).symm.toRingHom
  have hφ : ∀ a, φ (g.hom a) = Ideal.Quotient.mk I (f.hom a) := by
    intro a
    have : (RingHom.quotientKerEquivOfSurjective hg).symm (g.hom a) =
        Ideal.Quotient.mk (RingHom.ker g.hom) a := by
      rw [RingEquiv.symm_apply_eq]
      rfl
    simp only [φ, RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom, this,
      Ideal.Quotient.lift_mk]
  let δ : P ⟶ CommRingCat.of (C ⧸ I) :=
    h.desc (CommRingCat.ofHom (Ideal.Quotient.mk I)) (CommRingCat.ofHom φ) (by
      ext a
      exact (hφ a).symm)
  have hδ : ∀ c, δ.hom (inl.hom c) = Ideal.Quotient.mk I c := by
    intro c
    have e := h.inl_desc (CommRingCat.ofHom (Ideal.Quotient.mk I)) (CommRingCat.ofHom φ) (by
      ext a
      exact (hφ a).symm)
    exact congrArg (fun q : C ⟶ CommRingCat.of (C ⧸ I) => q.hom c) e
  refine ⟨?_, ?_⟩
  · let ψ : CommRingCat.of (C ⧸ I) ⟶ P := CommRingCat.ofHom (Ideal.Quotient.lift I inl.hom hIinl)
    have hψ : δ ≫ ψ = 𝟙 P := by
      apply h.hom_ext
      · ext c
        change ψ.hom (δ.hom (inl.hom c)) = inl.hom c
        rw [hδ]
        rfl
      · ext b
        obtain ⟨a, rfl⟩ := hg b
        change ψ.hom (δ.hom (inr.hom (g.hom a))) = inr.hom (g.hom a)
        have h1 : inr.hom (g.hom a) = inl.hom (f.hom a) := by
          rw [← CommRingCat.comp_apply, ← h.w, CommRingCat.comp_apply]
        rw [h1, hδ]
        rfl
    intro p
    obtain ⟨c, hc⟩ := Ideal.Quotient.mk_surjective (δ.hom p)
    refine ⟨c, ?_⟩
    have : ψ.hom (δ.hom p) = p := by rw [← CommRingCat.comp_apply, hψ]; rfl
    rw [← this, ← hc]
    rfl
  · intro c hc
    rw [RingHom.mem_ker] at hc
    have := hδ c
    rw [hc, map_zero] at this
    exact Ideal.Quotient.eq_zero_iff_mem.mp this.symm


/-- Elements of `(𝔪 C) • M` for a ring map `κ : A → C` and a `C`-module `M` are finite sums
`∑ κ(aᵢ) • zᵢ` with `aᵢ ∈ 𝔪`. -/
theorem exists_sum_of_mem_map_smul_top {A C M : Type*} [CommRing A] [CommRing C] [AddCommGroup M]
    [Module C M] (κ : A →+* C) (𝔪 : Ideal A) {x : M}
    (hx : x ∈ (Ideal.map κ 𝔪) • (⊤ : Submodule C M)) :
    ∃ (n : ℕ) (a : Fin n → A) (z : Fin n → M), (∀ i, a i ∈ 𝔪) ∧ x = ∑ i, κ (a i) • z i := by
  let S : Submodule C M :=
    { carrier := {x | ∃ (n : ℕ) (a : Fin n → A) (z : Fin n → M), (∀ i, a i ∈ 𝔪) ∧
        x = ∑ i, κ (a i) • z i}
      add_mem' := by
        rintro _ _ ⟨n₁, a₁, z₁, ha₁, rfl⟩ ⟨n₂, a₂, z₂, ha₂, rfl⟩
        refine ⟨n₁ + n₂, Fin.append a₁ a₂, Fin.append z₁ z₂, ?_, ?_⟩
        · intro i
          refine Fin.addCases (fun j => ?_) (fun j => ?_) i
          · rw [Fin.append_left]; exact ha₁ j
          · rw [Fin.append_right]; exact ha₂ j
        · rw [Fin.sum_univ_add]
          simp only [Fin.append_left, Fin.append_right]
      zero_mem' := ⟨0, Fin.elim0, Fin.elim0, fun i => i.elim0, by simp⟩
      smul_mem' := by
        rintro c _ ⟨n, a, z, ha, rfl⟩
        refine ⟨n, a, fun i => c • z i, ha, ?_⟩
        rw [Finset.smul_sum]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [smul_comm] }
  have hle : Ideal.map κ 𝔪 ≤ S.colon ⊤ := by
    rw [Ideal.map_le_iff_le_comap]
    intro a ha
    rw [Ideal.mem_comap, Submodule.mem_colon]
    intro m _
    exact ⟨1, fun _ => a, fun _ => m, fun _ => ha, by simp⟩
  have : (Ideal.map κ 𝔪) • (⊤ : Submodule C M) ≤ S := by
    rw [Submodule.smul_le]
    intro r hr m hm
    exact Submodule.mem_colon.mp (hle hr) m hm
  exact this hx

/-! ### Functions on the fibre -/

variable {X Y : Scheme.{u}} (β : X ⟶ Y) (y : Y)

lemma top_le_fromSpecResidueField_preimage {W : Y.Opens} (hy : y ∈ W) :
    (⊤ : (Spec (Y.residueField y)).Opens) ≤ Y.fromSpecResidueField y ⁻¹ᵁ W := by
  intro z _
  have hz : Y.fromSpecResidueField y z ∈ Set.range (Y.fromSpecResidueField y) := ⟨z, rfl⟩
  rw [Scheme.range_fromSpecResidueField] at hz
  change Y.fromSpecResidueField y z ∈ W
  rw [hz]
  exact hy

/-- The residue map `Γ(Y, W) → Γ(Spec κ(y), ⊤)` at a point `y ∈ W`. -/
def fibreResidue {W : Y.Opens} (hy : y ∈ W) : Γ(Y, W) ⟶ Γ(Spec (Y.residueField y), ⊤) :=
  (Y.fromSpecResidueField y).appLE W ⊤ (top_le_fromSpecResidueField_preimage y hy)

/-- At a closed point, the residue map from an affine neighbourhood is onto. -/
theorem surjective_fibreResidue {W : Y.Opens} (hW : IsAffineOpen W) (hy : y ∈ W)
    (hcl : IsClosed ({y} : Set Y)) : Function.Surjective (fibreResidue y hy) := by
  have := isClosed_singleton_iff_isClosedImmersion.mp hcl
  have h1 := (Y.fromSpecResidueField y).app_surjective W hW
  have hle := top_le_fromSpecResidueField_preimage y hy
  have h2 : Function.Surjective ((Spec (Y.residueField y)).presheaf.map (homOfLE hle).op) := by
    have : homOfLE hle = eqToHom (top_unique hle).symm := rfl
    rw [this]
    exact (ConcreteCategory.bijective_of_isIso _).2
  simp only [fibreResidue, Scheme.Hom.appLE, CommRingCat.hom_comp, RingHom.coe_comp]
  exact h2.comp h1

lemma fiberι_preimage_eq {V : X.Opens} :
    β.fiberι y ⁻¹ᵁ V = β.fiberι y ⁻¹ᵁ V ⊓ β.fiberToSpecResidueField y ⁻¹ᵁ ⊤ := by
  rw [Scheme.Hom.preimage_top, inf_top_eq]

/-- **The fibre square of rings is a pushout** over affine opens `V ⊆ β⁻¹ W`. -/
theorem isPushout_fiberι_appLE {W : Y.Opens} (hW : IsAffineOpen W) (hy : y ∈ W) {V : X.Opens}
    (hV : IsAffineOpen V) (hVW : V ≤ β ⁻¹ᵁ W) :
    IsPushout (β.appLE W V hVW) (fibreResidue y hy)
      ((β.fiberι y).appLE V (β.fiberι y ⁻¹ᵁ V) le_rfl)
      ((β.fiberToSpecResidueField y).appLE ⊤ (β.fiberι y ⁻¹ᵁ V) le_top) := by
  have H : IsPullback (β.fiberι y) (β.fiberToSpecResidueField y) β (Y.fromSpecResidueField y) :=
    IsPullback.of_hasPullback _ _
  have := isIso_pushoutSection_of_isAffineOpen H (top_le_fromSpecResidueField_preimage y hy) hVW
    (fiberι_preimage_eq β y) hW (isAffineOpen_top _) hV
  exact (isIso_pushoutSection_iff H _ _ _).mp this

/-- The preimage of an affine open `V ⊆ β⁻¹ W` in the fibre is affine. -/
theorem isAffineOpen_fiberι_preimage {W : Y.Opens} (hW : IsAffineOpen W) (hy : y ∈ W)
    {V : X.Opens} (hV : IsAffineOpen V) (hVW : V ≤ β ⁻¹ᵁ W) :
    IsAffineOpen (β.fiberι y ⁻¹ᵁ V) := by
  have H : IsPullback (β.fiberι y) (β.fiberToSpecResidueField y) β (Y.fromSpecResidueField y) :=
    IsPullback.of_hasPullback _ _
  have : IsAffine _ := hW
  have : IsAffine _ := hV
  have : IsAffine ((⊤ : (Spec (Y.residueField y)).Opens).toScheme) := isAffineOpen_top _
  exact .of_isIso (Scheme.Hom.isPullback_resLE H (top_le_fromSpecResidueField_preimage y hy) hVW
    (fiberι_preimage_eq β y)).isoPullback.hom

/-- **Functions on the fibre** (blueprint `lem:sm-ltg-fibre-functions`): at a closed point `y`,
`ι^♯ : Γ(X, V) → Γ(X_y, ι⁻¹ V)` is onto and its kernel is generated by the kernel of the residue
map, for every affine open `V ⊆ β⁻¹ W`. -/
theorem surjective_fiberι_app_and_ker_le {W : Y.Opens} (hW : IsAffineOpen W) (hy : y ∈ W)
    (hcl : IsClosed ({y} : Set Y)) {V : X.Opens} (hV : IsAffineOpen V) (hVW : V ≤ β ⁻¹ᵁ W) :
    Function.Surjective ((β.fiberι y).app V) ∧
      RingHom.ker ((β.fiberι y).app V).hom ≤
        Ideal.map (β.appLE W V hVW).hom (RingHom.ker (fibreResidue y hy).hom) := by
  have h := surjective_and_ker_le_of_isPushout (isPushout_fiberι_appLE β y hW hy hV hVW)
    (surjective_fibreResidue y hW hy hcl)
  rwa [Scheme.Hom.appLE_eq_app] at h

/-- The action of `Γ(Y, W)` on functions on the fibre factors through the residue map. -/
theorem fiberι_app_appLE {W : Y.Opens} (hy : y ∈ W) {V : X.Opens} (hVW : V ≤ β ⁻¹ᵁ W)
    (a : Γ(Y, W)) :
    (β.fiberι y).app V (β.appLE W V hVW a) =
      (β.fiberToSpecResidueField y).appLE ⊤ (β.fiberι y ⁻¹ᵁ V) le_top (fibreResidue y hy a) := by
  have e1 : (β.appLE W V hVW ≫ (β.fiberι y).appLE V (β.fiberι y ⁻¹ᵁ V) le_rfl) =
      (β.fiberι y ≫ β).appLE W (β.fiberι y ⁻¹ᵁ V) (fun x hx => hVW hx) :=
    Scheme.Hom.appLE_comp_appLE _ _ _ _ _ _ _
  have e2 : (fibreResidue y hy ≫ (β.fiberToSpecResidueField y).appLE ⊤ (β.fiberι y ⁻¹ᵁ V)
      le_top) = (β.fiberToSpecResidueField y ≫ Y.fromSpecResidueField y).appLE W
        (β.fiberι y ⁻¹ᵁ V) (fun x hx => top_le_fromSpecResidueField_preimage y hy trivial) :=
    Scheme.Hom.appLE_comp_appLE _ _ _ _ _ _ _
  have hw : β.fiberι y ≫ β = β.fiberToSpecResidueField y ≫ Y.fromSpecResidueField y :=
    (IsPullback.of_hasPullback β (Y.fromSpecResidueField y)).w
  have := congrArg (fun q => q.hom a) e1
  rw [← Scheme.Hom.appLE_eq_app]
  simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
  rw [this]
  have := congrArg (fun q => q.hom a) e2
  simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
  rw [this]
  have key : ∀ (f g : (β.fiber y) ⟶ Y) (_ : f = g) (e e' : β.fiberι y ⁻¹ᵁ V ≤ f ⁻¹ᵁ W),
      (f.appLE W (β.fiberι y ⁻¹ᵁ V) e).hom a = (f.appLE W (β.fiberι y ⁻¹ᵁ V) e').hom a :=
    fun _ _ _ _ _ => rfl
  have key2 : ∀ (f g : (β.fiber y) ⟶ Y) (_ : f = g) (e : β.fiberι y ⁻¹ᵁ V ≤ f ⁻¹ᵁ W)
      (e' : β.fiberι y ⁻¹ᵁ V ≤ g ⁻¹ᵁ W),
      (f.appLE W (β.fiberι y ⁻¹ᵁ V) e).hom a = (g.appLE W (β.fiberι y ⁻¹ᵁ V) e').hom a := by
    rintro f g rfl e e'
    rfl
  exact key2 _ _ hw _ _

/-! ### Sections of `𝓛^m` on the fibre -/

namespace LineBundleData

variable {β y} (L : LineBundleData X) (m : ℤ)

section PullbackLemmas

variable {X' : Scheme.{u}} (f : X' ⟶ X)

/-- Pullback of sections is semilinear over `f^♯`. -/
lemma Sections.pullback_smul {W : X.Opens} (r : Γ(X, W)) (s : L.Sections m W) :
    (r • s).pullback f = f.app W r • s.pullback f := by
  ext i
  simp only [Sections.coeff_pullback, Sections.coeff_smul, map_mul, LineBundleData.app_res]
  rfl

/-- Pullback of sections commutes with restriction. -/
lemma Sections.pullback_restrict {W W' : X.Opens} (h : W' ≤ W) (s : L.Sections m W) :
    (s.restrict h).pullback f = (s.pullback f).restrict (f.preimage_mono h) := by
  ext i
  simp only [Sections.coeff_pullback, Sections.coeff_restrict]
  exact LineBundleData.app_res f _ _

/-- Pullback of sections is additive. -/
lemma Sections.pullback_add {W : X.Opens} (s t : L.Sections m W) :
    (s + t).pullback f = s.pullback f + t.pullback f := by
  ext i
  simp only [Sections.coeff_pullback, Sections.coeff_add, map_add]

/-- The chart coefficient of a pulled-back section is the pullback of the chart coefficient. -/
lemma toLocal_pullback {W : X.Opens} {i : L.ι} (hW : W ≤ L.U i) (s : L.Sections m W) :
    toLocal (unitModule X') m (L := L.pullback f) (f.preimage_mono hW : f ⁻¹ᵁ W ≤ f ⁻¹ᵁ L.U i)
      (s.pullback f).toTwist = f.app W (toLocal (unitModule X) m hW s.toTwist) := by
  change X'.presheaf.map _ (f.app (W ⊓ L.U i) (s.coeff i)) =
    f.app W (X.presheaf.map _ (s.coeff i))
  exact (LineBundleData.app_res f (le_inf le_rfl hW) (s.coeff i)).symm

end PullbackLemmas

variable (β y)

/-- The pullback of sections of `𝓛^m` over `V ≤ U` to the fibre, as a `Γ(X, U)`-linear map
between the section modules (`Γ(X, U)` acting by restriction on `X` and through `ι^♯` on the
fibre). -/
def fibreSectionsMap {U V : X.Opens} (hV : V ≤ U) :
    Cohomology.sectionsModuleCat (L.twist (unitModule X) m) (RingHom.id Γ(X, U)) V hV →ₗ[Γ(X, U)]
      Cohomology.sectionsModuleCat ((L.pullback (β.fiberι y)).twist (unitModule (β.fiber y)) m)
        ((β.fiberι y).app U).hom (β.fiberι y ⁻¹ᵁ V) ((β.fiberι y).preimage_mono hV) where
  toFun s := (Sections.pullback (β.fiberι y) (L := L) (m := m) s)
  map_add' s t := Sections.pullback_add L m _ s t
  map_smul' r s := by
    change Sections.pullback (β.fiberι y) ((res hV r) • (show L.Sections m V from s)) =
      (res ((β.fiberι y).preimage_mono hV) ((β.fiberι y).app U r)) •
        Sections.pullback (β.fiberι y) (show L.Sections m V from s)
    rw [Sections.pullback_smul, LineBundleData.app_res]

lemma fibreSectionsMap_apply {U V : X.Opens} (hV : V ≤ U) (s : L.Sections m V) :
    L.fibreSectionsMap β y m hV s = s.pullback (β.fiberι y) :=
  rfl

/-- The functions on an affine open `U` whose basic opens lie inside charts of `L`. -/
def chartBasicSet (U : X.Opens) : Set Γ(X, U) := {g | ∃ i, X.basicOpen g ≤ L.U i}

lemma span_chartBasicSet {U : X.Opens} (hU : IsAffineOpen U) :
    Ideal.span (L.chartBasicSet U) = ⊤ := by
  rw [← hU.self_le_iSup_basicOpen_iff]
  intro x hx
  obtain ⟨i, hi⟩ := L.exists_mem_U x
  obtain ⟨g, hg, hxg⟩ := hU.exists_basicOpen_le (V := L.U i) ⟨x, hi⟩ hx
  exact Opens.mem_iSup.mpr ⟨⟨g, i, hg⟩, hxg⟩

section Fibre

variable {W : Y.Opens} (hW : IsAffineOpen W) (hy : y ∈ W) (hcl : IsClosed ({y} : Set Y))
  {U : X.Opens} (hU : IsAffineOpen U) (hUW : U ≤ β ⁻¹ᵁ W)

include hW hy hcl hU hUW in
/-- On a basic open inside a chart the pullback of sections to the fibre is onto. -/
lemma surjective_fibreSectionsMap_basicOpen {g : Γ(X, U)} (hg : g ∈ L.chartBasicSet U) :
    Function.Surjective (L.fibreSectionsMap β y m (X.basicOpen_le g : X.basicOpen g ≤ U)) := by
  obtain ⟨i, hi⟩ := hg
  intro t
  have hle : β.fiberι y ⁻¹ᵁ X.basicOpen g ≤ (L.pullback (β.fiberι y)).U i :=
    (β.fiberι y).preimage_mono hi
  set e := toLocal (unitModule (β.fiber y)) m (L := L.pullback (β.fiberι y)) hle
    (show (L.pullback (β.fiberι y)).Sections m (β.fiberι y ⁻¹ᵁ X.basicOpen g) from t).toTwist
  obtain ⟨a, ha⟩ := (surjective_fiberι_app_and_ker_le β y hW hy hcl (hU.basicOpen g)
    ((X.basicOpen_le g).trans hUW)).1 e
  refine ⟨Sections.ofTwist (ofLocal (unitModule X) m hi a), ?_⟩
  change Sections.pullback (β.fiberι y) (Sections.ofTwist (ofLocal (unitModule X) m hi a)) = t
  apply (localEquiv (unitModule (β.fiber y)) m (L := L.pullback (β.fiberι y)) hle).injective
  rw [localEquiv_apply, localEquiv_apply]
  change toLocal _ m hle (Sections.pullback (β.fiberι y)
    (Sections.ofTwist (ofLocal (unitModule X) m hi a))).toTwist = e
  rw [toLocal_pullback]
  change (β.fiberι y).app _ (toLocal (unitModule X) m hi (ofLocal (unitModule X) m hi a)) = e
  rw [toLocal_ofLocal]
  exact ha

include hU in
lemma isLocalizedModule_restrict_basicOpen (g : Γ(X, U)) :
    IsLocalizedModule (Submonoid.powers g)
      (Cohomology.sectionsRestrict (L.twist (unitModule X) m) (RingHom.id Γ(X, U)) le_rfl
        (X.basicOpen_le g) (X.basicOpen_le g)).hom :=
  Cohomology.isLocalizedModule_sectionsRestrict _ (RingHom.id _) hU le_rfl g
    (inf_eq_left.mpr (X.basicOpen_le g)).symm

include hW hy hU hUW in
lemma isLocalizedModule_fibre_restrict_basicOpen (g : Γ(X, U)) :
    IsLocalizedModule (Submonoid.powers g)
      (Cohomology.sectionsRestrict ((L.pullback (β.fiberι y)).twist (unitModule (β.fiber y)) m)
        ((β.fiberι y).app U).hom le_rfl ((β.fiberι y).preimage_mono (X.basicOpen_le g))
        ((β.fiberι y).preimage_mono (X.basicOpen_le g))).hom :=
  Cohomology.isLocalizedModule_sectionsRestrict _ ((β.fiberι y).app U).hom
    (isAffineOpen_fiberι_preimage β y hW hy hU hUW) le_rfl g (by
      rw [Scheme.preimage_basicOpen]
      exact (inf_eq_left.mpr (Scheme.basicOpen_le _ _)).symm)

lemma fibreSectionsMap_restrict {V V' : X.Opens} (hV : V ≤ U) (hV' : V' ≤ U) (h : V' ≤ V)
    (s : L.Sections m V) :
    L.fibreSectionsMap β y m hV' (Cohomology.sectionsRestrict (L.twist (unitModule X) m)
      (RingHom.id Γ(X, U)) hV hV' h s) =
      Cohomology.sectionsRestrict ((L.pullback (β.fiberι y)).twist (unitModule (β.fiber y)) m)
        ((β.fiberι y).app U).hom ((β.fiberι y).preimage_mono hV)
        ((β.fiberι y).preimage_mono hV') ((β.fiberι y).preimage_mono h)
        (L.fibreSectionsMap β y m hV s) :=
  Sections.pullback_restrict L m (β.fiberι y) h s

include hW hy hcl hU hUW in
/-- **Sections of `𝓛^m` on the fibre, surjectivity** (blueprint `lem:sm-ltg-fibre-twist`): at a
closed point `y`, every section of `(ι^* 𝓛)^m` over `ι⁻¹ U` is the pullback of a section of `𝓛^m`
over `U`, for every affine open `U ⊆ β⁻¹ W`. -/
theorem surjective_fibreSectionsMap :
    Function.Surjective (L.fibreSectionsMap β y m (le_refl U)) := by
  let S := L.chartBasicSet U
  have : ∀ r : S, IsLocalizedModule.Away r.1
      (Cohomology.sectionsRestrict (L.twist (unitModule X) m) (RingHom.id Γ(X, U)) le_rfl
        (X.basicOpen_le r.1) (X.basicOpen_le r.1)).hom :=
    fun r => L.isLocalizedModule_restrict_basicOpen m hU r.1
  have : ∀ r : S, IsLocalizedModule.Away r.1
      (Cohomology.sectionsRestrict ((L.pullback (β.fiberι y)).twist (unitModule (β.fiber y)) m)
        ((β.fiberι y).app U).hom le_rfl ((β.fiberι y).preimage_mono (X.basicOpen_le r.1))
        ((β.fiberι y).preimage_mono (X.basicOpen_le r.1))).hom :=
    fun r => L.isLocalizedModule_fibre_restrict_basicOpen β y m hW hy hU hUW r.1
  refine surjective_of_isLocalized_span S (L.span_chartBasicSet hU) _
    (fun r => (Cohomology.sectionsRestrict (L.twist (unitModule X) m) (RingHom.id Γ(X, U)) le_rfl
        (X.basicOpen_le r.1) (X.basicOpen_le r.1)).hom) _
    (fun r => (Cohomology.sectionsRestrict
        ((L.pullback (β.fiberι y)).twist (unitModule (β.fiber y)) m)
        ((β.fiberι y).app U).hom le_rfl ((β.fiberι y).preimage_mono (X.basicOpen_le r.1))
        ((β.fiberι y).preimage_mono (X.basicOpen_le r.1))).hom) _ (fun r => ?_)
  have heq : IsLocalizedModule.map (Submonoid.powers r.1)
      (Cohomology.sectionsRestrict (L.twist (unitModule X) m) (RingHom.id Γ(X, U)) le_rfl
        (X.basicOpen_le r.1) (X.basicOpen_le r.1)).hom
      (Cohomology.sectionsRestrict ((L.pullback (β.fiberι y)).twist (unitModule (β.fiber y)) m)
        ((β.fiberι y).app U).hom le_rfl ((β.fiberι y).preimage_mono (X.basicOpen_le r.1))
        ((β.fiberι y).preimage_mono (X.basicOpen_le r.1))).hom
      (L.fibreSectionsMap β y m (le_refl U)) =
      L.fibreSectionsMap β y m (X.basicOpen_le r.1) := by
    apply IsLocalizedModule.linearMap_ext (Submonoid.powers r.1)
      (Cohomology.sectionsRestrict (L.twist (unitModule X) m) (RingHom.id Γ(X, U)) le_rfl
        (X.basicOpen_le r.1) (X.basicOpen_le r.1)).hom
      (Cohomology.sectionsRestrict ((L.pullback (β.fiberι y)).twist (unitModule (β.fiber y)) m)
        ((β.fiberι y).app U).hom le_rfl ((β.fiberι y).preimage_mono (X.basicOpen_le r.1))
        ((β.fiberι y).preimage_mono (X.basicOpen_le r.1))).hom
    rw [IsLocalizedModule.map_comp]
    ext s
    exact (L.fibreSectionsMap_restrict β y m le_rfl (X.basicOpen_le r.1) _ s).symm
  rw [heq]
  exact L.surjective_fibreSectionsMap_basicOpen β y m hW hy hcl hU hUW r.2

include hW hy hcl hU hUW in
/-- **Sections of `𝓛^m` on the fibre, kernel** (blueprint `lem:sm-ltg-fibre-twist`): at a closed
point `y`, a section of `𝓛^m` over an affine open `U ⊆ β⁻¹ W` vanishing on the fibre lies in
`𝔪 · Γ(U, 𝓛^m)`, `𝔪` the kernel of the residue map of `y`. -/
theorem ker_fibreSectionsMap_le
    (s : Cohomology.sectionsModuleCat (L.twist (unitModule X) m) (RingHom.id Γ(X, U)) U le_rfl)
    (hs : L.fibreSectionsMap β y m (le_refl U) s = 0) :
    s ∈ (Ideal.map (β.appLE W U hUW).hom (RingHom.ker (fibreResidue y hy).hom)) •
      (⊤ : Submodule Γ(X, U)
        (Cohomology.sectionsModuleCat (L.twist (unitModule X) m) (RingHom.id Γ(X, U)) U le_rfl)) := by
  set I := Ideal.map (β.appLE W U hUW).hom (RingHom.ker (fibreResidue y hy).hom)
  refine Submodule.mem_of_span_eq_top_of_smul_pow_mem _ (L.chartBasicSet U)
    (L.span_chartBasicSet hU) s (fun ⟨g, hg⟩ => ?_)
  obtain ⟨i, hi⟩ := hg
  set D := X.basicOpen g
  have hD : D ≤ U := X.basicOpen_le g
  let rD := (Cohomology.sectionsRestrict (L.twist (unitModule X) m) (RingHom.id Γ(X, U)) le_rfl
    hD hD).hom
  have hloc : IsLocalizedModule (Submonoid.powers g) rD := L.isLocalizedModule_restrict_basicOpen m hU g
  let := hU.isLocalization_basicOpen g
  -- the action of `Γ(X, U)` on the sections over `D`
  have hsmulD : ∀ (c : Γ(X, U)) (a : Γ(X, D)),
      (c • (show Cohomology.sectionsModuleCat (L.twist (unitModule X) m) (RingHom.id Γ(X, U)) D hD
        from ofLocal (unitModule X) m hi a)) = ofLocal (unitModule X) m hi (res hD c * a) := by
    intro c a
    change res hD c • ofLocal (unitModule X) m hi a = _
    exact ((localEquiv (unitModule X) m hi).symm.map_smul (res hD c) a).symm
  have hres_ideal : Ideal.map (β.appLE W D (hD.trans hUW)).hom
      (RingHom.ker (fibreResidue y hy).hom) = Ideal.map (res hD) I := by
    rw [Ideal.map_map]
    congr 1
    rw [← CommRingCat.hom_comp, Scheme.Hom.appLE_map]
  -- the key claim, by induction on the ideal
  have claim : ∀ a ∈ Ideal.map (res hD) I, ∃ (n : ℕ) (z : Cohomology.sectionsModuleCat
      (L.twist (unitModule X) m) (RingHom.id Γ(X, U)) U le_rfl), z ∈ I • (⊤ : Submodule Γ(X, U)
        (Cohomology.sectionsModuleCat (L.twist (unitModule X) m) (RingHom.id Γ(X, U)) U le_rfl)) ∧
      rD z = g ^ n • (show Cohomology.sectionsModuleCat (L.twist (unitModule X) m)
        (RingHom.id Γ(X, U)) D hD from ofLocal (unitModule X) m hi a) := by
    intro a ha
    refine Submodule.span_induction ?_ ?_ ?_ ?_ ha
    · rintro _ ⟨j, hj, rfl⟩
      obtain ⟨⟨z₀, ⟨_, n, rfl⟩⟩, hz₀⟩ := hloc.surj (show Cohomology.sectionsModuleCat
        (L.twist (unitModule X) m) (RingHom.id Γ(X, U)) D hD from
          ofLocal (unitModule X) m hi (1 : Γ(X, D)))
      refine ⟨n, j • z₀, Submodule.smul_mem_smul hj trivial, ?_⟩
      rw [map_smul, ← hz₀, smul_comm, hsmulD, mul_one]
      rfl
    · refine ⟨0, 0, Submodule.zero_mem _, ?_⟩
      rw [map_zero, pow_zero, one_smul]
      exact ((localEquiv (unitModule X) m hi).symm.map_zero).symm
    · rintro x y - - ⟨n₁, z₁, hz₁, e₁⟩ ⟨n₂, z₂, hz₂, e₂⟩
      refine ⟨n₁ + n₂, g ^ n₂ • z₁ + g ^ n₁ • z₂,
        Submodule.add_mem _ (Submodule.smul_mem _ _ hz₁) (Submodule.smul_mem _ _ hz₂), ?_⟩
      rw [map_add, map_smul, map_smul, e₁, e₂, smul_smul, smul_smul, ← pow_add, ← pow_add,
        add_comm n₂ n₁, ← smul_add]
      congr 1
      exact ((localEquiv (unitModule X) m hi).symm.map_add x y).symm
    · rintro c x - ⟨n, z, hz, e⟩
      obtain ⟨⟨c₀, ⟨_, k, rfl⟩⟩, hc₀⟩ := IsLocalization.surj (Submonoid.powers g) c
      refine ⟨n + k, c₀ • z, Submodule.smul_mem _ _ hz, ?_⟩
      rw [map_smul, e, smul_smul, hsmulD, hsmulD, pow_add, smul_eq_mul]
      congr 1
      change res hD (c₀ * g ^ n) * x = res hD (g ^ n * g ^ k) * (c * x)
      have hc : c * res hD (g ^ k) = res hD c₀ := hc₀
      rw [map_mul, map_mul, ← hc]
      ring
  -- apply the claim to the coefficient of `s` on `D`
  set a : Γ(X, D) := toLocal (unitModule X) m hi (show L.twistSubgroup (unitModule X) m D from rD s)
  have hsa : (show Cohomology.sectionsModuleCat (L.twist (unitModule X) m) (RingHom.id Γ(X, U)) D hD
      from ofLocal (unitModule X) m hi a) = rD s := ofLocal_toLocal _ _ _ _
  have hker : a ∈ RingHom.ker ((β.fiberι y).app D).hom := by
    rw [RingHom.mem_ker]
    have h1 := toLocal_pullback L m (β.fiberι y) hi (show L.Sections m D from rD s)
    refine h1.symm.trans ?_
    have h2 : Sections.pullback (β.fiberι y) (show L.Sections m D from rD s) = 0 := by
      have := L.fibreSectionsMap_restrict β y m le_rfl hD hD s
      rw [hs, map_zero] at this
      exact this
    change toLocal (unitModule (β.fiber y)) m _ (Sections.pullback (β.fiberι y)
      (show L.Sections m D from rD s)).toTwist = 0
    rw [h2]
    exact (localEquiv (unitModule (β.fiber y)) m (L := L.pullback (β.fiberι y))
      ((β.fiberι y).preimage_mono hi)).map_zero
  have hmem := (surjective_fiberι_app_and_ker_le β y hW hy hcl (hU.basicOpen g)
    (hD.trans hUW)).2 hker
  rw [hres_ideal] at hmem
  obtain ⟨n, z, hz, e⟩ := claim a hmem
  rw [hsa, ← map_smul] at e
  obtain ⟨⟨_, n', rfl⟩, hn'⟩ := hloc.exists_of_eq e.symm
  refine ⟨n' + n, ?_⟩
  rw [pow_add, mul_smul]
  change g ^ n' • g ^ n • s ∈ _ at *
  rw [show g ^ n' • g ^ n • s = g ^ n' • z from hn']
  exact Submodule.smul_mem _ _ hz

include hW hy hcl hU hUW in
/-- **Sections of `𝓛^m` on the fibre** (blueprint `lem:sm-ltg-fibre-twist`), clean form: the
pullback to the fibre over a closed point is onto. -/
theorem surjective_pullback_fiberι :
    Function.Surjective (fun s : L.Sections m U => s.pullback (β.fiberι y)) :=
  L.surjective_fibreSectionsMap β y m hW hy hcl hU hUW

include hW hy hcl hU hUW in
/-- **Sections of `𝓛^m` on the fibre** (blueprint `lem:sm-ltg-fibre-twist`), clean form: a
section vanishing on the fibre over a closed point is a combination `∑ β^♯(aᵢ) zᵢ` with `aᵢ` in
the kernel of the residue map. -/
theorem exists_sum_of_pullback_fiberι_eq_zero (s : L.Sections m U)
    (hs : s.pullback (β.fiberι y) = 0) :
    ∃ (n : ℕ) (a : Fin n → Γ(Y, W)) (z : Fin n → L.Sections m U),
      (∀ i, a i ∈ RingHom.ker (fibreResidue y hy).hom) ∧
        s = ∑ i, (β.appLE W U hUW).hom (a i) • z i := by
  have h := L.ker_fibreSectionsMap_le β y m hW hy hcl hU hUW s hs
  obtain ⟨n, a, z, ha, hsum⟩ := exists_sum_of_mem_map_smul_top (β.appLE W U hUW).hom _ h
  refine ⟨n, a, z, ha, ?_⟩
  refine hsum.trans (Finset.sum_congr rfl fun i _ => ?_)
  change res le_rfl ((β.appLE W U hUW).hom (a i)) • (show L.Sections m U from z i) = _
  rw [res_self]

end Fibre

