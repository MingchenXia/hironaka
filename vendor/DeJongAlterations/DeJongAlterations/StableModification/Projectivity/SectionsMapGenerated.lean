import DeJongAlterations.StableModification.Projectivity.SectionsMap
import DeJongAlterations.StableModification.Projectivity.LineBundleOps

/-!
# Global generation of `𝓛^m` and generating sections

Blueprint `sm-projectivity-core.tex`, `lem:sm-lbd-generated` (PLAN-OM3 M2). The module
`𝓛^m = 𝒪_X ⊗ 𝓛^m` is generated by its global sections
(`IsGloballyGenerated`, the form of `FiberAmple`) if and only if every point lies in the
non-vanishing locus of some global section (`isGloballyGenerated_iff`); on a quasi-compact `X`
finitely many sections `s 0, …, s N` then have no common zero
(`exists_generates_of_isGloballyGenerated`), so they define a morphism to `ℙᴺ`
(`LineBundleData.toProjectiveSpace`).
-/

noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace Opposite

namespace DeJongAlterations.StableModification.Projectivity

universe u

variable {X : Scheme.{u}}

namespace LineBundleData

variable {L : LineBundleData X} {m : ℤ}

/-- A global section of `𝓛^m` as a section of the twist of the structure sheaf. -/
abbrev Sections.toGlobal (s : L.Sections m ⊤) : Γ(L.twist (unitModule X) m, ⊤) :=
  s.toTwist

/-- The `i`-th coefficient on an open `V ⊆ U i`, as a `Γ(X, V)`-linear map on the sections of
`𝒪_X ⊗ 𝓛^m` (with the module structure of the sheaf of modules). -/
def coeffLinear {V : X.Opens} {i : L.ι} (hV : V ≤ L.U i) :
    Γ(L.twist (unitModule X) m, V) →ₗ[Γ(X, V)] Γ(X, V) where
  toFun y := toLocal (unitModule X) m hV y
  map_add' y y' := toLocal_add (unitModule X) m hV y y'
  map_smul' r y := toLocal_smul (unitModule X) m hV r y

lemma coeffLinear_injective {V : X.Opens} {i : L.ι} (hV : V ≤ L.U i) :
    Function.Injective (coeffLinear (L := L) (m := m) hV) :=
  (localEquiv (unitModule X) m hV).injective

/-- The `i`-th coefficient of the restriction of a global section to `V ⊆ U i`. -/
lemma coeffLinear_restrict_top {V : X.Opens} {i : L.ι} (hV : V ≤ L.U i)
    (s : L.Sections m ⊤) :
    coeffLinear hV ((L.twist (unitModule X) m).presheaf.map (homOfLE (le_top : V ≤ ⊤)).op
      s.toGlobal) =
      X.presheaf.map (homOfLE (le_inf le_top hV : V ≤ ⊤ ⊓ L.U i)).op (s.coeff i) :=
  Cohomology.presheaf_map_map (unitModule X) _ _ _ _

/-- If every point lies in the non-vanishing locus of a global section, `𝓛^m` is globally
generated. -/
theorem isGloballyGenerated_of_forall_exists
    (hs : ∀ x : X, ∃ s : L.Sections m ⊤, x ∈ s.nonvanishingLocus) :
    IsGloballyGenerated (L.twist (unitModule X) m) := by
  intro W t x hxW
  obtain ⟨i, hi⟩ := L.exists_mem_U x
  obtain ⟨s, hs⟩ := hs x
  have hxs : x ∈ X.basicOpen (s.coeff i) := (s.mem_nonvanishingLocus_iff hi).mp hs
  have hVW : W ⊓ X.basicOpen (s.coeff i) ≤ W := inf_le_left
  have hVi : W ⊓ X.basicOpen (s.coeff i) ≤ L.U i :=
    inf_le_right.trans ((X.basicOpen_le _).trans inf_le_right)
  refine ⟨W ⊓ X.basicOpen (s.coeff i), hVW, ⟨hxW, hxs⟩, ?_⟩
  set V := W ⊓ X.basicOpen (s.coeff i) with hVdef
  let sV : Γ(L.twist (unitModule X) m, V) :=
    (L.twist (unitModule X) m).presheaf.map (homOfLE (le_top : V ≤ ⊤)).op s.toGlobal
  let tV : Γ(L.twist (unitModule X) m, V) :=
    (L.twist (unitModule X) m).presheaf.map (homOfLE hVW).op t
  have hunit : IsUnit (coeffLinear hVi sV) := by
    rw [coeffLinear_restrict_top]
    apply isUnit_of_basicOpen_eq
    rw [Scheme.basicOpen_res]
    exact inf_eq_left.mpr inf_le_right
  obtain ⟨v, hv⟩ := hunit
  have key : tV = (coeffLinear hVi tV * ((v⁻¹ : Γ(X, V)ˣ) : Γ(X, V))) • sV := by
    apply coeffLinear_injective hVi
    rw [LinearMap.map_smul, ← hv, smul_eq_mul, mul_assoc, Units.inv_mul, mul_one]
  change tV ∈ _
  rw [key]
  exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨s.toGlobal, rfl⟩)

/-- If `𝓛^m` is globally generated, every point lies in the non-vanishing locus of a global
section. -/
theorem exists_mem_nonvanishingLocus_of_isGloballyGenerated
    (h : IsGloballyGenerated (L.twist (unitModule X) m)) (x : X) :
    ∃ s : L.Sections m ⊤, x ∈ s.nonvanishingLocus := by
  obtain ⟨i, hi⟩ := L.exists_mem_U x
  let g : Γ(L.twist (unitModule X) m, L.U i) :=
    ofLocal (unitModule X) m (le_refl (L.U i)) (1 : Γ(X, L.U i))
  obtain ⟨V, hVW, hxV, hmem⟩ := h (L.U i) g x hi
  have h1 : coeffLinear hVW ((L.twist (unitModule X) m).presheaf.map (homOfLE hVW).op g) =
      (1 : Γ(X, V)) := by
    have e := toLocal_restrict (unitModule X) m (le_refl (L.U i)) hVW
      (ofLocal (unitModule X) m (le_refl (L.U i)) (1 : Γ(X, L.U i)))
    have e2 : toLocal (unitModule X) m (le_refl (L.U i))
        (ofLocal (unitModule X) m (le_refl (L.U i)) (1 : Γ(X, L.U i))) = (1 : Γ(X, L.U i)) :=
      toLocal_ofLocal _ _ _ _
    exact e.trans ((congrArg (fun z : Γ(X, L.U i) => X.presheaf.map (homOfLE hVW).op z) e2).trans
      (map_one (X.presheaf.map (homOfLE hVW).op).hom))
  have h2 := Submodule.mem_map_of_mem (f := coeffLinear (L := L) (m := m) hVW) hmem
  rw [Submodule.map_span, h1] at h2
  have hx1 : x ∉ X.zeroLocus (U := V) (Ideal.span ((coeffLinear (L := L) (m := m) hVW) ''
      Set.range fun t : Γ(L.twist (unitModule X) m, ⊤) =>
        (L.twist (unitModule X) m).presheaf.map (homOfLE (le_top : V ≤ ⊤)).op t) :
        Set Γ(X, V)) := by
    rw [Scheme.mem_zeroLocus_iff]
    push Not
    exact ⟨1, h2, by rw [Scheme.basicOpen_one]; exact hxV⟩
  rw [Scheme.zeroLocus_span, Scheme.mem_zeroLocus_iff] at hx1
  push Not at hx1
  obtain ⟨f, ⟨_, ⟨t, rfl⟩, rfl⟩, hf⟩ := hx1
  refine ⟨Sections.ofTwist t, ?_⟩
  have hf' : x ∈ X.basicOpen (X.presheaf.map (homOfLE (le_inf le_top hVW : V ≤ ⊤ ⊓ L.U i)).op
      ((Sections.ofTwist t : L.Sections m ⊤).coeff i)) := by
    rw [← coeffLinear_restrict_top]
    exact hf
  rw [Scheme.basicOpen_res] at hf'
  exact (Sections.basicOpen_coeff_le _ i) hf'.2

/-- **`𝓛^m` is globally generated iff global sections have no common zero.** -/
theorem isGloballyGenerated_iff :
    IsGloballyGenerated (L.twist (unitModule X) m) ↔
      ∀ x : X, ∃ s : L.Sections m ⊤, x ∈ s.nonvanishingLocus :=
  ⟨exists_mem_nonvanishingLocus_of_isGloballyGenerated, isGloballyGenerated_of_forall_exists⟩

/-- On a quasi-compact scheme, a globally generated `𝓛^m` has finitely many generating global
sections `s 0, …, s N`. -/
theorem exists_generates_of_isGloballyGenerated [CompactSpace X]
    (h : IsGloballyGenerated (L.twist (unitModule X) m)) :
    ∃ (N : ℕ) (s : Fin (N + 1) → L.Sections m ⊤), Generates s := by
  classical
  choose s hs using exists_mem_nonvanishingLocus_of_isGloballyGenerated h
  obtain ⟨T, hT⟩ := isCompact_univ.elim_finite_subcover (fun x => ((s x).nonvanishingLocus : Set X))
    (fun x => (s x).nonvanishingLocus.isOpen) (fun x _ => Set.mem_iUnion.mpr ⟨x, hs x⟩)
  let e := T.equivFin
  refine ⟨T.card, fun a => if h : (a : ℕ) < T.card then s (e.symm ⟨a, h⟩).1 else 0, ?_⟩
  intro x
  obtain ⟨y, hyT, hxy⟩ := Set.mem_iUnion₂.mp (hT (Set.mem_univ x))
  let a : Fin (T.card + 1) := ⟨e ⟨y, hyT⟩, (e ⟨y, hyT⟩).2.trans (Nat.lt_succ_self _)⟩
  refine ⟨a, ?_⟩
  have ha : (a : ℕ) < T.card := (e ⟨y, hyT⟩).2
  simp only [a, ha, dif_pos]
  simpa using hxy

end LineBundleData

end DeJongAlterations.StableModification.Projectivity
