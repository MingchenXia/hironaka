import DeJongAlterations.Geometry.BlowupProjective
import DeJongAlterations.StableModification.Projectivity.Reduction

/-!
# Ideal sheaves of finite type on projective schemes over an arbitrary ring (SERRE-I)

Blueprint `sm-projectivity-relative.tex`, `lem:sm-serre-ideal` (PLAN-T5 §4 Layer 0, SERRE-I;
consumed by PLAN-T5 node A4, projective cofinality). Let `R` be any ring (not necessarily
Noetherian), `p : X ⟶ Spec R` projective and of finite presentation, and `D` an ideal sheaf on `X`
of finite type (its ideal on every affine open is finitely generated). Then:

* `exists_fin_sameDegree_representation_of_fg`: for a closed immersion `j : X ⟶ ℙⁿ_R` of finite
  presentation, `D` is the pullback of the ideal sheaf of a homogeneous ideal generated by finitely
  many forms of one degree (Serre's description of quasi-coherent ideals on `Proj`,
  Hartshorne II.5.15; here via Codex's projective-ideal representation, which needs only the finite
  generation of the chart ideals of `j_* D`);
* `isProjectiveOver_blowupStructure_comp_of_fg` (**SERRE-I**): the blow-up `Bl_D X` is projective
  over `R`;
* `isRelativelyProjective_blowupStructure_comp_of_fg`: the relative form, for `X` projective
  relative to a separated base `T ⟶ Spec R`.

Over a Noetherian ring this is Codex's `Geometry.BlowupProjective.blowupStructure_comp_isProjective`;
the only use of Noetherianity there is the finite generation of the chart ideals
(`Geometry.ProjectiveIdeal.nativeCoordinateIdeal_fg`), which we replace by: the chart ideal of
`j_* D` is the preimage of the finitely generated ideal `D(X ∩ D₊(x_a))` under the surjection
`R[x/x_a] → Γ(X ∩ D₊(x_a))`, whose kernel is finitely generated because `j` is of finite
presentation.
-/

universe u

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace

namespace DeJongAlterations.StableModification.Projectivity

noncomputable section

open Geometry Geometry.ProjectiveIdeal Geometry.BlowupGluing Geometry.BlowupProjectiveEmbedding

attribute [local instance] MvPolynomial.gradedAlgebra

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

variable {R : Type u} [CommRing R] {X : Scheme.{u}} {n : ℕ}

/-- The preimage of a finitely generated ideal under a surjective ring map of finite presentation
is finitely generated. -/
theorem fg_comap_of_surjective_of_finitePresentation {A B : Type*} [CommRing A] [CommRing B]
    (f : A →+* B) (hf : Function.Surjective f) (hfp : f.FinitePresentation) {J : Ideal B}
    (hJ : J.FG) : (J.comap f).FG := by
  obtain ⟨S, hS⟩ := hJ
  choose g hg using fun b : B => hf b
  have hker : (RingHom.ker f).FG := by
    algebraize [f]
    exact Algebra.FinitePresentation.ker_fG_of_surjective (Algebra.ofId A B) hf
  have hmap : (Ideal.span (g '' (S : Set B))).map f = J := by
    rw [Ideal.map_span, ← hS, Set.image_image]
    simp [hg]
  have : J.comap f = Ideal.span (g '' (S : Set B)) ⊔ RingHom.ker f := by
    rw [← hmap, Ideal.comap_map_of_surjective _ hf, RingHom.ker_eq_comap_bot]
  rw [this]
  exact (Submodule.fg_span ((S.finite_toSet).image g)).sup hker

/-- The map on sections of a closed immersion `j` into `ℙⁿ_R` over a coordinate chart is of finite
presentation when `j ≫ (ℙⁿ_R → Spec R)` is of finite presentation. -/
theorem finitePresentation_app_coordinate (j : X ⟶ projectiveSpace R n) [IsClosedImmersion j]
    [LocallyOfFinitePresentation (j ≫ projectiveSpaceStructure R n)] (a : Fin (n + 1)) :
    (j.app (nativeCoordinateOpen (R := R) a)).hom.FinitePresentation := by
  set U : (projectiveSpace R n).Opens := nativeCoordinateOpen (R := R) a
  have hU : IsAffineOpen U := nativeCoordinateOpen_isAffine a
  have hV : IsAffineOpen (j ⁻¹ᵁ U) := hU.preimage j
  have h₁ := HasRingHomProperty.appLE @LocallyOfFinitePresentation
    (j ≫ projectiveSpaceStructure R n) inferInstance ⟨⊤, isAffineOpen_top _⟩ ⟨j ⁻¹ᵁ U, hV⟩
    le_top
  have h₂ := HasRingHomProperty.appLE @LocallyOfFiniteType (projectiveSpaceStructure R n)
    inferInstance ⟨⊤, isAffineOpen_top _⟩ ⟨U, hU⟩ le_top
  have hcomp : (projectiveSpaceStructure R n).appLE ⊤ U le_top ≫ j.appLE U (j ⁻¹ᵁ U) le_rfl =
      (j ≫ projectiveSpaceStructure R n).appLE ⊤ (j ⁻¹ᵁ U) le_top :=
    Scheme.Hom.appLE_comp_appLE _ _ _ _ _ _ _
  rw [← hcomp, CommRingCat.hom_comp] at h₁
  have := RingHom.FinitePresentation.of_comp_finiteType _ h₁ h₂
  rwa [Scheme.Hom.appLE_eq_app] at this

/-- The chart ideals of `j_* D` are finitely generated for an ideal sheaf `D` of finite type and a
closed immersion `j` of finite presentation. -/
theorem nativeCoordinateIdeal_map_fg (D : X.IdealSheafData) (j : X ⟶ projectiveSpace R n)
    [IsClosedImmersion j] [LocallyOfFinitePresentation (j ≫ projectiveSpaceStructure R n)]
    (hD : ∀ U : X.affineOpens, (D.ideal U).FG) (a : Fin (n + 1)) :
    (nativeCoordinateIdeal (D.map j) a).FG := by
  set U : (projectiveSpace R n).Opens := nativeCoordinateOpen (R := R) a
  have hU : IsAffineOpen U := nativeCoordinateOpen_isAffine a
  have hV : IsAffineOpen (j ⁻¹ᵁ U) := hU.preimage j
  have hmap := Scheme.IdealSheafData.ideal_map_of_isAffineHom D j ⟨U, hU⟩
  unfold nativeCoordinateIdeal
  change ((D.map j).ideal ⟨U, hU⟩).comap _ |>.FG
  rw [hmap, Ideal.comap_comap]
  refine fg_comap_of_surjective_of_finitePresentation _ ?_ ?_ (hD ⟨j ⁻¹ᵁ U, hV⟩)
  · exact (j.app_surjective U hU).comp
      (nativeCoordinateSectionsIso (R := R) a).commRingCatIsoToRingEquiv.surjective
  · exact (finitePresentation_app_coordinate j a).comp
      (RingHom.FinitePresentation.of_bijective
        (nativeCoordinateSectionsIso (R := R) a).commRingCatIsoToRingEquiv.bijective)

/-- **Representation of an ideal sheaf of finite type by forms of one degree**, over an arbitrary
ring, for a closed immersion of finite presentation into `ℙⁿ_R`. -/
theorem exists_fin_sameDegree_representation_of_fg (D : X.IdealSheafData)
    (j : X ⟶ projectiveSpace R n) [IsClosedImmersion j]
    [LocallyOfFinitePresentation (j ≫ projectiveSpaceStructure R n)]
    (hD : ∀ U : X.affineOpens, (D.ideal U).FG) :
    ∃ (m d : ℕ) (F : Fin (m + 1) → MvPolynomial (Fin (n + 1)) R)
      (J : HomogeneousIdeal (ProjectiveGrading R n)),
      (∀ a, (F a).IsHomogeneous d) ∧ Ideal.span (Set.range F) = J.toIdeal ∧
      (GradedQuotient.quotientIdealSheaf (ProjectiveGrading R n) J).comap j = D := by
  classical
  obtain ⟨J₀, s₀, hhom, hs₀, hD₀⟩ :=
    exists_finite_homogeneous_generators_comap_quotientIdealSheaf_eq_of_coordinate_fg D j
      (nativeCoordinateIdeal_map_fg D j hD)
  obtain ⟨d, s, J, hd, hs, heq⟩ := exists_sameDegree_homogeneous_ideal J₀ s₀ hhom hs₀
  have hDJ : (GradedQuotient.quotientIdealSheaf (ProjectiveGrading R n) J).comap j = D := by
    rw [heq]; exact hD₀
  let e := (Fintype.equivFin s).symm
  let g : Fin (Fintype.card s) → MvPolynomial (Fin (n + 1)) R := fun a => (e a).1
  have hg : Set.range g = (s : Set (MvPolynomial (Fin (n + 1)) R)) := by
    ext P
    constructor
    · rintro ⟨a, rfl⟩
      exact (e a).2
    · intro hP
      refine ⟨e.symm ⟨P, hP⟩, ?_⟩
      exact congrArg Subtype.val (e.apply_symm_apply ⟨P, hP⟩)
  refine ⟨Fintype.card s, d, Fin.cons 0 g, J, ?_, ?_, hDJ⟩
  · intro a
    refine Fin.cases (MvPolynomial.isHomogeneous_zero (Fin (n + 1)) R d) ?_ a
    intro b
    exact hd _ (e b).2
  · rw [Fin.range_cons, Ideal.span_insert_zero, hg]
    exact hs

/-- The blow-up of an ideal sheaf of finite type on a closed subscheme of finite presentation of
`ℙⁿ_R` is a closed subscheme of `X ×_R ℙᵐ_R` over `X`, for an arbitrary ring `R`. -/
theorem exists_closedProductEmbedding_of_fg (D : X.IdealSheafData)
    (p : X ⟶ Spec (CommRingCat.of R)) (j : X ⟶ projectiveSpace R n) [IsClosedImmersion j]
    (hjp : j ≫ projectiveSpaceStructure R n = p) [LocallyOfFinitePresentation p]
    (hD : ∀ U : X.affineOpens, (D.ideal U).FG) :
    ∃ (m : ℕ) (e : blowup D ⟶ pullback p (projectiveSpaceStructure R m)),
      IsClosedImmersion e ∧ e ≫ pullback.fst _ _ = blowupStructure D := by
  subst hjp
  obtain ⟨m, d, F, J, hF, hs, hDJ⟩ := exists_fin_sameDegree_representation_of_fg D j hD
  subst hDJ
  exact ⟨m, formsProductMap (j ≫ projectiveSpaceStructure R n) j J F hs hF, inferInstance,
    formsProductMap_fst _ j J F hs hF⟩

/-- **SERRE-I**: the blow-up of an ideal sheaf of finite type on a scheme projective and of finite
presentation over an arbitrary ring `R` is projective over `R` (blueprint `lem:sm-serre-ideal`). -/
theorem isProjectiveOver_blowupStructure_comp_of_fg (D : X.IdealSheafData)
    (p : X ⟶ Spec (CommRingCat.of R)) (hp : IsProjectiveOver p) [LocallyOfFinitePresentation p]
    (hD : ∀ U : X.affineOpens, (D.ideal U).FG) :
    IsProjectiveOver (blowupStructure D ≫ p) := by
  obtain ⟨n, j, hj, hjp⟩ := hp
  have := hj
  obtain ⟨m, e, he, hefst⟩ := exists_closedProductEmbedding_of_fg D p j hjp hD
  have := he
  subst hjp
  refine ⟨Algebra.Segre.dimension n m,
    e ≫ BlowupProjective.productClosedEmbedding j m ≫ Segre.segre R n m, inferInstance, ?_⟩
  simp only [Category.assoc, Segre.segre_structure,
    BlowupProjective.productClosedEmbedding_fst_assoc, reassoc_of% hefst]

/-- **SERRE-I, relative form**: if `f : X ⟶ T` is projective relative to a separated
`pT : T ⟶ Spec R` and `X` is projective and of finite presentation over `R`, then for an ideal
sheaf `D` of finite type on `X`, `Bl_D X ⟶ X ⟶ T` is projective relative to `pT`. -/
theorem isRelativelyProjective_blowupStructure_comp_of_fg {T : Scheme.{u}}
    (pT : T ⟶ Spec (CommRingCat.of R)) [IsSeparated pT] (f : X ⟶ T)
    (hX : IsProjectiveOver (f ≫ pT)) [LocallyOfFinitePresentation (f ≫ pT)]
    (D : X.IdealSheafData) (hD : ∀ U : X.affineOpens, (D.ideal U).FG) :
    DeJong.IsRelativelyProjective pT (blowupStructure D ≫ f) :=
  isRelativelyProjective_of_isProjectiveOver pT _ (by
    simpa [Category.assoc] using isProjectiveOver_blowupStructure_comp_of_fg D (f ≫ pT) hX hD)

end

end DeJongAlterations.StableModification.Projectivity
