import DeJongAlterations.StableModification.Perfection.LevelTransfer
import Mathlib.FieldTheory.SeparableClosure
import Mathlib.RingTheory.Jacobson.Ring

/-!
# Separable residue fields at the points over finitely many closed points

Blueprint chapter `sm-dj-perfection`, node `lem:sm-dj-perfection-separable-points` (ring form;
plan PL (5); new route, not in de Jong 1996).

We keep the model of `Perfection/Stabilization.lean`: `A ⊆ M` finitely generated over `K`,
`Ω ⊆ M` perfect, algebraic over `K` and linearly disjoint from `F = K(A)`; `E₀ ≤ Ω` and the finite
set `T` are as in `exists_finset_stabilization`.

* `exists_isSeparable_quotient` (**separable points**): for a finite set `S` of maximal ideals of
  `A` (closed points of `Spec A`) there is `E₂ ≤ Ω` finite over `K` such that for every
  `E₂ ≤ E ≤ Ω` and every maximal ideal `P` of `B_E ≅ ι(B_E)` over a point of `S`, the residue
  field `B_E/P` is separable over `E`. Ideals are taken in the isomorphic image
  `normalizationImage A E = ι(B_E) ⊆ M`.
* `exists_smooth_and_isSeparable_quotient`: smoothness of `B_E` and separable residue fields at
  once, for `A` of dimension at most one.

Proof of `exists_isSeparable_quotient`. For `p ∈ S` and `t ∈ T`, the class `t̄` of `t` in
`B_Ω / p B_Ω` is integral over `Ω` (the image of `A` is the residue field `A/p`, finite over `K` by
the Nullstellensatz), with minimal polynomial `μ_{p,t}`. For a prime `Q ⊇ p B_Ω`, the minimal
polynomial of the class of `t` in `B_Ω/Q` is a monic irreducible factor of `μ_{p,t}`, hence one of
the finitely many normalized factors, and it is separable because `Ω` is perfect. Let `E₂` contain
`E₀` and all coefficients of all these factors. Given `P` over `p`, choose `Q` over `P` (lying over,
`B_Ω` is integral over `B_E`); the factor for `Q` descends to a separable polynomial over `E`
killing the class of `t` in `B_E/P`. By level transfer `B_E/P` is generated by these classes.
-/

noncomputable section

open IntermediateField TensorProduct Polynomial

namespace DeJongAlterations.StableModification.Perfection

universe u

variable {K : Type u} {M : Type u} [Field K] [Field M] [Algebra K M] {A : Subalgebra K M}

/-- A root of a monic polynomial whose coefficients map to elements integral over `Ω` is integral
over `Ω`. -/
theorem isIntegral_of_eval₂_eq_zero {Ω S B : Type*} [CommRing Ω] [CommRing S] [Algebra Ω S]
    [CommRing B] (φ : B →+* S) (hφ : ∀ b, IsIntegral Ω (φ b)) {z : S} {f : B[X]}
    (hf : f.Monic) (hz : f.eval₂ φ z = 0) : IsIntegral Ω z := by
  let Sg := Algebra.adjoin Ω (Set.range φ)
  have : Algebra.IsIntegral Ω Sg := Algebra.IsIntegral.adjoin (by
    rintro _ ⟨b, rfl⟩
    exact hφ b)
  let ψ : B →+* Sg := φ.codRestrict Sg.toSubsemiring fun b => Algebra.subset_adjoin ⟨b, rfl⟩
  have hz' : IsIntegral Sg z := ⟨f.map ψ, hf.map _, by rw [Polynomial.eval₂_map]; exact hz⟩
  exact isIntegral_trans _ hz'

/-- For a maximal ideal `p` of `A`, the classes in `ι(B_Ω) / p ι(B_Ω)` are integral over `Ω`
(the image of `A` is the residue field `A/p`, finite over `K` by the Nullstellensatz). -/
theorem isIntegral_quotient_map [Algebra.FiniteType K A] (Ω : IntermediateField K M)
    [Algebra.IsAlgebraic K Ω] (p : Ideal A) [p.IsMaximal] (y : normalizationImage A Ω) :
    IsIntegral Ω (Ideal.Quotient.mk (p.map (toNormalizationImage A Ω)) y) := by
  have hΩ := forall_isIntegral_of_isAlgebraic Ω
  set I := p.map (toNormalizationImage A Ω)
  let φ := (Ideal.Quotient.mk I).comp (toNormalizationImage A Ω)
  let : Field (A ⧸ p) := Ideal.Quotient.field p
  have : Module.Finite K (A ⧸ p) := finite_of_finite_type_of_isJacobsonRing K (A ⧸ p)
  have hK : (algebraMap Ω (normalizationImage A Ω ⧸ I)).comp (algebraMap K Ω) =
      φ.comp (algebraMap K A) := by
    ext c
    simp only [RingHom.comp_apply, φ]
    rw [← Ideal.Quotient.mk_algebraMap]
    congr 1
  have hA : ∀ a : A, IsIntegral Ω (φ a) := by
    intro a
    obtain ⟨f, hf, hfa⟩ := Algebra.IsIntegral.isIntegral (R := K) (Ideal.Quotient.mk p a)
    have hmem : Polynomial.eval₂ (algebraMap K A) a f ∈ p := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, Polynomial.hom_eval₂]
      exact hfa
    refine ⟨f.map (algebraMap K Ω), hf.map _, ?_⟩
    rw [Polynomial.eval₂_map, hK, ← Polynomial.hom_eval₂]
    exact (Ideal.Quotient.eq_zero_iff_mem).2 (Ideal.mem_map_of_mem _ hmem)
  obtain ⟨f, hf, hfy⟩ := ((mem_range_normalizationι_iff hΩ).1 y.2).2
  refine isIntegral_of_eval₂_eq_zero (S := normalizationImage A Ω ⧸ I) φ hA hf ?_
  have h0 : Polynomial.eval₂ (toNormalizationImage A Ω) y f = 0 := by
    apply Subtype.val_injective
    change (normalizationImage A Ω).val.toRingHom
      (Polynomial.eval₂ (toNormalizationImage A Ω) y f) = 0
    rw [Polynomial.hom_eval₂]
    exact hfy
  rw [show φ = (Ideal.Quotient.mk I).comp (toNormalizationImage A Ω) from rfl,
    ← Polynomial.hom_eval₂, h0, map_zero]

variable (A)

/-- **Separable points (ring form).** Let `Ω` be perfect, algebraic over `K` and linearly disjoint
from `F = K(A)`, and `S` a finite set of maximal ideals of `A`. There is `E₂ ≤ Ω` finite over `K`
such that for every intermediate field `E₂ ≤ E ≤ Ω` and every maximal ideal `P` of
`B_E ≅ ι(B_E)` lying over a point of `S`, the residue field `B_E / P` is separable over `E`. -/
theorem exists_isSeparable_quotient (Ω : IntermediateField K M) [Algebra.IsAlgebraic K Ω]
    [PerfectField Ω] [Algebra.FiniteType K A] (hld : Ω.LinearDisjoint (fracField A))
    (S : Finset (Ideal A)) (hS : ∀ p ∈ S, p.IsMaximal) :
    ∃ E₂ : IntermediateField K M, E₂ ≤ Ω ∧ FiniteDimensional K E₂ ∧
      ∀ E : IntermediateField K M, E₂ ≤ E → E ≤ Ω →
        ∀ P : Ideal (normalizationImage A E), P.IsMaximal →
          P.comap (toNormalizationImage A E) ∈ S →
          Algebra.IsSeparable E (normalizationImage A E ⧸ P) := by
  classical
  have hΩ := forall_isIntegral_of_isAlgebraic Ω
  obtain ⟨E₀, hE₀Ω, hfin₀, T, hT, hgen⟩ := exists_finset_stabilization A Ω
  have hTΩ : ∀ t ∈ T, t ∈ baseField A Ω ∧ IsIntegral A t := fun t ht =>
    ⟨baseField_mono hE₀Ω (hT t ht).1, (hT t ht).2⟩
  let tΩ : M → normalizationImage A Ω := imageElem A Ω hΩ
  let μ : Ideal A → M → Polynomial Ω := fun p t =>
    minpoly Ω (Ideal.Quotient.mk (p.map (toNormalizationImage A Ω)) (tΩ t))
  let Cf : Finset Ω := S.biUnion fun p => T.biUnion fun t =>
    (UniqueFactorizationMonoid.normalizedFactors (μ p t)).toFinset.biUnion Polynomial.coeffs
  let E₂ := E₀ ⊔ IntermediateField.adjoin K ((Cf.image Ω.val : Finset M) : Set M)
  have hCfΩ : ((Cf.image Ω.val : Finset M) : Set M) ⊆ Ω := by
    intro x hx
    simp only [Finset.coe_image, Set.mem_image] at hx
    obtain ⟨c, -, rfl⟩ := hx
    exact c.2
  have hfinC : FiniteDimensional K (IntermediateField.adjoin K
      ((Cf.image Ω.val : Finset M) : Set M)) := by
    have : Finite ((Cf.image Ω.val : Finset M) : Set M) := (Finset.finite_toSet _).to_subtype
    exact IntermediateField.finiteDimensional_adjoin fun x hx => hΩ x (hCfΩ hx)
  refine ⟨E₂, sup_le hE₀Ω (IntermediateField.adjoin_le_iff.2 hCfΩ), inferInstance, ?_⟩
  intro E hE₂ hEΩ P hP hPS
  have hE₀ : E₀ ≤ E := le_sup_left.trans hE₂
  have hE : ∀ x ∈ E, IsIntegral K x := fun x hx => hΩ x (hEΩ hx)
  let : Algebra E Ω := (IntermediateField.inclusion hEΩ).toAlgebra
  have : IsScalarTower E Ω M := IsScalarTower.of_algebraMap_eq fun _ => rfl
  set p := P.comap (toNormalizationImage A E) with hp
  have hpmax : p.IsMaximal := hS p hPS
  -- lying over: a prime `Q` of `ι(B_Ω)` over `P`
  let j := imageInclusion (A := A) hEΩ hΩ
  let : Algebra (normalizationImage A E) (normalizationImage A Ω) := j.toAlgebra
  have hint : Algebra.IsIntegral (normalizationImage A E) (normalizationImage A Ω) := by
    refine ⟨fun y => ?_⟩
    obtain ⟨f, hf, hfy⟩ := ((mem_range_normalizationι_iff hΩ).1 y.2).2
    refine ⟨f.map (toNormalizationImage A E), hf.map _, ?_⟩
    apply Subtype.val_injective
    rw [Polynomial.eval₂_map]
    change (normalizationImage A Ω).val.toRingHom
      (Polynomial.eval₂ (j.comp (toNormalizationImage A E)) y f) = 0
    rw [Polynomial.hom_eval₂]
    exact hfy
  have hj : Function.Injective j := fun a b h => by
    have := congrArg (fun z : normalizationImage A Ω => (z : M)) h
    simp only [j, coe_imageInclusion] at this
    exact Subtype.ext this
  obtain ⟨Q, -, hQprime, hQP⟩ := Ideal.exists_ideal_over_prime_of_isIntegral P
    (⊥ : Ideal (normalizationImage A Ω))
    (Ideal.comap_bot_le_of_injective (algebraMap (normalizationImage A E)
      (normalizationImage A Ω)) hj)
  have hQmax : Q.IsMaximal :=
    Ideal.isMaximal_of_isIntegral_of_isMaximal_comap Q (hQP ▸ hP)
  have hQp : (p.map (toNormalizationImage A Ω)) ≤ Q := by
    rw [Ideal.map_le_iff_le_comap, ← imageInclusion_comp_toNormalizationImage hEΩ hΩ,
      ← Ideal.comap_comap]
    change p ≤ (Q.comap (algebraMap (normalizationImage A E) (normalizationImage A Ω))).comap _
    rw [hQP]
  -- every generator class is separable over `E`
  let tE : M → normalizationImage A E := imageElem A E hE
  have htE : ∀ t ∈ T, t ∈ baseField A E ∧ IsIntegral A t := fun t ht =>
    ⟨baseField_mono hE₀ (hT t ht).1, (hT t ht).2⟩
  let : Field (normalizationImage A E ⧸ P) := Ideal.Quotient.field P
  have hsep : ∀ t ∈ T, IsSeparable E (Ideal.Quotient.mk P (tE t)) := by
    intro t ht
    let θ := Ideal.Quotient.mk Q (tΩ t)
    have hint₀ := isIntegral_quotient_map Ω p (tΩ t)
    have hμ0 : μ p t ≠ 0 := minpoly.ne_zero hint₀
    have hθμ : Polynomial.aeval θ (μ p t) = 0 := by
      have h1 := minpoly.aeval Ω (Ideal.Quotient.mk (p.map (toNormalizationImage A Ω)) (tΩ t))
      rw [← Ideal.Quotient.mkₐ_eq_mk Ω, Polynomial.aeval_algHom_apply,
        Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem] at h1
      change Polynomial.aeval (Ideal.Quotient.mkₐ Ω Q (tΩ t)) (μ p t) = 0
      rw [Polynomial.aeval_algHom_apply, Ideal.Quotient.mkₐ_eq_mk,
        Ideal.Quotient.eq_zero_iff_mem]
      exact hQp h1
    have hθint : IsIntegral Ω θ := ⟨μ p t, minpoly.monic hint₀, by
      rwa [← Polynomial.aeval_def]⟩
    let g := minpoly Ω θ
    have hgirr : Irreducible g := minpoly.irreducible hθint
    have hgdvd : g ∣ μ p t := minpoly.dvd Ω θ hθμ
    obtain ⟨f, hf, hgf⟩ :=
      UniqueFactorizationMonoid.exists_mem_normalizedFactors_of_dvd hμ0 hgirr hgdvd
    have hfmonic : f.Monic := by
      have hf0 : f ≠ 0 :=
        (UniqueFactorizationMonoid.irreducible_of_normalized_factor f hf).ne_zero
      rw [← UniqueFactorizationMonoid.normalize_normalized_factor f hf]
      exact Polynomial.monic_normalize hf0
    have hgf' : g = f :=
      Polynomial.eq_of_monic_of_associated (minpoly.monic hθint) hfmonic hgf
    have hcoeffE : ∀ n, ((g.coeff n : Ω) : M) ∈ E := by
      intro n
      by_cases hn : g.coeff n = 0
      · rw [hn]; exact zero_mem _
      · refine hE₂ (le_sup_right (a := E₀) (IntermediateField.subset_adjoin K _ ?_))
        simp only [Finset.coe_image, Set.mem_image, Finset.mem_coe]
        refine ⟨g.coeff n, ?_, rfl⟩
        simp only [Cf, Finset.mem_biUnion, Multiset.mem_toFinset]
        exact ⟨p, hPS, t, ht, f, hf, hgf' ▸ Polynomial.coeff_mem_coeffs hn⟩
    have hlifts : g ∈ Polynomial.lifts (algebraMap E Ω) := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro n
      exact ⟨⟨_, hcoeffE n⟩, rfl⟩
    obtain ⟨h, hmap, -, hmonic⟩ :=
      Polynomial.lifts_and_degree_eq_and_monic hlifts (minpoly.monic hθint)
    have hgsep : g.Separable := PerfectField.separable_of_irreducible hgirr
    have hhsep : h.Separable := by
      rw [← Polynomial.separable_map (algebraMap E Ω), hmap]
      exact hgsep
    have hmemQ : Polynomial.aeval (tΩ t) g ∈ Q := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, ← Ideal.Quotient.mkₐ_eq_mk Ω,
        ← Polynomial.aeval_algHom_apply, Ideal.Quotient.mkₐ_eq_mk]
      exact minpoly.aeval Ω θ
    have hjh : j (Polynomial.aeval (tE t) h) = Polynomial.aeval (tΩ t) g := by
      apply Subtype.val_injective
      rw [coe_imageInclusion, Polynomial.aeval_subalgebra_coe, Polynomial.aeval_subalgebra_coe,
        coe_imageElem E hE (htE t ht), coe_imageElem Ω hΩ (hTΩ t ht), ← hmap,
        Polynomial.aeval_map_algebraMap]
    have hmemP : Polynomial.aeval (tE t) h ∈ P := by
      rw [← hQP, Ideal.mem_comap, RingHom.algebraMap_toAlgebra j, hjh]
      exact hmemQ
    have haeval : Polynomial.aeval (Ideal.Quotient.mk P (tE t)) h = 0 := by
      rw [← Ideal.Quotient.mkₐ_eq_mk E, Polynomial.aeval_algHom_apply, Ideal.Quotient.mkₐ_eq_mk,
        Ideal.Quotient.eq_zero_iff_mem]
      exact hmemP
    exact hhsep.of_dvd (minpoly.dvd E _ haeval)
  -- `ι(B_E) / P` is generated by these classes, hence separable
  have hgenE := range_normalizationι_subset_adjoin Ω hld hT hgen E hE₀ hEΩ
  refine ⟨fun y => ?_⟩
  obtain ⟨n, rfl⟩ := Ideal.Quotient.mk_surjective y
  have hn : (n : M) ∈ Algebra.adjoin E (T : Set M) := hgenE n.2
  have hT' : (T : Set M) = (normalizationImage A E).val '' (tE '' (T : Set M)) := by
    ext t
    constructor
    · intro ht
      exact ⟨tE t, ⟨t, ht, rfl⟩, coe_imageElem E hE (htE t ht)⟩
    · rintro ⟨_, ⟨s, hs, rfl⟩, rfl⟩
      change (tE s : M) ∈ (T : Set M)
      rw [coe_imageElem E hE (htE s hs)]
      exact hs
  rw [hT', Algebra.adjoin_image] at hn
  obtain ⟨n', hn', hnn'⟩ := Subalgebra.mem_map.1 hn
  obtain rfl := Subtype.val_injective hnn'
  have hle : Algebra.adjoin E (tE '' (T : Set M)) ≤
      (separableClosure E (normalizationImage A E ⧸ P)).toSubalgebra.comap
        (Ideal.Quotient.mkₐ E P) := by
    refine Algebra.adjoin_le ?_
    rintro _ ⟨t, ht, rfl⟩
    rw [SetLike.mem_coe, Subalgebra.mem_comap, IntermediateField.mem_toSubalgebra,
      mem_separableClosure_iff, Ideal.Quotient.mkₐ_eq_mk]
    exact hsep t ht
  have := hle hn'
  rw [Subalgebra.mem_comap, IntermediateField.mem_toSubalgebra, mem_separableClosure_iff,
    Ideal.Quotient.mkₐ_eq_mk] at this
  exact this

/-- **Smooth curve with separable marked points.** Combining `exists_smooth_normalization` and
`exists_isSeparable_quotient`: if moreover `A` has dimension at most one, there is `E ≤ Ω` finite
over `K` such that for every intermediate field `E ≤ E' ≤ Ω` the normalization `B_{E'}` of
`E' ⊗_K A` is smooth over `E'` and its residue fields at the maximal ideals over `S` are separable
over `E'`. -/
theorem exists_smooth_and_isSeparable_quotient (Ω : IntermediateField K M)
    [Algebra.IsAlgebraic K Ω] [PerfectField Ω] [Algebra.FiniteType K A] [Ring.DimensionLEOne A]
    (hld : Ω.LinearDisjoint (fracField A)) (S : Finset (Ideal A)) (hS : ∀ p ∈ S, p.IsMaximal) :
    ∃ E : IntermediateField K M, E ≤ Ω ∧ FiniteDimensional K E ∧
      ∀ E' : IntermediateField K M, E ≤ E' → E' ≤ Ω →
        Algebra.Smooth E' (normalization A E') ∧
        ∀ P : Ideal (normalizationImage A E'), P.IsMaximal →
          P.comap (toNormalizationImage A E') ∈ S →
          Algebra.IsSeparable E' (normalizationImage A E' ⧸ P) := by
  obtain ⟨E₀, hE₀Ω, hfin₀, h₀⟩ := exists_smooth_normalization A Ω hld
  obtain ⟨E₂, hE₂Ω, hfin₂, h₂⟩ := exists_isSeparable_quotient A Ω hld S hS
  refine ⟨E₀ ⊔ E₂, sup_le hE₀Ω hE₂Ω, inferInstance, fun E' hE' hE'Ω => ⟨?_, ?_⟩⟩
  · exact (h₀ E' (le_sup_left.trans hE') hE'Ω).1
  · exact h₂ E' (le_sup_right.trans hE') hE'Ω

end DeJongAlterations.StableModification.Perfection

end
