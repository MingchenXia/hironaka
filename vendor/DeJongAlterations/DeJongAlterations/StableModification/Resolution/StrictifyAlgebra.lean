import DeJongAlterations.Algebra.CompletionIntersectionRegularityHeight
import DeJongAlterations.Geometry.SNCSubdivisorProducts
import Mathlib.RingTheory.Derivation.Basic

/-!
# Commutative algebra for the strictification of normal crossings divisors

This file contains the ring-theoretic steps of the strictification of a normal crossings
divisor by blowups along its multiplicity strata (de Jong 1996, 2.4,
`references/dejong96-alterations/tex/page-0006.tex`: "first blow up the points where `D` has
three branches, then blow up the strict transform of the curves on `S` where `D` has two
branches, etc."), which are used at the completed local rings of closed points.

Let `t_1, …, t_n` be elements of a commutative ring `R` and `T ⊆ {1, …, n}`.

* `layerIdeal t T r` is the ideal generated by the products `∏_{i ∈ U} t_i` over the subsets
  `U ⊆ T` with `r` elements. For `t` a part of a regular system of parameters it is the ideal of
  the locus where at least `|T| - r + 1` of the hyperplanes `t_i = 0`, `i ∈ T`, meet; thus
  `layerIdeal t T |T| = (∏_{i ∈ T} t_i)` is the divisor and `layerIdeal t T 1 = (t_i : i ∈ T)` its
  deepest stratum.
* `deltaIdeal 𝒟 J = J + (D f : D ∈ 𝒟, f ∈ J)` for a set `𝒟` of derivations.

## Main results

* `deltaIdeal_layerIdeal`: if the `R`-span of `𝒟` contains, for every `i ∈ T`, a derivation `E`
  with `E(t_l) = δ_{il}` for `l ∈ T`, then `deltaIdeal 𝒟 (layerIdeal t T (r + 1)) =
  layerIdeal t T r` for `r < |T|`; iterating (`deltaIdeal_iterate_span_prod`), the
  `j`-fold iterate of `deltaIdeal 𝒟` on `(∏_{i ∈ T} t_i)` is `layerIdeal t T (|T| - j)`.
  This is how the multiplicity strata of a normal crossings divisor are cut out by
  derivatives of its equation.
* `deltaIdeal_map`: `deltaIdeal` commutes with extension of ideals along a ring map to which
  the derivations extend.
* `map_radical_eq_of_isRadical`: if `J S` is radical then `(√J) S = J S`.
* `exists_span_singleton_eq_of_map_eq_span_singleton`: along a local homomorphism to a local
  domain which is injective on ideals (e.g. a completion), an ideal whose extension is principal
  is principal, generated by an element with the same extension.
* For a part `t` of a regular system of parameters of a regular local ring:
  `prime_param` (each `t_i` is prime), `param_not_dvd` (distinct `t_i` are non-associate),
  `span_prod_param_eq_inf` (`(∏_{i ∈ T} t_i) = ⋂_{i ∈ T} (t_i)`) and `span_prod_param_isRadical`.
-/

noncomputable section

open IsLocalRing

namespace DeJongAlterations.StableModification.Resolution.Strictify

open Algebra.CompletionIntersectionRegularityHeight

section Layers

variable {R ι : Type*} [CommRing R] (t : ι → R)

/-- The ideal generated by the products of `r` distinct members `t_i`, `i ∈ T`. -/
def layerIdeal (T : Finset ι) (r : ℕ) : Ideal R :=
  Ideal.span ((fun U : Finset ι ↦ ∏ i ∈ U, t i) '' {U | U ⊆ T ∧ U.card = r})

theorem prod_mem_layerIdeal {T U : Finset ι} (hU : U ⊆ T) :
    ∏ i ∈ U, t i ∈ layerIdeal t T U.card :=
  Ideal.subset_span ⟨U, ⟨hU, rfl⟩, rfl⟩

@[simp]
theorem layerIdeal_zero (T : Finset ι) : layerIdeal t T 0 = ⊤ := by
  rw [Ideal.eq_top_iff_one]
  simpa using prod_mem_layerIdeal t (Finset.empty_subset T)

theorem layerIdeal_card (T : Finset ι) : layerIdeal t T T.card = Ideal.span {∏ i ∈ T, t i} := by
  rw [layerIdeal]
  congr 1
  ext y
  simp only [Set.mem_image, Set.mem_ofPred_eq, Set.mem_singleton_iff]
  constructor
  · rintro ⟨U, ⟨hU, hc⟩, rfl⟩
    rw [Finset.eq_of_subset_of_card_le hU hc.ge]
  · rintro rfl
    exact ⟨T, ⟨subset_rfl, rfl⟩, rfl⟩

theorem layerIdeal_one (T : Finset ι) : layerIdeal t T 1 = Ideal.span (t '' (T : Set ι)) := by
  rw [layerIdeal]
  congr 1
  ext y
  simp only [Set.mem_image, Set.mem_ofPred_eq, Finset.mem_coe]
  constructor
  · rintro ⟨U, ⟨hU, hc⟩, rfl⟩
    obtain ⟨i, rfl⟩ := Finset.card_eq_one.mp hc
    exact ⟨i, hU (Finset.mem_singleton_self i), by simp⟩
  · rintro ⟨i, hi, rfl⟩
    exact ⟨{i}, ⟨Finset.singleton_subset_iff.mpr hi, Finset.card_singleton i⟩, by simp⟩

theorem layerIdeal_succ_le (T : Finset ι) (r : ℕ) : layerIdeal t T (r + 1) ≤ layerIdeal t T r := by
  classical
  rw [layerIdeal, Ideal.span_le]
  rintro _ ⟨U, ⟨hU, hc⟩, rfl⟩
  dsimp only
  obtain ⟨i, hi⟩ : U.Nonempty := Finset.card_pos.mp (by omega)
  rw [← Finset.mul_prod_erase U t hi]
  apply Ideal.mul_mem_left
  have hcard : (U.erase i).card = r := by rw [Finset.card_erase_of_mem hi]; omega
  rw [← hcard]
  exact prod_mem_layerIdeal t ((Finset.erase_subset i U).trans hU)

end Layers

section Delta

variable {K R : Type*} [CommRing K] [CommRing R] [Algebra K R]

/-- `deltaIdeal 𝒟 J = J + (D f : D ∈ 𝒟, f ∈ J)`. -/
def deltaIdeal (𝒟 : Set (Derivation K R R)) (J : Ideal R) : Ideal R :=
  J ⊔ Ideal.span {y | ∃ D ∈ 𝒟, ∃ f ∈ J, D f = y}

variable (𝒟 : Set (Derivation K R R))

theorem le_deltaIdeal (J : Ideal R) : J ≤ deltaIdeal 𝒟 J := le_sup_left

theorem derivation_mem_deltaIdeal {J : Ideal R} {D : Derivation K R R} (hD : D ∈ 𝒟) {f : R}
    (hf : f ∈ J) : D f ∈ deltaIdeal 𝒟 J :=
  Ideal.mem_sup_right (Ideal.subset_span ⟨D, hD, f, hf, rfl⟩)

@[simp]
theorem deltaIdeal_top : deltaIdeal 𝒟 (⊤ : Ideal R) = ⊤ := top_unique le_sup_left

/-- `deltaIdeal` of an ideal is computed on generators. -/
theorem deltaIdeal_span (s : Set R) :
    deltaIdeal 𝒟 (Ideal.span s) = Ideal.span s ⊔ Ideal.span {y | ∃ D ∈ 𝒟, ∃ f ∈ s, D f = y} := by
  apply le_antisymm
  · apply sup_le le_sup_left
    rw [Ideal.span_le]
    rintro _ ⟨D, hD, f, hf, rfl⟩
    induction hf using Submodule.span_induction with
    | mem f hf => exact Ideal.mem_sup_right (Ideal.subset_span ⟨D, hD, f, hf, rfl⟩)
    | zero => simp
    | add f g _ _ hf hg => rw [map_add]; exact Ideal.add_mem _ hf hg
    | smul a f hf ih =>
      rw [smul_eq_mul, Derivation.leibniz, smul_eq_mul, smul_eq_mul]
      exact Ideal.add_mem _ (Ideal.mul_mem_left _ a ih)
        (Ideal.mem_sup_left (Ideal.mul_mem_right _ _ hf))
  · apply sup_le (le_deltaIdeal 𝒟 _)
    rw [Ideal.span_le]
    rintro _ ⟨D, hD, f, hf, rfl⟩
    exact derivation_mem_deltaIdeal 𝒟 hD (Ideal.subset_span hf)

/-- The Leibniz rule for a finite product. -/
theorem derivation_prod_eq_sum {ι : Type*} [DecidableEq ι] (t : ι → R) (D : Derivation K R R)
    (U : Finset ι) : D (∏ i ∈ U, t i) = ∑ l ∈ U, (∏ i ∈ U.erase l, t i) * D (t l) := by
  induction U using Finset.induction_on with
  | empty => simp
  | @insert i U hi ih =>
    rw [Finset.prod_insert hi, Derivation.leibniz, smul_eq_mul, smul_eq_mul, ih,
      Finset.sum_insert hi, Finset.erase_insert hi, Finset.mul_sum, add_comm]
    congr 1
    refine Finset.sum_congr rfl fun l hl ↦ ?_
    have hli : l ≠ i := fun h ↦ hi (h ▸ hl)
    rw [Finset.erase_insert_of_ne hli.symm, Finset.prod_insert (fun h ↦ hi (Finset.mem_of_mem_erase h))]
    ring

/-- A derivation lowers the layer of a product of members of `t`. -/
theorem derivation_prod_mem_layerIdeal {ι : Type*} [DecidableEq ι] (t : ι → R)
    (D : Derivation K R R) (T : Finset ι) {U : Finset ι} (hU : U ⊆ T) {r : ℕ}
    (hc : U.card = r + 1) : D (∏ i ∈ U, t i) ∈ layerIdeal t T r := by
  rw [derivation_prod_eq_sum t D U]
  refine Ideal.sum_mem _ fun l hl ↦ Ideal.mul_mem_right _ _ ?_
  have hcard : (U.erase l).card = r := by rw [Finset.card_erase_of_mem hl]; omega
  rw [← hcard]
  exact prod_mem_layerIdeal t ((Finset.erase_subset l U).trans hU)

/-- Every derivation maps the `(r + 1)`-st layer into the `r`-th layer. -/
theorem derivation_mem_layerIdeal {ι : Type*} (t : ι → R) (D : Derivation K R R)
    (T : Finset ι) (r : ℕ) {f : R} (hf : f ∈ layerIdeal t T (r + 1)) :
    D f ∈ layerIdeal t T r := by
  classical
  induction hf using Submodule.span_induction with
  | mem f hf =>
    obtain ⟨U, ⟨hU, hc⟩, rfl⟩ := hf
    exact derivation_prod_mem_layerIdeal t D T hU hc
  | zero => simp
  | add f g _ _ hf hg => rw [map_add]; exact Ideal.add_mem _ hf hg
  | smul a f hf ih =>
    rw [smul_eq_mul, Derivation.leibniz, smul_eq_mul, smul_eq_mul]
    exact Ideal.add_mem _ (Ideal.mul_mem_left _ a ih)
      (Ideal.mul_mem_right _ _ (layerIdeal_succ_le t T r hf))

/-- A derivation killing all factors kills the product. -/
theorem derivation_prod_eq_zero {ι : Type*} [DecidableEq ι] (t : ι → R) (E : Derivation K R R)
    (U : Finset ι) (hE : ∀ l ∈ U, E (t l) = 0) : E (∏ i ∈ U, t i) = 0 := by
  rw [derivation_prod_eq_sum t E U]
  exact Finset.sum_eq_zero fun l hl ↦ by rw [hE l hl, mul_zero]

/-- Members of the `R`-span of `𝒟` take values in the ideal generated by the values of `𝒟`. -/
theorem span_apply_mem {E : Derivation K R R} (hE : E ∈ Submodule.span R 𝒟) (f : R) :
    E f ∈ Ideal.span {y | ∃ D ∈ 𝒟, D f = y} := by
  induction hE using Submodule.span_induction with
  | mem D hD => exact Ideal.subset_span ⟨D, hD, rfl⟩
  | zero => simp
  | add D D' _ _ h h' => rw [Derivation.add_apply]; exact Ideal.add_mem _ h h'
  | smul a D _ h => rw [Derivation.smul_apply, smul_eq_mul]; exact Ideal.mul_mem_left _ a h

/-- The hypothesis of `deltaIdeal_layerIdeal`: the `R`-span of `𝒟` contains a derivation dual to
each `t_i`, `i ∈ T`. -/
def HasDualDerivations {ι : Type*} [DecidableEq ι] (t : ι → R) (T : Finset ι) : Prop :=
  ∀ i ∈ T, ∃ E ∈ Submodule.span R 𝒟, ∀ l ∈ T, E (t l) = if l = i then 1 else 0

/-- **Derivatives cut out the next multiplicity stratum.** -/
theorem deltaIdeal_layerIdeal {ι : Type*} [DecidableEq ι] (t : ι → R) (T : Finset ι)
    (hE : HasDualDerivations 𝒟 t T) (r : ℕ) (hr : r < T.card) :
    deltaIdeal 𝒟 (layerIdeal t T (r + 1)) = layerIdeal t T r := by
  apply le_antisymm
  · apply sup_le (layerIdeal_succ_le t T r)
    rw [Ideal.span_le]
    rintro _ ⟨D, -, f, hf, rfl⟩
    exact derivation_mem_layerIdeal t D T r hf
  · rw [layerIdeal, Ideal.span_le]
    rintro _ ⟨U', ⟨hU', hc⟩, rfl⟩
    dsimp only
    obtain ⟨i, hiT, hiU'⟩ : ∃ i ∈ T, i ∉ U' := by
      by_contra h
      push Not at h
      have := Finset.card_le_card (show T ⊆ U' from h)
      omega
    obtain ⟨E, hEspan, hEval⟩ := hE i hiT
    have hU : insert i U' ⊆ T := Finset.insert_subset hiT hU'
    have hcard : (insert i U').card = r + 1 := by
      rw [Finset.card_insert_of_notMem hiU', hc]
    have hval : E (∏ l ∈ insert i U', t l) = ∏ l ∈ U', t l := by
      rw [Finset.prod_insert hiU', Derivation.leibniz, smul_eq_mul, smul_eq_mul,
        derivation_prod_eq_zero t E U' (fun l hl ↦ by
          rw [hEval l (hU' hl), if_neg (fun (h : l = i) ↦ hiU' (h ▸ hl))]),
        hEval i hiT, if_pos rfl]
      ring
    rw [← hval]
    have hmem : ∏ l ∈ insert i U', t l ∈ layerIdeal t T (r + 1) := by
      rw [← hcard]
      exact prod_mem_layerIdeal t hU
    refine Ideal.mem_sup_right ?_
    refine (Ideal.span_mono ?_) (span_apply_mem 𝒟 hEspan _)
    rintro _ ⟨D, hD, rfl⟩
    exact ⟨D, hD, _, hmem, rfl⟩

/-- **Iterated derivatives of a product of parameters.** -/
theorem deltaIdeal_iterate_span_prod {ι : Type*} [DecidableEq ι] (t : ι → R) (T : Finset ι)
    (hE : HasDualDerivations 𝒟 t T) (j : ℕ) :
    (deltaIdeal 𝒟)^[j] (Ideal.span {∏ i ∈ T, t i}) = layerIdeal t T (T.card - j) := by
  induction j with
  | zero => rw [Function.iterate_zero, id, Nat.sub_zero, layerIdeal_card]
  | succ j ih =>
    rw [Function.iterate_succ_apply', ih]
    rcases Nat.lt_or_ge j T.card with h | h
    · have : T.card - j = (T.card - (j + 1)) + 1 := by omega
      rw [this, deltaIdeal_layerIdeal 𝒟 t T hE _ (by omega)]
    · rw [Nat.sub_eq_zero_of_le h, Nat.sub_eq_zero_of_le (by omega), layerIdeal_zero,
        deltaIdeal_top]

/-- `deltaIdeal` commutes with extension along a ring map to which the derivations extend. -/
theorem deltaIdeal_map {A : Type*} [CommRing A] [Algebra K A] (τ : A →+* R)
    (𝒟A : Set (Derivation K A A)) (ext : Derivation K A A → Derivation K R R)
    (hext : ∀ D a, ext D (τ a) = τ (D a)) (J : Ideal A) :
    (deltaIdeal 𝒟A J).map τ = deltaIdeal (ext '' 𝒟A) (J.map τ) := by
  rw [deltaIdeal, Ideal.map_sup, Ideal.map_span, Ideal.map, deltaIdeal_span]
  congr 1
  congr 1
  ext y
  simp only [Set.mem_image, Set.mem_ofPred_eq, SetLike.mem_coe]
  constructor
  · rintro ⟨_, ⟨D, hD, f, hf, rfl⟩, rfl⟩
    exact ⟨ext D, ⟨D, hD, rfl⟩, τ f, ⟨f, hf, rfl⟩, hext D f⟩
  · rintro ⟨_, ⟨D, hD, rfl⟩, _, ⟨f, hf, rfl⟩, rfl⟩
    exact ⟨D f, ⟨D, hD, f, hf, rfl⟩, (hext D f).symm⟩

/-- Iterated version of `deltaIdeal_map`. -/
theorem deltaIdeal_iterate_map {A : Type*} [CommRing A] [Algebra K A] (τ : A →+* R)
    (𝒟A : Set (Derivation K A A)) (ext : Derivation K A A → Derivation K R R)
    (hext : ∀ D a, ext D (τ a) = τ (D a)) (j : ℕ) (J : Ideal A) :
    ((deltaIdeal 𝒟A)^[j] J).map τ = (deltaIdeal (ext '' 𝒟A))^[j] (J.map τ) := by
  induction j with
  | zero => rfl
  | succ j ih =>
    rw [Function.iterate_succ_apply', Function.iterate_succ_apply', deltaIdeal_map τ 𝒟A ext hext,
      ih]

end Delta

section Radical

variable {R S : Type*} [CommRing R] [CommRing S]

/-- If the extension of `J` is radical, then the radical of `J` has the same extension. -/
theorem map_radical_eq_of_isRadical (φ : R →+* S) (J : Ideal R) (h : (J.map φ).IsRadical) :
    J.radical.map φ = J.map φ :=
  le_antisymm (le_trans (Ideal.map_radical_le φ) h.radical.le) (Ideal.map_mono Ideal.le_radical)

end Radical

section Principal

variable {O R : Type*} [CommRing O] [CommRing R] [IsLocalRing R] [IsDomain R]

/-- Along a ring map `φ` to a local domain with `(J R) ∩ O = J` for all ideals, an ideal `J`
with principal extension `(f)` is principal, generated by an element `g ∈ J` with `(φ g) = (f)`. -/
theorem exists_span_singleton_eq_of_map_eq_span_singleton (φ : O →+* R)
    (hφ : ∀ J : Ideal O, (J.map φ).comap φ = J) (J : Ideal O) (f : R)
    (hJ : J.map φ = Ideal.span {f}) :
    ∃ g ∈ J, J = Ideal.span {g} ∧ Ideal.span {φ g} = Ideal.span {f} := by
  classical
  by_cases hf : f = 0
  · refine ⟨0, J.zero_mem, ?_, by simp [hf]⟩
    have hbot : J.map φ = ⊥ := by rw [hJ, hf, Ideal.span_singleton_eq_bot.mpr rfl]
    rw [← hφ J, hbot, Ideal.span_singleton_eq_bot.mpr rfl]
    simpa using hφ ⊥
  have hfmem : f ∈ J.map φ := hJ ▸ Ideal.mem_span_singleton_self f
  rw [Ideal.map, Submodule.mem_span_iff_exists_finset_subset] at hfmem
  obtain ⟨c, s, hs, -, hsum⟩ := hfmem
  have hdvd : ∀ y ∈ s, ∃ e : R, y = f * e := by
    intro y hy
    obtain ⟨g, hg, rfl⟩ := hs hy
    have : φ g ∈ Ideal.span {f} := hJ ▸ Ideal.mem_map_of_mem φ hg
    obtain ⟨e, he⟩ := Ideal.mem_span_singleton'.mp this
    exact ⟨e, by rw [← he, mul_comm]⟩
  choose! e he using hdvd
  have hone : ∑ y ∈ s, c y * e y = 1 := by
    apply mul_left_cancel₀ hf
    rw [mul_one, Finset.mul_sum]
    conv_rhs => rw [← hsum]
    refine Finset.sum_congr rfl fun y hy ↦ ?_
    rw [smul_eq_mul]
    calc f * (c y * e y) = c y * (f * e y) := by ring
      _ = c y * y := by rw [← he y hy]
  obtain ⟨y, hy, hunit⟩ : ∃ y ∈ s, IsUnit (e y) := by
    by_contra h
    push Not at h
    apply (IsLocalRing.maximalIdeal.isMaximal R).ne_top
    rw [Ideal.eq_top_iff_one, ← hone]
    exact Ideal.sum_mem _ fun y hy ↦ Ideal.mul_mem_left _ _
      ((IsLocalRing.mem_maximalIdeal _).mpr (h y hy))
  obtain ⟨g, hg, rfl⟩ := hs hy
  have hspan : Ideal.span {φ g} = Ideal.span {f} := by
    rw [he _ hy, Ideal.span_singleton_mul_right_unit hunit]
  refine ⟨g, hg, ?_, hspan⟩
  rw [← hφ J, ← hφ (Ideal.span {g}), Ideal.map_span, Set.image_singleton, hspan, hJ]

end Principal

section Parameters

variable {R ι : Type*} [CommRing R] [IsRegularLocalRing R]
  (t : ι → maximalIdeal R)
  (hli : LinearIndependent (ResidueField R) (fun i ↦ (maximalIdeal R).toCotangent (t i)))
include hli

omit hli in
theorem span_param_eq_parameterIdeal (i : ι) :
    Ideal.span {(t i : R)} = parameterIdeal t {i} := by
  simp [parameterIdeal]

/-- A member of a regular system of parameters is a prime element. -/
theorem prime_param (i : ι) : Prime (t i : R) := by
  have hp : (Ideal.span {(t i : R)}).IsPrime := by
    rw [span_param_eq_parameterIdeal t]
    exact parameterIdeal_isPrime t hli {i}
  have hne : (t i : R) ≠ 0 := by
    intro h0
    apply not_mem_parameterIdeal t hli ∅ i (Finset.notMem_empty i)
    simp [parameterIdeal, h0]
  exact (Ideal.span_singleton_prime hne).mp hp

/-- Distinct members of a regular system of parameters are not associate. -/
theorem param_not_dvd {i j : ι} (hij : i ≠ j) : ¬ (t i : R) ∣ t j := by
  intro h
  apply not_mem_parameterIdeal t hli {i} j (by simpa using hij.symm)
  rw [← span_param_eq_parameterIdeal t]
  exact Ideal.mem_span_singleton.mpr h

/-- The product of distinct parameters generates the intersection of the principal ideals. -/
theorem span_prod_param_eq_inf (T : Finset ι) :
    Ideal.span {∏ i ∈ T, (t i : R)} = T.inf fun i ↦ Ideal.span {(t i : R)} :=
  (Geometry.SNCSubdivisorProducts.finset_inf_span_singleton_of_prime T (fun i ↦ (t i : R))
    (fun i _ ↦ prime_param t hli i) (fun _ _ _ _ hij ↦ param_not_dvd t hli hij)).symm

/-- The ideal of a product of distinct parameters is radical. -/
theorem span_prod_param_isRadical (T : Finset ι) :
    (Ideal.span {∏ i ∈ T, (t i : R)}).IsRadical := by
  rw [span_prod_param_eq_inf t hli]
  induction T using Finset.cons_induction with
  | empty => exact fun _ _ ↦ by simp
  | cons i T hi ih =>
    rw [Finset.inf_cons]
    exact ((Ideal.span_singleton_prime (prime_param t hli i).ne_zero).mpr
      (prime_param t hli i)).isRadical.inf ih

end Parameters

end DeJongAlterations.StableModification.Resolution.Strictify
