import DeJongAlterations.StableModification.Resolution.StrictifyChart
import DeJongAlterations.StableModification.Resolution.StrictifyScheme
import DeJongAlterations.Geometry.BlowupGluing
import DeJongAlterations.Geometry.AffineBlowupCover
import DeJongAlterations.Geometry.BlowupModification
import DeJongAlterations.Geometry.BlowupProjective
import DeJongAlterations.Geometry.BlowupComplement
import DeJongAlterations.Geometry.CompletedLocalRingOpen
import DeJongAlterations.StableModification.DeJong.Dimension

/-!
# One blowup of the strictification

Let `X` be a smooth variety over an algebraically closed field `k`, `C ⊆ X` closed and
`π : X' → X` the blowup of `X` along the reduced structure of `C` (Codex's
`Geometry.BlowupGluing.blowup`). At every point `y ∈ X'`, with `x = π(y)`, the local homomorphism
`𝒪_{X,x} → 𝒪_{X',y}` is a localization of a blowup chart (`exists_chartData`): there is
`g ∈ I(C)_x` with `I(C)_x 𝒪_{X',y} = (g)`, `g ≠ 0` in `𝒪_{X',y}`, and `𝒪_{X',y}` is a localization of
the subring generated by `𝒪_{X,x}` and the fractions `s/g`, `s ∈ I(C)_x`. These are the hypotheses
of `exists_chart_coordinates`, the computation of the completed local rings of the blowup
(de Jong 1996, 2.4, `references/dejong96-alterations/tex/page-0006.tex`).

The chart is the fraction chart `A[I/a] ⊆ Frac(A)` of an affine open `Spec A ∋ x` (Codex's
`affineBlowupFractionChart`, `affineBlowupFractionOpenCover`); the stalk maps are compared with
`Localization.localRingHom` by Mathlib's `IsAffineOpen.arrowStalkMapIso`.
-/

noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace IsLocalRing

namespace DeJongAlterations.StableModification.Resolution.Strictify

set_option backward.isDefEq.respectTransparency false

open Algebra.NodeFittingIdealSheaf Geometry.BlowupGluing

universe u

section Algebra

variable {A B' B O P : Type*} [CommRing A] [CommRing B'] [CommRing B] [CommRing O] [CommRing P]

/-- The chart data of a local homomorphism `φ : O → P` for the ideal `I ⊆ O`: an element `g ∈ I`
with `I P = (φ g)`, `φ g ≠ 0`, and `P` a localization of the subring generated by `φ(O)` and the
fractions `s/g`, `s ∈ I`. -/
def HasChartData (φ : O →+* P) (I : Ideal O) : Prop :=
  ∃ g ∈ I, IsChartLocalization φ I g ∧ I.map φ = Ideal.span {φ g} ∧ φ g ≠ 0

/-- Chart data descend along an isomorphism of the target. -/
theorem HasChartData.of_comp_ringEquiv (φ : O →+* P) (β : P ≃+* B) (I : Ideal O)
    (H : HasChartData ((β : P →+* B).comp φ) I) : HasChartData φ I := by
  obtain ⟨g, hg, hloc, hmap, hne⟩ := H
  have hI : Ideal.map (RingEquiv.refl O) I = I :=
    le_antisymm (Ideal.map_le_iff_le_comap.mpr fun x hx ↦ hx)
      (fun x hx ↦ Ideal.mem_map_of_mem (RingEquiv.refl O) hx)
  refine ⟨g, hg, ?_, ?_, ?_⟩
  · apply IsChartLocalization.of_ringEquiv φ ((β : P →+* B).comp φ) (RingEquiv.refl O) β
      (fun _ ↦ rfl)
    rw [hI]
    exact hloc
  · apply map_eq_span_of_ringEquiv φ ((β : P →+* B).comp φ) (RingEquiv.refl O) β (fun _ ↦ rfl)
    rw [hI]
    exact hmap
  · intro h
    apply hne
    simp [h]

/-- The chart hypotheses are transported along an isomorphism `e` with `e ∘ θ = f`. -/
theorem chartHyp_of_ringEquiv [IsDomain B] (θ : A →+* B') (e : B' ≃+* B) (f : A →+* B)
    (he : ∀ z, e (θ z) = f z) (I : Ideal A) (a : A)
    (hgen : ∀ b : B, b ∈ Subring.closure (Set.range f ∪ {c | ∃ a' ∈ I, f a * c = f a'}))
    (hI : I.map f = Ideal.span {f a}) (hfa : f a ≠ 0) :
    (∀ b : B', b ∈ Subring.closure (Set.range θ ∪ {c | ∃ a' ∈ I, θ a * c = θ a'})) ∧
      I.map θ = Ideal.span {θ a} ∧ θ a ≠ 0 ∧
      ∀ (q : Ideal B') [q.IsPrime], q.primeCompl ≤ nonZeroDivisors B' := by
  have hes : ∀ z, θ z = e.symm (f z) := fun z ↦ by rw [← he, RingEquiv.symm_apply_apply]
  have hθ : θ = (e.symm : B →+* B').comp f := RingHom.ext hes
  have : IsDomain B' := e.toMulEquiv.isDomain
  refine ⟨fun b ↦ ?_, ?_, ?_, fun q _ ↦ q.primeCompl_le_nonZeroDivisors⟩
  · have hle : Subring.closure (Set.range f ∪ {c | ∃ a' ∈ I, f a * c = f a'}) ≤
        (Subring.closure (Set.range θ ∪ {c | ∃ a' ∈ I, θ a * c = θ a'})).comap
          (e.symm : B →+* B') := by
      rw [Subring.closure_le]
      rintro _ (⟨z, rfl⟩ | ⟨a', ha', hc⟩)
      · exact Subring.subset_closure (Or.inl ⟨z, hes z⟩)
      · refine Subring.subset_closure (Or.inr ⟨a', ha', ?_⟩)
        rw [hes, hes]
        change e.symm (f a) * e.symm _ = _
        rw [← map_mul, hc]
    have := hle (hgen (e b))
    simpa using this
  · rw [hθ, ← Ideal.map_map, hI, Ideal.map_span, Set.image_singleton]
    rfl
  · rw [hes]
    exact fun h ↦ hfa (e.symm.injective (h.trans (map_zero _).symm))

variable [Algebra A O] [Algebra B' P]

/-- **Chart data at a localization of a chart.** If `B'` is generated by `θ(A)` and fractions `c`
with `θ(a) c = θ(a')`, `a' ∈ I`, `I B' = (θ a)` and `θ a ≠ 0`, then every ring map `φ : O → P`
from an `A`-algebra to a localization `P` of `B'` at non-zero-divisors, compatible with `θ`, has
chart data for `I O` with generator the image of `a`. -/
theorem hasChartData_of_isLocalization (M : Submonoid B') [IsLocalization M P]
    (hM : M ≤ nonZeroDivisors B') (θ : A →+* B') (φ : O →+* P)
    (hφ : ∀ z, φ (algebraMap A O z) = algebraMap B' P (θ z)) (I : Ideal A) (a : A) (ha : a ∈ I)
    (hgen : ∀ b : B', b ∈ Subring.closure (Set.range θ ∪ {c | ∃ a' ∈ I, θ a * c = θ a'}))
    (hI : I.map θ = Ideal.span {θ a}) (ha0 : θ a ≠ 0) :
    HasChartData φ (I.map (algebraMap A O)) := by
  refine ⟨algebraMap A O a, Ideal.mem_map_of_mem _ ha, ?_, ?_, ?_⟩
  · intro u
    obtain ⟨⟨b, s⟩, hbs⟩ := IsLocalization.surj M u
    have hcl : ∀ z : B', algebraMap B' P z ∈ Subring.closure (Set.range φ ∪
        chartGenerators φ (I.map (algebraMap A O)) (algebraMap A O a)) := by
      intro z
      have hle : Subring.closure (Set.range θ ∪ {c | ∃ a' ∈ I, θ a * c = θ a'}) ≤
          (Subring.closure (Set.range φ ∪
            chartGenerators φ (I.map (algebraMap A O)) (algebraMap A O a))).comap
            (algebraMap B' P) := by
        rw [Subring.closure_le]
        rintro _ (⟨a'', rfl⟩ | ⟨a', ha', hc⟩)
        · exact Subring.subset_closure (Or.inl ⟨algebraMap A O a'', hφ a''⟩)
        · refine Subring.subset_closure
            (Or.inr ⟨algebraMap A O a', Ideal.mem_map_of_mem _ ha', ?_⟩)
          rw [hφ, hφ, ← map_mul, hc]
      exact hle (hgen z)
    exact ⟨_, hcl b, _, hcl s, IsLocalization.map_units P s, hbs⟩
  · have : φ.comp (algebraMap A O) = (algebraMap B' P).comp θ := RingHom.ext hφ
    rw [Ideal.map_map, this, ← Ideal.map_map, hI, Ideal.map_span, Set.image_singleton, hφ]
  · rw [hφ]
    exact fun h ↦ ha0 (IsLocalization.injective P hM (h.trans (map_zero _).symm))

end Algebra

variable {X : Scheme.{u}}

/-- The sections over `Spec B` of a morphism `Spec B → Spec Γ(X, U) ⊆ X`. -/
theorem appLE_eq_of_eq_comp_fromSpec {B : CommRingCat.{u}} (U : X.affineOpens) (h : Spec B ⟶ X)
    (f : Γ(X, U.1) ⟶ B) (hh : h = Spec.map f ≫ U.2.fromSpec) (hVU : ⊤ ≤ h ⁻¹ᵁ U.1) :
    h.appLE U.1 ⊤ hVU = f ≫ (Scheme.ΓSpecIso B).inv := by
  have h1 := IsAffineOpen.SpecMap_appLE_fromSpec h U.2 (isAffineOpen_top _) hVU
  have h1' : Spec.map (h.appLE U.1 ⊤ hVU) ≫ U.2.fromSpec =
      Spec.map (f ≫ (Scheme.ΓSpecIso B).inv) ≫ U.2.fromSpec := by
    rw [h1, IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv, hh, Spec.map_comp,
      Category.assoc]
  exact Spec.map_injective ((cancel_mono U.2.fromSpec).mp h1')

theorem ΓSpecIso_hom_appLE {B : CommRingCat.{u}} (U : X.affineOpens) (h : Spec B ⟶ X)
    (f : Γ(X, U.1) ⟶ B) (hh : h = Spec.map f ≫ U.2.fromSpec) (hVU : ⊤ ≤ h ⁻¹ᵁ U.1)
    (z : Γ(X, U.1)) : (Scheme.ΓSpecIso B).hom (h.appLE U.1 ⊤ hVU z) = f z := by
  rw [appLE_eq_of_eq_comp_fromSpec U h f hh hVU, CommRingCat.comp_apply]
  exact CommRingCat.hom_inv_apply _ _

variable [IsIntegral X] (C : Closeds X)

/-- **Chart data at the points of a fraction chart.** Let `Spec A ⊆ X` be affine, `I = I(C)(Spec A)`,
`0 ≠ a ∈ I` and `h : Spec A[I/a] → Spec A ⊆ X` the chart morphism. At every `y ∈ Spec A[I/a]` the
stalk map of `h` has chart data for `I(C)_{h(y)}`. -/
theorem hasChartData_stalkMap_fractionChart (U : X.affineOpens) [Nonempty U.1]
    (a : Γ(X, U.1)) (ha : a ∈ (Scheme.IdealSheafData.vanishingIdeal C).ideal U) (ha0 : a ≠ 0)
    (h : Spec (CommRingCat.of (affineBlowupFractionChart
      ((Scheme.IdealSheafData.vanishingIdeal C).ideal U) a)) ⟶ X)
    (hh : h = Spec.map (CommRingCat.ofHom (algebraMap Γ(X, U.1)
      (affineBlowupFractionChart ((Scheme.IdealSheafData.vanishingIdeal C).ideal U) a))) ≫
        U.2.fromSpec)
    (y : Spec (CommRingCat.of (affineBlowupFractionChart
      ((Scheme.IdealSheafData.vanishingIdeal C).ideal U) a))) :
    HasChartData (h.stalkMap y).hom (localIdeal C (h y)) := by
  classical
  let I := (Scheme.IdealSheafData.vanishingIdeal C).ideal U
  let B := affineBlowupFractionChart I a
  let A := Γ(X, U.1)
  let f : A →+* B := algebraMap A B
  have hrange : ∀ z, h z ∈ U.1 := by
    intro z
    rw [hh]
    have hz : U.2.fromSpec (Spec.map (CommRingCat.ofHom f) z) ∈ Set.range U.2.fromSpec :=
      Set.mem_range_self _
    rwa [U.2.range_fromSpec] at hz
  have hVU : (⊤ : (Spec (CommRingCat.of B)).Opens) ≤ h ⁻¹ᵁ U.1 := fun z _ ↦ hrange z
  let θ := (h.appLE U.1 ⊤ hVU).hom
  let e : Γ(Spec (CommRingCat.of B), ⊤) ≃+* B :=
    (Scheme.ΓSpecIso (CommRingCat.of B)).commRingCatIsoToRingEquiv
  have he : ∀ z, e (θ z) = f z := ΓSpecIso_hom_appLE U h (CommRingCat.ofHom f) hh hVU
  have hf_inj : Function.Injective f := by
    intro z w hzw
    apply IsFractionRing.injective A (FractionRing A)
    exact congrArg Subtype.val hzw
  obtain ⟨hgenθ, hIθ, hθa0, hM⟩ := chartHyp_of_ringEquiv θ e f he I a
    (fun b ↦ mem_closure_fractionChart I a ha0 b)
    (affineBlowupFractionChart_mapIdeal I a ha ha0)
    (fun h0 ↦ ha0 (hf_inj (h0.trans (map_zero f).symm)))
  let : Algebra A (X.presheaf.stalk (h y)) :=
    TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨h y, hrange y⟩
  let : Algebra Γ(Spec (CommRingCat.of B), ⊤) ((Spec (CommRingCat.of B)).presheaf.stalk y) :=
    TopCat.Presheaf.algebra_section_stalk (Spec (CommRingCat.of B)).presheaf
      ⟨y, show y ∈ (⊤ : (Spec (CommRingCat.of B)).Opens) from trivial⟩
  have := (isAffineOpen_top (Spec (CommRingCat.of B))).isLocalization_stalk
    ⟨y, show y ∈ (⊤ : (Spec (CommRingCat.of B)).Opens) from trivial⟩
  have hφ : ∀ z, (h.stalkMap y).hom (algebraMap A _ z) =
      algebraMap Γ(Spec (CommRingCat.of B), ⊤) _ (θ z) := by
    intro z
    change (h.stalkMap y).hom (X.presheaf.germ U.1 (h y) (hrange y) z) =
      (Spec (CommRingCat.of B)).presheaf.germ ⊤ y trivial (θ z)
    rw [Scheme.Hom.germ_stalkMap_apply]
    simp only [θ, Scheme.Hom.appLE, CommRingCat.comp_apply]
    rw [TopCat.Presheaf.germ_res_apply]
  have hloc : localIdeal C (h y) = I.map (X.presheaf.germ U.1 (h y) (hrange y)).hom :=
    stalkIdeal_eq_map_germ _ U (hrange y)
  have key := hasChartData_of_isLocalization _
    (hM ((isAffineOpen_top (Spec (CommRingCat.of B))).primeIdealOf
      ⟨y, show y ∈ (⊤ : (Spec (CommRingCat.of B)).Opens) from trivial⟩).asIdeal)
    θ _ hφ I a ha hgenθ hIθ hθa0
  rw [hloc]
  exact key

/-- **Chart data on the blowup** (de Jong 2.4): at every point `y` of the blowup `π : X' → X` of
`X` along the reduced closed subscheme `C`, the stalk map `𝒪_{X,π(y)} → 𝒪_{X',y}` has chart data
for `I(C)_{π(y)}`. -/
theorem hasChartData_blowupStructure (y : blowup (Scheme.IdealSheafData.vanishingIdeal C)) :
    HasChartData ((blowupStructure (Scheme.IdealSheafData.vanishingIdeal C)).stalkMap y).hom
      (localIdeal C (blowupStructure (Scheme.IdealSheafData.vanishingIdeal C) y)) := by
  classical
  let D := Scheme.IdealSheafData.vanishingIdeal C
  let π := blowupStructure D
  obtain ⟨U0, hxU⟩ := exists_affineOpens_mem (π y)
  let U : X.AffineZariskiSite := ⟨U0.1, U0.2⟩
  have hyU : y ∈ (chartInclusion D U).opensRange := by
    rw [chartInclusion_opensRange]
    exact hxU
  obtain ⟨y', rfl⟩ := hyU
  have : Nonempty U0.1 := ⟨⟨_, hxU⟩⟩
  obtain ⟨⟨⟨a, ha⟩, ha0⟩, y'', rfl⟩ :=
    (affineBlowupFractionOpenCover (D.ideal ⟨U.1, U.2⟩)).exists_eq y'
  let ψ := affineBlowupChartInclusion (D.ideal ⟨U.1, U.2⟩) a ha ha0 ≫ chartInclusion D U
  have hh : ψ ≫ π = Spec.map (CommRingCat.ofHom (algebraMap Γ(X, U0.1)
      (affineBlowupFractionChart (D.ideal U0) a))) ≫ U0.2.fromSpec := by
    simp only [ψ, π, Category.assoc, chartInclusion_structure]
    rw [← Category.assoc, affineBlowupChartInclusion_structure]
  have key := hasChartData_stalkMap_fractionChart C U0 a ha ha0 (ψ ≫ π) hh y''
  rw [Scheme.Hom.stalkMap_comp] at key
  exact HasChartData.of_comp_ringEquiv _ (asIso (ψ.stalkMap y'')).commRingCatIsoToRingEquiv _ key

end DeJongAlterations.StableModification.Resolution.Strictify
