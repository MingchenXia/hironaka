import DeJongAlterations.Algebra.NodeDomain
import DeJongAlterations.Algebra.RegularLocalSurjection
import DeJongAlterations.Algebra.NodeFlatPresentationEvaluation
import Mathlib.RingTheory.MvPowerSeries.Equiv
import Mathlib.RingTheory.AdicCompletion.Completeness
import Mathlib.RingTheory.Ideal.KrullsHeightTheorem

/-!
# Formal node models and recognition of formal charts

The formal local models of the global resolution of a nodal curve (de Jong 1996, 3.4 and 4.27,
`references/dejong96-alterations/tex/page-0013.tex`–`page-0015.tex`, `page-0026.tex`–
`page-0027.tex`; blueprint `def:sm-dj-formal-charts`, `lem:sm-dj-node-model`,
`lem:sm-dj-recognize-chart`):

* the **regular model** `k[[Z_1, …, Z_d]]`;
* the **node model** `NodeModel k n = k[[U, V, Z_1, …, Z_m]] / (U V - ∏ Z_i ^ n_i)`.

Main results:

* `isDomain_nodeModel`: the node model is a domain when some `n_i > 0`. The proof is a graded
  embedding: for weights `w(U) = w(V) = ∑ n_i`, `w(Z_i) = 2` the node polynomial `F` is weighted
  homogeneous, and `f ↦ ∑_p [f_p] T^p` (with `f_p` the weight-`p` component of `f`) is a ring map
  `k[[U, V, Z]] → (k[U, V, Z]/(F))[[T]]` whose kernel is `(F)` (`mem_span_of_gradedMap_eq_zero`);
  the target is a domain because the polynomial node ring is (Codex's
  `Algebra.NodeDomain.nestedQuotient_isDomain`).
* `ringKrullDim_nodeModel_le`: the node model has dimension at most `m + 1`.
* `exists_mvPowerSeries_algEquiv`, `exists_nodeModel_algEquiv` (**recognition**): a complete local
  `k`-algebra with residue field reached by `k`, whose maximal ideal is generated by elements
  satisfying the model relation and whose dimension is at least that of the model, is isomorphic
  to the model with the variables sent to the given generators. The evaluation map is surjective
  by completeness (`evaluation_surjective`), and injective because the model is a
  finite-dimensional domain of no larger dimension (Codex's
  `Algebra.RegularLocalSurjection.injective_of_surjective_of_ringKrullDim_le`).

These upgrade the weak chart statements of `GlobalNodeChart` (generators of the maximal ideal of
a completed blowup chart satisfying the model relation) to strong formal charts.
-/

noncomputable section

open IsLocalRing MvPowerSeries

namespace DeJongAlterations.StableModification.Resolution.Global

set_option backward.isDefEq.respectTransparency false

section PowerSeries

variable {R : Type*} [CommRing R]

/-- A power series in finitely many variables without constant term lies in the ideal generated by
the variables. -/
theorem mem_span_X_of_constantCoeff_eq_zero (n : ℕ) (f : MvPowerSeries (Fin n) R)
    (hf : constantCoeff f = 0) :
    f ∈ Ideal.span (Set.range (X : Fin n → MvPowerSeries (Fin n) R)) := by
  induction n with
  | zero =>
    have : f = 0 := by
      ext d
      have hd : d = 0 := Subsingleton.elim _ _
      subst hd
      simpa using hf
    rw [this]
    exact Ideal.zero_mem _
  | succ n ih =>
    let e := MvPowerSeries.finSuccEquiv R n
    set F := e f with hF
    have hdec := PowerSeries.eq_X_mul_shift_add_const F
    set c0 := PowerSeries.coeff 0 F with hc0
    have hc0' : constantCoeff c0 = 0 := by
      rw [← coeff_zero_eq_constantCoeff_apply, hc0, hF, coeff_coeff_finSuccEquiv]
      rw [show Finsupp.cons 0 (0 : Fin n →₀ ℕ) = 0 from Finsupp.cons_zero_zero,
        coeff_zero_eq_constantCoeff_apply, hf]
    have hmem := ih c0 hc0'
    have hf' : f = e.symm F := (e.symm_apply_apply f).symm
    rw [hf', hdec, map_add, map_mul]
    refine Ideal.add_mem _ (Ideal.mul_mem_right _ _ ?_) ?_
    · have : e.symm PowerSeries.X = X 0 := by
        rw [← finSuccEquiv_X_zero, AlgEquiv.symm_apply_apply]
      rw [this]
      exact Ideal.subset_span ⟨0, rfl⟩
    · have hmap : (Ideal.span (Set.range (X : Fin n → MvPowerSeries (Fin n) R))).map
          (e.symm.toRingHom.comp PowerSeries.C) ≤
          Ideal.span (Set.range (X : Fin (n + 1) → MvPowerSeries (Fin (n + 1)) R)) := by
        rw [Ideal.map_span, Ideal.span_le]
        rintro _ ⟨_, ⟨j, rfl⟩, rfl⟩
        have : (e.symm.toRingHom.comp PowerSeries.C) (X j) = X j.succ := by
          change e.symm (PowerSeries.C (X j)) = X j.succ
          rw [← finSuccEquiv_X_succ, AlgEquiv.symm_apply_apply]
        rw [this]
        exact Ideal.subset_span ⟨j.succ, rfl⟩
      have hc : PowerSeries.constantCoeff F = c0 := by
        rw [hc0, PowerSeries.coeff_zero_eq_constantCoeff_apply]
      rw [hc]
      exact hmap (Ideal.mem_map_of_mem _ hmem)

variable {k : Type*} [Field k]

/-- The maximal ideal of `k[[X_1, …, X_n]]` is generated by the variables. -/
theorem maximalIdeal_mvPowerSeries_eq (n : ℕ) :
    maximalIdeal (MvPowerSeries (Fin n) k) = Ideal.span (Set.range X) := by
  apply le_antisymm
  · intro f hf
    apply mem_span_X_of_constantCoeff_eq_zero
    by_contra h
    exact hf (MvPowerSeries.isUnit_iff_constantCoeff.mpr (isUnit_iff_ne_zero.mpr h))
  · rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩ hu
    have := MvPowerSeries.isUnit_iff_constantCoeff.mp hu
    simp at this

/-- `dim k[[X_1, …, X_n]] ≤ n`. -/
theorem ringKrullDim_mvPowerSeries_le (n : ℕ) :
    ringKrullDim (MvPowerSeries (Fin n) k) ≤ n := by
  refine (ringKrullDim_le_spanFinrank_maximalIdeal _).trans ?_
  rw [maximalIdeal_mvPowerSeries_eq]
  have h1 := Submodule.spanFinrank_span_le_ncard_of_finite
    (R := MvPowerSeries (Fin n) k) (Set.finite_range (X : Fin n → MvPowerSeries (Fin n) k))
  have h2 : (Set.range (X : Fin n → MvPowerSeries (Fin n) k)).ncard ≤ n := by
    rw [← Set.image_univ, ← Finset.coe_univ]
    exact (Set.ncard_image_le (Finset.finite_toSet _)).trans (by simp)
  exact_mod_cast h1.trans h2

end PowerSeries


section Components

variable {σ k : Type*} [Fintype σ] [DecidableEq σ] [Field k] (w : σ → ℕ)

/-- The monomials of weight `p` (finitely many when all weights are positive). -/
def weightSlice (p : ℕ) : Finset (σ →₀ ℕ) :=
  (Finset.Iic (Finsupp.equivFunOnFinite.symm fun _ ↦ p)).filter fun d ↦ Finsupp.weight w d = p

theorem mem_weightSlice (hw : ∀ i, w i ≠ 0) {p : ℕ} {d : σ →₀ ℕ} :
    d ∈ weightSlice w p ↔ Finsupp.weight w d = p := by
  simp only [weightSlice, Finset.mem_filter, Finset.mem_Iic, and_iff_right_iff_imp]
  intro hd
  refine Finsupp.le_def.mpr fun i ↦ ?_
  change d i ≤ p
  rw [← hd]
  exact Finsupp.le_weight w (hw i) d

/-- The weighted homogeneous component of weight `p` of a power series, as a polynomial. -/
def weightComponent (p : ℕ) (f : MvPowerSeries σ k) : MvPolynomial σ k :=
  ∑ d ∈ weightSlice w p, MvPolynomial.monomial d (MvPowerSeries.coeff d f)

theorem coeff_weightComponent (hw : ∀ i, w i ≠ 0) (p : ℕ) (f : MvPowerSeries σ k)
    (d : σ →₀ ℕ) :
    MvPolynomial.coeff d (weightComponent w p f) =
      if Finsupp.weight w d = p then MvPowerSeries.coeff d f else 0 := by
  classical
  simp only [weightComponent, MvPolynomial.coeff_sum, MvPolynomial.coeff_monomial]
  rw [Finset.sum_ite_eq' (weightSlice w p) d]
  exact if_congr (mem_weightSlice w hw) rfl rfl

theorem weightComponent_one (hw : ∀ i, w i ≠ 0) (p : ℕ) :
    weightComponent w p (1 : MvPowerSeries σ k) = if p = 0 then 1 else 0 := by
  classical
  ext d
  rw [coeff_weightComponent w hw, MvPowerSeries.coeff_one]
  by_cases hd : d = 0
  · subst hd
    by_cases hp : p = 0
    · simp [hp]
    · simp [hp, Ne.symm hp]
  · by_cases hp : p = 0
    · simp [hp, hd, MvPolynomial.coeff_one, Ne.symm hd]
    · simp [hp, hd]

theorem weightComponent_mul (hw : ∀ i, w i ≠ 0) (p : ℕ) (f g : MvPowerSeries σ k) :
    weightComponent w p (f * g) =
      ∑ x ∈ Finset.antidiagonal p, weightComponent w x.1 f * weightComponent w x.2 g := by
  classical
  ext d
  rw [coeff_weightComponent w hw, MvPolynomial.coeff_sum]
  simp only [MvPolynomial.coeff_mul, coeff_weightComponent w hw, MvPowerSeries.coeff_mul]
  rw [Finset.sum_comm]
  split_ifs with hd
  · refine Finset.sum_congr rfl fun ab hab ↦ ?_
    rw [Finset.mem_antidiagonal] at hab
    rw [Finset.sum_eq_single (Finsupp.weight w ab.1, Finsupp.weight w ab.2)]
    · simp
    · rintro x - hx
      split_ifs with h1 h2 <;> try simp
      exact (hx (Prod.ext h1.symm h2.symm)).elim
    · intro hx
      exfalso
      apply hx
      rw [Finset.mem_antidiagonal, ← map_add, hab, hd]
  · symm
    refine Finset.sum_eq_zero fun ab hab ↦ Finset.sum_eq_zero fun x hx ↦ ?_
    rw [Finset.mem_antidiagonal] at hab hx
    split_ifs with h1 h2 <;> try simp
    exact (hd (by rw [← hab, map_add, h1, h2, hx])).elim

variable (hw : ∀ i, w i ≠ 0)

/-- The *graded map* `f ↦ ∑_p [f_p] T^p` from power series to power series in one variable over a
quotient of the polynomial ring, `f_p` the weighted homogeneous component of weight `p`. -/
def gradedMap (J : Ideal (MvPolynomial σ k)) :
    MvPowerSeries σ k →+* PowerSeries (MvPolynomial σ k ⧸ J) where
  toFun f := PowerSeries.mk fun p ↦ Ideal.Quotient.mk J (weightComponent w p f)
  map_one' := by
    ext p
    rw [PowerSeries.coeff_mk, weightComponent_one w hw, PowerSeries.coeff_one]
    split_ifs <;> simp
  map_mul' f g := by
    ext p
    rw [PowerSeries.coeff_mk, weightComponent_mul w hw, map_sum, PowerSeries.coeff_mul]
    simp only [map_mul, PowerSeries.coeff_mk]
  map_zero' := by
    ext p
    simp [weightComponent]
  map_add' f g := by
    ext p
    simp only [PowerSeries.coeff_mk, map_add, weightComponent, Finset.sum_add_distrib]

theorem coeff_gradedMap (J : Ideal (MvPolynomial σ k)) (f : MvPowerSeries σ k) (p : ℕ) :
    PowerSeries.coeff p (gradedMap w hw J f) = Ideal.Quotient.mk J (weightComponent w p f) :=
  PowerSeries.coeff_mk p (fun p ↦ Ideal.Quotient.mk J (weightComponent w p f))

/-- The graded map kills a weighted homogeneous polynomial generating `J`. -/
theorem gradedMap_generator {F : MvPolynomial σ k} {e : ℕ}
    (hF : MvPolynomial.IsWeightedHomogeneous w F e) :
    gradedMap w hw (Ideal.span {F}) (F : MvPowerSeries σ k) = 0 := by
  ext p
  rw [coeff_gradedMap, map_zero, Ideal.Quotient.eq_zero_iff_mem]
  have : weightComponent w p (F : MvPowerSeries σ k) = if p = e then F else 0 := by
    by_cases hpe : p = e
    · subst hpe
      rw [if_pos rfl]
      ext d
      rw [coeff_weightComponent w hw, MvPolynomial.coeff_coe]
      split_ifs with h
      · rfl
      · exact (hF.coeff_eq_zero d h).symm
    · rw [if_neg hpe]
      ext d
      rw [coeff_weightComponent w hw, MvPolynomial.coeff_coe, MvPolynomial.coeff_zero]
      split_ifs with h
      · exact hF.coeff_eq_zero d (by rw [h]; exact hpe)
      · rfl
  rw [this]
  split_ifs
  · exact Ideal.mem_span_singleton_self F
  · exact Ideal.zero_mem _

/-- **The kernel of the graded map is generated by a weighted homogeneous generator.** If the
graded map for `J = (F)` kills `f`, then `F ∣ f` in the power series ring. -/
theorem mem_span_of_gradedMap_eq_zero {F : MvPolynomial σ k} {e : ℕ}
    (hF : MvPolynomial.IsWeightedHomogeneous w F e) (f : MvPowerSeries σ k)
    (hf : gradedMap w hw (Ideal.span {F}) f = 0) :
    f ∈ Ideal.span {(F : MvPowerSeries σ k)} := by
  classical
  have hcomp : ∀ p, ∃ Q : MvPolynomial σ k, weightComponent w p f = F * Q := by
    intro p
    have h := congrArg (PowerSeries.coeff p) hf
    rw [coeff_gradedMap, map_zero, Ideal.Quotient.eq_zero_iff_mem,
      Ideal.mem_span_singleton'] at h
    obtain ⟨Q, hQ⟩ := h
    exact ⟨Q, by rw [← hQ, mul_comm]⟩
  choose Q hQ using hcomp
  let G : MvPowerSeries σ k := fun b ↦ MvPolynomial.coeff b (Q (Finsupp.weight w b + e))
  have hG : f = (F : MvPowerSeries σ k) * G := by
    ext d
    rw [MvPowerSeries.coeff_mul]
    have hterm : ∀ ab ∈ Finset.antidiagonal d,
        MvPowerSeries.coeff ab.1 (F : MvPowerSeries σ k) * MvPowerSeries.coeff ab.2 G =
          MvPolynomial.coeff ab.1 F * MvPolynomial.coeff ab.2 (Q (Finsupp.weight w d)) := by
      intro ab hab
      rw [Finset.mem_antidiagonal] at hab
      rw [MvPolynomial.coeff_coe]
      by_cases h0 : MvPolynomial.coeff ab.1 F = 0
      · rw [h0, zero_mul, zero_mul]
      · have hwa := hF h0
        congr 1
        change MvPolynomial.coeff ab.2 (Q (Finsupp.weight w ab.2 + e)) = _
        rw [← hab, map_add, hwa, add_comm]
    rw [Finset.sum_congr rfl hterm, ← MvPolynomial.coeff_mul, ← hQ,
      coeff_weightComponent w hw, if_pos rfl]
  rw [hG]
  exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)

end Components

section Node

variable (k : Type*) [Field k] {m : ℕ} (n : Fin m → ℕ)

/-- The node polynomial `U V - ∏ Z_i ^ n_i`, in the variables `U = X 0`, `V = X 1` and
`Z_i = X (i + 2)`. -/
def nodePoly : MvPolynomial (Fin (m + 2)) k :=
  MvPolynomial.X 0 * MvPolynomial.X 1 - ∏ i, MvPolynomial.X i.succ.succ ^ n i

/-- The weights `w(U) = w(V) = ∑ n_i` and `w(Z_i) = 2`, for which the node polynomial is
weighted homogeneous of weight `2 ∑ n_i`. -/
def nodeWeight : Fin (m + 2) → ℕ :=
  Fin.cons (∑ i, n i) (Fin.cons (∑ i, n i) fun _ ↦ 2)

theorem nodeWeight_ne_zero (hn : ∑ i, n i ≠ 0) (i : Fin (m + 2)) : nodeWeight n i ≠ 0 := by
  refine Fin.cases ?_ (fun j ↦ Fin.cases ?_ (fun l ↦ ?_) j) i
  · simpa [nodeWeight] using hn
  · simpa [nodeWeight] using hn
  · simp [nodeWeight]

theorem nodePoly_isWeightedHomogeneous :
    (nodePoly k n).IsWeightedHomogeneous (nodeWeight n) (2 * ∑ i, n i) := by
  unfold nodePoly
  refine MvPolynomial.IsWeightedHomogeneous.sub ?_ ?_
  · have h := (MvPolynomial.isWeightedHomogeneous_X k (nodeWeight n) 0).mul
      (MvPolynomial.isWeightedHomogeneous_X k (nodeWeight n) 1)
    have he : 2 * ∑ i, n i = nodeWeight n 0 + nodeWeight n 1 := by
      simp [nodeWeight]
      ring
    rw [he]
    exact h
  · have h := MvPolynomial.IsWeightedHomogeneous.prod Finset.univ
      (fun i ↦ (MvPolynomial.X i.succ.succ : MvPolynomial (Fin (m + 2)) k) ^ n i)
      (fun i ↦ n i • nodeWeight n i.succ.succ)
      (fun i _ ↦ (MvPolynomial.isWeightedHomogeneous_X k (nodeWeight n) i.succ.succ).pow (n i))
    have he : 2 * ∑ i, n i = ∑ i, n i • nodeWeight n i.succ.succ := by
      simp [nodeWeight, Finset.sum_mul, mul_comm]
    rw [he]
    exact h

/-- The coefficient `∏ Z_i ^ n_i` in the polynomial ring of the `Z`-variables. -/
def nodeCoeff : MvPolynomial (Fin m) k := ∏ i, MvPolynomial.X i ^ n i

theorem nodeCoeff_ne_zero : nodeCoeff k n ≠ 0 :=
  Finset.prod_ne_zero_iff.mpr fun i _ ↦ pow_ne_zero _ (MvPolynomial.X_ne_zero i)

/-- The polynomial ring in `m + 2` variables as a twice iterated polynomial ring over the
polynomial ring of the `Z`-variables. -/
def nodePolyEquiv :
    MvPolynomial (Fin (m + 2)) k ≃ₐ[k] Polynomial (Polynomial (MvPolynomial (Fin m) k)) :=
  (MvPolynomial.finSuccEquiv k (m + 1)).trans
    (Polynomial.mapAlgEquiv (MvPolynomial.finSuccEquiv k m))

theorem nodePolyEquiv_nodePoly :
    nodePolyEquiv k (nodePoly k n) = Algebra.NodeDomain.nestedEquation (nodeCoeff k n) := by
  have h0 : nodePolyEquiv k (MvPolynomial.X 0 : MvPolynomial (Fin (m + 2)) k) = Polynomial.X := by
    simp [nodePolyEquiv, MvPolynomial.finSuccEquiv_X_zero]
  have h1 : nodePolyEquiv k (MvPolynomial.X 1 : MvPolynomial (Fin (m + 2)) k) =
      Polynomial.C Polynomial.X := by
    change nodePolyEquiv k (MvPolynomial.X (Fin.succ 0)) = _
    rw [nodePolyEquiv, AlgEquiv.trans_apply, MvPolynomial.finSuccEquiv_X_succ]
    simp [MvPolynomial.finSuccEquiv_X_zero]
  have h2 : ∀ i : Fin m, nodePolyEquiv k (MvPolynomial.X i.succ.succ) =
      Polynomial.C (Polynomial.C (MvPolynomial.X i)) := by
    intro i
    simp [nodePolyEquiv, MvPolynomial.finSuccEquiv_X_succ]
  rw [nodePoly, map_sub, map_mul, map_prod, h0, h1, Algebra.NodeDomain.nestedEquation,
    nodeCoeff, mul_comm]
  simp_rw [map_pow, h2, map_prod, map_pow]

/-- The polynomial node ring `k[U, V, Z] / (U V - ∏ Z_i ^ n_i)` is a domain. -/
theorem isDomain_nodePolyQuotient :
    IsDomain (MvPolynomial (Fin (m + 2)) k ⧸ Ideal.span {nodePoly k n}) := by
  have := Algebra.NodeDomain.nestedQuotient_isDomain (nodeCoeff k n) (nodeCoeff_ne_zero k n)
  let e := Ideal.quotientEquiv (Ideal.span {nodePoly k n})
    (Algebra.NodeDomain.nestedIdeal (nodeCoeff k n)) (nodePolyEquiv k).toRingEquiv (by
      rw [Ideal.map_span, Set.image_singleton, Algebra.NodeDomain.nestedIdeal]
      congr 1
      rw [Set.singleton_eq_singleton_iff]
      exact (nodePolyEquiv_nodePoly k n).symm)
  exact Function.Injective.isDomain e.toRingHom e.injective

/-- The node power series `U V - ∏ Z_i ^ n_i` in `k[[U, V, Z_1, …, Z_m]]`. -/
abbrev nodeSeries : MvPowerSeries (Fin (m + 2)) k := (nodePoly k n : MvPowerSeries (Fin (m + 2)) k)

theorem nodeSeries_eq :
    nodeSeries k n = X 0 * X 1 - ∏ i, (X i.succ.succ : MvPowerSeries (Fin (m + 2)) k) ^ n i := by
  change MvPolynomial.coeToMvPowerSeries.ringHom (nodePoly k n) = _
  rw [nodePoly, map_sub, map_mul, map_prod]
  simp only [map_pow, MvPolynomial.coeToMvPowerSeries.ringHom_apply, MvPolynomial.coe_X]

theorem nodePoly_ne_zero (hn : ∑ i, n i ≠ 0) : nodePoly k n ≠ 0 := by
  intro h
  have := congrArg (MvPolynomial.eval (Fin.cons 1 (Fin.cons 1 0) : Fin (m + 2) → k)) h
  obtain ⟨j, -, hj⟩ := Finset.exists_ne_zero_of_sum_ne_zero hn
  have hprod : ∏ i, (Fin.cons 1 (Fin.cons 1 0) : Fin (m + 2) → k) i.succ.succ ^ n i = 0 :=
    Finset.prod_eq_zero (Finset.mem_univ j) (by simp [zero_pow hj])
  simp only [nodePoly, map_sub, map_mul, map_prod, map_pow, MvPolynomial.eval_X, map_zero] at this
  rw [hprod, Fin.cons_zero, Fin.cons_one, Fin.cons_zero] at this
  simp at this

/-- The **formal node model** `k[[U, V, Z_1, …, Z_m]] / (U V - ∏ Z_i ^ n_i)`
(de Jong 1996, 3.4 and 4.27; `def:sm-dj-formal-charts`). -/
abbrev NodeModel : Type _ := MvPowerSeries (Fin (m + 2)) k ⧸ Ideal.span {nodeSeries k n}

/-- **The formal node model is a domain** as soon as some exponent is positive. The graded map
for the weights `nodeWeight` embeds it into a power series ring over the polynomial node ring,
which is a domain by `isDomain_nodePolyQuotient`. -/
theorem isDomain_nodeModel (hn : ∑ i, n i ≠ 0) : IsDomain (NodeModel k n) := by
  have hw := nodeWeight_ne_zero n hn
  have hF := nodePoly_isWeightedHomogeneous k n
  have := isDomain_nodePolyQuotient k n
  let φ : NodeModel k n →+*
      PowerSeries (MvPolynomial (Fin (m + 2)) k ⧸ Ideal.span {nodePoly k n}) :=
    Ideal.Quotient.lift _ (gradedMap (nodeWeight n) hw (Ideal.span {nodePoly k n})) (by
      intro f hf
      obtain ⟨g, rfl⟩ := Ideal.mem_span_singleton'.mp hf
      rw [map_mul, gradedMap_generator _ hw hF, mul_zero])
  refine Function.Injective.isDomain φ ?_
  rw [injective_iff_map_eq_zero]
  intro x hx
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective x
  exact Ideal.Quotient.eq_zero_iff_mem.mpr (mem_span_of_gradedMap_eq_zero _ hw hF f hx)

theorem withBot_le_of_add_one_le {a : WithBot ℕ∞} {N : ℕ} (h : a + 1 ≤ ((N + 1 : ℕ) : WithBot ℕ∞)) :
    a ≤ N := by
  induction a using WithBot.recBotCoe with
  | bot => exact bot_le
  | coe e =>
    induction e using ENat.recTopCoe with
    | top =>
      have h' : ((⊤ : ℕ∞) + 1 : ℕ∞) ≤ ((N + 1 : ℕ) : ℕ∞) := by exact_mod_cast h
      simp at h'
    | coe e =>
      have : e + 1 ≤ N + 1 := by exact_mod_cast h
      exact_mod_cast (by omega : e ≤ N)

/-- The formal node model has Krull dimension at most `m + 1`. -/
theorem ringKrullDim_nodeModel_le (hn : ∑ i, n i ≠ 0) : ringKrullDim (NodeModel k n) ≤ m + 1 := by
  have hF0 : nodeSeries k n ≠ 0 := by
    rw [nodeSeries, Ne, MvPolynomial.coe_eq_zero_iff]
    exact nodePoly_ne_zero k n hn
  have h1 := ringKrullDim_quotient_succ_le_of_nonZeroDivisor (mem_nonZeroDivisors_of_ne_zero hF0)
  have h2 := ringKrullDim_mvPowerSeries_le (k := k) (m + 2)
  have := withBot_le_of_add_one_le (N := m + 1) (h1.trans h2)
  exact_mod_cast this

end Node

section Recognition

variable {k : Type*} [Field k] {Q : Type*} [CommRing Q] [IsLocalRing Q] [Algebra k Q]
  [IsAdicComplete (maximalIdeal Q) Q]

/-- A nontrivial ring of Krull dimension at most `N` has finite Krull dimension. -/
theorem finiteRingKrullDim_of_le {R : Type*} [CommRing R] [Nontrivial R] {N : ℕ}
    (h : ringKrullDim R ≤ N) : FiniteRingKrullDim R := by
  rw [finiteRingKrullDim_iff_ne_bot_and_top]
  refine ⟨fun hb ↦ ?_, fun ht ↦ ?_⟩
  · have := ringKrullDim_nonneg_of_nontrivial (R := R)
    rw [hb] at this
    simp at this
  · rw [ht] at h
    have h' : ((N : ℕ∞) : WithBot ℕ∞) = ((⊤ : ℕ∞) : WithBot ℕ∞) := top_le_iff.mp h
    exact ENat.natCast_ne_top N (WithBot.coe_injective h')

/-- **Evaluation at generators of the maximal ideal is surjective.** If `Q` is a complete local
`k`-algebra whose residue field is reached by `k`, and `b` generates the maximal ideal, then the
evaluation `k[[X_i]] → Q`, `X_i ↦ b_i`, is surjective. -/
theorem evaluation_surjective {σ : Type*} [Finite σ]
    (hres : Function.Surjective (algebraMap k (ResidueField Q)))
    (b : σ → Q) (hb : ∀ i, b i ∈ maximalIdeal Q)
    (hspan : Ideal.span (Set.range b) = maximalIdeal Q) :
    Function.Surjective
      (DeJongAlterations.Algebra.NodeFlatPresentation.evaluation (A := k) (maximalIdeal Q) b hb) := by
  let f := (DeJongAlterations.Algebra.NodeFlatPresentation.evaluation (A := k)
    (maximalIdeal Q) b hb).toRingHom
  have hmap : (Ideal.span (Set.range (X : σ → MvPowerSeries σ k))).map f = maximalIdeal Q := by
    rw [Ideal.map_span, ← Set.range_comp, ← hspan]
    congr 1
    congr 1
    funext i
    exact DeJongAlterations.Algebra.NodeFlatPresentation.evaluation_X _ b hb i
  have : IsHausdorff ((Ideal.span (Set.range (X : σ → MvPowerSeries σ k))).map f) Q := by
    rw [hmap]
    infer_instance
  refine surjective_of_mk_map_comp_surjective
    (I := Ideal.span (Set.range (X : σ → MvPowerSeries σ k))) f ?_
  intro y
  obtain ⟨q, rfl⟩ := Ideal.Quotient.mk_surjective y
  obtain ⟨c, hc⟩ := hres (residue Q q)
  refine ⟨algebraMap k _ c, ?_⟩
  rw [RingHom.comp_apply, Ideal.Quotient.eq, hmap, ← residue_eq_zero_iff, map_sub]
  have hf : f (algebraMap k _ c) = algebraMap k Q c := AlgHom.commutes _ c
  rw [hf, ← hc, IsScalarTower.algebraMap_apply k Q (ResidueField Q),
    ResidueField.algebraMap_eq, sub_self]

/-- **Recognition of regular formal charts.** A complete local `k`-algebra `Q`, with residue field
reached by `k`, whose maximal ideal is generated by `d` elements and whose dimension is at least
`d`, is the power series ring `k[[Z_1, …, Z_d]]`, with `Z_i` sent to the given generators. -/
theorem exists_mvPowerSeries_algEquiv {d : ℕ}
    (hres : Function.Surjective (algebraMap k (ResidueField Q)))
    (z : Fin d → Q) (hz : Ideal.span (Set.range z) = maximalIdeal Q)
    (hdim : (d : WithBot ℕ∞) ≤ ringKrullDim Q) :
    ∃ e : MvPowerSeries (Fin d) k ≃ₐ[k] Q, ∀ i, e (X i) = z i := by
  have hzm : ∀ i, z i ∈ maximalIdeal Q := fun i ↦ hz ▸ Ideal.subset_span ⟨i, rfl⟩
  have hsurj := evaluation_surjective hres z hzm hz
  have : IsDomain (MvPowerSeries (Fin d) k) := NoZeroDivisors.to_isDomain _
  have : FiniteRingKrullDim (MvPowerSeries (Fin d) k) :=
    finiteRingKrullDim_of_le (ringKrullDim_mvPowerSeries_le d)
  have hinj := DeJongAlterations.Algebra.RegularLocalSurjection.injective_of_surjective_of_ringKrullDim_le
    (DeJongAlterations.Algebra.NodeFlatPresentation.evaluation (A := k)
      (maximalIdeal Q) z hzm).toRingHom hsurj ((ringKrullDim_mvPowerSeries_le d).trans hdim)
  exact ⟨AlgEquiv.ofBijective _ ⟨hinj, hsurj⟩, fun i ↦
    DeJongAlterations.Algebra.NodeFlatPresentation.evaluation_X _ z hzm i⟩

/-- **Recognition of formal node charts.** A complete local `k`-algebra `Q`, with residue field
reached by `k`, of dimension at least `m + 1`, whose maximal ideal is generated by `u, v, z_1, …,
z_m` with `u v = ∏ z_i ^ n_i` (some `n_i > 0`), is the formal node model, with `U, V, Z_i` sent to
`u, v, z_i`. -/
theorem exists_nodeModel_algEquiv {m : ℕ} (n : Fin m → ℕ) (hn : ∑ i, n i ≠ 0)
    (hres : Function.Surjective (algebraMap k (ResidueField Q)))
    (u v : Q) (z : Fin m → Q)
    (hspan : Ideal.span (insert u (insert v (Set.range z))) = maximalIdeal Q)
    (hrel : u * v = ∏ i, z i ^ n i)
    (hdim : (m + 1 : WithBot ℕ∞) ≤ ringKrullDim Q) :
    ∃ e : NodeModel k n ≃ₐ[k] Q, e (Ideal.Quotient.mk _ (X 0)) = u ∧
      e (Ideal.Quotient.mk _ (X 1)) = v ∧ ∀ i, e (Ideal.Quotient.mk _ (X i.succ.succ)) = z i := by
  let b : Fin (m + 2) → Q := Fin.cons u (Fin.cons v z)
  have hb0 : b 0 = u := Fin.cons_zero _ _
  have hb1 : b 1 = v := by simp [b]
  have hbs : ∀ i, b i.succ.succ = z i := fun i ↦ by simp [b]
  have hbspan : Ideal.span (Set.range b) = maximalIdeal Q := by
    rw [← hspan]
    simp only [b, Fin.range_cons]
  have hbm : ∀ i, b i ∈ maximalIdeal Q := fun i ↦ hbspan ▸ Ideal.subset_span ⟨i, rfl⟩
  let ev := DeJongAlterations.Algebra.NodeFlatPresentation.evaluation (A := k)
    (maximalIdeal Q) b hbm
  have hev : ∀ i, ev (X i) = b i :=
    DeJongAlterations.Algebra.NodeFlatPresentation.evaluation_X _ b hbm
  have hsurj := evaluation_surjective hres b hbm hbspan
  have hker : ev (nodeSeries k n) = 0 := by
    rw [nodeSeries_eq, map_sub, map_mul, map_prod]
    simp only [map_pow, hev, hb0, hb1, hbs]
    exact sub_eq_zero.mpr hrel
  let ψ : NodeModel k n →ₐ[k] Q := Ideal.Quotient.liftₐ _ ev (by
    intro a ha
    obtain ⟨g, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [map_mul, hker, mul_zero])
  have hψ : ∀ f, ψ (Ideal.Quotient.mk _ f) = ev f := fun f ↦ rfl
  have hψsurj : Function.Surjective ψ := by
    intro q
    obtain ⟨f, hf⟩ := hsurj q
    exact ⟨Ideal.Quotient.mk _ f, (hψ f).trans hf⟩
  have := isDomain_nodeModel k n hn
  have hle := ringKrullDim_nodeModel_le k n hn
  have : FiniteRingKrullDim (NodeModel k n) :=
    finiteRingKrullDim_of_le (N := m + 1) (by exact_mod_cast hle)
  have hinj := DeJongAlterations.Algebra.RegularLocalSurjection.injective_of_surjective_of_ringKrullDim_le
    ψ.toRingHom hψsurj (hle.trans hdim)
  refine ⟨AlgEquiv.ofBijective ψ ⟨hinj, hψsurj⟩, ?_, ?_, fun i ↦ ?_⟩
  · exact (hψ _).trans ((hev 0).trans hb0)
  · exact (hψ _).trans ((hev 1).trans hb1)
  · exact (hψ _).trans ((hev _).trans (hbs i))

end Recognition

end DeJongAlterations.StableModification.Resolution.Global
