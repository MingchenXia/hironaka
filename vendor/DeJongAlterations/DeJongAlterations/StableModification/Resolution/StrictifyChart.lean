import DeJongAlterations.StableModification.Resolution.StrictifyAlgebra
import DeJongAlterations.Algebra.CompletionLocalMap
import DeJongAlterations.Algebra.CompletionRegularityAscent
import DeJongAlterations.Algebra.NoetherianCompletion
import DeJongAlterations.Algebra.RegularLocalDomain
import Mathlib.LinearAlgebra.Dimension.OrzechProperty
import DeJongAlterations.Algebra.BlowupChartIdeal

/-!
# The completed local rings of a blowup along a stratum

Let `φ : O → P` be a local homomorphism of Noetherian local rings with residue fields `k`,
`O` regular, `t = (t_i)_{i ∈ ι}` a regular system of parameters of the completion `Ô`, and
`I ⊆ O` an ideal with `I Ô = (t_i : i ∈ S)` for a nonempty `S ⊆ ι`. Suppose that `P` is a
localization of a chart `O[I/g]` of the blowup of `O` along `I` (`IsChartLocalization`: every
element of `P` is a quotient, by a unit, of an element of the subring generated by `φ(O)` and
the fractions `c` with `φ(g) c = φ(s)`, `s ∈ I`), that `I P = (φ g)` with `φ g ≠ 0`, `P` a domain,
and `dim P ≥ |ι|`. This is the situation at a closed point `y` of the blowup `X'` of a regular
variety `X` along a closed subscheme `C` with `Ô_{C,x} = Ô_{X,x}/(t_i : i ∈ S)`, `x = π(y)`
(de Jong 1996, 2.4, `references/dejong96-alterations/tex/page-0006.tex`; the charts are those of
de Jong 4.27, `page-0027.tex`, for the regular centre `(u,v,t_1,t_2)`).

`exists_chart_coordinates` shows that the completion `P̂` is regular and has a regular system
of parameters `z` with

* `z_i = t_i` for `i ∉ S` and `z_j = t_j` for one `j ∈ S` (the exceptional divisor is
  `(φ g) = (z_j)`),
* `z_l = t_l/t_j - a_l` for `l ∈ S \ {j}`, where `a_l ∈ k` is the value of `t_l/t_j` at `y`,

and that the strict transform of the divisor `(∏_{i ∈ S} t_i)` is `(∏_{l ∈ S'} z_l)`, where
`S' = {l ∈ S \ {j} : a_l = 0}`: if `h ∈ O` has `(h) Ô = (∏_{i ∈ S} t_i)`, then
`φ h = (φ g)^{|S|} h'` with `(h') P̂ = (∏_{l ∈ S'} z_l)`.

The proof computes the maximal ideal of `P̂`: every element of `P` is congruent to a constant
modulo `N = (t_i, t_l/t_j - a_l)`, so `𝔪_{P̂} = N`, which is generated by the `|ι|` elements
`z`; since `dim P̂ ≥ |ι|`, `P̂` is regular.
-/

noncomputable section

open IsLocalRing

namespace DeJongAlterations.StableModification.Resolution.Strictify

open Algebra.CompletionLocalMap Algebra.CompletionRegularityBasics
open Algebra.CompletionRegularityAscent

/-- In a local ring, if finitely many elements `f_l`, `l ∈ S`, generate the principal ideal `(a)`
with `a` a non-zero-divisor, then one of them generates it. -/
theorem exists_mem_span_singleton_eq {Q ι : Type*} [CommRing Q] [IsLocalRing Q] (f : ι → Q)
    (S : Finset ι) (a : Q) (ha : IsSMulRegular Q a)
    (h : Ideal.span (f '' (S : Set ι)) = Ideal.span {a}) :
    ∃ j ∈ S, Ideal.span {f j} = Ideal.span {a} := by
  classical
  have hmem : a ∈ Ideal.span (f '' (S : Set ι)) := h ▸ Ideal.mem_span_singleton_self a
  obtain ⟨c, hc⟩ := (Submodule.mem_span_image_finset_iff_exists_fun' Q).mp hmem
  have hdvd : ∀ l ∈ S, ∃ e : Q, f l = a * e := by
    intro l hl
    have : f l ∈ Ideal.span {a} := h ▸ Ideal.subset_span ⟨l, hl, rfl⟩
    obtain ⟨e, he⟩ := Ideal.mem_span_singleton'.mp this
    exact ⟨e, by rw [← he, mul_comm]⟩
  choose! e he using hdvd
  have hone : ∑ l ∈ S, c l * e l = 1 := by
    apply ha
    simp only [smul_eq_mul, mul_one, Finset.mul_sum]
    conv_rhs => rw [← hc]
    refine Finset.sum_congr rfl fun l hl ↦ ?_
    rw [smul_eq_mul, he l hl]
    ring
  obtain ⟨j, hj, hunit⟩ : ∃ j ∈ S, IsUnit (e j) := by
    by_contra hne
    push Not at hne
    apply (maximalIdeal.isMaximal Q).ne_top
    rw [Ideal.eq_top_iff_one, ← hone]
    exact Ideal.sum_mem _ fun l hl ↦ Ideal.mul_mem_left _ _
      ((IsLocalRing.mem_maximalIdeal _).mpr (hne l hl))
  exact ⟨j, hj, by rw [he j hj, Ideal.span_singleton_mul_right_unit hunit]⟩

/-- A product of `|S|` members of an ideal lies in its `|S|`-th power. -/
theorem prod_mem_pow_card {R ι : Type*} [CommRing R] (J : Ideal R) (S : Finset ι) (f : ι → R)
    (hf : ∀ i ∈ S, f i ∈ J) : ∏ i ∈ S, f i ∈ J ^ S.card := by
  classical
  induction S using Finset.induction_on with
  | empty => simp
  | @insert i S hi ih =>
    rw [Finset.prod_insert hi, Finset.card_insert_of_notMem hi, pow_succ']
    exact Ideal.mul_mem_mul (hf i (Finset.mem_insert_self i S))
      (ih fun l hl ↦ hf l (Finset.mem_insert_of_mem hl))

section Chart

variable {k O P : Type*} [Field k] [CommRing O] [IsLocalRing O]
  [Algebra k O] [CommRing P] [IsLocalRing P] [Algebra k P]
  (φ : O →+* P)

/-- The generators `s/g`, `s ∈ I`, of the blowup chart `O[I/g]`, viewed in `P`. -/
def chartGenerators (I : Ideal O) (g : O) : Set P := {c | ∃ s ∈ I, φ g * c = φ s}

/-- `P` is a localization of (the image of) the blowup chart `O[I/g]`. -/
def IsChartLocalization (I : Ideal O) (g : O) : Prop :=
  ∀ p : P, ∃ b ∈ Subring.closure (Set.range φ ∪ chartGenerators φ I g),
    ∃ b' ∈ Subring.closure (Set.range φ ∪ chartGenerators φ I g), IsUnit b' ∧ p * b' = b

local notation "Rh" => AdicCompletion (maximalIdeal O) O
local notation "Qh" => AdicCompletion (maximalIdeal P) P

/-- The constants of `P̂`. -/
abbrev constQ (c : k) : Qh := algebraMap P Qh (algebraMap k P c)

/-- The elements of `P̂` congruent to a constant modulo `N`. -/
def constModSubring (N : Ideal Qh) : Subring Qh where
  carrier := {q | ∃ c : k, q - constQ (P := P) c ∈ N}
  mul_mem' := by
    rintro q q' ⟨c, hc⟩ ⟨c', hc'⟩
    refine ⟨c * c', ?_⟩
    have : q * q' - constQ (P := P) (c * c') =
        (q - constQ c) * q' + constQ c * (q' - constQ c') := by
      simp only [constQ, map_mul]; ring
    rw [this]
    exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ hc) (Ideal.mul_mem_left _ _ hc')
  one_mem' := ⟨1, by simp [constQ]⟩
  add_mem' := by
    rintro q q' ⟨c, hc⟩ ⟨c', hc'⟩
    refine ⟨c + c', ?_⟩
    have : q + q' - constQ (P := P) (c + c') = (q - constQ c) + (q' - constQ c') := by
      simp only [constQ, map_add]; ring
    rw [this]
    exact Ideal.add_mem _ hc hc'
  zero_mem' := ⟨0, by simp [constQ]⟩
  neg_mem' := by
    rintro q ⟨c, hc⟩
    refine ⟨-c, ?_⟩
    have : -q - constQ (P := P) (-c) = -(q - constQ c) := by
      simp only [constQ, map_neg]; ring
    rw [this]
    exact N.neg_mem hc

theorem mem_constModSubring {N : Ideal Qh} {q : Qh} :
    q ∈ constModSubring (k := k) N ↔ ∃ c : k, q - constQ (P := P) c ∈ N := Iff.rfl

theorem le_constModSubring {N : Ideal Qh} {q : Qh} (hq : q ∈ N) :
    q ∈ constModSubring (k := k) N := ⟨0, by simpa [constQ] using hq⟩

variable [IsNoetherianRing P]

/-- An invertible element congruent to a constant modulo a proper ideal has an inverse congruent
to a constant. -/
theorem inv_mem_constModSubring {N : Ideal Qh} (hN : N ≤ maximalIdeal Qh) {q : Qh}
    (hq : q ∈ constModSubring (k := k) N) (hu : IsUnit q) :
    (hu.unit⁻¹ : Qhˣ).val ∈ constModSubring (k := k) N := by
  obtain ⟨c, hc⟩ := hq
  have hc0 : c ≠ 0 := by
    rintro rfl
    apply (IsLocalRing.mem_maximalIdeal q).mp (hN (by simpa [constQ] using hc)) hu
  refine ⟨c⁻¹, ?_⟩
  have hinv : constQ (P := P) c * constQ c⁻¹ = 1 := by
    simp only [constQ, ← map_mul, mul_inv_cancel₀ hc0, map_one]
  have : (hu.unit⁻¹ : Qhˣ).val - constQ (P := P) c⁻¹ =
      -((hu.unit⁻¹ : Qhˣ).val * constQ (P := P) c⁻¹) * (q - constQ c) := by
    have h1 : (hu.unit⁻¹ : Qhˣ).val * q = 1 := hu.val_inv_mul
    linear_combination (constQ (P := P) c⁻¹) * h1 - (hu.unit⁻¹ : Qhˣ).val * hinv
  rw [this]
  exact Ideal.mul_mem_left _ _ hc

variable (hresP : Function.Bijective (algebraMap k (ResidueField P)))
include hresP

/-- The residue field of `P̂` is `k`. -/
theorem bijective_constQ_residue :
    Function.Bijective fun c : k ↦ residue Qh (constQ (P := P) c) := by
  have h1 : (fun c : k ↦ residue Qh (constQ (P := P) c)) =
      (ResidueField.map (algebraMap P Qh)) ∘ (algebraMap k (ResidueField P)) := by
    ext c
    simp only [constQ, Function.comp_apply]
    rw [IsScalarTower.algebraMap_apply k P (ResidueField P), ResidueField.algebraMap_eq,
      ResidueField.map_residue]
  rw [h1]
  exact (residueField_map_bijective P).comp hresP

omit hresP in
/-- Ideal generators of the maximal ideal span the cotangent space. -/
theorem cotangent_span_top_of_span_eq {Q ι : Type*} [CommRing Q] [IsLocalRing Q]
    [IsNoetherianRing Q] (z : ι → maximalIdeal Q)
    (hz : Ideal.span (Set.range fun i ↦ (z i : Q)) = maximalIdeal Q) :
    ⊤ ≤ Submodule.span (ResidueField Q) (Set.range fun i ↦ (maximalIdeal Q).toCotangent (z i)) := by
  rw [Set.range_comp' ((maximalIdeal Q).toCotangent) z, top_le_iff,
    CotangentSpace.span_image_eq_top_iff]
  apply Submodule.map_injective_of_injective (maximalIdeal Q).injective_subtype
  rw [Submodule.map_span, Submodule.map_top, Submodule.range_subtype, ← Set.range_comp]
  exact hz

variable [IsNoetherianRing O] [IsLocalHom φ]

/-- **The completed local ring of a blowup along a regular stratum.** See the module docstring. -/
theorem exists_chart_coordinates [IsDomain P] [IsDomain Rh]
    (hφk : ∀ c : k, φ (algebraMap k O c) = algebraMap k P c)
    (hresO : Function.Surjective (algebraMap k (ResidueField O)))
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (t : ι → maximalIdeal Rh)
    (htspan : Ideal.span (Set.range fun i ↦ (t i : Rh)) = maximalIdeal Rh)
    (I : Ideal O) (S : Finset ι)
    (hIS : I.map (algebraMap O Rh) = Ideal.span ((fun i ↦ (t i : Rh)) '' (S : Set ι)))
    (g : O) (hg : g ∈ I) (hIg : I.map φ = Ideal.span {φ g}) (hg0 : φ g ≠ 0)
    (hgen : IsChartLocalization φ I g)
    (hdim : (Fintype.card ι : WithBot ℕ∞) ≤ ringKrullDim P) :
    ∃ (j : ι) (z : ι → maximalIdeal Qh) (S' : Finset ι),
      j ∈ S ∧ IsRegularLocalRing Qh ∧
      LinearIndependent (ResidueField Qh) (fun i ↦ (maximalIdeal Qh).toCotangent (z i)) ∧
      Ideal.span (Set.range fun i ↦ (z i : Qh)) = maximalIdeal Qh ∧
      (∀ i ∉ S, (z i : Qh) = completionMap φ (t i)) ∧ (z j : Qh) = completionMap φ (t j) ∧
      S' ⊆ S.erase j ∧
      Ideal.span {algebraMap P Qh (φ g)} = Ideal.span {(z j : Qh)} ∧
      ∀ h : O, Ideal.span {algebraMap O Rh h} = Ideal.span {∏ i ∈ S, (t i : Rh)} →
        ∃ h' : P, φ h = φ g ^ S.card * h' ∧
          Ideal.span {algebraMap P Qh h'} = Ideal.span {∏ i ∈ S', (z i : Qh)} := by
  classical
  set Φ := completionMap φ with hΦdef
  have hΦ : ∀ o : O, Φ (algebraMap O Rh o) = algebraMap P Qh (φ o) := completionMap_algebraMap φ
  set T : ι → Qh := fun i ↦ Φ (t i) with hTdef
  have hT_mem : ∀ i, T i ∈ maximalIdeal Qh := fun i ↦ map_nonunit Φ _ (t i).property
  have hreg : IsSMulRegular Qh (algebraMap P Qh (φ g)) := by
    have : Module.FaithfullyFlat P Qh := faithfullyFlat P
    apply IsSMulRegular.of_flat
    intro a b hab
    exact mul_left_cancel₀ hg0 hab
  -- the exceptional divisor is generated by one of the `t_j`, `j ∈ S`
  have hspanQ : Ideal.span (T '' (S : Set ι)) = Ideal.span {algebraMap P Qh (φ g)} := by
    have h1 : (I.map (algebraMap O Rh)).map Φ = Ideal.span (T '' (S : Set ι)) := by
      rw [hIS, Ideal.map_span, Set.image_image]
    have h2 : (I.map φ).map (algebraMap P Qh) = Ideal.span {algebraMap P Qh (φ g)} := by
      rw [hIg, Ideal.map_span, Set.image_singleton]
    have h3 : (I.map (algebraMap O Rh)).map Φ = (I.map φ).map (algebraMap P Qh) := by
      rw [Ideal.map_map, Ideal.map_map, show Φ.comp (algebraMap O Rh) =
        (algebraMap P Qh).comp φ from RingHom.ext hΦ]
    rw [← h1, h3, h2]
  obtain ⟨j, hjS, hj⟩ := exists_mem_span_singleton_eq T S _ hreg hspanQ
  have hw0 : ∀ l ∈ S, ∃ w : Qh, T l = T j * w := by
    intro l hl
    have : T l ∈ Ideal.span {T j} := by
      rw [hj, ← hspanQ]
      exact Ideal.subset_span ⟨l, hl, rfl⟩
    obtain ⟨w, hw⟩ := Ideal.mem_span_singleton'.mp this
    exact ⟨w, by rw [← hw, mul_comm]⟩
  choose! w0 hw0 using hw0
  set w : ι → Qh := fun l ↦ if l = j then 1 else w0 l with hwdef
  have hw : ∀ l ∈ S, T l = T j * w l := by
    intro l hl
    by_cases hlj : l = j
    · simp [hwdef, hlj]
    · simp only [hwdef, if_neg hlj]
      exact hw0 l hl
  obtain ⟨u0, hu0⟩ : ∃ u0, T j = algebraMap P Qh (φ g) * u0 := by
    have : T j ∈ Ideal.span {algebraMap P Qh (φ g)} := hj ▸ Ideal.mem_span_singleton_self _
    obtain ⟨u0, hu0⟩ := Ideal.mem_span_singleton'.mp this
    exact ⟨u0, by rw [← hu0, mul_comm]⟩
  -- residues of the ratios
  have hbijQ := bijective_constQ_residue (k := k) hresP
  let a : ι → k := fun l ↦ (Equiv.ofBijective _ hbijQ).symm (residue Qh (w l))
  have ha_res : ∀ l, residue Qh (constQ (P := P) (a l)) = residue Qh (w l) := fun l ↦
    (Equiv.ofBijective _ hbijQ).apply_symm_apply _
  have ha : ∀ l, w l - constQ (P := P) (a l) ∈ maximalIdeal Qh := by
    intro l
    rw [← residue_eq_zero_iff, map_sub, sub_eq_zero, ha_res]
  have ha_j : a j = 1 := by
    apply hbijQ.1
    simp only [ha_res, hwdef, if_pos rfl, map_one, constQ]
  -- the ideal `N`
  set N : Ideal Qh := Ideal.span (Set.range T) ⊔
    Ideal.span ((fun l ↦ w l - constQ (P := P) (a l)) '' (S : Set ι)) with hNdef
  have hN_le : N ≤ maximalIdeal Qh := by
    apply sup_le
    · rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      exact hT_mem i
    · rw [Ideal.span_le]
      rintro _ ⟨l, -, rfl⟩
      exact ha l
  -- images of `Ô` are constants modulo `N`
  have hresR : Function.Surjective fun c : k ↦ residue Rh (algebraMap O Rh (algebraMap k O c)) := by
    intro z
    obtain ⟨z', rfl⟩ := (residueField_map_bijective O).2 z
    obtain ⟨c, rfl⟩ := hresO z'
    refine ⟨c, ?_⟩
    simp only
    rw [IsScalarTower.algebraMap_apply k O (ResidueField O), ResidueField.algebraMap_eq,
      ResidueField.map_residue]
  have hconstR : ∀ r : Rh, Φ r ∈ constModSubring (k := k) N := by
    intro r
    obtain ⟨c, hc⟩ := hresR (residue Rh r)
    refine ⟨c, ?_⟩
    have hmem : r - algebraMap O Rh (algebraMap k O c) ∈ Ideal.span (Set.range fun i ↦ (t i : Rh)) := by
      rw [htspan, ← residue_eq_zero_iff, map_sub, sub_eq_zero]
      exact hc.symm
    have heq : Φ r - constQ (P := P) c = Φ (r - algebraMap O Rh (algebraMap k O c)) := by
      rw [map_sub, hΦ, hφk]
    rw [heq]
    have hle : (Ideal.span (Set.range fun i ↦ (t i : Rh))).map Φ ≤ N := by
      rw [Ideal.map_span]
      apply le_sup_of_le_left
      apply Ideal.span_mono
      rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
      exact ⟨i, rfl⟩
    exact hle (Ideal.mem_map_of_mem Φ hmem)
  have hw_const : ∀ l ∈ S, w l ∈ constModSubring (k := k) N := fun l hl ↦
    ⟨a l, Ideal.mem_sup_right (Ideal.subset_span ⟨l, hl, rfl⟩)⟩
  -- expansion of elements of `I`
  have hexpand : ∀ s ∈ I, ∃ ρ : ι → Rh,
      algebraMap P Qh (φ s) = T j * ∑ l ∈ S, Φ (ρ l) * w l := by
    intro s hs
    have : algebraMap O Rh s ∈ Ideal.span ((fun i ↦ (t i : Rh)) '' (S : Set ι)) :=
      hIS ▸ Ideal.mem_map_of_mem _ hs
    obtain ⟨ρ, hρ⟩ := (Submodule.mem_span_image_finset_iff_exists_fun' Rh).mp this
    refine ⟨ρ, ?_⟩
    rw [← hΦ, ← hρ, map_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl fun l hl ↦ ?_
    rw [smul_eq_mul, map_mul]
    change Φ (ρ l) * T l = _
    rw [hw l hl]
    ring
  obtain ⟨ε, hε⟩ := hexpand g hg
  set e : Qh := ∑ l ∈ S, Φ (ε l) * w l with hedef
  have hue : u0 * e = 1 := by
    apply hreg
    simp only [smul_eq_mul, mul_one]
    calc algebraMap P Qh (φ g) * (u0 * e) = T j * e := by rw [hu0]; ring
      _ = algebraMap P Qh (φ g) := hε.symm
  have he_unit : IsUnit e := IsUnit.of_mul_eq_one_right _ hue
  have hu0_unit : IsUnit u0 := IsUnit.of_mul_eq_one _ hue
  have he_const : e ∈ constModSubring (k := k) N :=
    Subring.sum_mem _ fun l hl ↦ Subring.mul_mem _ (hconstR _) (hw_const l hl)
  have hTj_reg : IsSMulRegular Qh (T j) := by
    rw [hu0]
    intro x y hxy
    simp only [smul_eq_mul] at hxy
    apply hreg
    apply hu0_unit.mul_left_cancel
    simp only [smul_eq_mul]
    linear_combination hxy
  -- the chart generators are constants modulo `N`
  have hgen_const : ∀ c ∈ chartGenerators φ I g,
      algebraMap P Qh c ∈ constModSubring (k := k) N := by
    rintro c ⟨s, hs, hsc⟩
    obtain ⟨ρ, hρ⟩ := hexpand s hs
    have h1 : T j * (e * algebraMap P Qh c) = T j * ∑ l ∈ S, Φ (ρ l) * w l := by
      rw [← mul_assoc, ← hε, ← map_mul, hsc, hρ]
    have h2 : e * algebraMap P Qh c = ∑ l ∈ S, Φ (ρ l) * w l := hTj_reg h1
    have h3 : algebraMap P Qh c = (he_unit.unit⁻¹ : Qhˣ).val * ∑ l ∈ S, Φ (ρ l) * w l := by
      rw [← h2, ← mul_assoc, he_unit.val_inv_mul, one_mul]
    rw [h3]
    exact Subring.mul_mem _ (inv_mem_constModSubring hN_le he_const he_unit)
      (Subring.sum_mem _ fun l hl ↦ Subring.mul_mem _ (hconstR _) (hw_const l hl))
  have hB : ∀ b ∈ Subring.closure (Set.range φ ∪ chartGenerators φ I g),
      algebraMap P Qh b ∈ constModSubring (k := k) N := by
    intro b hb
    have hle : Subring.closure (Set.range φ ∪ chartGenerators φ I g) ≤
        (constModSubring (k := k) N).comap (algebraMap P Qh) := by
      rw [Subring.closure_le]
      rintro _ (⟨o, rfl⟩ | hc)
      · change algebraMap P Qh (φ o) ∈ constModSubring (k := k) N
        rw [← hΦ]
        exact hconstR _
      · exact hgen_const _ hc
    exact hle hb
  -- the maximal ideal of `P̂` is `N`
  have hmax : maximalIdeal Qh = N := by
    apply le_antisymm _ hN_le
    rw [AdicCompletion.maximalIdeal_eq_map, Ideal.map_le_iff_le_comap]
    intro p hp
    obtain ⟨b, hb, b', -, hu, hpb⟩ := hgen p
    obtain ⟨c, hc⟩ := hB b hb
    have hbmem : algebraMap P Qh b ∈ maximalIdeal Qh := by
      rw [← hpb, map_mul]
      exact Ideal.mul_mem_right _ _ (map_nonunit (algebraMap P Qh) p hp)
    have hc0 : c = 0 := by
      apply hbijQ.1
      have hcm : constQ (P := P) c ∈ maximalIdeal Qh := by
        have := Ideal.sub_mem _ hbmem (hN_le hc)
        simpa using this
      simp only [constQ, map_zero]
      rw [(residue_eq_zero_iff _).mpr hcm]
    rw [hc0] at hc
    simp only [constQ, map_zero, sub_zero] at hc
    show algebraMap P Qh p ∈ N
    have : algebraMap P Qh p = algebraMap P Qh b * algebraMap P Qh (hu.unit⁻¹ : Pˣ).val := by
      rw [← map_mul, ← hpb, mul_assoc, hu.mul_val_inv, mul_one]
    rw [this]
    exact Ideal.mul_mem_right _ _ hc
  -- the coordinates `z`
  let z0 : ι → Qh := fun i ↦ if i ∈ S ∧ i ≠ j then w i - constQ (P := P) (a i) else T i
  have hz0_mem : ∀ i, z0 i ∈ maximalIdeal Qh := by
    intro i
    by_cases hi : i ∈ S ∧ i ≠ j
    · simp only [z0, if_pos hi]; exact ha i
    · simp only [z0, if_neg hi]; exact hT_mem i
  let z : ι → maximalIdeal Qh := fun i ↦ ⟨z0 i, hz0_mem i⟩
  have hz_not : ∀ i ∉ S, (z i : Qh) = T i := fun i hi ↦ by
    simp only [z, z0, if_neg (fun h : i ∈ S ∧ i ≠ j ↦ hi h.1)]
  have hz_j : (z j : Qh) = T j := by simp only [z, z0, if_neg (fun h : j ∈ S ∧ j ≠ j ↦ h.2 rfl)]
  have hz_ne : ∀ l ∈ S, l ≠ j → (z l : Qh) = w l - constQ (P := P) (a l) := fun l hl hlj ↦ by
    simp only [z, z0, if_pos (And.intro hl hlj)]
  have hzspan : Ideal.span (Set.range fun i ↦ (z i : Qh)) = maximalIdeal Qh := by
    refine (?_ : _ = N).trans hmax.symm
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      by_cases hi : i ∈ S ∧ i ≠ j
      · change z0 i ∈ N
        simp only [z0, if_pos hi]
        exact Ideal.mem_sup_right (Ideal.subset_span ⟨i, hi.1, rfl⟩)
      · change z0 i ∈ N
        simp only [z0, if_neg hi]
        exact Ideal.mem_sup_left (Ideal.subset_span ⟨i, rfl⟩)
    · apply sup_le
      · rw [Ideal.span_le]
        rintro _ ⟨i, rfl⟩
        by_cases hi : i ∈ S ∧ i ≠ j
        · rw [hw i hi.1, ← hz_j]
          exact Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨j, rfl⟩)
        · have : (z i : Qh) = T i := by simp only [z, z0, if_neg hi]
          rw [← this]
          exact Ideal.subset_span ⟨i, rfl⟩
      · rw [Ideal.span_le]
        rintro _ ⟨l, hl, rfl⟩
        by_cases hlj : l = j
        · subst hlj
          simp only [hwdef, if_pos rfl, ha_j, constQ, map_one, sub_self]
          exact Ideal.zero_mem _
        · change w l - constQ (P := P) (a l) ∈ _
          rw [← hz_ne l hl hlj]
          exact Ideal.subset_span ⟨l, rfl⟩
  -- regularity
  have hspan_le : ((maximalIdeal Qh).spanFinrank : WithBot ℕ∞) ≤ Fintype.card ι := by
    rw [← hzspan]
    have h1 := Submodule.spanFinrank_span_le_ncard_of_finite
      (R := Qh) (Set.finite_range fun i ↦ (z i : Qh))
    have h2 : (Set.range fun i ↦ (z i : Qh)).ncard ≤ Fintype.card ι := by
      rw [← Set.image_univ, ← Finset.coe_univ]
      exact (Set.ncard_image_le (Finset.finite_toSet _)).trans (by simp)
    exact_mod_cast h1.trans h2
  have hdimQ : ringKrullDim P ≤ ringKrullDim Qh := ringKrullDim_le_completion P
  have hregQ : IsRegularLocalRing Qh :=
    IsRegularLocalRing.of_spanFinrank_maximalIdeal_le Qh (hspan_le.trans (hdim.trans hdimQ))
  have hcard : Fintype.card ι = Module.finrank (ResidueField Qh) (CotangentSpace Qh) := by
    have h1 := (IsRegularLocalRing.iff_finrank_cotangentSpace Qh).mp hregQ
    have h2 := ringKrullDim_le_spanFinrank_maximalIdeal (R := Qh)
    rw [spanFinrank_maximalIdeal_eq_finrank_cotangentSpace] at hspan_le h2
    have h3 : (Module.finrank (ResidueField Qh) (CotangentSpace Qh) : WithBot ℕ∞) ≤
        Fintype.card ι := hspan_le
    have h4 : (Fintype.card ι : WithBot ℕ∞) ≤ Module.finrank (ResidueField Qh) (CotangentSpace Qh) :=
      (hdim.trans hdimQ).trans h2
    exact_mod_cast le_antisymm h4 h3
  have hli : LinearIndependent (ResidueField Qh)
      (fun i ↦ (maximalIdeal Qh).toCotangent (z i)) :=
    linearIndependent_of_top_le_span_of_card_eq_finrank
      (cotangent_span_top_of_span_eq z hzspan) hcard
  refine ⟨j, z, (S.erase j).filter (fun l ↦ a l = 0), hjS, hregQ, hli, hzspan, hz_not, hz_j,
    Finset.filter_subset _ _, ?_, ?_⟩
  · rw [hz_j, hj]
  · intro h hh
    -- `h ∈ I ^ |S|`
    have hhI : h ∈ I ^ S.card := by
      rw [← comap_map O (I ^ S.card), Ideal.mem_comap, Ideal.map_pow, hIS]
      have : algebraMap O Rh h ∈ Ideal.span {∏ i ∈ S, (t i : Rh)} :=
        hh ▸ Ideal.mem_span_singleton_self _
      refine (Ideal.span_singleton_le_iff_mem _).mpr ?_ |>.trans_eq rfl |> fun h' ↦ h' this
      exact prod_mem_pow_card _ S _ fun i hi ↦ Ideal.subset_span ⟨i, hi, rfl⟩
    have hφh : φ h ∈ Ideal.span {φ g ^ S.card} := by
      rw [← Ideal.span_singleton_pow, ← hIg, ← Ideal.map_pow]
      exact Ideal.mem_map_of_mem φ hhI
    obtain ⟨h', hh'⟩ := Ideal.mem_span_singleton'.mp hφh
    refine ⟨h', by rw [← hh', mul_comm], ?_⟩
    -- the unit relating `h` and the product of parameters
    obtain ⟨v, hv⟩ := Ideal.span_singleton_eq_span_singleton.mp hh
    -- `∏ t = h * v`
    have hΦh : algebraMap P Qh (φ h) = Φ (v⁻¹ : Rhˣ) * (T j ^ S.card * ∏ l ∈ S, w l) := by
      have : algebraMap O Rh h = (∏ i ∈ S, (t i : Rh)) * (v⁻¹ : Rhˣ) := by
        rw [← hv, mul_assoc, Units.mul_inv, mul_one]
      rw [← hΦ, this, map_mul, map_prod, mul_comm]
      congr 1
      rw [← Finset.prod_const, ← Finset.prod_mul_distrib]
      exact Finset.prod_congr rfl fun l hl ↦ hw l hl
    have hkey : T j ^ S.card * (e ^ S.card * algebraMap P Qh h') =
        T j ^ S.card * (Φ (v⁻¹ : Rhˣ) * ∏ l ∈ S, w l) := by
      calc T j ^ S.card * (e ^ S.card * algebraMap P Qh h') =
          (T j * e) ^ S.card * algebraMap P Qh h' := by ring
        _ = algebraMap P Qh (φ h) := by rw [← hε, ← map_pow, ← map_mul, ← hh', mul_comm]
        _ = _ := by rw [hΦh]; ring
    have hcancel : e ^ S.card * algebraMap P Qh h' = Φ (v⁻¹ : Rhˣ) * ∏ l ∈ S, w l :=
      (hTj_reg.pow S.card) hkey
    -- split the product of the ratios
    have hsplit : ∏ l ∈ S, w l = (∏ l ∈ (S.erase j).filter (fun l ↦ a l = 0), (z l : Qh)) *
        ∏ l ∈ (S.erase j).filter (fun l ↦ ¬ a l = 0), w l := by
      have hwj : w j = 1 := by simp [hwdef]
      rw [← Finset.mul_prod_erase S w hjS, hwj, one_mul,
        ← Finset.prod_filter_mul_prod_filter_not (S.erase j) (fun l ↦ a l = 0)]
      congr 1
      refine Finset.prod_congr rfl fun l hl ↦ ?_
      rw [Finset.mem_filter, Finset.mem_erase] at hl
      rw [hz_ne l hl.1.2 hl.1.1, hl.2]
      simp [constQ]
    have hunit2 : IsUnit (∏ l ∈ (S.erase j).filter (fun l ↦ ¬ a l = 0), w l) := by
      refine IsUnit.prod_iff.mpr fun l hl ↦ ?_
      rw [Finset.mem_filter] at hl
      rw [← IsLocalRing.notMem_maximalIdeal, ← residue_eq_zero_iff, ← ha_res]
      intro h0
      apply hl.2
      apply hbijQ.1
      simp only [h0, constQ, map_zero]
    have hfinal : algebraMap P Qh h' = (∏ l ∈ (S.erase j).filter (fun l ↦ a l = 0), (z l : Qh)) *
        (((he_unit.pow S.card).unit⁻¹ : Qhˣ).val * Φ (v⁻¹ : Rhˣ) *
          ∏ l ∈ (S.erase j).filter (fun l ↦ ¬ a l = 0), w l) := by
      have : algebraMap P Qh h' = ((he_unit.pow S.card).unit⁻¹ : Qhˣ).val *
          (e ^ S.card * algebraMap P Qh h') := by
        rw [← mul_assoc, (he_unit.pow S.card).val_inv_mul, one_mul]
      rw [this, hcancel, hsplit]
      ring
    have hu3 : IsUnit (((he_unit.pow S.card).unit⁻¹ : Qhˣ).val * Φ (v⁻¹ : Rhˣ) *
        ∏ l ∈ (S.erase j).filter (fun l ↦ ¬ a l = 0), w l) :=
      ((Units.isUnit _).mul ((Units.map Φ.toMonoidHom (v⁻¹)).isUnit)).mul hunit2
    rw [hfinal, Ideal.span_singleton_mul_right_unit hu3]

end Chart

section ChartHypotheses

variable {O P O' P' : Type*} [CommRing O] [CommRing P] [CommRing O'] [CommRing P']

/-- The chart condition is transported along ring isomorphisms of source and target. -/
theorem IsChartLocalization.of_ringEquiv (φ : O →+* P) (φ' : O' →+* P') (α : O ≃+* O')
    (β : P ≃+* P') (hcomm : ∀ o, β (φ o) = φ' (α o)) (I : Ideal O) (g : O)
    (H : IsChartLocalization φ' (I.map α) (α g)) : IsChartLocalization φ I g := by
  intro u
  obtain ⟨b, hb, b', hb', hu, hub⟩ := H (β u)
  have hφ : ∀ o', β.symm (φ' o') = φ (α.symm o') := by
    intro o'
    apply β.injective
    rw [RingEquiv.apply_symm_apply, hcomm, RingEquiv.apply_symm_apply]
  have hcl : ∀ z ∈ Subring.closure (Set.range φ' ∪ chartGenerators φ' (I.map α) (α g)),
      β.symm z ∈ Subring.closure (Set.range φ ∪ chartGenerators φ I g) := by
    intro z hz
    have hle : Subring.closure (Set.range φ' ∪ chartGenerators φ' (I.map α) (α g)) ≤
        (Subring.closure (Set.range φ ∪ chartGenerators φ I g)).comap β.symm.toRingHom := by
      rw [Subring.closure_le]
      rintro _ (⟨o', rfl⟩ | ⟨s', hs', hc⟩)
      · exact Subring.subset_closure (Or.inl ⟨α.symm o', (hφ o').symm⟩)
      · refine Subring.subset_closure (Or.inr ⟨α.symm s', ?_, ?_⟩)
        · have : s' ∈ I.map (α : O →+* O') := hs'
          rw [Ideal.map_comap_of_equiv] at this
          simpa using this
        · apply β.injective
          simp only [map_mul, RingEquiv.apply_symm_apply, hcomm]
          rw [← hc]
          simp
    exact hle hz
  refine ⟨β.symm b, hcl b hb, β.symm b', hcl b' hb', hu.map β.symm, ?_⟩
  rw [← hub, map_mul, RingEquiv.symm_apply_apply]

/-- The principal-ideal condition is transported along ring isomorphisms. -/
theorem map_eq_span_of_ringEquiv (φ : O →+* P) (φ' : O' →+* P') (α : O ≃+* O')
    (β : P ≃+* P') (hcomm : ∀ o, β (φ o) = φ' (α o)) (I : Ideal O) (g : O)
    (H : (I.map α).map φ' = Ideal.span {φ' (α g)}) : I.map φ = Ideal.span {φ g} := by
  have h1 : (I.map φ).map (β : P →+* P') = Ideal.span {β (φ g)} := by
    rw [Ideal.map_map, show (β : P →+* P').comp φ = φ'.comp (α : O →+* O') from
      RingHom.ext hcomm, ← Ideal.map_map, hcomm]
    exact H
  have h2 := congrArg (Ideal.map (β.symm : P' →+* P)) h1
  rw [Ideal.map_map, Ideal.map_span, Set.image_singleton] at h2
  simpa using h2

variable {A : Type*} [CommRing A] [IsDomain A]

/-- The fraction chart `A[I/a]` is generated by `A` and the fractions `a'/a`, `a' ∈ I`. -/
theorem mem_closure_fractionChart (I : Ideal A) (a : A) (ha0 : a ≠ 0)
    (b : affineBlowupFractionChart I a) :
    b ∈ Subring.closure (Set.range (algebraMap A (affineBlowupFractionChart I a)) ∪
      {c | ∃ a' ∈ I, algebraMap A (affineBlowupFractionChart I a) a * c =
        algebraMap A (affineBlowupFractionChart I a) a'}) := by
  obtain ⟨b, hb⟩ := b
  induction hb using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨⟨a', ha'⟩, rfl⟩ := hx
    exact Subring.subset_closure (Or.inr ⟨a', ha', by
      have := affineBlowupFractionChart_mul_ratio I a ha0 a' ha'
      exact this⟩)
  | algebraMap r => exact Subring.subset_closure (Or.inl ⟨r, rfl⟩)
  | add x y hx hy ihx ihy => exact Subring.add_mem _ ihx ihy
  | mul x y hx hy ihx ihy => exact Subring.mul_mem _ ihx ihy

variable {B : Type*} [CommRing B]

omit [IsDomain A] in
/-- **Chart hypotheses at a prime of a blowup chart.** For a ring map `θ : A → B` such that `B` is
generated by `θ(A)` and fractions `c` with `θ(a) c = θ(a')`, `a' ∈ I`, and `I B = (θ a)`, the local
homomorphism `A_𝔭 → B_𝔮` satisfies the chart hypotheses of `exists_chart_coordinates`. -/
theorem isChartLocalization_localRingHom (θ : A →+* B) (I : Ideal A) (a : A)
    (hgen : ∀ b : B, b ∈ Subring.closure (Set.range θ ∪ {c | ∃ a' ∈ I, θ a * c = θ a'}))
    (p : Ideal A) [p.IsPrime] (q : Ideal B) [q.IsPrime] (hpq : p = q.comap θ) :
    IsChartLocalization (Localization.localRingHom p q θ hpq)
      (I.map (algebraMap A (Localization.AtPrime p))) (algebraMap A _ a) := by
  intro u
  obtain ⟨⟨b, s⟩, hbs⟩ := IsLocalization.surj q.primeCompl u
  have hcl : ∀ z : B, algebraMap B (Localization.AtPrime q) z ∈
      Subring.closure (Set.range (Localization.localRingHom p q θ hpq) ∪
        chartGenerators (Localization.localRingHom p q θ hpq)
          (I.map (algebraMap A (Localization.AtPrime p))) (algebraMap A _ a)) := by
    intro z
    have hle : Subring.closure (Set.range θ ∪ {c | ∃ a' ∈ I, θ a * c = θ a'}) ≤
        (Subring.closure (Set.range (Localization.localRingHom p q θ hpq) ∪
          chartGenerators (Localization.localRingHom p q θ hpq)
            (I.map (algebraMap A (Localization.AtPrime p))) (algebraMap A _ a))).comap
          (algebraMap B (Localization.AtPrime q)) := by
      rw [Subring.closure_le]
      rintro _ (⟨a'', rfl⟩ | ⟨a', ha', hc⟩)
      · exact Subring.subset_closure (Or.inl ⟨algebraMap A _ a'',
          Localization.localRingHom_to_map p q θ hpq a''⟩)
      · refine Subring.subset_closure (Or.inr ⟨algebraMap A _ a', Ideal.mem_map_of_mem _ ha', ?_⟩)
        rw [Localization.localRingHom_to_map, Localization.localRingHom_to_map, ← map_mul, hc]
    exact hle (hgen z)
  refine ⟨_, hcl b, _, hcl s, IsLocalization.map_units _ s, hbs⟩

omit [IsDomain A] in
theorem map_localRingHom_eq_span (θ : A →+* B) (I : Ideal A) (a : A)
    (hI : I.map θ = Ideal.span {θ a})
    (p : Ideal A) [p.IsPrime] (q : Ideal B) [q.IsPrime] (hpq : p = q.comap θ) :
    (I.map (algebraMap A (Localization.AtPrime p))).map (Localization.localRingHom p q θ hpq) =
      Ideal.span {Localization.localRingHom p q θ hpq (algebraMap A _ a)} := by
  rw [Ideal.map_map, Localization.localRingHom_to_map]
  have : (Localization.localRingHom p q θ hpq).comp (algebraMap A (Localization.AtPrime p)) =
      (algebraMap B (Localization.AtPrime q)).comp θ := by
    ext x
    exact Localization.localRingHom_to_map p q θ hpq x
  rw [this, ← Ideal.map_map, hI, Ideal.map_span, Set.image_singleton]

end ChartHypotheses

