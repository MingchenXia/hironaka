import DeJongAlterations.StableModification.Resolution.LocalNode
import Mathlib.RingTheory.KrullDimension.NonZeroDivisors
import Mathlib.RingTheory.MvPowerSeries.Equiv
import Mathlib.RingTheory.PowerSeries.Ideal
import Mathlib.RingTheory.RegularLocalRing.Defs

/-!
# Regularity of the local models

The regularity statements behind de Jong's local analysis of a semi-stable curve over a regular
base (de Jong 1996, 3.1, 3.3, 3.4, `references/dejong96-alterations/tex/page-0013.tex`,
`page-0014.tex`):

* 3.1, "`Sing(X) ⊆ Sing(f)`": at a smooth point the complete local ring is `A[[w]]` with `A`
  regular, and `A[[w]]` is regular (`isRegularLocalRing_powerSeries`).
* 3.3, "if `∑ n_i = 1`, then the point `x` is regular on `X`": `A[[u,v]]/(uv - t)` is regular for
  `t ∈ 𝔪_A ∖ 𝔪_A²` (`isRegularLocalRing_splitNodeRing_of_parameter`), so a non-regular node
  `A[[u,v]]/(uv - ∏ t_i^{n_i})` has `∑ n_i ≥ 2` (`two_le_sum_of_not_isRegularLocalRing`).

Both use only the inequalities `dim A + 1 ≤ dim A[[w]]` (Mathlib) and `dim R ≤ dim R/(f) + 1` for
a local Noetherian ring (Krull), together with explicit generators of the maximal ideals.
-/

noncomputable section

namespace DeJongAlterations.StableModification.Resolution

open IsLocalRing MvPowerSeries

variable {A : Type*} [CommRing A]

section PowerSeries

/-- The maximal ideal of `A[[w]]` over a local ring is generated by `w` and generators of `𝔪_A`. -/
theorem maximalIdeal_powerSeries [IsLocalRing A] (s : Set A)
    (hs : Ideal.span s = maximalIdeal A) :
    maximalIdeal (PowerSeries A) =
      Ideal.span (insert PowerSeries.X ((PowerSeries.C : A →+* PowerSeries A) '' s)) := by
  apply le_antisymm
  · intro f hf
    have hc : PowerSeries.constantCoeff f ∈ maximalIdeal A := by
      intro hu
      exact hf (PowerSeries.isUnit_iff_constantCoeff.mpr hu)
    have hdvd : PowerSeries.X ∣ f - PowerSeries.C (PowerSeries.constantCoeff f) := by
      rw [PowerSeries.X_dvd_iff]
      simp
    obtain ⟨g, hg⟩ := hdvd
    have hC : PowerSeries.C (PowerSeries.constantCoeff f) ∈
        Ideal.span (insert PowerSeries.X ((PowerSeries.C : A →+* PowerSeries A) '' s)) := by
      have : PowerSeries.C (PowerSeries.constantCoeff f) ∈
          (Ideal.span s).map (PowerSeries.C : A →+* PowerSeries A) := by
        rw [hs]
        exact Ideal.mem_map_of_mem _ hc
      rw [Ideal.map_span] at this
      exact Ideal.span_mono (Set.subset_insert _ _) this
    have hX : PowerSeries.X * g ∈
        Ideal.span (insert PowerSeries.X ((PowerSeries.C : A →+* PowerSeries A) '' s)) :=
      Ideal.mul_mem_right _ _ (Ideal.subset_span (Set.mem_insert _ _))
    have : f = PowerSeries.C (PowerSeries.constantCoeff f) + PowerSeries.X * g := by
      rw [← hg]
      ring
    rw [this]
    exact Ideal.add_mem _ hC hX
  · apply Ideal.span_le.mpr
    rintro f (rfl | ⟨a, ha, rfl⟩)
    · intro hu
      have := PowerSeries.isUnit_iff_constantCoeff.mp hu
      simp at this
    · intro hu
      have := PowerSeries.isUnit_iff_constantCoeff.mp hu
      rw [PowerSeries.constantCoeff_C] at this
      exact (hs ▸ Ideal.subset_span ha : a ∈ maximalIdeal A) this

/-- **de Jong 3.1 (`Sing(X) ⊆ Sing(f)`), algebraic form.** A power series ring in one variable
over a regular local ring is a regular local ring. -/
theorem isRegularLocalRing_powerSeries [IsRegularLocalRing A] :
    IsRegularLocalRing (PowerSeries A) := by
  obtain ⟨s, hscard, hspan⟩ :=
    Submodule.FG.exists_span_finset_card_eq_spanFinrank (IsNoetherian.noetherian (maximalIdeal A))
  have hgen := maximalIdeal_powerSeries (A := A) (s : Set A) hspan
  apply IsRegularLocalRing.of_spanFinrank_maximalIdeal_le
  have hfin : (insert (PowerSeries.X : PowerSeries A)
      ((PowerSeries.C : A →+* PowerSeries A) '' (s : Set A))).Finite :=
    ((s.finite_toSet.image _).insert _)
  have h1 : (maximalIdeal (PowerSeries A)).spanFinrank ≤ s.card + 1 := by
    rw [hgen]
    refine (Submodule.spanFinrank_span_le_ncard_of_finite hfin).trans ?_
    refine (Set.ncard_insert_le _ _).trans ?_
    gcongr
    refine (Set.ncard_image_le s.finite_toSet).trans ?_
    rw [Set.ncard_coe_finset]
  have h2 : ((s.card + 1 : ℕ) : WithBot ℕ∞) = ringKrullDim A + 1 := by
    rw [hscard]
    push_cast
    rw [(isRegularLocalRing_iff A).mp inferInstance]
  calc ((maximalIdeal (PowerSeries A)).spanFinrank : WithBot ℕ∞)
      ≤ ((s.card + 1 : ℕ) : WithBot ℕ∞) := by exact_mod_cast h1
    _ = ringKrullDim A + 1 := h2
    _ ≤ ringKrullDim (PowerSeries A) := ringKrullDim_succ_le_ringKrullDim_powerseries

end PowerSeries

section TwoVariables

/-- `dim A + 2 ≤ dim A[[u,v]]`. -/
theorem ringKrullDim_add_two_le_mvPowerSeries_fin_two :
    ringKrullDim A + 2 ≤ ringKrullDim (MvPowerSeries (Fin 2) A) := by
  have e2 := ringKrullDim_eq_of_ringEquiv (MvPowerSeries.finSuccEquiv A 1).toRingEquiv
  have e1 := ringKrullDim_eq_of_ringEquiv (MvPowerSeries.finSuccEquiv A 0).toRingEquiv
  have e0 := ringKrullDim_eq_of_ringEquiv (MvPowerSeries.isEmptyEquiv (Fin 0) A).toRingEquiv
  have h2 := ringKrullDim_succ_le_ringKrullDim_powerseries (R := MvPowerSeries (Fin 1) A)
  have h1 := ringKrullDim_succ_le_ringKrullDim_powerseries (R := MvPowerSeries (Fin 0) A)
  rw [e2]
  refine le_trans ?_ h2
  rw [e1]
  have h1' := add_le_add h1 (le_refl (1 : WithBot ℕ∞))
  refine le_trans ?_ h1'
  rw [e0, add_assoc]
  norm_num

/-- The maximal ideal of `A[[u,v]]` over a local ring is generated by `u`, `v` and generators
of `𝔪_A`. -/
theorem maximalIdeal_mvPowerSeries_fin_two [IsLocalRing A] (s : Set A)
    (hs : Ideal.span s = maximalIdeal A) :
    maximalIdeal (MvPowerSeries (Fin 2) A) =
      Ideal.span (insert (X 0) (insert (X 1) ((C : A →+* MvPowerSeries (Fin 2) A) '' s))) := by
  set J := Ideal.span (insert (X 0) (insert (X 1) ((C : A →+* MvPowerSeries (Fin 2) A) '' s)))
  apply le_antisymm
  · intro f hf
    have hc : constantCoeff f ∈ maximalIdeal A := by
      intro hu
      exact hf (MvPowerSeries.isUnit_iff_constantCoeff.mpr hu)
    have hC : C (constantCoeff f) ∈ J := by
      have : C (constantCoeff f) ∈ (Ideal.span s).map (C : A →+* MvPowerSeries (Fin 2) A) := by
        rw [hs]
        exact Ideal.mem_map_of_mem _ hc
      rw [Ideal.map_span] at this
      exact Ideal.span_mono ((Set.subset_insert _ _).trans (Set.subset_insert _ _)) this
    rw [Algebra.NodeFormalMorse.decomposition f]
    refine Ideal.add_mem _ (Ideal.add_mem _ hC ?_) ?_
    · exact Ideal.mul_mem_right _ _ (Ideal.subset_span (Set.mem_insert _ _))
    · exact Ideal.mul_mem_right _ _
        (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_insert _ _)))
  · apply Ideal.span_le.mpr
    rintro f (rfl | rfl | ⟨a, ha, rfl⟩)
    · intro hu
      have := MvPowerSeries.isUnit_iff_constantCoeff.mp hu
      simp at this
    · intro hu
      have := MvPowerSeries.isUnit_iff_constantCoeff.mp hu
      simp at this
    · intro hu
      have := MvPowerSeries.isUnit_iff_constantCoeff.mp hu
      rw [constantCoeff_C] at this
      exact (hs ▸ Ideal.subset_span ha : a ∈ maximalIdeal A) this

variable (A) in
/-- The equation `uv - h` of the split node lies in the maximal ideal of `A[[u,v]]` if `h ∈ 𝔪_A`. -/
theorem splitNodeEquation_mem_maximalIdeal [IsLocalRing A] {h : A} (hh : h ∈ maximalIdeal A) :
    X (0 : Fin 2) * X 1 - C h ∈ maximalIdeal (MvPowerSeries (Fin 2) A) := by
  intro hu
  have := MvPowerSeries.isUnit_iff_constantCoeff.mp hu
  simp only [map_sub, map_mul, constantCoeff_X, mul_zero, constantCoeff_C, zero_sub,
    IsUnit.neg_iff] at this
  exact hh this

variable (A) in
/-- The split node ring `A[[u,v]]/(uv - h)` over a local ring with `h ∈ 𝔪_A` is local. -/
theorem splitNodeRing_isLocalRing [IsLocalRing A] {h : A} (hh : h ∈ maximalIdeal A) :
    IsLocalRing (SplitNodeRing A h) := by
  have hne : Ideal.span {X (0 : Fin 2) * X 1 - C h} ≠ ⊤ := by
    intro htop
    rw [Ideal.span_singleton_eq_top] at htop
    exact splitNodeEquation_mem_maximalIdeal A hh htop
  let : Nontrivial (SplitNodeRing A h) := Ideal.Quotient.nontrivial_iff.mpr hne
  exact IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective

/-- **de Jong 3.3, "if `∑ n_i = 1`, then the point `x` is regular on `X`".** Over a regular local
ring `A`, the split node `A[[u,v]]/(uv - t)` with `t ∈ 𝔪_A ∖ 𝔪_A²` is a regular local ring. -/
theorem isRegularLocalRing_splitNodeRing_of_parameter [IsRegularLocalRing A] {t : A}
    (ht : t ∈ maximalIdeal A) (ht2 : t ∉ maximalIdeal A ^ 2) :
    IsRegularLocalRing (SplitNodeRing A t) := by
  let : IsLocalRing (SplitNodeRing A t) := splitNodeRing_isLocalRing A ht
  let π : MvPowerSeries (Fin 2) A →+* SplitNodeRing A t := Ideal.Quotient.mk _
  have hπ : Function.Surjective π := Ideal.Quotient.mk_surjective
  obtain ⟨n, x, hgen, hrank⟩ := Algebra.RegularQuotient.exists_parameter_generators A t ht ht2
  -- generators of the maximal ideal of the node ring
  have hmaxS : maximalIdeal (MvPowerSeries (Fin 2) A) =
      Ideal.span (insert (X 0) (insert (X 1)
        ((C : A →+* MvPowerSeries (Fin 2) A) '' insert t (Set.range x)))) :=
    maximalIdeal_mvPowerSeries_fin_two _ hgen
  let G : Set (SplitNodeRing A t) :=
    insert (π (X 0)) (insert (π (X 1)) (Set.range fun i => π (C (x i))))
  have hmaxB : maximalIdeal (SplitNodeRing A t) = Ideal.span G := by
    rw [← map_maximalIdeal_of_surjective π hπ, hmaxS, Ideal.map_span]
    apply le_antisymm
    · apply Ideal.span_le.mpr
      rintro _ ⟨f, hf, rfl⟩
      rcases hf with rfl | rfl | ⟨a, ha, rfl⟩
      · exact Ideal.subset_span (Set.mem_insert _ _)
      · exact Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_insert _ _))
      · rcases ha with rfl | ⟨i, rfl⟩
        · -- `t = uv` in the node ring
          have hz : π (X 0 * X 1 - C a) = 0 :=
            Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton _))
          rw [map_sub, sub_eq_zero] at hz
          rw [← hz, map_mul]
          exact Ideal.mul_mem_right _ _ (Ideal.subset_span (Set.mem_insert _ _))
        · exact Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ ⟨i, rfl⟩))
    · apply Ideal.span_le.mpr
      rintro _ (rfl | rfl | ⟨i, rfl⟩)
      · exact Ideal.subset_span ⟨X 0, Set.mem_insert _ _, rfl⟩
      · exact Ideal.subset_span ⟨X 1, Set.mem_insert_of_mem _ (Set.mem_insert _ _), rfl⟩
      · exact Ideal.subset_span ⟨C (x i), Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _
          ⟨x i, Set.mem_insert_of_mem _ ⟨i, rfl⟩, rfl⟩), rfl⟩
  apply IsRegularLocalRing.of_spanFinrank_maximalIdeal_le
  have hfin : G.Finite := ((Set.finite_range _).insert _).insert _
  have h1 : (maximalIdeal (SplitNodeRing A t)).spanFinrank ≤ n + 2 := by
    rw [hmaxB]
    refine (Submodule.spanFinrank_span_le_ncard_of_finite hfin).trans ?_
    refine (Set.ncard_insert_le _ _).trans ?_
    have : (insert (π (X 1)) (Set.range fun i => π (C (x i)))).ncard ≤ n + 1 := by
      refine (Set.ncard_insert_le _ _).trans ?_
      gcongr
      rw [← Set.image_univ]
      refine (Set.ncard_image_le Set.finite_univ).trans ?_
      simp
    omega
  -- dimension estimate: `dim A + 2 ≤ dim A[[u,v]] ≤ dim B + 1`
  have hdimA : ringKrullDim A = ((n + 1 : ℕ) : WithBot ℕ∞) := by
    rw [← (isRegularLocalRing_iff A).mp inferInstance, hrank]
  have hle := Algebra.RegularQuotient.ringKrullDim_le_quotient_parameter_add_one
    (MvPowerSeries (Fin 2) A) (splitNodeEquation_mem_maximalIdeal A ht)
  have h2 := (ringKrullDim_add_two_le_mvPowerSeries_fin_two (A := A)).trans hle
  rw [hdimA] at h2
  have h3 : (((n + 2 : ℕ) : WithBot ℕ∞)) + 1 ≤ ringKrullDim (SplitNodeRing A t) + 1 := by
    have : (((n + 1 : ℕ) : WithBot ℕ∞)) + 2 = (((n + 2 : ℕ) : WithBot ℕ∞)) + 1 := by
      push_cast
      ring
    rw [← this]
    exact h2
  have h4 : (((n + 2 : ℕ) : WithBot ℕ∞)) ≤ ringKrullDim (SplitNodeRing A t) :=
    (ENat.WithBot.add_le_add_one_right_iff).mp h3
  calc ((maximalIdeal (SplitNodeRing A t)).spanFinrank : WithBot ℕ∞)
      ≤ ((n + 2 : ℕ) : WithBot ℕ∞) := by exact_mod_cast h1
    _ ≤ ringKrullDim (SplitNodeRing A t) := h4

/-- A monomial of total degree one is one of the variables. -/
theorem prod_pow_eq_of_sum_eq_one {ι : Type*} [Fintype ι] [DecidableEq ι] (t : ι → A)
    (n : ι → ℕ) (hn : ∑ i, n i = 1) : ∃ j, ∏ i, t i ^ n i = t j := by
  have hex : ∃ j, n j ≠ 0 := by
    by_contra hall
    simp only [ne_eq, not_exists, not_not] at hall
    simp [hall] at hn
  obtain ⟨j, hj⟩ := hex
  have hothers : ∀ i, i ≠ j → n i = 0 := by
    intro i hij
    have hsum := Finset.add_le_sum (f := n) (fun _ _ => Nat.zero_le _) (Finset.mem_univ i)
      (Finset.mem_univ j) hij
    omega
  have hnj : n j = 1 := by
    have := Finset.single_le_sum (f := n) (fun _ _ => Nat.zero_le _) (Finset.mem_univ j)
    omega
  refine ⟨j, ?_⟩
  rw [Fintype.prod_eq_single j (fun i hi => by simp [hothers i hi]), hnj, pow_one]

/-- **de Jong 3.3 / 3.4.** If the node `A[[u,v]]/(uv - ∏ t_i^{n_i})` over a regular local ring,
with all `t_i ∈ 𝔪_A ∖ 𝔪_A²` and `∑ n_i ≥ 1`, is not regular, then `∑ n_i ≥ 2`. -/
theorem two_le_sum_of_not_isRegularLocalRing [IsRegularLocalRing A] {ι : Type*} [Fintype ι]
    [DecidableEq ι] (t : ι → A) (ht : ∀ i, t i ∈ maximalIdeal A)
    (ht2 : ∀ i, t i ∉ maximalIdeal A ^ 2) (n : ι → ℕ) (hn : 1 ≤ ∑ i, n i)
    (hsing : ¬ IsRegularLocalRing (SplitNodeRing A (∏ i, t i ^ n i))) : 2 ≤ ∑ i, n i := by
  by_contra hlt
  have hone : ∑ i, n i = 1 := by omega
  obtain ⟨j, hj⟩ := prod_pow_eq_of_sum_eq_one t n hone
  rw [hj] at hsing
  exact hsing (isRegularLocalRing_splitNodeRing_of_parameter (ht j) (ht2 j))

end TwoVariables

end DeJongAlterations.StableModification.Resolution
