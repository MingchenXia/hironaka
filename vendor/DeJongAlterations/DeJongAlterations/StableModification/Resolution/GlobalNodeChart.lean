import DeJongAlterations.StableModification.Resolution.GlobalChart

/-!
# The charts of the blowups of de Jong 3.4 and 4.27

Let `Q` be a Noetherian local `k`-algebra with residue field `k` whose maximal ideal is generated by
`U, V, Z_1, …, Z_m` with `UV = ∏ Z_i^{n_i}` (a *node presentation*; in the application `Q` is the
completion of the local ring of a variety at a closed point, and the presentation is a node chart
of `Q`, blueprint `def:sm-dj-formal-charts`). This file computes the completed local rings of the
blowup at the closed points of the exceptional fibre, in the two cases used by de Jong 1996:

* **3.4** (`page-0014.tex`, `page-0015.tex`): the centre is `(u, v, z_a)` with `n_a ≥ 2` (a
  codimension-two component of the singular locus). `branch_u_chart` (chart "`u ≠ 0`"): the point
  is regular, with coordinates `U, z' - c, Z_i (i ≠ a)` where `Z_a = U z'`. `branch_z_chart`
  (chart "`t_1 ≠ 0`"): `U = Z_a u'`, `V = Z_a v'`, `u'v' = Z^{n - 2e_a}`, and the point has the
  node presentation `u', v', Z` of type `n - 2e_a` or is regular.
* **4.27** (`page-0026.tex`, `page-0027.tex`): the centre is `(u, v, z_a, z_b)` with
  `n_a = n_b = 1` (a component of the singular locus where two branches cross).
  `crossing_u_chart`: regular, coordinates `U, z_a' - c_a, z_b' - c_b, Z_i (i ≠ a, b)`.
  `crossing_z_chart`: `u'v' = z_b' ∏_{i ≠ a, b} Z_i^{n_i}`, a node presentation or regular.

`branch_blowup_chart` and `crossing_blowup_chart` combine these with
`exists_chart_maximalIdeal`: for a chart localization `φ : O → P` of the blowup of `O` along `I`
with `I Ô = (u, v, z_a)` resp. `(u, v, z_a, z_b)`, they describe generators of the maximal ideal of
`P̂` in each chart. The regular cases give regular local rings by `isRegularLocalRing_of_span_eq`
once `dim P̂ ≥ m + 1`.

The proofs follow de Jong's chart computations (with the misprint J6 of 4.27 corrected: the
boundary in the chart `t_1 ≠ 0` is `t_2' t_3 ⋯ t_r t_1`): the relation is divided by the square of
the exceptional generator (a non-zero-divisor), and every new generator minus its value is shown to
lie in the ideal of the new coordinates by evaluating in the quotient by that ideal (blueprint
`lem:sm-dj-node-chart-branch`, `lem:sm-dj-node-chart-crossing`).
-/

noncomputable section

open IsLocalRing

namespace DeJongAlterations.StableModification.Resolution.Global

set_option backward.isDefEq.respectTransparency false

section Abstract

variable {k Q : Type*} [Field k] [CommRing Q] [IsLocalRing Q] [Algebra k Q]

/-- A constant in the maximal ideal is zero. -/
theorem eq_zero_of_algebraMap_mem_maximalIdeal {c : k} (hc : algebraMap k Q c ∈ maximalIdeal Q) :
    c = 0 := by
  by_contra h
  exact hc ((IsUnit.mk0 c h).map (algebraMap k Q))


/-- If `q ≡ e` modulo an ideal `J ≤ 𝔪` and `q ≡ b` modulo `𝔪` for constants `b, e`, then `b = e`
and `q ≡ b` modulo `J`. -/
theorem sub_mem_of_sub_mem {J : Ideal Q} (hJ : J ≤ maximalIdeal Q) {q : Q} {b e : k}
    (hb : q - algebraMap k Q b ∈ maximalIdeal Q) (he : q - algebraMap k Q e ∈ J) :
    q - algebraMap k Q b ∈ J := by
  have hbe : algebraMap k Q (e - b) ∈ maximalIdeal Q := by
    have := Ideal.sub_mem _ hb (hJ he)
    rw [map_sub]
    convert this using 1
    ring
  have : e - b = 0 := eq_zero_of_algebraMap_mem_maximalIdeal hbe
  rwa [sub_eq_zero.mp this] at he

/-- Elements generating the maximal ideal: if `d` elements generate `𝔪_Q` and `dim Q ≥ d`, then
`Q` is a regular local ring. -/
theorem isRegularLocalRing_of_span_eq [IsNoetherianRing Q] {d : ℕ} (z : Fin d → Q)
    (hz : Ideal.span (Set.range z) = maximalIdeal Q)
    (hdim : (d : WithBot ℕ∞) ≤ ringKrullDim Q) : IsRegularLocalRing Q := by
  apply IsRegularLocalRing.of_spanFinrank_maximalIdeal_le
  refine le_trans ?_ hdim
  rw [← hz]
  have h1 := Submodule.spanFinrank_span_le_ncard_of_finite (R := Q) (Set.finite_range z)
  have h2 : (Set.range z).ncard ≤ d := by
    rw [← Set.image_univ, ← Finset.coe_univ]
    exact (Set.ncard_image_le (Finset.finite_toSet _)).trans (by simp)
  exact_mod_cast h1.trans h2

omit [IsLocalRing Q] in
/-- In `Q ⧸ J`, an element whose image is the image of a constant is congruent to it. -/
theorem sub_mem_of_mk_eq {J : Ideal Q} {q : Q} {e : k}
    (h : Ideal.Quotient.mk J q = Ideal.Quotient.mk J (algebraMap k Q e)) :
    q - algebraMap k Q e ∈ J :=
  Ideal.Quotient.eq.mp h

end Abstract

section Branch

variable {k Q : Type*} [Field k] [CommRing Q] [IsLocalRing Q] [Algebra k Q]

/-- **The `U`-chart of the blowup of a node branch (de Jong 3.4, chart "`u ≠ 0`").** Let `𝔪_Q` be
generated by `U, V, Z_1, …, Z_m` and `v' - b, z' - c` with `UV = ∏ Z_i^{n_i}`, `n_a ≥ 2`,
`V = U v'`, `Z_a = U z'`, `U` a non-zero-divisor and `v' ≡ b`, `z' ≡ c` modulo `𝔪`. Then
`U, z' - c, Z_i (i ≠ a)` generate `𝔪_Q`; if `dim Q ≥ m + 1`, `Q` is regular. -/
theorem branch_u_chart {m : ℕ} (U V : Q) (Z : Fin m → Q) (n : Fin m → ℕ) (a : Fin m)
    (hna : 2 ≤ n a) (hrel : U * V = ∏ i, Z i ^ n i) (hU : IsSMulRegular Q U)
    (v' z' : Q) (b c : k) (hV : V = U * v') (hZ : Z a = U * z')
    (hb : v' - algebraMap k Q b ∈ maximalIdeal Q) (hc : z' - algebraMap k Q c ∈ maximalIdeal Q)
    (hmax : maximalIdeal Q = Ideal.span (insert U (insert V (Set.range Z))) ⊔
      Ideal.span {v' - algebraMap k Q b, z' - algebraMap k Q c}) :
    Ideal.span (Set.range (Fin.cons U (Function.update Z a (z' - algebraMap k Q c)) :
      Fin (m + 1) → Q)) = maximalIdeal Q := by
  classical
  set y : Fin (m + 1) → Q := Fin.cons U (Function.update Z a (z' - algebraMap k Q c)) with hy
  set N := Ideal.span (Set.range y) with hN
  have hUN : U ∈ N := Ideal.subset_span ⟨0, rfl⟩
  have hZN : ∀ i, i ≠ a → Z i ∈ N := fun i hi ↦
    Ideal.subset_span ⟨i.succ, by rw [hy, Fin.cons_succ, Function.update_of_ne hi]⟩
  have hcN : z' - algebraMap k Q c ∈ N :=
    Ideal.subset_span ⟨a.succ, by rw [hy, Fin.cons_succ, Function.update_self]⟩
  have hUm : U ∈ maximalIdeal Q := hmax ▸ Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
  have hZm : ∀ i, Z i ∈ maximalIdeal Q := fun i ↦ hmax ▸ Ideal.mem_sup_left
    (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ ⟨i, rfl⟩)))
  have hNm : N ≤ maximalIdeal Q := by
    rw [hN, Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    refine Fin.cases ?_ (fun i ↦ ?_) i
    · rw [hy, Fin.cons_zero]
      exact hUm
    · by_cases hi : i = a
      · subst hi
        rw [hy, Fin.cons_succ, Function.update_self]
        exact hc
      · rw [hy, Fin.cons_succ, Function.update_of_ne hi]
        exact hZm i
  -- the relation in the chart
  have hprod : ∏ i, Z i ^ n i = Z a ^ n a * ∏ i ∈ Finset.univ.erase a, Z i ^ n i :=
    (Finset.mul_prod_erase _ _ (Finset.mem_univ a)).symm
  have hv' : v' = U ^ (n a - 2) * z' ^ n a * ∏ i ∈ Finset.univ.erase a, Z i ^ n i := by
    have h1 : U * (U * (v' - U ^ (n a - 2) * z' ^ n a * ∏ i ∈ Finset.univ.erase a,
        Z i ^ n i)) = 0 := by
      have h2 : U ^ n a = U * (U * U ^ (n a - 2)) := by
        rw [← mul_assoc, ← pow_two, ← pow_add]
        congr 1
        omega
      have := hrel
      rw [hV, hprod, hZ, mul_pow, h2] at this
      linear_combination this
    have h3 := hU (by simpa using h1 : U • (U * (v' - _)) = U • 0)
    have h4 := hU (by simpa using h3 : U • (v' - _) = U • 0)
    exact sub_eq_zero.mp h4
  -- `v'` is congruent to a constant modulo `N`
  have hvN : v' - algebraMap k Q b ∈ N := by
    apply sub_mem_of_sub_mem hNm hb
      (e := 0 ^ (n a - 2) * c ^ n a * ∏ i ∈ Finset.univ.erase a, (0 : k) ^ n i)
    apply sub_mem_of_mk_eq
    have hU0 : Ideal.Quotient.mk N U = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hUN
    have hZ0 : ∀ i ∈ Finset.univ.erase a, Ideal.Quotient.mk N (Z i) = 0 := fun i hi ↦
      Ideal.Quotient.eq_zero_iff_mem.mpr (hZN i (Finset.ne_of_mem_erase hi))
    have hz0 : Ideal.Quotient.mk N z' = Ideal.Quotient.mk N (algebraMap k Q c) :=
      Ideal.Quotient.eq.mpr hcN
    rw [hv', map_mul, map_mul, map_pow, map_pow, hU0, hz0, map_prod,
      Finset.prod_congr rfl fun i hi ↦ by rw [map_pow, hZ0 i hi]]
    simp only [map_mul, map_pow, map_prod, map_zero]
  apply le_antisymm hNm
  rw [hmax]
  apply sup_le
  · rw [Ideal.span_le]
    rintro x (rfl | rfl | ⟨i, rfl⟩)
    · exact hUN
    · rw [hV]
      exact Ideal.mul_mem_right _ _ hUN
    · by_cases hi : i = a
      · subst hi
        rw [hZ]
        exact Ideal.mul_mem_right _ _ hUN
      · exact hZN i hi
  · rw [Ideal.span_le]
    rintro x (rfl | rfl)
    · exact hvN
    · exact hcN


omit [IsLocalRing Q] in
/-- `∏ Z_i^{n'_i}` for `n'` the update of `n` at `a` splits off the factor at `a`. -/
theorem prod_pow_update {m : ℕ} (Z : Fin m → Q) (n : Fin m → ℕ) (a : Fin m) (e : ℕ) :
    ∏ i, Z i ^ Function.update n a e i = Z a ^ e * ∏ i ∈ Finset.univ.erase a, Z i ^ n i := by
  classical
  rw [← Finset.mul_prod_erase _ _ (Finset.mem_univ a), Function.update_self]
  congr 1
  refine Finset.prod_congr rfl fun i hi ↦ ?_
  rw [Function.update_of_ne (Finset.ne_of_mem_erase hi)]

/-- An element congruent modulo `𝔪` to a nonzero constant is a unit. -/
theorem isUnit_of_sub_mem {q : Q} {b : k} (hb : q - algebraMap k Q b ∈ maximalIdeal Q)
    (hb0 : b ≠ 0) : IsUnit q := by
  by_contra hq
  apply hb0
  apply eq_zero_of_algebraMap_mem_maximalIdeal (Q := Q)
  have := Ideal.sub_mem _ ((mem_maximalIdeal q).mpr hq) hb
  simpa using this

/-- **The `Z_a`-chart of the blowup of a node branch (de Jong 3.4, chart "`t_1 ≠ 0`").** Let
`𝔪_Q` be generated by `U, V, Z_1, …, Z_m` and `u' - b_u, v' - b_v` with `UV = ∏ Z_i^{n_i}`,
`n_a ≥ 2`, `U = Z_a u'`, `V = Z_a v'`, `Z_a` a non-zero-divisor. Then `u'v' = Z^{n - 2 e_a}`, and
either `b_u = b_v = 0` and `u', v', Z` generate `𝔪_Q` (a node of type `n - 2e_a`), or one of
`b_u, b_v` is nonzero and `u' - b_u, Z` (resp. `v' - b_v, Z`) generate `𝔪_Q`. -/
theorem branch_z_chart {m : ℕ} (U V : Q) (Z : Fin m → Q) (n : Fin m → ℕ) (a : Fin m)
    (hna : 2 ≤ n a) (hrel : U * V = ∏ i, Z i ^ n i) (hZa : IsSMulRegular Q (Z a))
    (u' v' : Q) (bu bv : k) (hUu : U = Z a * u') (hVv : V = Z a * v')
    (hbu : u' - algebraMap k Q bu ∈ maximalIdeal Q) (hbv : v' - algebraMap k Q bv ∈ maximalIdeal Q)
    (hmax : maximalIdeal Q = Ideal.span (insert U (insert V (Set.range Z))) ⊔
      Ideal.span {u' - algebraMap k Q bu, v' - algebraMap k Q bv}) :
    u' * v' = ∏ i, Z i ^ Function.update n a (n a - 2) i ∧
    ((bu = 0 ∧ bv = 0 ∧ Ideal.span (insert u' (insert v' (Set.range Z))) = maximalIdeal Q) ∨
      (bu ≠ 0 ∧ Ideal.span (Set.range (Fin.cons (u' - algebraMap k Q bu) Z :
        Fin (m + 1) → Q)) = maximalIdeal Q) ∨
      (bv ≠ 0 ∧ Ideal.span (Set.range (Fin.cons (v' - algebraMap k Q bv) Z :
        Fin (m + 1) → Q)) = maximalIdeal Q)) := by
  classical
  have hrel' : u' * v' = ∏ i, Z i ^ Function.update n a (n a - 2) i := by
    rw [prod_pow_update]
    have h1 : Z a * (Z a * (u' * v' - Z a ^ (n a - 2) * ∏ i ∈ Finset.univ.erase a,
        Z i ^ n i)) = 0 := by
      have h2 : Z a ^ n a = Z a * (Z a * Z a ^ (n a - 2)) := by
        rw [← mul_assoc, ← pow_two, ← pow_add]
        congr 1
        omega
      have := hrel
      rw [hUu, hVv, ← Finset.mul_prod_erase _ _ (Finset.mem_univ a), h2] at this
      linear_combination this
    have h3 := hZa (by simpa using h1 : Z a • (Z a * (u' * v' - _)) = Z a • 0)
    have h4 := hZa (by simpa using h3 : Z a • (u' * v' - _) = Z a • 0)
    exact sub_eq_zero.mp h4
  refine ⟨hrel', ?_⟩
  have hZm : ∀ i, Z i ∈ maximalIdeal Q := fun i ↦ hmax ▸ Ideal.mem_sup_left
    (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ ⟨i, rfl⟩)))
  -- generic containment: any ideal containing the `Z_i`, `u' - b_u`, `v' - b_v` is `𝔪`
  have hle : ∀ N : Ideal Q, (∀ i, Z i ∈ N) → u' - algebraMap k Q bu ∈ N →
      v' - algebraMap k Q bv ∈ N → maximalIdeal Q ≤ N := by
    intro N hZN hu hv
    have hZaN : Z a ∈ N := hZN a
    rw [hmax]
    apply sup_le
    · rw [Ideal.span_le]
      rintro x (rfl | rfl | ⟨i, rfl⟩)
      · rw [hUu]; exact Ideal.mul_mem_right _ _ hZaN
      · rw [hVv]; exact Ideal.mul_mem_right _ _ hZaN
      · exact hZN i
    · rw [Ideal.span_le]
      rintro x (rfl | rfl)
      · exact hu
      · exact hv
  by_cases hbu0 : bu = 0
  · by_cases hbv0 : bv = 0
    · subst hbu0 hbv0
      refine Or.inl ⟨rfl, rfl, le_antisymm ?_ ?_⟩
      · rw [Ideal.span_le]
        rintro x (rfl | rfl | ⟨i, rfl⟩)
        · simpa using hbu
        · simpa using hbv
        · exact hZm i
      · apply hle
        · exact fun i ↦ Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ ⟨i, rfl⟩))
        · simpa using Ideal.subset_span (Set.mem_insert u' _)
        · simpa using Ideal.subset_span (Set.mem_insert_of_mem u' (Set.mem_insert v' _))
    · -- `v'` is a unit
      refine Or.inr (Or.inr ⟨hbv0, ?_⟩)
      set N := Ideal.span (Set.range (Fin.cons (v' - algebraMap k Q bv) Z : Fin (m + 1) → Q))
      have hvN : v' - algebraMap k Q bv ∈ N := Ideal.subset_span ⟨0, rfl⟩
      have hZN : ∀ i, Z i ∈ N := fun i ↦ Ideal.subset_span ⟨i.succ, rfl⟩
      have hNm : N ≤ maximalIdeal Q := by
        rw [Ideal.span_le]
        rintro _ ⟨i, rfl⟩
        refine Fin.cases ?_ (fun i ↦ ?_) i
        · exact hbv
        · exact hZm i
      have huN : u' - algebraMap k Q bu ∈ N := by
        apply sub_mem_of_sub_mem hNm hbu (e := bv⁻¹ * ∏ i, (0 : k) ^ Function.update n a (n a - 2) i)
        apply sub_mem_of_mk_eq
        have hv0 : Ideal.Quotient.mk N v' = Ideal.Quotient.mk N (algebraMap k Q bv) :=
          Ideal.Quotient.eq.mpr hvN
        have hZ0 : ∀ i, Ideal.Quotient.mk N (Z i) = 0 := fun i ↦
          Ideal.Quotient.eq_zero_iff_mem.mpr (hZN i)
        have hr := congrArg (Ideal.Quotient.mk N) hrel'
        rw [map_mul, hv0, map_prod] at hr
        simp only [map_pow, hZ0] at hr
        have hbv' : Ideal.Quotient.mk N (algebraMap k Q bv) *
            Ideal.Quotient.mk N (algebraMap k Q bv⁻¹) = 1 := by
          rw [← map_mul, ← map_mul, mul_inv_cancel₀ hbv0, map_one, map_one]
        calc Ideal.Quotient.mk N u' = Ideal.Quotient.mk N u' *
              (Ideal.Quotient.mk N (algebraMap k Q bv) * Ideal.Quotient.mk N (algebraMap k Q bv⁻¹)) := by
              rw [hbv', mul_one]
          _ = (∏ i, (0 : Q ⧸ N) ^ Function.update n a (n a - 2) i) *
              Ideal.Quotient.mk N (algebraMap k Q bv⁻¹) := by rw [← mul_assoc, hr]
          _ = _ := by simp only [map_mul, map_prod, map_pow, map_zero, mul_comm]
      exact le_antisymm hNm (hle N hZN huN hvN)
  · -- `u'` is a unit
    refine Or.inr (Or.inl ⟨hbu0, ?_⟩)
    set N := Ideal.span (Set.range (Fin.cons (u' - algebraMap k Q bu) Z : Fin (m + 1) → Q))
    have huN : u' - algebraMap k Q bu ∈ N := Ideal.subset_span ⟨0, rfl⟩
    have hZN : ∀ i, Z i ∈ N := fun i ↦ Ideal.subset_span ⟨i.succ, rfl⟩
    have hNm : N ≤ maximalIdeal Q := by
      rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      refine Fin.cases ?_ (fun i ↦ ?_) i
      · exact hbu
      · exact hZm i
    have hvN : v' - algebraMap k Q bv ∈ N := by
      apply sub_mem_of_sub_mem hNm hbv (e := bu⁻¹ * ∏ i, (0 : k) ^ Function.update n a (n a - 2) i)
      apply sub_mem_of_mk_eq
      have hu0 : Ideal.Quotient.mk N u' = Ideal.Quotient.mk N (algebraMap k Q bu) :=
        Ideal.Quotient.eq.mpr huN
      have hZ0 : ∀ i, Ideal.Quotient.mk N (Z i) = 0 := fun i ↦
        Ideal.Quotient.eq_zero_iff_mem.mpr (hZN i)
      have hr := congrArg (Ideal.Quotient.mk N) hrel'
      rw [map_mul, hu0, map_prod] at hr
      simp only [map_pow, hZ0] at hr
      have hbu' : Ideal.Quotient.mk N (algebraMap k Q bu⁻¹) *
          Ideal.Quotient.mk N (algebraMap k Q bu) = 1 := by
        rw [← map_mul, ← map_mul, inv_mul_cancel₀ hbu0, map_one, map_one]
      calc Ideal.Quotient.mk N v' = (Ideal.Quotient.mk N (algebraMap k Q bu⁻¹) *
            Ideal.Quotient.mk N (algebraMap k Q bu)) * Ideal.Quotient.mk N v' := by
            rw [hbu', one_mul]
        _ = Ideal.Quotient.mk N (algebraMap k Q bu⁻¹) *
            ∏ i, (0 : Q ⧸ N) ^ Function.update n a (n a - 2) i := by rw [mul_assoc, hr]
        _ = _ := by simp only [map_mul, map_prod, map_pow, map_zero]
    exact le_antisymm hNm (hle N hZN huN hvN)


end Branch

section Crossing

variable {k Q : Type*} [Field k] [CommRing Q] [IsLocalRing Q] [Algebra k Q]

omit [IsLocalRing Q] in
/-- Splitting off two factors of exponent one. -/
theorem prod_pow_eq_mul_mul {m : ℕ} (Z : Fin m → Q) (n : Fin m → ℕ) {a b : Fin m} (hab : a ≠ b)
    (hna : n a = 1) (hnb : n b = 1) :
    ∏ i, Z i ^ n i = Z a * Z b * ∏ i ∈ (Finset.univ.erase a).erase b, Z i ^ n i := by
  rw [← Finset.mul_prod_erase _ _ (Finset.mem_univ a),
    ← Finset.mul_prod_erase _ _ (Finset.mem_erase.mpr ⟨hab.symm, Finset.mem_univ b⟩), hna, hnb,
    pow_one, pow_one, mul_assoc]

/-- **The `U`-chart of the blowup of a crossing of two branches (de Jong 4.27, chart
"`u ≠ 0`").** Let `𝔪_Q` be generated by `U, V, Z_1, …, Z_m` and `v' - b, z_a' - c_a, z_b' - c_b`,
where `UV = ∏ Z_i^{n_i}` with `n_a = n_b = 1` (`a ≠ b`), `V = U v'`, `Z_a = U z_a'`, `Z_b = U z_b'`
and `U` is a non-zero-divisor. Then `U, z_a' - c_a, z_b' - c_b, Z_i (i ≠ a, b)` generate `𝔪_Q`. -/
theorem crossing_u_chart {m : ℕ} (U V : Q) (Z : Fin m → Q) (n : Fin m → ℕ) {a b : Fin m}
    (hab : a ≠ b) (hna : n a = 1) (hnb : n b = 1) (hrel : U * V = ∏ i, Z i ^ n i)
    (hU : IsSMulRegular Q U) (v' za zb : Q) (bv ca cb : k) (hV : V = U * v')
    (hZa : Z a = U * za) (hZb : Z b = U * zb)
    (hbv : v' - algebraMap k Q bv ∈ maximalIdeal Q) (hca : za - algebraMap k Q ca ∈ maximalIdeal Q)
    (hcb : zb - algebraMap k Q cb ∈ maximalIdeal Q)
    (hmax : maximalIdeal Q = Ideal.span (insert U (insert V (Set.range Z))) ⊔
      Ideal.span {v' - algebraMap k Q bv, za - algebraMap k Q ca, zb - algebraMap k Q cb}) :
    Ideal.span (Set.range (Fin.cons U (Function.update (Function.update Z a
      (za - algebraMap k Q ca)) b (zb - algebraMap k Q cb)) : Fin (m + 1) → Q)) =
      maximalIdeal Q := by
  classical
  set y : Fin (m + 1) → Q := Fin.cons U (Function.update (Function.update Z a
    (za - algebraMap k Q ca)) b (zb - algebraMap k Q cb)) with hy
  set N := Ideal.span (Set.range y) with hN
  have hUN : U ∈ N := Ideal.subset_span ⟨0, by rw [hy, Fin.cons_zero]⟩
  have hZN : ∀ i, i ≠ a → i ≠ b → Z i ∈ N := fun i hia hib ↦
    Ideal.subset_span ⟨i.succ, by rw [hy, Fin.cons_succ, Function.update_of_ne hib,
      Function.update_of_ne hia]⟩
  have haN : za - algebraMap k Q ca ∈ N := Ideal.subset_span ⟨a.succ, by
    rw [hy, Fin.cons_succ, Function.update_of_ne hab, Function.update_self]⟩
  have hbN : zb - algebraMap k Q cb ∈ N := Ideal.subset_span ⟨b.succ, by
    rw [hy, Fin.cons_succ, Function.update_self]⟩
  have hUm : U ∈ maximalIdeal Q :=
    hmax ▸ Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
  have hZm : ∀ i, Z i ∈ maximalIdeal Q := fun i ↦ hmax ▸ Ideal.mem_sup_left
    (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ ⟨i, rfl⟩)))
  have hNm : N ≤ maximalIdeal Q := by
    rw [hN, Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    refine Fin.cases ?_ (fun i ↦ ?_) i
    · rw [hy, Fin.cons_zero]; exact hUm
    · rw [hy, Fin.cons_succ]
      by_cases hib : i = b
      · subst hib; rw [Function.update_self]; exact hcb
      · rw [Function.update_of_ne hib]
        by_cases hia : i = a
        · subst hia; rw [Function.update_self]; exact hca
        · rw [Function.update_of_ne hia]; exact hZm i
  -- the relation `v' = z_a' z_b' h''`
  have hsplit := prod_pow_eq_mul_mul Z n hab hna hnb
  have hv' : v' = za * zb * ∏ i ∈ (Finset.univ.erase a).erase b, Z i ^ n i := by
    have h1 : U * (U * (v' - za * zb * ∏ i ∈ (Finset.univ.erase a).erase b, Z i ^ n i)) = 0 := by
      have := hrel
      rw [hV, hsplit, hZa, hZb] at this
      linear_combination this
    have h3 := hU (by simpa using h1 : U • (U * (v' - _)) = U • 0)
    have h4 := hU (by simpa using h3 : U • (v' - _) = U • 0)
    exact sub_eq_zero.mp h4
  have hvN : v' - algebraMap k Q bv ∈ N := by
    apply sub_mem_of_sub_mem hNm hbv
      (e := ca * cb * ∏ i ∈ (Finset.univ.erase a).erase b, (0 : k) ^ n i)
    apply sub_mem_of_mk_eq
    have ha0 : Ideal.Quotient.mk N za = Ideal.Quotient.mk N (algebraMap k Q ca) :=
      Ideal.Quotient.eq.mpr haN
    have hb0 : Ideal.Quotient.mk N zb = Ideal.Quotient.mk N (algebraMap k Q cb) :=
      Ideal.Quotient.eq.mpr hbN
    have hZ0 : ∀ i ∈ (Finset.univ.erase a).erase b, Ideal.Quotient.mk N (Z i) = 0 := by
      intro i hi
      have hib := Finset.ne_of_mem_erase hi
      have hia := Finset.ne_of_mem_erase (Finset.mem_of_mem_erase hi)
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (hZN i hia hib)
    rw [hv', map_mul, map_mul, ha0, hb0, map_prod,
      Finset.prod_congr rfl fun i hi ↦ by rw [map_pow, hZ0 i hi]]
    simp only [map_mul, map_pow, map_prod, map_zero]
  apply le_antisymm hNm
  rw [hmax]
  apply sup_le
  · rw [Ideal.span_le]
    rintro x (rfl | rfl | ⟨i, rfl⟩)
    · exact hUN
    · rw [hV]; exact Ideal.mul_mem_right _ _ hUN
    · by_cases hia : i = a
      · subst hia; rw [hZa]; exact Ideal.mul_mem_right _ _ hUN
      · by_cases hib : i = b
        · subst hib; rw [hZb]; exact Ideal.mul_mem_right _ _ hUN
        · exact hZN i hia hib
  · rw [Ideal.span_le]
    rintro x (rfl | rfl | rfl)
    · exact hvN
    · exact haN
    · exact hbN


/-- **The `Z_a`-chart of the blowup of a crossing of two branches (de Jong 4.27, chart
"`t_1 ≠ 0`").** With `UV = ∏ Z_i^{n_i}`, `n_a = n_b = 1`, `U = Z_a u'`, `V = Z_a v'`,
`Z_b = Z_a z_b'`, `Z_a` a non-zero-divisor and `𝔪_Q` generated by `U, V, Z` and
`u' - b_u, v' - b_v, z_b' - c_b`: then `u'v' = z_b' ∏_{i ≠ a, b} Z_i^{n_i}`, and either
`b_u = b_v = 0` and `u', v'` and `Z` with `Z_b` replaced by `z_b' - c_b` generate `𝔪_Q`, or one of
`b_u, b_v` is nonzero and that unit coordinate minus its value together with this family
generate `𝔪_Q`. -/
theorem crossing_z_chart {m : ℕ} (U V : Q) (Z : Fin m → Q) (n : Fin m → ℕ) {a b : Fin m}
    (hab : a ≠ b) (hna : n a = 1) (hnb : n b = 1) (hrel : U * V = ∏ i, Z i ^ n i)
    (hZa : IsSMulRegular Q (Z a)) (u' v' zb : Q) (bu bv cb : k)
    (hU : U = Z a * u') (hV : V = Z a * v') (hZb : Z b = Z a * zb)
    (hbu : u' - algebraMap k Q bu ∈ maximalIdeal Q) (hbv : v' - algebraMap k Q bv ∈ maximalIdeal Q)
    (hcb : zb - algebraMap k Q cb ∈ maximalIdeal Q)
    (hmax : maximalIdeal Q = Ideal.span (insert U (insert V (Set.range Z))) ⊔
      Ideal.span {u' - algebraMap k Q bu, v' - algebraMap k Q bv, zb - algebraMap k Q cb}) :
    u' * v' = zb * ∏ i ∈ (Finset.univ.erase a).erase b, Z i ^ n i ∧
    ((bu = 0 ∧ bv = 0 ∧ Ideal.span (insert u' (insert v' (Set.range
        (Function.update Z b (zb - algebraMap k Q cb))))) = maximalIdeal Q) ∨
      (bu ≠ 0 ∧ Ideal.span (Set.range (Fin.cons (u' - algebraMap k Q bu)
        (Function.update Z b (zb - algebraMap k Q cb)) : Fin (m + 1) → Q)) = maximalIdeal Q) ∨
      (bv ≠ 0 ∧ Ideal.span (Set.range (Fin.cons (v' - algebraMap k Q bv)
        (Function.update Z b (zb - algebraMap k Q cb)) : Fin (m + 1) → Q)) = maximalIdeal Q)) := by
  classical
  set h'' := ∏ i ∈ (Finset.univ.erase a).erase b, Z i ^ n i with hh''
  have hrel' : u' * v' = zb * h'' := by
    have h1 : Z a * (Z a * (u' * v' - zb * h'')) = 0 := by
      have := hrel
      rw [hU, hV, prod_pow_eq_mul_mul Z n hab hna hnb, hZb] at this
      linear_combination this
    have h3 := hZa (by simpa using h1 : Z a • (Z a * (u' * v' - _)) = Z a • 0)
    have h4 := hZa (by simpa using h3 : Z a • (u' * v' - _) = Z a • 0)
    exact sub_eq_zero.mp h4
  refine ⟨hrel', ?_⟩
  set Z' := Function.update Z b (zb - algebraMap k Q cb) with hZ'
  have hZm : ∀ i, Z i ∈ maximalIdeal Q := fun i ↦ hmax ▸ Ideal.mem_sup_left
    (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ ⟨i, rfl⟩)))
  have hZ'm : ∀ i, Z' i ∈ maximalIdeal Q := by
    intro i
    by_cases hib : i = b
    · subst hib; rw [hZ', Function.update_self]; exact hcb
    · rw [hZ', Function.update_of_ne hib]; exact hZm i
  have hle : ∀ N : Ideal Q, (∀ i, Z' i ∈ N) → u' - algebraMap k Q bu ∈ N →
      v' - algebraMap k Q bv ∈ N → maximalIdeal Q ≤ N := by
    intro N hZN hu hv
    have hZaN : Z a ∈ N := by
      have := hZN a
      rwa [hZ', Function.update_of_ne hab] at this
    have hcbN : zb - algebraMap k Q cb ∈ N := by
      have := hZN b
      rwa [hZ', Function.update_self] at this
    rw [hmax]
    apply sup_le
    · rw [Ideal.span_le]
      rintro x (rfl | rfl | ⟨i, rfl⟩)
      · rw [hU]; exact Ideal.mul_mem_right _ _ hZaN
      · rw [hV]; exact Ideal.mul_mem_right _ _ hZaN
      · by_cases hib : i = b
        · subst hib; rw [hZb]; exact Ideal.mul_mem_right _ _ hZaN
        · have := hZN i
          rwa [hZ', Function.update_of_ne hib] at this
    · rw [Ideal.span_le]
      rintro x (rfl | rfl | rfl)
      · exact hu
      · exact hv
      · exact hcbN
  -- quotient computation of the unit cases
  have hquot : ∀ (N : Ideal Q) (q r : Q) (bq : k), bq ≠ 0 → (∀ i, Z' i ∈ N) →
      q - algebraMap k Q bq ∈ N → q * r = zb * h'' →
      Ideal.Quotient.mk N r = Ideal.Quotient.mk N (algebraMap k Q
        (bq⁻¹ * (cb * ∏ i ∈ (Finset.univ.erase a).erase b, (0 : k) ^ n i))) := by
    intro N q r bq hbq hZN hq hqr
    have hq0 : Ideal.Quotient.mk N q = Ideal.Quotient.mk N (algebraMap k Q bq) :=
      Ideal.Quotient.eq.mpr hq
    have hcb0 : Ideal.Quotient.mk N zb = Ideal.Quotient.mk N (algebraMap k Q cb) := by
      have := hZN b
      rw [hZ', Function.update_self] at this
      exact Ideal.Quotient.eq.mpr this
    have hZ0 : ∀ i ∈ (Finset.univ.erase a).erase b, Ideal.Quotient.mk N (Z i) = 0 := by
      intro i hi
      have hib := Finset.ne_of_mem_erase hi
      have := hZN i
      rw [hZ', Function.update_of_ne hib] at this
      exact Ideal.Quotient.eq_zero_iff_mem.mpr this
    have hr := congrArg (Ideal.Quotient.mk N) hqr
    rw [map_mul, map_mul, hq0, hcb0, hh'', map_prod,
      Finset.prod_congr rfl fun i hi ↦ by rw [map_pow, hZ0 i hi]] at hr
    have hinv : Ideal.Quotient.mk N (algebraMap k Q bq⁻¹) *
        Ideal.Quotient.mk N (algebraMap k Q bq) = 1 := by
      rw [← map_mul, ← map_mul, inv_mul_cancel₀ hbq, map_one, map_one]
    calc Ideal.Quotient.mk N r = (Ideal.Quotient.mk N (algebraMap k Q bq⁻¹) *
          Ideal.Quotient.mk N (algebraMap k Q bq)) * Ideal.Quotient.mk N r := by
          rw [hinv, one_mul]
      _ = Ideal.Quotient.mk N (algebraMap k Q bq⁻¹) * (Ideal.Quotient.mk N (algebraMap k Q cb) *
          ∏ i ∈ (Finset.univ.erase a).erase b, (0 : Q ⧸ N) ^ n i) := by rw [mul_assoc, hr]
      _ = _ := by simp only [map_mul, map_prod, map_pow, map_zero]
  by_cases hbu0 : bu = 0
  · by_cases hbv0 : bv = 0
    · subst hbu0 hbv0
      refine Or.inl ⟨rfl, rfl, le_antisymm ?_ ?_⟩
      · rw [Ideal.span_le]
        rintro x (rfl | rfl | ⟨i, rfl⟩)
        · simpa using hbu
        · simpa using hbv
        · exact hZ'm i
      · apply hle
        · exact fun i ↦ Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ ⟨i, rfl⟩))
        · simpa using Ideal.subset_span (Set.mem_insert u' _)
        · simpa using Ideal.subset_span (Set.mem_insert_of_mem u' (Set.mem_insert v' _))
    · refine Or.inr (Or.inr ⟨hbv0, ?_⟩)
      set N := Ideal.span (Set.range (Fin.cons (v' - algebraMap k Q bv) Z' : Fin (m + 1) → Q))
      have hvN : v' - algebraMap k Q bv ∈ N := Ideal.subset_span ⟨0, rfl⟩
      have hZN : ∀ i, Z' i ∈ N := fun i ↦ Ideal.subset_span ⟨i.succ, rfl⟩
      have hNm : N ≤ maximalIdeal Q := by
        rw [Ideal.span_le]
        rintro _ ⟨i, rfl⟩
        refine Fin.cases ?_ (fun i ↦ ?_) i
        · exact hbv
        · exact hZ'm i
      have huN : u' - algebraMap k Q bu ∈ N :=
        sub_mem_of_sub_mem hNm hbu (sub_mem_of_mk_eq (hquot N v' u' bv hbv0 hZN hvN
          (by rw [mul_comm]; exact hrel')))
      exact le_antisymm hNm (hle N hZN huN hvN)
  · refine Or.inr (Or.inl ⟨hbu0, ?_⟩)
    set N := Ideal.span (Set.range (Fin.cons (u' - algebraMap k Q bu) Z' : Fin (m + 1) → Q))
    have huN : u' - algebraMap k Q bu ∈ N := Ideal.subset_span ⟨0, rfl⟩
    have hZN : ∀ i, Z' i ∈ N := fun i ↦ Ideal.subset_span ⟨i.succ, rfl⟩
    have hNm : N ≤ maximalIdeal Q := by
      rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      refine Fin.cases ?_ (fun i ↦ ?_) i
      · exact hbu
      · exact hZ'm i
    have hvN : v' - algebraMap k Q bv ∈ N :=
      sub_mem_of_sub_mem hNm hbv (sub_mem_of_mk_eq (hquot N u' v' bu hbu0 hZN huN hrel'))
    exact le_antisymm hNm (hle N hZN huN hvN)

end Crossing

open Algebra.CompletionLocalMap Strictify

section Combined

variable {k O P : Type*} [Field k] [CommRing O] [IsLocalRing O]
  [Algebra k O] [CommRing P] [IsLocalRing P] [Algebra k P]
  (φ : O →+* P) [IsNoetherianRing O] [IsNoetherianRing P] [IsLocalHom φ]

local notation "Rh" => AdicCompletion (maximalIdeal O) O
local notation "Qh" => AdicCompletion (maximalIdeal P) P

omit [IsNoetherianRing O] [IsNoetherianRing P] in
/-- The images of a node presentation in the completion of a chart. -/
theorem completionMap_node_relation {m : ℕ} (u v : Rh) (z : Fin m → Rh) (n : Fin m → ℕ)
    (hrel : u * v = ∏ i, z i ^ n i) :
    completionMap φ u * completionMap φ v = ∏ i, completionMap φ (z i) ^ n i := by
  rw [← map_mul, hrel, map_prod]
  simp only [map_pow]

/-- **Blowing up a node branch (de Jong 3.4).** Let `Ô` have node coordinates `u, v, z` of type
`n` (they generate `𝔪_Ô` and `uv = ∏ z_i^{n_i}`), let `I Ô = (u, v, z_a)` with `n_a ≥ 2`, and let
`φ : O → P` be a chart localization for `I`. With `U, V, Z` the images in `P̂`, either one of
`U, V` generates the exceptional ideal and `P̂` has a regular chart (`U`-, `V`-charts), or `Z_a`
does, `U = Z_a u'`, `V = Z_a v'`, and `P̂` has node coordinates of type `n - 2e_a` or a regular
chart (`Z_a`-chart). -/
theorem branch_blowup_chart [IsDomain P]
    (hφk : ∀ c : k, φ (algebraMap k O c) = algebraMap k P c)
    (hresO : Function.Surjective (algebraMap k (ResidueField O)))
    (hresP : Function.Bijective (algebraMap k (ResidueField P)))
    {m : ℕ} (u v : Rh) (z : Fin m → Rh) (n : Fin m → ℕ) (a : Fin m) (hna : 2 ≤ n a)
    (hspan : Ideal.span (insert u (insert v (Set.range z))) = maximalIdeal Rh)
    (hrel : u * v = ∏ i, z i ^ n i)
    (I : Ideal O) (hI : I.map (algebraMap O Rh) = Ideal.span {u, v, z a})
    (g : O) (hg : g ∈ I) (hIg : I.map φ = Ideal.span {φ g}) (hg0 : φ g ≠ 0)
    (hgen : IsChartLocalization φ I g) :
    (∃ (z' : Qh) (c : k), completionMap φ (z a) = completionMap φ u * z' ∧
      completionMap φ v ∈ Ideal.span {completionMap φ u} ∧
      Ideal.span {completionMap φ u} = Ideal.span {algebraMap P Qh (φ g)} ∧
      z' - constQ (P := P) c ∈ maximalIdeal Qh ∧
      Ideal.span (Set.range (Fin.cons (completionMap φ u) (Function.update
        (fun i ↦ completionMap φ (z i)) a (z' - constQ (P := P) c)) : Fin (m + 1) → Qh)) =
        maximalIdeal Qh) ∨
    (∃ (z' : Qh) (c : k), completionMap φ (z a) = completionMap φ v * z' ∧
      completionMap φ u ∈ Ideal.span {completionMap φ v} ∧
      Ideal.span {completionMap φ v} = Ideal.span {algebraMap P Qh (φ g)} ∧
      z' - constQ (P := P) c ∈ maximalIdeal Qh ∧
      Ideal.span (Set.range (Fin.cons (completionMap φ v) (Function.update
        (fun i ↦ completionMap φ (z i)) a (z' - constQ (P := P) c)) : Fin (m + 1) → Qh)) =
        maximalIdeal Qh) ∨
    (∃ (u' v' : Qh) (bu bv : k), completionMap φ u = completionMap φ (z a) * u' ∧
      completionMap φ v = completionMap φ (z a) * v' ∧
      Ideal.span {completionMap φ (z a)} = Ideal.span {algebraMap P Qh (φ g)} ∧
      u' * v' = ∏ i, completionMap φ (z i) ^ Function.update n a (n a - 2) i ∧
      ((bu = 0 ∧ bv = 0 ∧ Ideal.span (insert u' (insert v' (Set.range fun i ↦
          completionMap φ (z i)))) = maximalIdeal Qh) ∨
        (bu ≠ 0 ∧ u' - constQ (P := P) bu ∈ maximalIdeal Qh ∧
          Ideal.span (Set.range (Fin.cons (u' - constQ (P := P) bu)
          (fun i ↦ completionMap φ (z i)) : Fin (m + 1) → Qh)) = maximalIdeal Qh) ∨
        (bv ≠ 0 ∧ v' - constQ (P := P) bv ∈ maximalIdeal Qh ∧
          Ideal.span (Set.range (Fin.cons (v' - constQ (P := P) bv)
          (fun i ↦ completionMap φ (z i)) : Fin (m + 1) → Qh)) = maximalIdeal Qh))) := by
  classical
  let y : Fin (m + 2) → Rh := Fin.cons u (Fin.cons v z)
  have hyrange : Set.range y = insert u (insert v (Set.range z)) := by
    simp only [y, Fin.range_cons]
  let S : Finset (Fin (m + 2)) := {0, 1, a.succ.succ}
  have hyS : y '' (S : Set (Fin (m + 2))) = {u, v, z a} := by
    simp only [S, Finset.coe_insert, Finset.coe_singleton, Set.image_insert_eq,
      Set.image_singleton]
    rfl
  obtain ⟨j, hjS, w, ar, hwj, haj, hw, har, hreg, hspanj, hmax⟩ :=
    exists_chart_maximalIdeal φ hφk hresO hresP y (by rw [hyrange]; exact hspan) I S
      (by rw [hI, hyS]) g hg hIg hg0 hgen
  set Φ := completionMap φ
  set U := Φ u
  set V := Φ v
  set Z : Fin m → Qh := fun i ↦ Φ (z i)
  have hrelQ : U * V = ∏ i, Z i ^ n i := completionMap_node_relation φ u v z n hrel
  have hrange : Set.range (fun i ↦ Φ (y i)) = insert U (insert V (Set.range Z)) := by
    have : (fun i ↦ Φ (y i)) = Fin.cons U (Fin.cons V Z) := by
      funext i
      refine Fin.cases rfl (fun i ↦ Fin.cases rfl (fun i ↦ rfl) i) i
    rw [this, Fin.range_cons, Fin.range_cons]
  have hS0 : (0 : Fin (m + 2)) ∈ S := by simp [S]
  have hS1 : (1 : Fin (m + 2)) ∈ S := by simp [S]
  have hSa : a.succ.succ ∈ S := by simp [S]
  have hy0 : y 0 = u := rfl
  have hy1 : y 1 = v := rfl
  have hya : y a.succ.succ = z a := rfl
  have hSimage : ∀ f : Fin (m + 2) → Qh, f '' (S : Set (Fin (m + 2))) = {f 0, f 1, f a.succ.succ} := by
    intro f
    simp only [S, Finset.coe_insert, Finset.coe_singleton, Set.image_insert_eq,
      Set.image_singleton]
  rw [hrange, hSimage] at hmax
  have hj : j = 0 ∨ j = 1 ∨ j = a.succ.succ := by simpa [S] using hjS
  rcases hj with rfl | rfl | rfl
  · -- `U`-chart
    left
    have hw1 := hw 1 hS1
    have hwa := hw a.succ.succ hSa
    rw [hy0, hy1] at hw1
    rw [hy0, hya] at hwa
    refine ⟨w a.succ.succ, ar a.succ.succ, hwa, ?_, hspanj, har _, ?_⟩
    · change Φ v ∈ Ideal.span {Φ u}
      rw [hw1]; exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
    · apply branch_u_chart U V Z n a hna hrelQ hreg (w 1) (w a.succ.succ) (ar 1) (ar a.succ.succ)
        hw1 hwa (har 1) (har _)
      rw [hmax, hwj, haj]
      simp only [constQ, map_one, sub_self, Ideal.span_insert_zero]
      rfl
  · -- `V`-chart
    right; left
    have hw0 := hw 0 hS0
    have hwa := hw a.succ.succ hSa
    rw [hy0, hy1] at hw0
    rw [hy1, hya] at hwa
    refine ⟨w a.succ.succ, ar a.succ.succ, hwa, ?_, hspanj, har _, ?_⟩
    · change Φ u ∈ Ideal.span {Φ v}
      rw [hw0]; exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
    · apply branch_u_chart V U Z n a hna (by rw [mul_comm]; exact hrelQ) hreg (w 0)
        (w a.succ.succ) (ar 0) (ar a.succ.succ) hw0 hwa (har 0) (har _)
      rw [hmax, hwj, haj, Set.insert_comm U V]
      simp only [constQ, map_one, sub_self, Set.insert_comm _ (0 : Qh), Ideal.span_insert_zero]
      rfl
  · -- `Z_a`-chart
    right; right
    have hw0 := hw 0 hS0
    have hw1 := hw 1 hS1
    rw [hy0, hya] at hw0
    rw [hy1, hya] at hw1
    have hz := branch_z_chart U V Z n a hna hrelQ hreg (w 0) (w 1) (ar 0) (ar 1) hw0 hw1
      (har 0) (har 1) (by
        rw [hmax, hwj, haj]
        simp only [constQ, map_one, sub_self]
        congr 1
        have hset : ∀ x y : Qh, ({x, y, 0} : Set Qh) = insert 0 {x, y} := by
          intro x y; ext q; simp only [Set.mem_insert_iff, Set.mem_singleton_iff]; tauto
        rw [hset, Ideal.span_insert_zero]
        rfl)
    refine ⟨w 0, w 1, ar 0, ar 1, hw0, hw1, hspanj, hz.1, ?_⟩
    rcases hz.2 with h | h | h
    · exact Or.inl h
    · exact Or.inr (Or.inl ⟨h.1, har 0, h.2⟩)
    · exact Or.inr (Or.inr ⟨h.1, har 1, h.2⟩)

/-- **Blowing up a crossing of two node branches (de Jong 4.27).** Let `Ô` have node coordinates
`u, v, z` of type `n` with `n_a = n_b = 1` (`a ≠ b`), let `I Ô = (u, v, z_a, z_b)` and let
`φ : O → P` be a chart localization for `I`. With `U, V, Z` the images in `P̂`: in the `U`- and
`V`-charts `P̂` has a regular chart; in the `Z_a`-chart `U = Z_a u'`, `V = Z_a v'`, `Z_b = Z_a z_b'`,
`u'v' = z_b' ∏_{i ≠ a, b} Z_i^{n_i}`, and `P̂` has node coordinates `u', v'` and `Z` with `Z_b`
replaced by `z_b' - c_b`, or a regular chart; symmetrically in the `Z_b`-chart. -/
theorem crossing_blowup_chart [IsDomain P]
    (hφk : ∀ c : k, φ (algebraMap k O c) = algebraMap k P c)
    (hresO : Function.Surjective (algebraMap k (ResidueField O)))
    (hresP : Function.Bijective (algebraMap k (ResidueField P)))
    {m : ℕ} (u v : Rh) (z : Fin m → Rh) (n : Fin m → ℕ) {a b : Fin m} (hab : a ≠ b)
    (hna : n a = 1) (hnb : n b = 1)
    (hspan : Ideal.span (insert u (insert v (Set.range z))) = maximalIdeal Rh)
    (hrel : u * v = ∏ i, z i ^ n i)
    (I : Ideal O) (hI : I.map (algebraMap O Rh) = Ideal.span {u, v, z a, z b})
    (g : O) (hg : g ∈ I) (hIg : I.map φ = Ideal.span {φ g}) (hg0 : φ g ≠ 0)
    (hgen : IsChartLocalization φ I g) :
    (∃ (za zb : Qh) (ca cb : k),
      completionMap φ (z a) = completionMap φ u * za ∧
      completionMap φ (z b) = completionMap φ u * zb ∧
      completionMap φ v ∈ Ideal.span {completionMap φ u} ∧
      Ideal.span {completionMap φ u} = Ideal.span {algebraMap P Qh (φ g)} ∧
      za - constQ (P := P) ca ∈ maximalIdeal Qh ∧ zb - constQ (P := P) cb ∈ maximalIdeal Qh ∧
      Ideal.span (Set.range (Fin.cons (completionMap φ u) (Function.update (Function.update
        (fun i ↦ completionMap φ (z i)) a (za - constQ (P := P) ca)) b
        (zb - constQ (P := P) cb)) : Fin (m + 1) → Qh)) = maximalIdeal Qh) ∨
    (∃ (za zb : Qh) (ca cb : k),
      completionMap φ (z a) = completionMap φ v * za ∧
      completionMap φ (z b) = completionMap φ v * zb ∧
      completionMap φ u ∈ Ideal.span {completionMap φ v} ∧
      Ideal.span {completionMap φ v} = Ideal.span {algebraMap P Qh (φ g)} ∧
      za - constQ (P := P) ca ∈ maximalIdeal Qh ∧ zb - constQ (P := P) cb ∈ maximalIdeal Qh ∧
      Ideal.span (Set.range (Fin.cons (completionMap φ v) (Function.update (Function.update
        (fun i ↦ completionMap φ (z i)) a (za - constQ (P := P) ca)) b
        (zb - constQ (P := P) cb)) : Fin (m + 1) → Qh)) = maximalIdeal Qh) ∨
    (∃ (a' b' : Fin m), ((a' = a ∧ b' = b) ∨ (a' = b ∧ b' = a)) ∧
      ∃ (u' v' zb : Qh) (bu bv cb : k),
      completionMap φ u = completionMap φ (z a') * u' ∧
      completionMap φ v = completionMap φ (z a') * v' ∧
      completionMap φ (z b') = completionMap φ (z a') * zb ∧
      Ideal.span {completionMap φ (z a')} = Ideal.span {algebraMap P Qh (φ g)} ∧
      zb - constQ (P := P) cb ∈ maximalIdeal Qh ∧
      u' * v' = zb * ∏ i ∈ (Finset.univ.erase a').erase b', completionMap φ (z i) ^ n i ∧
      ((bu = 0 ∧ bv = 0 ∧ Ideal.span (insert u' (insert v' (Set.range
          (Function.update (fun i ↦ completionMap φ (z i)) b' (zb - constQ (P := P) cb))))) =
          maximalIdeal Qh) ∨
        (bu ≠ 0 ∧ u' - constQ (P := P) bu ∈ maximalIdeal Qh ∧
          Ideal.span (Set.range (Fin.cons (u' - constQ (P := P) bu)
          (Function.update (fun i ↦ completionMap φ (z i)) b' (zb - constQ (P := P) cb)) :
            Fin (m + 1) → Qh)) = maximalIdeal Qh) ∨
        (bv ≠ 0 ∧ v' - constQ (P := P) bv ∈ maximalIdeal Qh ∧
          Ideal.span (Set.range (Fin.cons (v' - constQ (P := P) bv)
          (Function.update (fun i ↦ completionMap φ (z i)) b' (zb - constQ (P := P) cb)) :
            Fin (m + 1) → Qh)) = maximalIdeal Qh))) := by
  classical
  let y : Fin (m + 2) → Rh := Fin.cons u (Fin.cons v z)
  have hyrange : Set.range y = insert u (insert v (Set.range z)) := by
    simp only [y, Fin.range_cons]
  let S : Finset (Fin (m + 2)) := {0, 1, a.succ.succ, b.succ.succ}
  have hyS : y '' (S : Set (Fin (m + 2))) = {u, v, z a, z b} := by
    simp only [S, Finset.coe_insert, Finset.coe_singleton, Set.image_insert_eq,
      Set.image_singleton]
    rfl
  obtain ⟨j, hjS, w, ar, hwj, haj, hw, har, hreg, hspanj, hmax⟩ :=
    exists_chart_maximalIdeal φ hφk hresO hresP y (by rw [hyrange]; exact hspan) I S
      (by rw [hI, hyS]) g hg hIg hg0 hgen
  set Φ := completionMap φ
  set U := Φ u
  set V := Φ v
  set Z : Fin m → Qh := fun i ↦ Φ (z i)
  have hrelQ : U * V = ∏ i, Z i ^ n i := completionMap_node_relation φ u v z n hrel
  have hrange : Set.range (fun i ↦ Φ (y i)) = insert U (insert V (Set.range Z)) := by
    have : (fun i ↦ Φ (y i)) = Fin.cons U (Fin.cons V Z) := by
      funext i
      refine Fin.cases rfl (fun i ↦ Fin.cases rfl (fun i ↦ rfl) i) i
    rw [this, Fin.range_cons, Fin.range_cons]
  have hS0 : (0 : Fin (m + 2)) ∈ S := by simp [S]
  have hS1 : (1 : Fin (m + 2)) ∈ S := by simp [S]
  have hSa : a.succ.succ ∈ S := by simp [S]
  have hSb : b.succ.succ ∈ S := by simp [S]
  have hSimage : ∀ f : Fin (m + 2) → Qh, f '' (S : Set (Fin (m + 2))) =
      {f 0, f 1, f a.succ.succ, f b.succ.succ} := by
    intro f
    simp only [S, Finset.coe_insert, Finset.coe_singleton, Set.image_insert_eq,
      Set.image_singleton]
  rw [hrange, hSimage] at hmax
  have hset : ∀ x y z : Qh, ({0, x, y, z} : Set Qh) = insert 0 {x, y, z} := fun _ _ _ ↦ rfl
  have hset1 : ∀ x y z : Qh, ({x, 0, y, z} : Set Qh) = insert 0 {x, y, z} :=
    fun x _ _ ↦ Set.insert_comm x 0 _
  have hset2 : ∀ x y z : Qh, ({x, y, 0, z} : Set Qh) = insert 0 {x, y, z} := by
    intro x y z
    rw [Set.insert_comm y 0, Set.insert_comm x 0]
  have hset3 : ∀ x y z : Qh, ({x, y, z, 0} : Set Qh) = insert 0 {x, y, z} := by
    intro x y z
    rw [Set.pair_comm z 0, Set.insert_comm y 0, Set.insert_comm x 0]
  have hj : j = 0 ∨ j = 1 ∨ j = a.succ.succ ∨ j = b.succ.succ := by simpa [S] using hjS
  have hab2 : a.succ.succ ≠ b.succ.succ := fun h ↦ hab (Fin.succ_injective _
    (Fin.succ_injective _ h))
  rcases hj with rfl | rfl | rfl | rfl
  · left
    have hw1 := hw 1 hS1
    have hwa := hw a.succ.succ hSa
    have hwb := hw b.succ.succ hSb
    refine ⟨w a.succ.succ, w b.succ.succ, ar a.succ.succ, ar b.succ.succ, hwa, hwb, ?_, hspanj,
      har _, har _, ?_⟩
    · change Φ v ∈ Ideal.span {Φ u}
      rw [show Φ v = Φ (y 1) from rfl, hw1]
      exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
    · apply crossing_u_chart U V Z n hab hna hnb hrelQ hreg (w 1) (w a.succ.succ)
        (w b.succ.succ) (ar 1) (ar a.succ.succ) (ar b.succ.succ) hw1 hwa hwb (har 1) (har _)
        (har _)
      rw [hmax, hwj, haj]
      simp only [constQ, map_one, sub_self]
      congr 1
      rw [hset, Ideal.span_insert_zero]
      rfl
  · right; left
    have hw0 := hw 0 hS0
    have hwa := hw a.succ.succ hSa
    have hwb := hw b.succ.succ hSb
    refine ⟨w a.succ.succ, w b.succ.succ, ar a.succ.succ, ar b.succ.succ, hwa, hwb, ?_, hspanj,
      har _, har _, ?_⟩
    · change Φ u ∈ Ideal.span {Φ v}
      rw [show Φ u = Φ (y 0) from rfl, hw0]
      exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
    · apply crossing_u_chart V U Z n hab hna hnb (by rw [mul_comm]; exact hrelQ) hreg (w 0)
        (w a.succ.succ) (w b.succ.succ) (ar 0) (ar a.succ.succ) (ar b.succ.succ) hw0 hwa hwb
        (har 0) (har _) (har _)
      rw [hmax, hwj, haj, Set.insert_comm U V]
      simp only [constQ, map_one, sub_self]
      congr 1
      rw [hset1, Ideal.span_insert_zero]
      rfl
  · right; right
    have hw0 := hw 0 hS0
    have hw1 := hw 1 hS1
    have hwb := hw b.succ.succ hSb
    have hz := crossing_z_chart U V Z n hab hna hnb hrelQ hreg (w 0) (w 1) (w b.succ.succ)
      (ar 0) (ar 1) (ar b.succ.succ) hw0 hw1 hwb (har 0) (har 1) (har _) (by
        rw [hmax, hwj, haj]
        simp only [constQ, map_one, sub_self]
        congr 1
        rw [hset2, Ideal.span_insert_zero]
        rfl)
    refine ⟨a, b, Or.inl ⟨rfl, rfl⟩, w 0, w 1, w b.succ.succ, ar 0, ar 1, ar b.succ.succ, hw0,
      hw1, hwb, hspanj, har _, hz.1, ?_⟩
    rcases hz.2 with h | h | h
    · exact Or.inl h
    · exact Or.inr (Or.inl ⟨h.1, har 0, h.2⟩)
    · exact Or.inr (Or.inr ⟨h.1, har 1, h.2⟩)
  · right; right
    have hw0 := hw 0 hS0
    have hw1 := hw 1 hS1
    have hwa := hw a.succ.succ hSa
    have hz := crossing_z_chart U V Z n hab.symm hnb hna hrelQ hreg (w 0) (w 1) (w a.succ.succ)
      (ar 0) (ar 1) (ar a.succ.succ) hw0 hw1 hwa (har 0) (har 1) (har _) (by
        rw [hmax, hwj, haj]
        simp only [constQ, map_one, sub_self]
        congr 1
        rw [hset3, Ideal.span_insert_zero]
        rfl)
    refine ⟨b, a, Or.inr ⟨rfl, rfl⟩, w 0, w 1, w a.succ.succ, ar 0, ar 1, ar a.succ.succ, hw0,
      hw1, hwa, hspanj, har _, hz.1, ?_⟩
    rcases hz.2 with h | h | h
    · exact Or.inl h
    · exact Or.inr (Or.inl ⟨h.1, har 0, h.2⟩)
    · exact Or.inr (Or.inr ⟨h.1, har 1, h.2⟩)

end Combined

end DeJongAlterations.StableModification.Resolution.Global
