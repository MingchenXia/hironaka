import DeJongAlterations.StableModification.Resolution.LocalMonomial
import DeJongAlterations.Algebra.NodeFittingGeometricNodeSupport
import DeJongAlterations.Geometry.SNCSubdivisorCartier

/-!
# Local equations of a strict normal crossings divisor

Let `D = ⋃ D_i` be a divisor with strict normal crossings on a Noetherian scheme `Y`
(Codex's `IsStrictNormalCrossings`, de Jong 1996, 2.4, 3.1) and `y ∈ Y`. If `D_1, …, D_r` are the
components through `y`, then each `D_i` is cut out near `y` by an element `t_i ∈ 𝔪_y ∖ 𝔪_y²` and
`D` is cut out at `y` by `t_1 ⋯ t_r` (de Jong 3.3,
`references/dejong96-alterations/tex/page-0014.tex`: "Let `t_i ∈ 𝒪_{S,s}` be an element such that
`V(t_i) = D_i ∩ Spec 𝒪_{S,s}`").

## Main results

* `exists_parameter_generator_atPrime`: a height-one prime `I` of a ring `A` with regular quotient,
  contained in a prime `𝔭` with `A_𝔭` regular, is generated in `A_𝔭` by an element of
  `𝔪 ∖ 𝔪²` (a variant of Codex's `SNCSubdivisorAffine.exists_regular_generator_atPrime` keeping
  the parameter property).
* `exists_snc_local_equations`: the stalk at `y` of the ideal of `D` is generated by
  `t_1 ⋯ t_r` with all `t_i ∈ 𝔪_y ∖ 𝔪_y²`.
-/

noncomputable section

namespace DeJongAlterations.StableModification.Resolution

open AlgebraicGeometry CategoryTheory TopologicalSpace IsLocalRing
open Scheme.IdealSheafData Algebra.NodeFittingIdealSheaf
open Geometry.SNCSubdivisorTopology Geometry.SNCSubdivisorLocal Geometry.SNCSubdivisorCartier

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

universe u

/-- A height-one prime with regular quotient, inside a prime with regular localization, is
generated in the localization by a regular parameter `b ∈ 𝔪 ∖ 𝔪²`. The argument is Codex's
`Geometry.SNCSubdivisorAffine.exists_regular_generator_atPrime`, keeping the parameter property
supplied by `Geometry.SNCSubdivisorAlgebra.exists_regular_kernel_generator`. -/
theorem exists_parameter_generator_atPrime {R : Type*} [CommRing R]
    (I p : Ideal R) [I.IsPrime] [p.IsPrime] [IsRegularLocalRing (Localization.AtPrime p)]
    [IsRegularRing (R ⧸ I)] (hIp : I ≤ p) (hheight : I.height = 1) :
    ∃ b : Localization.AtPrime p, b ∈ maximalIdeal (Localization.AtPrime p) ∧
      b ∉ maximalIdeal (Localization.AtPrime p) ^ 2 ∧
      I.map (algebraMap R (Localization.AtPrime p)) = Ideal.span {b} := by
  let q := p.map (Ideal.Quotient.mk I)
  let : q.IsPrime := Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
    (by simpa only [Ideal.mk_ker] using hIp)
  have hqp : q.comap (Ideal.Quotient.mk I) = p := by
    simp only [q, Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective,
      ← RingHom.ker_eq_comap_bot, Ideal.mk_ker, sup_of_le_left hIp]
  let L := Localization.AtPrime p
  let J := I.map (algebraMap R L)
  have hequiv : (L ⧸ J) ≃+* Localization.AtPrime q := by
    have hnot : ∀ x : R, Ideal.Quotient.mk I x ∉ q ↔ x ∉ p := by
      intro x
      apply not_congr
      change x ∈ q.comap (Ideal.Quotient.mk I) ↔ x ∈ p
      rw [hqp]
    have heq : Algebra.algebraMapSubmonoid (R ⧸ I) p.primeCompl = q.primeCompl := by
      ext y
      constructor
      · rintro ⟨x, hx, rfl⟩
        exact (hnot x).mpr hx
      · intro hy
        obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
        exact ⟨x, (hnot x).mp hy, rfl⟩
    let : IsLocalization q.primeCompl (L ⧸ J) := by
      rw [← heq]
      infer_instance
    exact (IsLocalization.algEquiv q.primeCompl (L ⧸ J)
      (Localization.AtPrime q)).toRingEquiv
  let : IsRegularLocalRing (L ⧸ J) := IsRegularLocalRing.of_ringEquiv hequiv.symm
  have hd : Disjoint (p.primeCompl : Set R) (I : Set R) :=
    Set.disjoint_left.mpr (fun x hxM hxI ↦ hxM (hIp hxI))
  have hJheight : J.height = 1 :=
    (IsLocalization.height_map_of_disjoint (S := L) p.primeCompl I hd).trans hheight
  have hJne : J ≠ ⊥ := by
    let : IsDomain L := Algebra.RegularLocalDomain.isDomain_of_isRegularLocalRing L
    exact Ideal.ne_bot_of_height_eq_one hJheight
  obtain ⟨b, hbm, hbm2, -, hspan⟩ :=
    Geometry.SNCSubdivisorAlgebra.exists_regular_kernel_generator (Ideal.Quotient.mk J)
      Ideal.Quotient.mk_surjective (by simpa only [Ideal.mk_ker] using hJne)
      (by simpa only [Ideal.mk_ker, hJheight] using (le_refl (1 : ℕ∞)))
  exact ⟨b, hbm, hbm2, by simpa only [Ideal.mk_ker] using hspan.symm⟩

variable {Y : Scheme.{u}}

/-- On an affine open `U ∋ y`, a section lies in the prime ideal of `y` iff its germ at `y` is not a
unit. -/
theorem mem_primeIdealOf_iff_germ_mem {U : Y.Opens} (hU : IsAffineOpen U) {y : Y} (hy : y ∈ U)
    (f : Γ(Y, U)) :
    f ∈ (hU.primeIdealOf ⟨y, hy⟩).asIdeal ↔
      Y.presheaf.germ U y hy f ∈ maximalIdeal (Y.presheaf.stalk y) := by
  let := TopCat.Presheaf.algebra_section_stalk Y.presheaf ⟨y, hy⟩
  have := hU.isLocalization_stalk ⟨y, hy⟩
  exact (IsLocalization.AtPrime.to_map_mem_maximal_iff (Y.presheaf.stalk y)
    (hU.primeIdealOf ⟨y, hy⟩).asIdeal f).symm

/-- The ideal on an affine open of a closed subscheme containing `y` lies in the prime of `y`. -/
theorem ideal_le_primeIdealOf_of_mem_support (D : Y.IdealSheafData) (U : Y.affineOpens) {y : Y}
    (hy : y ∈ U.1) (hyD : y ∈ D.support) :
    D.ideal U ≤ (U.2.primeIdealOf ⟨y, hy⟩).asIdeal := by
  intro f hf
  rw [mem_primeIdealOf_iff_germ_mem U.2 hy]
  have hle := (Algebra.NodeFittingGeometricNodeSupport.mem_support_iff_stalkIdeal_le_maximalIdeal
    D y).mp hyD
  apply hle
  rw [stalkIdeal_eq_map_germ D U hy]
  exact Ideal.mem_map_of_mem _ hf

/-- A reduced closed subscheme of a Noetherian scheme is the reduced union of all the components
of its support. -/
theorem selectedDivisor_univ_eq [IsNoetherian Y] (D : Y.IdealSheafData)
    [IsReduced D.subscheme] [Fintype (DivisorComponent D)] :
    selectedDivisor D Finset.univ = D := by
  have := selectedDivisor_isReduced D Finset.univ
  apply idealSheaf_eq_of_isReduced_of_support_eq
  rw [selectedDivisor_support]
  apply le_antisymm (selectedSupport_le D Finset.univ)
  intro x hx
  obtain ⟨S, hS, hxS⟩ := exists_mem_irreducibleComponents_subset_of_isIrreducible
    ({⟨x, hx⟩} : Set D.support) isIrreducible_singleton
  rw [mem_selectedSupport]
  refine ⟨divisorComponentOf D S hS, Finset.mem_univ _, ?_⟩
  exact ⟨⟨x, hx⟩, hxS rfl, rfl⟩

/-- **Local equations of a strict normal crossings divisor (de Jong 3.3).** At every point `y` of
a Noetherian scheme carrying a strict normal crossings divisor `D`, the stalk of the ideal of `D`
is generated by a product `t_1 ⋯ t_r` of elements `t_i ∈ 𝔪_y ∖ 𝔪_y²` (one for each component
through `y`; `r = 0` if `y ∉ D`). -/
theorem exists_snc_local_equations [IsNoetherian Y] (D : Y.IdealSheafData)
    (hD : IsStrictNormalCrossings D) (y : Y) :
    ∃ (r : ℕ) (t : Fin r → Y.presheaf.stalk y),
      (∀ i, t i ∈ maximalIdeal (Y.presheaf.stalk y)) ∧
      (∀ i, t i ∉ maximalIdeal (Y.presheaf.stalk y) ^ 2) ∧
      stalkIdeal D y = Ideal.span {∏ i, t i} := by
  classical
  by_cases hyD : y ∉ D.support
  · refine ⟨0, Fin.elim0, fun i => i.elim0, fun i => i.elim0, ?_⟩
    rw [Fin.prod_univ_zero, Ideal.span_singleton_one]
    by_contra hne
    exact hyD ((Algebra.NodeFittingGeometricNodeSupport.mem_support_iff_stalkIdeal_le_maximalIdeal
      D y).mpr (le_maximalIdeal hne))
  rw [not_not] at hyD
  let : IsRegularLocalRing (Y.presheaf.stalk y) := hD.regularAlong y hyD
  let : IsReduced D.subscheme := hD.reduced
  let : Fintype (DivisorComponent D) := Fintype.ofFinite _
  obtain ⟨_, ⟨U, hU, rfl⟩, hyU, -⟩ :=
    Y.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ y) isOpen_univ
  have hU' : IsAffineOpen U := hU
  let U' : Y.affineOpens := ⟨U, hU⟩
  let A := Γ(Y, U)
  let : IsNoetherianRing A := IsLocallyNoetherian.component_noetherian U'
  let P := hU'.primeIdealOf ⟨y, hyU⟩
  let p : Ideal A := P.asIdeal
  let L := Localization.AtPrime p
  let := TopCat.Presheaf.algebra_section_stalk Y.presheaf ⟨y, hyU⟩
  have hloc := hU'.isLocalization_stalk ⟨y, hyU⟩
  let eL : L ≃ₐ[A] Y.presheaf.stalk y := IsLocalization.algEquiv p.primeCompl L _
  let : IsRegularLocalRing L := IsRegularLocalRing.of_ringEquiv eL.symm.toRingEquiv
  -- the components through `y`
  let F : Finset (DivisorComponent D) := Finset.univ.filter fun C => y ∈ C.val
  let I : DivisorComponent D → Ideal A := fun C => (vanishingIdeal C.val).ideal U'
  have hmeet : ∀ C ∈ F, ((C.val : Set Y) ∩ Set.range U'.2.fromSpec).Nonempty := by
    intro C hC
    refine ⟨y, (Finset.mem_filter.mp hC).2, ?_⟩
    rw [hU'.range_fromSpec]
    exact hyU
  have hcontain : ∀ C ∈ F, I C ≤ p := fun C hC =>
    ideal_le_primeIdealOf_of_mem_support (vanishingIdeal C.val) U' hyU (Finset.mem_filter.mp hC).2
  have hinfo : ∀ C ∈ F, (I C).IsPrime ∧ (I C).height = 1 ∧ IsRegularRing (A ⧸ I C) :=
    fun C hC => component_affine_prime_data D hD C U' (hmeet C hC)
  have hgen : ∀ C : {C : DivisorComponent D // C ∈ F},
      ∃ b : L, b ∈ maximalIdeal L ∧ b ∉ maximalIdeal L ^ 2 ∧
        (I C.val).map (algebraMap A L) = Ideal.span {b} := by
    intro C
    let : (I C.val).IsPrime := (hinfo C.val C.property).1
    let : IsRegularRing (A ⧸ I C.val) := (hinfo C.val C.property).2.2
    exact exists_parameter_generator_atPrime (I C.val) p (hcontain C.val C.property)
      (hinfo C.val C.property).2.1
  choose a ham ham2 haspan using hgen
  have haprime : ∀ C : {C : DivisorComponent D // C ∈ F}, Prime (a C) :=
    fun C => prime_of_mem_maximalIdeal_of_not_mem_sq (ham C) (ham2 C)
  -- distinct components have non-associated equations
  have hdist : ∀ C ∈ (Finset.univ : Finset {C : DivisorComponent D // C ∈ F}),
      ∀ C' ∈ (Finset.univ : Finset {C : DivisorComponent D // C ∈ F}), C ≠ C' → ¬ a C ∣ a C' := by
    intro C _ C' _ hne hdiv
    have hd : ∀ C : {C : DivisorComponent D // C ∈ F},
        Disjoint (p.primeCompl : Set A) (I C.val : Set A) := fun C =>
      Set.disjoint_left.mpr (fun x hxM hxI ↦ hxM (hcontain C.val C.property hxI))
    have hJheight : ∀ C : {C : DivisorComponent D // C ∈ F},
        ((I C.val).map (algebraMap A L)).height = 1 := by
      intro C
      let : (I C.val).IsPrime := (hinfo C.val C.property).1
      exact (IsLocalization.height_map_of_disjoint (S := L) p.primeCompl (I C.val) (hd C)).trans
        (hinfo C.val C.property).2.1
    have hle : (I C'.val).map (algebraMap A L) ≤ (I C.val).map (algebraMap A L) := by
      rw [haspan C, haspan C']
      exact Ideal.span_singleton_le_span_singleton.mpr hdiv
    let : (I C'.val).IsPrime := (hinfo C'.val C'.property).1
    let : (I C.val).IsPrime := (hinfo C.val C.property).1
    let : ((I C'.val).map (algebraMap A L)).IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint p.primeCompl L (I C'.val) inferInstance (hd C')
    have heqJ : (I C'.val).map (algebraMap A L) = (I C.val).map (algebraMap A L) :=
      ((I C'.val).map (algebraMap A L)).eq_of_le_of_height_le hle
        (by rw [hJheight C, hJheight C'])
    have heqI := congrArg (fun J : Ideal L ↦ J.under A) heqJ
    rw [IsLocalization.under_map_of_isPrime_disjoint p.primeCompl L inferInstance (hd C'),
      IsLocalization.under_map_of_isPrime_disjoint p.primeCompl L inferInstance (hd C)] at heqI
    exact hne (Subtype.ext (component_affine_ideal_injective D U' C'.val C.val
      (hmeet C'.val C'.property) (hmeet C.val C.property) heqI).symm)
  -- the localized ideal of `D` is generated by the product of the equations
  have hDU : (D.ideal U').map (algebraMap A L) = Ideal.span {∏ C, a C} := by
    have h1 : D.ideal U' = (Finset.univ : Finset (DivisorComponent D)).inf I := by
      conv_lhs => rw [← selectedDivisor_univ_eq D]
      exact selectedDivisor_ideal D Finset.univ U'
    have hfilter : (Finset.univ.filter fun C => I C ≤ p) = F := by
      ext C
      simp only [Finset.mem_filter, Finset.mem_univ, true_and, F]
      constructor
      · intro hC
        by_contra hyC
        -- a component not through `y` has ideal not contained in the prime of `y`
        apply hyC
        have hsupp : y ∈ (vanishingIdeal C.val).support := by
          rw [mem_support_iff_of_mem (U := U') hyU, Scheme.mem_zeroLocus_iff]
          intro f hf hyf
          rw [Scheme.mem_basicOpen _ _ _ hyU] at hyf
          exact (mem_primeIdealOf_iff_germ_mem hU' hyU f).mp (hC hf) hyf
        exact hsupp
      · intro hyC
        exact hcontain C (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hyC⟩)
    rw [h1, map_finset_inf_filter p, hfilter, map_finset_inf p.primeCompl]
    have heq : F.inf (fun C ↦ (I C).map (algebraMap A L)) =
        (Finset.univ : Finset {C : DivisorComponent D // C ∈ F}).inf
          (fun C ↦ Ideal.span {a C}) := by
      rw [← Finset.inf_attach F]
      simp only [Finset.univ_eq_attach]
      exact Finset.inf_congr rfl (fun C _ => haspan C)
    rw [heq]
    exact Geometry.SNCSubdivisorProducts.finset_inf_span_singleton_of_prime _ a
      (fun C _ => haprime C) hdist
  -- transport to the stalk and reindex by `Fin r`
  let r := Fintype.card {C : DivisorComponent D // C ∈ F}
  let σ := Fintype.equivFin {C : DivisorComponent D // C ∈ F}
  refine ⟨r, fun i => eL (a (σ.symm i)), fun i => ?_, fun i => ?_, ?_⟩
  · intro hu
    apply ham (σ.symm i)
    have h2 := hu.map eL.symm
    rwa [AlgEquiv.symm_apply_apply] at h2
  · intro hsq
    apply ham2 (σ.symm i)
    let e : Y.presheaf.stalk y ≃+* L := eL.symm.toRingEquiv
    have hmap := Ideal.mem_map_of_mem (e : Y.presheaf.stalk y →+* L) hsq
    rw [Ideal.map_pow, Ideal.map_coe, map_ringEquiv_maximalIdeal e] at hmap
    have h1 : (e : Y.presheaf.stalk y →+* L) (eL (a (σ.symm i))) = a (σ.symm i) :=
      eL.symm_apply_apply _
    rwa [h1] at hmap
  · rw [stalkIdeal_eq_map_germ D U' hyU]
    have hgerm : (Y.presheaf.germ U y hyU).hom = (eL.toRingEquiv.toRingHom).comp (algebraMap A L) := by
      ext f
      exact (eL.commutes f).symm
    have hprod : eL.toRingEquiv.toRingHom (∏ C, a C) = ∏ i : Fin r, eL (a (σ.symm i)) := by
      rw [map_prod]
      exact (Equiv.prod_comp σ.symm (fun C => eL.toRingEquiv.toRingHom (a C))).symm
    rw [hgerm, ← Ideal.map_map, hDU, Ideal.map_span, Set.image_singleton, hprod]
