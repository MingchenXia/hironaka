import DeJongAlterations.StableModification.Resolution.LocalSNC
import DeJongAlterations.Algebra.RegularQuotientFamily
import DeJongAlterations.Algebra.RegularLocalDomain

/-!
# The local equations of a strict normal crossings divisor are regular parameters

Let `D = ⋃ D_C` be a strict normal crossings divisor on a Noetherian scheme `Y`
(`IsStrictNormalCrossings`, de Jong 1996, 2.4, 3.1: every `D_J = ⋂_{C ∈ J} D_C` is regular of
codimension `#J`) and `y ∈ Y`. De Jong 3.3 (`references/dejong96-alterations/tex/page-0014.tex`)
chooses `t_C ∈ 𝒪_{Y,y}` with `V(t_C) = D_C` near `y` for the components through `y`, and uses that
they are part of a regular system of parameters of `𝒪_{Y,y}` (LITERATURE-ISSUES J8: only part of
one in general). This file proves that (`exists_component_parameters`):

* the stalk at `y` of the ideal of each component `C ∋ y` is `(t_C)`, the stalk of the ideal of
  `D` is `(∏ t_C)`, and
* the classes of the `t_C` in `𝔪_y/𝔪_y²` are linearly independent.

The independence comes from `D_J` for `J = {C : y ∈ C}`: its local ring `𝒪_{Y,y}/(t_C)_{C ∈ J}` is
regular (`intersectionsRegular`) and its ideal has height `#J` (`intersectionsCodimension` at the
generic point of the component of `D_J` through `y`), and

* `linearIndependent_toCotangent_of_isRegularLocalRing_quotient`: if `R` is regular local,
  `t_1, …, t_r ∈ 𝔪`, `R/(t)` is regular and `ht (t) ≥ r`, then the `t_i` are linearly independent
  in `𝔪/𝔪²` (with `ht 𝔭 + dim R/𝔭 ≤ dim R`, `height_add_ringKrullDim_quotient_le`).

The images of the `t_C` in the completion `Ô_{Y,y}` are then independent as well
(`Algebra.CompletionIntersectionRegularityCotangent.independent_completed_of_original`), and extend
to a regular system of parameters (`Algebra.RegularQuotientFamily.exists_family_generators`). These
are the coordinates `t_1, …, t_r` of de Jong's local models
(`Resolution.exists_local_model`, lemma `lem:sm-dj-local-model`) used by the global resolution
(blueprint chapter `sm-dj-resolution-global.tex`, `lem:sm-dj-snc-parameters`).
-/

noncomputable section

namespace DeJongAlterations.StableModification.Resolution

open AlgebraicGeometry CategoryTheory TopologicalSpace IsLocalRing
open Scheme.IdealSheafData Algebra.NodeFittingIdealSheaf
open Geometry.SNCSubdivisorTopology Geometry.SNCSubdivisorLocal Geometry.SNCSubdivisorCartier
open Geometry.SpecIdealSheaf Geometry.ReducedClosedSubscheme

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

universe u

/-- `ht 𝔭 + dim R/𝔭 ≤ dim R` for a prime `𝔭` (chains below and above `𝔭` concatenate). -/
theorem height_add_ringKrullDim_quotient_le {R : Type*} [CommRing R] (p : Ideal R) [p.IsPrime] :
    (p.height : WithBot ℕ∞) + ringKrullDim (R ⧸ p) ≤ ringKrullDim R := by
  let P : PrimeSpectrum R := ⟨p, inferInstance⟩
  have h1 : p.height = Order.height P := PrimeSpectrum.height_eq_orderHeight P
  have hset : PrimeSpectrum.zeroLocus (p : Set R) = Set.Ici P := by
    ext q
    simp only [PrimeSpectrum.mem_zeroLocus, Set.mem_Ici, SetLike.coe_subset_coe]
    rfl
  have h2 : ringKrullDim (R ⧸ p) = (Order.coheight P : WithBot ℕ∞) := by
    rw [ringKrullDim_quotient, Order.coheight_eq_krullDim_Ici, hset]
  have : Nonempty (PrimeSpectrum R) := ⟨P⟩
  rw [h1, h2, ringKrullDim, Order.krullDim_eq_iSup_height_add_coheight_of_nonempty]
  have := le_iSup (fun a : PrimeSpectrum R ↦ Order.height a + Order.coheight a) P
  exact_mod_cast this

/-- If `R` is a regular local ring and `t_1, …, t_r ∈ 𝔪` generate an ideal of height at least `r`
with regular quotient, then the classes of the `t_i` in `𝔪/𝔪²` are linearly independent: if
`𝔪/(t) ` is generated by `n = dim R/(t)` elements, then `dim R ≤ n + dim span(t̄_i)`, while
`ht (t) + dim R/(t) ≤ dim R`. -/
theorem linearIndependent_toCotangent_of_isRegularLocalRing_quotient
    {R : Type*} [CommRing R] [IsRegularLocalRing R] {ι : Type*} [Fintype ι]
    (t : ι → maximalIdeal R)
    [IsRegularLocalRing (R ⧸ Ideal.span (Set.range fun i ↦ (t i : R)))]
    (hht : (Fintype.card ι : ℕ∞) ≤ (Ideal.span (Set.range fun i ↦ (t i : R))).height) :
    LinearIndependent (ResidueField R) (fun i ↦ (maximalIdeal R).toCotangent (t i)) := by
  classical
  set I := Ideal.span (Set.range fun i ↦ (t i : R)) with hIdef
  let Q := R ⧸ I
  let mk : R →+* Q := Ideal.Quotient.mk I
  have : IsDomain Q := Algebra.RegularLocalDomain.isDomain_of_isRegularLocalRing Q
  have hIp : I.IsPrime := (Ideal.Quotient.isDomain_iff_prime I).mp inferInstance
  -- a minimal generating family of `𝔪_Q`
  obtain ⟨s, hscard, hsspan⟩ := Submodule.FG.exists_span_finset_card_eq_spanFinrank
    (IsNoetherian.noetherian (maximalIdeal Q))
  have hs_mem : ∀ q ∈ s, q ∈ maximalIdeal Q := fun q hq ↦ hsspan ▸ Submodule.subset_span hq
  choose lift hliftspec using fun q : Q ↦ Ideal.Quotient.mk_surjective (I := I) q
  have hlift_mem : ∀ q ∈ maximalIdeal Q, lift q ∈ maximalIdeal R := by
    intro q hq hu
    apply hq
    rw [← hliftspec q]
    exact hu.map mk
  let l : s → maximalIdeal R := fun q ↦ ⟨lift q, hlift_mem q (hs_mem q q.2)⟩
  let S : Set (maximalIdeal R) := Set.range l ∪ Set.range t
  have hspanS : Submodule.span R S = ⊤ := by
    rw [eq_top_iff]
    rintro m -
    have hm : mk m ∈ maximalIdeal Q := by
      rw [← map_maximalIdeal_of_surjective mk Ideal.Quotient.mk_surjective]
      exact Ideal.mem_map_of_mem mk m.2
    rw [← hsspan, Submodule.mem_span_finset] at hm
    obtain ⟨f, -, hf⟩ := hm
    have hr : (m : R) - ∑ q ∈ s, lift (f q) * lift q ∈ I := by
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      change mk _ = 0
      rw [map_sub, map_sum, ← hf, sub_eq_zero]
      refine Finset.sum_congr rfl fun x _ ↦ ?_
      rw [smul_eq_mul, map_mul]
      change f x * x = Ideal.Quotient.mk I (lift (f x)) * Ideal.Quotient.mk I (lift x)
      rw [hliftspec, hliftspec]
    rw [hIdef] at hr
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun R).mp hr
    have hmeq : m = ∑ q : s, lift (f q) • l q + ∑ i, c i • t i := by
      apply Subtype.ext
      simp only [Submodule.coe_add, Submodule.coe_sum, Submodule.coe_smul, smul_eq_mul, l]
      rw [Finset.sum_coe_sort s (fun q ↦ lift (f q) * lift q)]
      simp only [smul_eq_mul] at hc
      rw [hc]
      ring
    rw [hmeq]
    refine Submodule.add_mem _ (Submodule.sum_mem _ fun q _ ↦ Submodule.smul_mem _ _ ?_)
      (Submodule.sum_mem _ fun i _ ↦ Submodule.smul_mem _ _ ?_)
    · exact Submodule.subset_span (Or.inl ⟨q, rfl⟩)
    · exact Submodule.subset_span (Or.inr ⟨i, rfl⟩)
  -- the cotangent images of `S` span the cotangent space
  have hcot := CotangentSpace.span_image_eq_top_iff.mpr hspanS
  let V := CotangentSpace R
  let b : ι → V := fun i ↦ (maximalIdeal R).toCotangent (t i)
  let b' : s → V := fun q ↦ (maximalIdeal R).toCotangent (l q)
  have hVle : Module.finrank (ResidueField R) V ≤ s.card + (Set.range b).finrank (ResidueField R) := by
    have himage : (maximalIdeal R).toCotangent '' S = Set.range b' ∪ Set.range b := by
      rw [Set.image_union, ← Set.range_comp, ← Set.range_comp]
      rfl
    rw [himage, Submodule.span_union] at hcot
    have h1 := Submodule.finrank_sup_add_finrank_inf_eq (Submodule.span (ResidueField R) (Set.range b'))
      (Submodule.span (ResidueField R) (Set.range b))
    rw [hcot, finrank_top] at h1
    have h2 : (Set.range b').finrank (ResidueField R) ≤ s.card := by
      simpa using finrank_range_le_card (R := ResidueField R) b'
    change _ ≤ _ + Module.finrank _ (Submodule.span _ _)
    have h3 : (Set.range b').finrank (ResidueField R) =
      Module.finrank (ResidueField R) (Submodule.span (ResidueField R) (Set.range b')) := rfl
    omega
  -- dimension bookkeeping
  have hRdim : (Module.finrank (ResidueField R) V : WithBot ℕ∞) = ringKrullDim R := by
    rw [← spanFinrank_maximalIdeal_eq_finrank_cotangentSpace]
    exact (isRegularLocalRing_iff R).mp inferInstance
  have hQdim : (s.card : WithBot ℕ∞) = ringKrullDim Q := by
    rw [hscard]
    exact (isRegularLocalRing_iff Q).mp inferInstance
  have hht' := height_add_ringKrullDim_quotient_le I
  rw [← hRdim, ← hQdim] at hht'
  have hcard : (Fintype.card ι : WithBot ℕ∞) + s.card ≤ Module.finrank (ResidueField R) V := by
    refine le_trans ?_ hht'
    gcongr
    exact_mod_cast hht
  have hcard' : Fintype.card ι + s.card ≤ Module.finrank (ResidueField R) V := by
    exact_mod_cast hcard
  have hle : (Set.range b).finrank (ResidueField R) ≤ Fintype.card ι := finrank_range_le_card b
  rw [linearIndependent_iff_card_eq_finrank_span]
  change Fintype.card ι = (Set.range b).finrank (ResidueField R)
  omega


/-- A point of a closed subset `T` of a scheme which has no proper generization inside `T` is the
generic point of an irreducible component of `T`; under `HasPureCodimension T r` its local ring
has dimension `r`. -/
theorem ringKrullDim_stalk_eq_of_hasPureCodimension {X : Scheme.{u}} {T : Closeds X} {r : ℕ}
    (hT : HasPureCodimension T r) {z : X} (hz : z ∈ T)
    (hmax : ∀ w ∈ T, z ∈ closure ({w} : Set X) → w = z) :
    ringKrullDim (X.presheaf.stalk z) = r := by
  let z' : T := ⟨z, hz⟩
  let S : Set T := closure {z'}
  have hSimage : (Subtype.val : T → X) '' S = closure ({z} : Set X) := by
    have h1 : S = Subtype.val ⁻¹' closure ((Subtype.val : T → X) '' {z'}) :=
      Topology.IsInducing.subtypeVal.closure_eq_preimage_closure_image {z'}
    rw [h1, Set.image_singleton, Set.image_preimage_eq_inter_range, Subtype.range_coe]
    exact Set.inter_eq_left.mpr ((T.isClosed.closure_subset_iff).mpr (Set.singleton_subset_iff.mpr hz))
  have hcomp : S ∈ irreducibleComponents T := by
    refine ⟨isIrreducible_singleton.closure, fun s' hs' hSs' ↦ ?_⟩
    have hirr : IsIrreducible ((Subtype.val : T → X) '' s') :=
      hs'.image _ continuous_subtype_val.continuousOn
    let w := hirr.genericPoint
    have hw : IsGenericPoint w (closure ((Subtype.val : T → X) '' s')) :=
      hirr.isGenericPoint_genericPoint_closure
    have hwT : w ∈ T := by
      have : closure ((Subtype.val : T → X) '' s') ⊆ T :=
        T.isClosed.closure_subset_iff.mpr (by rintro _ ⟨x, -, rfl⟩; exact x.2)
      exact this hw.mem
    have hzw : z ∈ closure ({w} : Set X) := by
      rw [hw.def]
      exact subset_closure ⟨z', hSs' (subset_closure rfl), rfl⟩
    have hwz := hmax w hwT hzw
    intro x hx
    have hxmem : (x : X) ∈ closure ({z} : Set X) := by
      rw [← hwz, hw.def]
      exact subset_closure ⟨x, hx, rfl⟩
    rw [← hSimage] at hxmem
    obtain ⟨x', hx', hxx'⟩ := hxmem
    rwa [← Subtype.ext hxx']
  have hgen : IsGenericPoint z ((Subtype.val : T → X) '' S) := by
    rw [hSimage]
    exact isGenericPoint_closure
  exact hT S hcomp z hgen


/-- For an ideal `I ≤ 𝔭` of a ring `A`, `A_𝔭 ⧸ I A_𝔭` is the localization of `A ⧸ I` at the image
of `𝔭`; so it is a regular local ring if `A ⧸ I` is a regular ring. -/
theorem isRegularLocalRing_localization_quotient {A : Type*} [CommRing A] (I p : Ideal A)
    [p.IsPrime] [IsRegularRing (A ⧸ I)] (hIp : I ≤ p) :
    IsRegularLocalRing (Localization.AtPrime p ⧸ I.map (algebraMap A (Localization.AtPrime p))) := by
  let q := p.map (Ideal.Quotient.mk I)
  let : q.IsPrime := Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
    (by simpa only [Ideal.mk_ker] using hIp)
  have hqp : q.comap (Ideal.Quotient.mk I) = p := by
    simp only [q, Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective,
      ← RingHom.ker_eq_comap_bot, Ideal.mk_ker, sup_of_le_left hIp]
  let L := Localization.AtPrime p
  let J := I.map (algebraMap A L)
  have hnot : ∀ x : A, Ideal.Quotient.mk I x ∉ q ↔ x ∉ p := by
    intro x
    apply not_congr
    change x ∈ q.comap (Ideal.Quotient.mk I) ↔ x ∈ p
    rw [hqp]
  have heq : Algebra.algebraMapSubmonoid (A ⧸ I) p.primeCompl = q.primeCompl := by
    ext y
    constructor
    · rintro ⟨x, hx, rfl⟩
      exact (hnot x).mpr hx
    · intro hy
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
      exact ⟨x, (hnot x).mp hy, rfl⟩
  let : IsLocalization q.primeCompl (L ⧸ J) := by
    rw [← heq]
    infer_instance
  exact IsRegularLocalRing.of_ringEquiv
    (IsLocalization.algEquiv q.primeCompl (Localization.AtPrime q) (L ⧸ J)).toRingEquiv

variable {Y : Scheme.{u}}

/-- **The local equations of a strict normal crossings divisor are regular parameters.** Let `D` be
a strict normal crossings divisor on a Noetherian scheme `Y` and `y ∈ Y`. The components `C` of `D`
through `y` have local equations `t_C ∈ 𝔪_y` (the stalk at `y` of the ideal of `C` is `(t_C)`), and
these are linearly independent in `𝔪_y/𝔪_y²`, i.e. part of a regular system of parameters of
`𝒪_{Y,y}` (de Jong 1996, 3.1, 3.3, `references/dejong96-alterations/tex/page-0013.tex`,
`page-0014.tex`; see LITERATURE-ISSUES J8: they form a full regular system of parameters only at
generic points of the stratum). -/
theorem exists_component_parameters [IsNoetherian Y] (D : Y.IdealSheafData)
    (hD : IsStrictNormalCrossings D) (y : Y) :
    ∃ t : {C : DivisorComponent D // y ∈ C.val} → maximalIdeal (Y.presheaf.stalk y),
      (∀ C, stalkIdeal (vanishingIdeal C.1.val) y = Ideal.span {(t C : Y.presheaf.stalk y)}) ∧
      stalkIdeal D y = Ideal.span {∏ᶠ C, (t C : Y.presheaf.stalk y)} ∧
      LinearIndependent (ResidueField (Y.presheaf.stalk y))
        (fun C ↦ (maximalIdeal (Y.presheaf.stalk y)).toCotangent (t C)) := by
  classical
  let : Fintype (DivisorComponent D) := Fintype.ofFinite _
  let ι := {C : DivisorComponent D // y ∈ C.val}
  by_cases hyD : y ∉ D.support
  · have : IsEmpty ι := ⟨fun C ↦ hyD (Geometry.SNCSubdivisorComponent.component_le_support D C.1 C.2)⟩
    refine ⟨isEmptyElim, isEmptyElim, ?_, linearIndependent_empty_type⟩
    rw [finprod_of_isEmpty, Ideal.span_singleton_one]
    by_contra hne
    exact hyD ((Algebra.NodeFittingGeometricNodeSupport.mem_support_iff_stalkIdeal_le_maximalIdeal
      D y).mpr (le_maximalIdeal hne))
  rw [not_not] at hyD
  let : IsRegularLocalRing (Y.presheaf.stalk y) := hD.regularAlong y hyD
  obtain ⟨_, ⟨U, hU, rfl⟩, hyU, -⟩ :=
    Y.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ y) isOpen_univ
  have hU' : IsAffineOpen U := hU
  let U' : Y.affineOpens := ⟨U, hU⟩
  let A := Γ(Y, U)
  let : IsNoetherianRing A := IsLocallyNoetherian.component_noetherian U'
  let P := hU'.primeIdealOf ⟨y, hyU⟩
  let p : Ideal A := P.asIdeal
  let L := Localization.AtPrime p
  let := TopCat.Presheaf.algebra_section_stalk Y.presheaf ⟨y, hyU⟩
  have hloc := hU'.isLocalization_stalk ⟨y, hyU⟩
  let eL : L ≃ₐ[A] Y.presheaf.stalk y := IsLocalization.algEquiv p.primeCompl L _
  let : IsRegularLocalRing L := IsRegularLocalRing.of_ringEquiv eL.symm.toRingEquiv
  let I : DivisorComponent D → Ideal A := fun C => (vanishingIdeal C.val).ideal U'
  have hmeet : ∀ C : ι, ((C.1.val : Set Y) ∩ Set.range U'.2.fromSpec).Nonempty := by
    intro C
    refine ⟨y, C.2, ?_⟩
    rw [hU'.range_fromSpec]
    exact hyU
  have hcontain : ∀ C : ι, I C.1 ≤ p := fun C =>
    ideal_le_primeIdealOf_of_mem_support (vanishingIdeal C.1.val) U' hyU C.2
  have hinfo : ∀ C : ι, (I C.1).IsPrime ∧ (I C.1).height = 1 ∧ IsRegularRing (A ⧸ I C.1) :=
    fun C => component_affine_prime_data D hD C.1 U' (hmeet C)
  have hgen : ∀ C : ι, ∃ b : L, b ∈ maximalIdeal L ∧ b ∉ maximalIdeal L ^ 2 ∧
      (I C.1).map (algebraMap A L) = Ideal.span {b} := by
    intro C
    let : (I C.1).IsPrime := (hinfo C).1
    let : IsRegularRing (A ⧸ I C.1) := (hinfo C).2.2
    exact exists_parameter_generator_atPrime (I C.1) p (hcontain C) (hinfo C).2.1
  choose a ham ham2 haspan using hgen
  have hgerm : (Y.presheaf.germ U y hyU).hom = (eL.toRingEquiv.toRingHom).comp (algebraMap A L) := by
    ext f
    exact (eL.commutes f).symm
  have hmemO : ∀ C : ι, eL (a C) ∈ maximalIdeal (Y.presheaf.stalk y) := by
    intro C hu
    apply ham C
    have h2 := hu.map eL.symm
    rwa [AlgEquiv.symm_apply_apply] at h2
  let t : ι → maximalIdeal (Y.presheaf.stalk y) := fun C ↦ ⟨eL (a C), hmemO C⟩
  refine ⟨t, fun C ↦ ?_, ?_, ?_⟩
  · rw [stalkIdeal_eq_map_germ (vanishingIdeal C.1.val) U' hyU, hgerm, ← Ideal.map_map]
    change ((I C.1).map (algebraMap A L)).map _ = _
    rw [haspan C, Ideal.map_span, Set.image_singleton]
    rfl
  · -- the ideal of `D` (END-LOC's `exists_snc_local_equations`, with these equations)
    have haprime : ∀ C : ι, Prime (a C) :=
      fun C => prime_of_mem_maximalIdeal_of_not_mem_sq (ham C) (ham2 C)
    have hdist : ∀ C ∈ (Finset.univ : Finset ι), ∀ C' ∈ (Finset.univ : Finset ι), C ≠ C' →
        ¬ a C ∣ a C' := by
      intro C _ C' _ hne hdiv
      have hd : ∀ C : ι, Disjoint (p.primeCompl : Set A) (I C.1 : Set A) := fun C =>
        Set.disjoint_left.mpr (fun x hxM hxI ↦ hxM (hcontain C hxI))
      have hJheight : ∀ C : ι, ((I C.1).map (algebraMap A L)).height = 1 := by
        intro C
        let : (I C.1).IsPrime := (hinfo C).1
        exact (IsLocalization.height_map_of_disjoint (S := L) p.primeCompl (I C.1) (hd C)).trans
          (hinfo C).2.1
      have hle : (I C'.1).map (algebraMap A L) ≤ (I C.1).map (algebraMap A L) := by
        rw [haspan C, haspan C']
        exact Ideal.span_singleton_le_span_singleton.mpr hdiv
      let : (I C'.1).IsPrime := (hinfo C').1
      let : (I C.1).IsPrime := (hinfo C).1
      let : ((I C'.1).map (algebraMap A L)).IsPrime :=
        IsLocalization.isPrime_of_isPrime_disjoint p.primeCompl L (I C'.1) inferInstance (hd C')
      have heqJ : (I C'.1).map (algebraMap A L) = (I C.1).map (algebraMap A L) :=
        ((I C'.1).map (algebraMap A L)).eq_of_le_of_height_le hle
          (by rw [hJheight C, hJheight C'])
      have heqI := congrArg (fun J : Ideal L ↦ J.under A) heqJ
      rw [IsLocalization.under_map_of_isPrime_disjoint p.primeCompl L inferInstance (hd C'),
        IsLocalization.under_map_of_isPrime_disjoint p.primeCompl L inferInstance (hd C)] at heqI
      exact hne (Subtype.ext (component_affine_ideal_injective D U' C'.1 C.1
        (hmeet C') (hmeet C) heqI).symm)
    have hDU : (D.ideal U').map (algebraMap A L) = Ideal.span {∏ C, a C} := by
      have h1 : D.ideal U' = (Finset.univ : Finset (DivisorComponent D)).inf I := by
        let : IsReduced D.subscheme := hD.reduced
        conv_lhs => rw [← selectedDivisor_univ_eq D]
        exact selectedDivisor_ideal D Finset.univ U'
      let F : Finset (DivisorComponent D) := Finset.univ.filter fun C => y ∈ C.val
      have hfilter : (Finset.univ.filter fun C => I C ≤ p) = F := by
        ext C
        simp only [Finset.mem_filter, Finset.mem_univ, true_and, F]
        constructor
        · intro hC
          by_contra hyC
          apply hyC
          have hsupp : y ∈ (vanishingIdeal C.val).support := by
            rw [mem_support_iff_of_mem (U := U') hyU, Scheme.mem_zeroLocus_iff]
            intro f hf hyf
            rw [Scheme.mem_basicOpen _ _ _ hyU] at hyf
            exact (mem_primeIdealOf_iff_germ_mem hU' hyU f).mp (hC hf) hyf
          exact hsupp
        · intro hyC
          exact hcontain ⟨C, hyC⟩
      rw [h1, map_finset_inf_filter p, hfilter, map_finset_inf p.primeCompl]
      have heq : F.inf (fun C ↦ (I C).map (algebraMap A L)) =
          (Finset.univ : Finset ι).inf (fun C ↦ Ideal.span {a C}) := by
        apply le_antisymm
        · refine Finset.le_inf fun C _ ↦ ?_
          rw [← haspan C]
          exact Finset.inf_le (Finset.mem_filter.mpr ⟨Finset.mem_univ _, C.2⟩)
        · refine Finset.le_inf fun C hC ↦ ?_
          have hyC : y ∈ C.val := (Finset.mem_filter.mp hC).2
          rw [haspan ⟨C, hyC⟩]
          exact Finset.inf_le (Finset.mem_univ (⟨C, hyC⟩ : ι))
      rw [heq]
      exact Geometry.SNCSubdivisorProducts.finset_inf_span_singleton_of_prime _ a
        (fun C _ => haprime C) hdist
    rw [stalkIdeal_eq_map_germ D U' hyU, hgerm, ← Ideal.map_map]
    change ((D.ideal U').map (algebraMap A L)).map _ = _
    rw [hDU, Ideal.map_span, Set.image_singleton, map_prod, finprod_eq_prod_of_fintype]
    rfl
  -- independence
  by_cases hι : IsEmpty ι
  · exact linearIndependent_empty_type
  rw [not_isEmpty_iff] at hι
  let J : Finset (DivisorComponent D) := Finset.univ.filter fun C ↦ y ∈ C.val
  have hJmem : ∀ C, C ∈ J ↔ y ∈ C.val := fun C ↦ by simp [J]
  have hJ : J.Nonempty := by
    obtain ⟨C⟩ := hι
    exact ⟨C.1, (hJmem C.1).mpr C.2⟩
  let E := componentIntersection D J
  let IU := E.ideal U'
  have hIU : IU = ⨆ C ∈ J, I C := by
    change (⨆ C ∈ J, vanishingIdeal C.val).ideal U' = _
    rw [ideal_iSup, iSup_apply]
    refine iSup_congr fun C ↦ ?_
    by_cases hC : C ∈ J
    · simp only [hC, iSup_pos]
      rfl
    · simp only [hC, not_false_eq_true, iSup_neg, ideal_bot]
      rfl
  let IL := IU.map (algebraMap A L)
  have hIL : IL = Ideal.span (Set.range a) := by
    apply le_antisymm
    · change IU.map (algebraMap A L) ≤ _
      rw [hIU, Ideal.map_iSup]
      refine iSup_le fun C ↦ ?_
      rw [Ideal.map_iSup]
      refine iSup_le fun hC ↦ ?_
      rw [haspan ⟨C, (hJmem C).mp hC⟩]
      exact Ideal.span_mono (Set.singleton_subset_iff.mpr ⟨_, rfl⟩)
    · rw [Ideal.span_le]
      rintro _ ⟨C, rfl⟩
      have h1 : a C ∈ (I C.1).map (algebraMap A L) := by
        rw [haspan C]
        exact Ideal.subset_span rfl
      refine Ideal.map_mono ?_ h1
      rw [hIU]
      exact le_iSup₂_of_le C.1 ((hJmem C.1).mpr C.2) le_rfl
  have hyE : y ∈ E.support := by
    rw [componentIntersection_support]
    exact Closeds.mem_iInf.mpr fun C ↦ Closeds.mem_iInf.mpr fun hC ↦ (hJmem C).mp hC
  have hIUp : IU ≤ p := ideal_le_primeIdealOf_of_mem_support E U' hyU hyE
  have hEI : E.comap U'.2.fromSpec = specIdealSheaf A IU := Geometry.BlowupCartier.comap_fromSpec E U'
  have hregI : IsRegularScheme (specIdealSheaf A IU).subscheme := by
    rw [← hEI]
    exact (hD.intersectionsRegular J hJ).of_isOpenImmersion
      (Geometry.SNCLocality.comapSubschemeMap U'.2.fromSpec E)
  let : IsRegularRing (A ⧸ IU) :=
    Geometry.SNCSubdivisorComponent.isRegularRing_quotient_of_specIdealSheaf IU hregI
  let : IsRegularLocalRing (L ⧸ IL) := isRegularLocalRing_localization_quotient IU p hIUp
  -- the height of `IL` is the number of components through `y`
  let : IsDomain (L ⧸ IL) := Algebra.RegularLocalDomain.isDomain_of_isRegularLocalRing _
  let : IL.IsPrime := (Ideal.Quotient.isDomain_iff_prime IL).mp inferInstance
  let Pz : Ideal A := IL.under A
  have hmapPz : Pz.map (algebraMap A L) = IL := IsLocalization.map_under p.primeCompl L IL
  have hdisj : Disjoint (p.primeCompl : Set A) (Pz : Set A) := by
    rw [Set.disjoint_left]
    intro x hx hxP
    have hu : IsUnit (algebraMap A L x) := IsLocalization.map_units L (⟨x, hx⟩ : p.primeCompl)
    exact (Ideal.IsPrime.ne_top ‹IL.IsPrime›) (Ideal.eq_top_of_isUnit_mem IL (Ideal.mem_comap.mp hxP) hu)
  have hIUPz : IU ≤ Pz := Ideal.le_comap_map
  let q : Spec A := (⟨Pz, inferInstance⟩ : PrimeSpectrum A)
  let z := U'.2.fromSpec q
  have hzE : z ∈ E.support := by
    have hq : q ∈ ((E.comap U'.2.fromSpec).support : Set (Spec A)) := by
      rw [hEI, specIdealSheaf_support]
      exact (PrimeSpectrum.mem_zeroLocus _ _).mpr hIUPz
    rwa [support_comap] at hq
  have hzU : z ∈ U := by
    have hz : z ∈ Set.range U'.2.fromSpec := ⟨q, rfl⟩
    rwa [hU'.range_fromSpec] at hz
  have hmax : ∀ w ∈ E.support, z ∈ closure ({w} : Set Y) → w = z := by
    intro w hw hzw
    have hwz : w ⤳ z := specializes_iff_mem_closure.mpr hzw
    have hwU : w ∈ U := hwz.mem_open U.isOpen hzU
    obtain ⟨q', rfl⟩ : w ∈ Set.range U'.2.fromSpec := by
      rw [hU'.range_fromSpec]
      exact hwU
    have hspec : q' ⤳ q :=
      (U'.2.fromSpec.isOpenEmbedding.isInducing.specializes_iff).mp hwz
    have hle : q'.asIdeal ≤ Pz := (PrimeSpectrum.le_iff_specializes q' q).mpr hspec
    have hq'E : IU ≤ q'.asIdeal := by
      have hq' : q' ∈ ((E.comap U'.2.fromSpec).support : Set (Spec A)) := by
        rw [support_comap]
        exact hw
      rw [hEI, specIdealSheaf_support] at hq'
      exact (PrimeSpectrum.mem_zeroLocus _ _).mp hq'
    have h1 : q'.asIdeal.map (algebraMap A L) = IL :=
      le_antisymm (hmapPz ▸ Ideal.map_mono hle) (Ideal.map_mono hq'E)
    have hdisj' : Disjoint (p.primeCompl : Set A) (q'.asIdeal : Set A) :=
      hdisj.mono_right hle
    have h2 : q'.asIdeal = Pz := by
      rw [← IsLocalization.under_map_of_isPrime_disjoint p.primeCompl L q'.isPrime hdisj', h1]
    have : q' = q := PrimeSpectrum.ext h2
    rw [this]
  have hdim := ringKrullDim_stalk_eq_of_hasPureCodimension (hD.intersectionsCodimension J hJ)
    hzE hmax
  have hdim' : ringKrullDim ((Spec A).presheaf.stalk q) = J.card :=
    (ringKrullDim_eq_of_ringEquiv
      (asIso (U'.2.fromSpec.stalkMap q)).commRingCatIsoToRingEquiv).symm.trans hdim
  have hheight : Pz.height = J.card := by
    rw [ringKrullDim_stalk_eq_coheight, ← idealHeight_eq_coheight] at hdim'
    exact_mod_cast hdim'
  have hILheight : IL.height = J.card := by
    rw [← hmapPz, IsLocalization.height_map_of_disjoint p.primeCompl Pz hdisj, hheight]
  -- transport to the stalk
  have hspan : Ideal.span (Set.range fun C ↦ (t C : Y.presheaf.stalk y)) =
      IL.map (eL : L →+* Y.presheaf.stalk y) := by
    rw [hIL, Ideal.map_span, ← Set.range_comp]
    rfl
  let : IsRegularLocalRing (Y.presheaf.stalk y ⧸
      Ideal.span (Set.range fun C ↦ (t C : Y.presheaf.stalk y))) :=
    IsRegularLocalRing.of_ringEquiv (Ideal.quotientEquiv IL _ eL.toRingEquiv hspan)
  have hhmap : (IL.map (eL : L →+* Y.presheaf.stalk y)).height = IL.height := by
    have h := RingEquiv.height_map eL.toRingEquiv IL
    rw [← Ideal.map_coe] at h
    exact h
  apply linearIndependent_toCotangent_of_isRegularLocalRing_quotient t
  rw [hspan, hhmap, hILheight, Fintype.card_subtype]

end DeJongAlterations.StableModification.Resolution
