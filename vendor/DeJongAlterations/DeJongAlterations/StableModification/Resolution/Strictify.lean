import DeJongAlterations.StableModification.Resolution.StrictifySNC
import DeJongAlterations.Theorem

/-!
# Strictification of normal crossings divisors

**Theorem** (de Jong 1996, 2.4, `references/dejong96-alterations/tex/page-0006.tex`: "a divisor
with normal crossings becomes a divisor with strict normal crossings after blowing up").
Let `X` be a regular projective variety over an algebraically closed field `k` and `Z ⊆ X` a
normal crossings divisor (`IsNormalCrossings`: at every closed point the completed local ideal of
`Z` is generated by `t_1 ⋯ t_s` for part of a regular system of parameters). Then there is a
projective modification `π : X' → X`, a composition of blowups along regular strata, with `X'`
regular and `π⁻¹ Z` (with its reduced structure) a strict normal crossings divisor in Codex's
sense (`IsStrictNormalCrossings`). In the form of Codex's output structure:
`∃ d : AlterationWithBoundary p Z, IsModification d.alteration` (`exists_alterationWithBoundary`).

The proof: `Z` is a normal crossings family with one member of multiplicity at most `dim X`
(`isNCFamily_of_isNormalCrossings`); repeated blowups of the deepest strata
(`exists_modification_ncFamily_le_one`) lower the multiplicity to `1`, and a normal crossings
family of multiplicity one has strict normal crossings (`isStrictNormalCrossings_of_isNCFamily`).
-/

noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace IsLocalRing

namespace DeJongAlterations.StableModification.Resolution.Strictify

set_option backward.isDefEq.respectTransparency false

open Scheme.IdealSheafData

universe u

/-- **Extension to a regular system of parameters.** A family `t` of elements of `𝔪` with
linearly independent classes in `𝔪/𝔪²` extends to a family `T` (indexed by `Fin (s + e)`, with
`T (castAdd i) = t i`) with linearly independent classes generating `𝔪`. -/
theorem exists_extend_parameters {R : Type*} [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    {s : ℕ} (t : Fin s → maximalIdeal R)
    (ht : LinearIndependent (ResidueField R) fun i ↦ (maximalIdeal R).toCotangent (t i)) :
    ∃ (e : ℕ) (T : Fin (s + e) → maximalIdeal R), (∀ i, T (Fin.castAdd e i) = t i) ∧
      LinearIndependent (ResidueField R) (fun i ↦ (maximalIdeal R).toCotangent (T i)) ∧
      Ideal.span (Set.range fun i ↦ (T i : R)) = maximalIdeal R := by
  classical
  let K := ResidueField R
  let v : Fin s → CotangentSpace R := fun i ↦ (maximalIdeal R).toCotangent (t i)
  let W : Submodule K (CotangentSpace R) := Submodule.span K (Set.range v)
  let b := Module.finBasis K (CotangentSpace R ⧸ W)
  let e := Module.finrank K (CotangentSpace R ⧸ W)
  choose w' hw' using fun i : Fin e ↦ Submodule.Quotient.mk_surjective W (b i)
  choose w hw using fun i : Fin e ↦ Ideal.toCotangent_surjective (maximalIdeal R) (w' i)
  let T : Fin (s + e) → maximalIdeal R := fun j ↦ Sum.elim t w (finSumFinEquiv.symm j)
  have hT : (fun j ↦ (maximalIdeal R).toCotangent (T j)) =
      Sum.elim v w' ∘ finSumFinEquiv.symm := by
    funext j
    simp only [T, Function.comp_apply]
    rcases finSumFinEquiv.symm j with i | i
    · rfl
    · simp [hw]
  have hli : LinearIndependent K (Sum.elim v w') := by
    let f : Fin s → W := fun i ↦ ⟨v i, Submodule.subset_span (Set.mem_range_self i)⟩
    have hf : LinearIndependent K f := LinearIndependent.of_comp W.subtype ht
    have hg : LinearIndependent K (Submodule.Quotient.mk (p := W) ∘ w') := by
      have : Submodule.Quotient.mk (p := W) ∘ w' = b := funext hw'
      rw [this]
      exact b.linearIndependent
    exact hf.sumElim_of_quotient w' hg
  have hspan : Submodule.span K (Set.range (Sum.elim v w')) = ⊤ := by
    let N := Submodule.span K (Set.range (Sum.elim v w'))
    have hWN : W ≤ N := Submodule.span_mono fun _ ⟨i, hi⟩ ↦ ⟨Sum.inl i, hi⟩
    have hmap : N.map W.mkQ = ⊤ := by
      rw [eq_top_iff, ← b.span_eq, Submodule.span_le]
      rintro _ ⟨i, rfl⟩
      exact ⟨w' i, Submodule.subset_span ⟨Sum.inr i, rfl⟩, hw' i⟩
    rw [Submodule.map_mkQ_eq_top, sup_eq_right.mpr hWN] at hmap
    exact hmap
  refine ⟨e, T, fun i ↦ by simp [T], ?_, ?_⟩
  · rw [hT]
    exact hli.comp _ finSumFinEquiv.symm.injective
  · have h1 : Submodule.span K ((maximalIdeal R).toCotangent '' Set.range T) = ⊤ := by
      rw [← Set.range_comp]
      change Submodule.span K (Set.range fun j ↦ (maximalIdeal R).toCotangent (T j)) = ⊤
      rw [hT, Set.range_comp, finSumFinEquiv.symm.range_eq_univ, Set.image_univ]
      exact hspan
    rw [CotangentSpace.span_image_eq_top_iff] at h1
    have h2 := congrArg (Submodule.map (maximalIdeal R).subtype) h1
    rw [Submodule.map_span, Submodule.map_top, Submodule.range_subtype, ← Set.range_comp] at h2
    exact h2

/-- **Normal crossings from local equations by part of a regular system of parameters.** If at
every closed point `I(Z)_x Ô_{X,x} = (t_1 ⋯ t_s)` for elements `t_i` of the maximal ideal with
linearly independent classes in `𝔪/𝔪²`, then `Z` is a normal crossings divisor. -/
theorem isNormalCrossings_of_forall_exists {X : Scheme.{u}} [IsLocallyNoetherian X]
    (Z : Closeds X)
    (h : ∀ x : X, IsClosed ({x} : Set X) → ∃ (s : ℕ) (t : Fin s → maximalIdeal (X.completedLocalRing x)),
      LinearIndependent (ResidueField (X.completedLocalRing x))
        (fun i ↦ (maximalIdeal (X.completedLocalRing x)).toCotangent (t i)) ∧
      formalIdeal Z x = Ideal.span {∏ i, (t i : X.completedLocalRing x)}) :
    IsNormalCrossings Z := by
  classical
  intro x hx
  obtain ⟨s, t, ht, hZ⟩ := h x hx
  obtain ⟨e, T, hTt, hT, hTspan⟩ := exists_extend_parameters t ht
  exact ⟨
    { n := s + e
      t := T
      indep := hT
      span_eq := hTspan
      A := fun _ ↦ Finset.univ.map (Fin.castAddEmb e)
      disjoint := fun l l' h ↦ absurd (Subsingleton.elim l l') h
      formalIdeal_eq := fun _ ↦ by
        rw [hZ, Finset.prod_map]
        simp [hTt] }⟩

/-- A normal crossings divisor is a normal crossings family with one member, of multiplicity at
most `m` whenever all closed local rings have dimension at most `m`. -/
theorem isNCFamily_of_isNormalCrossings {X : Scheme.{u}} [IsLocallyNoetherian X]
    (hX : IsRegularScheme X) (Z : Closeds X) (hZ : IsNormalCrossings Z) (m : ℕ)
    (hm : ∀ x : X, IsClosed ({x} : Set X) → ringKrullDim (X.presheaf.stalk x) ≤ m) :
    IsNCFamily (fun _ : Option (Fin 0) ↦ Z) (fun l ↦ l.elim m fun _ ↦ 1) := by
  intro x hx
  obtain ⟨c⟩ := hZ x hx
  have : IsRegularLocalRing (X.presheaf.stalk x) := hX x
  have hn : (c.n : WithBot ℕ∞) ≤ m :=
    (card_le_ringKrullDim_of_linearIndependent c.t c.indep).trans (hm x hx)
  refine ⟨
    { n := c.n
      t := c.t
      indep := c.indep
      span_eq := c.span_eq
      A := fun l ↦ l.elim (c.A ()) fun i ↦ i.elim0
      disjoint := by
        rintro (_ | i) (_ | i') h
        · exact absurd rfl h
        · exact i'.elim0
        · exact i.elim0
        · exact i.elim0
      formalIdeal_eq := by
        rintro (_ | i)
        · exact c.formalIdeal_eq ()
        · exact i.elim0 }, ?_⟩
  rintro (_ | i)
  · have h1 : ((c.A ()).card : WithBot ℕ∞) ≤ m := by
      have := Finset.card_le_univ (c.A ())
      rw [Fintype.card_fin] at this
      exact (WithBot.coe_le_coe.mpr (by exact_mod_cast this)).trans hn
    exact_mod_cast h1
  · exact i.elim0

variable {k : Type u} [Field k] [IsAlgClosed k]

/-- **Strictification** (explicit form). For a regular projective variety `X` over `k = k̄` and a
normal crossings divisor `Z`, there is a projective modification `π : X' → X` with `X'` regular
and `π⁻¹ Z` a strict normal crossings divisor. -/
theorem exists_modification_isStrictNormalCrossings {X : Scheme.{u}} (p : X ⟶ Spec (.of k))
    [IsVariety p] [IsLocallyNoetherian X] (hp : IsProjectiveOver p) (hX : IsRegularScheme X)
    (Z : Closeds X) (hZ : IsNormalCrossings Z) :
    ∃ (X' : Scheme.{u}) (π : X' ⟶ X), IsModification π ∧ IsProjectiveOver (π ≫ p) ∧
      IsRegularScheme X' ∧
      IsStrictNormalCrossings (vanishingIdeal (Z.preimage π.continuous)) := by
  have : Smooth p := Geometry.RegularSmoothConverse.smooth_of_isRegularScheme p hX
  obtain ⟨m, hm⟩ := DeJong.exists_nat_topologicalKrullDim_eq p
  have hF := isNCFamily_of_isNormalCrossings hX Z hZ m fun x hx ↦ by
    rw [ringKrullDim_stalk_eq_of_isClosed p x hx, hm]
  obtain ⟨X', _, π, r', F', hmod, hproj, hreg', hF', hunion⟩ :=
    exists_modification_ncFamily_le_one m p _ hF hp
  have : IsIntegral X' := hmod.sourceIntegral
  have : LocallyOfFiniteType (π ≫ p) := inferInstance
  have hB : (⨆ l, F' l) = Z.preimage π.continuous := by
    refine SetLike.ext fun y ↦ ?_
    rw [mem_iSup_closeds, hunion y]
    constructor
    · rintro ⟨-, h⟩
      exact h
    · intro h
      exact ⟨none, h⟩
  refine ⟨X', π, hmod, hproj, hreg', ?_⟩
  rw [← hB]
  exact isStrictNormalCrossings_of_isNCFamily (π ≫ p) hreg' hF'

/-- **Strictification of normal crossings divisors** (de Jong 2.4), in the form of Codex's output
structure: for a regular projective variety `X` over `k = k̄` and a normal crossings divisor `Z`,
there is an `AlterationWithBoundary` of `(X, Z)` whose alteration is a modification (a composition
of blowups along regular strata), with source equal to its compactification and boundary the
reduced preimage of `Z`. -/
theorem exists_alterationWithBoundary {X : Scheme.{u}} (p : X ⟶ Spec (.of k)) [IsVariety p]
    [IsLocallyNoetherian X] (hp : IsProjectiveOver p) (hX : IsRegularScheme X) (Z : Closeds X)
    (hZ : IsNormalCrossings Z) :
    ∃ d : AlterationWithBoundary p (Z : Set X), IsModification d.alteration := by
  obtain ⟨X', π, hmod, hproj, hreg', hsnc⟩ :=
    exists_modification_isStrictNormalCrossings p hp hX Z hZ
  have : IsIntegral X' := hmod.sourceIntegral
  have : IsProper (π ≫ p) := hproj.isProper
  have hvar : IsVariety (π ≫ p) := { }
  refine ⟨
    { source := X'
      compactification := X'
      sourceStructure := π ≫ p
      compactificationStructure := π ≫ p
      alteration := π
      inclusion := 𝟙 X'
      boundary := vanishingIdeal (Z.preimage π.continuous)
      sourceVariety := hvar
      compactificationVariety := hvar
      alterationOver := rfl
      inclusionOver := Category.id_comp _
      isAlteration := inferInstance
      isOpenImmersion := inferInstance
      projective := hproj
      regular := hreg'
      normalCrossings := hsnc
      boundarySupport := ?_ }, hmod⟩
  rw [Geometry.ReducedClosedSubscheme.support_vanishingIdeal]
  ext y
  simp

end DeJongAlterations.StableModification.Resolution.Strictify
