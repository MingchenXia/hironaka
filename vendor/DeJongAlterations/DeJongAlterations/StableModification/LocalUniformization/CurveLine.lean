import DeJongAlterations.StableModification.LocalUniformization.CurveCofinal

/-!
# The affine line over a valuation ring and its function field

For a valuation ring `R` of a field `K`, the affine line `𝔸¹_R = Spec R[X]` with the smooth
standard model `Curves.smoothModel R : 𝔸¹_R → Spec R` is an integral, separated, quasi-compact,
strictly semi-stable relative curve. Its function field `K(𝔸¹_R)` (with the `K`-algebra structure
`LocalUniformization.functionFieldAlgebra`) is `K(t)` for the image `t` of `X`
(`adjoin_lineGenerator_eq_top`, `transcendental_lineGenerator`). For an element `S` of a field
`L ⊇ K` transcendental over `K` there is a `K`-embedding `K(𝔸¹_R) → L` sending `t` to `S`
(`lineEmbedding`), with image `K(S)` (`fieldRange_lineEmbedding`).

This is the curve `C̄ = Spec(Ā)`, `Ā = k[T]`, of M. Temkin, *Stable modification of relative
curves*, J. Algebraic Geom. 19 (2010), proof of Proposition 4.3.3 (`semi-stable.tex`
lines 3062–3064), over the base `R` (Temkin writes `k[T]` for `R[T]`). Blueprint
`lem:sm-lu-curve-line` (`sm-local-uniformization-curve.tex`).
-/

noncomputable section

open AlgebraicGeometry CategoryTheory IsLocalRing Polynomial
open scoped IntermediateField

universe u

namespace DeJongAlterations.StableModification.LocalUniformization.Curve

open ValCurves RiemannZariskiSpace Curves
open _root_.DeJongAlterations.StableModification.ValuationRing (fiberTrdeg)

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

variable {K : Type u} [Field K] (R : ValuationSubring K)

/-- The ring `R[X]` as a commutative ring (a `def`, so that instances on its spectrum are found). -/
def lineRing : CommRingCat.{u} := CommRingCat.of R[X]

instance : IsDomain (lineRing R) := inferInstanceAs (IsDomain R[X])

/-- The affine line `𝔸¹_R → Spec R` (Curves' smooth standard model). -/
def lineModel : Spec (lineRing R) ⟶ Spec (.of R) := smoothModel R

instance : Flat (lineModel R) := inferInstanceAs (Flat (smoothModel R))

instance : LocallyOfFinitePresentation (lineModel R) :=
  inferInstanceAs (LocallyOfFinitePresentation (smoothModel R))

theorem isStrictlySemistable_lineModel : IsStrictlySemistable (lineModel R) ⊤ :=
  isStrictlySemistable_smoothModel R

/-- The map `R[X] → K(𝔸¹_R)`. -/
abbrev lineAlgebraMap : R[X] →+* (Spec (lineRing R)).functionField :=
  algebraMap (lineRing R) (Spec (lineRing R)).functionField

/-- The image of `X` in the function field of `𝔸¹_R`. -/
def lineGenerator : (Spec (lineRing R)).functionField := lineAlgebraMap R X

/-- The `K`-algebra structure on the function field of `𝔸¹_R` restricts on `R` to the constant
polynomials. -/
theorem algebraMap_line_coe (r : R) :
    letI := functionFieldAlgebra (lineModel R)
    algebraMap K (Spec (lineRing R)).functionField (r : K) = lineAlgebraMap R (C r) := by
  rw [functionFieldAlgebra_algebraMap_coe, fieldMap]
  have h : genericPt (Spec (lineRing R)) ≫ lineModel R =
      Spec.map (CommRingCat.ofHom (algebraMap R R[X]) ≫
        StructureSheaf.toStalk (lineRing R) (genericPoint (Spec (lineRing R)))) := by
    rw [genericPt, Spec.fromSpecStalk_eq', lineModel, smoothModel, Spec.map_comp]
  rw [h, Spec.preimage_map]
  rfl


variable {R}

/-- `R[X] → K(𝔸¹_R)` is evaluation at `t` after `R ⊆ K`. -/
theorem lineAlgebraMap_eq_aeval (P : R[X]) :
    letI := functionFieldAlgebra (lineModel R)
    lineAlgebraMap R P = aeval (lineGenerator R) (P.map R.subtype) := by
  let := functionFieldAlgebra (lineModel R)
  conv_lhs => rw [← eval₂_C_X (p := P)]
  rw [hom_eval₂, aeval_def, eval₂_map]
  congr 1
  exact RingHom.ext fun r ↦ (algebraMap_line_coe R r).symm

variable (R)

/-- The function field of `𝔸¹_R` is generated by `t` over `K`. -/
theorem adjoin_lineGenerator_eq_top :
    letI := functionFieldAlgebra (lineModel R)
    K⟮lineGenerator R⟯ = ⊤ := by
  let := functionFieldAlgebra (lineModel R)
  refine eq_top_iff.mpr fun z _ ↦ ?_
  obtain ⟨a, b, -, rfl⟩ := IsFractionRing.div_surjective (lineRing R) z
  have hmem : ∀ P : R[X], lineAlgebraMap R P ∈ K⟮lineGenerator R⟯ := fun P ↦ by
    rw [lineAlgebraMap_eq_aeval]
    exact IntermediateField.algebra_adjoin_le_adjoin K _ (aeval_mem_adjoin_singleton K _)
  exact div_mem (hmem a) (hmem b)

/-- `t` is transcendental over `K`. -/
theorem transcendental_lineGenerator :
    letI := functionFieldAlgebra (lineModel R)
    Transcendental K (lineGenerator R) := by
  let := functionFieldAlgebra (lineModel R)
  rw [transcendental_iff]
  intro q hq
  obtain ⟨b, hbM, hb⟩ := IsLocalization.integerNormalization_spec (nonZeroDivisors R) q
  set q' := IsLocalization.integerNormalization (nonZeroDivisors R) q
  have hsmul : b • q = C (b : K) * q := by
    rw [← smul_eq_C_mul, ← algebraMap_smul K b q]
    rfl
  have hq'map : q'.map R.subtype = C (b : K) * q := by rw [← hsmul]; exact hb
  have h1 : lineAlgebraMap R q' = 0 := by
    rw [lineAlgebraMap_eq_aeval, hq'map, map_mul, hq, mul_zero]
  have h2 : q' = 0 :=
    (IsFractionRing.injective (lineRing R) (Spec (lineRing R)).functionField) (by
      rw [map_zero]
      exact h1)
  have h3 : C (b : K) * q = 0 := by rw [← hq'map, h2, Polynomial.map_zero]
  have hb0 : (b : K) ≠ 0 := fun h ↦ nonZeroDivisors.ne_zero hbM (Subtype.ext h)
  rw [mul_eq_zero, C_eq_zero] at h3
  exact h3.resolve_left hb0

/-- The function field of `𝔸¹_R` is finitely generated over `K`. -/
theorem fg_line :
    letI := functionFieldAlgebra (lineModel R)
    (⊤ : IntermediateField K (Spec (lineRing R)).functionField).FG := by
  let := functionFieldAlgebra (lineModel R)
  exact ⟨{lineGenerator R}, by rw [Finset.coe_singleton, adjoin_lineGenerator_eq_top]⟩

/-- The function field of `𝔸¹_R` is algebraic over `K(t)`. -/
theorem isAlgebraic_line :
    letI := functionFieldAlgebra (lineModel R)
    Algebra.IsAlgebraic K⟮lineGenerator R⟯ (Spec (lineRing R)).functionField := by
  let := functionFieldAlgebra (lineModel R)
  refine ⟨fun z ↦ ?_⟩
  have hz : z ∈ K⟮lineGenerator R⟯ := by
    rw [adjoin_lineGenerator_eq_top]
    trivial
  exact isAlgebraic_algebraMap (⟨z, hz⟩ : K⟮lineGenerator R⟯)

/-- The function field of `𝔸¹_R` has transcendence degree one over `K`. -/
theorem trdeg_line :
    letI := functionFieldAlgebra (lineModel R)
    Algebra.trdeg K (Spec (lineRing R)).functionField = 1 := by
  let := functionFieldAlgebra (lineModel R)
  exact Valuation.DVRCoordinate.trdeg_eq_one_of_isAlgebraic (transcendental_lineGenerator R)
    (isAlgebraic_line R)

/-- `𝔸¹_R` is a relative curve. -/
theorem fiberTrdeg_line_le : fiberTrdeg (lineModel R) (genericPoint (Spec (lineRing R))) ≤ 1 := by
  let := functionFieldAlgebra (lineModel R)
  rw [← trdeg_functionField_eq, trdeg_line]

/-- The function field of `𝔸¹_R` is finite over `K(b)` for every transcendental `b`. -/
theorem finiteDimensional_line :
    letI := functionFieldAlgebra (lineModel R)
    ∀ b : (Spec (lineRing R)).functionField, Transcendental K b →
      FiniteDimensional K⟮b⟯ (Spec (lineRing R)).functionField := by
  let := functionFieldAlgebra (lineModel R)
  intro b hb
  have : Algebra.IsAlgebraic K⟮b⟯ (Spec (lineRing R)).functionField :=
    Valuation.DVRCoordinate.isAlgebraic_adjoin_of_transcendental
      (transcendental_lineGenerator R) (isAlgebraic_line R) hb
  exact Valuation.DVRCoordinate.finiteDimensional_adjoin_of_transcendental (fg_line R)

/-! ### Embedding the function field of the line -/

variable {L : Type u} [Field L] [Algebra K L] {S : L} (hS : Transcendental K S)

/-- Evaluation `R[X] → L` at `S`. -/
def lineEval (S : L) : lineRing R →+* L := eval₂RingHom ((algebraMap K L).comp R.subtype) S

include hS in
/-- Evaluation `R[X] → L` at a transcendental `S` is injective. -/
theorem lineEval_injective : Function.Injective (lineEval R S) := by
  rw [injective_iff_map_eq_zero]
  intro P hP
  have h1 : aeval S (P.map R.subtype) = 0 := by
    rw [aeval_def, eval₂_map]
    exact hP
  have h2 := (transcendental_iff.mp hS) _ h1
  exact Polynomial.map_injective _ Subtype.val_injective (by rw [h2, Polynomial.map_zero])

/-- The embedding `K(𝔸¹_R) → L`, `t ↦ S`. -/
def lineEmbedding : (Spec (lineRing R)).functionField →+* L :=
  IsFractionRing.lift (A := lineRing R) (lineEval_injective R hS)

theorem lineEmbedding_lineAlgebraMap (P : R[X]) :
    lineEmbedding R hS (lineAlgebraMap R P) = aeval S (P.map R.subtype) := by
  have h := IsFractionRing.lift_algebraMap (A := lineRing R)
    (K := (Spec (lineRing R)).functionField) (lineEval_injective R hS) P
  calc lineEmbedding R hS (lineAlgebraMap R P) = lineEval R S P := h
    _ = aeval S (P.map R.subtype) := by
      rw [aeval_def, eval₂_map]
      rfl

theorem lineEmbedding_lineGenerator : lineEmbedding R hS (lineGenerator R) = S := by
  rw [lineGenerator, lineEmbedding_lineAlgebraMap, Polynomial.map_X, aeval_X]

/-- `lineEmbedding` is a `K`-algebra map. -/
theorem lineEmbedding_comp_algebraMap :
    letI := functionFieldAlgebra (lineModel R)
    (lineEmbedding R hS).comp (algebraMap K (Spec (lineRing R)).functionField) =
      algebraMap K L := by
  let := functionFieldAlgebra (lineModel R)
  refine IsLocalization.ringHom_ext (nonZeroDivisors R) (RingHom.ext fun r ↦ ?_)
  simp only [RingHom.comp_apply]
  change lineEmbedding R hS (algebraMap K _ (r : K)) = algebraMap K L (r : K)
  rw [algebraMap_line_coe, lineEmbedding_lineAlgebraMap, Polynomial.map_C, aeval_C]
  rfl

/-- The image of `lineEmbedding` lies in `K(S)`. -/
theorem lineEmbedding_mem_adjoin (z : (Spec (lineRing R)).functionField) :
    lineEmbedding R hS z ∈ K⟮S⟯ := by
  obtain ⟨a, b, -, rfl⟩ := IsFractionRing.div_surjective (lineRing R) z
  have hmem : ∀ P : R[X], lineEmbedding R hS (lineAlgebraMap R P) ∈ K⟮S⟯ := fun P ↦ by
    rw [lineEmbedding_lineAlgebraMap]
    exact IntermediateField.algebra_adjoin_le_adjoin K _ (aeval_mem_adjoin_singleton K _)
  rw [map_div₀]
  exact div_mem (hmem a) (hmem b)

/-- Every element of `K(S)` is in the image of `lineEmbedding`. -/
theorem exists_lineEmbedding_eq {c : L} (hc : c ∈ K⟮S⟯) :
    ∃ z, lineEmbedding R hS z = c := by
  let := functionFieldAlgebra (lineModel R)
  let jK : (Spec (lineRing R)).functionField →ₐ[K] L :=
    { lineEmbedding R hS with
      commutes' := fun c ↦ congrArg (fun f ↦ f c) (lineEmbedding_comp_algebraMap R hS) }
  have hle : K⟮S⟯ ≤ jK.fieldRange := by
    rw [IntermediateField.adjoin_simple_le_iff]
    exact ⟨lineGenerator R, lineEmbedding_lineGenerator R hS⟩
  obtain ⟨z, hz⟩ := hle hc
  exact ⟨z, hz⟩

end DeJongAlterations.StableModification.LocalUniformization.Curve
