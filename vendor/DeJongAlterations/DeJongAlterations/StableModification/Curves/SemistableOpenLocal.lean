import DeJongAlterations.StableModification.Curves.SemistableOpenNode

/-!
# The locus of at most nodal geometric points is open: the algebraic statement

A prime `y` of a `K`-algebra `A` is *at most a node* (`IsAtMostNode K y`) if the maximal ideal of
`A_y` is principal or the completion of `A_y` is the formal node `K[[u, v]]/(uv)`; on a curve over
an algebraically closed field these are exactly the smooth points and the ordinary double points.
An `R`-algebra `B` is *geometrically at most nodal* (`GeometricallyAtMostNodal R B`) if every closed
point of every geometric fibre `K ⊗_R B` is at most a node.

Main results, for `R → B` of finite type, `K` algebraically closed and `z ⊂ K ⊗_R B` maximal, with
`q ⊂ B` the prime under `z`:
* `exists_away_of_spanFinrank_le_one`: if the maximal ideal at `z` is principal, then
  `B_f` is geometrically at most nodal for some `f ∉ q` (in fact every geometric local ring of
  `B_f` has principal maximal ideal);
* `exists_away_of_node`: if `B` is flat and finitely presented and `z` is a node, then for some
  `f ∉ q`, every geometric node `z'` of `B_f` has a neighbourhood `D(s) ⊂ Spec B_f` which is
  geometrically at most nodal.

The proofs: `B` is unramified over the plane at `q` (`exists_isUnramifiedAt_plane`), so `B_f` is a
quotient of a standard étale `R[X₀, X₁]`-algebra (Mathlib's local structure of unramified
algebras); in the smooth case the second coordinate maps to `0`, so the geometric local rings of
`B_f` are quotients of those of the plane by one coordinate
(`geometricallyAtMostNodal_of_coord_eq_zero`); in the node case the kernel is principal near the
node with invertible Hessian (`exists_principal_kernel`), and the hypersurface classification
`geometricPoint_of_surjective` applies (`geometricallyAtMostNodal_away`).

This is the algebraic core of the openness of the semi-stable locus (M. Temkin, *Stable
modification of relative curves*, Lemma 5.1(i), T:3282–3292; blueprint `sm-semistable-curves.tex`).
-/

noncomputable section

open IsLocalRing TensorProduct MvPowerSeries

namespace DeJongAlterations.StableModification.Curves.SemistableOpen

open Algebra.NodeFormalMorse Algebra.NodeVariableMorse Algebra.NodeGeometricCompletionFormalUV

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

universe u

section Defs

/-- A prime `y` of a `K`-algebra `A` is a *formal node* if the completion of `A_y` is
`K[[u, v]]/(uv)`. -/
def IsFormalNode (K : Type u) [Field K] {A : Type u} [CommRing A] [Algebra K A] (y : Ideal A)
    [y.IsPrime] : Prop :=
  Nonempty (AdicCompletion (maximalIdeal (Localization.AtPrime y)) (Localization.AtPrime y) ≃ₐ[K]
    FormalUV K)

/-- A prime `y` of a `K`-algebra `A` is *at most a node* if the maximal ideal of `A_y` is principal
or the completion of `A_y` is the formal node `K[[u, v]]/(uv)`. -/
def IsAtMostNode (K : Type u) [Field K] {A : Type u} [CommRing A] [Algebra K A] (y : Ideal A)
    [y.IsPrime] : Prop :=
  (maximalIdeal (Localization.AtPrime y)).spanFinrank ≤ 1 ∨ IsFormalNode K y

/-- An `R`-algebra `B` is *geometrically at most nodal* if every closed point of every geometric
fibre `K ⊗_R B` (`K` algebraically closed) is at most a node. -/
def GeometricallyAtMostNodal (R B : Type u) [CommRing R] [CommRing B] [Algebra R B] : Prop :=
  ∀ (K : Type u) [Field K] [IsAlgClosed K] [Algebra R K] (y : Ideal (K ⊗[R] B)) [y.IsMaximal],
    IsAtMostNode K y

end Defs

section FormalUV

variable (K : Type u) [Field K]

/-- The maximal ideal of `K[[u, v]]/(uv)` is generated by two elements. -/
theorem spanFinrank_maximalIdeal_formalUV_le_two :
    (maximalIdeal (FormalUV K)).spanFinrank ≤ 2 := by
  have hsurj : Function.Surjective
      (Ideal.Quotient.mk (Ideal.span {((uvPolynomial K : MvPolynomial (Fin 2) K) : Series K)})) :=
    Ideal.Quotient.mk_surjective
  rw [← map_maximalIdeal_of_surjective _ hsurj,
    ← Algebra.NodeFieldQuadraticSource.variableIdeal_eq_maximalIdeal]
  refine (Ideal.spanFinrank_map_le_of_fg _ (Submodule.fg_span (Set.finite_range _))).trans ?_
  refine (Submodule.spanFinrank_span_le_ncard_of_finite (Set.finite_range _)).trans ?_
  calc (Set.range (X : Fin 2 → Series K)).ncard
      = ((X : Fin 2 → Series K) '' Set.univ).ncard := by rw [Set.image_univ]
    _ ≤ (Set.univ : Set (Fin 2)).ncard := Set.ncard_image_le Set.finite_univ
    _ = 2 := by rw [Set.ncard_univ, Nat.card_eq_fintype_card, Fintype.card_fin]

end FormalUV

section Smooth

variable {R : Type u} [CommRing R] {P : Type u} [CommRing P] [Algebra R P]
  [Algebra (MvPolynomial (Fin 2) R) P] [IsScalarTower R (MvPolynomial (Fin 2) R) P]
  [Algebra.Etale (MvPolynomial (Fin 2) R) P]
  {B : Type u} [CommRing B] [Algebra R B] (φ : P →ₐ[R] B) (hφ : Function.Surjective φ)

include hφ in
/-- **Smooth case.** If `B` is a quotient of an algebra étale over `R[X₀, X₁]` in which the second
coordinate vanishes, then the maximal ideal of every geometric local ring of `B` at a closed point
is principal. -/
theorem spanFinrank_le_one_of_coord_eq_zero (h1 : φ (coord R P 1) = 0) (K : Type u) [Field K]
    [IsAlgClosed K] [Algebra R K] (y : Ideal (K ⊗[R] B)) [y.IsMaximal] :
    (maximalIdeal (Localization.AtPrime y)).spanFinrank ≤ 1 := by
  let Φ : PlaneBaseChange R K P →ₐ[K] K ⊗[R] B := Algebra.TensorProduct.map (AlgHom.id K K) φ
  have hΦ : Function.Surjective Φ := LinearMap.lTensor_surjective K hφ
  set Q := y.comap Φ.toRingHom with hQdef
  have : Q.IsMaximal := Ideal.comap_isMaximal_of_surjective _ hΦ
  have : Algebra.FiniteType K (PlaneBaseChange R K P) :=
    Algebra.FiniteType.trans (S := MvPolynomial (Fin 2) K) inferInstance inferInstance
  have hres := algebraMap_quotient_surjective_of_isAlgClosed K (PlaneBaseChange R K P) Q
  choose c hc using fun j : Fin 2 =>
    hres (Ideal.Quotient.mk Q (coord K (PlaneBaseChange R K P) j))
  have hQ : IsRationalPoint Q c := by
    refine ⟨fun j => ?_, hres⟩
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, ← hc j, Ideal.Quotient.mk_algebraMap, sub_self]
  -- the hypersurface `u₁ = 0` through the point
  set g₁ := coord K (PlaneBaseChange R K P) 1 with hg₁def
  have hg₁ : Φ g₁ = 0 := by
    rw [hg₁def, ← toPlaneBaseChange_coord]
    change (1 : K) ⊗ₜ φ (coord R P 1) = 0
    rw [h1, tmul_zero]
  let π₁ := Ideal.Quotient.mkₐ K (Ideal.span {g₁})
  have hπ₁ : Function.Surjective π₁ := Ideal.Quotient.mkₐ_surjective K _
  have hπ₁ker : RingHom.ker π₁.toRingHom = Ideal.span {g₁} := Ideal.Quotient.mkₐ_ker K _
  let Φ₁ : (PlaneBaseChange R K P ⧸ Ideal.span {g₁}) →ₐ[K] K ⊗[R] B :=
    Ideal.Quotient.liftₐ _ Φ fun a ha => by
      obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      rw [map_mul, hg₁, mul_zero]
  have hΦ₁ : Function.Surjective Φ₁ := fun x => by
    obtain ⟨p, rfl⟩ := hΦ x
    exact ⟨Ideal.Quotient.mk _ p, rfl⟩
  set y₁ := y.comap Φ₁.toRingHom with hy₁def
  have : y₁.IsMaximal := Ideal.comap_isMaximal_of_surjective _ hΦ₁
  have hy₁ : y₁.comap π₁.toRingHom = Q := by
    ext x
    rfl
  have hd : planeDerivation K (PlaneBaseChange R K P) 1 g₁ ∉ Q := by
    rw [hg₁def, planeDerivation_coord, if_pos rfl]
    exact fun h => (Ideal.IsPrime.ne_top inferInstance) ((Ideal.eq_top_iff_one _).mpr h)
  have hle := hQ.spanFinrank_maximalIdeal_le_one π₁ y₁ hy₁ hπ₁ g₁ hπ₁ker 1 hd
  -- push forward along the surjective local map `𝒪_{y₁} → 𝒪_y`
  have : IsNoetherianRing (PlaneBaseChange R K P) := Algebra.FiniteType.isNoetherianRing K _
  have : IsNoetherianRing (PlaneBaseChange R K P ⧸ Ideal.span {g₁}) := inferInstance
  have hsurj := localQuotientMap_surjective Φ₁ y rfl hΦ₁
  rw [← map_maximalIdeal_of_surjective _ hsurj]
  exact (Ideal.spanFinrank_map_le_of_fg _ (IsNoetherian.noetherian _)).trans hle

end Smooth

section NodeLocalization

variable {R : Type u} [CommRing R] {P : Type u} [CommRing P] [Algebra R P]
  [Algebra (MvPolynomial (Fin 2) R) P] [IsScalarTower R (MvPolynomial (Fin 2) R) P]
  [Algebra.Etale (MvPolynomial (Fin 2) R) P]
  {B : Type u} [CommRing B] [Algebra R B] (φ : P →ₐ[R] B) (hφ : Function.Surjective φ)

include hφ in
/-- **Node case.** Let `φ : P → B` be a surjection from an algebra étale over `R[X₀, X₁]`, and
`g ∈ ker φ`, `h ∈ P` with `h · ker φ ⊆ (g)`. Then `B_{φ(h · hessian g)}` is the hypersurface
`g = 0` in the surface `P_{h · hessian g}` with invertible Hessian, so it is geometrically at most
nodal. -/
theorem geometricallyAtMostNodal_away (g : P) (hgJ : g ∈ RingHom.ker φ.toRingHom) (h : P)
    (hJ : ∀ j ∈ RingHom.ker φ.toRingHom, h * j ∈ Ideal.span {g}) :
    GeometricallyAtMostNodal R (Localization.Away (φ (h * hessian R P g))) := by
  set a := h * hessian R P g with ha
  let φ' : Localization.Away a →ₐ[R] Localization.Away (φ a) := Localization.awayMapₐ φ a
  have hφ' : Function.Surjective φ' := IsLocalization.Away.mapₐ_surjective_of_surjective a hφ
  have haunit : IsUnit (algebraMap P (Localization.Away a) a) :=
    IsLocalization.Away.algebraMap_isUnit a
  have hhunit : IsUnit (algebraMap P (Localization.Away a) h) := by
    rw [ha, map_mul] at haunit
    exact isUnit_of_mul_isUnit_left haunit
  -- the kernel of the localized map is `(g)`
  have hker : RingHom.ker φ'.toRingHom =
      Ideal.span {algebraMap P (Localization.Away a) g} := by
    have h₀ : RingHom.ker φ'.toRingHom =
        (RingHom.ker φ.toRingHom).map (algebraMap P (Localization.Away a)) :=
      IsLocalization.ker_map (Localization.Away (φ a)) φ.toRingHom
        (Submonoid.map_powers φ.toRingHom a)
    rw [h₀]
    apply le_antisymm
    · rw [Ideal.map_le_iff_le_comap]
      intro j hj
      obtain ⟨r, hr⟩ := Ideal.mem_span_singleton'.mp (hJ j hj)
      obtain ⟨v, hv⟩ := hhunit
      rw [Ideal.mem_comap]
      have : algebraMap P (Localization.Away a) j =
          (↑v⁻¹ * algebraMap P (Localization.Away a) r) * algebraMap P (Localization.Away a) g := by
        rw [mul_assoc, ← map_mul, hr, map_mul, ← hv, ← mul_assoc, Units.inv_mul, one_mul]
      rw [this]
      exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      exact Ideal.mem_map_of_mem _ hgJ
  -- the Hessian of `g` is a unit on `P_a`
  have hcoord : ∀ j, IsScalarTower.toAlgHom R P (Localization.Away a) (coord R P j) =
      coord R (Localization.Away a) j := fun j =>
    (IsScalarTower.algebraMap_apply (MvPolynomial (Fin 2) R) P (Localization.Away a) _).symm
  have hhess : IsUnit (hessian R (Localization.Away a) (algebraMap P (Localization.Away a) g)) := by
    have := hessian_map (R' := R) (IsScalarTower.toAlgHom R P (Localization.Away a)) hcoord g
    rw [IsScalarTower.coe_toAlgHom', ] at this
    rw [this]
    rw [ha, map_mul] at haunit
    exact isUnit_of_mul_isUnit_right haunit
  intro K _ _ _ y _
  exact geometricPoint_of_surjective R K (Localization.Away a) (algebraMap P _ g) hhess
    (Algebra.TensorProduct.map (AlgHom.id K K) φ') (LinearMap.lTensor_surjective K hφ')
    (by
      have h := Algebra.TensorProduct.lTensor_ker (A := K) φ' hφ'
      rw [show RingHom.ker φ' = RingHom.ker φ'.toRingHom from rfl, hker, Ideal.map_span,
        Set.image_singleton] at h
      exact h) y

end NodeLocalization

section Assembly

variable {R : Type u} [CommRing R] {B : Type u} [CommRing B] [Algebra R B]
  {K : Type u} [Field K] [IsAlgClosed K] [Algebra R K] (z : Ideal (K ⊗[R] B)) [z.IsMaximal]

/-- **Smooth points spread out.** If the maximal ideal of the geometric local ring of `B` at `z`
is principal, then for some `f` outside the prime under `z`, the maximal ideal of every geometric
local ring of `B_f` at a closed point is principal. -/
theorem exists_away_of_spanFinrank_le_one [Algebra.FiniteType R B]
    (hz : (maximalIdeal (Localization.AtPrime z)).spanFinrank ≤ 1) :
    ∃ f : B, f ∉ z.comap (Algebra.TensorProduct.includeRight : B →ₐ[R] K ⊗[R] B).toRingHom ∧
      ∀ (K' : Type u) [Field K'] [IsAlgClosed K'] [Algebra R K']
        (y : Ideal (K' ⊗[R] Localization.Away f)) [y.IsMaximal],
        (maximalIdeal (Localization.AtPrime y)).spanFinrank ≤ 1 := by
  obtain ⟨b, hb0, hunr⟩ := exists_isUnramifiedAt_plane z 1 (by norm_num) hz
  let : Algebra (MvPolynomial (Fin 2) R) B := (MvPolynomial.aeval (R := R) b).toRingHom.toAlgebra
  have : IsScalarTower R (MvPolynomial (Fin 2) R) B := IsScalarTower.of_algebraMap_eq fun r => by
    change algebraMap R B r = MvPolynomial.aeval b (MvPolynomial.C r)
    rw [MvPolynomial.aeval_C]
  have : Algebra.FiniteType (MvPolynomial (Fin 2) R) B :=
    Algebra.FiniteType.of_restrictScalars_finiteType R (MvPolynomial (Fin 2) R) B
  have := hunr
  obtain ⟨f, hfq, Pe, ψ, hψ⟩ :=
    Algebra.IsUnramifiedAt.exists_hasStandardEtaleSurjectionOn (R := MvPolynomial (Fin 2) R)
      (z.comap (Algebra.TensorProduct.includeRight : B →ₐ[R] K ⊗[R] B).toRingHom)
  refine ⟨f, hfq, ?_⟩
  let : Algebra R Pe.Ring := ((algebraMap (MvPolynomial (Fin 2) R) Pe.Ring).comp
    (algebraMap R (MvPolynomial (Fin 2) R))).toAlgebra
  have : IsScalarTower R (MvPolynomial (Fin 2) R) Pe.Ring :=
    IsScalarTower.of_algebraMap_eq fun _ => rfl
  let ψR : Pe.Ring →ₐ[R] Localization.Away f := ψ.restrictScalars R
  have h1 : ψR (coord R Pe.Ring 1) = 0 := by
    change ψ (algebraMap (MvPolynomial (Fin 2) R) Pe.Ring (MvPolynomial.X 1)) = 0
    rw [AlgHom.commutes, IsScalarTower.algebraMap_apply (MvPolynomial (Fin 2) R) B
      (Localization.Away f)]
    change algebraMap B _ (MvPolynomial.aeval b (MvPolynomial.X 1)) = 0
    rw [MvPolynomial.aeval_X, hb0 1 (by simp), map_zero]
  exact spanFinrank_le_one_of_coord_eq_zero ψR hψ h1

/-- **Nodes spread out.** Let `B` be flat and of finite presentation over `R`, and `z` a geometric
node (`Ô_z ≅ K[[u, v]]/(uv)`). Then for some `f` outside the prime under `z`, every geometric node
`z'` of `B_f` has a neighbourhood `D(s) ⊂ Spec B_f` which is geometrically at most nodal. -/
theorem exists_away_of_node [Module.Flat R B] [Algebra.FinitePresentation R B]
    (hz : IsFormalNode K z) :
    ∃ f : B, f ∉ z.comap (Algebra.TensorProduct.includeRight : B →ₐ[R] K ⊗[R] B).toRingHom ∧
      ∀ (K' : Type u) [Field K'] [IsAlgClosed K'] [Algebra R K']
        (z' : Ideal (K' ⊗[R] Localization.Away f)) [z'.IsMaximal], IsFormalNode K' z' →
        ∃ s : Localization.Away f, s ∉ z'.comap (Algebra.TensorProduct.includeRight :
            Localization.Away f →ₐ[R] K' ⊗[R] Localization.Away f).toRingHom ∧
          GeometricallyAtMostNodal R (Localization.Away s) := by
  obtain ⟨e⟩ := hz
  have : IsNoetherianRing (K ⊗[R] B) := Algebra.FiniteType.isNoetherianRing K _
  have h2 : (maximalIdeal (Localization.AtPrime z)).spanFinrank ≤ 2 := by
    rw [← AdicCompletion.spanFinrank_maximalIdeal_eq,
      ← Ideal.spanFinrank_map_eq_of_ringEquiv e.toRingEquiv,
      map_ringEquiv_maximalIdeal e.toRingEquiv]
    exact spanFinrank_maximalIdeal_formalUV_le_two K
  obtain ⟨b, -, hunr⟩ := exists_isUnramifiedAt_plane z 2 le_rfl h2
  let : Algebra (MvPolynomial (Fin 2) R) B := (MvPolynomial.aeval (R := R) b).toRingHom.toAlgebra
  have : IsScalarTower R (MvPolynomial (Fin 2) R) B := IsScalarTower.of_algebraMap_eq fun r => by
    change algebraMap R B r = MvPolynomial.aeval b (MvPolynomial.C r)
    rw [MvPolynomial.aeval_C]
  have : Algebra.FiniteType (MvPolynomial (Fin 2) R) B :=
    Algebra.FiniteType.of_restrictScalars_finiteType R (MvPolynomial (Fin 2) R) B
  have := hunr
  obtain ⟨f, hfq, Pe, ψ, hψ⟩ :=
    Algebra.IsUnramifiedAt.exists_hasStandardEtaleSurjectionOn (R := MvPolynomial (Fin 2) R)
      (z.comap (Algebra.TensorProduct.includeRight : B →ₐ[R] K ⊗[R] B).toRingHom)
  refine ⟨f, hfq, fun K' _ _ _ z' _ ⟨e'⟩ => ?_⟩
  let : Algebra R Pe.Ring := ((algebraMap (MvPolynomial (Fin 2) R) Pe.Ring).comp
    (algebraMap R (MvPolynomial (Fin 2) R))).toAlgebra
  have : IsScalarTower R (MvPolynomial (Fin 2) R) Pe.Ring :=
    IsScalarTower.of_algebraMap_eq fun _ => rfl
  let ψR : Pe.Ring →ₐ[R] Localization.Away f := ψ.restrictScalars R
  have : Module.Flat R (Localization.Away f) := Module.Flat.trans R B (Localization.Away f)
  have : Algebra.FinitePresentation R (Localization.Away f) :=
    Algebra.FinitePresentation.trans R B (Localization.Away f)
  obtain ⟨g, hgJ, h, hhQ, hhessQ, hJ⟩ := exists_principal_kernel ψR hψ z' e'
  refine ⟨ψR (h * hessian R Pe.Ring g), fun hmem => ?_,
    geometricallyAtMostNodal_away ψR hψ g hgJ h hJ⟩
  have hmem' : h * hessian R Pe.Ring g ∈ z'.comap ((Algebra.TensorProduct.includeRight :
      Localization.Away f →ₐ[R] K' ⊗[R] Localization.Away f).comp ψR).toRingHom := hmem
  rcases Ideal.IsPrime.mem_or_mem inferInstance hmem' with h' | h'
  · exact hhQ h'
  · exact hhessQ h'

end Assembly

end DeJongAlterations.StableModification.Curves.SemistableOpen
