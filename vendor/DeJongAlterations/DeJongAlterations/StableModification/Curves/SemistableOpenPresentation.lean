import DeJongAlterations.StableModification.Curves.SemistableOpenHypersurface
import Mathlib.RingTheory.Unramified.LocalStructure
import Mathlib.RingTheory.Unramified.Locus
import Mathlib.RingTheory.Kaehler.TensorProduct
import Mathlib.RingTheory.LocalRing.Module
import Mathlib.RingTheory.Flat.FaithfullyFlat.Basic

/-!
# Presentations of a family of curves near a geometric smooth point or node

Let `R → B` be of finite type, `K` an algebraically closed field with `R → K`, and `z` a maximal
ideal of `K ⊗_R B` (a closed point of a geometric fibre of `Spec B → Spec R`) whose local ring has
maximal ideal generated by `n ≤ 2` elements (`n = 1` at a smooth point, `n = 2` at an ordinary
double point). Then there are `b₀, b₁ ∈ B` (with `bᵢ = 0` for `i ≥ n`) such that `B` is unramified
over `R[X₀, X₁]` (`Xᵢ ↦ bᵢ`) at the prime `q` under `z` (`exists_isUnramifiedAt_plane`); by
Mathlib's local structure of unramified algebras, `B_f` is then a quotient of a standard étale
`R[X₀, X₁]`-algebra for some `f ∉ q` (`exists_etale_presentation`).

The proof chooses `bᵢ` whose classes span the cotangent space of the geometric local ring, shows
that `K ⊗_R B` is unramified over `K[X₀, X₁]` at `z` (`isUnramifiedAt_of_maximalIdeal_eq_span`),
and descends unramifiedness along `B → K ⊗_R B` through the base change of Kähler differentials
`Ω_{K ⊗ B / K[X]} = (K ⊗ B) ⊗_B Ω_{B/R[X]}` and the fibre criterion for the support of a finite
module (`notMem_support_of_subsingleton_tensor`).

This is the first step of the openness of the semi-stable locus (M. Temkin, *Stable modification
of relative curves*, Lemma 5.1(i), T:3282–3292; blueprint `sm-semistable-curves.tex`).
-/

noncomputable section

open IsLocalRing TensorProduct

namespace DeJongAlterations.StableModification.Curves.SemistableOpen

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

universe u

section Support

/-- **Fibre criterion for the support.** If `M` is a finite `B`-module and `B → F` is a map to a
field with kernel `q` such that `F ⊗_B M = 0`, then `q` is not in the support of `M`. -/
theorem notMem_support_of_subsingleton_tensor {B M F : Type u} [CommRing B] [AddCommGroup M]
    [Module B M] [Module.Finite B M] [Field F] [Algebra B F] (q : PrimeSpectrum B)
    (hq : RingHom.ker (algebraMap B F) = q.asIdeal) [Subsingleton (F ⊗[B] M)] :
    q ∉ Module.support B M := by
  intro hmem
  rw [Module.mem_support_iff_nontrivial_residueField_tensorProduct] at hmem
  let κ := q.asIdeal.ResidueField
  let g : B ⧸ q.asIdeal →+* F := Ideal.Quotient.lift q.asIdeal (algebraMap B F) (fun a ha => by
    rw [← RingHom.mem_ker, hq]; exact ha)
  have hg : Function.Injective g := by
    rw [injective_iff_map_eq_zero]
    intro a ha
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective a
    rw [Ideal.Quotient.eq_zero_iff_mem, ← hq, RingHom.mem_ker]
    exact ha
  let : Algebra κ F := (IsFractionRing.lift hg : κ →+* F).toAlgebra
  have : IsScalarTower B κ F := .of_algebraMap_eq fun b => by
    change algebraMap B F b = IsFractionRing.lift hg (algebraMap B κ b)
    rw [IsScalarTower.algebraMap_apply B (B ⧸ q.asIdeal) κ, IsFractionRing.lift_algebraMap]
    rfl
  let e := (AlgebraTensorModule.cancelBaseChange B κ F F M).symm
  have : Nontrivial (F ⊗[κ] (κ ⊗[B] M)) := inferInstance
  have : Nontrivial (F ⊗[B] M) := e.toEquiv.nontrivial
  exact not_subsingleton _ ‹_›

end Support

section FieldUnramified

variable {K : Type u} [Field K] {A : Type u} [CommRing A] [Algebra K A]
  [Algebra (MvPolynomial (Fin 2) K) A] [IsScalarTower K (MvPolynomial (Fin 2) K) A]
  [Algebra.EssFiniteType (MvPolynomial (Fin 2) K) A]
  (z : Ideal A) [z.IsMaximal] {c : Fin 2 → K}

/-- **Unramified over the plane at a rational point.** If `z` is a rational point of a
`K[X₀, X₁]`-algebra `A` at which `uᵢ - cᵢ` generate the maximal ideal of the local ring, then `A` is
unramified over `K[X₀, X₁]` at `z`. -/
theorem isUnramifiedAt_of_maximalIdeal_eq_span (hz : IsRationalPoint z c)
    (hspan : maximalIdeal (Localization.AtPrime z) = Ideal.span (Set.range fun i : Fin 2 =>
      algebraMap A (Localization.AtPrime z) (coord K A i - algebraMap K A (c i)))) :
    Algebra.IsUnramifiedAt (MvPolynomial (Fin 2) K) z := by
  have := hz.liesOver
  let := Localization.AtPrime.algebraOfLiesOver (pointIdeal K c) z
  rw [Algebra.isUnramifiedAt_iff_map_eq (MvPolynomial (Fin 2) K) (pointIdeal K c) z]
  constructor
  · -- the residue field extension is trivial
    refine ⟨fun x => ?_⟩
    obtain ⟨w, rfl⟩ := Ideal.bijective_algebraMap_quotient_residueField z |>.2 x
    obtain ⟨k, rfl⟩ := hz.residue_surjective w
    have : algebraMap (A ⧸ z) z.ResidueField (algebraMap K (A ⧸ z) k) =
        algebraMap (pointIdeal K c).ResidueField z.ResidueField
          (algebraMap K (pointIdeal K c).ResidueField k) := by
      simp only [← IsScalarTower.algebraMap_apply]
    rw [this]
    exact isSeparable_algebraMap _
  · rw [pointIdeal_eq_span, Ideal.map_span, hspan, ← Set.range_comp]
    congr 2
    funext i
    simp only [Function.comp_apply, map_sub, coord, ← MvPolynomial.algebraMap_eq,
      ← IsScalarTower.algebraMap_apply]

end FieldUnramified

section Value

variable {K : Type u} [Field K] [IsAlgClosed K] {A : Type u} [CommRing A] [Algebra K A]
  [Algebra.FiniteType K A] (z : Ideal A) [z.IsMaximal]

/-- The residue field at a closed point of a finitely generated algebra over an algebraically
closed field `K` is `K`. -/
def pointValueEquiv : K ≃ₐ[K] A ⧸ z :=
  AlgEquiv.ofBijective (Algebra.ofId K (A ⧸ z))
    ⟨(algebraMap K (A ⧸ z)).injective, algebraMap_quotient_surjective_of_isAlgClosed K A z⟩

/-- The value at a closed point: `A → A/z ≅ K`. -/
def pointValue : A →ₐ[K] K :=
  (pointValueEquiv z).symm.toAlgHom.comp (Ideal.Quotient.mkₐ K z)

theorem algebraMap_pointValue (a : A) :
    algebraMap K (A ⧸ z) (pointValue z a) = Ideal.Quotient.mk z a :=
  (pointValueEquiv z).apply_symm_apply (Ideal.Quotient.mk z a)

theorem sub_pointValue_mem (a : A) : a - algebraMap K A (pointValue z a) ∈ z := by
  rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, Ideal.Quotient.mk_algebraMap,
    algebraMap_pointValue, sub_self]

theorem pointValue_eq_zero_iff (a : A) : pointValue (K := K) z a = 0 ↔ a ∈ z := by
  rw [← Ideal.Quotient.eq_zero_iff_mem, ← algebraMap_pointValue (K := K),
    map_eq_zero_iff (algebraMap K (A ⧸ z)) (algebraMap K (A ⧸ z)).injective]

end Value

section Choose

/-- For an ideal `I`, a set of elements of `I` spans `I` as a module iff it generates `I`. -/
theorem span_subtype_eq_top_iff {L : Type u} [CommRing L] (I : Ideal L) (s : Set I) :
    Submodule.span L s = ⊤ ↔ Ideal.span (Subtype.val '' s) = I := by
  rw [← (Submodule.map_injective_of_injective (f := I.subtype) I.injective_subtype).eq_iff,
    Submodule.map_span, Submodule.map_top, Submodule.range_subtype]
  rfl

variable {R : Type u} [CommRing R] {B : Type u} [CommRing B] [Algebra R B]
  [Algebra.FiniteType R B] {K : Type u} [Field K] [IsAlgClosed K] [Algebra R K]
  (z : Ideal (K ⊗[R] B)) [z.IsMaximal]

/-- Every element of `K ⊗_R B` differs from its value at `z` by an element of the ideal generated
by the `1 ⊗ b - b(z)`. -/
theorem sub_pointValue_mem_span (x : K ⊗[R] B) :
    x - algebraMap K _ (pointValue z x) ∈ Ideal.span (Set.range fun b : B =>
      (1 : K) ⊗ₜ b - algebraMap K (K ⊗[R] B) (pointValue z ((1 : K) ⊗ₜ b))) := by
  induction x using TensorProduct.induction_on with
  | zero => simp
  | tmul k b =>
    have hk : (k ⊗ₜ b : K ⊗[R] B) = algebraMap K (K ⊗[R] B) k * ((1 : K) ⊗ₜ b) := by
      rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply,
        Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    rw [hk, map_mul, AlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply, map_mul,
      ← mul_sub]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨b, rfl⟩)
  | add x y hx hy =>
    have : x + y - algebraMap K _ (pointValue z (x + y)) =
        (x - algebraMap K _ (pointValue z x)) + (y - algebraMap K _ (pointValue z y)) := by
      rw [map_add, map_add]; ring
    rw [this]
    exact add_mem hx hy

/-- **Choice of plane coordinates.** If the maximal ideal of the local ring of `K ⊗_R B` at `z` is
generated by `n ≤ 2` elements, there are `b₀, b₁ ∈ B` (with `bᵢ = 0` for `i ≥ n`) such that the
`1 ⊗ bᵢ - bᵢ(z)` generate it. -/
theorem exists_coordinates_span (n : ℕ) (hn2 : n ≤ 2)
    (hn : (maximalIdeal (Localization.AtPrime z)).spanFinrank ≤ n) :
    ∃ b : Fin 2 → B, (∀ i : Fin 2, n ≤ i.val → b i = 0) ∧
      maximalIdeal (Localization.AtPrime z) = Ideal.span (Set.range fun i : Fin 2 =>
        algebraMap (K ⊗[R] B) (Localization.AtPrime z)
          ((1 : K) ⊗ₜ b i - algebraMap K (K ⊗[R] B) (pointValue z ((1 : K) ⊗ₜ b i)))) := by
  have : IsNoetherianRing (K ⊗[R] B) := Algebra.FiniteType.isNoetherianRing K _
  set L := Localization.AtPrime z
  let t : B → L := fun b => algebraMap _ L
    ((1 : K) ⊗ₜ b - algebraMap K (K ⊗[R] B) (pointValue z ((1 : K) ⊗ₜ b)))
  have ht : ∀ b, t b ∈ maximalIdeal L := fun b => by
    rw [← Localization.AtPrime.map_eq_maximalIdeal]
    exact Ideal.mem_map_of_mem _ (sub_pointValue_mem z _)
  have hspanT : Ideal.span (Set.range t) = maximalIdeal L := by
    apply le_antisymm
    · rw [Ideal.span_le]; rintro _ ⟨b, rfl⟩; exact ht b
    · rw [← Localization.AtPrime.map_eq_maximalIdeal, Ideal.map_le_iff_le_comap]
      intro x hx
      have h1 := sub_pointValue_mem_span z x
      rw [(pointValue_eq_zero_iff z x).mpr hx, map_zero, sub_zero] at h1
      have h2 := Ideal.mem_map_of_mem (algebraMap (K ⊗[R] B) L) h1
      rw [Ideal.map_span, ← Set.range_comp] at h2
      exact h2
  let w : B → maximalIdeal L := fun b => ⟨t b, ht b⟩
  let v : B → CotangentSpace L := fun b => (maximalIdeal L).toCotangent (w b)
  have hv : Submodule.span (ResidueField L) (Set.range v) = ⊤ := by
    have h := (CotangentSpace.span_image_eq_top_iff (R := L) (s := Set.range w)).mpr (by
      rw [span_subtype_eq_top_iff, ← Set.range_comp]
      exact hspanT)
    rwa [← Set.range_comp] at h
  obtain ⟨ι, a, -, hsp, hli⟩ := exists_linearIndependent' (ResidueField L) v
  have : Finite ι := hli.finite_of_isNoetherian
  have := Fintype.ofFinite ι
  have hcard : Fintype.card ι ≤ n := by
    refine hli.fintype_card_le_finrank.trans ?_
    rw [← spanFinrank_maximalIdeal_eq_finrank_cotangentSpace]
    exact hn
  let e := Fintype.equivFin ι
  let b : Fin 2 → B := fun i =>
    if h : i.val < Fintype.card ι then a (e.symm ⟨i.val, h⟩) else 0
  refine ⟨b, fun i hi => dif_neg (by omega), ?_⟩
  have hvb : Submodule.span (ResidueField L) (Set.range fun i => v (b i)) = ⊤ := by
    rw [eq_top_iff, ← hv, ← hsp]
    apply Submodule.span_mono
    rintro _ ⟨j, rfl⟩
    have hj : (e j).val < 2 := lt_of_lt_of_le (e j).isLt (hcard.trans hn2)
    refine ⟨⟨(e j).val, hj⟩, ?_⟩
    change v (b ⟨(e j).val, hj⟩) = v (a j)
    simp only [b, dif_pos (e j).isLt, Fin.eta, Equiv.symm_apply_apply]
  have h := (CotangentSpace.span_image_eq_top_iff (R := L)
    (s := Set.range fun i => w (b i))).mp (by rwa [← Set.range_comp])
  rw [span_subtype_eq_top_iff, ← Set.range_comp] at h
  exact h.symm

end Choose

section Unramified

attribute [local instance] MvPolynomial.algebraMvPolynomial

variable {R : Type u} [CommRing R] {B : Type u} [CommRing B] [Algebra R B]
  [Algebra.FiniteType R B] {K : Type u} [Field K] [IsAlgClosed K] [Algebra R K]
  (z : Ideal (K ⊗[R] B)) [z.IsMaximal]

/-- **Unramified plane coordinates at a geometric point.** If the maximal ideal of the local ring
of `K ⊗_R B` at `z` is generated by `n ≤ 2` elements, there are `b₀, b₁ ∈ B` (with `bᵢ = 0` for
`i ≥ n`) such that `B` is unramified over `R[X₀, X₁]` (`Xᵢ ↦ bᵢ`) at the prime under `z`. -/
theorem exists_isUnramifiedAt_plane (n : ℕ) (hn2 : n ≤ 2)
    (hn : (maximalIdeal (Localization.AtPrime z)).spanFinrank ≤ n) :
    ∃ b : Fin 2 → B, (∀ i : Fin 2, n ≤ i.val → b i = 0) ∧
      letI := (MvPolynomial.aeval (R := R) b).toRingHom.toAlgebra
      Algebra.IsUnramifiedAt (MvPolynomial (Fin 2) R)
        (z.comap (Algebra.TensorProduct.includeRight : B →ₐ[R] K ⊗[R] B).toRingHom) := by
  obtain ⟨b, hb0, hspan⟩ := exists_coordinates_span z n hn2 hn
  refine ⟨b, hb0, ?_⟩
  let : Algebra (MvPolynomial (Fin 2) R) B := (MvPolynomial.aeval (R := R) b).toRingHom.toAlgebra
  have : IsScalarTower R (MvPolynomial (Fin 2) R) B := IsScalarTower.of_algebraMap_eq fun r => by
    change algebraMap R B r = MvPolynomial.aeval b (MvPolynomial.C r)
    rw [MvPolynomial.aeval_C]
  let A := PlaneBaseChange R K B
  let zA : Ideal A := z
  have : zA.IsMaximal := ‹z.IsMaximal›
  have hcoord : ∀ i, coord K A i = ((1 : K) ⊗ₜ b i : K ⊗[R] B) := fun i => by
    rw [← toPlaneBaseChange_coord]
    change (1 : K) ⊗ₜ (MvPolynomial.aeval b (MvPolynomial.X i)) = _
    rw [MvPolynomial.aeval_X]
  have : Algebra.FiniteType K A := inferInstanceAs (Algebra.FiniteType K (K ⊗[R] B))
  have : Algebra.FiniteType (MvPolynomial (Fin 2) K) A :=
    Algebra.FiniteType.of_restrictScalars_finiteType K (MvPolynomial (Fin 2) K) A
  have : Algebra.FiniteType (MvPolynomial (Fin 2) R) B :=
    Algebra.FiniteType.of_restrictScalars_finiteType R (MvPolynomial (Fin 2) R) B
  have hz : IsRationalPoint zA (fun i => pointValue (K := K) z ((1 : K) ⊗ₜ b i)) := by
    refine ⟨fun i => ?_, ?_⟩
    · rw [hcoord]
      exact sub_pointValue_mem z _
    · exact algebraMap_quotient_surjective_of_isAlgClosed K A zA
  have hunr : Algebra.IsUnramifiedAt (MvPolynomial (Fin 2) K) zA := by
    apply isUnramifiedAt_of_maximalIdeal_eq_span zA hz
    simp only [hcoord]
    exact hspan
  -- `zA` is not in the support of `Ω_{A/K[X]}`
  have h1 : (⟨zA, inferInstance⟩ : PrimeSpectrum A) ∉
      Module.support A Ω[A⁄MvPolynomial (Fin 2) K] := by
    have := (Set.ext_iff.mp (Algebra.unramifiedLocus_eq_compl_support
      (R := MvPolynomial (Fin 2) K) (A := A)) ⟨zA, inferInstance⟩).mp hunr
    exact this
  rw [Module.mem_support_iff_nontrivial_residueField_tensorProduct,
    not_nontrivial_iff_subsingleton] at h1
  -- base change of Kähler differentials
  have : Algebra.IsPushout (MvPolynomial (Fin 2) R) (MvPolynomial (Fin 2) K) B A :=
    (planeBaseChange_isPushout R K B).symm
  let F := zA.ResidueField
  let e₁ := KaehlerDifferential.tensorKaehlerEquiv (MvPolynomial (Fin 2) R)
    (MvPolynomial (Fin 2) K) B A
  let e₂ := AlgebraTensorModule.cancelBaseChange B A F F Ω[B⁄MvPolynomial (Fin 2) R]
  let e₃ := LinearEquiv.lTensor F e₁
  have : Subsingleton (F ⊗[B] Ω[B⁄MvPolynomial (Fin 2) R]) :=
    (e₂.symm.toEquiv.trans e₃.toEquiv).subsingleton
  have hker : RingHom.ker (algebraMap B F) =
      z.comap (Algebra.TensorProduct.includeRight : B →ₐ[R] K ⊗[R] B).toRingHom := by
    rw [IsScalarTower.algebraMap_eq B A F, ← RingHom.comap_ker, Ideal.ker_algebraMap_residueField]
    rfl
  have h3 := notMem_support_of_subsingleton_tensor (B := B)
    (M := Ω[B⁄MvPolynomial (Fin 2) R]) (F := F)
    ⟨z.comap (Algebra.TensorProduct.includeRight : B →ₐ[R] K ⊗[R] B).toRingHom, inferInstance⟩
    hker
  have := (Set.ext_iff.mp (Algebra.unramifiedLocus_eq_compl_support
    (R := MvPolynomial (Fin 2) R) (A := B)) _).mpr h3
  exact this

end Unramified

end DeJongAlterations.StableModification.Curves.SemistableOpen
