import DeJongAlterations.StableModification.Curves.SemistableOpenPresentation
import DeJongAlterations.Algebra.NodeGeometricCompletionJets
import Mathlib.RingTheory.Flat.Equalizer
import Mathlib.RingTheory.Support

/-!
# A family of curves near a node is a hypersurface with invertible Hessian

Let `R → B` be flat and of finite presentation, `φ : P → B` a surjection from an algebra `P` étale
over `R[X₀, X₁]`, `K` an algebraically closed field over `R`, and `z` a maximal ideal of `K ⊗_R B`
at which the completed local ring is the formal node `K[[u, v]]/(uv)`. Then there are `g ∈ ker φ`
and `h ∈ P` outside the prime `Q₀` of `P` under `z` such that `h · ker φ ⊆ (g)` and the Hessian of
`g` is not in `Q₀` (`exists_principal_kernel`). Hence, after inverting `h · hessian g`, the family
is the hypersurface `g = 0` in a surface étale over the plane, with invertible Hessian.

The proof:
* the completed local ring of `K ⊗_R B` at `z` is `K[[X₀, X₁]]/(taylor (ker φ_K))`; its kernel is
  principal, generated by a series `F` of order two with nondegenerate quadratic part
  (`exists_ker_eq_span_of_formalUV`), so some `g ∈ ker φ` has Taylor expansion a unit multiple of
  `F` (`exists_mem_map_eq_unit_mul`);
* the hypersurface `T = P/(g)` then has a node at the point under `z`, and the surjection of
  local rings `𝒪_{K ⊗ T} → 𝒪_{K ⊗ B}` is injective, both completions being formal nodes with the
  same jet dimensions `2n - 1` (`localRingHom_injective_of_formalUV`, Krull intersection);
* by flatness of `B`, `K ⊗_R ker(T → B) ⊂ K ⊗_R T`, so the fibre of `ker(T → B)` at the point
  vanishes (`subsingleton_tensor_of_lTensor_injective`), and the fibre criterion for the support
  gives `h`.

This is the node case of the openness of the semi-stable locus (M. Temkin, *Stable modification
of relative curves*, Lemma 5.1(i), T:3282–3292, which cites the local description of nodes in
A. J. de Jong, *Smoothness, semi-stability and alterations*, 2.23; blueprint
`sm-semistable-curves.tex`).
-/

noncomputable section

open IsLocalRing TensorProduct MvPowerSeries

namespace DeJongAlterations.StableModification.Curves.SemistableOpen

open Algebra.NodeFormalMorse Algebra.NodeVariableMorse Algebra.NodeGeometricCompletionFormalUV

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

universe u

section Annihilator

/-- If every element of a finitely generated ideal `I` is killed by an element outside a prime
`p`, then a single element outside `p` kills all of `I`. -/
theorem exists_notMem_forall_mul_eq_zero {A : Type u} [CommRing A] (I : Ideal A) (hI : I.FG)
    (p : Ideal A) [p.IsPrime] (h : ∀ x ∈ I, ∃ s ∉ p, s * x = 0) :
    ∃ s ∉ p, ∀ x ∈ I, s * x = 0 := by
  have : Module.Finite A I := Module.Finite.iff_fg.mpr hI
  have hp : (⟨p, inferInstance⟩ : PrimeSpectrum A) ∉ Module.support A I := by
    rw [Module.notMem_support_iff']
    intro m
    obtain ⟨s, hs, hsm⟩ := h m.1 m.2
    exact ⟨s, hs, Subtype.ext hsm⟩
  rw [Module.mem_support_iff_of_finite, SetLike.not_le_iff_exists] at hp
  obtain ⟨s, hs, hsp⟩ := hp
  refine ⟨s, hsp, fun x hx => ?_⟩
  exact congrArg Subtype.val (Module.mem_annihilator.mp hs ⟨x, hx⟩)

end Annihilator

section FibreVanishing

variable {R : Type u} [CommRing R] {T : Type u} [CommRing T] [Algebra R T] (M : Ideal T)
  (K : Type u) [CommRing K] [Algebra R K]

/-- **Fibre vanishing.** Let `M ⊂ T` be an ideal such that `K ⊗_R M → K ⊗_R T` is injective (e.g.
`T/M` flat over `R`) and `ρ : K ⊗_R T → F` a map to a field. If some `s` with `ρ s ≠ 0` kills
`1 ⊗ M`, then `F ⊗_T M = 0`, where `T → F` is `t ↦ ρ (1 ⊗ t)`. -/
theorem subsingleton_tensor_of_lTensor_injective
    (hinj : Function.Injective ((M.subtype.restrictScalars R).lTensor K))
    {F : Type u} [Field F] (ρ : K ⊗[R] T →+* F) (s : K ⊗[R] T) (hs : ρ s ≠ 0)
    (hsM : ∀ m ∈ M, s * ((1 : K) ⊗ₜ m) = 0) :
    letI : Algebra T F :=
      (ρ.comp (Algebra.TensorProduct.includeRight : T →ₐ[R] K ⊗[R] T).toRingHom).toAlgebra
    Subsingleton (F ⊗[T] M) := by
  let : Algebra T F :=
    (ρ.comp (Algebra.TensorProduct.includeRight : T →ₐ[R] K ⊗[R] T).toRingHom).toAlgebra
  have hsmul : ∀ (t : T) (f : F), t • f = ρ ((1 : K) ⊗ₜ t) * f := fun t f => by
    rw [Algebra.smul_def]
    rfl
  -- the additive map `K ⊗_R M → F ⊗_T M`, `k ⊗ m ↦ ρ (k ⊗ 1) ⊗ m`
  let lam : K ⊗[R] M →+ F ⊗[T] M := TensorProduct.liftAddHom
    (AddMonoidHom.mk' (fun k => AddMonoidHom.mk' (fun m => ρ (k ⊗ₜ (1 : T)) ⊗ₜ[T] m)
      (fun a b => tmul_add _ _ _)) (fun a b => by
        ext m
        simp [add_tmul]))
    (fun r k m => by
      simp only [AddMonoidHom.mk'_apply]
      rw [← algebraMap_smul T r m, ← smul_tmul, hsmul, ← map_mul,
        Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one, smul_tmul,
        Algebra.algebraMap_eq_smul_one])
  have hlam : ∀ (k : K) (m : M), lam (k ⊗ₜ m) = ρ (k ⊗ₜ (1 : T)) ⊗ₜ[T] m := fun k m => rfl
  refine ⟨fun a b => ?_⟩
  suffices h : ∀ x : F ⊗[T] M, x = 0 by rw [h a, h b]
  intro x
  induction x using TensorProduct.induction_on with
  | zero => rfl
  | add x y hx hy => rw [hx, hy, add_zero]
  | tmul f m =>
    let μ : K ⊗[R] T →ₗ[R] K ⊗[R] M :=
      ((LinearMap.toSpanSingleton T M m).restrictScalars R).lTensor K
    have hμ₁ : ∀ x : K ⊗[R] T,
        (M.subtype.restrictScalars R).lTensor K (μ x) = x * ((1 : K) ⊗ₜ (m : T)) := by
      intro x
      induction x using TensorProduct.induction_on with
      | zero => rw [map_zero, map_zero, zero_mul]
      | tmul k t =>
        simp only [μ, LinearMap.lTensor_tmul, LinearMap.restrictScalars_apply,
          LinearMap.toSpanSingleton_apply, Submodule.subtype_apply, Submodule.coe_smul,
          smul_eq_mul, Algebra.TensorProduct.tmul_mul_tmul, mul_one]
      | add x y hx hy => rw [map_add, map_add, hx, hy, add_mul]
    have hμ₂ : ∀ x : K ⊗[R] T, lam (μ x) = ρ x ⊗ₜ[T] m := by
      intro x
      induction x using TensorProduct.induction_on with
      | zero => rw [map_zero, map_zero, map_zero, zero_tmul]
      | tmul k t =>
        simp only [μ, LinearMap.lTensor_tmul, LinearMap.restrictScalars_apply,
          LinearMap.toSpanSingleton_apply]
        rw [hlam, ← smul_tmul, hsmul, ← map_mul, Algebra.TensorProduct.tmul_mul_tmul, one_mul,
          mul_one]
      | add x y hx hy => rw [map_add, map_add, hx, hy, map_add, add_tmul]
    have hμs : μ s = 0 := by
      apply hinj
      rw [hμ₁, map_zero]
      exact hsM m m.2
    have hρs : ρ s ⊗ₜ[T] m = 0 := by rw [← hμ₂, hμs, map_zero]
    have : f ⊗ₜ[T] m = (f * (ρ s)⁻¹) • (ρ s ⊗ₜ[T] m) := by
      rw [smul_tmul', smul_eq_mul, mul_assoc, inv_mul_cancel₀ hs, mul_one]
    rw [this, hρs, smul_zero]

end FibreVanishing

section Jets

variable (K : Type u) [Field K]

/-- The jets of a Noetherian local `K`-algebra whose completion is the formal node have the
dimensions `2n - 1`. -/
theorem finrank_jet_of_completion_formalUV (L : Type u) [CommRing L] [IsLocalRing L]
    [IsNoetherianRing L] [Algebra K L]
    (e : AdicCompletion (maximalIdeal L) L ≃ₐ[K] FormalUV K) (n : ℕ) :
    Module.finrank K (L ⧸ maximalIdeal L ^ n) = 2 * n - 1 ∧
      FiniteDimensional K (L ⧸ maximalIdeal L ^ n) := by
  let j := (Algebra.NodeGeometricCompletionJets.jetEquiv L n).restrictScalars K
  refine ⟨?_, ?_⟩
  · rw [j.toLinearEquiv.finrank_eq, finrank_jet_of_algEquiv e n]
  · have := finiteDimensional_jet_of_algEquiv e n
    exact Module.Finite.equiv j.symm.toLinearEquiv

/-- **Injectivity at a node.** Let `ψ : T → B` be a surjection of `K`-algebras with `T`
Noetherian and `y ⊂ B` a maximal ideal. If the completions of `T` at `ψ⁻¹ y` and of `B` at `y`
are both formal nodes, then the local map `𝒪_{T, ψ⁻¹ y} → 𝒪_{B, y}` is injective. -/
theorem localRingHom_injective_of_formalUV {T B : Type u} [CommRing T] [CommRing B]
    [Algebra K T] [Algebra K B] [IsNoetherianRing T] (ψ : T →ₐ[K] B)
    (hψ : Function.Surjective ψ) (y : Ideal B) [y.IsMaximal]
    (eT : AdicCompletion (maximalIdeal (Localization.AtPrime (y.comap ψ.toRingHom)))
      (Localization.AtPrime (y.comap ψ.toRingHom)) ≃ₐ[K] FormalUV K)
    (eB : AdicCompletion (maximalIdeal (Localization.AtPrime y)) (Localization.AtPrime y) ≃ₐ[K]
      FormalUV K) :
    Function.Injective (Localization.localRingHom (y.comap ψ.toRingHom) y ψ.toRingHom rfl) := by
  set p := y.comap ψ.toRingHom with hp
  have : p.IsMaximal := Ideal.comap_isMaximal_of_surjective _ hψ
  have : IsNoetherianRing B := isNoetherianRing_of_surjective T B ψ.toRingHom hψ
  let q : Localization.AtPrime p →ₐ[K] Localization.AtPrime y :=
    { Localization.localRingHom p y ψ.toRingHom rfl with
      commutes' := fun k => by
        change Localization.localRingHom p y ψ.toRingHom rfl
          (algebraMap K (Localization.AtPrime p) k) = _
        rw [IsScalarTower.algebraMap_apply K T (Localization.AtPrime p),
          Localization.localRingHom_to_map]
        change algebraMap B (Localization.AtPrime y) (ψ (algebraMap K T k)) = _
        rw [AlgHom.commutes, ← IsScalarTower.algebraMap_apply] }
  have hq : Function.Surjective q := localQuotientMap_surjective ψ y rfl hψ
  have : ∀ n : ℕ, FiniteDimensional K (Localization.AtPrime p ⧸ maximalIdeal _ ^ n) :=
    fun n => (finrank_jet_of_completion_formalUV K _ eT n).2
  have : ∀ n : ℕ, FiniteDimensional K (Localization.AtPrime y ⧸ maximalIdeal _ ^ n) :=
    fun n => (finrank_jet_of_completion_formalUV K _ eB n).2
  exact Algebra.NodeFieldJetRigidity.injective_of_all_jet_finrank_eq K q hq fun n => by
    rw [(finrank_jet_of_completion_formalUV K _ eT n).1,
      (finrank_jet_of_completion_formalUV K _ eB n).1]

end Jets

section Choice

/-- If the image of an ideal `J` under `θ : P → K[[X₀, X₁]]` generates a nonzero principal ideal
`(F)`, then some `j ∈ J` has `θ j = b * F` with `b` a unit. -/
theorem exists_mem_map_eq_unit_mul {K : Type u} [Field K] {P : Type u} [CommRing P]
    (J : Ideal P) (θ : P →+* Series K) {F : Series K} (hF : F ≠ 0)
    (h : J.map θ = Ideal.span {F}) : ∃ j ∈ J, ∃ b : Series K, IsUnit b ∧ θ j = b * F := by
  by_contra H
  push Not at H
  have hle : J.map θ ≤ Ideal.span {F} * maximalIdeal (Series K) := by
    rw [Ideal.map_le_iff_le_comap]
    intro j hj
    have hjF : θ j ∈ Ideal.span {F} := h ▸ Ideal.mem_map_of_mem θ hj
    obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp hjF
    have hbm : b ∈ maximalIdeal (Series K) := by
      rw [mem_maximalIdeal, mem_nonunits_iff]
      exact fun hu => H j hj b hu hb.symm
    rw [Ideal.mem_comap, ← hb, show b * F = F * b from mul_comm b F]
    exact Ideal.mul_mem_mul (Ideal.mem_span_singleton_self F) hbm
  have hFm : F ∈ Ideal.span {F} * maximalIdeal (Series K) :=
    hle (h ▸ Ideal.mem_span_singleton_self F)
  obtain ⟨a, ha, hFa⟩ := Ideal.mem_span_singleton_mul.mp hFm
  have hu : IsUnit (1 - a) := IsLocalRing.isUnit_one_sub_self_of_mem_nonunits a ha
  apply hF
  have : F * (1 - a) = 0 := by rw [mul_sub, mul_one, hFa, sub_self]
  exact hu.mul_left_eq_zero.mp this

end Choice

section Node

variable {R : Type u} [CommRing R] {P : Type u} [CommRing P] [Algebra R P]
  [Algebra (MvPolynomial (Fin 2) R) P] [IsScalarTower R (MvPolynomial (Fin 2) R) P]
  [Algebra.Etale (MvPolynomial (Fin 2) R) P]
  {B : Type u} [CommRing B] [Algebra R B] [Module.Flat R B] [Algebra.FinitePresentation R B]
  (φ : P →ₐ[R] B) (hφ : Function.Surjective φ)
  {K : Type u} [Field K] [IsAlgClosed K] [Algebra R K]
  (z : Ideal (K ⊗[R] B)) [z.IsMaximal]

include hφ in
/-- **Near a node the kernel of a plane presentation is principal.** Let `φ : P → B` be a
surjection from an algebra étale over `R[X₀, X₁]` onto a flat, finitely presented `R`-algebra, and
`z ⊂ K ⊗_R B` a geometric point with `Ô_z ≅ K[[u, v]]/(uv)`. Then there are `g ∈ ker φ` and `h ∈ P`
outside the prime `Q₀` of `P` under `z`, with `hessian g ∉ Q₀` and `h · ker φ ⊆ (g)`. -/
theorem exists_principal_kernel
    (e : AdicCompletion (maximalIdeal (Localization.AtPrime z)) (Localization.AtPrime z) ≃ₐ[K]
      FormalUV K) :
    ∃ g ∈ RingHom.ker φ.toRingHom, ∃ h : P,
      h ∉ z.comap ((Algebra.TensorProduct.includeRight : B →ₐ[R] K ⊗[R] B).comp φ).toRingHom ∧
      hessian R P g ∉
        z.comap ((Algebra.TensorProduct.includeRight : B →ₐ[R] K ⊗[R] B).comp φ).toRingHom ∧
      ∀ j ∈ RingHom.ker φ.toRingHom, h * j ∈ Ideal.span {g} := by
  classical
  have : Algebra.FinitePresentation R P :=
    Algebra.FinitePresentation.trans R (MvPolynomial (Fin 2) R) P
  set J := RingHom.ker φ.toRingHom with hJ
  set Q₀ := z.comap ((Algebra.TensorProduct.includeRight : B →ₐ[R] K ⊗[R] B).comp φ).toRingHom
    with hQ₀def
  -- base change to `K`
  let Φ : PlaneBaseChange R K P →ₐ[K] K ⊗[R] B := Algebra.TensorProduct.map (AlgHom.id K K) φ
  have hΦ : Function.Surjective Φ := LinearMap.lTensor_surjective K hφ
  have hΦker : RingHom.ker Φ.toRingHom = J.map (toPlaneBaseChange R K P).toRingHom :=
    Algebra.TensorProduct.lTensor_ker φ hφ
  have hΦinc : ∀ p, Φ (toPlaneBaseChange R K P p) = (1 : K) ⊗ₜ φ p := fun p => rfl
  set Q := z.comap Φ.toRingHom with hQdef
  have : Q.IsMaximal := Ideal.comap_isMaximal_of_surjective _ hΦ
  have : Algebra.FiniteType K (PlaneBaseChange R K P) :=
    Algebra.FiniteType.trans (S := MvPolynomial (Fin 2) K) inferInstance inferInstance
  have hres := algebraMap_quotient_surjective_of_isAlgClosed K (PlaneBaseChange R K P) Q
  choose c hc using fun j : Fin 2 =>
    hres (Ideal.Quotient.mk Q (coord K (PlaneBaseChange R K P) j))
  have hQ : IsRationalPoint Q c := by
    refine ⟨fun j => ?_, hres⟩
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, ← hc j, Ideal.Quotient.mk_algebraMap, sub_self]
  have hQ₀ : ∀ p, p ∈ Q₀ ↔ toPlaneBaseChange R K P p ∈ Q := fun p => Iff.rfl
  -- the kernel of `K[[X₀, X₁]] → Ô_{K ⊗ B, z}` is principal
  let I' := (RingHom.ker Φ.toRingHom).map hQ.taylor.toRingHom
  let eB : (Series K ⧸ I') ≃ₐ[K] FormalUV K :=
    (hQ.quotientCompletionEquiv' Φ z rfl hΦ).symm.trans e
  have : Nontrivial (Series K ⧸ I') := eB.toEquiv.nontrivial
  have : IsLocalRing (Series K ⧸ I') :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk I') Ideal.Quotient.mk_surjective
  obtain ⟨F, hFker, hF2, hF3, hFΔ⟩ := exists_ker_eq_span_of_formalUV
    (Ideal.Quotient.mkₐ K I') (Ideal.Quotient.mkₐ_surjective K I') eB
  have hI' : J.map (hQ.taylor.toRingHom.comp (toPlaneBaseChange R K P).toRingHom) =
      Ideal.span {F} := by
    rw [← Ideal.map_map, ← hΦker, ← hFker]
    exact (Ideal.Quotient.mkₐ_ker K I').symm
  have hF0 : F ≠ 0 := fun h0 => hF3 (h0 ▸ zero_mem _)
  obtain ⟨g, hgJ, b, hb, hgb⟩ := exists_mem_map_eq_unit_mul J _ hF0 hI'
  -- the Taylor expansion of `1 ⊗ g` is a nondegenerate quadratic germ
  have hG : hQ.taylor (toPlaneBaseChange R K P g) = b * F := hgb
  have hG2 : hQ.taylor (toPlaneBaseChange R K P g) ∈ variableIdeal K ^ 2 := by
    rw [hG]
    exact Ideal.mul_mem_left _ _ hF2
  have hGΔ : jetDiscriminant (hQ.taylor (toPlaneBaseChange R K P g)) ≠ 0 := by
    rw [hG, jetDiscriminant_mul_of_mem b F hF2]
    exact mul_ne_zero (pow_ne_zero 2 (MvPowerSeries.isUnit_iff_constantCoeff.mp hb).ne_zero) hFΔ
  rw [mem_variableIdeal_sq_iff] at hG2
  have hd : ∀ i, planeDerivation K (PlaneBaseChange R K P) i (toPlaneBaseChange R K P g) ∈ Q := by
    intro i
    rw [hQ.mem_iff_taylor, ← hQ.coeff_single_taylor]
    fin_cases i
    · exact hG2.2.1
    · exact hG2.2.2
  have hhQ : hessian K (PlaneBaseChange R K P) (toPlaneBaseChange R K P g) ∉ Q := by
    rw [hQ.mem_iff_taylor, hQ.taylor_hessian, constantCoeff_hessian, neg_eq_zero]
    exact hGΔ
  have hhQ₀ : hessian R P g ∉ Q₀ := by
    rw [hQ₀, ← hessian_baseChange]
    exact hhQ
  -- the hypersurface `T = P/(g)` and the surjection `T → B`
  have hgker : ∀ a ∈ Ideal.span {g}, φ a = 0 := fun a ha => by
    obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [map_mul, show φ g = 0 from RingHom.mem_ker.mp hgJ, mul_zero]
  let Φbar : (P ⧸ Ideal.span {g}) →ₐ[R] B := Ideal.Quotient.liftₐ (Ideal.span {g}) φ hgker
  have hΦbar : Function.Surjective Φbar := fun x => by
    obtain ⟨p, rfl⟩ := hφ x
    exact ⟨Ideal.Quotient.mk _ p, rfl⟩
  let πT := baseQuotientMap R K P g
  let ΦT : HypersurfaceFibre R K P g →ₐ[K] K ⊗[R] B :=
    Algebra.TensorProduct.map (AlgHom.id K K) Φbar
  have hΦT : Function.Surjective ΦT := LinearMap.lTensor_surjective K hΦbar
  have hcomp : ∀ x : K ⊗[R] P, ΦT (πT x) = Φ x := by
    intro x
    induction x using TensorProduct.induction_on with
    | zero => rw [map_zero, map_zero, map_zero]
    | tmul k p => rfl
    | add x y hx hy => rw [map_add, map_add, hx, hy, map_add]
  set QT := z.comap ΦT.toRingHom with hQTdef
  have : QT.IsMaximal := Ideal.comap_isMaximal_of_surjective _ hΦT
  have hQT : QT.comap πT.toRingHom = Q := by
    ext x
    change ΦT (πT x) ∈ z ↔ Φ x ∈ z
    rw [hcomp]
  -- the hypersurface has a node at `QT`, and is the family locally on the fibre
  let eT := hQ.nodeEquiv πT QT hQT (baseQuotientMap_surjective R K P g) _
    (ker_baseQuotientMap R K P g) hd hhQ
  have : Algebra.FinitePresentation R (P ⧸ Ideal.span {g}) :=
    Algebra.FinitePresentation.quotient (Submodule.fg_span_singleton g)
  have : Algebra.FiniteType K (HypersurfaceFibre R K P g) :=
    inferInstanceAs (Algebra.FiniteType K (K ⊗[R] (P ⧸ Ideal.span {g})))
  have : IsNoetherianRing (HypersurfaceFibre R K P g) := Algebra.FiniteType.isNoetherianRing K _
  have hinjT := localRingHom_injective_of_formalUV K ΦT hΦT z eT e
  obtain ⟨s, hsQT, hs⟩ := exists_notMem_forall_mul_eq_zero (RingHom.ker ΦT.toRingHom)
    (IsNoetherian.noetherian _) QT fun x hx => by
      have h0 : algebraMap _ (Localization.AtPrime QT) x = 0 := by
        apply hinjT
        rw [Localization.localRingHom_to_map, map_zero]
        change algebraMap _ _ (ΦT x) = 0
        rw [show ΦT x = 0 from RingHom.mem_ker.mp hx, map_zero]
      obtain ⟨⟨m, hm⟩, hmx⟩ := (IsLocalization.map_eq_zero_iff QT.primeCompl _ x).mp h0
      exact ⟨m, hm, hmx⟩
  -- the kernel `M` of `T → B` and its fibre
  set M := RingHom.ker Φbar.toRingHom with hMdef
  have hMfg : M.FG := Algebra.FinitePresentation.ker_fG_of_surjective Φbar hΦbar
  have : Module.Finite (P ⧸ Ideal.span {g}) M := Module.Finite.iff_fg.mpr hMfg
  have hflat : Function.Injective ((M.subtype.restrictScalars R).lTensor K) :=
    LinearMap.lTensor_injective_of_exact_of_flat Φbar.toLinearMap hΦbar
      (M.subtype.restrictScalars R) Subtype.val_injective (fun t => by
        constructor
        · intro ht
          exact ⟨⟨t, ht⟩, rfl⟩
        · rintro ⟨m, rfl⟩
          exact m.2) K
  let : Field (HypersurfaceFibre R K P g ⧸ QT) := Ideal.Quotient.field QT
  let ρ : K ⊗[R] (P ⧸ Ideal.span {g}) →+* HypersurfaceFibre R K P g ⧸ QT := Ideal.Quotient.mk QT
  have hρs : ρ s ≠ 0 := by
    change Ideal.Quotient.mk QT s ≠ 0
    rwa [Ne, Ideal.Quotient.eq_zero_iff_mem]
  have hsub := subsingleton_tensor_of_lTensor_injective M K hflat ρ s hρs fun m hm => hs _ (by
    rw [RingHom.mem_ker]
    change (1 : K) ⊗ₜ Φbar m = 0
    rw [show Φbar m = 0 from hm, tmul_zero])
  let : Algebra (P ⧸ Ideal.span {g}) (HypersurfaceFibre R K P g ⧸ QT) :=
    (ρ.comp (Algebra.TensorProduct.includeRight :
      (P ⧸ Ideal.span {g}) →ₐ[R] K ⊗[R] (P ⧸ Ideal.span {g})).toRingHom).toAlgebra
  set Qbar := QT.comap (Algebra.TensorProduct.includeRight :
      (P ⧸ Ideal.span {g}) →ₐ[R] K ⊗[R] (P ⧸ Ideal.span {g})).toRingHom with hQbar
  have hker : RingHom.ker (algebraMap (P ⧸ Ideal.span {g}) (HypersurfaceFibre R K P g ⧸ QT)) =
      Qbar := by
    ext t
    rw [RingHom.mem_ker]
    exact Ideal.Quotient.eq_zero_iff_mem
  have hsupp := notMem_support_of_subsingleton_tensor (B := P ⧸ Ideal.span {g}) (M := M)
    (F := HypersurfaceFibre R K P g ⧸ QT) ⟨Qbar, inferInstance⟩ hker
  rw [Module.mem_support_iff_of_finite, SetLike.not_le_iff_exists] at hsupp
  obtain ⟨hbar, hann, hhbar⟩ := hsupp
  obtain ⟨h, rfl⟩ := Ideal.Quotient.mk_surjective hbar
  refine ⟨g, hgJ, h, ?_, hhQ₀, fun j hj => ?_⟩
  · exact hhbar
  · have hjM : Ideal.Quotient.mk (Ideal.span {g}) j ∈ M := by
      rw [RingHom.mem_ker]
      exact RingHom.mem_ker.mp hj
    have := congrArg Subtype.val (Module.mem_annihilator.mp hann ⟨_, hjM⟩)
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_mul]
    exact this

end Node

