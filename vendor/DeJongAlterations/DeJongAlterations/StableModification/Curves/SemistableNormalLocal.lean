import DeJongAlterations.StableModification.Curves.SemistableNormalMorse
import DeJongAlterations.StableModification.Curves.SemistableOpenLocal
import DeJongAlterations.Algebra.NodeBlowupChart

/-!
# Étale local structure of a nodal family at a node

Let `R → B` be flat and finitely presented and `z` a geometric point of `B` which is a node of its
fibre (`Ô ≅ K[[u, v]]/(uv)`). Near `z`, the family is the hypersurface `g = 0` in a surface `P`
étale over `R[X₀, X₁]`, with invertible Hessian (SS2, `SemistableOpen.exists_principal_kernel`).
This file shows that, étale locally, it is the base change of the standard node
`O[u, v]/(uv - c)` along an étale `R`-algebra `O` (Stacks, Tag 0CBY; blueprint
`sm-semistable-normal.tex`):

* `etale_critical`: the critical locus `O = P/(∂₀g, ∂₁g)` of `g` is étale over `R`, because the
  partial derivatives of `g` are étale coordinates (their Jacobian is the Hessian);
* `exists_mul_mem_of_section`: if an algebra étale over the plane over `A` has an `A`-point `σ` on
  the zero section of the coordinates, then, after inverting an element `s` with `σ(s) = 1`, the
  kernel of `σ` is generated by the coordinates (the diagonal of an étale algebra is open);
* `planeDerivation_recoord_gradient_mem`, `hessian_recoord_gradient_sub_mem`: in the coordinates
  `yᵢ = ∂ᵢg`, the function `g - g(σ)` vanishes to second order along the critical section and its
  Hessian is the inverse of the original Hessian there;
* `exists_basePlane_mul`, `exists_nodeChart`: the étale local structure itself, a ring étale over
  `O ⊗_R P/(g)` and over the standard node `O[u, v]/(uv - c)`.
-/

noncomputable section

open TensorProduct

namespace DeJongAlterations.StableModification.Curves.SemistableNormal

open SemistableOpen (coord planeDerivation planeDerivation_coord hessian planeDerivation_map
  hessian_map)

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

universe u

section BasePlane

variable (R : Type u) [CommRing R] (O : Type u) [CommRing O] [Algebra R O]
  (P : Type u) [CommRing P] [Algebra R P]
  [Algebra (MvPolynomial (Fin 2) R) P] [IsScalarTower R (MvPolynomial (Fin 2) R) P]

/-- The plane structure of the base change: `O[X₀, X₁] → O ⊗_R P`, `Xᵢ ↦ 1 ⊗ uᵢ`. -/
def basePlaneMap : MvPolynomial (Fin 2) O →ₐ[O] O ⊗[R] P :=
  MvPolynomial.aeval fun i => 1 ⊗ₜ coord R P i

/-- The base change `O ⊗_R P` with its plane structure over `O[X₀, X₁]` (a type synonym;
adapted from `SemistableOpen.PlaneBaseChange`, which is the case of a field `O`). -/
def BasePlane : Type u := O ⊗[R] P

instance : CommRing (BasePlane R O P) := inferInstanceAs (CommRing (O ⊗[R] P))
instance : Algebra O (BasePlane R O P) := inferInstanceAs (Algebra O (O ⊗[R] P))
instance : Algebra R (BasePlane R O P) := inferInstanceAs (Algebra R (O ⊗[R] P))
instance : IsScalarTower R O (BasePlane R O P) := inferInstanceAs (IsScalarTower R O (O ⊗[R] P))
instance : Algebra (MvPolynomial (Fin 2) O) (BasePlane R O P) :=
  (basePlaneMap R O P).toRingHom.toAlgebra
instance : IsScalarTower O (MvPolynomial (Fin 2) O) (BasePlane R O P) :=
  .of_algebraMap_eq fun k => ((basePlaneMap R O P).commutes k).symm
instance : Algebra P (BasePlane R O P) :=
  (Algebra.TensorProduct.rightAlgebra : Algebra P (O ⊗[R] P))
instance : Algebra (MvPolynomial (Fin 2) R) (BasePlane R O P) :=
  ((algebraMap P (BasePlane R O P)).comp (algebraMap (MvPolynomial (Fin 2) R) P)).toAlgebra
instance : IsScalarTower (MvPolynomial (Fin 2) R) P (BasePlane R O P) :=
  .of_algebraMap_eq' rfl
instance : IsScalarTower R P (BasePlane R O P) := .of_algebraMap_eq fun r => by
  change algebraMap R O r ⊗ₜ (1 : P) = (1 : O) ⊗ₜ algebraMap R P r
  rw [Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul]

/-- The inclusion `P → O ⊗_R P`, `p ↦ 1 ⊗ p`. -/
def toBasePlane : P →ₐ[R] BasePlane R O P := Algebra.TensorProduct.includeRight

omit [Algebra (MvPolynomial (Fin 2) R) P] [IsScalarTower R (MvPolynomial (Fin 2) R) P] in
theorem toBasePlane_apply (p : P) : toBasePlane R O P p = algebraMap P (BasePlane R O P) p := rfl

omit [IsScalarTower R (MvPolynomial (Fin 2) R) P] in
theorem toBasePlane_coord (j : Fin 2) :
    toBasePlane R O P (coord R P j) = coord O (BasePlane R O P) j := by
  change (1 : O) ⊗ₜ coord R P j = basePlaneMap R O P (MvPolynomial.X j)
  simp [basePlaneMap]

section Pushout

attribute [local instance] MvPolynomial.algebraMvPolynomial

instance : IsScalarTower R (MvPolynomial (Fin 2) R) (BasePlane R O P) :=
  .of_algebraMap_eq fun r => by
    change algebraMap R (BasePlane R O P) r = algebraMap P (BasePlane R O P)
      (algebraMap (MvPolynomial (Fin 2) R) P (algebraMap R _ r))
    rw [← IsScalarTower.algebraMap_apply R (MvPolynomial (Fin 2) R) P r,
      ← IsScalarTower.algebraMap_apply R P (BasePlane R O P) r]

instance : IsScalarTower R (MvPolynomial (Fin 2) O) (BasePlane R O P) :=
  .of_algebraMap_eq fun r => by
    rw [IsScalarTower.algebraMap_apply R O (MvPolynomial (Fin 2) O),
      ← IsScalarTower.algebraMap_apply O (MvPolynomial (Fin 2) O) (BasePlane R O P),
      ← IsScalarTower.algebraMap_apply R O (BasePlane R O P)]

instance : IsScalarTower (MvPolynomial (Fin 2) R) (MvPolynomial (Fin 2) O)
    (BasePlane R O P) := by
  refine .of_algebraMap_eq fun a => ?_
  change algebraMap P (BasePlane R O P) (algebraMap _ P a) =
    basePlaneMap R O P (MvPolynomial.map (algebraMap R O) a)
  induction a using MvPolynomial.induction_on with
  | C r =>
    have hc : basePlaneMap R O P (MvPolynomial.C (algebraMap R O r)) =
        algebraMap O (O ⊗[R] P) (algebraMap R O r) := (basePlaneMap R O P).commutes _
    rw [MvPolynomial.map_C, hc]
    change algebraMap P (BasePlane R O P) (algebraMap (MvPolynomial (Fin 2) R) P
      (algebraMap R (MvPolynomial (Fin 2) R) r)) = _
    rw [← IsScalarTower.algebraMap_apply R (MvPolynomial (Fin 2) R) P r,
      ← IsScalarTower.algebraMap_apply R P (BasePlane R O P) r]
    exact IsScalarTower.algebraMap_apply R O (BasePlane R O P) r
  | add a b ha hb => rw [map_add, map_add, ha, hb, map_add, map_add]
  | mul_X a i ha =>
    rw [map_mul, map_mul, ha, map_mul, map_mul, MvPolynomial.map_X]
    congr 1
    simp [basePlaneMap, coord]
    rfl

/-- `O ⊗_R P = O[X₀, X₁] ⊗_{R[X₀, X₁]} P`. -/
instance basePlane_isPushout :
    Algebra.IsPushout (MvPolynomial (Fin 2) R) P (MvPolynomial (Fin 2) O) (BasePlane R O P) := by
  have hbig : Algebra.IsPushout R P O (BasePlane R O P) := TensorProduct.isPushout'
  exact (Algebra.IsPushout.comp_iff R (MvPolynomial (Fin 2) R) O (MvPolynomial (Fin 2) O)
    (T := P) (T' := BasePlane R O P)).mp hbig

/-- **Base change of a surface étale over the plane.** -/
instance [Algebra.Etale (MvPolynomial (Fin 2) R) P] :
    Algebra.Etale (MvPolynomial (Fin 2) O) (BasePlane R O P) := by
  have := RingHom.Etale.isStableUnderBaseChange (MvPolynomial (Fin 2) R) P (MvPolynomial (Fin 2) O)
    (BasePlane R O P) (RingHom.etale_algebraMap.mpr inferInstance)
  exact RingHom.etale_algebraMap.mp this

end Pushout

variable [Algebra.Etale (MvPolynomial (Fin 2) R) P]

/-- Partial derivatives commute with base change. -/
theorem planeDerivation_basePlane (i : Fin 2) (p : P) :
    planeDerivation O (BasePlane R O P) i (toBasePlane R O P p) =
      toBasePlane R O P (planeDerivation R P i p) :=
  planeDerivation_map (toBasePlane R O P) (toBasePlane_coord R O P) i p

theorem hessian_basePlane (g : P) :
    hessian O (BasePlane R O P) (toBasePlane R O P g) = toBasePlane R O P (hessian R P g) :=
  hessian_map (toBasePlane R O P) (toBasePlane_coord R O P) g

end BasePlane

section Critical

variable (R : Type u) [CommRing R] (P : Type u) [CommRing P] [Algebra R P]
  [Algebra (MvPolynomial (Fin 2) R) P] [IsScalarTower R (MvPolynomial (Fin 2) R) P]

section Formal

variable [Algebra.FormallyEtale (MvPolynomial (Fin 2) R) P]

/-- The gradient `(∂₀g, ∂₁g)` of `g`. -/
def gradient (g : P) : Fin 2 → P := fun i => planeDerivation R P i g

/-- The ideal `(∂₀g, ∂₁g)` of the critical locus of `g`. -/
def critIdeal (g : P) : Ideal P := Ideal.span {planeDerivation R P 0 g, planeDerivation R P 1 g}

theorem jacobian_gradient (g : P) : jacobian R P (gradient R P g) = hessian R P g :=
  (hessian_eq_jacobian R P g).symm

end Formal

variable [Algebra.Etale (MvPolynomial (Fin 2) R) P]

/-- **The critical locus of a function with invertible Hessian is étale over the base**: its
partial derivatives are étale coordinates, and the critical locus is their zero locus. -/
theorem etale_critical (g : P) (hg : IsUnit (hessian R P g)) :
    Algebra.Etale R (P ⧸ critIdeal R P g) := by
  have : Algebra.FinitePresentation R P :=
    Algebra.FinitePresentation.trans R (MvPolynomial (Fin 2) R) P
  have := etale_recoord R (gradient R P g) (by rwa [jacobian_gradient])
  have h := etale_quotient_coord R (Recoord R (gradient R P g))
  refine Algebra.Etale.of_equiv (Ideal.quotientEquivAlg
    (Ideal.span {coord R (Recoord R (gradient R P g)) 0, coord R (Recoord R (gradient R P g)) 1})
    (critIdeal R P g) (Recoord.equiv R (gradient R P g)).symm ?_)
  rw [Ideal.map_span, Set.image_pair, coord_recoord, coord_recoord]
  rfl

end Critical

section Section

variable {A : Type u} [CommRing A] {T : Type u} [CommRing T] [Algebra A T]
  [Algebra (MvPolynomial (Fin 2) A) T] [IsScalarTower A (MvPolynomial (Fin 2) A) T]
  [Algebra.Etale (MvPolynomial (Fin 2) A) T]

/-- **The diagonal of an étale algebra is open.** Let `T` be étale over `A[Y₀, Y₁]` and
`σ : T → A` an `A`-point on the zero section of the coordinates. Then there is `s ∈ T` with
`σ(s) = 1` such that `s · ker σ ⊆ (y₀, y₁)`: the zero locus `T/(y₀, y₁)` is étale over `A`, so its
`A`-point `σ` is cut out by an idempotent. -/
theorem exists_mul_mem_of_section (σ : T →ₐ[A] A) (hσ : ∀ i, σ (coord A T i) = 0) :
    ∃ s : T, σ s = 1 ∧ ∀ x, σ x = 0 → s * x ∈ coordIdeal A T := by
  have : Algebra.FinitePresentation A T :=
    Algebra.FinitePresentation.trans A (MvPolynomial (Fin 2) A) T
  have := etale_quotient_coord A T
  have hσI : ∀ x ∈ coordIdeal A T, σ x = 0 := by
    intro x hx
    have : coordIdeal A T ≤ RingHom.ker σ.toRingHom := by
      rw [Ideal.span_le]
      rintro _ (rfl | rfl)
      · exact hσ 0
      · exact hσ 1
    exact this hx
  let σbar : (T ⧸ coordIdeal A T) →ₐ[A] A := Ideal.Quotient.liftₐ _ σ hσI
  have hσbar : ∀ x, σbar (Ideal.Quotient.mk _ x) = σ x := fun _ => rfl
  have hsurj : Function.Surjective σbar := fun a =>
    ⟨algebraMap A _ a, σbar.commutes a⟩
  let : Algebra (T ⧸ coordIdeal A T) A := σbar.toAlgebra
  have : IsScalarTower A (T ⧸ coordIdeal A T) A :=
    .of_algebraMap_eq fun a => (σbar.commutes a).symm
  have hfe : Algebra.FormallyEtale (T ⧸ coordIdeal A T) A :=
    Algebra.FormallyEtale.of_restrictScalars (R := A)
  have hidem := (Algebra.FormallyEtale.iff_of_surjective hsurj).mp hfe
  have hfg : (RingHom.ker (algebraMap (T ⧸ coordIdeal A T) A)).FG :=
    Algebra.FinitePresentation.ker_fG_of_surjective σbar hsurj
  obtain ⟨e, he, hspan⟩ := (Ideal.isIdempotentElem_iff_of_fg _ hfg).mp hidem
  have heker : σbar e = 0 := by
    have : e ∈ RingHom.ker (algebraMap (T ⧸ coordIdeal A T) A) := by
      rw [hspan]; exact Submodule.mem_span_singleton_self e
    exact this
  obtain ⟨s, hs⟩ := Ideal.Quotient.mk_surjective (1 - e)
  refine ⟨s, ?_, fun x hx => ?_⟩
  · rw [← hσbar, hs, map_sub, map_one, heker, sub_zero]
  · have hxk : Ideal.Quotient.mk (coordIdeal A T) x ∈
        RingHom.ker (algebraMap (T ⧸ coordIdeal A T) A) := by
      change σbar (Ideal.Quotient.mk _ x) = 0
      rw [hσbar, hx]
    rw [hspan] at hxk
    obtain ⟨r, hr⟩ := Submodule.mem_span_singleton.mp hxk
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_mul, hs, ← hr, smul_eq_mul]
    have : e * e = e := he
    linear_combination (-r) * this

end Section

section Gradient

variable (A : Type u) [CommRing A] {T : Type u} [CommRing T] [Algebra A T]
  [Algebra (MvPolynomial (Fin 2) A) T] [IsScalarTower A (MvPolynomial (Fin 2) A) T]
  [Algebra.FormallyEtale (MvPolynomial (Fin 2) A) T] (g : T)
  [Algebra.FormallyEtale (MvPolynomial (Fin 2) A) (Recoord A (gradient A T g))]

/-- In the coordinates `yᵢ = ∂ᵢg`, the partial derivatives of `g` are `∂'ⱼg = Σᵢ yᵢ ∂'ⱼuᵢ`. -/
theorem planeDerivation_recoord_gradient (j : Fin 2) :
    planeDerivation A (Recoord A (gradient A T g)) j (Recoord.equiv A _ g) =
      ∑ i, coord A (Recoord A (gradient A T g)) i *
        Recoord.equiv A _ (newDeriv A (gradient A T g) j (coord A T i)) := by
  change newDeriv A (gradient A T g) j g = _
  rw [newDeriv_eq_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [coord_recoord]
  rfl

/-- `g` is critical along the zero section of the coordinates `yᵢ = ∂ᵢg`. -/
theorem planeDerivation_recoord_gradient_mem (j : Fin 2) :
    planeDerivation A (Recoord A (gradient A T g)) j (Recoord.equiv A _ g) ∈
      coordIdeal A (Recoord A (gradient A T g)) := by
  rw [planeDerivation_recoord_gradient, Fin.sum_univ_two]
  exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ (coord_mem_coordIdeal _ _ 0))
    (Ideal.mul_mem_right _ _ (coord_mem_coordIdeal _ _ 1))

/-- **The Hessian in the coordinates `yᵢ = ∂ᵢg`** is, along the zero section, the Jacobian
determinant of the old coordinates in the new ones, i.e. the inverse of the original Hessian. -/
theorem hessian_recoord_gradient_sub_mem :
    hessian A (Recoord A (gradient A T g)) (Recoord.equiv A _ g) -
        Recoord.equiv A _ (newJacobian A (gradient A T g)) ∈
      coordIdeal A (Recoord A (gradient A T g)) := by
  set T' := Recoord A (gradient A T g)
  rw [← Ideal.Quotient.eq_zero_iff_mem]
  have h : ∀ j k : Fin 2, Ideal.Quotient.mk (coordIdeal A T')
      (planeDerivation A T' k (planeDerivation A T' j (Recoord.equiv A _ g))) =
      Ideal.Quotient.mk (coordIdeal A T')
        (Recoord.equiv A _ (newDeriv A (gradient A T g) j (coord A T k))) := by
    intro j k
    rw [planeDerivation_recoord_gradient, Fin.sum_univ_two, map_add, map_add,
      mul_comm (coord A T' 0), mul_comm (coord A T' 1), mk_planeDerivation_mul_coord,
      mk_planeDerivation_mul_coord]
    fin_cases k <;> simp
  rw [map_sub, hessian, map_sub, map_mul, map_mul, h, h, h, h]
  simp only [newJacobian, map_sub, map_mul]
  exact sub_self _

end Gradient

section NodeChart

variable (R : Type u) [CommRing R] (P : Type u) [CommRing P] [Algebra R P]
  [Algebra (MvPolynomial (Fin 2) R) P] [IsScalarTower R (MvPolynomial (Fin 2) R) P]
  (O : Type u) [CommRing O] [Algebra R O]

/-- The section `O ⊗_R P → O`, `o ⊗ p ↦ o · π(p)`, attached to `π : P → O`. -/
def baseSection (π : P →ₐ[R] O) : BasePlane R O P →ₐ[O] O :=
  Algebra.TensorProduct.lift (AlgHom.id O O) π (fun _ _ => Commute.all _ _)

omit [Algebra (MvPolynomial (Fin 2) R) P] [IsScalarTower R (MvPolynomial (Fin 2) R) P] in
theorem baseSection_toBasePlane (π : P →ₐ[R] O) (p : P) :
    baseSection R P O π (toBasePlane R O P p) = π p := by
  change Algebra.TensorProduct.lift (AlgHom.id O O) π (fun _ _ => Commute.all _ _)
    ((1 : O) ⊗ₜ p) = π p
  rw [Algebra.TensorProduct.lift_tmul, AlgHom.id_apply, one_mul]

theorem planeDerivation_sub_algebraMap {A T : Type u} [CommRing A] [CommRing T] [Algebra A T]
    [Algebra (MvPolynomial (Fin 2) A) T] [IsScalarTower A (MvPolynomial (Fin 2) A) T]
    [Algebra.FormallyEtale (MvPolynomial (Fin 2) A) T] (i : Fin 2) (x : T) (c : A) :
    planeDerivation A T i (x - algebraMap A T c) = planeDerivation A T i x := by
  rw [map_sub, Derivation.map_algebraMap, sub_zero]

theorem hessian_sub_algebraMap {A T : Type u} [CommRing A] [CommRing T] [Algebra A T]
    [Algebra (MvPolynomial (Fin 2) A) T] [IsScalarTower A (MvPolynomial (Fin 2) A) T]
    [Algebra.FormallyEtale (MvPolynomial (Fin 2) A) T] (x : T) (c : A) :
    hessian A T (x - algebraMap A T c) = hessian A T x := by
  simp only [hessian, planeDerivation_sub_algebraMap]

variable [Algebra.Etale (MvPolynomial (Fin 2) R) P]

/-- **The node chart over the base change.** Let `P` be étale over `R[X₀, X₁]` and `g ∈ P` with
invertible Hessian, and let `π : P → O` be an `R`-algebra map killing `∂₀g, ∂₁g` (a point of the
critical locus with values in `O`). For a prime `𝔮` of `O`, there is an étale `O ⊗_R P`-algebra `P'`
with an étale plane structure `O[U, V] → P'` and a prime `Q'` over the point `σ⁻¹(𝔮)` of the section
`σ : O ⊗_R P → O`, `o ⊗ p ↦ o π(p)`, such that `1 ⊗ g = u v + π(g)` in `P'` and `u, v ∈ Q'`. -/
theorem exists_basePlane_mul (g : P) (hg : IsUnit (hessian R P g)) (π : P →ₐ[R] O)
    (hπ : ∀ i, π (planeDerivation R P i g) = 0) (𝔮 : Ideal O) [𝔮.IsPrime] :
    ∃ (P' : Type u) (_ : CommRing P') (_ : Algebra (BasePlane R O P) P')
      (_ : Algebra.Etale (BasePlane R O P) P') (_ : Algebra O P')
      (_ : IsScalarTower O (BasePlane R O P) P')
      (_ : Algebra (MvPolynomial (Fin 2) O) P') (_ : IsScalarTower O (MvPolynomial (Fin 2) O) P')
      (_ : Algebra.Etale (MvPolynomial (Fin 2) O) P') (Q' : Ideal P') (_ : Q'.IsPrime),
      Q'.comap (algebraMap (BasePlane R O P) P') = 𝔮.comap (baseSection R P O π).toRingHom ∧
      (∀ i, coord O P' i ∈ Q') ∧
      algebraMap (BasePlane R O P) P' (toBasePlane R O P g) =
        coord O P' 0 * coord O P' 1 + algebraMap O P' (π g) := by
  have : Algebra.FinitePresentation O (BasePlane R O P) :=
    Algebra.FinitePresentation.trans O (MvPolynomial (Fin 2) O) (BasePlane R O P)
  set g' := toBasePlane R O P g with hg'def
  have hg' : IsUnit (hessian O (BasePlane R O P) g') := by
    rw [hessian_basePlane]; exact hg.map _
  set w := gradient O (BasePlane R O P) g' with hwdef
  have hw : IsUnit (jacobian O (BasePlane R O P) w) := by rw [jacobian_gradient]; exact hg'
  have : Algebra.Etale (MvPolynomial (Fin 2) O) (Recoord O w) := etale_recoord O w hw
  let σ : Recoord O w →ₐ[O] O :=
    (baseSection R P O π).comp (Recoord.equiv O w).symm.toAlgHom
  have hσ : ∀ x, σ x = baseSection R P O π ((Recoord.equiv O w).symm x) := fun _ => rfl
  have hwi : ∀ i, w i = toBasePlane R O P (planeDerivation R P i g) := fun i =>
    planeDerivation_basePlane R O P i g
  have hσ_coord : ∀ i, σ (coord O (Recoord O w) i) = 0 := by
    intro i
    rw [coord_recoord, hσ]
    change baseSection R P O π (w i) = 0
    rw [hwi, baseSection_toBasePlane, hπ]
  obtain ⟨s, hs1, hs⟩ := exists_mul_mem_of_section σ hσ_coord
  set G : Recoord O w := Recoord.equiv O w g' - algebraMap O (Recoord O w) (π g) with hGdef
  have hσG : σ G = 0 := by
    rw [hGdef, map_sub, AlgHom.commutes, hσ]
    change baseSection R P O π g' - _ = 0
    rw [hg'def, baseSection_toBasePlane, Algebra.algebraMap_self, RingHom.id_apply, sub_self]
  -- localize at `s`
  let Ts := Localization.Away s
  have : Algebra.Etale (Recoord O w) Ts := Algebra.Etale.of_isLocalizationAway s
  have : Algebra.Etale (MvPolynomial (Fin 2) O) Ts := Algebra.Etale.comp _ (Recoord O w) Ts
  have hcs : ∀ i, (IsScalarTower.toAlgHom O (Recoord O w) Ts) (coord O (Recoord O w) i) =
      coord O Ts i := fun i =>
    (IsScalarTower.algebraMap_apply (MvPolynomial (Fin 2) O) (Recoord O w) Ts _).symm
  -- the section extended to `Ts`
  have hsunit : ∀ y : Submonoid.powers s, IsUnit (σ y) := by
    rintro ⟨_, n, rfl⟩
    rw [map_pow, hs1, one_pow]
    exact isUnit_one
  let σs : Ts →ₐ[O] O := IsLocalization.liftAlgHom (M := Submonoid.powers s) hsunit
  have hσs : ∀ x, σs (algebraMap (Recoord O w) Ts x) = σ x := fun x =>
    IsLocalization.lift_eq (M := Submonoid.powers s) hsunit x
  let Qs := 𝔮.comap σs.toRingHom
  have : Qs.IsPrime := Ideal.comap_isPrime _ _
  have hmapI : (coordIdeal O (Recoord O w)).map (algebraMap (Recoord O w) Ts) =
      coordIdeal O Ts := by
    rw [Ideal.map_span, Set.image_pair]
    simp only [coordIdeal]
    congr 2
  have hQs : coordIdeal O Ts ≤ Qs := by
    rw [← hmapI, Ideal.map_le_iff_le_comap, Ideal.span_le]
    rintro _ (rfl | rfl) <;> simp only [SetLike.mem_coe, Ideal.mem_comap] <;>
      change σs (algebraMap (Recoord O w) Ts _) ∈ 𝔮 <;> rw [hσs, hσ_coord] <;> exact 𝔮.zero_mem
  have hsu : IsUnit (algebraMap (Recoord O w) Ts s) := IsLocalization.Away.algebraMap_isUnit s
  -- the hypotheses of the Morse lemma
  have hG : algebraMap (Recoord O w) Ts G ∈ coordIdeal O Ts := by
    obtain ⟨v, hv⟩ := hsu
    have h1 : algebraMap (Recoord O w) Ts (s * G) ∈ coordIdeal O Ts :=
      hmapI ▸ Ideal.mem_map_of_mem _ (hs G hσG)
    have : algebraMap (Recoord O w) Ts G =
        ↑v⁻¹ * algebraMap (Recoord O w) Ts (s * G) := by
      rw [map_mul, ← hv, ← mul_assoc, Units.inv_mul, one_mul]
    rw [this]
    exact Ideal.mul_mem_left _ _ h1
  have hdG : ∀ j, planeDerivation O Ts j (algebraMap (Recoord O w) Ts G) ∈ coordIdeal O Ts := by
    intro j
    have := planeDerivation_map (IsScalarTower.toAlgHom O (Recoord O w) Ts) hcs j G
    simp only [IsScalarTower.coe_toAlgHom'] at this
    rw [this, hGdef, planeDerivation_sub_algebraMap, ← hmapI]
    exact Ideal.mem_map_of_mem _ (planeDerivation_recoord_gradient_mem O g' j)
  have hh : hessian O Ts (algebraMap (Recoord O w) Ts G) ∉ Qs := by
    have := hessian_map (IsScalarTower.toAlgHom O (Recoord O w) Ts) hcs G
    simp only [IsScalarTower.coe_toAlgHom'] at this
    rw [this, hGdef, hessian_sub_algebraMap]
    intro hmem
    have hJ : IsUnit (Recoord.equiv O w (newJacobian O w)) := by
      refine IsUnit.of_mul_eq_one (Recoord.equiv O w (jacobian O (BasePlane R O P) w)) ?_
      rw [← map_mul, mul_comm, jacobian_mul_newJacobian, map_one]
    have hmem' : algebraMap (Recoord O w) Ts (Recoord.equiv O w (newJacobian O w)) ∈ Qs := by
      have h2 : algebraMap (Recoord O w) Ts (hessian O (Recoord O w) (Recoord.equiv O w g') -
          Recoord.equiv O w (newJacobian O w)) ∈ Qs :=
        hQs (hmapI ▸ Ideal.mem_map_of_mem _ (hessian_recoord_gradient_sub_mem O g'))
      have := Qs.sub_mem hmem h2
      rwa [map_sub, sub_sub_cancel] at this
    exact Ideal.IsPrime.ne_top ‹_› (Ideal.eq_top_of_isUnit_mem _ hmem' (hJ.map _))
  obtain ⟨P', _, _, _, _, _, _, _, _, Q', _, hQ', hcoord, hmul⟩ :=
    exists_etale_mul_of_hessian Qs hG hdG hQs hh
  -- the structure over `O ⊗_R P`: `O ⊗_R P = Recoord O w → Ts → P'`
  let : Algebra (BasePlane R O P) (Recoord O w) := (Recoord.equiv O w).toRingHom.toAlgebra
  let e : BasePlane R O P ≃ₐ[BasePlane R O P] Recoord O w :=
    { Recoord.equiv O w with commutes' := fun _ => rfl }
  have : Algebra.Etale (BasePlane R O P) (Recoord O w) := Algebra.Etale.of_equiv e
  have : Algebra.Etale (BasePlane R O P) Ts := Algebra.Etale.comp _ (Recoord O w) Ts
  let : Algebra (BasePlane R O P) P' :=
    ((algebraMap Ts P').comp (algebraMap (BasePlane R O P) Ts)).toAlgebra
  have : IsScalarTower (BasePlane R O P) Ts P' := .of_algebraMap_eq' rfl
  have : Algebra.Etale (BasePlane R O P) P' := Algebra.Etale.comp _ Ts P'
  have hι : ∀ x : BasePlane R O P, algebraMap (BasePlane R O P) P' x =
      algebraMap Ts P' (algebraMap (Recoord O w) Ts (Recoord.equiv O w x)) := fun x => by
    rw [IsScalarTower.algebraMap_apply (BasePlane R O P) Ts P',
      IsScalarTower.algebraMap_apply (BasePlane R O P) (Recoord O w) Ts]
    rfl
  have : IsScalarTower O (BasePlane R O P) P' := .of_algebraMap_eq fun o => by
    rw [hι, AlgEquiv.commutes, ← IsScalarTower.algebraMap_apply O (Recoord O w) Ts,
      ← IsScalarTower.algebraMap_apply O Ts P']
  refine ⟨P', inferInstance, inferInstance, inferInstance, inferInstance, inferInstance,
    inferInstance, inferInstance, inferInstance, Q', inferInstance, ?_, ?_, ?_⟩
  · ext x
    rw [Ideal.mem_comap, Ideal.mem_comap, hι, ← Ideal.mem_comap, hQ', Ideal.mem_comap]
    change σs (algebraMap (Recoord O w) Ts _) ∈ 𝔮 ↔ _
    rw [hσs]
    rfl
  · intro i
    have hle : (coordIdeal O Ts).map (algebraMap Ts P') ≤ Q' := by
      rw [Ideal.map_le_iff_le_comap, hQ']
      exact hQs
    exact hle (hcoord i)
  · rw [hι, ← hmul]
    have : Recoord.equiv O w (toBasePlane R O P g) = G + algebraMap O (Recoord O w) (π g) := by
      rw [hGdef, sub_add_cancel]
    rw [this, map_add, map_add, ← IsScalarTower.algebraMap_apply O (Recoord O w) Ts,
      ← IsScalarTower.algebraMap_apply O Ts P']

end NodeChart

section NodeChartQuotient

variable (R : Type u) [CommRing R] (P : Type u) [CommRing P] [Algebra R P]
  [Algebra (MvPolynomial (Fin 2) R) P] [IsScalarTower R (MvPolynomial (Fin 2) R) P]
  [Algebra.Etale (MvPolynomial (Fin 2) R) P]
  (O : Type u) [CommRing O] [Algebra R O]

open Algebra.NodeBlowupChart in
/-- **The node chart.** In the situation of `exists_basePlane_mul`, assume moreover `π(g) ∈ 𝔮`
(the point lies on the hypersurface `g = 0`). Then there is a ring `W`, étale over
`O ⊗_R P/(g)` and étale over the standard node `O[u, v]/(uv + π(g))`, with compatible
`O`-structures, and a prime `𝔔` of `W` lying over `π⁻¹(𝔮) ⊂ P` and over `𝔮 ⊂ O` at which the node
coordinates vanish. -/
theorem exists_nodeChart (g : P) (hg : IsUnit (hessian R P g)) (π : P →ₐ[R] O)
    (hπ : ∀ i, π (planeDerivation R P i g) = 0) (𝔮 : Ideal O) [𝔮.IsPrime] (hg𝔮 : π g ∈ 𝔮) :
    ∃ (W : Type u) (_ : CommRing W) (_ : Algebra (O ⊗[R] (P ⧸ Ideal.span {g})) W)
      (_ : Algebra.Etale (O ⊗[R] (P ⧸ Ideal.span {g})) W) (_ : Algebra (Node O (-π g)) W)
      (_ : Algebra.Etale (Node O (-π g)) W) (𝔔 : Ideal W) (_ : 𝔔.IsPrime),
      (∀ o : O, algebraMap (O ⊗[R] (P ⧸ Ideal.span {g})) W (o ⊗ₜ 1) =
        algebraMap (Node O (-π g)) W (algebraMap O (Node O (-π g)) o)) ∧
      (∀ p : P, algebraMap (O ⊗[R] (P ⧸ Ideal.span {g})) W (1 ⊗ₜ Ideal.Quotient.mk _ p) ∈ 𝔔 ↔
        π p ∈ 𝔮) ∧
      (∀ o : O, algebraMap (O ⊗[R] (P ⧸ Ideal.span {g})) W (o ⊗ₜ 1) ∈ 𝔔 ↔ o ∈ 𝔮) ∧
      (∀ i, algebraMap (Node O (-π g)) W (coordinate (-π g) i) ∈ 𝔔) := by
  obtain ⟨P', _, _, _, _, _, _, _, _, Q', _, hQ', hcoord, hmul⟩ :=
    exists_basePlane_mul R P O g hg π hπ 𝔮
  set ν := algebraMap (BasePlane R O P) P'
  set Ig : Ideal (BasePlane R O P) := Ideal.span {toBasePlane R O P g}
  set J : Ideal P' := Ig.map ν
  have hJQ : J ≤ Q' := by
    rw [Ideal.map_le_iff_le_comap, hQ', Ideal.span_le, Set.singleton_subset_iff,
      SetLike.mem_coe, Ideal.mem_comap]
    change baseSection R P O π (toBasePlane R O P g) ∈ 𝔮
    rwa [baseSection_toBasePlane]
  -- the structure over `O ⊗_R P/(g) = (O ⊗_R P)/(1 ⊗ g)`
  set A := BasePlane R O P ⧸ Ig
  have : Algebra.FinitePresentation (BasePlane R O P) P' := inferInstance
  have hJspan : J = Ideal.span {ν (toBasePlane R O P g)} := by
    simp only [J, Ig]
    rw [Ideal.map_span, Set.image_singleton]
  have hJfg : J.FG := hJspan ▸ Submodule.fg_span_singleton _
  have : Algebra.FinitePresentation (BasePlane R O P) (P' ⧸ J) :=
    Algebra.FinitePresentation.quotient hJfg
  have := formallyEtale_quotient_map (BasePlane R O P) P' Ig
  have := isScalarTower_quotient_map (BasePlane R O P) P' Ig (BasePlane R O P)
  have : Algebra.FinitePresentation A (P' ⧸ J) :=
    Algebra.FinitePresentation.of_restrict_scalars_finitePresentation (BasePlane R O P) A _
  have hEA : Algebra.Etale A (P' ⧸ J) := ⟨inferInstance, inferInstance⟩
  have hIg : (Ideal.span ({g} : Set P)).map
      (Algebra.TensorProduct.includeRight : P →ₐ[R] O ⊗[R] P) = Ig := by
    rw [Ideal.map_span, Set.image_singleton]
    rfl
  let eB : O ⊗[R] (P ⧸ Ideal.span {g}) ≃ₐ[O] A :=
    (Algebra.TensorProduct.tensorQuotientEquiv (R := R) O P O (Ideal.span {g})).trans
      (Ideal.quotientEquivAlgOfEq O hIg)
  have heB : ∀ o p, eB (o ⊗ₜ Ideal.Quotient.mk _ p) =
      Ideal.Quotient.mk Ig (algebraMap O (BasePlane R O P) o * toBasePlane R O P p) := by
    intro o p
    change Ideal.Quotient.mk Ig (o ⊗ₜ p) = _
    congr 1
    change o ⊗ₜ p = (o ⊗ₜ 1) * ((1 : O) ⊗ₜ p)
    rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
  let : Algebra (O ⊗[R] (P ⧸ Ideal.span {g})) A := eB.toRingHom.toAlgebra
  let eB' : O ⊗[R] (P ⧸ Ideal.span {g}) ≃ₐ[O ⊗[R] (P ⧸ Ideal.span {g})] A :=
    { eB with commutes' := fun _ => rfl }
  have : Algebra.Etale (O ⊗[R] (P ⧸ Ideal.span {g})) A := Algebra.Etale.of_equiv eB'
  let : Algebra (O ⊗[R] (P ⧸ Ideal.span {g})) (P' ⧸ J) :=
    ((algebraMap A (P' ⧸ J)).comp (algebraMap (O ⊗[R] (P ⧸ Ideal.span {g})) A)).toAlgebra
  have : IsScalarTower (O ⊗[R] (P ⧸ Ideal.span {g})) A (P' ⧸ J) := .of_algebraMap_eq' rfl
  have : Algebra.Etale (O ⊗[R] (P ⧸ Ideal.span {g})) (P' ⧸ J) :=
    Algebra.Etale.comp _ A (P' ⧸ J)
  have hB : ∀ o p, algebraMap (O ⊗[R] (P ⧸ Ideal.span {g})) (P' ⧸ J)
      (o ⊗ₜ Ideal.Quotient.mk _ p) =
      Ideal.Quotient.mk J (algebraMap O P' o * ν (toBasePlane R O P p)) := by
    intro o p
    change algebraMap A (P' ⧸ J) (eB (o ⊗ₜ Ideal.Quotient.mk _ p)) = _
    rw [heB, Ideal.Quotient.algebraMap_quotient_map_quotient, map_mul,
      ← IsScalarTower.algebraMap_apply]
  -- the node side
  set c : O := -π g
  set Iu := DeJongAlterations.Algebra.NodeChart.uChartIdeal O c
  set Ju : Ideal P' := Iu.map (algebraMap (MvPolynomial (Fin 2) O) P')
  have hJu : Ju = J := by
    rw [hJspan]
    simp only [Ju, Iu, DeJongAlterations.Algebra.NodeChart.uChartIdeal]
    rw [Ideal.map_span, Set.image_singleton, hmul]
    congr 2
    rw [map_sub, map_mul, ← MvPolynomial.algebraMap_eq, ← IsScalarTower.algebraMap_apply,
      map_neg, sub_neg_eq_add]
  have hJufg : Ju.FG := hJu ▸ hJfg
  have : Algebra.FinitePresentation (MvPolynomial (Fin 2) O) (P' ⧸ Ju) :=
    Algebra.FinitePresentation.quotient hJufg
  have := formallyEtale_quotient_map (MvPolynomial (Fin 2) O) P' Iu
  have := isScalarTower_quotient_map (MvPolynomial (Fin 2) O) P' Iu (MvPolynomial (Fin 2) O)
  have : Algebra.FinitePresentation (Node O c) (P' ⧸ Ju) :=
    Algebra.FinitePresentation.of_restrict_scalars_finitePresentation (MvPolynomial (Fin 2) O)
      (Node O c) _
  have : Algebra.Etale (Node O c) (P' ⧸ Ju) := ⟨inferInstance, inferInstance⟩
  let eW : (P' ⧸ Ju) ≃ₐ[O] (P' ⧸ J) := Ideal.quotientEquivAlgOfEq O hJu
  let : Algebra (Node O c) (P' ⧸ J) :=
    (eW.toRingHom.comp (algebraMap (Node O c) (P' ⧸ Ju))).toAlgebra
  let eW' : (P' ⧸ Ju) ≃ₐ[Node O c] (P' ⧸ J) := { eW with commutes' := fun _ => rfl }
  have : Algebra.Etale (Node O c) (P' ⧸ J) := Algebra.Etale.of_equiv eW'
  have hN : ∀ q : MvPolynomial (Fin 2) O, algebraMap (Node O c) (P' ⧸ J)
      (Ideal.Quotient.mk Iu q) =
        Ideal.Quotient.mk J (algebraMap (MvPolynomial (Fin 2) O) P' q) := by
    intro q
    change eW (algebraMap (Node O c) (P' ⧸ Ju) (Ideal.Quotient.mk Iu q)) = _
    rw [Ideal.Quotient.algebraMap_quotient_map_quotient]
    rfl
  -- the point
  have hmem : ∀ x : P', Ideal.Quotient.mk J x ∈ Q'.map (Ideal.Quotient.mk J) ↔ x ∈ Q' := by
    intro x
    rw [← Ideal.mem_comap, Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective,
      ← RingHom.ker_eq_comap_bot, Ideal.mk_ker, sup_eq_left.mpr hJQ]
  have : (Q'.map (Ideal.Quotient.mk J)).IsPrime :=
    Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by rw [Ideal.mk_ker]; exact hJQ)
  have hν : ∀ x, ν x ∈ Q' ↔ baseSection R P O π x ∈ 𝔮 := by
    intro x
    rw [← Ideal.mem_comap, hQ']
    rfl
  refine ⟨P' ⧸ J, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance,
    Q'.map (Ideal.Quotient.mk J), inferInstance, ?_, ?_, ?_, ?_⟩
  · intro o
    rw [show (o ⊗ₜ (1 : P ⧸ Ideal.span {g})) = o ⊗ₜ Ideal.Quotient.mk _ 1 from rfl, hB,
      map_one, map_one, mul_one, show algebraMap O (Node O c) o = Ideal.Quotient.mk Iu
        (algebraMap O (MvPolynomial (Fin 2) O) o) from rfl, hN,
      ← IsScalarTower.algebraMap_apply]
  · intro p
    rw [hB, map_one, one_mul, hmem, hν, baseSection_toBasePlane]
  · intro o
    rw [show (o ⊗ₜ (1 : P ⧸ Ideal.span {g})) = o ⊗ₜ Ideal.Quotient.mk _ 1 from rfl, hB,
      map_one, map_one, mul_one, hmem, IsScalarTower.algebraMap_apply O (BasePlane R O P) P', hν,
      AlgHom.commutes]
    rfl
  · intro i
    rw [show coordinate c i = Ideal.Quotient.mk Iu (MvPolynomial.X i) from rfl, hN, hmem]
    exact hcoord i

end NodeChartQuotient

end DeJongAlterations.StableModification.Curves.SemistableNormal
