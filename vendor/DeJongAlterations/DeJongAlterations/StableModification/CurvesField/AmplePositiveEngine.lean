import DeJongAlterations.StableModification.CurvesField.AmplePositiveNormalization

/-!
# Serre vanishing for ideals on a two-chart cover, without finiteness of `H¹`

Let `X = U ∪ V` be covered by two affine charts with rings `A = Γ(U)`, `B = Γ(V)`,
`C = Γ(U ∩ V)` and restriction maps `ρ_U : A → C`, `ρ_V : B → C`, and let `g ∈ Cˣ` be the
transition function of a line bundle `𝓛` trivialized on both charts. The two-term complex of an
ideal `I` (ideals `I_A`, `I_B`, `I_C`) twisted by `𝓛^k` has `H¹ = I_C / (ρ_V I_B + g^k ρ_U I_A)`.
This file proves its vanishing for `k ≫ 0`, modulo a smaller ideal `J` with `N · I ⊆ J`, from
the vanishing for the structure sheaf modulo `N` (`exists_forall_mem_of_engine`):

* `H¹_k(𝒪 / N) = 0` for `k ≫ 0` (the input; for `N = 0` this is Serre vanishing for `𝒪`, which
  uses finiteness of `H¹(𝒪)`);
* `I_C` is generated by `ρ_V I_B`, and every `ρ_V b`, `b ∈ I_B`, is `g^E ρ_U a` modulo `J_C` (the
  ideal is quasi-coherent and `U ∩ V` is a basic open in both charts);
* `I_B` is finitely generated.

No finiteness of `H¹(I)` is needed: `I / J` is a quotient of finitely many copies of
`𝒪 / N ⊗ 𝓛^{-E}`, the generators of `I_B` extended over `U` after multiplication by `g^E`. This is
the dévissage step of Hartshorne, Exercise III.5.7 (ampleness can be checked on the reduction and
on the components), carried out on the two-term complexes (blueprint
`sm-curves-fields-ample-positive.tex`, `lem:sm-ample-positive-engine`).

Consequences: sections of `𝓛^k` with prescribed residues modulo `I` (`exists_lift_of_engine`), and
the descending induction along a filtration `I = I₀ ⊇ I₁ ⊇ … ⊇ I_e = 0`
(`exists_forall_mem_of_filtration`), used for the nilradical filtration.
-/

universe u

namespace DeJongAlterations.StableModification.CurvesField.Positive

section Engine

variable {A B C : Type*} [CommRing A] [CommRing B] [CommRing C] (ρU : A →+* C) (ρV : B →+* C)
  (g : Cˣ)

/-- The coboundary condition: `w ≡ ρ_V b + g^k ρ_U a` modulo `J` with `a ∈ I_A`, `b ∈ I_B`. -/
def IsCobdy (IA : Ideal A) (IB : Ideal B) (JC : Ideal C) (k : ℕ) (w : C) : Prop :=
  ∃ a ∈ IA, ∃ b ∈ IB, w - (ρV b + (g : C) ^ k * ρU a) ∈ JC

variable {ρU ρV g}

lemma IsCobdy.add {IA : Ideal A} {IB : Ideal B} {JC : Ideal C} {k : ℕ} {w w' : C}
    (h : IsCobdy ρU ρV g IA IB JC k w) (h' : IsCobdy ρU ρV g IA IB JC k w') :
    IsCobdy ρU ρV g IA IB JC k (w + w') := by
  obtain ⟨a, ha, b, hb, hw⟩ := h
  obtain ⟨a', ha', b', hb', hw'⟩ := h'
  refine ⟨a + a', IA.add_mem ha ha', b + b', IB.add_mem hb hb', ?_⟩
  have e : w + w' - (ρV (b + b') + (g : C) ^ k * ρU (a + a')) =
      (w - (ρV b + (g : C) ^ k * ρU a)) + (w' - (ρV b' + (g : C) ^ k * ρU a')) := by
    rw [map_add, map_add]; ring
  rw [e]
  exact JC.add_mem hw hw'

lemma IsCobdy.zero {IA : Ideal A} {IB : Ideal B} {JC : Ideal C} {k : ℕ} :
    IsCobdy ρU ρV g IA IB JC k 0 :=
  ⟨0, IA.zero_mem, 0, IB.zero_mem, by simp⟩

lemma IsCobdy.sum {IA : Ideal A} {IB : Ideal B} {JC : Ideal C} {k : ℕ} {ι : Type*}
    (s : Finset ι) (w : ι → C) (h : ∀ i ∈ s, IsCobdy ρU ρV g IA IB JC k (w i)) :
    IsCobdy ρU ρV g IA IB JC k (∑ i ∈ s, w i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using IsCobdy.zero
  | insert i s hi ih =>
    rw [Finset.sum_insert hi]
    exact (h i (Finset.mem_insert_self i s)).add
      (ih fun j hj => h j (Finset.mem_insert_of_mem hj))

/-- Raising the exponent: if `ρ_V b ≡ g^e ρ_U a`, then `ρ_V b ≡ g^{e+d} ρ_U (h^d a)` modulo `J`,
for `h` with `ρ_U h · g ≡ 1` modulo `N`. -/
lemma exists_raise {h : A} {NC : Ideal C} (hh : ρU h * (g : C) - 1 ∈ NC) {IA : Ideal A}
    {IC JC : Ideal C} (hIA : ∀ a ∈ IA, ρU a ∈ IC) (hJ : NC * IC ≤ JC) {b : B} {a : A} {e : ℕ}
    (hb : ρV b - (g : C) ^ e * ρU a ∈ JC) (ha : a ∈ IA) (d : ℕ) :
    ρV b - (g : C) ^ (e + d) * ρU (h ^ d * a) ∈ JC := by
  induction d with
  | zero => simpa using hb
  | succ d ih =>
    have hmem : (g : C) ^ (e + d) * ρU (h ^ d * a) * (ρU h * (g : C) - 1) ∈ JC := by
      have h1 : ρU (h ^ d * a) ∈ IC := hIA _ (IA.mul_mem_left _ ha)
      have h2 : (ρU h * (g : C) - 1) * ρU (h ^ d * a) ∈ NC * IC := Ideal.mul_mem_mul hh h1
      have h3 := hJ h2
      have e : (g : C) ^ (e + d) * ρU (h ^ d * a) * (ρU h * (g : C) - 1) =
          (g : C) ^ (e + d) * ((ρU h * (g : C) - 1) * ρU (h ^ d * a)) := by ring
      rw [e]
      exact JC.mul_mem_left _ h3
    have e : ρV b - (g : C) ^ (e + (d + 1)) * ρU (h ^ (d + 1) * a) =
        (ρV b - (g : C) ^ (e + d) * ρU (h ^ d * a)) -
          (g : C) ^ (e + d) * ρU (h ^ d * a) * (ρU h * (g : C) - 1) := by
      rw [map_mul, map_pow, map_mul, map_pow]; ring
    rw [e]
    exact JC.sub_mem ih hmem

/-- **The engine** (blueprint `lem:sm-ample-positive-engine`): under the hypotheses above,
for all `k ≫ 0` every element of `I_C` is a coboundary `ρ_V b + g^k ρ_U a` (`a ∈ I_A`, `b ∈ I_B`)
modulo `J_C`. -/
theorem exists_forall_mem_of_engine {h : A} {NC : Ideal C} (hh : ρU h * (g : C) - 1 ∈ NC)
    {IA : Ideal A} {IB : Ideal B} {IC JC : Ideal C} (hIA : ∀ a ∈ IA, ρU a ∈ IC)
    (hIB : ∀ b ∈ IB, ρV b ∈ IC) (hJ : NC * IC ≤ JC) (hgen : IC ≤ IB.map ρV)
    (hloc : ∀ b ∈ IB, ∃ E : ℕ, ∃ a ∈ IA, ρV b - (g : C) ^ E * ρU a ∈ JC) (hfg : IB.FG)
    (hO : ∃ k₀ : ℕ, ∀ k : ℕ, k₀ ≤ k → ∀ x : C, ∃ a : A, ∃ b : B,
      x - (ρV b + (g : C) ^ k * ρU a) ∈ NC) :
    ∃ k₁ : ℕ, ∀ k : ℕ, k₁ ≤ k → ∀ w ∈ IC, IsCobdy ρU ρV g IA IB JC k w := by
  classical
  obtain ⟨S, hS⟩ := hfg
  have hSI : ∀ b ∈ S, b ∈ IB := fun b hb => hS ▸ Ideal.subset_span hb
  choose! Eb ab hab hEb using fun b (hb : b ∈ S) => hloc b (hSI b hb)
  set E := S.sup Eb
  -- a uniform exponent
  have hunif : ∀ b ∈ S, ∃ a ∈ IA, ρV b - (g : C) ^ E * ρU a ∈ JC := by
    intro b hb
    have hle : Eb b ≤ E := Finset.le_sup hb
    refine ⟨h ^ (E - Eb b) * ab b, IA.mul_mem_left _ (hab b hb), ?_⟩
    have := exists_raise hh hIA hJ (hEb b hb) (hab b hb) (E - Eb b)
    rwa [Nat.add_sub_cancel' hle] at this
  choose! a' ha' ha'E using hunif
  obtain ⟨k₀, hk₀⟩ := hO
  refine ⟨k₀ + E, fun k hk w hw => ?_⟩
  -- the generators
  have hgen' : ∀ c : C, ∀ b ∈ S, IsCobdy ρU ρV g IA IB JC k (c * ρV b) := by
    intro c b hb
    obtain ⟨x, y, hxy⟩ := hk₀ (k - E) (by omega) c
    refine ⟨x * a' b, IA.mul_mem_left _ (ha' b hb), y * b, IB.mul_mem_left _ (hSI b hb), ?_⟩
    set ν := c - (ρV y + (g : C) ^ (k - E) * ρU x)
    set ι := ρV b - (g : C) ^ E * ρU (a' b)
    have hkE : (g : C) ^ k = (g : C) ^ (k - E) * (g : C) ^ E := by
      rw [← pow_add, Nat.sub_add_cancel (by omega)]
    have e : c * ρV b - (ρV (y * b) + (g : C) ^ k * ρU (x * a' b)) =
        (g : C) ^ (k - E) * ρU x * ι + ν * ρV b := by
      simp only [ν, ι, map_mul, hkE]; ring
    rw [e]
    refine JC.add_mem (JC.mul_mem_left _ (ha'E b hb)) (hJ (Ideal.mul_mem_mul hxy ?_))
    exact hIB b (hSI b hb)
  -- `w` is a combination of the `ρ_V b`, `b ∈ S`
  have hw' : w ∈ Ideal.span (↑(S.image ρV) : Set C) := by
    have := hgen hw
    rwa [← hS, Ideal.map_span, ← Finset.coe_image] at this
  obtain ⟨f, -, hf⟩ := Submodule.mem_span_finset.mp hw'
  rw [← hf]
  apply IsCobdy.sum
  intro y hy
  obtain ⟨b, hb, rfl⟩ := Finset.mem_image.mp hy
  exact hgen' (f (ρV b)) b hb

/-- **Lifting residues** (`H¹_k(I) = 0` gives `H⁰_k(𝒪) ↠ H⁰_k(𝒪/I)`): if every element of `I_C`
is a coboundary for `k`, a pair `(α, β)` compatible modulo `I_C` is congruent modulo `I` to a
global section `(a, b)`, `ρ_V b = g^k ρ_U a`. -/
theorem exists_lift_of_cobdy {IA : Ideal A} {IB : Ideal B} {IC : Ideal C} {k : ℕ}
    (hcob : ∀ w ∈ IC, IsCobdy ρU ρV g IA IB ⊥ k w) (α : A) (β : B)
    (hαβ : ρV β - (g : C) ^ k * ρU α ∈ IC) :
    ∃ a : A, ∃ b : B, ρV b = (g : C) ^ k * ρU a ∧ a - α ∈ IA ∧ b - β ∈ IB := by
  obtain ⟨a', ha', b', hb', h⟩ := hcob _ hαβ
  rw [Ideal.mem_bot] at h
  refine ⟨α + a', β - b', ?_, by simpa using ha', by simpa using IB.neg_mem hb'⟩
  rw [map_add, map_sub]
  linear_combination h

/-- **Descending induction along a filtration**: if `I_j ⊇ I_{j+1}` with `I_e = 0` on `C`, and for
`k ≫ 0` every element of `I_{j,C}` is a coboundary modulo `I_{j+1,C}`, then for `k ≫ 0` every
element of `I_{0,C}` is an exact coboundary. -/
theorem exists_forall_mem_of_filtration (IA : ℕ → Ideal A) (IB : ℕ → Ideal B) (IC : ℕ → Ideal C)
    (hA : ∀ j, IA (j + 1) ≤ IA j) (hB : ∀ j, IB (j + 1) ≤ IB j) (e : ℕ) (he : IC e = ⊥)
    (hstep : ∀ j < e, ∃ k₁ : ℕ, ∀ k : ℕ, k₁ ≤ k → ∀ w ∈ IC j,
      IsCobdy ρU ρV g (IA j) (IB j) (IC (j + 1)) k w) :
    ∃ k₁ : ℕ, ∀ k : ℕ, k₁ ≤ k → ∀ w ∈ IC 0, IsCobdy ρU ρV g (IA 0) (IB 0) ⊥ k w := by
  -- by downward induction on `j`
  suffices H : ∀ d ≤ e, ∃ k₁ : ℕ, ∀ k : ℕ, k₁ ≤ k → ∀ w ∈ IC (e - d),
      IsCobdy ρU ρV g (IA (e - d)) (IB (e - d)) ⊥ k w by
    simpa using H e le_rfl
  intro d hd
  induction d with
  | zero =>
    refine ⟨0, fun k _ w hw => ?_⟩
    rw [Nat.sub_zero, he, Ideal.mem_bot] at hw
    rw [hw]
    exact IsCobdy.zero
  | succ d ih =>
    obtain ⟨k₂, hk₂⟩ := ih (by omega)
    obtain ⟨k₃, hk₃⟩ := hstep (e - (d + 1)) (by omega)
    have hj : e - (d + 1) + 1 = e - d := by omega
    refine ⟨max k₂ k₃, fun k hk w hw => ?_⟩
    obtain ⟨a, ha, b, hb, hr⟩ := hk₃ k (le_of_max_le_right hk) w hw
    rw [hj] at hr
    obtain ⟨a', ha', b', hb', hr'⟩ := hk₂ k (le_of_max_le_left hk) _ hr
    have hA' : IA (e - d) ≤ IA (e - (d + 1)) := hj ▸ hA _
    have hB' : IB (e - d) ≤ IB (e - (d + 1)) := hj ▸ hB _
    refine ⟨a + a', (IA _).add_mem ha (hA' ha'), b + b', (IB _).add_mem hb (hB' hb'), ?_⟩
    rw [Ideal.mem_bot] at hr' ⊢
    rw [map_add, map_add]
    linear_combination hr'

end Engine

end DeJongAlterations.StableModification.CurvesField.Positive
