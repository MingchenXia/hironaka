import DeJongAlterations.StableModification.CurvesField.OmegaDegree

/-!
# Riemann–Roch for line-bundle data on a curve with a two-chart presentation

Let `X = U ∪ V` with `U`, `V` affine, `U ∩ V = D(f)` for some `f ∈ Γ(V, 𝒪)`, and let `𝓛` be
line-bundle data generated by `τ` on `U` and by `σ` on `V`, with transition function
`g = τ / σ ∈ Γ(U ∩ V, 𝒪)ˣ` (a **two-chart presentation**, `Presentation`). Since
`Γ(U ∩ V, 𝒪) = Γ(V, 𝒪)_f`, `g = a / f^j` for some `a ∈ Γ(V, 𝒪)` and `j ∈ ℕ`. If `a` and `f` are
non-zero-divisors with finite-dimensional quotients `Γ(V, 𝒪)/(a)`, `Γ(V, 𝒪)/(f)` (e.g. `X`
integral of finite type and dimension one over a field), then for every `k ≥ 0`
(`Presentation.eulerCharOf_twist`)

  `χ(𝓛^k) = χ(𝒪) + k · (dim Γ(V, 𝒪)/(a) - j · dim Γ(V, 𝒪)/(f))`,

so `χ(𝓛^k) = χ(𝒪) + k · deg 𝓛` with `deg 𝓛 = χ(𝓛) - χ(𝒪)` (`Presentation.eulerCharOf_twist_eq`),
the Riemann–Roch theorem in the weak form needed to produce sections of large powers of a line
bundle of positive degree (Hartshorne IV.1.3, curve case; the "classical computation" in
M. Temkin, *Stable modification of relative curves*, J. Algebraic Geom. 19 (2010), proof of
Thm 1.1, `references/temkin10-stable-modification/source/semi-stable.tex`, lines 1735--1741).

The proof applies lane COH4's weak Riemann–Roch for twists by a regular function
(`CurvesField.euler_family`) twice, to `a` and to `f⁻¹`, on the two-term Čech complex
(`twoTrivIso`). Blueprint `sm-curves-fields-ample-positive.tex`, `lem:sm-ample-positive-rr`.
-/

universe u

open CategoryTheory Opposite AlgebraicGeometry TopologicalSpace Module
open DeJongAlterations.StableModification.Cohomology
open DeJongAlterations.StableModification.Projectivity

namespace DeJongAlterations.StableModification.CurvesField.Positive

noncomputable section

open Ample Ample.LineBundleData Projectivity.LineBundleData

/-! ### Mixed twists `a^k f^l` -/

section MixedTwist

variable {Y : Scheme.{u}} (F : Y.Modules) (U V : Y.Opens) {K : Type u} [Field K]
  (c : K →+* Γ(Y, ⊤)) {a f : Γ(Y, V)}
  (ha : IsUnit (Y.presheaf.map (homOfLE (inf_le_right : U ⊓ V ≤ V)).op a))
  (hf : IsUnit (Y.presheaf.map (homOfLE (inf_le_right : U ⊓ V ≤ V)).op f))

/-- Multiplication by `f^l a^k` on `Γ(U ∩ V, F)`. -/
abbrev mixedTwist (k l : ℤ) :
    sectionsModuleCat F c (U ⊓ V) le_top →ₗ[K] sectionsModuleCat F c (U ⊓ V) le_top :=
  smulLin F c (((hf.unit ^ l * ha.unit ^ k : Γ(Y, U ⊓ V)ˣ)) : Γ(Y, U ⊓ V))

lemma mixedTwist_succ (k l : ℤ) :
    mixedTwist F U V c ha hf k (l + 1) =
      (fEquiv F U V c hf).toLinearMap ∘ₗ mixedTwist F U V c ha hf k l := by
  apply LinearMap.ext
  intro s
  exact (fun x : Γ(F, U ⊓ V) =>
    show (((hf.unit ^ (l + 1) * ha.unit ^ k : Γ(Y, U ⊓ V)ˣ)) : Γ(Y, U ⊓ V)) • x =
      (hf.unit : Γ(Y, U ⊓ V)) •
        ((((hf.unit ^ l * ha.unit ^ k : Γ(Y, U ⊓ V)ˣ)) : Γ(Y, U ⊓ V)) • x) by
    rw [smul_smul, zpow_add_one, ← Units.val_mul]
    congr 2
    group) s

lemma mixedTwist_zero (k : ℤ) :
    mixedTwist F U V c ha hf k 0 = twistFamily F U V c ha k := by
  simp only [mixedTwist, twistFamily, zpow_zero, one_mul]

variable [FiniteDimensional K (H0 (resUV F U V c) (resVU F U V c) (twistFamily F U V c ha 0))]
  [FiniteDimensional K (H1 (resUV F U V c) (resVU F U V c) (twistFamily F U V c ha 0))]
  [FiniteDimensional K (sectionsModuleCat F c V le_top ⧸ LinearMap.range (fMul F V c a))]
  [FiniteDimensional K (sectionsModuleCat F c V le_top ⧸ LinearMap.range (fMul F V c f))]

/-- **Weak Riemann–Roch for the twists by `a^k f^l`**:
`χ(a^k f^l) = χ(𝒪) + k · dim (MV / a) + l · dim (MV / f)`. -/
theorem euler_mixedTwist (hainj : Function.Injective (fMul F V c a))
    (hfinj : Function.Injective (fMul F V c f)) (k l : ℤ) :
    euler (resUV F U V c) (resVU F U V c) (mixedTwist F U V c ha hf k l) =
      euler (resUV F U V c) (resVU F U V c) (twistFamily F U V c ha 0) +
        k * finrank K (sectionsModuleCat F c V le_top ⧸ LinearMap.range (fMul F V c a)) +
        l * finrank K (sectionsModuleCat F c V le_top ⧸ LinearMap.range (fMul F V c f)) := by
  obtain ⟨h0, h1⟩ := finiteDimensional_family (resUV F U V c) (resVU F U V c)
    (fEquiv F U V c ha) (fMul F V c a) (resVU_fMul F U V c ha) hainj
    (twistFamily F U V c ha) (twistFamily_succ F U V c ha) k
  have h0' : FiniteDimensional K
      (H0 (resUV F U V c) (resVU F U V c) (mixedTwist F U V c ha hf k 0)) := by
    rw [mixedTwist_zero]; exact h0
  have h1' : FiniteDimensional K
      (H1 (resUV F U V c) (resVU F U V c) (mixedTwist F U V c ha hf k 0)) := by
    rw [mixedTwist_zero]; exact h1
  have e₁ := euler_family (resUV F U V c) (resVU F U V c) (fEquiv F U V c hf) (fMul F V c f)
    (resVU_fMul F U V c hf) hfinj (mixedTwist F U V c ha hf k) (mixedTwist_succ F U V c ha hf k) l
  have e₂ := euler_family (resUV F U V c) (resVU F U V c) (fEquiv F U V c ha) (fMul F V c a)
    (resVU_fMul F U V c ha) hainj (twistFamily F U V c ha) (twistFamily_succ F U V c ha) k
  rw [e₁, mixedTwist_zero, e₂]

end MixedTwist

/-! ### Two-chart presentations -/

variable {X : Scheme.{u}}

/-- A **two-chart presentation** of line-bundle data `𝓛`: affine opens `U`, `V` covering `X` with
`U ∩ V = D(f)` in `V`, and generators `τ` of `𝓛` on `U` and `σ` of `𝓛` on `V`. -/
structure Presentation (L : Projectivity.LineBundleData X) where
  /-- The first chart. -/
  U : X.Opens
  /-- The second chart. -/
  V : X.Opens
  isAffineOpen_U : IsAffineOpen U
  isAffineOpen_V : IsAffineOpen V
  sup_eq : U ⊔ V = ⊤
  /-- The equation of `V ∖ U` in `V`. -/
  f : Γ(X, V)
  basicOpen_f : X.basicOpen f = U ⊓ V
  /-- A generator of `𝓛` on `U`. -/
  τ : L.Sections 1 U
  nonvanishingLocus_τ : τ.nonvanishingLocus = U
  /-- A generator of `𝓛` on `V`. -/
  σ : L.Sections 1 V
  nonvanishingLocus_σ : σ.nonvanishingLocus = V

namespace Presentation

variable {L : Projectivity.LineBundleData X} (P : Presentation L)

lemma isAffineOpen_inf : IsAffineOpen (P.U ⊓ P.V) :=
  P.basicOpen_f ▸ P.isAffineOpen_V.basicOpen P.f

/-- The transition function `g = τ / σ`, a unit on `U ∩ V`. -/
def g : Γ(X, P.U ⊓ P.V)ˣ := transUnit P.nonvanishingLocus_σ P.nonvanishingLocus_τ

/-- The restriction of a function on `V` to `U ∩ V`. -/
abbrev resV (b : Γ(X, P.V)) : Γ(X, P.U ⊓ P.V) :=
  X.presheaf.map (homOfLE (inf_le_right : P.U ⊓ P.V ≤ P.V)).op b

lemma isUnit_resV_f : IsUnit (P.resV P.f) := by
  apply isUnit_of_basicOpen_eq
  rw [Scheme.basicOpen_res, P.basicOpen_f]
  exact inf_eq_left.mpr le_rfl

/-- `g = a / f^j` for some `a ∈ Γ(V, 𝒪)`: every function on `U ∩ V = D(f)` is a fraction. -/
lemma exists_numerator : ∃ (a : Γ(X, P.V)) (j : ℕ), P.resV a = (P.g : Γ(X, P.U ⊓ P.V)) *
    P.resV P.f ^ j := by
  obtain ⟨n, x, hx⟩ := exists_pow_smul_eq_res (unitModule X) P.U P.V P.isAffineOpen_V
    P.basicOpen_f.symm (show Γ(unitModule X, P.U ⊓ P.V) from (P.g : Γ(X, P.U ⊓ P.V)))
  refine ⟨x, n, ?_⟩
  have hx' : P.resV (P.f ^ n) * (P.g : Γ(X, P.U ⊓ P.V)) = P.resV x := hx
  rw [← hx', mul_comm]
  congr 1
  exact map_pow _ _ _

lemma isUnit_resV_of_numerator {a : Γ(X, P.V)} {j : ℕ}
    (h : P.resV a = (P.g : Γ(X, P.U ⊓ P.V)) * P.resV P.f ^ j) : IsUnit (P.resV a) := by
  rw [h]
  exact (Units.isUnit _).mul (P.isUnit_resV_f.pow j)

lemma g_zpow_eq {a : Γ(X, P.V)} {j : ℕ}
    (h : P.resV a = (P.g : Γ(X, P.U ⊓ P.V)) * P.resV P.f ^ j) (k : ℕ) :
    ((P.g ^ (k : ℤ) : Γ(X, P.U ⊓ P.V)ˣ) : Γ(X, P.U ⊓ P.V)) =
      (((P.isUnit_resV_f.unit ^ (-((j : ℤ) * k)) *
        (P.isUnit_resV_of_numerator h).unit ^ (k : ℤ) : Γ(X, P.U ⊓ P.V)ˣ)) :
          Γ(X, P.U ⊓ P.V)) := by
  have hu : (P.isUnit_resV_of_numerator h).unit = P.g * P.isUnit_resV_f.unit ^ j := by
    apply Units.ext
    rw [IsUnit.unit_spec, Units.val_mul, Units.val_pow_eq_pow_val, IsUnit.unit_spec, h]
  rw [hu]
  congr 1
  rw [mul_zpow, ← zpow_natCast P.isUnit_resV_f.unit j, ← zpow_mul, mul_left_comm, ← zpow_add,
    neg_add_cancel, zpow_zero, mul_one]

section Cohomology

variable [CompactSpace X] [IsAffineHom (Limits.pullback.diagonal (Limits.terminal.from X))]
  {K : Type u} [Field K] (c : K →+* Γ(X, ⊤))

/-- `F ⊗ 𝓛^k` is the twist of `F` along the presentation by `g^k`. -/
def twistIso (F : X.Modules) (k : ℕ) : L.twist F k ≅ twist F P.U P.V (P.g ^ (k : ℤ)) :=
  L.twistCongr F (by ring) ≪≫ twoTrivIso P.nonvanishingLocus_σ P.nonvanishingLocus_τ F k P.sup_eq

/-- `H⁰(X, 𝓛^k)` as the kernel of the twisted differential. -/
def cohomologyZeroEquiv (k : ℕ) :
    cohomology (L.twist (unitModule X) k) c 0 ≃ₗ[K]
      H0 (resUV (unitModule X) P.U P.V c) (resVU (unitModule X) P.U P.V c)
        (smulLin (unitModule X) c ((P.g ^ (k : ℤ) : Γ(X, P.U ⊓ P.V)ˣ) : Γ(X, P.U ⊓ P.V))) :=
  (cohomologyIsoOfIso (P.twistIso (unitModule X) k) c 0).toLinearEquiv.trans
    (cohomologyTwistZeroEquiv (unitModule X) P.U P.V _ c P.sup_eq P.isAffineOpen_U
      P.isAffineOpen_V P.isAffineOpen_inf)

/-- `H¹(X, 𝓛^k)` as the cokernel of the twisted differential. -/
def cohomologyOneEquiv (k : ℕ) :
    cohomology (L.twist (unitModule X) k) c 1 ≃ₗ[K]
      H1 (resUV (unitModule X) P.U P.V c) (resVU (unitModule X) P.U P.V c)
        (smulLin (unitModule X) c ((P.g ^ (k : ℤ) : Γ(X, P.U ⊓ P.V)ˣ) : Γ(X, P.U ⊓ P.V))) :=
  (cohomologyIsoOfIso (P.twistIso (unitModule X) k) c 1).toLinearEquiv.trans
    (cohomologyTwistOneEquiv (unitModule X) P.U P.V _ c P.sup_eq P.isAffineOpen_U
      P.isAffineOpen_V P.isAffineOpen_inf)

variable [FiniteDimensional K (cohomology (unitModule X) c 0)]
  [FiniteDimensional K (cohomology (unitModule X) c 1)]

/-- **Riemann–Roch for a presented line bundle**: if `g = a / f^j` with `a`, `f` non-zero-divisors
with finite-dimensional quotients, then
`χ(𝓛^k) = χ(𝒪) + k · (dim Γ(V)/(a) - j · dim Γ(V)/(f))`. -/
theorem eulerCharOf_twist {a : Γ(X, P.V)} {j : ℕ}
    (h : P.resV a = (P.g : Γ(X, P.U ⊓ P.V)) * P.resV P.f ^ j)
    [FiniteDimensional K
      (sectionsModuleCat (unitModule X) c P.V le_top ⧸ LinearMap.range (fMul (unitModule X) P.V c a))]
    [FiniteDimensional K
      (sectionsModuleCat (unitModule X) c P.V le_top ⧸
        LinearMap.range (fMul (unitModule X) P.V c P.f))]
    (hainj : Function.Injective (fMul (unitModule X) P.V c a))
    (hfinj : Function.Injective (fMul (unitModule X) P.V c P.f)) (k : ℕ) :
    DualityScheme.eulerCharOf (L.twist (unitModule X) k) c =
      DualityScheme.eulerCharOf (unitModule X) c +
        k * ((finrank K (sectionsModuleCat (unitModule X) c P.V le_top ⧸
          LinearMap.range (fMul (unitModule X) P.V c a)) : ℤ) -
          j * finrank K (sectionsModuleCat (unitModule X) c P.V le_top ⧸
            LinearMap.range (fMul (unitModule X) P.V c P.f))) := by
  have ha := P.isUnit_resV_of_numerator h
  have hf := P.isUnit_resV_f
  have h0 : FiniteDimensional K (H0 (resUV (unitModule X) P.U P.V c)
      (resVU (unitModule X) P.U P.V c) (twistFamily (unitModule X) P.U P.V c ha 0)) :=
    Module.Finite.equiv (cohomologyZeroEquivTwistZero (unitModule X) P.U P.V c ha P.sup_eq
      P.isAffineOpen_U P.isAffineOpen_V P.isAffineOpen_inf)
  have h1 : FiniteDimensional K (H1 (resUV (unitModule X) P.U P.V c)
      (resVU (unitModule X) P.U P.V c) (twistFamily (unitModule X) P.U P.V c ha 0)) :=
    Module.Finite.equiv (cohomologyOneEquivTwistZero (unitModule X) P.U P.V c ha P.sup_eq
      P.isAffineOpen_U P.isAffineOpen_V P.isAffineOpen_inf)
  have key := euler_mixedTwist (unitModule X) P.U P.V c ha hf hainj hfinj k (-((j : ℤ) * k))
  have hg : smulLin (unitModule X) c ((P.g ^ (k : ℤ) : Γ(X, P.U ⊓ P.V)ˣ) : Γ(X, P.U ⊓ P.V)) =
      mixedTwist (unitModule X) P.U P.V c ha hf k (-((j : ℤ) * k)) := by
    rw [P.g_zpow_eq h k]
  rw [DualityScheme.eulerCharOf_eq_of_pair _ c P.sup_eq P.isAffineOpen_U P.isAffineOpen_V
      P.isAffineOpen_inf,
    DualityScheme.eulerCharOf_eq_of_pair _ c P.sup_eq P.isAffineOpen_U P.isAffineOpen_V
      P.isAffineOpen_inf,
    LinearEquiv.finrank_eq (P.cohomologyZeroEquiv c k), LinearEquiv.finrank_eq
      (P.cohomologyOneEquiv c k),
    LinearEquiv.finrank_eq (cohomologyZeroEquivTwistZero (unitModule X) P.U P.V c ha P.sup_eq
      P.isAffineOpen_U P.isAffineOpen_V P.isAffineOpen_inf),
    LinearEquiv.finrank_eq (cohomologyOneEquivTwistZero (unitModule X) P.U P.V c ha P.sup_eq
      P.isAffineOpen_U P.isAffineOpen_V P.isAffineOpen_inf), hg]
  unfold euler at key
  rw [key]
  ring

/-- **Riemann–Roch, `χ(𝓛^k) = χ(𝒪) + k · deg 𝓛`**, with `deg 𝓛 = χ(𝓛) - χ(𝒪)`. -/
theorem eulerCharOf_twist_eq {a : Γ(X, P.V)} {j : ℕ}
    (h : P.resV a = (P.g : Γ(X, P.U ⊓ P.V)) * P.resV P.f ^ j)
    [FiniteDimensional K
      (sectionsModuleCat (unitModule X) c P.V le_top ⧸ LinearMap.range (fMul (unitModule X) P.V c a))]
    [FiniteDimensional K
      (sectionsModuleCat (unitModule X) c P.V le_top ⧸
        LinearMap.range (fMul (unitModule X) P.V c P.f))]
    (hainj : Function.Injective (fMul (unitModule X) P.V c a))
    (hfinj : Function.Injective (fMul (unitModule X) P.V c P.f)) (k : ℕ) :
    DualityScheme.eulerCharOf (L.twist (unitModule X) k) c =
      DualityScheme.eulerCharOf (unitModule X) c +
        k * (DualityScheme.eulerCharOf (L.twist (unitModule X) 1) c -
          DualityScheme.eulerCharOf (unitModule X) c) := by
  have e1 := P.eulerCharOf_twist c h hainj hfinj 1
  have ek := P.eulerCharOf_twist c h hainj hfinj k
  push_cast at e1
  rw [ek, e1]
  ring

end Cohomology

end Presentation

end

end DeJongAlterations.StableModification.CurvesField.Positive
