/-!
# Projective curves have separable chart pairs

Let `k` be algebraically closed and `X` an integral projective `k`-scheme of dimension one (with a
point other than its generic point). Then `X` has a separable chart pair
(`exists_isSeparable_chartPair`, blueprint `prop:sm-separable-charts-exist`): in suitable linear
coordinates `x₀, …, xₙ` of the ambient `ℙⁿ`, two coordinate charts `U_a = X ∩ D₊(x_a)`,
`U_b = X ∩ D₊(x_b)` cover `X` and `t = x_b / x_a` is a separating transcendental element of
`K(X)/k`.

## The construction

* A linear form `l₀` not vanishing at the generic point `η`; the closed set `Z = X ∖ D₊(l₀)` is
  finite (`X` is a Noetherian space of dimension at most one, COH3A's `finite_inter_of_disjoint`).
* A basis `l₀, l₁, …, lₙ` of linear forms such that every `l_j`, `j ≠ 0`, is nonzero at `η` and at
  every point of `Z` (`exists_isUnit_matrix_avoiding`: a vector space over an infinite field is
  not a finite union of proper subspaces, so the vectors avoiding finitely many proper subspaces
  span, and `l₀` extends to a basis of such vectors).
* The linear automorphism of `ℙⁿ` with `x_j ↦ l_j` (Codex's `linearAutomorphism`) gives new
  coordinates whose charts are `U_j = X ∩ D₊(l_j)` with ratios `l_m / l_j` (COH2's
  `ProjectiveCoordinates.ofClosedImmersion`). Then `U_a ∪ U_j = X` for every `j ≠ a`, where `a` is
  the index of `l₀`.
* `Γ(U_a)` is generated by the ratios `l_m / l_a`, and `Ω_{K/k} ≠ 0` (`K ≠ k` as `X` is not a
  point), so some `d(l_b / l_a) ≠ 0`; then `t = l_b / l_a` is transcendental and, `K` being
  algebraic over `k(t)` (`isIntegral_eval₂_of_universallyClosed`), `K/k(t)` is separable by
  `isSeparable_of_D_ne_zero`.

Reference: M. Temkin, *Stable modification of relative curves*, J. Algebraic Geom. 19 (2010),
`references/temkin10-stable-modification/source/semi-stable.tex`, Thm 1.1, lines 1717–1741 (the
degree of `ω`); the classical construction is Hartshorne, *Algebraic Geometry*, II.6.7, IV.2.
Blueprint: `sm-omega-degree-scheme.tex`, `lem:sm-linear-chart-generators`,
`prop:sm-separable-charts-exist`.
-/

universe u

open CategoryTheory Opposite AlgebraicGeometry TopologicalSpace Module
open DeJongAlterations.StableModification.Cohomology DeJongAlterations.StableModification.Omega

namespace DeJongAlterations.StableModification.CurvesField.DualityScheme

noncomputable section

/-! ### Avoiding finitely many proper subspaces with a basis -/

section LinearAlgebra

variable {k : Type u} [Field k] [Infinite k] {V : Type u} [AddCommGroup V] [Module k V]

/-- Over an infinite field, the vectors avoiding finitely many proper subspaces span. -/
lemma span_avoiding_eq_top (s : Finset (Submodule k V)) (hs : ⊤ ∉ s) :
    Submodule.span k {v : V | ∀ H ∈ s, v ∉ H} = ⊤ := by
  classical
  by_contra hW
  apply Subspace.biUnion_ne_univ_of_top_notMem (s := insert (Submodule.span k
    {v : V | ∀ H ∈ s, v ∉ H}) s)
  · rw [Finset.mem_insert, not_or]
    exact ⟨fun h => hW h.symm, hs⟩
  · refine Set.eq_univ_of_forall fun v => ?_
    by_cases hv : ∀ H ∈ s, v ∉ H
    · exact Set.mem_biUnion (Finset.mem_insert_self _ _) (Submodule.subset_span hv)
    · push Not at hv
      obtain ⟨H, hH, hvH⟩ := hv
      exact Set.mem_biUnion (Finset.mem_insert_of_mem hH) hvH

variable {n : ℕ}

/-- **A basis through a given vector avoiding finitely many proper subspaces**: for `c₀ ≠ 0` in
`kⁿ⁺¹` (`k` infinite) and finitely many proper subspaces, there is an invertible matrix `M` with a
row `M a = c₀` whose other rows avoid all the subspaces. -/
theorem exists_isUnit_matrix_avoiding (c₀ : Fin (n + 1) → k) (hc₀ : c₀ ≠ 0)
    (s : Finset (Submodule k (Fin (n + 1) → k))) (hs : ⊤ ∉ s) :
    ∃ (M : Matrix (Fin (n + 1)) (Fin (n + 1)) k) (a : Fin (n + 1)), IsUnit M ∧ M a = c₀ ∧
      ∀ j ≠ a, ∀ H ∈ s, M j ∉ H := by
  classical
  set A := {v : Fin (n + 1) → k | ∀ H ∈ s, v ∉ H}
  have hA := span_avoiding_eq_top s hs
  have hind : LinearIndepOn k id ({c₀} : Set (Fin (n + 1) → k)) :=
    LinearIndepOn.singleton hc₀
  obtain ⟨b, hbt, hsb, htb, hb⟩ := exists_linearIndepOn_id_extension hind
    (Set.singleton_subset_iff.mpr (Set.mem_insert c₀ A))
  have hspan : Submodule.span k b = ⊤ := by
    refine eq_top_iff.mpr ?_
    rw [← hA]
    exact Submodule.span_le.mpr fun v hv => htb (Set.mem_insert_of_mem _ hv)
  have hfin : b.Finite := hb.finite
  let := hfin.fintype
  let B : Basis b k (Fin (n + 1) → k) := Basis.mk hb.linearIndependent (by
    have : (Set.range fun x : b => id (x : Fin (n + 1) → k)) = b := by
      simp only [id, Subtype.range_coe]
    rw [this]; exact hspan.ge)
  have hcard : Fintype.card b = n + 1 := by
    rw [← Module.finrank_eq_card_basis B, Module.finrank_fin_fun]
  let σ : Fin (n + 1) ≃ b := (Fintype.equivFinOfCardEq hcard).symm
  refine ⟨Matrix.of fun j => (σ j : Fin (n + 1) → k), σ.symm ⟨c₀, hsb rfl⟩, ?_, ?_, ?_⟩
  · rw [← Matrix.linearIndependent_rows_iff_isUnit]
    exact hb.linearIndependent.comp σ σ.injective
  · change ((σ (σ.symm ⟨c₀, hsb rfl⟩) : b) : Fin (n + 1) → k) = c₀
    rw [Equiv.apply_symm_apply]
  · intro j hj H hH
    have hne : (σ j : Fin (n + 1) → k) ≠ c₀ := by
      intro h
      apply hj
      rw [Equiv.eq_symm_apply]
      exact Subtype.ext h
    have hmem := hbt (σ j).2
    rcases hmem with h | h
    · exact absurd h hne
    · exact h H hH

end LinearAlgebra

/-! ### Linear forms and points of projective space -/

section LinearForms

attribute [local instance] MvPolynomial.gradedAlgebra

open MvPolynomial Geometry.ProjectiveIdeal Geometry.FiniteProjective
  Geometry.ProjectiveLinearCoordinates Algebra.ProjectiveLinearCoordinates

variable {k : Type u} [Field k] {n : ℕ}

/-- The linear form `∑ⱼ cⱼ xⱼ` with coefficient vector `c`. -/
def linForm (c : Fin (n + 1) → k) : MvPolynomial (Fin (n + 1)) k := ∑ j, C (c j) * X j

/-- `c ↦ ∑ⱼ cⱼ xⱼ` as a `k`-linear map. -/
def linFormₗ : (Fin (n + 1) → k) →ₗ[k] MvPolynomial (Fin (n + 1)) k where
  toFun := linForm
  map_add' c d := by
    simp only [linForm, Pi.add_apply, map_add, add_mul, Finset.sum_add_distrib]
  map_smul' a c := by
    simp only [linForm, Pi.smul_apply, smul_eq_mul, map_mul, RingHom.id_apply, Finset.smul_sum,
      MvPolynomial.smul_eq_C_mul, mul_assoc]

lemma linForm_single (j : Fin (n + 1)) : linForm (Pi.single j (1 : k)) = X j := by
  rw [linForm, Finset.sum_eq_single j]
  · simp
  · intro m _ hm
    simp [hm]
  · simp

/-- The coefficient vectors of the linear forms vanishing at a point `y` of `ℙⁿ`: a proper
subspace (`pointSubspace_ne_top`). -/
def pointSubspace (y : Proj (projectiveSpaceGrading k n)) : Submodule k (Fin (n + 1) → k) :=
  (y.asHomogeneousIdeal.toIdeal.restrictScalars k).comap linFormₗ

lemma mem_pointSubspace_iff (y : Proj (projectiveSpaceGrading k n)) (c : Fin (n + 1) → k) :
    c ∈ pointSubspace y ↔ linForm c ∈ y.asHomogeneousIdeal :=
  Iff.rfl

lemma pointSubspace_ne_top (y : Proj (projectiveSpaceGrading k n)) : pointSubspace y ≠ ⊤ := by
  obtain ⟨j, hj⟩ := Cohomology.exists_X_notMem_asHomogeneousIdeal y
  intro h
  have : Pi.single j (1 : k) ∈ pointSubspace y := h ▸ Submodule.mem_top
  rw [mem_pointSubspace_iff, linForm_single] at this
  exact hj this

/-- The polynomial substitution of the linear automorphism of a matrix sends `x_j` to the linear
form of the `j`-th row. -/
lemma linearPolynomialEquiv_X (M : Matrix (Fin (n + 1)) (Fin (n + 1)) k) (h : Invertible M)
    (j : Fin (n + 1)) :
    linearPolynomialEquiv k (M.toLinearEquiv' h) (X j) = linForm (M j) := by
  change aeval (matrixForm k (LinearMap.toMatrix' (M.toLinearEquiv' h).toLinearMap)) (X j) = _
  rw [aeval_X]
  have : LinearMap.toMatrix' (M.toLinearEquiv' h).toLinearMap = M :=
    LinearMap.toMatrix'_toLin' M
  rw [this]
  rfl

/-- **The charts of the transformed embedding**: for a closed immersion `i` and an invertible
matrix `M`, the `j`-th coordinate chart of `i` followed by the linear automorphism of `M` is
`i⁻¹ D₊(∑ₘ M_{jm} xₘ)`. -/
lemma mem_chartOpen_linearAutomorphism_iff {X : Scheme.{u}} (i : X ⟶ projectiveSpace k n)
    (M : Matrix (Fin (n + 1)) (Fin (n + 1)) k) (h : Invertible M) (j : Fin (n + 1)) (x : X) :
    x ∈ chartOpen (i ≫ (linearAutomorphism k n (M.toLinearEquiv' h)).hom) j ↔
      linForm (M j) ∉ (i x).asHomogeneousIdeal := by
  have h1 := linearAutomorphism_preimage_basicOpen k n (M.toLinearEquiv' h) (MvPolynomial.X j)
  rw [linearPolynomialEquiv_X] at h1
  show i x ∈ (linearAutomorphism k n (M.toLinearEquiv' h)).hom ⁻¹ᵁ
    Proj.basicOpen (ProjectiveGrading k n) (MvPolynomial.X j) ↔ _
  rw [h1]
  rfl

end LinearForms

/-! ### The function field of a curve which is not a point -/

section FunctionField

variable {X : Scheme.{u}} [IsIntegral X]

/-- If the ring of an affine open is a field, the open is the generic point. -/
lemma eq_genericPoint_of_isField {V : X.Opens} (hV : IsAffineOpen V) [Nonempty V]
    (hfield : IsField Γ(X, V)) {x : X} (hx : x ∈ V) : x = genericPoint X := by
  have hη : genericPoint X ∈ V :=
    ((genericPoint_spec X).mem_open_set_iff V.isOpen).mpr (by simpa using ‹Nonempty V›)
  let := hfield.toField
  have hp : ∀ p : PrimeSpectrum Γ(X, V), p.asIdeal = ⊥ := fun p =>
    (Ideal.eq_bot_or_top p.asIdeal).resolve_right p.isPrime.ne_top
  have e : hV.primeIdealOf ⟨x, hx⟩ = hV.primeIdealOf ⟨genericPoint X, hη⟩ :=
    PrimeSpectrum.ext ((hp _).trans (hp _).symm)
  have h1 := hV.fromSpec_primeIdealOf ⟨x, hx⟩
  have h2 := hV.fromSpec_primeIdealOf ⟨genericPoint X, hη⟩
  rw [e] at h1
  exact h1.symm.trans h2

variable {k : Type u} [Field k] (f : X ⟶ Spec (CommRingCat.of k))

/-- The constants `k → K(X)`. -/
abbrev constField [Nonempty (⊤ : X.Opens)] : k →+* X.functionField :=
  (X.germToFunctionField ⊤).hom.comp (structureCoeff f)

/-- If every element of the function field is a constant, `X` is a point. -/
lemma eq_genericPoint_of_forall_mem_range [Nonempty (⊤ : X.Opens)]
    (h : ∀ y : X.functionField, y ∈ Set.range (constField f)) (x : X) :
    x = genericPoint X := by
  obtain ⟨_, ⟨V, hV, rfl⟩, hxV, -⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ x) isOpen_univ
  have : Nonempty V := ⟨⟨x, hxV⟩⟩
  have hbij : Function.Bijective (X.germToFunctionField V) := by
    refine ⟨X.germToFunctionField_injective V, fun y => ?_⟩
    obtain ⟨c, rfl⟩ := h y
    exact ⟨sectionsRingHom (structureCoeff f) (le_top : V ≤ ⊤) c,
      germToFunctionField_sectionsRingHom _ c⟩
  have hfield : IsField Γ(X, V) := MulEquiv.isField (Field.toIsField X.functionField)
    (RingEquiv.ofBijective (X.germToFunctionField V).hom hbij).toMulEquiv
  exact eq_genericPoint_of_isField hV hfield hxV

end FunctionField

/-! ### A generator with a nonzero differential -/

section Differentials

open KaehlerDifferential

variable {X : Scheme.{u}} [IsIntegral X] {k : Type u} [Field k] (f : X ⟶ Spec (CommRingCat.of k))
  [Nonempty (⊤ : X.Opens)]

/-- `K(X)` is essentially of finite type over `k`. -/
lemma essFiniteType_functionField [LocallyOfFiniteType f] {U : X.Opens} (hU : IsAffineOpen U)
    [Nonempty U] :
    letI := (constField f).toAlgebra
    Algebra.EssFiniteType k X.functionField := by
  let := (constField f).toAlgebra
  let iU : Algebra k Γ(X, U) := (sectionsRingHom (structureCoeff f) (le_top : U ≤ ⊤)).toAlgebra
  have : Algebra.FiniteType k Γ(X, U) := finiteType_sectionsRingHom f hU
  have : IsFractionRing Γ(X, U) X.functionField :=
    functionField_isFractionRing_of_isAffineOpen X U hU
  have : IsScalarTower k Γ(X, U) X.functionField :=
    IsScalarTower.of_algebraMap_eq fun r => (germToFunctionField_sectionsRingHom _ r).symm
  have : Algebra.EssFiniteType Γ(X, U) X.functionField :=
    Algebra.EssFiniteType.of_isLocalization _ (nonZeroDivisors Γ(X, U))
  exact Algebra.EssFiniteType.comp k Γ(X, U) X.functionField

/-- **Some generator has a nonzero differential**: if `Γ(U)` (`U` affine) is generated over `k`
by the `r m` and `X` is not a point, then some `d(r m) ≠ 0` in `Ω_{K(X)/k}` (otherwise `d`
vanishes on `K(X)`, which is then formally unramified, hence algebraic over `k = k̄`, hence `k`). -/
lemma exists_D_ne_zero [IsAlgClosed k] [LocallyOfFiniteType f] {U : X.Opens}
    (hU : IsAffineOpen U) [Nonempty U] {ι : Type*} (r : ι → Γ(X, U))
    (hgen : Function.Surjective
      (MvPolynomial.eval₂Hom (sectionsRingHom (structureCoeff f) (le_top : U ≤ ⊤)) r))
    (hpt : ∃ x : X, x ≠ genericPoint X) :
    letI := (constField f).toAlgebra
    ∃ m, D k X.functionField (X.germToFunctionField U (r m)) ≠ 0 := by
  let := (constField f).toAlgebra
  by_contra h
  push Not at h
  set M := derivationPreimage k (⊥ : Submodule X.functionField Ω[X.functionField⁄k])
  have hr : ∀ m, X.germToFunctionField U (r m) ∈ M := fun m =>
    (Submodule.mem_bot X.functionField).mpr (h m)
  have hc : (X.germToFunctionField U).hom.comp (sectionsRingHom (structureCoeff f)
      (le_top : U ≤ ⊤)) = algebraMap k X.functionField :=
    RingHom.ext fun c => germToFunctionField_sectionsRingHom _ c
  have hA : ∀ a : Γ(X, U), X.germToFunctionField U a ∈ M := by
    intro a
    obtain ⟨P, rfl⟩ := hgen a
    rw [MvPolynomial.coe_eval₂Hom, MvPolynomial.hom_eval₂, hc]
    have hle : Algebra.adjoin k (Set.range fun m => X.germToFunctionField U (r m)) ≤
        M.toSubalgebra := Algebra.adjoin_le (by rintro _ ⟨m, rfl⟩; exact hr m)
    apply hle
    rw [← MvPolynomial.aeval_range]
    exact ⟨P, rfl⟩
  have : IsFractionRing Γ(X, U) X.functionField :=
    functionField_isFractionRing_of_isAffineOpen X U hU
  have hK : ∀ y : X.functionField, D k X.functionField y = 0 := by
    intro y
    obtain ⟨a, b, -, rfl⟩ := IsFractionRing.div_surjective (A := Γ(X, U)) y
    exact (Submodule.mem_bot X.functionField).mp (M.div_mem (hA a) (hA b))
  have hsub : Subsingleton Ω[X.functionField⁄k] := by
    refine subsingleton_of_forall_eq 0 fun ω => ?_
    have hω : ω ∈ Submodule.span X.functionField (Set.range (D k X.functionField)) := by
      rw [span_range_derivation]; trivial
    induction hω using Submodule.span_induction with
    | mem z hz =>
      obtain ⟨y, rfl⟩ := hz
      exact hK y
    | zero => rfl
    | add _ _ _ _ h1 h2 => rw [h1, h2, add_zero]
    | smul a z _ h1 => rw [h1, smul_zero]
  have : Algebra.FormallyUnramified k X.functionField := ⟨hsub⟩
  have := essFiniteType_functionField f hU
  have : Algebra.IsSeparable k X.functionField :=
    (Algebra.FormallyUnramified.iff_isSeparable k X.functionField).mp inferInstance
  have hbij := IsAlgClosed.algebraMap_bijective_of_isIntegral (k := k) (K := X.functionField)
  obtain ⟨x, hx⟩ := hpt
  exact hx (eq_genericPoint_of_forall_mem_range f (fun y => hbij.2 y) x)

end Differentials

/-! ### Finiteness of the complement of a chart -/

section Finite

variable {X : Scheme.{u}} [IsIntegral X] {k : Type u} [Field k]
  (f : X ⟶ Spec (CommRingCat.of k))

omit [IsIntegral X] in
/-- A space of topological dimension at most one has no chains `x ⤳ y ⤳ z` of three distinct
points. -/
lemma eq_or_eq_of_topologicalKrullDim_le_one (hdim : topologicalKrullDim X ≤ 1) (x y z : X)
    (hxy : x ⤳ y) (hyz : y ⤳ z) : x = y ∨ y = z := by
  by_contra h
  push Not at h
  have h2 := Cohomology.two_le_krullDim_of_specializes hyz hxy (fun h' => h.2 h'.symm)
    (fun h' => h.1 h'.symm)
  rw [← Order.krullDim_eq_of_orderIso irreducibleSetEquivPoints] at h2
  exact absurd (h2.trans hdim) (by decide)

/-- **The complement of an open containing the generic point of a curve is finite.** -/
lemma finite_compl [LocallyOfFiniteType f] [QuasiCompact f] (hdim : topologicalKrullDim X ≤ 1)
    (W : X.Opens) (hη : genericPoint X ∈ W) : ((W : Set X)ᶜ).Finite := by
  set Z := f ⁻¹' {IsLocalRing.closedPoint k}
  have hZ : IsClosed Z := (IsLocalRing.isClosed_singleton_closedPoint k).preimage f.continuous
  have := Cohomology.noetherianSpace_closedFibre f
  have hpt : ∀ p q : PrimeSpectrum k, p = q := fun p q => PrimeSpectrum.ext
    (((Ideal.eq_bot_or_top _).resolve_right p.isPrime.ne_top).trans
      ((Ideal.eq_bot_or_top _).resolve_right q.isPrime.ne_top).symm)
  have hZuniv : ∀ x : X, x ∈ Z := fun x => hpt (f x) (IsLocalRing.closedPoint k)
  have hfin := Cohomology.finite_inter_of_disjoint hZ
    (fun x _ y z => eq_or_eq_of_topologicalKrullDim_le_one hdim x y z) (G := {genericPoint X})
    (Set.singleton_subset_iff.mpr (hZuniv _))
    (fun z _ => ⟨_, rfl, (genericPoint_spec X).specializes trivial⟩)
    (W := (W : Set X)ᶜ) W.isOpen.isClosed_compl (Set.disjoint_singleton_left.mpr (by simpa using hη))
  exact hfin.subset fun x hx => ⟨hZuniv x, hx⟩

end Finite

/-! ### Existence of separable chart pairs -/

section Existence

attribute [local instance] MvPolynomial.gradedAlgebra

open MvPolynomial Geometry.ProjectiveIdeal Geometry.FiniteProjective
  Geometry.ProjectiveLinearCoordinates KaehlerDifferential

variable {k : Type u} [Field k] [IsAlgClosed k] {X : Scheme.{u}} [IsIntegral X]
  (f : X ⟶ Spec (CommRingCat.of k))

omit [IsAlgClosed k] in
/-- The map `k[T] → K(X)` of a chart pair is evaluation at the germ of `t`. -/
lemma polyToFunctionField_eq [Nonempty (⊤ : X.Opens)] (P : ChartPair X) (p : Polynomial k) :
    P.polyToFunctionField f p =
      Polynomial.eval₂ (constField f) (@Scheme.germToFunctionField X _ P.U₀ P.nonempty₀ P.t) p := by
  have := P.nonempty₀
  change X.germToFunctionField P.U₀ (Polynomial.eval₂ _ _ p) = _
  rw [Polynomial.hom_eval₂]
  congr 1
  exact RingHom.ext fun c => germToFunctionField_sectionsRingHom _ c

/-- **Projective curves have separable chart pairs** (blueprint `prop:sm-separable-charts-exist`):
an integral projective `k`-scheme (`k = k̄`) of dimension at most one which is not a point has a
separable chart pair. -/
theorem exists_isSeparable_chartPair (hp : IsProjectiveOver f) (hdim : topologicalKrullDim X ≤ 1)
    (hpt : ∃ x : X, x ≠ genericPoint X) : ∃ P : ChartPair X, P.IsSeparable f := by
  classical
  have hproper := hp.isProper
  obtain ⟨n, i, hi, hcomp⟩ := hp
  have : Nonempty (⊤ : X.Opens) := ⟨⟨genericPoint X, trivial⟩⟩
  -- a linear form `l₀` not vanishing at the generic point
  obtain ⟨c₀, -, hc₀⟩ := SetLike.exists_of_lt (lt_top_iff_ne_top.mpr
    (pointSubspace_ne_top (i (genericPoint X))))
  have hc₀0 : c₀ ≠ 0 := fun h => hc₀ (h ▸ Submodule.zero_mem _)
  let W₀ : X.Opens := i ⁻¹ᵁ Proj.basicOpen (projectiveSpaceGrading k n) (linForm c₀)
  have hηW₀ : genericPoint X ∈ W₀ := hc₀
  have hZ := finite_compl f hdim W₀ hηW₀
  -- a basis of linear forms through `l₀` avoiding the bad points
  let pts : Finset X := insert (genericPoint X) hZ.toFinset
  let sub : Finset (Submodule k (Fin (n + 1) → k)) := pts.image fun x => pointSubspace (i x)
  have hsub : ⊤ ∉ sub := by
    rw [Finset.mem_image]
    rintro ⟨x, -, hx⟩
    exact pointSubspace_ne_top _ hx
  obtain ⟨M, a, hM, hMa, hMav⟩ := exists_isUnit_matrix_avoiding c₀ hc₀0 sub hsub
  let hinv : Invertible M := hM.invertible
  -- the new embedding
  let i' := i ≫ (linearAutomorphism k n (M.toLinearEquiv' hinv)).hom
  have : IsClosedImmersion i' := inferInstance
  have hcomp' : i' ≫ projectiveSpaceStructure k n = f := by
    rw [Category.assoc, linearAutomorphism_structure, hcomp]
  have hmem := mem_chartOpen_linearAutomorphism_iff i M hinv
  have hcc := Cohomology.closedConstants_eq_structureCoeff i' hcomp'
  let D' := Cohomology.ProjectiveCoordinates.ofClosedImmersion i'
  have hgen : Function.Surjective (MvPolynomial.eval₂Hom (sectionsRingHom (structureCoeff f)
      (le_top : chartOpen i' a ≤ ⊤)) (fun m : ULift.{u} (Fin (n + 1)) => chartRatio i' a m.down)) := by
