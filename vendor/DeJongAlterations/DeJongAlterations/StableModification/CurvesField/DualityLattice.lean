import Mathlib.Algebra.Polynomial.Laurent
import Mathlib.LinearAlgebra.Dual.Lemmas
import Mathlib.LinearAlgebra.Dimension.Constructions
import Mathlib.Data.Int.Interval

/-!
# Serre duality for vector bundles on the projective line, in coordinates

Let `R = k[T, T⁻¹]` and `V = Rⁿ`. A vector bundle `E` of rank `n` on `ℙ¹_k` is described by two
lattices in `V`: the trivial `k[t]`-lattice `Pⁿ = k[t]ⁿ` (`t = T`) and a `k[s]`-lattice `N`
(`s = T⁻¹`), i.e. a `k`-subspace stable under multiplication by `s` with
`sᵐ k[s]ⁿ ⊆ N ⊆ s⁻ᵐ k[s]ⁿ` for some `m`. Its two-term Čech complex is
`Pⁿ × N → V`, `(a, b) ↦ b - a`, so `H⁰(E) = Pⁿ ∩ N` and `H¹(E) = V ⧸ (Pⁿ + N)`.

With the pairing `⟨x, y⟩ = ∑ xᵢ yᵢ ∈ R`, the *Serre dual* `E^∨ ⊗ Ω¹` of `E` is described by
`Pⁿ` and the `k[s]`-lattice
`N' = {y | ⟨x, y⟩ ∈ s² k[s] for all x ∈ N}` (`serreDual`), since `Ω¹_{ℙ¹} = 𝒪(-2)` is generated by
`dt` on `{t ≠ ∞}` and by `ds = -s² dt` on `{s ≠ ∞}`. This file proves Serre duality for these
bundles:
`h⁰(E^∨ ⊗ Ω¹) = h¹(E)` and `h¹(E^∨ ⊗ Ω¹) = h⁰(E)`
(`finrank_inf_serreDual`, `finrank_quot_serreDual`), together with the finiteness of all these
spaces. The proof is elementary: `H⁰(E^∨ ⊗ Ω¹)` is the annihilator of the image of `N` in a
finite band of coefficients under the residue pairing `res ⟨x, y⟩ = ⟨x, y⟩_{-1}`, which is a
perfect pairing between bands of coefficients (`pairing_bijective`, `finrank_annIn_add`), and
`h¹(E^∨ ⊗ Ω¹) = h⁰(E)` follows from the same count on a band containing all of `N` modulo
`sᵐ k[s]ⁿ` (`euler_band`, `serreDual_inf_band_eq`).

This is the duality on `ℙ¹` behind the computation of the degree of the canonical sheaf of a
curve with a finite separable map to `ℙ¹` (Temkin, *Stable modification of relative curves*,
J. Algebraic Geom. 19 (2010), Thm 1.1, `references/temkin10-stable-modification/source/
semi-stable.tex`, lines 1717–1741, which uses `deg ω_X = 2g - 2`). Blueprint:
`sm-omega-degree.tex`, `lem:sm-p1-lattice-duality`.

## Main definitions

* `Duality.band k n a b`: vectors whose coefficients vanish outside `(a, b]`.
* `Duality.lower k n m`: vectors whose coefficients vanish above `m` (the lattice `s⁻ᵐ k[s]ⁿ`).
* `Duality.upper k n m`: vectors whose coefficients vanish below `m` (`upper 0 = k[t]ⁿ`).
* `Duality.IsLattice N`: `N` is stable under `s` and `lower (-m) ≤ N ≤ lower m` for some `m`.
* `Duality.serreDual N`: the lattice of the Serre dual bundle.

## Main results

* `Duality.finrank_inf_serreDual`: `dim (k[t]ⁿ ∩ N') = dim V ⧸ (k[t]ⁿ + N)`.
* `Duality.finrank_quot_serreDual`: `dim V ⧸ (k[t]ⁿ + N') = dim (k[t]ⁿ ∩ N)`.
-/

universe u

open LaurentPolynomial Module

namespace DeJongAlterations.StableModification.CurvesField.Duality

noncomputable section

variable (k : Type u) [Field k] (n : ℕ)

/-- The coordinate space `Rⁿ`, `R = k[T, T⁻¹]`. -/
abbrev Vec : Type u := Fin n → k[T;T⁻¹]

variable {k n}

/-! ### Coefficients of Laurent polynomials -/

lemma coeff_T_mul (j c : ℤ) (f : k[T;T⁻¹]) : (T j * f).coeff c = f.coeff (c - j) := by
  rw [T, AddMonoidAlgebra.coeff_single_mul_apply, one_mul]
  congr 1
  ring

lemma coeff_single (j c : ℤ) (r : k) :
    (AddMonoidAlgebra.single j r : k[T;T⁻¹]).coeff c = if j = c then r else 0 := by
  rw [AddMonoidAlgebra.coeff_single, Finsupp.single_apply]

lemma coeff_smul (r : k) (f : k[T;T⁻¹]) (c : ℤ) : (r • f).coeff c = r * f.coeff c := by
  rw [AddMonoidAlgebra.coeff_smul_apply, smul_eq_mul]

lemma coeff_add (f g : k[T;T⁻¹]) (c : ℤ) : (f + g).coeff c = f.coeff c + g.coeff c := by
  rw [AddMonoidAlgebra.coeff_add, Finsupp.add_apply]

lemma coeff_sum {ι : Type*} (s : Finset ι) (f : ι → k[T;T⁻¹]) (c : ℤ) :
    (∑ i ∈ s, f i).coeff c = ∑ i ∈ s, (f i).coeff c := by
  rw [AddMonoidAlgebra.coeff_sum, Finsupp.finsetSum_apply]

lemma coeff_zero' (c : ℤ) : (0 : k[T;T⁻¹]).coeff c = 0 := rfl

lemma coeff_neg (f : k[T;T⁻¹]) (c : ℤ) : (-f).coeff c = -f.coeff c := by
  rw [show -f = (-1 : k) • f by rw [neg_one_smul], coeff_smul, neg_one_mul]

lemma coeff_sub (f g : k[T;T⁻¹]) (c : ℤ) : (f - g).coeff c = f.coeff c - g.coeff c := by
  rw [sub_eq_add_neg, coeff_add, coeff_neg, ← sub_eq_add_neg]

/-- A Laurent polynomial whose coefficients vanish outside a finite set `S` is the sum of its
monomials over `S`. -/
lemma eq_sum_single (f : k[T;T⁻¹]) (S : Finset ℤ) (hS : ∀ j ∉ S, f.coeff j = 0) :
    f = ∑ j ∈ S, AddMonoidAlgebra.single j (f.coeff j) := by
  ext c
  rw [coeff_sum]
  simp_rw [coeff_single]
  rw [Finset.sum_ite_eq']
  split_ifs with h
  · rfl
  · exact hS c h

lemma single_eq_C_mul_T' (j : ℤ) (r : k) :
    (AddMonoidAlgebra.single j r : k[T;T⁻¹]) = r • T j := by
  ext c
  rw [coeff_smul, coeff_single, T, coeff_single]
  split_ifs <;> simp

/-- The coefficient of a product, when the first factor is supported in a finite set `S`. -/
lemma coeff_mul_eq_sum (f g : k[T;T⁻¹]) (S : Finset ℤ) (hS : ∀ j ∉ S, f.coeff j = 0) (c : ℤ) :
    (f * g).coeff c = ∑ j ∈ S, f.coeff j * g.coeff (c - j) := by
  conv_lhs => rw [eq_sum_single f S hS]
  rw [Finset.sum_mul, coeff_sum]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [single_eq_C_mul_T', smul_mul_assoc, coeff_smul, coeff_T_mul]

/-- The coefficient of a product, when the second factor is supported in a finite set `S`. -/
lemma coeff_mul_eq_sum' (f g : k[T;T⁻¹]) (S : Finset ℤ) (hS : ∀ j ∉ S, g.coeff j = 0) (c : ℤ) :
    (f * g).coeff c = ∑ j ∈ S, f.coeff (c - j) * g.coeff j := by
  rw [mul_comm, coeff_mul_eq_sum g f S hS]
  exact Finset.sum_congr rfl fun j _ => mul_comm _ _

/-- If `f` has no coefficients above `a` and `g` none above `b`, then `f g` has none above
`a + b`. -/
lemma coeff_mul_eq_zero_of_lower {f g : k[T;T⁻¹]} {a b : ℤ} (hf : ∀ j, a < j → f.coeff j = 0)
    (hg : ∀ j, b < j → g.coeff j = 0) {c : ℤ} (hc : a + b < c) : (f * g).coeff c = 0 := by
  rw [coeff_mul_eq_sum f g f.coeff.support (fun j hj => Finsupp.notMem_support_iff.mp hj)]
  refine Finset.sum_eq_zero fun j _ => ?_
  rcases le_or_gt j a with h | h
  · rw [hg (c - j) (by omega), mul_zero]
  · rw [hf j h, zero_mul]

variable (k n)

/-! ### Supported vectors -/

/-- Vectors all of whose coordinates have their coefficients in `S`. -/
def supportedIn (S : Set ℤ) : Submodule k (Vec k n) where
  carrier := {x | ∀ i j, j ∉ S → (x i).coeff j = 0}
  add_mem' {x y} hx hy i j hj := by
    rw [Pi.add_apply, coeff_add, hx i j hj, hy i j hj, add_zero]
  zero_mem' _ _ _ := rfl
  smul_mem' r x hx i j hj := by
    rw [Pi.smul_apply, coeff_smul, hx i j hj, mul_zero]

/-- `band a b`: coefficients in `(a, b]`. -/
abbrev band (a b : ℤ) : Submodule k (Vec k n) := supportedIn k n (Set.Ioc a b)

/-- `lower m = s⁻ᵐ k[s]ⁿ`: coefficients `≤ m`. -/
abbrev lower (m : ℤ) : Submodule k (Vec k n) := supportedIn k n (Set.Iic m)

/-- `upper m = tᵐ k[t]ⁿ`: coefficients `≥ m`; `upper 0 = k[t]ⁿ`. -/
abbrev upper (m : ℤ) : Submodule k (Vec k n) := supportedIn k n (Set.Ici m)

variable {k n}

lemma mem_supportedIn {S : Set ℤ} {x : Vec k n} :
    x ∈ supportedIn k n S ↔ ∀ i j, j ∉ S → (x i).coeff j = 0 := Iff.rfl

lemma supportedIn_mono {S S' : Set ℤ} (h : S ⊆ S') : supportedIn k n S ≤ supportedIn k n S' :=
  fun _ hx i j hj => hx i j fun hjS => hj (h hjS)

lemma mem_inf_supportedIn {S S' : Set ℤ} {x : Vec k n} (hx : x ∈ supportedIn k n S)
    (hx' : x ∈ supportedIn k n S') : x ∈ supportedIn k n (S ∩ S') := by
  intro i j hj
  rw [Set.mem_inter_iff, not_and_or] at hj
  rcases hj with hj | hj
  · exact hx i j hj
  · exact hx' i j hj

/-! ### Truncation -/

open Classical in
/-- Truncation to the coefficients in `S`. -/
def restrict (S : Set ℤ) : Vec k n →ₗ[k] Vec k n where
  toFun x i := AddMonoidAlgebra.ofCoeff (Finsupp.filter (· ∈ S) (x i).coeff)
  map_add' x y := by
    funext i
    apply AddMonoidAlgebra.coeff_injective
    simp only [Pi.add_apply, AddMonoidAlgebra.coeff_add, Finsupp.filter_add]
  map_smul' r x := by
    funext i
    apply AddMonoidAlgebra.coeff_injective
    simp only [Pi.smul_apply, AddMonoidAlgebra.coeff_smul, RingHom.id_apply,
      Finsupp.filter_smul]

open Classical in
lemma coeff_restrict (S : Set ℤ) (x : Vec k n) (i : Fin n) (j : ℤ) :
    (restrict S x i).coeff j = if j ∈ S then (x i).coeff j else 0 := by
  change (Finsupp.filter (· ∈ S) (x i).coeff) j = _
  rw [Finsupp.filter_apply]

lemma restrict_mem (S : Set ℤ) (x : Vec k n) : restrict S x ∈ supportedIn k n S := by
  intro i j hj
  rw [coeff_restrict, if_neg hj]

lemma sub_restrict_mem (S : Set ℤ) (x : Vec k n) : x - restrict S x ∈ supportedIn k n Sᶜ := by
  intro i j hj
  rw [Set.mem_compl_iff, not_not] at hj
  rw [Pi.sub_apply, coeff_sub, coeff_restrict, if_pos hj, sub_self]

lemma restrict_eq_self {S : Set ℤ} {x : Vec k n} (hx : x ∈ supportedIn k n S) :
    restrict S x = x := by
  funext i
  ext j
  rw [coeff_restrict]
  split_ifs with h
  · rfl
  · exact (hx i j h).symm

/-! ### Shifts and the pairing -/

/-- Multiplication of all coordinates by `T j`. -/
def shift (j : ℤ) : Vec k n →ₗ[k] Vec k n where
  toFun x i := T j * x i
  map_add' x y := by funext i; simp [mul_add]
  map_smul' r x := by funext i; simp

lemma coeff_shift (j : ℤ) (x : Vec k n) (i : Fin n) (c : ℤ) :
    (shift j x i).coeff c = (x i).coeff (c - j) :=
  coeff_T_mul j c (x i)

/-- The `R`-bilinear pairing `⟨x, y⟩ = ∑ xᵢ yᵢ`. -/
def dot (x y : Vec k n) : k[T;T⁻¹] := ∑ i, x i * y i

lemma dot_add_left (x x' y : Vec k n) : dot (x + x') y = dot x y + dot x' y := by
  simp only [dot, Pi.add_apply, add_mul, Finset.sum_add_distrib]

lemma dot_add_right (x y y' : Vec k n) : dot x (y + y') = dot x y + dot x y' := by
  simp only [dot, Pi.add_apply, mul_add, Finset.sum_add_distrib]

lemma dot_smul_left (r : k) (x y : Vec k n) : dot (r • x) y = r • dot x y := by
  simp only [dot, Pi.smul_apply, smul_mul_assoc, Finset.smul_sum]

lemma dot_smul_right (r : k) (x y : Vec k n) : dot x (r • y) = r • dot x y := by
  simp only [dot, Pi.smul_apply, mul_smul_comm, Finset.smul_sum]

lemma dot_sub_left (x x' y : Vec k n) : dot (x - x') y = dot x y - dot x' y := by
  simp only [dot, Pi.sub_apply, sub_mul, Finset.sum_sub_distrib]

lemma dot_zero_left (y : Vec k n) : dot 0 y = 0 := by simp [dot]

lemma dot_zero_right (x : Vec k n) : dot x 0 = 0 := by simp [dot]

lemma dot_shift_left (j : ℤ) (x y : Vec k n) : dot (shift j x) y = T j * dot x y := by
  simp only [dot, Finset.mul_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  change T j * x i * y i = _
  ring

lemma dot_shift_right (j : ℤ) (x y : Vec k n) : dot x (shift j y) = T j * dot x y := by
  simp only [dot, Finset.mul_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  change x i * (T j * y i) = _
  ring

lemma coeff_dot (x y : Vec k n) (c : ℤ) : (dot x y).coeff c = ∑ i, (x i * y i).coeff c := by
  rw [dot, coeff_sum]

/-- If `x` has no coefficients above `a` and `y` none above `b`, then `⟨x, y⟩` has none above
`a + b`. -/
lemma coeff_dot_eq_zero_of_lower {x y : Vec k n} {a b : ℤ} (hx : x ∈ lower k n a)
    (hy : y ∈ lower k n b) {c : ℤ} (hc : a + b < c) : (dot x y).coeff c = 0 := by
  rw [coeff_dot]
  refine Finset.sum_eq_zero fun i _ => ?_
  exact coeff_mul_eq_zero_of_lower (fun j hj => hx i j (by simpa using hj))
    (fun j hj => hy i j (by simpa using hj)) hc

/-- The vector with `T j` in coordinate `i` and `0` elsewhere. -/
def unit (i : Fin n) (j : ℤ) : Vec k n := Pi.single i (T j)

lemma dot_unit_left (i : Fin n) (j : ℤ) (y : Vec k n) : dot (unit i j) y = T j * y i := by
  rw [dot, Finset.sum_eq_single i]
  · simp [unit]
  · intro b _ hb
    simp [unit, hb]
  · simp

lemma coeff_unit (i i' : Fin n) (j c : ℤ) :
    ((unit i j : Vec k n) i').coeff c = if i' = i ∧ c = j then 1 else 0 := by
  by_cases h : i' = i
  · subst h
    simp only [unit, Pi.single_eq_same, true_and]
    rw [T, coeff_single]
    by_cases hc : c = j
    · simp [hc]
    · simp [hc, Ne.symm hc]
  · simp [unit, h]

lemma unit_mem_supportedIn {S : Set ℤ} (i : Fin n) {j : ℤ} (hj : j ∈ S) :
    (unit i j : Vec k n) ∈ supportedIn k n S := by
  intro i' c hc
  rw [coeff_unit]
  rw [if_neg]
  rintro ⟨-, rfl⟩
  exact hc hj

/-- The residue pairing `res ⟨x, y⟩ = ⟨x, y⟩_{-1}` (the coefficient of `t⁻¹ dt`). -/
def res (x y : Vec k n) : k := (dot x y).coeff (-1)

lemma res_add_left (x x' y : Vec k n) : res (x + x') y = res x y + res x' y := by
  rw [res, dot_add_left, coeff_add]; rfl

lemma res_sub_left (x x' y : Vec k n) : res (x - x') y = res x y - res x' y := by
  rw [res, dot_sub_left, coeff_sub]; rfl

lemma res_smul_left (r : k) (x y : Vec k n) : res (r • x) y = r * res x y := by
  rw [res, dot_smul_left, coeff_smul]; rfl

lemma res_add_right (x y y' : Vec k n) : res x (y + y') = res x y + res x y' := by
  rw [res, dot_add_right, coeff_add]; rfl

lemma res_smul_right (r : k) (x y : Vec k n) : res x (r • y) = r * res x y := by
  rw [res, dot_smul_right, coeff_smul]; rfl

lemma res_unit_left (i : Fin n) (j : ℤ) (y : Vec k n) :
    res (unit i j) y = (y i).coeff (-1 - j) := by
  rw [res, dot_unit_left, coeff_T_mul]

lemma res_shift_left (j : ℤ) (x y : Vec k n) :
    res (shift j x) y = (dot x y).coeff (-1 - j) := by
  rw [res, dot_shift_left, coeff_T_mul]

/-- The residue pairing only sees the coefficients of `x` in degrees `-1 - j`, `j` a degree of
`y`: if `y` has coefficients in `(a, b]` and `x` vanishes in degrees `[-1 - b, -1 - a)`,
then `res ⟨x, y⟩ = 0`. -/
lemma res_eq_zero_of_band {x y : Vec k n} {a b : ℤ} (hy : y ∈ band k n a b)
    (hx : ∀ i j, -1 - b ≤ j → j < -1 - a → (x i).coeff j = 0) : res x y = 0 := by
  rw [res, coeff_dot]
  refine Finset.sum_eq_zero fun i _ => ?_
  rw [coeff_mul_eq_sum' (x i) (y i) (Finset.Ioc a b)
    (fun j hj => hy i j (by simpa using hj))]
  refine Finset.sum_eq_zero fun j hj => ?_
  rw [Finset.mem_Ioc] at hj
  rw [hx i (-1 - j) (by omega) (by omega), zero_mul]

/-! ### Bands are finite-dimensional -/

variable (k n) in
/-- Coordinates of a vector of `band a b`: its coefficients `(xᵢ)_j`, `j ∈ (a, b]`. -/
def bandEquiv (a b : ℤ) : band k n a b ≃ₗ[k] (Fin n × Finset.Ioc a b → k) where
  toFun x p := (x.1 p.1).coeff p.2
  map_add' x y := by funext p; exact coeff_add _ _ _
  map_smul' r x := by funext p; exact coeff_smul _ _ _
  invFun c := ⟨fun i => ∑ j : Finset.Ioc a b, c (i, j) • T (j : ℤ), by
    intro i j hj
    rw [coeff_sum]
    refine Finset.sum_eq_zero fun j' _ => ?_
    rw [coeff_smul, T, coeff_single, if_neg, mul_zero]
    rintro rfl
    exact hj (Finset.mem_Ioc.mp j'.2)⟩
  left_inv x := by
    apply Subtype.ext
    funext i
    change ∑ j : Finset.Ioc a b, (x.1 i).coeff j • T (j : ℤ) = x.1 i
    conv_rhs => rw [eq_sum_single (x.1 i) (Finset.Ioc a b)
      (fun j hj => x.2 i j (by simpa using hj))]
    rw [← Finset.sum_coe_sort (Finset.Ioc a b)]
    exact Finset.sum_congr rfl fun j _ => (single_eq_C_mul_T' _ _).symm
  right_inv c := by
    funext p
    change (∑ j : Finset.Ioc a b, c (p.1, j) • T (j : ℤ)).coeff p.2 = c p
    rw [coeff_sum, Finset.sum_eq_single p.2]
    · rw [coeff_smul, T, coeff_single, if_pos rfl, mul_one]
    · intro j _ hj
      rw [coeff_smul, T, coeff_single, if_neg (fun h => hj (Subtype.ext h)), mul_zero]
    · simp

instance (a b : ℤ) : FiniteDimensional k (band k n a b) :=
  LinearEquiv.finiteDimensional (bandEquiv k n a b).symm

lemma finrank_band (a b : ℤ) : finrank k (band k n a b) = n * (b - a).toNat := by
  rw [(bandEquiv k n a b).finrank_eq, Module.finrank_fintype_fun_eq_card, Fintype.card_prod,
    Fintype.card_fin, Fintype.card_coe, Int.card_Ioc]

/-! ### The residue pairing between bands is perfect -/

variable (k n) in
/-- The residue pairing `band (-2 - b) (-2 - a) × band a b → k`. -/
def pairing (a b : ℤ) : band k n (-2 - b) (-2 - a) →ₗ[k] Module.Dual k (band k n a b) where
  toFun y :=
    { toFun x := res x.1 y.1
      map_add' x x' := res_add_left _ _ _
      map_smul' r x := res_smul_left _ _ _ }
  map_add' y y' := by ext x; exact res_add_right _ _ _
  map_smul' r y := by ext x; exact res_smul_right _ _ _

lemma pairing_apply (a b : ℤ) (y : band k n (-2 - b) (-2 - a)) (x : band k n a b) :
    pairing k n a b y x = res x.1 y.1 := rfl

lemma pairing_injective (a b : ℤ) : Function.Injective (pairing k n a b) := by
  rw [← LinearMap.ker_eq_bot, eq_bot_iff]
  intro y hy
  rw [LinearMap.mem_ker] at hy
  rw [Submodule.mem_bot]
  apply Subtype.ext
  funext i
  ext c
  change (y.1 i).coeff c = 0
  by_cases hc : c ∈ Set.Ioc (-2 - b) (-2 - a)
  · have hx : (unit i (-1 - c) : Vec k n) ∈ band k n a b :=
      unit_mem_supportedIn i (by rw [Set.mem_Ioc] at hc ⊢; omega)
    have := congrArg (fun φ : Module.Dual k (band k n a b) => φ ⟨_, hx⟩) hy
    simp only [pairing_apply, LinearMap.zero_apply] at this
    rw [res_unit_left, show -1 - (-1 - c) = c by ring] at this
    exact this
  · exact y.2 i c hc

lemma pairing_bijective (a b : ℤ) : Function.Bijective (pairing k n a b) := by
  refine ⟨pairing_injective a b, ?_⟩
  rw [← LinearMap.injective_iff_surjective_of_finrank_eq_finrank]
  · exact pairing_injective a b
  · rw [Subspace.dual_finrank_eq, finrank_band, finrank_band]
    congr 2
    ring

variable (k n) in
/-- The annihilator in `band (-2 - b) (-2 - a)` of a subspace `S` under the residue pairing. -/
def annIn (a b : ℤ) (S : Submodule k (Vec k n)) : Submodule k (Vec k n) where
  carrier := {y | y ∈ band k n (-2 - b) (-2 - a) ∧ ∀ x ∈ S, res x y = 0}
  add_mem' {y y'} hy hy' := ⟨add_mem hy.1 hy'.1, fun x hx => by
    rw [res_add_right, hy.2 x hx, hy'.2 x hx, add_zero]⟩
  zero_mem' := ⟨zero_mem _, fun x _ => by rw [res, dot_zero_right]; rfl⟩
  smul_mem' r y hy := ⟨Submodule.smul_mem _ r hy.1, fun x hx => by
    rw [res_smul_right, hy.2 x hx, mul_zero]⟩

lemma annIn_eq_map {a b : ℤ} {S : Submodule k (Vec k n)} (hS : S ≤ band k n a b) :
    annIn k n a b S = ((S.comap (band k n a b).subtype).dualAnnihilator.comap
      (pairing k n a b)).map (band k n (-2 - b) (-2 - a)).subtype := by
  ext y
  simp only [Submodule.mem_map, Submodule.mem_comap, Submodule.mem_dualAnnihilator,
    Submodule.subtype_apply]
  constructor
  · rintro ⟨hy, h⟩
    refine ⟨⟨y, hy⟩, fun x hx => ?_, rfl⟩
    rw [pairing_apply]
    exact h x.1 hx
  · rintro ⟨y', hy', rfl⟩
    refine ⟨y'.2, fun x hx => ?_⟩
    have := hy' ⟨x, hS hx⟩ hx
    rwa [pairing_apply] at this

/-- **Annihilator count**: for `S ⊆ band a b`,
`dim (annihilator of S in band (-2 - b) (-2 - a)) + dim S = dim band a b`. -/
theorem finrank_annIn_add {a b : ℤ} {S : Submodule k (Vec k n)} (hS : S ≤ band k n a b) :
    finrank k (annIn k n a b S) + finrank k S = n * (b - a).toNat := by
  set Φ := LinearEquiv.ofBijective (pairing k n a b) (pairing_bijective a b) with hΦ
  have hΦ' : (Φ : band k n (-2 - b) (-2 - a) →ₗ[k] Module.Dual k (band k n a b)) =
      pairing k n a b := LinearMap.ext fun _ => rfl
  set S₀ := S.comap (band k n a b).subtype
  have h1 : finrank k (annIn k n a b S) = finrank k S₀.dualAnnihilator := by
    rw [annIn_eq_map hS, ← (Submodule.equivMapOfInjective _ (Submodule.injective_subtype _)
      _).finrank_eq, ← hΦ', Submodule.comap_equiv_eq_map_symm, LinearEquiv.finrank_map_eq]
  have h2 : finrank k S₀ = finrank k S := (Submodule.comapSubtypeEquivOfLe hS).finrank_eq
  have h3 := Subspace.finrank_add_finrank_dualAnnihilator_eq S₀
  rw [finrank_band] at h3
  omega
/-! ### Quotients and rank–nullity -/

/-- If `f : M → M'` is onto with kernel inside `S`, then `dim M ⧸ S + dim f(S) = dim M'`. -/
lemma finrank_quotient_add_finrank_map {M M' : Type*} [AddCommGroup M] [Module k M]
    [AddCommGroup M'] [Module k M'] [FiniteDimensional k M'] (f : M →ₗ[k] M')
    (hf : Function.Surjective f) (S : Submodule k M) (hS : LinearMap.ker f ≤ S) :
    finrank k (M ⧸ S) + finrank k (S.map f) = finrank k M' := by
  let g : M →ₗ[k] M' ⧸ S.map f := (S.map f).mkQ ∘ₗ f
  have hg : Function.Surjective g := (Submodule.mkQ_surjective _).comp hf
  have hker : LinearMap.ker g = S := by
    rw [LinearMap.ker_comp, Submodule.ker_mkQ, Submodule.comap_map_eq, sup_eq_left.mpr hS]
  let e : (M ⧸ S) ≃ₗ[k] M' ⧸ S.map f :=
    (Submodule.quotEquivOfEq _ _ hker.symm).trans (g.quotKerEquivOfSurjective hg)
  rw [e.finrank_eq, Submodule.finrank_quotient_add_finrank]

lemma finiteDimensional_quotient_of_surjective {M M' : Type*} [AddCommGroup M] [Module k M]
    [AddCommGroup M'] [Module k M'] [FiniteDimensional k M'] (f : M →ₗ[k] M')
    (hf : Function.Surjective f) (S : Submodule k M) (hS : LinearMap.ker f ≤ S) :
    FiniteDimensional k (M ⧸ S) := by
  let g : M →ₗ[k] M' ⧸ S.map f := (S.map f).mkQ ∘ₗ f
  have hg : Function.Surjective g := (Submodule.mkQ_surjective _).comp hf
  have hker : LinearMap.ker g = S := by
    rw [LinearMap.ker_comp, Submodule.ker_mkQ, Submodule.comap_map_eq, sup_eq_left.mpr hS]
  exact LinearEquiv.finiteDimensional
    ((Submodule.quotEquivOfEq _ _ hker.symm).trans (g.quotKerEquivOfSurjective hg)).symm

/-! ### Lattices and their Serre duals -/

lemma shift_zero (x : Vec k n) : shift 0 x = x := by
  funext i
  change T 0 * x i = x i
  rw [T_zero, one_mul]

lemma shift_shift (a b : ℤ) (x : Vec k n) : shift a (shift b x) = shift (a + b) x := by
  funext i
  change T a * (T b * x i) = T (a + b) * x i
  rw [← mul_assoc, ← T_add]

variable (k n) in
/-- A `k[s]`-lattice in `Rⁿ` (`s = T⁻¹`): a subspace stable under `s` lying between
`lower (-m) = sᵐ k[s]ⁿ` and `lower m = s⁻ᵐ k[s]ⁿ` for some `m`. -/
structure IsLattice (N : Submodule k (Vec k n)) : Prop where
  shift_mem : ∀ x ∈ N, shift (-1) x ∈ N
  exists_le : ∃ m : ℕ, lower k n (-m) ≤ N ∧ N ≤ lower k n m

lemma lower_mono {a b : ℤ} (h : a ≤ b) : lower k n a ≤ lower k n b :=
  supportedIn_mono (Set.Iic_subset_Iic.mpr h)

lemma IsLattice.shift_neg_mem {N : Submodule k (Vec k n)} (hN : IsLattice k n N) (j : ℕ)
    {x : Vec k n} (hx : x ∈ N) : shift (-(j : ℤ)) x ∈ N := by
  induction j with
  | zero => rw [Nat.cast_zero, neg_zero, shift_zero]; exact hx
  | succ j ih =>
    have := hN.shift_mem _ ih
    rwa [shift_shift, show (-1 : ℤ) + -(j : ℤ) = -((j + 1 : ℕ) : ℤ) by push_cast; ring] at this

lemma IsLattice.exists_le_one {N : Submodule k (Vec k n)} (hN : IsLattice k n N) :
    ∃ m : ℕ, 1 ≤ m ∧ lower k n (-m) ≤ N ∧ N ≤ lower k n m := by
  obtain ⟨m, h₁, h₂⟩ := hN.exists_le
  refine ⟨m + 1, by omega, le_trans (lower_mono (by push_cast; omega)) h₁,
    le_trans h₂ (lower_mono (by push_cast; omega))⟩

variable (k n) in
/-- The lattice of the Serre dual bundle `E^∨ ⊗ Ω¹`:
`N' = {y | ⟨x, y⟩ ∈ s² k[s] for all x ∈ N}`. -/
def serreDual (N : Submodule k (Vec k n)) : Submodule k (Vec k n) where
  carrier := {y | ∀ x ∈ N, ∀ j, -1 ≤ j → (dot x y).coeff j = 0}
  add_mem' {y y'} hy hy' x hx j hj := by
    rw [dot_add_right, coeff_add, hy x hx j hj, hy' x hx j hj, add_zero]
  zero_mem' x _ j _ := by rw [dot_zero_right]; rfl
  smul_mem' r y hy x hx j hj := by
    rw [dot_smul_right, coeff_smul, hy x hx j hj, mul_zero]

lemma mem_serreDual_iff {N : Submodule k (Vec k n)} (hN : IsLattice k n N) {y : Vec k n} :
    y ∈ serreDual k n N ↔ ∀ x ∈ N, res x y = 0 := by
  refine ⟨fun hy x hx => hy x hx (-1) le_rfl, fun hy x hx j hj => ?_⟩
  obtain ⟨l, hl⟩ : ∃ l : ℕ, (l : ℤ) = j + 1 := ⟨(j + 1).toNat, Int.toNat_of_nonneg (by omega)⟩
  have := hy _ (hN.shift_neg_mem l hx)
  rwa [res_shift_left, hl, show -1 - -(j + 1) = j by ring] at this

lemma serreDual_le_lower {N : Submodule k (Vec k n)} {m : ℤ} (hN : lower k n (-m) ≤ N) :
    serreDual k n N ≤ lower k n (m - 2) := by
  intro y hy i c hc
  rw [Set.mem_Iic, not_le] at hc
  have hx : (unit i (-m) : Vec k n) ∈ N := hN (unit_mem_supportedIn i (Set.mem_Iic.mpr le_rfl))
  have := hy _ hx (c - m) (by omega)
  rwa [dot_unit_left, coeff_T_mul, show c - m - -m = c by ring] at this

lemma lower_le_serreDual {N : Submodule k (Vec k n)} {m : ℤ} (hN : N ≤ lower k n m) :
    lower k n (-m - 2) ≤ serreDual k n N := fun y hy x hx j hj =>
  coeff_dot_eq_zero_of_lower (hN hx) hy (by omega)

lemma IsLattice.serreDual {N : Submodule k (Vec k n)} (hN : IsLattice k n N) :
    IsLattice k n (serreDual k n N) := by
  refine ⟨fun y hy x hx j hj => ?_, ?_⟩
  · rw [dot_shift_right, coeff_T_mul]
    exact hy x hx _ (by omega)
  · obtain ⟨m, h₁, h₂⟩ := hN.exists_le
    refine ⟨m + 2, le_trans (lower_mono (by push_cast; omega)) (lower_le_serreDual h₂),
      le_trans (serreDual_le_lower h₁) (lower_mono (by push_cast; omega))⟩

/-! ### The cohomology of a lattice through a band -/

section Band

variable {N : Submodule k (Vec k n)} {m : ℕ} (hm : 1 ≤ m) (h₁ : lower k n (-m) ≤ N)
  (h₂ : N ≤ lower k n m)

/-- The projection onto the coefficients in degrees `(-m, -1]`. -/
abbrev proj (m : ℕ) : Vec k n →ₗ[k] Vec k n := restrict (Set.Ioc (-(m : ℤ)) (-1))

/-- The projection onto the coefficients in degrees `(-m, -1]`, with values in that band. -/
def proj' (m : ℕ) : Vec k n →ₗ[k] band k n (-m) (-1) :=
  (proj m).codRestrict _ (restrict_mem _)

lemma proj'_surjective (m : ℕ) : Function.Surjective (proj' (k := k) (n := n) m) := by
  intro y
  refine ⟨y.1, Subtype.ext ?_⟩
  exact restrict_eq_self y.2

include h₁ in
lemma ker_proj'_le : LinearMap.ker (proj' (k := k) (n := n) m) ≤ upper k n 0 ⊔ N := by
  intro x hx
  have hx' : proj m x = 0 := congrArg Subtype.val hx
  rw [Submodule.mem_sup]
  refine ⟨restrict (Set.Ici 0) x, restrict_mem _ _, x - restrict (Set.Ici 0) x, ?_,
    add_sub_cancel _ _⟩
  apply h₁
  intro i j hj
  rw [Set.mem_Iic, not_le] at hj
  rw [Pi.sub_apply, coeff_sub, coeff_restrict]
  by_cases h0 : 0 ≤ j
  · rw [if_pos (Set.mem_Ici.mpr h0), sub_self]
  · have := congrArg (fun z : Vec k n => (z i).coeff j) hx'
    simp only [coeff_restrict, Pi.zero_apply] at this
    rw [if_pos (Set.mem_Ioc.mpr ⟨hj, by omega⟩)] at this
    rw [if_neg (by simpa using h0), this, sub_zero]
    rfl

lemma proj_eq_zero_of_mem_upper {x : Vec k n} (hx : x ∈ upper k n 0) : proj m x = 0 := by
  funext i
  ext j
  rw [coeff_restrict]
  split_ifs with h
  · rw [Set.mem_Ioc] at h
    exact hx i j (by rw [Set.mem_Ici]; omega)
  · rfl

lemma map_proj_sup_upper (S : Submodule k (Vec k n)) :
    (upper k n 0 ⊔ S).map (proj m) = S.map (proj m) := by
  rw [Submodule.map_sup]
  have : (upper k n 0).map (proj (k := k) (n := n) m) = ⊥ := by
    rw [eq_bot_iff]
    rintro _ ⟨x, hx, rfl⟩
    exact (Submodule.mem_bot k).mpr (proj_eq_zero_of_mem_upper hx)
  rw [this, bot_sup_eq]

lemma finrank_map_proj' (S : Submodule k (Vec k n)) :
    finrank k (S.map (proj' m)) = finrank k (S.map (proj m)) := by
  rw [(Submodule.equivMapOfInjective _ (Submodule.injective_subtype (band k n (-m) (-1)))
    (S.map (proj' m))).finrank_eq, ← Submodule.map_comp]
  rfl

include hm h₁ in
/-- `h¹(N) + dim π(N) = n (m - 1)`, `π` the projection onto degrees `(-m, -1]`. -/
lemma finrank_quot_add_finrank_map_proj :
    finrank k (Vec k n ⧸ (upper k n 0 ⊔ N)) + finrank k (N.map (proj m)) = n * (m - 1) := by
  have h := finrank_quotient_add_finrank_map (proj' m) (proj'_surjective m) (upper k n 0 ⊔ N)
    (ker_proj'_le h₁)
  rw [finrank_band, finrank_map_proj', map_proj_sup_upper] at h
  rw [h]
  congr 1
  omega

include h₁ h₂ in
lemma restrict_band_mem {x : Vec k n} (hx : x ∈ N) :
    restrict (Set.Ioc (-(m : ℤ)) m) x ∈ N ⊓ band k n (-m) m := by
  refine ⟨?_, restrict_mem _ _⟩
  have hlow : x - restrict (Set.Ioc (-(m : ℤ)) m) x ∈ N := by
    apply h₁
    intro i j hj
    rw [Set.mem_Iic, not_le] at hj
    rw [Pi.sub_apply, coeff_sub, coeff_restrict]
    split_ifs with h
    · rw [sub_self]
    · rw [Set.mem_Ioc, not_and_or, not_le] at h
      rcases h with h | h
      · omega
      · rw [h₂ hx i j (by rw [Set.mem_Iic]; omega), sub_zero]
  have := sub_mem hx hlow
  rwa [sub_sub_cancel] at this

lemma proj_restrict_band (x : Vec k n) :
    proj m (restrict (Set.Ioc (-(m : ℤ)) m) x) = proj m x := by
  funext i
  ext j
  rw [coeff_restrict, coeff_restrict, coeff_restrict]
  by_cases h : j ∈ Set.Ioc (-(m : ℤ)) (-1)
  · have h' : j ∈ Set.Ioc (-(m : ℤ)) m := by
      rw [Set.mem_Ioc] at h ⊢; omega
    rw [if_pos h, if_pos h', if_pos h]
  · rw [if_neg h, if_neg h]

include h₁ h₂ in
lemma map_proj_eq_map_proj_band :
    N.map (proj m) = (N ⊓ band k n (-m) m).map (proj m) := by
  refine le_antisymm ?_ (Submodule.map_mono inf_le_left)
  rintro _ ⟨x, hx, rfl⟩
  exact ⟨_, restrict_band_mem h₁ h₂ hx, proj_restrict_band x⟩

include hm h₂ in
lemma upper_inf_le_band : upper k n 0 ⊓ N ≤ N ⊓ band k n (-m) m := by
  rintro x ⟨hx₀, hx⟩
  refine ⟨hx, fun i j hj => ?_⟩
  rw [Set.mem_Ioc, not_and_or, not_lt, not_le] at hj
  rcases hj with hj | hj
  · exact hx₀ i j (by rw [Set.mem_Ici]; omega)
  · exact h₂ hx i j (by rw [Set.mem_Iic]; omega)

include hm h₁ h₂ in
/-- `h⁰(N) + dim π(N) = dim (N ∩ band (-m) m)`. -/
lemma finrank_inf_add_finrank_map_proj :
    finrank k (upper k n 0 ⊓ N : Submodule k (Vec k n)) + finrank k (N.map (proj m)) =
      finrank k (N ⊓ band k n (-m) m : Submodule k (Vec k n)) := by
  set Nb := N ⊓ band k n (-m) m
  let f := (proj (k := k) (n := n) m) ∘ₗ Nb.subtype
  have hr : LinearMap.range f = N.map (proj m) := by
    rw [LinearMap.range_comp, Submodule.range_subtype, ← map_proj_eq_map_proj_band h₁ h₂]
  have hk : LinearMap.ker f = (upper k n 0 ⊓ N).comap Nb.subtype := by
    ext ⟨x, hx⟩
    simp only [f, LinearMap.mem_ker, LinearMap.comp_apply, Submodule.subtype_apply,
      Submodule.mem_comap]
    constructor
    · intro h
      refine ⟨fun i j hj => ?_, hx.1⟩
      rw [Set.mem_Ici, not_le] at hj
      by_cases hj' : -(m : ℤ) < j
      · have := congrArg (fun z : Vec k n => (z i).coeff j) h
        simp only [coeff_restrict, Pi.zero_apply] at this
        rw [if_pos (Set.mem_Ioc.mpr ⟨hj', by omega⟩)] at this
        exact this
      · exact hx.2 i j (by rw [Set.mem_Ioc]; omega)
    · intro h
      exact proj_eq_zero_of_mem_upper h.1
  have := LinearMap.finrank_range_add_finrank_ker f
  rw [hr, hk, (Submodule.comapSubtypeEquivOfLe (upper_inf_le_band hm h₂)).finrank_eq] at this
  omega

include hm h₁ h₂ in
/-- The Euler characteristic through a band:
`h⁰(N) + n (m - 1) = h¹(N) + dim (N ∩ band (-m) m)`. -/
lemma euler_band :
    finrank k (upper k n 0 ⊓ N : Submodule k (Vec k n)) + n * (m - 1) =
      finrank k (Vec k n ⧸ (upper k n 0 ⊔ N)) +
        finrank k (N ⊓ band k n (-m) m : Submodule k (Vec k n)) := by
  have e₁ := finrank_quot_add_finrank_map_proj hm h₁
  have e₂ := finrank_inf_add_finrank_map_proj hm h₁ h₂
  omega

end Band

/-! ### Serre duality -/

section Duality

variable {N : Submodule k (Vec k n)} (hN : IsLattice k n N)

include hN in
lemma IsLattice.finiteDimensional_inf :
    FiniteDimensional k (upper k n 0 ⊓ N : Submodule k (Vec k n)) := by
  obtain ⟨m, hm, -, h₂⟩ := hN.exists_le_one
  exact Submodule.finiteDimensional_of_le (upper_inf_le_band hm h₂ |>.trans inf_le_right)

include hN in
lemma IsLattice.finiteDimensional_quot :
    FiniteDimensional k (Vec k n ⧸ (upper k n 0 ⊔ N)) := by
  obtain ⟨m, -, h₁, -⟩ := hN.exists_le_one
  exact finiteDimensional_quotient_of_surjective (proj' m) (proj'_surjective m) _
    (ker_proj'_le h₁)

include hN in
lemma mem_annIn_proj_iff {m : ℕ} (h₁ : lower k n (-m) ≤ N) {y : Vec k n} :
    y ∈ upper k n 0 ⊓ serreDual k n N ↔
      y ∈ annIn k n (-m) (-1) (N.map (proj m)) := by
  have key : ∀ x : Vec k n, y ∈ band k n (-2 - -1) (-2 - -(m : ℤ)) →
      res (proj m x) y = res x y := by
    intro x hy
    have h0 : res (x - proj m x) y = 0 := by
      refine res_eq_zero_of_band hy fun i j hj hj' => ?_
      have := sub_restrict_mem (Set.Ioc (-(m : ℤ)) (-1)) x i j
        (by rw [Set.mem_compl_iff, not_not, Set.mem_Ioc]; omega)
      exact this
    rw [res_sub_left, sub_eq_zero] at h0
    exact h0.symm
  constructor
  · rintro ⟨hy₀, hy⟩
    have hyb : y ∈ band k n (-2 - -1) (-2 - -(m : ℤ)) := by
      intro i j hj
      rw [Set.mem_Ioc, not_and_or, not_lt, not_le] at hj
      rcases hj with hj | hj
      · exact hy₀ i j (by rw [Set.mem_Ici]; omega)
      · exact serreDual_le_lower h₁ hy i j (by rw [Set.mem_Iic]; omega)
    refine ⟨hyb, ?_⟩
    rintro _ ⟨x, hx, rfl⟩
    rw [key x hyb]
    exact (mem_serreDual_iff hN).mp hy x hx
  · rintro ⟨hyb, hy⟩
    refine ⟨fun i j hj => hyb i j (by rw [Set.mem_Ici] at hj; rw [Set.mem_Ioc]; omega), ?_⟩
    change y ∈ serreDual k n N
    rw [mem_serreDual_iff hN]
    intro x hx
    rw [← key x hyb]
    exact hy _ ⟨x, hx, rfl⟩

include hN in
/-- **Serre duality on `ℙ¹`, `H⁰` part**: `h⁰(E^∨ ⊗ Ω¹) = h¹(E)`. -/
theorem finrank_inf_serreDual :
    finrank k (upper k n 0 ⊓ serreDual k n N : Submodule k (Vec k n)) =
      finrank k (Vec k n ⧸ (upper k n 0 ⊔ N)) := by
  obtain ⟨m, hm, h₁, h₂⟩ := hN.exists_le_one
  have heq : upper k n 0 ⊓ serreDual k n N = annIn k n (-m) (-1) (N.map (proj m)) := by
    ext y
    exact mem_annIn_proj_iff hN h₁
  have hle : N.map (proj m) ≤ band k n (-m) (-1) := by
    rintro _ ⟨x, -, rfl⟩
    exact restrict_mem _ x
  have e₁ := finrank_annIn_add hle
  have e₂ := finrank_quot_add_finrank_map_proj hm h₁
  rw [heq]
  have : (-1 - -(m : ℤ)).toNat = m - 1 := by omega
  rw [this] at e₁
  omega

include hN in
lemma serreDual_inf_band_eq {m : ℕ} (h₁ : lower k n (-m) ≤ N) (h₂ : N ≤ lower k n m) :
    serreDual k n N ⊓ band k n (-((m + 2 : ℕ) : ℤ)) ((m + 2 : ℕ) : ℤ) =
      annIn k n (-m) m (N ⊓ band k n (-m) m) := by
  ext y
  constructor
  · rintro ⟨hy, hyb⟩
    refine ⟨fun i j hj => ?_, fun x hx => (mem_serreDual_iff hN).mp hy x hx.1⟩
    rw [Set.mem_Ioc, not_and_or, not_lt, not_le] at hj
    rcases hj with hj | hj
    · exact hyb i j (by rw [Set.mem_Ioc]; push_cast; omega)
    · exact serreDual_le_lower h₁ hy i j (by rw [Set.mem_Iic]; omega)
  · rintro ⟨hyb, hy⟩
    refine ⟨?_, fun i j hj => hyb i j (by rw [Set.mem_Ioc] at hj ⊢; push_cast at hj; omega)⟩
    change y ∈ serreDual k n N
    rw [mem_serreDual_iff hN]
    intro x hx
    have hxb := restrict_band_mem h₁ h₂ hx
    have h0 : res (x - restrict (Set.Ioc (-(m : ℤ)) m) x) y = 0 := by
      refine res_eq_zero_of_band hyb fun i j hj hj' => ?_
      exact sub_restrict_mem (Set.Ioc (-(m : ℤ)) m) x i j
        (by rw [Set.mem_compl_iff, not_not, Set.mem_Ioc]; omega)
    rw [res_sub_left, hy _ hxb, sub_zero] at h0
    exact h0

include hN in
/-- **Serre duality on `ℙ¹`, `H¹` part**: `h¹(E^∨ ⊗ Ω¹) = h⁰(E)`. -/
theorem finrank_quot_serreDual :
    finrank k (Vec k n ⧸ (upper k n 0 ⊔ serreDual k n N)) =
      finrank k (upper k n 0 ⊓ N : Submodule k (Vec k n)) := by
  obtain ⟨m, hm, h₁, h₂⟩ := hN.exists_le_one
  have h₁' : lower k n (-((m + 2 : ℕ) : ℤ)) ≤ serreDual k n N := by
    refine le_trans (lower_mono ?_) (lower_le_serreDual h₂)
    push_cast; omega
  have h₂' : serreDual k n N ≤ lower k n ((m + 2 : ℕ) : ℤ) :=
    le_trans (serreDual_le_lower h₁) (lower_mono (by push_cast; omega))
  have e₁ := euler_band hm h₁ h₂
  have e₂ := euler_band (by omega : 1 ≤ m + 2) h₁' h₂'
  rw [serreDual_inf_band_eq hN h₁ h₂] at e₂
  have e₃ := finrank_annIn_add (S := N ⊓ band k n (-m) m) inf_le_right
  have e₄ := finrank_inf_serreDual hN
  have e₅ : (m - -(m : ℤ)).toNat = 2 * m := by omega
  rw [e₅] at e₃
  have e₆ : n * (m - 1) + n * (m + 2 - 1) = n * (2 * m) := by
    rw [← Nat.mul_add]; congr 1; omega
  omega

end Duality

end

end DeJongAlterations.StableModification.CurvesField.Duality
