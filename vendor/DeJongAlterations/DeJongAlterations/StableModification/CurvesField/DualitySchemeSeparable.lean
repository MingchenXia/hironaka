import Mathlib.FieldTheory.SeparablyGenerated
import Mathlib.FieldTheory.RatFunc.AsPolynomial
import Mathlib.RingTheory.Unramified.Field
import Mathlib.RingTheory.AlgebraicIndependent.TranscendenceBasis
import Mathlib.RingTheory.AlgebraicIndependent.Transcendental

/-!
# A nonzero differential gives a separable extension

Let `k` be a perfect field and `K/k` a finitely generated field extension, algebraic over
`k(t) = RatFunc k` (embedded in `K`). If `dt ≠ 0` in `Ω_{K/k}`, then `K/k(t)` is separable
(`isSeparable_of_D_ne_zero`). The proof:

* `K/k` has a separating transcendence basis `S` (Mathlib,
  `exists_isTranscendenceBasis_and_isSeparable_of_perfectField`); since `{t}` is a transcendence
  basis too (`isTranscendenceBasis_ratFunc_X`, `IsTranscendenceBasis.algebraMap_comp`), `S` has
  one element `u`;
* `Ω_{K/k}` is spanned by the differentials of a separating transcendence basis
  (`span_D_eq_top_of_isSeparable`, from the exact sequence
  `K ⊗ Ω_{k(S)/k} → Ω_{K/k} → Ω_{K/k(S)} = 0` and `D_mem_span_of_mem_adjoin`), so
  `Ω_{K/k} = K du`, which is spanned by `dt ≠ 0`;
* hence `Ω_{K/k(t)} = 0`: `K/k(t)` is formally unramified, i.e. separable
  (`Algebra.FormallyUnramified.iff_isSeparable`).

This replaces the classical criterion "`t ∉ K^p`" in the choice of a separable projection of a
curve to `ℙ¹` (blueprint `sm-omega-degree-scheme.tex`, `lem:sm-separable-of-dt`), the input of
the two-chart presentation used for the degree of `ω` in M. Temkin, *Stable modification of
relative curves*, J. Algebraic Geom. 19 (2010), Thm 1.1
(`references/temkin10-stable-modification/source/semi-stable.tex`, lines 1717–1741).
-/

universe u

open Polynomial KaehlerDifferential

namespace DeJongAlterations.StableModification.CurvesField.DualityScheme

noncomputable section

section Span

variable (k : Type*) {K : Type*} [Field k] [Field K] [Algebra k K]

/-- The elements of `K` whose differential lies in a given `K`-submodule of `Ω_{K/k}` form an
intermediate field. -/
def derivationPreimage (N : Submodule K Ω[K⁄k]) : IntermediateField k K where
  carrier := {x | D k K x ∈ N}
  mul_mem' {a b} ha hb := by
    change D k K (a * b) ∈ N
    rw [Derivation.leibniz]
    exact N.add_mem (N.smul_mem _ hb) (N.smul_mem _ ha)
  add_mem' {a b} ha hb := by
    change D k K (a + b) ∈ N
    rw [map_add]
    exact N.add_mem ha hb
  algebraMap_mem' r := by
    change D k K (algebraMap k K r) ∈ N
    rw [Derivation.map_algebraMap]
    exact N.zero_mem
  inv_mem' a ha := by
    change D k K a⁻¹ ∈ N
    rw [Derivation.leibniz_inv]
    exact N.smul_mem _ ha

/-- The differential of an element of the field generated by `S` lies in the `K`-span of the
differentials of `S`. -/
lemma D_mem_span_of_mem_adjoin (S : Set K) {x : K} (hx : x ∈ IntermediateField.adjoin k S) :
    D k K x ∈ Submodule.span K (D k K '' S) := by
  have h : IntermediateField.adjoin k S ≤
      derivationPreimage k (Submodule.span K (D k K '' S)) := by
    rw [IntermediateField.adjoin_le_iff]
    intro s hs
    exact Submodule.subset_span ⟨s, hs, rfl⟩
  exact h hx

/-- **`Ω_{K/k}` is spanned by the differentials of a set `S` over which `K` is separable.** -/
lemma span_D_eq_top_of_isSeparable (S : Set K)
    [Algebra.IsSeparable (IntermediateField.adjoin k S) K] :
    Submodule.span K (D k K '' S) = ⊤ := by
  set F := IntermediateField.adjoin k S
  have : Algebra.FormallyUnramified F K := Algebra.FormallyUnramified.of_isSeparable F K
  refine eq_top_iff.mpr fun ω hω => ?_
  have h0 : KaehlerDifferential.map k F K K ω = 0 := Subsingleton.elim _ _
  obtain ⟨y, rfl⟩ := (KaehlerDifferential.exact_mapBaseChange_map k F K ω).mp h0
  clear h0 hω
  induction y using TensorProduct.induction_on with
  | zero => simp
  | add y z hy hz => rw [map_add]; exact Submodule.add_mem _ hy hz
  | tmul b m =>
    rw [mapBaseChange_tmul]
    refine Submodule.smul_mem _ b ?_
    have hm : m ∈ Submodule.span F (Set.range (D k F)) := by
      rw [span_range_derivation]; trivial
    induction hm using Submodule.span_induction with
    | mem z hz =>
      obtain ⟨a, rfl⟩ := hz
      rw [map_D]
      exact D_mem_span_of_mem_adjoin k S a.2
    | zero => simp
    | add z w _ _ hz hw => rw [map_add]; exact Submodule.add_mem _ hz hw
    | smul a z _ hz =>
      rw [LinearMap.map_smul]
      exact Submodule.smul_of_tower_mem _ a hz

end Span

section TranscendenceBasis

variable (k : Type u) [Field k]

/-- `X` is a transcendence basis of `k(X)` over `k`. -/
lemma isTranscendenceBasis_ratFunc_X :
    IsTranscendenceBasis k (fun _ : Unit => (RatFunc.X : RatFunc k)) := by
  refine (algebraicIndependent_unique_type_iff.mpr RatFunc.transcendental_X).isTranscendenceBasis_iff_isAlgebraic.mpr
    ⟨fun f => ?_⟩
  set B := Algebra.adjoin k (Set.range fun _ : Unit => (RatFunc.X : RatFunc k))
  have hB : B = Algebra.adjoin k {(RatFunc.X : RatFunc k)} := by simp [B]
  have hmem : ∀ p : k[X], algebraMap k[X] (RatFunc k) p ∈ B := fun p => by
    have : algebraMap k[X] (RatFunc k) p = aeval (RatFunc.X : RatFunc k) p := by
      rw [← RatFunc.algebraMap_X, Polynomial.aeval_algebraMap_apply, aeval_X_left_apply]
    rw [this, hB]
    exact Polynomial.aeval_mem_adjoin_singleton k _
  obtain ⟨p, q, hq, rfl⟩ := IsFractionRing.div_surjective (A := k[X]) f
  have hq' : algebraMap k[X] (RatFunc k) q ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective k[X] (RatFunc k))).mpr
      (nonZeroDivisors.ne_zero hq)
  refine ⟨Polynomial.C ⟨_, hmem q⟩ * Polynomial.X - Polynomial.C ⟨_, hmem p⟩, ?_, ?_⟩
  · intro h0
    have h1 := congrArg (Polynomial.coeff · 1) h0
    simp only [coeff_sub, coeff_C_mul_X, coeff_C, if_neg one_ne_zero, sub_zero,
      coeff_zero] at h1
    exact hq' (congrArg Subtype.val h1)
  · rw [map_sub, map_mul, aeval_C, aeval_C, aeval_X]
    change algebraMap k[X] (RatFunc k) q * (algebraMap k[X] (RatFunc k) p /
      algebraMap k[X] (RatFunc k) q) - algebraMap k[X] (RatFunc k) p = 0
    rw [mul_div_cancel₀ _ hq', sub_self]

end TranscendenceBasis

section Separable

variable {k : Type u} [Field k] {K : Type u} [Field K] [Algebra k K]
  [Algebra (RatFunc k) K] [IsScalarTower k (RatFunc k) K]

/-- **A nonzero differential gives a separable extension** (blueprint `lem:sm-separable-of-dt`):
for `k` perfect, `K/k` finitely generated and algebraic over `k(t)`, if `dt ≠ 0` in `Ω_{K/k}` then
`K/k(t)` is separable. -/
theorem isSeparable_of_D_ne_zero [PerfectField k] [Algebra.EssFiniteType k K]
    [Algebra.IsAlgebraic (RatFunc k) K]
    (h : D k K (algebraMap (RatFunc k) K RatFunc.X) ≠ 0) :
    Algebra.IsSeparable (RatFunc k) K := by
  set t := algebraMap (RatFunc k) K RatFunc.X with ht
  obtain ⟨S, hS, hsep⟩ := exists_isTranscendenceBasis_and_isSeparable_of_perfectField k K
  -- `{t}` is a transcendence basis, so `S = {u}` has one element
  have : FaithfulSMul (RatFunc k) K :=
    (faithfulSMul_iff_algebraMap_injective _ _).mpr (algebraMap (RatFunc k) K).injective
  have hT : IsTranscendenceBasis k (fun _ : Unit => t) :=
    (isTranscendenceBasis_ratFunc_X k).algebraMap_comp (A := K)
  have hcard : S.card = 1 := by
    have h1 := hS.lift_cardinalMk_eq hT
    rw [Cardinal.mk_coe_finset, Cardinal.mk_fintype, Fintype.card_unit] at h1
    simpa using h1
  obtain ⟨u, rfl⟩ := Finset.card_eq_one.mp hcard
  rw [Finset.coe_singleton] at hsep
  have hspan := span_D_eq_top_of_isSeparable k ({u} : Set K)
  rw [Set.image_singleton] at hspan
  -- `Ω_{K/k} = K · dt`
  have hdt : ∀ ω : Ω[K⁄k], ∃ c : K, c • D k K t = ω := by
    obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp (hspan ▸ Submodule.mem_top :
      D k K t ∈ Submodule.span K {D k K u})
    have ha0 : a ≠ 0 := by
      rintro rfl
      rw [zero_smul] at ha
      exact h ha.symm
    intro ω
    obtain ⟨b, hb⟩ := Submodule.mem_span_singleton.mp (hspan ▸ Submodule.mem_top :
      ω ∈ Submodule.span K {D k K u})
    refine ⟨b * a⁻¹, ?_⟩
    rw [← ha, smul_smul, mul_assoc, inv_mul_cancel₀ ha0, mul_one, hb]
  -- hence `Ω_{K/k(t)} = 0`
  have hsub : Subsingleton Ω[K⁄RatFunc k] := by
    refine subsingleton_of_forall_eq 0 fun ω' => ?_
    obtain ⟨ω, rfl⟩ := KaehlerDifferential.map_surjective k (RatFunc k) K ω'
    obtain ⟨c, rfl⟩ := hdt ω
    rw [LinearMap.map_smul, map_D, Algebra.algebraMap_self, RingHom.id_apply, ht,
      Derivation.map_algebraMap, smul_zero]
  have : Algebra.FormallyUnramified (RatFunc k) K := ⟨hsub⟩
  have : Algebra.EssFiniteType (RatFunc k) K := Algebra.EssFiniteType.of_comp k (RatFunc k) K
  exact (Algebra.FormallyUnramified.iff_isSeparable (RatFunc k) K).mp inferInstance

end Separable

end

end DeJongAlterations.StableModification.CurvesField.DualityScheme
