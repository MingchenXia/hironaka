import DeJongAlterations.StableModification.Cohomology.FiniteSerre
import DeJongAlterations.Geometry.ProperSteinProjectiveCechSubsetNonemptyComparison

/-!
# Finiteness of the Čech cohomology of coherent modules with projective coordinates

Let `D` be projective coordinates on `X` over a Noetherian ring `A` and `F` a quasi-coherent
module with `Γ(U_i, F)` finite over `Γ(U_i, 𝒪_X)` for all `i` (`F` coherent). Then every Čech
cohomology module `Ȟ^p(U, F)` of the coordinate cover is a finite `A`-module
(`ProjectiveCoordinates.finite_cechCohomology`, blueprint `thm:sm-finite-coordinates`).

## Proof

Choose finite generators `t` of each `Γ(U_j, F)` and, by Serre's extension lemma
(`exists_extension`), sections `σ_t` of twists `F(N_t)` extending them. The `A[x_i]`-submodule
`M = serreModule` of `Γ_*(F)` generated by the `σ_t` is finite and graded
(`isHomogeneous_serreModule`). For a nonempty `T` and `j ∈ T` the map
`m / x_T^n ↦ (m_j|_{U_T}) / (x_T/x_j^{|T|})^n` from the degree-zero part of `M_{x_T}` to
`Γ(U_T, F)` (`psiAt`) is well defined (it is induced by a `LocalizedModule.lift`), independent of
`j` (`psiAt_eq`), injective (`psiAt_injective`) and surjective (`psiAt_surjective`), and compatible
with restrictions (`psiAt_naturality`). These are the statements `M_{(x_T)} ≅ Γ(U_T, M^~)`,
`M^~ ≅ F` of Hartshorne II.5.15 restricted to the coordinate cover. Hence the Čech complex of `F`
is isomorphic to Codex's coordinate Čech complex of the finite graded module `M` in degree `0`
(`SubsetNonemptyComparison.complexIso`), whose cohomology is finite by
`ProperSteinProjectiveCech.finiteGradedPolynomialCoordinateCech_homology_finite`.
-/

universe u

open CategoryTheory Opposite AlgebraicGeometry TopologicalSpace
open DeJongAlterations.Geometry.ProperSteinProjectiveCech

namespace DeJongAlterations.StableModification.Cohomology

noncomputable section

variable {X : Scheme.{u}} {A : Type u} [CommRing A]

namespace ProjectiveCoordinates

variable {c : A →+* Γ(X, ⊤)} (D : ProjectiveCoordinates X A c)

section Homogeneous

variable {D} {F : X.Modules}

lemma eq_single_of_mem_grading {b : ℕ} {e : D.Ambient F} (he : e ∈ D.grading F b) (i : D.ι) :
    e i = PolynomialModule.single _ b ((e i).coeff b) := by
  apply PolynomialModule.ext
  ext m
  rw [PolynomialModule.coeff_single, Finsupp.single_apply]
  split_ifs with h
  · rw [h]
  · exact he i m (by exact_mod_cast (Ne.symm h))

lemma eval_one_of_mem_grading {b : ℕ} {e : D.Ambient F} (he : e ∈ D.grading F b) (i : D.ι) :
    PolynomialModule.eval 1 (e i) = (e i).coeff b := by
  rw [eq_single_of_mem_grading he i, PolynomialModule.eval_single, one_pow, one_smul,
    PolynomialModule.coeff_single, Finsupp.single_eq_same]

lemma eq_zero_of_mem_grading {b : ℕ} {e : D.Ambient F} (he : e ∈ D.grading F b) {i : D.ι}
    (h : (e i).coeff b = 0) : e i = 0 := by
  rw [eq_single_of_mem_grading he i, h, PolynomialModule.single_zero]

lemma toPolynomial_eq_monomial_of_mem (i : D.ι) {a : ℕ} {s : MvPolynomial D.ι A}
    (hs : s ∈ polynomialIntegralGrading (K := A) (I := D.ι) (a : ℤ)) :
    D.toPolynomial i s = Polynomial.monomial a (D.dehom i s) := by
  have h : D.toPolynomial i s = Polynomial.monomial a ((D.toPolynomial i s).coeff a) := by
    ext n
    rw [Polynomial.coeff_monomial]
    split_ifs with h
    · rw [h]
    · exact D.toPolynomial_coeff_eq_zero_of_mem i hs (by exact_mod_cast (Ne.symm h))
  rw [h]
  congr 1
  rw [← D.eval_one_toPolynomial i s]
  conv_rhs => rw [h]
  rw [Polynomial.eval_monomial, one_pow, mul_one]

lemma coeff_smul_of_mem {a b : ℕ} {s : MvPolynomial D.ι A}
    (hs : s ∈ polynomialIntegralGrading (K := A) (I := D.ι) (a : ℤ))
    {e : D.Ambient F} (_he : e ∈ D.grading F b) (i : D.ι) :
    ((s • e) i).coeff (a + b) = D.dehom i s • (e i).coeff b := by
  rw [Ambient.smul_apply, D.toPolynomial_eq_monomial_of_mem i hs,
    PolynomialModule.monomial_smul_apply, if_pos (Nat.le_add_right a b), Nat.add_sub_cancel_left]

lemma smul_mem_grading {a b : ℤ} {s : MvPolynomial D.ι A}
    (hs : s ∈ polynomialIntegralGrading (K := A) (I := D.ι) a) {e : D.Ambient F}
    (he : e ∈ D.grading F b) : s • e ∈ D.grading F (a + b) :=
  SetLike.GradedSMul.smul_mem hs he

/-- A homogeneous element of a submodule has all its homogeneous components in it. -/
lemma decompose_mem_of_mem_grading {P : Submodule (MvPolynomial D.ι A) (D.Ambient F)} {d : ℤ}
    {y : D.Ambient F} (hyd : y ∈ D.grading F d) (hy : y ∈ P) (k : ℤ) :
    (DirectSum.decompose (D.grading F) y k : D.Ambient F) ∈ P := by
  classical
  rw [DirectSum.decompose_of_mem (D.grading F) hyd]
  by_cases h : d = k
  · subst h
    rw [DirectSum.of_eq_same]
    exact hy
  · rw [DirectSum.of_eq_of_ne _ _ _ (Ne.symm h)]
    exact zero_mem P

/-- The span of homogeneous elements is a homogeneous submodule. -/
theorem isHomogeneous_span (s : Set (D.Ambient F)) (hs : ∀ x ∈ s, ∃ k, x ∈ D.grading F k) :
    (Submodule.span (MvPolynomial D.ι A) s).IsHomogeneous (D.grading F) := by
  classical
  set P := Submodule.span (MvPolynomial D.ι A) s
  suffices H : ∀ x ∈ P, ∀ k, (DirectSum.decompose (D.grading F) x k : D.Ambient F) ∈ P from
    fun k x hx => H x hx k
  intro x hx
  induction hx using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨d, hd⟩ := hs x hx
    exact decompose_mem_of_mem_grading hd (Submodule.subset_span hx)
  | zero =>
    intro k
    rw [DirectSum.decompose_zero]
    exact zero_mem P
  | add x y _ _ hx hy =>
    intro k
    rw [DirectSum.decompose_add, DirectSum.add_apply, Submodule.coe_add]
    exact add_mem (hx k) (hy k)
  | smul r x _ hx =>
    intro k
    have hr := DirectSum.sum_support_decompose (polynomialIntegralGrading (K := A) (I := D.ι)) r
    have hxs := DirectSum.sum_support_decompose (D.grading F) x
    rw [← hr, ← hxs, Finset.sum_smul]
    simp_rw [Finset.smul_sum]
    rw [DirectSum.decompose_sum, DFinsupp.finsetSum_apply, AddSubmonoidClass.coe_finsetSum]
    refine Submodule.sum_mem _ fun a _ => ?_
    rw [DirectSum.decompose_sum, DFinsupp.finsetSum_apply, AddSubmonoidClass.coe_finsetSum]
    refine Submodule.sum_mem _ fun b _ => ?_
    exact decompose_mem_of_mem_grading
      (smul_mem_grading (DirectSum.decompose _ r a).property (DirectSum.decompose _ x b).property)
      (P.smul_mem _ (hx b)) k

end Homogeneous

section SerreModule

variable (F : X.Modules) [F.IsQuasicoherent]

/-- The chosen degree of Serre's extension of `t ∈ Γ(U_j, F)`. -/
def extDeg (j : D.ι) (t : Γ(F, D.U j)) : ℕ := (D.exists_extension F j t).choose

/-- The chosen dehomogenized components of Serre's extension of `t ∈ Γ(U_j, F)`. -/
def extSec (j : D.ι) (t : Γ(F, D.U j)) : ∀ i, Γ(F, D.U i) :=
  (D.exists_extension F j t).choose_spec.choose

/-- Serre's extension of `t ∈ Γ(U_j, F)`, an element of `Γ_*(F)` of degree `extDeg`. -/
def extElem (j : D.ι) (t : Γ(F, D.U j)) : D.Ambient F := single (D.extDeg F j t) (D.extSec F j t)

lemma extElem_isCompatible (j : D.ι) (t : Γ(F, D.U j)) : D.IsCompatible (D.extElem F j t) :=
  (D.exists_extension F j t).choose_spec.choose_spec.1

lemma extSec_self (j : D.ι) (t : Γ(F, D.U j)) : D.extSec F j t j = t :=
  (D.exists_extension F j t).choose_spec.choose_spec.2

lemma extElem_mem_grading (j : D.ι) (t : Γ(F, D.U j)) :
    D.extElem F j t ∈ D.grading F (D.extDeg F j t) :=
  single_mem_grading _ _

lemma extElem_coeff_self (j : D.ι) (t : Γ(F, D.U j)) :
    ((D.extElem F j t) j).coeff (D.extDeg F j t) = t := by
  rw [extElem, single_coeff_self, extSec_self]

variable (hF : ∀ i, Module.Finite Γ(X, D.U i) Γ(F, D.U i))

omit [F.IsQuasicoherent] in
/-- Chosen finite generators of `Γ(U_j, F)` over `Γ(U_j, 𝒪_X)`. -/
def gens (j : D.ι) : Finset Γ(F, D.U j) :=
  (@Module.Finite.fg_top _ _ _ _ _ (hF j)).choose

omit [F.IsQuasicoherent] in
lemma span_gens (j : D.ι) :
    Submodule.span Γ(X, D.U j) (D.gens F hF j : Set Γ(F, D.U j)) = ⊤ :=
  (@Module.Finite.fg_top _ _ _ _ _ (hF j)).choose_spec

/-- Serre's finite graded module: the `A[x_i]`-submodule of `Γ_*(F)` generated by the extensions
of the chosen generators (blueprint `def:sm-serre-module`). -/
def serreModule : Submodule (MvPolynomial D.ι A) (D.Ambient F) :=
  Submodule.span _ (Set.range fun p : (Σ j, (D.gens F hF j : Set Γ(F, D.U j))) =>
    D.extElem F p.1 p.2)

lemma extElem_mem_serreModule {j : D.ι} {t : Γ(F, D.U j)} (ht : t ∈ D.gens F hF j) :
    D.extElem F j t ∈ D.serreModule F hF :=
  Submodule.subset_span ⟨⟨j, ⟨t, ht⟩⟩, rfl⟩

lemma serreModule_le_gstar : D.serreModule F hF ≤ D.gstar F := by
  rw [serreModule, Submodule.span_le]
  rintro _ ⟨p, rfl⟩
  exact D.extElem_isCompatible F p.1 p.2

lemma isHomogeneous_serreModule : (D.serreModule F hF).IsHomogeneous (D.grading F) :=
  isHomogeneous_span _ (by
    rintro _ ⟨p, rfl⟩
    exact ⟨_, D.extElem_mem_grading F p.1 p.2⟩)

instance finite_serreModule : Module.Finite (MvPolynomial D.ι A) (D.serreModule F hF) :=
  Module.Finite.span_of_finite _ (Set.finite_range _)

/-- The grading of Serre's module. -/
abbrev serrePiece (k : ℤ) : Submodule A (D.serreModule F hF) :=
  homogeneousSubmodulePiece (D.grading F) (D.serreModule F hF) k

/-- The grading of Serre's module is a decomposition. -/
abbrev serreDecomposition : DirectSum.Decomposition (D.serrePiece F hF) :=
  homogeneousSubmoduleDecomposition (D.grading F) (D.serreModule F hF)
    (D.isHomogeneous_serreModule F hF)

end SerreModule

section Comparison

variable (F : X.Modules)

/-- The product `x_T = ∏_{l ∈ T} x_l` of the coordinates in `T`. -/
abbrev coordProd (T : Finset D.ι) : MvPolynomial D.ι A :=
  homogeneousCoordinateSubsetProduct (fun i => (MvPolynomial.X i : MvPolynomial D.ι A)) T

lemma coordProd_mem (T : Finset D.ι) :
    D.coordProd T ∈ polynomialIntegralGrading (K := A) (I := D.ι) (T.card : ℤ) :=
  homogeneousCoordinateSubsetProduct_degree _ _ polynomialCoordinate_X_degree T

/-- Dehomogenization at `x_j`, restricted to `U_T` (`j ∈ T`). -/
def dehomAt {T : Finset D.ι} {j : D.ι} (hj : j ∈ T) :
    MvPolynomial D.ι A →+* Γ(X, T.inf D.U) :=
  (resR (D.inf_le_U hj)).comp (D.dehom j)

lemma dehomAt_apply {T : Finset D.ι} {j : D.ι} (hj : j ∈ T) (s : MvPolynomial D.ι A) :
    D.dehomAt hj s = resR (D.inf_le_U hj) (D.dehom j s) := rfl

lemma dehom_coordProd (j : D.ι) (T : Finset D.ι) :
    D.dehom j (D.coordProd T) = ∏ l ∈ T, D.ratio j l := by
  simp [homogeneousCoordinateSubsetProduct, map_prod]

lemma isUnit_dehomAt_coordProd {T : Finset D.ι} {j : D.ι} (hj : j ∈ T) :
    IsUnit (D.dehomAt hj (D.coordProd T)) := by
  rw [dehomAt_apply, dehom_coordProd, map_prod]
  exact Finset.prod_induction _ IsUnit (fun _ _ ha hb => ha.mul hb) isUnit_one
    (fun l hl => D.isUnit_ratio_res j l (D.inf_le_U hj) (D.inf_le_U hl))

/-- `Γ(U_T, F)` as an `A[x_i]`-module through dehomogenization at `x_j`. -/
def SecAt {T : Finset D.ι} {j : D.ι} (_hj : j ∈ T) : Type u := Γ(F, T.inf D.U)

variable {T : Finset D.ι} {j : D.ι} (hj : j ∈ T)

instance : AddCommGroup (D.SecAt F hj) := inferInstanceAs (AddCommGroup Γ(F, T.inf D.U))

instance : Module (MvPolynomial D.ι A) (D.SecAt F hj) :=
  letI : Module Γ(X, T.inf D.U) (D.SecAt F hj) :=
    inferInstanceAs (Module Γ(X, T.inf D.U) Γ(F, T.inf D.U))
  Module.compHom _ (D.dehomAt hj)

variable {D F hj}

/-- The underlying section of an element of `SecAt`. -/
def SecAt.val (w : D.SecAt F hj) : Γ(F, T.inf D.U) := w

variable (D F hj) in
/-- A section of `F` over `U_T`, as an element of `SecAt`. -/
def SecAt.mk (w : Γ(F, T.inf D.U)) : D.SecAt F hj := w

@[simp] lemma SecAt.val_mk (w : Γ(F, T.inf D.U)) : (SecAt.mk D F hj w).val = w := rfl

@[simp] lemma SecAt.val_add (w w' : D.SecAt F hj) : (w + w').val = w.val + w'.val := rfl

@[simp] lemma SecAt.val_smul (s : MvPolynomial D.ι A) (w : D.SecAt F hj) :
    (s • w).val = D.dehomAt hj s • w.val := rfl

lemma SecAt.val_injective : Function.Injective (SecAt.val (D := D) (F := F) (hj := hj)) :=
  fun _ _ h => h

variable (D F hj)

lemma isUnit_algebraMap_coordProd (x : Submonoid.powers (D.coordProd T)) :
    IsUnit (algebraMap (MvPolynomial D.ι A) (Module.End (MvPolynomial D.ι A) (D.SecAt F hj)) x) := by
  obtain ⟨_, n, rfl⟩ := x
  rw [Module.End.isUnit_iff]
  obtain ⟨u, hu⟩ := (D.isUnit_dehomAt_coordProd hj).pow n
  refine Function.bijective_iff_has_inverse.mpr
    ⟨fun w => SecAt.mk D F hj (((u⁻¹ : (Γ(X, T.inf D.U))ˣ) : Γ(X, T.inf D.U)) • w.val),
      fun w => ?_, fun w => ?_⟩
  · apply SecAt.val_injective
    change ((u⁻¹ : (Γ(X, T.inf D.U))ˣ) : Γ(X, T.inf D.U)) •
      (D.dehomAt hj (D.coordProd T ^ n) • w.val) = w.val
    rw [map_pow, ← hu, smul_smul, Units.inv_mul, one_smul]
  · apply SecAt.val_injective
    change D.dehomAt hj (D.coordProd T ^ n) •
      ((((u⁻¹ : (Γ(X, T.inf D.U))ˣ) : Γ(X, T.inf D.U))) • w.val) = w.val
    rw [map_pow, ← hu, smul_smul, Units.mul_inv, one_smul]

variable [F.IsQuasicoherent] (hF : ∀ i, Module.Finite Γ(X, D.U i) Γ(F, D.U i))

/-- Dehomogenization at `x_j` followed by restriction to `U_T`, on Serre's module. -/
def evalAt : D.serreModule F hF →ₗ[MvPolynomial D.ι A] D.SecAt F hj where
  toFun m := SecAt.mk D F hj
    (resM F (D.inf_le_U hj) (PolynomialModule.eval 1 ((m : D.Ambient F) j)))
  map_add' m m' := by
    apply SecAt.val_injective
    change resM F _ (PolynomialModule.eval 1 ((m : D.Ambient F) j + (m' : D.Ambient F) j)) = _
    rw [map_add, resM_add]
    rfl
  map_smul' s m := by
    apply SecAt.val_injective
    rw [RingHom.id_apply, SecAt.val_smul, SecAt.val_mk, SecAt.val_mk]
    change resM F _ (PolynomialModule.eval 1 (D.toPolynomial j s • (m : D.Ambient F) j)) = _
    rw [PolynomialModule.eval_smul, eval_one_toPolynomial, resM_smul]
    rfl

lemma evalAt_apply (m : D.serreModule F hF) :
    (D.evalAt F hj hF m).val =
      resM F (D.inf_le_U hj) (PolynomialModule.eval 1 ((m : D.Ambient F) j)) := rfl

lemma evalAt_apply_of_mem {d : ℕ} (m : D.serreModule F hF)
    (hm : (m : D.Ambient F) ∈ D.grading F d) :
    (D.evalAt F hj hF m).val = resM F (D.inf_le_U hj) (((m : D.Ambient F) j).coeff d) := by
  rw [evalAt_apply, eval_one_of_mem_grading hm]

/-- The comparison map `M_{x_T} → Γ(U_T, F)` induced by dehomogenization at `x_j`. -/
def psiLoc : LocalizedModule (Submonoid.powers (D.coordProd T)) (D.serreModule F hF) →ₗ[MvPolynomial D.ι A]
    D.SecAt F hj :=
  LocalizedModule.lift _ (D.evalAt F hj hF) (D.isUnit_algebraMap_coordProd F hj)

/-- The defining formula of `psiLoc`: `(x_T/x_j^{|T|})^n · ψ(m / x_T^n) = m_j|_{U_T}`. -/
lemma dehomAt_pow_smul_psiLoc (m : D.serreModule F hF) (n : ℕ) :
    D.dehomAt hj (D.coordProd T) ^ n •
      (D.psiLoc F hj hF (LocalizedModule.mk m (homogeneousPowerDenominator (D.coordProd T) n))).val =
      (D.evalAt F hj hF m).val := by
  have h1 : (D.coordProd T ^ n : MvPolynomial D.ι A) •
      LocalizedModule.mk m (homogeneousPowerDenominator (D.coordProd T) n) =
      LocalizedModule.mk m 1 := by
    rw [LocalizedModule.smul'_mk]
    exact LocalizedModule.mk_cancel (homogeneousPowerDenominator (D.coordProd T) n) m
  have h2 := congrArg (fun z => (D.psiLoc F hj hF z).val) h1
  simp only [map_smul, SecAt.val_smul, map_pow] at h2
  rw [h2]
  exact congrArg SecAt.val (LinearMap.congr_fun (LocalizedModule.lift_comp
    (Submonoid.powers (D.coordProd T)) (D.evalAt F hj hF) (D.isUnit_algebraMap_coordProd F hj)) m)

end Comparison

section Pieces

variable (F : X.Modules) [F.IsQuasicoherent] (hF : ∀ i, Module.Finite Γ(X, D.U i) Γ(F, D.U i))

/-- The degree-zero part of `M_{x_T}` (Codex's coordinate diagram at `T`). -/
abbrev piece (T : Finset D.ι) :
    Submodule A (LocalizedModule (Submonoid.powers (D.coordProd T)) (D.serreModule F hF)) :=
  localizedHomogeneousModulePiece (polynomialIntegralGrading (K := A) (I := D.ι))
    (D.serrePiece F hF) (D.coordProd T) (T.card : ℤ) (D.coordProd_mem T) 0

variable {T : Finset D.ι} {j : D.ι} (hj : j ∈ T)

/-- The comparison map `(M_{x_T})_0 → Γ(U_T, F)` computed in the chart `x_j`, `j ∈ T`. -/
def psiAt : D.piece F hF T →ₗ[A] sectionsModuleCat F c (T.inf D.U) le_top where
  toFun z := (D.psiLoc F hj hF z.val).val
  map_add' z z' := by
    change (D.psiLoc F hj hF (z.val + z'.val)).val = _
    rw [map_add]
    rfl
  map_smul' a z := by
    change (D.psiLoc F hj hF (a • z.val)).val =
      sectionsRingHom c (le_top : T.inf D.U ≤ ⊤) a • (D.psiLoc F hj hF z.val).val
    rw [← algebraMap_smul (MvPolynomial D.ι A) a z.val, map_smul, SecAt.val_smul,
      MvPolynomial.algebraMap_eq, dehomAt_apply, dehom_C, resR_const]

/-- The underlying section of a value of `psiAt`. -/
abbrev toSections {V : X.Opens} (w : sectionsModuleCat F c V le_top) : Γ(F, V) := w

lemma psiAt_apply (z : D.piece F hF T) :
    toSections F (D.psiAt F hF hj z) = (D.psiLoc F hj hF z.val).val := rfl

lemma natCast_mul_card (n : ℕ) : (((n * T.card : ℕ)) : ℤ) = 0 + (n : ℤ) * (T.card : ℤ) := by
  push_cast
  ring

/-- Elements of the degree-zero part are fractions `m / x_T^n` with `m` of degree `n |T|`. -/
lemma exists_mk_of_mem_piece (z : D.piece F hF T) :
    ∃ (n : ℕ) (m : D.serreModule F hF), (m : D.Ambient F) ∈ D.grading F ((n * T.card : ℕ) : ℤ) ∧
      LocalizedModule.mk m (homogeneousPowerDenominator (D.coordProd T) n) = z.val := by
  obtain ⟨n, m, hm, hz⟩ := z.property
  refine ⟨n, m, ?_, hz⟩
  rw [natCast_mul_card]
  exact hm

/-- The defining formula of `psiAt` on a fraction `m / x_T^n`. -/
lemma dehomAt_pow_smul_psiAt (z : D.piece F hF T) (n : ℕ) (m : D.serreModule F hF)
    (hm : (m : D.Ambient F) ∈ D.grading F ((n * T.card : ℕ) : ℤ))
    (hz : LocalizedModule.mk m (homogeneousPowerDenominator (D.coordProd T) n) = z.val) :
    D.dehomAt hj (D.coordProd T) ^ n • toSections F (D.psiAt F hF hj z) =
      resM F (D.inf_le_U hj) (((m : D.Ambient F) j).coeff (n * T.card)) := by
  rw [psiAt_apply, ← hz, dehomAt_pow_smul_psiLoc, D.evalAt_apply_of_mem F hj hF m hm]

lemma dehomAt_coordProd_eq {j' : D.ι} (hj' : j' ∈ T) :
    D.dehomAt hj (D.coordProd T) =
      resR (D.inf_le_U hj) (D.ratio j j') ^ T.card * D.dehomAt hj' (D.coordProd T) := by
  rw [dehomAt_apply, dehomAt_apply, dehom_coordProd, dehom_coordProd, map_prod, map_prod,
    ← Finset.prod_const, ← Finset.prod_mul_distrib]
  refine Finset.prod_congr rfl fun l _ => ?_
  exact (D.ratio_mul_res j j' l (D.inf_le_U hj) (D.inf_le_U hj')).symm

omit [F.IsQuasicoherent] in
lemma smul_left_injective_of_isUnit {V : X.Opens} {r : Γ(X, V)} (hr : IsUnit r)
    {w w' : Γ(F, V)} (h : r • w = r • w') : w = w' :=
  (hr.smul_left_cancel).mp h

/-- `psiAt` does not depend on the chart (blueprint `lem:sm-serre-comparison`). -/
lemma psiAt_eq {j' : D.ι} (hj' : j' ∈ T) (z : D.piece F hF T) :
    D.psiAt F hF hj z = D.psiAt F hF hj' z := by
  obtain ⟨n, m, hm, hz⟩ := D.exists_mk_of_mem_piece F hF z
  have h := D.dehomAt_pow_smul_psiAt F hF hj z n m hm hz
  have h' := D.dehomAt_pow_smul_psiAt F hF hj' z n m hm hz
  have hc := ((D.serreModule_le_gstar F hF) m.property).res j j' (D.inf_le_U hj)
    (D.inf_le_U hj') (n * T.card)
  rw [hc, ← h', smul_smul, D.dehomAt_coordProd_eq hj hj', mul_pow, ← pow_mul,
    mul_comm T.card n] at h
  have hu : IsUnit (resR (D.inf_le_U hj) (D.ratio j j') ^ (n * T.card) *
      D.dehomAt hj' (D.coordProd T) ^ n) :=
    ((D.isUnit_ratio_res j j' (D.inf_le_U hj) (D.inf_le_U hj')).pow _).mul
      ((D.isUnit_dehomAt_coordProd hj').pow n)
  exact smul_left_injective_of_isUnit F hu h

lemma coordProd_pow_mem (T : Finset D.ι) (N : ℕ) :
    D.coordProd T ^ N ∈ polynomialIntegralGrading (K := A) (I := D.ι) ((N * T.card : ℕ) : ℤ) := by
  have := SetLike.pow_mem_graded N (D.coordProd_mem T)
  convert this using 2
  push_cast
  simp

lemma X_pow_mem (j : D.ι) (N : ℕ) :
    (MvPolynomial.X j : MvPolynomial D.ι A) ^ N ∈
      polynomialIntegralGrading (K := A) (I := D.ι) (N : ℤ) := by
  have := SetLike.pow_mem_graded N (polynomialCoordinate_X_degree (K := A) j)
  convert this using 2
  simp

lemma dehom_X_pow (i j : D.ι) (N : ℕ) :
    D.dehom i ((MvPolynomial.X j : MvPolynomial D.ι A) ^ N) = D.ratio i j ^ N := by
  rw [map_pow, dehom_X]

/-- `psiAt` has trivial kernel. -/
theorem eq_zero_of_psiAt_eq_zero (z : D.piece F hF T) (hz : D.psiAt F hF hj z = 0) : z = 0 := by
  classical
  obtain ⟨n, m, hm, hmz⟩ := D.exists_mk_of_mem_piece F hF z
  have h := D.dehomAt_pow_smul_psiAt F hF hj z n m hm hmz
  rw [hz] at h
  change D.dehomAt hj (D.coordProd T) ^ n • (0 : Γ(F, T.inf D.U)) = _ at h
  rw [smul_zero] at h
  -- the `j`-th component of `m` is killed by a power of `x_T / x_j^{|T|}`
  obtain ⟨N, hN⟩ := exists_pow_smul_eq_zero F (D.isAffineOpen j) (∏ l ∈ T, D.ratio j l)
    (D.inf_eq_basicOpen_prod hj) _ h.symm
  set e : D.Ambient F := D.coordProd T ^ N • (m : D.Ambient F) with he_def
  have he_mem : e ∈ D.grading F (((N * T.card : ℕ) : ℤ) + ((n * T.card : ℕ) : ℤ)) :=
    smul_mem_grading (D.coordProd_pow_mem T N) hm
  have he_mem' : e ∈ D.grading F ((N * T.card + n * T.card : ℕ) : ℤ) := by
    push_cast at he_mem ⊢
    exact he_mem
  have hej : e j = 0 := by
    refine eq_zero_of_mem_grading he_mem' ?_
    rw [he_def, coeff_smul_of_mem (D.coordProd_pow_mem T N) hm, map_pow, dehom_coordProd, hN]
  have he_compat : D.IsCompatible e :=
    (D.serreModule_le_gstar F hF) ((D.serreModule F hF).smul_mem (D.coordProd T ^ N) m.property)
  -- every component of `e` is killed by a power of `x_j / x_i`
  have hi : ∀ i, ∃ Ni : ℕ, D.ratio i j ^ Ni • (e i).coeff (N * T.card + n * T.card) = 0 := by
    intro i
    refine exists_pow_smul_eq_zero F (D.isAffineOpen i) (D.ratio i j) (D.inf_eq_basicOpen i j)
      _ ?_
    have := he_compat i j (N * T.card + n * T.card)
    rw [hej] at this
    rw [this]
    change _ • resM F _ (0 : Γ(F, D.U j)) = 0
    rw [resM_zero, smul_zero]
  choose Ni hNi using hi
  obtain ⟨M, hM⟩ : ∃ M : ℕ, ∀ i, Ni i ≤ M :=
    ⟨Finset.univ.sup Ni, fun i => Finset.le_sup (Finset.mem_univ i)⟩
  have he' : (MvPolynomial.X j : MvPolynomial D.ι A) ^ M • e = 0 := by
    have hmem : (MvPolynomial.X j : MvPolynomial D.ι A) ^ M • e ∈
        D.grading F ((M + (N * T.card + n * T.card) : ℕ) : ℤ) := by
      have := smul_mem_grading (D.X_pow_mem j M) he_mem'
      push_cast at this ⊢
      exact this
    ext i : 1
    refine eq_zero_of_mem_grading hmem ?_
    rw [coeff_smul_of_mem (D.X_pow_mem j M) he_mem', dehom_X_pow,
      ← Nat.sub_add_cancel (hM i), pow_add, mul_smul, hNi i, smul_zero]
  -- hence `x_T^{M + N} m = 0`
  have hkill : (D.coordProd T ^ (M + N) : MvPolynomial D.ι A) • m = 0 := by
    apply Subtype.ext
    rw [Submodule.coe_smul, Submodule.coe_zero]
    have hfac : D.coordProd T =
        (MvPolynomial.X j : MvPolynomial D.ι A) * D.coordProd (T.erase j) := by
      simp only [homogeneousCoordinateSubsetProduct]
      rw [Finset.mul_prod_erase T (fun i => (MvPolynomial.X i : MvPolynomial D.ι A)) hj]
    rw [pow_add, mul_smul, ← he_def]
    conv_lhs => rw [hfac, mul_pow, mul_comm, mul_smul, he', smul_zero]
  apply Subtype.ext
  rw [← hmz, Submodule.coe_zero, ← LocalizedModule.zero_mk 1]
  rw [LocalizedModule.mk_eq]
  refine ⟨⟨D.coordProd T ^ (M + N), M + N, rfl⟩, ?_⟩
  rw [one_smul, smul_zero, smul_zero]
  exact hkill


/-- `psiAt` is injective (blueprint `lem:sm-serre-comparison`). -/
theorem psiAt_injective : Function.Injective (D.psiAt F hF hj) := by
  intro z z' h
  have h0 : D.psiAt F hF hj (z + (-1 : A) • z') = 0 := by
    rw [map_add, map_smul, h, neg_one_smul, add_neg_cancel]
  have hz := D.eq_zero_of_psiAt_eq_zero F hF hj _ h0
  have hc : (-1 : A) • z' + z' = 0 := by
    nth_rewrite 2 [← one_smul A z']
    rw [← add_smul, neg_add_cancel, zero_smul]
  calc z = z + ((-1 : A) • z' + z') := by rw [hc, add_zero]
    _ = (z + (-1 : A) • z') + z' := (add_assoc _ _ _).symm
    _ = z' := by rw [hz, zero_add]


lemma dehomAt_coordProd_eq_erase :
    D.dehomAt hj (D.coordProd T) = resR (D.inf_le_U hj) (D.dehom j (D.coordProd (T.erase j))) := by
  classical
  rw [dehomAt_apply, dehom_coordProd, dehom_coordProd,
    ← Finset.mul_prod_erase T (fun l => D.ratio j l) hj, D.ratio_self, one_mul]

lemma monomial_mem (μ : D.ι →₀ ℕ) (r : A) :
    MvPolynomial.monomial μ r ∈
      polynomialIntegralGrading (K := A) (I := D.ι) ((Finsupp.degree μ : ℕ) : ℤ) := by
  rw [MvPolynomial.mem_weightedHomogeneousSubmodule]
  convert MvPolynomial.isWeightedHomogeneous_monomial (fun _ : D.ι => (1 : ℤ)) μ r rfl
  rw [Finsupp.weight_apply, Finsupp.degree_apply, Finsupp.sum, Nat.cast_sum]
  simp

/-- Every element `w` with `(x_T/x_j^{|T|})^a w = (q · g)|_{U_T}`, `q` a dehomogenized monomial and
`g` a chosen generator, is a value of `psiAt`. -/
lemma exists_psiAt_eq_of_monomial {g : Γ(F, D.U j)} (hg : g ∈ D.gens F hF j) (μ : D.ι →₀ ℕ)
    (r : A) (a : ℕ) (w : Γ(F, T.inf D.U))
    (hw : D.dehomAt hj (D.coordProd T) ^ a • w =
      resM F (D.inf_le_U hj) (D.dehom j (MvPolynomial.monomial μ r) • g)) :
    ∃ z, toSections F (D.psiAt F hF hj z) = w := by
  classical
  obtain ⟨e, he⟩ : ∃ e, e = Finsupp.degree μ := ⟨_, rfl⟩
  obtain ⟨N, hN⟩ : ∃ N, N = D.extDeg F j g := ⟨_, rfl⟩
  obtain ⟨k, hk⟩ : ∃ k, k = (T.erase j).card := ⟨_, rfl⟩
  have hcard : T.card = k + 1 := by rw [hk]; exact (Finset.card_erase_add_one hj).symm
  have hQ := D.monomial_mem μ r
  rw [← he] at hQ
  set P : MvPolynomial D.ι A := MvPolynomial.monomial μ r * D.coordProd (T.erase j) ^ (e + N) *
    (MvPolynomial.X j : MvPolynomial D.ι A) ^ (a * T.card) with hP_def
  have hP : P ∈ polynomialIntegralGrading (K := A) (I := D.ι)
      ((e + (e + N) * k + a * T.card : ℕ) : ℤ) := by
    have h1 := SetLike.mul_mem_graded (SetLike.mul_mem_graded hQ
      (D.coordProd_pow_mem (T.erase j) (e + N))) (D.X_pow_mem j (a * T.card))
    rw [← hk] at h1
    convert h1 using 2
    push_cast
    ring
  have hσ := D.extElem_mem_grading F j g
  rw [← hN] at hσ
  have hdeg : e + (e + N) * k + a * T.card + N = (a + e + N) * T.card := by
    rw [hcard]
    ring
  have hmA : P • D.extElem F j g ∈ D.serreModule F hF :=
    (D.serreModule F hF).smul_mem P (D.extElem_mem_serreModule F hF hg)
  set m : D.serreModule F hF := ⟨P • D.extElem F j g, hmA⟩ with hm_def
  have hm_grad : (m : D.Ambient F) ∈ D.grading F (((a + e + N) * T.card : ℕ) : ℤ) := by
    have := smul_mem_grading hP hσ
    rw [← hdeg]
    push_cast at this ⊢
    exact this
  have hz_mem : LocalizedModule.mk m (homogeneousPowerDenominator (D.coordProd T) (a + e + N)) ∈
      D.piece F hF T :=
    ⟨a + e + N, m, by rw [← natCast_mul_card]; exact hm_grad, rfl⟩
  refine ⟨⟨_, hz_mem⟩, ?_⟩
  have h := D.dehomAt_pow_smul_psiAt F hF hj ⟨_, hz_mem⟩ (a + e + N) m hm_grad rfl
  have hcoeff : ((m : D.Ambient F) j).coeff ((a + e + N) * T.card) =
      D.dehom j P • g := by
    rw [← hdeg]
    change ((P • D.extElem F j g) j).coeff (e + (e + N) * k + a * T.card + N) = _
    rw [coeff_smul_of_mem hP hσ, hN, extElem_coeff_self]
  rw [hcoeff, hP_def, map_mul, map_mul, map_pow, dehom_X_pow, D.ratio_self, one_pow, mul_one,
    mul_comm, mul_smul, resM_smul, map_pow, ← D.dehomAt_coordProd_eq_erase hj, ← hw, smul_smul,
    ← pow_add] at h
  have hn : e + N + a = a + e + N := by ring
  rw [hn] at h
  exact smul_left_injective_of_isUnit F ((D.isUnit_dehomAt_coordProd hj).pow _) h

/-- `psiAt` is surjective (blueprint `lem:sm-serre-comparison`). -/
theorem psiAt_surjective : Function.Surjective (D.psiAt F hF hj) := by
  classical
  intro w
  obtain ⟨a, t₀, ht₀⟩ := exists_res_eq_smul F (D.isAffineOpen j) (∏ l ∈ T, D.ratio j l)
    (D.inf_eq_basicOpen_prod hj) (toSections F w)
  have hβ : resR ((D.inf_eq_basicOpen_prod hj).le.trans (X.basicOpen_le _))
      (∏ l ∈ T, D.ratio j l) = D.dehomAt hj (D.coordProd T) := by
    rw [dehomAt_apply, dehom_coordProd]
  rw [hβ] at ht₀
  have ht : t₀ ∈ Submodule.span Γ(X, D.U j) (D.gens F hF j : Set Γ(F, D.U j)) := by
    rw [span_gens]
    trivial
  obtain ⟨f, -, hf⟩ := Submodule.mem_span_finset.mp ht
  choose P hP using fun g => D.dehom_surjective j (f g)
  obtain ⟨u, hu⟩ := (D.isUnit_dehomAt_coordProd hj).pow a
  let R := LinearMap.range (D.psiAt F hF hj)
  have key : ∀ g ∈ D.gens F hF j, ∀ (μ : D.ι →₀ ℕ) (r : A),
      (((u⁻¹ : (Γ(X, T.inf D.U))ˣ) : Γ(X, T.inf D.U)) •
        resM F (D.inf_le_U hj) (D.dehom j (MvPolynomial.monomial μ r) • g) :
          sectionsModuleCat F c (T.inf D.U) le_top) ∈ R := by
    intro g hg μ r
    obtain ⟨z, hz⟩ := D.exists_psiAt_eq_of_monomial F hF hj hg μ r a _ (by
      rw [← hu, smul_smul, Units.mul_inv, one_smul])
    exact ⟨z, hz⟩
  have hw : toSections F w = ∑ g ∈ D.gens F hF j, ∑ μ ∈ (P g).support,
      ((u⁻¹ : (Γ(X, T.inf D.U))ˣ) : Γ(X, T.inf D.U)) •
        resM F (D.inf_le_U hj)
          (D.dehom j (MvPolynomial.monomial μ (MvPolynomial.coeff μ (P g))) • g) := by
    have h1 : toSections F w = ((u⁻¹ : (Γ(X, T.inf D.U))ˣ) : Γ(X, T.inf D.U)) •
        resM F (D.inf_le_U hj) t₀ := by
      rw [ht₀, ← hu, smul_smul, Units.inv_mul, one_smul]
    rw [h1, ← hf, resM_sum, Finset.smul_sum]
    refine Finset.sum_congr rfl fun g _ => ?_
    rw [← hP g]
    conv_lhs => rw [MvPolynomial.as_sum (P g)]
    rw [map_sum, Finset.sum_smul, resM_sum, Finset.smul_sum]
  have : (w : sectionsModuleCat F c (T.inf D.U) le_top) ∈ R := by
    change toSections F w ∈ R
    rw [hw]
    exact Submodule.sum_mem _ fun g hg => Submodule.sum_mem _ fun μ _ => key g hg μ _
  exact this


omit hj in
/-- `psiAt` is compatible with the restrictions of the two diagrams. -/
lemma psiAt_naturality {S T : Finset D.ι} (hST : S ⊆ T) {j : D.ι} (hjS : j ∈ S)
    (z : D.piece F hF S) :
    toSections F (D.psiAt F hF (hST hjS)
      (homogeneousCoordinateSubsetRestriction (polynomialIntegralGrading (K := A) (I := D.ι))
        (D.serrePiece F hF) (fun i => (MvPolynomial.X i : MvPolynomial D.ι A))
        polynomialCoordinate_X_degree hST 0 z)) =
      resM F (Finset.inf_mono hST) (toSections F (D.psiAt F hF hjS z)) := by
  classical
  obtain ⟨n, m, hm, hmz⟩ := D.exists_mk_of_mem_piece F hF z
  set c' : MvPolynomial D.ι A := D.coordProd (T \ S) with hc'
  have hy : D.coordProd T = D.coordProd S * c' :=
    homogeneousCoordinateSubsetProduct_factor _ hST
  have hcard : (T \ S).card + S.card = T.card := Finset.card_sdiff_add_card_eq_card hST
  have hidx : ((n * (T \ S).card : ℕ) : ℤ) + ((n * S.card : ℕ) : ℤ) = ((n * T.card : ℕ) : ℤ) := by
    rw [← hcard]
    push_cast
    ring
  have hm' : ((c' ^ n • m : D.serreModule F hF) : D.Ambient F) ∈
      D.grading F ((n * T.card : ℕ) : ℤ) := by
    have h := smul_mem_grading (D.coordProd_pow_mem (T \ S) n) hm
    rw [hidx] at h
    exact h
  have hval : (homogeneousCoordinateSubsetRestriction (polynomialIntegralGrading (K := A) (I := D.ι))
        (D.serrePiece F hF) (fun i => (MvPolynomial.X i : MvPolynomial D.ι A))
        polynomialCoordinate_X_degree hST 0 z).val =
      LocalizedModule.mk (c' ^ n • m) (homogeneousPowerDenominator (D.coordProd T) n) := by
    change actualLocalizedModuleDivisorRestriction (D.coordProd S) (D.coordProd T)
      (homogeneousCoordinateSubsetProduct_dvd _ hST) z.val = _
    rw [← hmz]
    exact actualLocalizedModuleDivisorRestriction_mk _ _ _ hy m n
  have hT := D.dehomAt_pow_smul_psiAt F hF (hST hjS) _ n (c' ^ n • m) hm' hval.symm
  have hS := D.dehomAt_pow_smul_psiAt F hF hjS z n m hm hmz
  have hcoeff : (((c' ^ n • m : D.serreModule F hF) : D.Ambient F) j).coeff (n * T.card) =
      D.dehom j (c' ^ n) • ((m : D.Ambient F) j).coeff (n * S.card) := by
    have hnat : n * T.card = n * (T \ S).card + n * S.card := by
      rw [← hcard]
      ring
    rw [hnat]
    exact coeff_smul_of_mem (D.coordProd_pow_mem (T \ S) n) hm j
  rw [hcoeff] at hT
  have hβ : resR (D.inf_le_U (hST hjS)) (D.dehom j c') *
      resR ((Finset.inf_mono hST).trans (D.inf_le_U hjS)) (D.dehom j (D.coordProd S)) =
      D.dehomAt (hST hjS) (D.coordProd T) := by
    rw [dehomAt_apply, hy, map_mul, map_mul, mul_comm]
  have h2 : resM F (D.inf_le_U (hST hjS))
      (D.dehom j (c' ^ n) • ((m : D.Ambient F) j).coeff (n * S.card)) =
      D.dehomAt (hST hjS) (D.coordProd T) ^ n •
        resM F (Finset.inf_mono hST) (toSections F (D.psiAt F hF hjS z)) := by
    rw [resM_smul, ← resM_resM (D.inf_le_U hjS) (Finset.inf_mono hST), ← hS, resM_smul,
      dehomAt_apply]
    simp only [map_pow]
    rw [resR_resR, smul_smul, ← mul_pow, hβ]
  exact smul_left_injective_of_isUnit F ((D.isUnit_dehomAt_coordProd (hST hjS)).pow n)
    (hT.trans h2)

end Pieces

section Assembly

variable (F : X.Modules) [F.IsQuasicoherent] (hF : ∀ i, Module.Finite Γ(X, D.U i) Γ(F, D.U i))

/-- Codex's coordinate Čech diagram of Serre's module in degree `0`. -/
abbrev serreDiagram : Finset D.ι ⥤ ModuleCat.{u} A :=
  homogeneousCoordinateSubsetDiagram (polynomialIntegralGrading (K := A) (I := D.ι))
    (D.serrePiece F hF) (fun i => (MvPolynomial.X i : MvPolynomial D.ι A))
    polynomialCoordinate_X_degree 0

/-- The comparison isomorphisms `(M_{x_T})_0 ≅ Γ(U_T, F)` on nonempty `T`
(blueprint `lem:sm-serre-comparison`). -/
def comparisonIso (T : Finset D.ι) (hT : T.Nonempty) :
    (D.serreDiagram F hF).obj T ≅ (cechDiagram F D.U c).obj T :=
  (LinearEquiv.ofBijective (D.psiAt F hF (T.min'_mem hT))
    ⟨D.psiAt_injective F hF _, D.psiAt_surjective F hF _⟩).toModuleIso

lemma comparisonIso_naturality (S T : Finset D.ι) (hS : S.Nonempty) (hT : T.Nonempty)
    (hST : S ⊆ T) :
    (D.serreDiagram F hF).map (homOfLE hST) ≫ (D.comparisonIso F hF T hT).hom =
      (D.comparisonIso F hF S hS).hom ≫ (cechDiagram F D.U c).map (homOfLE hST) := by
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro z
  change toSections F (D.psiAt F hF (T.min'_mem hT)
      (homogeneousCoordinateSubsetRestriction (polynomialIntegralGrading (K := A) (I := D.ι))
        (D.serrePiece F hF) (fun i => (MvPolynomial.X i : MvPolynomial D.ι A))
        polynomialCoordinate_X_degree hST 0 z)) =
    resM F (Finset.inf_mono hST) (toSections F (D.psiAt F hF (S.min'_mem hS) z))
  exact (congrArg (toSections F) (D.psiAt_eq F hF (T.min'_mem hT) (hST (S.min'_mem hS)) _)).trans
    (D.psiAt_naturality F hF hST (S.min'_mem hS) z)

include hF in
/-- **Finiteness of Čech cohomology** for projective coordinates (blueprint
`thm:sm-finite-coordinates`): if `A` is Noetherian and `F` is quasi-coherent with finite sections
on the coordinate opens, every `Ȟ^p(U, F)` is a finite `A`-module. -/
theorem finite_cechCohomology [IsNoetherianRing A] (p : ℕ) :
    Module.Finite A (cechCohomology F D.U c p) := by
  let _ := D.serreDecomposition F hF
  have h := finiteGradedPolynomialCoordinateCech_homology_finite (K := A) (I := D.ι)
    (M := D.serreModule F hF) (D.serrePiece F hF) 0 p
  have : Module.Finite A ((subsetCechComplex (D.serreDiagram F hF)).homology p) := h
  let e := SubsetNonemptyComparison.complexIso (D.serreDiagram F hF) (cechDiagram F D.U c)
    (D.comparisonIso F hF) (D.comparisonIso_naturality F hF)
