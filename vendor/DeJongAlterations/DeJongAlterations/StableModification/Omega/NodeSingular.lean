import DeJongAlterations.StableModification.Omega.Node
import Mathlib.RingTheory.Smooth.Locus
import Mathlib.RingTheory.Spectrum.Prime.FreeLocus

/-!
# The smooth locus of a node chart and `ω_{X/S}` on node charts

On the node model `A = R[u,v]/(uv - h)` (`h` a non-zero-divisor) the smooth locus over `R` is
exactly `D(u) ∪ D(v)`: the coordinate charts are smooth (`NodeChart.basicOpen_coord_le_smoothLocus`)
and the points of `V(u, v)` are not. Consequently the dualizing sheaf
`ω_{X/S} = j_*(Ω¹_{X/S}|_{smooth locus})` (blueprint `def:sm-omega`) has, over every basic open
`D(g)` of a node chart, sections free of rank one, generated by `du/u = -dv/v`
(blueprint `prop:sm-omega-node`, M. Temkin, *Stable modification of relative curves*, §1.2,
T:1691–1712; PLAN-SM-GEOM chapter M).

## Non-smoothness at `V(u, v)`

The argument is elementary and works over any base ring `R`:

* if `A` were smooth at a prime `q ⊇ (u, v)`, then `Ω_{A/R}` would be free near `q`
  (`Algebra.smoothLocus_eq_compl_support_inter`), and its rank would be the rank at a minimal
  prime `p₀ ⊆ q`; since `u` is a non-zero-divisor, `u ∉ p₀`, and there `Ω` is free on `du`,
  so the rank would be one (`rankAtStalk_eq_one_of_bijective`);
* but the two derivations `∂/∂u, ∂/∂v : A → κ(q)` (well defined because `u dv + v du = 0`
  vanishes modulo `q`) show that `du, dv` are independent in `Ω ⊗ κ(q)`
  (`rankAtStalk_ne_one_of_derivations`).

Main declarations:

* `nodeDerivationOfValues`: derivations of `R[u,v]/(uv - h)` with prescribed values.
* `not_mem_smoothLocus_of_derivations`: the abstract criterion.
* `NodeChart.not_mem_smoothLocus`, `NodeChart.inf_smoothLocus`:
  `W ∩ smoothLocus = D(x₀) ∪ D(x₁)` on a node chart `W`.
* `dualizingSheafSectionsEquiv_smul`: the identification `Γ(ω, W) ≃ Γ(Ω¹, W ∩ U)` is linear.
* `NodeChart.exists_dualizing_generator`: `Γ(ω_{X/S}, D(g))` is free of rank one over
  `Γ(X, D(g))` for every `g ∈ Γ(X, W)`.
-/

noncomputable section

open AlgebraicGeometry CategoryTheory Opposite TopologicalSpace

universe u

namespace DeJongAlterations.StableModification.Omega

open DeJongAlterations.Algebra.NodeBlowupChart

section Values

variable {R : Type u} [CommRing R] (h : R) {N : Type*} [CommRing N] [Algebra (Node R h) N]
  [Algebra R N] [IsScalarTower R (Node R h) N]

/-- A derivation of the node algebra with prescribed values on the coordinates, provided the
values satisfy the differentiated relation `x₀ dx₁ + x₁ dx₀ = 0`. -/
def nodeDerivationOfValues (F : Fin 2 → N)
    (hF : algebraMap (Node R h) N (coordinate h 0) * F 1 +
      algebraMap (Node R h) N (coordinate h 1) * F 0 = 0) :
    {D : Derivation R (Node R h) N // ∀ i, D (coordinate h i) = F i} :=
  let P := MvPolynomial (Fin 2) R
  let I := DeJongAlterations.Algebra.NodeChart.uChartIdeal R h
  letI : Algebra P N := ((algebraMap (Node R h) N).comp (Ideal.Quotient.mk I)).toAlgebra
  haveI : IsScalarTower R P N := IsScalarTower.of_algebraMap_eq (fun r =>
    IsScalarTower.algebraMap_apply R (Node R h) N r)
  let D₀ : Derivation R P N := MvPolynomial.mkDerivation R F
  have hD₀ : ∀ p ∈ I, D₀ p = 0 := by
    intro p hp
    obtain ⟨q, rfl⟩ := Ideal.mem_span_singleton'.mp hp
    rw [Derivation.leibniz]
    have hf : D₀ (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h) = 0 := by
      rw [map_sub, Derivation.leibniz, MvPolynomial.mkDerivation_X, MvPolynomial.mkDerivation_X,
        MvPolynomial.derivation_C, sub_zero, Algebra.smul_def, Algebra.smul_def]
      exact hF
    have hq : algebraMap P N (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h) = 0 := by
      change algebraMap (Node R h) N (Ideal.Quotient.mk I _) = 0
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr
        (show _ ∈ I from Ideal.mem_span_singleton_self _), map_zero]
    rw [hf, smul_zero, zero_add, Algebra.smul_def, hq, zero_mul]
  let L : Node R h →ₗ[R] N := (I.restrictScalars R).liftQ D₀.toLinearMap (fun p hp => hD₀ p hp)
  ⟨Derivation.mk' L (by
    intro a b
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective a
    obtain ⟨q, rfl⟩ := Ideal.Quotient.mk_surjective b
    rw [← map_mul]
    change D₀ (p * q) = Ideal.Quotient.mk I p • D₀ q + Ideal.Quotient.mk I q • D₀ p
    rw [Derivation.leibniz, Algebra.smul_def, Algebra.smul_def,
      Algebra.smul_def (Ideal.Quotient.mk I p), Algebra.smul_def (Ideal.Quotient.mk I q)]
    rfl), by
    intro i
    change D₀ (MvPolynomial.X i) = F i
    rw [MvPolynomial.mkDerivation_X]⟩

end Values


section Rank

variable {R : Type u} [CommRing R] (h : R)

/-- An element of `A` outside a prime `q` acts invertibly on the residue field `κ(q)`. -/
theorem isUnit_algebraMap_end_residueField {A : Type*} [CommRing A] (q : Ideal A) [q.IsPrime]
    (s : q.primeCompl) : IsUnit (algebraMap A (Module.End A q.ResidueField) s) := by
  have hs : IsUnit (algebraMap A q.ResidueField s) := by
    refine isUnit_iff_ne_zero.mpr ?_
    rw [Ne, Ideal.algebraMap_residueField_eq_zero]
    exact s.2
  rw [Module.End.isUnit_iff]
  refine ⟨fun x y hxy => ?_, fun y => ⟨hs.unit⁻¹.val * y, ?_⟩⟩
  · change (s : A) • x = (s : A) • y at hxy
    rw [Algebra.smul_def, Algebra.smul_def] at hxy
    exact hs.mul_left_cancel hxy
  · change (s : A) • (hs.unit⁻¹.val * y) = y
    rw [Algebra.smul_def, ← mul_assoc, IsUnit.mul_val_inv, one_mul]

variable {A : Type*} [CommRing A] [Algebra R A]

/-- **Rank of `Ω` at a singular point.** If two derivations `D₀, D₁ : A → κ(q)` satisfy
`D₀ u = 1`, `D₀ v = 0`, `D₁ v = 1`, then the stalk of `Ω_{A/R}` at `q` is not free of rank one. -/
theorem rankAtStalk_ne_one_of_derivations (q : PrimeSpectrum A) (u v : A)
    (D₀ D₁ : Derivation R A q.asIdeal.ResidueField) (h00 : D₀ u = 1) (h01 : D₀ v = 0)
    (h11 : D₁ v = 1) (hfree : q ∈ Module.freeLocus A Ω[A⁄R]) :
    Module.rankAtStalk Ω[A⁄R] q ≠ 1 := by
  intro hr
  have : Module.Free (Localization.AtPrime q.asIdeal)
      (LocalizedModule q.asIdeal.primeCompl Ω[A⁄R]) := hfree
  have hr' : Module.finrank (Localization.AtPrime q.asIdeal)
      (LocalizedModule q.asIdeal.primeCompl Ω[A⁄R]) = 1 := hr
  have : Module.Finite (Localization.AtPrime q.asIdeal)
      (LocalizedModule q.asIdeal.primeCompl Ω[A⁄R]) :=
    Module.finite_of_finrank_pos (by rw [hr']; exact Nat.one_pos)
  let b := Module.finBasisOfFinrankEq (Localization.AtPrime q.asIdeal)
    (LocalizedModule q.asIdeal.primeCompl Ω[A⁄R]) hr'
  have hb : ∀ m : LocalizedModule q.asIdeal.primeCompl Ω[A⁄R], m = b.repr m 0 • b 0 := by
    intro m
    conv_lhs => rw [← b.sum_repr m]
    rw [Fin.sum_univ_one]
  let L : Derivation R A q.asIdeal.ResidueField →
      (LocalizedModule q.asIdeal.primeCompl Ω[A⁄R] →ₗ[Localization.AtPrime q.asIdeal]
        q.asIdeal.ResidueField) := fun D =>
    (IsLocalizedModule.lift q.asIdeal.primeCompl
      (LocalizedModule.mkLinearMap q.asIdeal.primeCompl Ω[A⁄R]) D.liftKaehlerDifferential
      (isUnit_algebraMap_end_residueField q.asIdeal)).extendScalarsOfIsLocalization
      q.asIdeal.primeCompl (Localization.AtPrime q.asIdeal)
  have hL : ∀ (D : Derivation R A q.asIdeal.ResidueField) (a : A),
      L D (LocalizedModule.mkLinearMap q.asIdeal.primeCompl Ω[A⁄R]
        (KaehlerDifferential.D R A a)) = D a := by
    intro D a
    change IsLocalizedModule.lift q.asIdeal.primeCompl
      (LocalizedModule.mkLinearMap q.asIdeal.primeCompl Ω[A⁄R]) D.liftKaehlerDifferential
      (isUnit_algebraMap_end_residueField q.asIdeal)
      (LocalizedModule.mkLinearMap q.asIdeal.primeCompl Ω[A⁄R]
        (KaehlerDifferential.D R A a)) = _
    rw [IsLocalizedModule.lift_apply, Derivation.liftKaehlerDifferential_comp_D]
  have key : ∀ (D : Derivation R A q.asIdeal.ResidueField) (a : A),
      algebraMap (Localization.AtPrime q.asIdeal) q.asIdeal.ResidueField
        (b.repr (LocalizedModule.mkLinearMap q.asIdeal.primeCompl Ω[A⁄R]
          (KaehlerDifferential.D R A a)) 0) * L D (b 0) = D a := by
    intro D a
    rw [← Algebra.smul_def, ← (L D).map_smul, ← hb]
    exact hL D a
  have e00 := key D₀ u
  have e01 := key D₀ v
  have e11 := key D₁ v
  rw [h00] at e00
  rw [h01] at e01
  rw [h11] at e11
  have hu := IsUnit.of_mul_eq_one _ e11
  have hz : L D₀ (b 0) = 0 := hu.mul_left_cancel (e01.trans (mul_zero _).symm)
  rw [hz, mul_zero] at e00
  exact zero_ne_one e00

/-- If `Ω_{A_p/R}` is free on `du`, the stalk of `Ω_{A/R}` at `p` has rank one. -/
theorem rankAtStalk_eq_one_of_bijective (p : PrimeSpectrum A) (u : A)
    (hbij : Function.Bijective (fun c : Localization.AtPrime p.asIdeal =>
      c • KaehlerDifferential.D R (Localization.AtPrime p.asIdeal)
        (algebraMap A (Localization.AtPrime p.asIdeal) u))) :
    Module.rankAtStalk Ω[A⁄R] p = 1 := by
  let e₁ := (IsLocalizedModule.iso p.asIdeal.primeCompl
    (KaehlerDifferential.map R R A (Localization.AtPrime p.asIdeal))).extendScalarsOfIsLocalization
      p.asIdeal.primeCompl (Localization.AtPrime p.asIdeal)
  let e₂ := LinearEquiv.ofBijective (LinearMap.toSpanSingleton (Localization.AtPrime p.asIdeal) _
    (KaehlerDifferential.D R (Localization.AtPrime p.asIdeal)
        (algebraMap A (Localization.AtPrime p.asIdeal) u))) hbij
  change Module.finrank (Localization.AtPrime p.asIdeal)
    (LocalizedModule p.asIdeal.primeCompl Ω[A⁄R]) = 1
  rw [e₁.finrank_eq, ← e₂.finrank_eq, Module.finrank_self]

/-- **Points with `du` and `dv` independent are not smooth.** Let `A` be a finitely presented
`R`-algebra and `u ∈ A` a non-zero-divisor such that `Ω_{A_p/R}` is free on `du` at every prime
`p ∌ u`. If two derivations `A → κ(q)` separate `u` and `v`, then `A` is not smooth over `R`
at `q`: smoothness would make `Ω` free near `q`, of the generic rank one (a minimal prime under
`q` avoids the non-zero-divisor `u`), while `du, dv` are independent in `Ω ⊗ κ(q)`. -/
theorem not_mem_smoothLocus_of_derivations [Algebra.FinitePresentation R A] (q : PrimeSpectrum A)
    (u v : A) (hu : u ∈ nonZeroDivisors A)
    (hgen : ∀ p : PrimeSpectrum A, u ∉ p.asIdeal →
      Function.Bijective (fun c : Localization.AtPrime p.asIdeal =>
        c • KaehlerDifferential.D R (Localization.AtPrime p.asIdeal)
          (algebraMap A (Localization.AtPrime p.asIdeal) u)))
    (D₀ D₁ : Derivation R A q.asIdeal.ResidueField) (h00 : D₀ u = 1) (h01 : D₀ v = 0)
    (h11 : D₁ v = 1) : q ∉ Algebra.smoothLocus R A := by
  intro hq
  rw [Algebra.smoothLocus_eq_compl_support_inter] at hq
  have hfree := hq.2
  obtain ⟨p₀, hp₀, hle⟩ :=
    Ideal.exists_minimalPrimes_le (I := (⊥ : Ideal A)) (J := q.asIdeal) bot_le
  have : p₀.IsPrime := hp₀.1.1
  let P₀ : PrimeSpectrum A := ⟨p₀, this⟩
  have hu₀ : u ∉ p₀ := fun h =>
    Set.disjoint_left.mp (Ideal.disjoint_nonZeroDivisors_of_mem_minimalPrimes hp₀) h hu
  have hspec : P₀ ⤳ q := (PrimeSpectrum.le_iff_specializes P₀ q).mp hle
  have hP₀ : P₀ ∈ Module.freeLocus A Ω[A⁄R] := hspec.mem_open Module.isOpen_freeLocus hfree
  have hopen := (Module.isLocallyConstant_rankAtStalk_freeLocus (R := A)
    (M := Ω[A⁄R])).isOpen_fiber (Module.rankAtStalk Ω[A⁄R] q)
  have hspec' : (⟨P₀, hP₀⟩ : Module.freeLocus A Ω[A⁄R]) ⤳ ⟨q, hfree⟩ :=
    (Topology.IsInducing.subtypeVal.specializes_iff (x := ⟨P₀, hP₀⟩) (y := ⟨q, hfree⟩)).mp hspec
  have hrank : Module.rankAtStalk Ω[A⁄R] P₀ = Module.rankAtStalk Ω[A⁄R] q :=
    hspec'.mem_open hopen rfl
  rw [rankAtStalk_eq_one_of_bijective P₀ u (hgen P₀ hu₀)] at hrank
  exact rankAtStalk_ne_one_of_derivations q u v D₀ D₁ h00 h01 h11 hfree hrank.symm

end Rank


section Dualizing

variable {X S : Scheme.{u}} (f : X ⟶ S) [LocallyOfFinitePresentation f]

/-- The identification `Γ(ω_{X/S}, W) ≃ Γ(Ω¹_{X/S}, W ∩ U)` (`U` the smooth locus) is
`Γ(X, W)`-linear. -/
theorem dualizingSheafSectionsEquiv_smul (W : X.Opens) (r : Γ(X, W))
    (s : Γ(dualizingSheaf f, W)) :
    dualizingSheafSectionsEquiv f W (r • s) =
      res (inf_le_left : W ⊓ f.smoothLocus ≤ W) r • dualizingSheafSectionsEquiv f W s := by
  have e := image_preimage_smoothLocus f W
  have key : (r • s : Γ(dualizingSheaf f, W)) =
      (show Γ(relativeDifferentials f, f.smoothLocus.ι ''ᵁ (f.smoothLocus.ι ⁻¹ᵁ W)) from
        (f.smoothLocus.ι.appIso _).inv (f.smoothLocus.ι.app W r) •
          (show Γ(relativeDifferentials f, f.smoothLocus.ι ''ᵁ (f.smoothLocus.ι ⁻¹ᵁ W)) from s)) :=
    rfl
  change (relativeDifferentials f).presheaf.map (homOfLE e.ge).op (r • s) = _
  rw [key, ← CommRingCat.comp_apply, Scheme.Hom.app_appIso_inv, Ω_map_res_smul]
  congr 1
  exact res_res (U' := f.smoothLocus.ι ''ᵁ (f.smoothLocus.ι ⁻¹ᵁ W))
    (Set.image_preimage_subset _ _) e.ge r

end Dualizing

namespace NodeChart

variable {X S : Scheme.{u}} {f : X ⟶ S} {V : S.Opens} {W : X.Opens} (C : NodeChart f V W)

/-- At a prime `p` of `Γ(X, W)` not containing the coordinate `xᵢ`, the Kähler differentials of
the local ring are free on `dxᵢ`. -/
theorem kaehler_localization_bijective (p : PrimeSpectrum Γ(X, W)) (i : Fin 2)
    (hi : C.coord i ∉ p.asIdeal) :
    letI := (f.appLE V W C.le).hom.toAlgebra
    Function.Bijective (fun c : Localization.AtPrime p.asIdeal =>
      c • KaehlerDifferential.D Γ(S, V) (Localization.AtPrime p.asIdeal)
        (algebraMap Γ(X, W) (Localization.AtPrime p.asIdeal) (C.coord i))) := by
  let := (f.appLE V W C.le).hom.toAlgebra
  let : Algebra (Node Γ(S, V) C.h) (Localization.AtPrime p.asIdeal) :=
    ((algebraMap Γ(X, W) (Localization.AtPrime p.asIdeal)).comp C.equiv.toRingHom).toAlgebra
  have : IsScalarTower Γ(S, V) (Node Γ(S, V) C.h) (Localization.AtPrime p.asIdeal) :=
    IsScalarTower.of_algebraMap_eq (R := Γ(S, V)) (S := Node Γ(S, V) C.h)
      (A := Localization.AtPrime p.asIdeal) (fun r => by
      change algebraMap Γ(S, V) (Localization.AtPrime p.asIdeal) r =
        algebraMap Γ(X, W) (Localization.AtPrime p.asIdeal) (C.equiv (algebraMap _ _ r))
      rw [C.equiv_algebraMap, IsScalarTower.algebraMap_apply Γ(S, V) Γ(X, W)
        (Localization.AtPrime p.asIdeal)]
      rfl)
  have hloc : IsLocalization (p.asIdeal.primeCompl.map C.equiv.symm.toMonoidHom)
      (Localization.AtPrime p.asIdeal) := by
    have := IsLocalization.isLocalization_of_base_ringEquiv p.asIdeal.primeCompl
      (Localization.AtPrime p.asIdeal) C.equiv.symm
    convert this
    all_goals rfl
  have hu : IsUnit (algebraMap (Node Γ(S, V) C.h) (Localization.AtPrime p.asIdeal)
      (coordinate C.h i)) :=
    IsLocalization.map_units (M := p.asIdeal.primeCompl) (Localization.AtPrime p.asIdeal)
      (⟨C.coord i, hi⟩ : p.asIdeal.primeCompl)
  exact nodeKaehler_bijective C.h (p.asIdeal.primeCompl.map C.equiv.symm.toMonoidHom) i hu

/-- At a prime `q` of `Γ(X, W)` containing both coordinates, the partial derivatives
`∂/∂xⱼ : Γ(X, W) → κ(q)` are `Γ(S, V)`-derivations. -/
theorem exists_derivation (q : PrimeSpectrum Γ(X, W)) (h0 : C.coord 0 ∈ q.asIdeal)
    (h1 : C.coord 1 ∈ q.asIdeal) (j : Fin 2) :
    letI := (f.appLE V W C.le).hom.toAlgebra
    ∃ D : Derivation Γ(S, V) Γ(X, W) q.asIdeal.ResidueField,
      ∀ i, D (C.coord i) = (Pi.single j 1 : Fin 2 → q.asIdeal.ResidueField) i := by
  let := (f.appLE V W C.le).hom.toAlgebra
  let : Algebra (Node Γ(S, V) C.h) q.asIdeal.ResidueField :=
    ((algebraMap Γ(X, W) q.asIdeal.ResidueField).comp C.equiv.toRingHom).toAlgebra
  have : IsScalarTower Γ(S, V) (Node Γ(S, V) C.h) q.asIdeal.ResidueField :=
    IsScalarTower.of_algebraMap_eq (R := Γ(S, V)) (S := Node Γ(S, V) C.h)
      (A := q.asIdeal.ResidueField) (fun r => by
      change algebraMap Γ(S, V) q.asIdeal.ResidueField r =
        algebraMap Γ(X, W) q.asIdeal.ResidueField (C.equiv (algebraMap _ _ r))
      rw [C.equiv_algebraMap, IsScalarTower.algebraMap_apply Γ(S, V) Γ(X, W)
        q.asIdeal.ResidueField]
      rfl)
  have hc : ∀ i, algebraMap (Node Γ(S, V) C.h) q.asIdeal.ResidueField (coordinate C.h i) = 0 := by
    intro i
    change algebraMap Γ(X, W) q.asIdeal.ResidueField (C.coord i) = 0
    rw [Ideal.algebraMap_residueField_eq_zero]
    fin_cases i
    · exact h0
    · exact h1
  obtain ⟨D, hD⟩ := nodeDerivationOfValues C.h (N := q.asIdeal.ResidueField) (Pi.single j 1)
    (by rw [hc, hc, zero_mul, zero_mul, add_zero])
  let e : Node Γ(S, V) C.h ≃ₐ[Γ(S, V)] Γ(X, W) := AlgEquiv.ofRingEquiv (f := C.equiv)
    C.equiv_algebraMap
  have hsmul : ∀ (a : Γ(X, W)) (m : q.asIdeal.ResidueField), e.symm a • m = a • m := by
    intro a m
    rw [Algebra.smul_def, Algebra.smul_def]
    change algebraMap Γ(X, W) q.asIdeal.ResidueField (C.equiv (e.symm a)) * m = _
    change algebraMap Γ(X, W) q.asIdeal.ResidueField (e (e.symm a)) * m = _
    rw [e.apply_symm_apply]
  refine ⟨Derivation.mk' (D.toLinearMap.comp e.symm.toLinearMap) (fun a b => ?_), fun i => ?_⟩
  · change D (e.symm (a * b)) = a • D (e.symm b) + b • D (e.symm a)
    rw [map_mul, Derivation.leibniz, hsmul, hsmul]
  · change D (e.symm (e (coordinate C.h i))) = _
    rw [e.symm_apply_apply, hD]

/-- Membership in a basic open of an affine open in terms of the prime ideal of the point. -/
theorem mem_basicOpen_iff {x : X} (hx : x ∈ W) (g : Γ(X, W)) :
    x ∈ X.basicOpen g ↔ g ∉ (C.isAffineOpen_W.primeIdealOf ⟨x, hx⟩).asIdeal := by
  have hW := C.isAffineOpen_W
  have key : hW.fromSpec (hW.primeIdealOf ⟨x, hx⟩) = x := hW.fromSpec_primeIdealOf ⟨x, hx⟩
  conv_lhs => rw [← key]
  change hW.primeIdealOf ⟨x, hx⟩ ∈ hW.fromSpec ⁻¹ᵁ X.basicOpen g ↔ _
  rw [hW.fromSpec_preimage_basicOpen]
  rfl

/-- **The points of `V(x₀, x₁)` are not smooth.** A point of a node chart at which both
coordinates vanish does not lie in the smooth locus of `f`. -/
theorem not_mem_smoothLocus [LocallyOfFinitePresentation f] {x : X} (hx : x ∈ W)
    (h0 : x ∉ X.basicOpen (C.coord 0)) (h1 : x ∉ X.basicOpen (C.coord 1)) :
    x ∉ f.smoothLocus := by
  have hW := C.isAffineOpen_W
  let := (f.appLE V W C.le).hom.toAlgebra
  have h0' : C.coord 0 ∈ (hW.primeIdealOf ⟨x, hx⟩).asIdeal := by
    by_contra h
    exact h0 ((C.mem_basicOpen_iff hx _).mpr h)
  have h1' : C.coord 1 ∈ (hW.primeIdealOf ⟨x, hx⟩).asIdeal := by
    by_contra h
    exact h1 ((C.mem_basicOpen_iff hx _).mpr h)
  let e : Node Γ(S, V) C.h ≃ₐ[Γ(S, V)] Γ(X, W) := AlgEquiv.ofRingEquiv (f := C.equiv)
    C.equiv_algebraMap
  have : Algebra.FinitePresentation Γ(S, V) Γ(X, W) :=
    have := DeJongAlterations.Algebra.NodeFamilyFlat.node_finitePresentation C.h
    Algebra.FinitePresentation.equiv e
  obtain ⟨D₀, hD₀⟩ := C.exists_derivation _ h0' h1' 0
  obtain ⟨D₁, hD₁⟩ := C.exists_derivation _ h0' h1' 1
  rw [Scheme.Hom.mem_smoothLocus, formallySmooth_stalkMap_iff V C.isAffineOpen_V W hW C.le hx]
  exact not_mem_smoothLocus_of_derivations _ (C.coord 0) (C.coord 1)
    C.nodeEqualizerData.u_mem (fun p hp => C.kaehler_localization_bijective p 0 hp) D₀ D₁
    (by rw [hD₀]; simp) (by rw [hD₀]; simp) (by rw [hD₁]; simp)

/-- **The smooth locus of a node chart.** `W ∩ smoothLocus(f) = D(x₀) ∪ D(x₁)`. -/
theorem inf_smoothLocus [LocallyOfFinitePresentation f] :
    W ⊓ f.smoothLocus = X.basicOpen (C.coord 0) ⊔ X.basicOpen (C.coord 1) := by
  apply le_antisymm
  · rintro x ⟨hxW, hxU⟩
    by_contra hx
    simp only [TopologicalSpace.Opens.mem_sup, not_or] at hx
    exact C.not_mem_smoothLocus hxW hx.1 hx.2 hxU
  · exact sup_le (le_inf (X.basicOpen_le _) (C.basicOpen_coord_le_smoothLocus 0))
      (le_inf (X.basicOpen_le _) (C.basicOpen_coord_le_smoothLocus 1))

/-- On a basic open `D(g)` of a node chart, `D(g) ∩ smoothLocus(f) = D(u) ∪ D(v)` with
`u = x₀|_{D(g)}`, `v = x₁|_{D(g)}`. -/
theorem basicOpen_inf_smoothLocus [LocallyOfFinitePresentation f] (g : Γ(X, W)) :
    X.basicOpen g ⊓ f.smoothLocus =
      X.basicOpen (C.coordAt g 0) ⊔ X.basicOpen (C.coordAt g 1) := by
  have hg : X.basicOpen g ≤ W := X.basicOpen_le g
  rw [Scheme.basicOpen_res, Scheme.basicOpen_res, ← inf_sup_left, ← C.inf_smoothLocus,
    ← inf_assoc, inf_eq_left.mpr hg]

include C in
/-- **`ω_{X/S}` on a node chart** (blueprint `prop:sm-omega-node`). For every `g ∈ Γ(X, W)`,
the sections of `ω_{X/S}` over `D(g)` form a free `Γ(X, D(g))`-module of rank one: there is
`τ ∈ Γ(D(g), ω_{X/S})` (the section `du/u = -dv/v`) with `c ↦ c τ` bijective. -/
theorem exists_dualizing_generator [LocallyOfFinitePresentation f] (g : Γ(X, W)) :
    ∃ τ : Γ(dualizingSheaf f, X.basicOpen g),
      Function.Bijective (fun c : Γ(X, X.basicOpen g) => c • τ) := by
  obtain ⟨σ, -, -, hbij⟩ := C.exists_generator g
  have heq := C.basicOpen_inf_smoothLocus g
  let ι : X.basicOpen g ⊓ f.smoothLocus ⟶
      X.basicOpen (C.coordAt g 0) ⊔ X.basicOpen (C.coordAt g 1) := homOfLE heq.le
  let E := dualizingSheafSectionsEquiv f (X.basicOpen g)
  refine ⟨E.symm ((relativeDifferentials f).presheaf.map ι.op σ), ?_⟩
  have hfun : (fun c : Γ(X, X.basicOpen g) =>
      c • E.symm ((relativeDifferentials f).presheaf.map ι.op σ)) =
      E.symm ∘ (relativeDifferentials f).presheaf.map ι.op ∘
        (fun c : Γ(X, X.basicOpen g) =>
          res (sup_le (X.basicOpen_le (C.coordAt g 0)) (X.basicOpen_le (C.coordAt g 1))) c •
            σ) := by
    funext c
    apply E.injective
    simp only [Function.comp_apply, AddEquiv.apply_symm_apply]
    rw [dualizingSheafSectionsEquiv_smul, AddEquiv.apply_symm_apply, Ω_map_res_smul, res_res]
  rw [hfun]
  exact E.symm.bijective.comp
    (((relativeDifferentials f).map_bijective_of_le ι heq.ge).comp hbij)

end NodeChart

end DeJongAlterations.StableModification.Omega
