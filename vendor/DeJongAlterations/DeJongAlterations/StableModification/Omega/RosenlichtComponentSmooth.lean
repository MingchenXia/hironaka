import DeJongAlterations.StableModification.Omega.RosenlichtComponent
import DeJongAlterations.StableModification.Omega.Smooth
import DeJongAlterations.StableModification.Omega.Invertible

/-!
# Comparison charts over the smooth locus

Let `ν : Y ⟶ X` with `ν ≫ f = q ≫ h` (in the application `Y` is the normalization of a component
of a geometric fibre of `f`). Over the smooth locus `Sm f` the dualizing sheaf `ω` is `Ω¹_{X/S}`,
and if `ν` is *unramified relative to the base change* at `y` (`IsUnramifiedAt`: near `y` the
module `Γ(V, Ω¹_{Y/T})` is generated by the differentials `d(ν^♯ a)` of functions pulled back from
`X`; for `T = Spec K` this says that `Y ⟶ X ×_S Spec K` is unramified near `y`), then the base
change `θ(σ)` of a generator `σ` of `ω` near `ν(y) ∈ Sm f` is a generator of `Ω¹_{Y/T}` near `y`:
there is a comparison chart with `t = 1` (`exists_compChart_of_mem_smoothLocus`, blueprint
`lem:sm-omega-bcf-smooth-chart`). This is the statement "away from `E_Z` the pullback of `ω` is
`Ω¹_{Z̃/K}`" in the proof of `cor:sm-omega-restriction-component` (`sm-omega-base-change.tex`).

* `span_restrict_basicOpen`: spanning sets of sections of a quasi-coherent module restrict to
  spanning sets over basic opens.
* `exists_basicOpen_bijective_of_span`: a section spanning the sections of an invertible module over
  an affine open is a free generator on a basic open neighbourhood of any given point.

M. Temkin, *Stable modification of relative curves*, J. Algebraic Geom. 19 (2010), §1.2 (a)
(`semi-stable.tex`, T:1700–1701).
-/

noncomputable section

open AlgebraicGeometry CategoryTheory Opposite TopologicalSpace
open DeJongAlterations.StableModification.Cohomology

universe u

namespace DeJongAlterations.StableModification.Omega.RosenlichtComponent

section Span

variable {Y : Scheme.{u}} (F : Y.Modules) [F.IsQuasicoherent]

set_option backward.isDefEq.respectTransparency false in
/-- **Spanning sets restrict to spanning sets on basic opens** (quasi-coherence). -/
theorem span_restrict_basicOpen {V : Y.Opens} (hV : IsAffineOpen V) (s : Set Γ(F, V))
    (hs : Submodule.span Γ(Y, V) s = ⊤) (g : Γ(Y, V)) :
    Submodule.span Γ(Y, Y.basicOpen g)
      (F.presheaf.map (homOfLE (Y.basicOpen_le g)).op '' s) = ⊤ := by
  let ρ := (Y.presheaf.map (homOfLE (Y.basicOpen_le g)).op).hom
  let _ : Algebra Γ(Y, V) Γ(Y, Y.basicOpen g) := ρ.toAlgebra
  have hloc : IsLocalization.Away g Γ(Y, Y.basicOpen g) := hV.isLocalization_basicOpen g
  let _ : Module Γ(Y, V) Γ(F, Y.basicOpen g) := Module.compHom _ ρ
  have hM := isLocalizedModule_restrictLinearNative F hV g
  set res := restrictLinearNative F (Y.basicOpen_le g)
  set P := Submodule.span Γ(Y, Y.basicOpen g)
    (F.presheaf.map (homOfLE (Y.basicOpen_le g)).op '' s)
  have hres : ∀ m₀ : Γ(F, V), res m₀ ∈ P := by
    intro m₀
    have hm₀ : m₀ ∈ Submodule.span Γ(Y, V) s := by rw [hs]; trivial
    induction hm₀ using Submodule.span_induction with
    | mem x hx => exact Submodule.subset_span ⟨x, hx, rfl⟩
    | zero => rw [map_zero]; exact P.zero_mem
    | add x y _ _ hx hy => rw [map_add]; exact P.add_mem hx hy
    | smul a x _ hx =>
      rw [map_smul]
      exact P.smul_mem (ρ a) hx
  rw [eq_top_iff]
  intro m _
  obtain ⟨⟨m₀, ⟨_, n, rfl⟩⟩, hm⟩ := IsLocalizedModule.surj (Submonoid.powers g) res m
  simp only at hm
  have hu : IsUnit (ρ (g ^ n)) :=
    IsLocalization.map_units Γ(Y, Y.basicOpen g) (⟨g ^ n, n, rfl⟩ : Submonoid.powers g)
  have : m = ((hu.unit⁻¹ : Γ(Y, Y.basicOpen g)ˣ) : Γ(Y, Y.basicOpen g)) • res m₀ := by
    rw [← hm]
    change m = ((hu.unit⁻¹ : Γ(Y, Y.basicOpen g)ˣ) : Γ(Y, Y.basicOpen g)) • (ρ (g ^ n) • m)
    rw [← mul_smul, hu.val_inv_mul, one_smul]
  rw [this]
  exact P.smul_mem _ (hres m₀)

omit [F.IsQuasicoherent] in
/-- Transport of a bijectivity statement along an equality of opens. -/
theorem bijective_smul_of_eq {V V' : Y.Opens} (hVV' : V = V') {W : Y.Opens} (h : V ≤ W)
    (h' : V' ≤ W) (γ : Γ(F, W))
    (hγ : Function.Bijective (fun c : Γ(Y, V') => c • F.presheaf.map (homOfLE h').op γ)) :
    Function.Bijective (fun c : Γ(Y, V) => c • F.presheaf.map (homOfLE h).op γ) := by
  subst hVV'
  exact hγ

set_option backward.isDefEq.respectTransparency false in
/-- **A spanning section is a local generator** of an invertible module: if `β` spans
`Γ(V, F)` (`V` affine) and `F` is invertible at `y ∈ V`, then `β` freely generates `F` on a basic
open neighbourhood of `y` in `V`. -/
theorem exists_basicOpen_bijective_of_span {y : Y} (hF : IsInvertibleAt F y) {V : Y.Opens}
    (hV : IsAffineOpen V) (hy : y ∈ V) (β : Γ(F, V))
    (hβ : Submodule.span Γ(Y, V) {β} = ⊤) :
    ∃ g : Γ(Y, V), y ∈ Y.basicOpen g ∧ Function.Bijective (fun c : Γ(Y, Y.basicOpen g) =>
      c • F.presheaf.map (homOfLE (Y.basicOpen_le g)).op β) := by
  obtain ⟨W₁, hW₁, hyW₁, hW₁V, β₁, hβ₁⟩ := exists_generator F hF hy
  obtain ⟨g, g₁, hgg₁, hyg⟩ := exists_basicOpen_le_affine_inter hV hW₁ y ⟨hy, hyW₁⟩
  refine ⟨g, hyg, ?_⟩
  set D := Y.basicOpen g
  have hDW₁ : D ≤ W₁ := hgg₁.le.trans (Y.basicOpen_le g₁)
  set γ := F.presheaf.map (homOfLE hDW₁).op β₁
  have hγ : Function.Bijective (fun c : Γ(Y, D) => c • γ) :=
    bijective_smul_of_eq F hgg₁ hDW₁ (Y.basicOpen_le g₁) β₁
      (bijective_smul_restrict_basicOpen F hW₁ β₁ hβ₁ g₁)
  have hspan := span_restrict_basicOpen F hV {β} hβ g
  rw [Set.image_singleton] at hspan
  set β' := F.presheaf.map (homOfLE (Y.basicOpen_le g)).op β
  obtain ⟨u, hu⟩ := hγ.surjective β'
  have hγmem : γ ∈ Submodule.span Γ(Y, D) {β'} := by rw [hspan]; trivial
  obtain ⟨w, hw⟩ := Submodule.mem_span_singleton.mp hγmem
  simp only at hu
  have hwu : w * u = 1 := by
    apply hγ.injective
    simp only
    rw [mul_smul, hu, hw, one_smul]
  have hcomp : (fun c : Γ(Y, D) => c • β') = (fun c : Γ(Y, D) => c • γ) ∘ (fun c => c * u) := by
    funext c
    simp only [Function.comp_apply]
    rw [mul_smul, hu]
  rw [hcomp]
  refine hγ.comp ⟨fun c c' h => ?_, fun c => ⟨c * w, ?_⟩⟩
  · simp only at h
    have := congrArg (· * w) h
    simp only [mul_assoc, mul_comm u w, hwu, mul_one] at this
    exact this
  · change c * w * u = c
    rw [mul_assoc, hwu, mul_one]

end Span

section SmoothChart

variable {X S Y T : Scheme.{u}} (f : X ⟶ S) [LocallyOfFinitePresentation f] (q : Y ⟶ T)
  (ν : Y ⟶ X) (h : T ⟶ S) (sq : ν ≫ f = q ≫ h)

/-- `ν` is **unramified relative to the base change** at `y`: for all affine opens `V_S ⊆ S` and
`W ⊆ f⁻¹ V_S` with `ν(y) ∈ W` there is an affine open `V ∋ y`, `V ⊆ ν⁻¹ W`, on which
`Γ(V, Ω¹_{Y/T})` is generated by the differentials `d(ν^♯ a)`, `a ∈ Γ(W, 𝒪_X)`. For
`T = Spec K` and `h : Spec K ⟶ S` this is the vanishing of `Ω¹_{Y/X ×_S Spec K}` near `y`, i.e.
`Y ⟶ X_K` unramified near `y` (on the chart `Spec (K ⊗_{Γ(S, V_S)} Γ(X, W))` of `X_K`; blueprint
`def:sm-omega-bcf-unramified`). -/
def IsUnramifiedAt (y : Y) : Prop :=
  ∀ (V_S : S.Opens) (W : X.Opens), IsAffineOpen V_S → IsAffineOpen W → W ≤ f ⁻¹ᵁ V_S → ν y ∈ W →
    ∃ V : Y.Opens, IsAffineOpen V ∧ y ∈ V ∧ ∃ hV : V ≤ ν ⁻¹ᵁ W,
      Submodule.span Γ(Y, V)
        (Set.range fun a : Γ(X, W) => (universalDerivation q).sec V (ν.appLE W V hV a)) = ⊤

set_option backward.isDefEq.respectTransparency false in
/-- **Comparison charts over the smooth locus** (blueprint `lem:sm-omega-bcf-smooth-chart`): if `ω`
and `Ω¹_{Y/T}` are invertible, `ν(y) ∈ Sm f` and `ν` is unramified relative to the base change at
`y`, there is a comparison chart around `y` with `t = 1`. -/
theorem exists_compChart_of_mem_smoothLocus (hω : IsInvertibleModule (dualizingSheaf f))
    [(relativeDifferentials q).IsQuasicoherent]
    (hΩ : IsInvertibleModule (relativeDifferentials q)) {y : Y} (hy : ν y ∈ f.smoothLocus)
    (hun : IsUnramifiedAt f q ν y) : ∃ C : CompChart f q ν h sq, y ∈ C.V ∧ C.t = 1 := by
  obtain ⟨V_S, hV_S, hyV_S, -⟩ :=
    exists_isAffineOpen_mem_and_subset (x := f (ν y)) (U := ⊤) trivial
  obtain ⟨W, hW, hxW, hWU, σ, hσ⟩ := exists_generator (dualizingSheaf f) (hω (ν y))
    (O := f.smoothLocus ⊓ f ⁻¹ᵁ V_S) ⟨hy, hyV_S⟩
  set O := f.smoothLocus.ι ''ᵁ (f.smoothLocus.ι ⁻¹ᵁ W) with hO
  have hOW : O = W := by
    rw [hO, Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
    exact inf_eq_right.mpr (hWU.trans inf_le_left)
  have hOaff : IsAffineOpen O := hOW ▸ hW
  obtain ⟨V, hV, hyV, hVO, hspan⟩ := hun V_S O hV_S hOaff (hOW ▸ (hWU.trans inf_le_right))
    (hOW.symm ▸ hxW)
  set θ := baseChangeDifferentials f q ν h sq
  let σO : Γ(relativeDifferentials f, O) := σ
  set β₀ : Γ(relativeDifferentials q, V) :=
    (relativeDifferentials q).presheaf.map (homOfLE hVO).op (θ.app O σO) with hβ₀
  have hgen : Submodule.span Γ(Y, V) {β₀} = ⊤ := by
    rw [eq_top_iff, ← hspan, Submodule.span_le]
    rintro _ ⟨a, rfl⟩
    obtain ⟨c, hc⟩ := hσ.surjective (show Γ(dualizingSheaf f, W) from
      (universalDerivation f).sec O a)
    -- `c • σ` in `ω` is `c|_O • σ` in `Ω¹_{X/S}`
    let c' : Γ(X, O) :=
      (f.smoothLocus.ι.appIso (f.smoothLocus.ι ⁻¹ᵁ W)).inv (f.smoothLocus.ι.app W c)
    have hc' : c' • σO = (universalDerivation f).sec O a := hc
    have h1 := congrArg (fun m => (relativeDifferentials q).presheaf.map (homOfLE hVO).op
      (θ.app O m)) hc'
    simp only at h1
    rw [Scheme.Modules.Hom.app_smul] at h1
    change (relativeDifferentials q).presheaf.map (homOfLE hVO).op
      (ν.app O c' • (show Γ(relativeDifferentials q, ν ⁻¹ᵁ O) from θ.app O σO)) = _ at h1
    rw [Scheme.Modules.map_smul, ← hβ₀] at h1
    have h2 := baseChangeSecMap_restrict_sec f q ν h sq hVO a
    rw [SetLike.mem_coe, Submodule.mem_span_singleton]
    exact ⟨_, h1.trans h2⟩
  obtain ⟨g, hyg, hbij⟩ :=
    exists_basicOpen_bijective_of_span (relativeDifferentials q) (hΩ y) hV hyV β₀ hgen
  have hle : Y.basicOpen g ≤ ν ⁻¹ᵁ W := (Y.basicOpen_le g).trans (hOW ▸ hVO)
  refine ⟨⟨W, hW, σ, hσ, Y.basicOpen g, hV.basicOpen g, hle,
    (relativeDifferentials q).presheaf.map (homOfLE (Y.basicOpen_le g)).op β₀, hbij, 1, ?_⟩,
    hyg, rfl⟩
  rw [one_smul, toLogDifferentials_app, hβ₀]
  change (relativeDifferentials q).presheaf.map _
      ((relativeDifferentials q).presheaf.map _ (θ.app O σO)) =
    (relativeDifferentials q).presheaf.map _
      ((relativeDifferentials q).presheaf.map _
        ((relativeDifferentials q).presheaf.map (homOfLE hVO).op (θ.app O σO)))
  rw [← ConcreteCategory.comp_apply, ← ConcreteCategory.comp_apply, ← ConcreteCategory.comp_apply,
    ← Functor.map_comp, ← Functor.map_comp, ← Functor.map_comp]
  rfl

end SmoothChart


section Assembly

open Module DeJongAlterations.StableModification.CurvesField

variable {X S Y : Scheme.{u}} (f : X ⟶ S)
  {K : Type u} [Field K] [IsAlgClosed K] (q : Y ⟶ Spec (.of K)) (ν : Y ⟶ X)
  (a : Spec (.of K) ⟶ S) (sq : ν ≫ f = q ≫ a)

/-- **Comparison charts at the points over the non-smooth locus** (the hypothesis remaining for
the degree of `ω` on a component; blueprint `lem:sm-omega-bcf-pole-chart`, not formalized): every
`y ∈ E` lies in a comparison chart `C` with `C.V ∩ E = {y}` and `dim_K Γ(C.V, 𝒪)/(t) = 1`, i.e.
`ν^* ω` has a simple pole at `y` relative to `Ω¹_{Y/K}`. -/
def HasPoleCharts [LocallyOfFinitePresentation f] (E : Finset Y) : Prop :=
  ∀ y ∈ E, ∃ C : CompChart f q ν a sq, y ∈ C.V ∧ (∀ z ∈ E, z ∈ C.V → z = y) ∧
    letI := (sectionsRingHom (structureCoeff q) (le_top : C.V ≤ ⊤)).toAlgebra
    FiniteDimensional K (Γ(Y, C.V) ⧸ Ideal.span {C.t}) ∧
      finrank K (Γ(Y, C.V) ⧸ Ideal.span {C.t}) = 1

open DeJong (IsNodalCurve IsSmoothAt) in
/-- **The degree of `ω` on a curve unramified over a geometric fibre of a nodal curve** (blueprint
`cor:sm-omega-bcf-restriction-component`, conditional on `HasPoleCharts`). Let `f : X ⟶ S` be a
nodal curve over an integral, normal, locally Noetherian scheme, smooth over the generic point,
`K = K̄`, and `ν : Y ⟶ X`, `q : Y ⟶ Spec K`, `ν ≫ f = q ≫ a`, with `Y` integral, normal, smooth of
relative dimension one and projective over `K`, Noetherian with affine diagonal, of dimension at
most one and not a point. Let `E = ν⁻¹(X ∖ Sm f)` be a finite set of closed points, let `ν` be
unramified relative to the base change at the points outside `E`, and assume the pole charts at
`E`. Then `deg ν^* ω = χ(ν^* ω) - χ(𝒪_Y) = 2 p_a(Y) - 2 + #E`. -/
theorem degree_pullback_dualizingSheaf_of_isNodalCurve [IsNodalCurve f] [IsIntegral S]
    [IsLocallyNoetherian S] (hS : IsNormalScheme S)
    (hgen : ∀ x : X, f x = genericPoint S → IsSmoothAt f x)
    [IsIntegral Y] [CompactSpace Y] [IsAffineHom (Limits.pullback.diagonal (Limits.terminal.from Y))]
    [SmoothOfRelativeDimension 1 q] [NoetherianSpace Y] (hp : IsProjectiveOver q)
    (hdim : topologicalKrullDim Y ≤ 1) (hpt : ∃ y : Y, y ≠ genericPoint Y)
    (hnormal : IsNormalScheme Y) (E : Finset Y) (hE : ∀ y, y ∈ E ↔ ν y ∉ f.smoothLocus)
    (hEc : ∀ y ∈ E, IsClosed ({y} : Set Y)) (hun : ∀ y, y ∉ E → IsUnramifiedAt f q ν y)
    (hpole : HasPoleCharts f q ν a sq E) :
    (∀ i, FiniteDimensional K
        (cohomology ((Scheme.Modules.pullback ν).obj (dualizingSheaf f)) (structureCoeff q) i)) ∧
      DualityScheme.eulerCharOf ((Scheme.Modules.pullback ν).obj (dualizingSheaf f))
          (structureCoeff q) - Genus.eulerChar Y (structureCoeff q) =
        2 * Genus.arithmeticGenus Y (structureCoeff q) - 2 + E.card := by
  have : Smooth q := SmoothOfRelativeDimension.smooth 1 q
  have hω := isInvertibleModule_dualizingSheaf_of_isNodalCurve f hS hgen
  have hΩ := isInvertibleModule_relativeDifferentials q
  refine degree_pullback_dualizingSheaf f q ν a sq hω hp hdim hpt hnormal E hE hEc
    (fun y hy => ?_) (fun y hy => hpole y hy)
  have hyU : ν y ∈ f.smoothLocus := by
    by_contra h
    exact hy ((hE y).mpr h)
  exact exists_compChart_of_mem_smoothLocus f q ν a sq hω hΩ hyU (hun y hy)

end Assembly

end DeJongAlterations.StableModification.Omega.RosenlichtComponent
