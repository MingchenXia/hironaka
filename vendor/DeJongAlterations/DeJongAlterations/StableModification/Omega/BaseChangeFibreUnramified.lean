import DeJongAlterations.StableModification.Omega.RosenlichtComponentSmooth
import Mathlib.AlgebraicGeometry.Morphisms.FormallyUnramified
import Mathlib.AlgebraicGeometry.Morphisms.Flat
import Mathlib.RingTheory.Kaehler.TensorProduct

/-!
# Unramified maps into a geometric fibre

Let `f : X ⟶ S`, `a : Spec K ⟶ S`, `X_K = X ×_S Spec K`, and `ν : Y ⟶ X`, `q : Y ⟶ Spec K` with
`ν ≫ f = q ≫ a`, so that `ν' = pullback.lift ν q sq : Y ⟶ X_K`. If `ν'` is formally unramified,
then `ν` is unramified relative to the base change at every point
(`isUnramifiedAt_of_formallyUnramified`): on affine opens `W ⊆ f⁻¹ V_S` and `V ⊆ ν⁻¹ W`, the module
`Γ(V, Ω¹_{Y/K})` is generated by the `d(ν^♯ a)`, `a ∈ Γ(W, 𝒪_X)`.

The proof connects the scheme `X_K` with the algebra of its affine charts (two of the connections
listed in `sm-omega-base-change.tex`, `rem:sm-omega-base-change-literature`):

* the sections of `X_K` over `ψ⁻¹ W` are the pushout `Γ(S, V_S) → Γ(X, W), Γ(Spec K, ⊤)`
  (Mathlib's `isIso_pushoutSection_of_isAffineOpen`), so their differentials over
  `Γ(Spec K, ⊤)` are the base change of `Ω_{Γ(X, W)/Γ(S, V_S)}`
  (`KaehlerDifferential.tensorKaehlerEquiv`; `span_D_of_isPushout`): the base change of `Ω¹` for
  affine pushout squares;
* Kähler differentials along a formally unramified map are spanned by the image of the
  differentials of the source (`span_D_of_formallyUnramified`, from the exact sequence
  `B ⊗_A Ω_{A/R} → Ω_{B/R} → Ω_{B/A} = 0`);
* the differentials of `Y` over `Spec K` on an affine `V` are the Kähler differentials over
  `Γ(Spec K, ⊤)` (`Omega.sectionsEquiv`).

Blueprint `sm-omega-base-change-fibre.tex`, `lem:sm-omega-bcf-unramified-bridge`; M. Temkin,
*Stable modification of relative curves*, J. Algebraic Geom. 19 (2010), §1.2 (a)
(`semi-stable.tex`, T:1700–1701).
-/

noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TensorProduct

universe u

namespace DeJongAlterations.StableModification.Omega

section Algebra

variable {R A B : Type*} [CommRing R] [CommRing A] [CommRing B] [Algebra R A] [Algebra A B]
  [Algebra R B] [IsScalarTower R A B]

/-- **Differentials along a formally unramified map**: if `A → B` is formally unramified and
`Ω_{A/R}` is spanned by `D a`, `a ∈ s`, then `Ω_{B/R}` is spanned by the `D b`, `b` in the image of
`s`. -/
theorem span_D_of_formallyUnramified [Algebra.FormallyUnramified A B] (s : Set A)
    (hs : Submodule.span A (KaehlerDifferential.D R A '' s) = ⊤) :
    Submodule.span B (KaehlerDifferential.D R B '' (algebraMap A B '' s)) = ⊤ := by
  set M := Submodule.span B (KaehlerDifferential.D R B '' (algebraMap A B '' s))
  have hmap : ∀ ω : Ω[A⁄R], KaehlerDifferential.map R R A B ω ∈ M := by
    intro ω
    have hω : ω ∈ Submodule.span A (KaehlerDifferential.D R A '' s) := by rw [hs]; trivial
    induction hω using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨a, ha, rfl⟩ := hx
      rw [KaehlerDifferential.map_D]
      exact Submodule.subset_span ⟨algebraMap A B a, ⟨a, ha, rfl⟩, rfl⟩
    | zero => rw [map_zero]; exact M.zero_mem
    | add x y _ _ hx hy => rw [map_add]; exact M.add_mem hx hy
    | smul c x _ hx =>
      rw [LinearMap.map_smul_of_tower, ← algebraMap_smul B c]
      exact M.smul_mem _ hx
  have hsurj : Function.Surjective (KaehlerDifferential.mapBaseChange R A B) := by
    rw [← LinearMap.range_eq_top, KaehlerDifferential.range_mapBaseChange, LinearMap.ker_eq_top]
    exact Subsingleton.elim _ _
  rw [eq_top_iff]
  rintro ω -
  obtain ⟨x, rfl⟩ := hsurj ω
  induction x using TensorProduct.induction_on with
  | zero => rw [map_zero]; exact M.zero_mem
  | tmul b ω' =>
    rw [KaehlerDifferential.mapBaseChange_tmul]
    exact M.smul_mem b (hmap ω')
  | add x y hx hy => rw [map_add]; exact M.add_mem hx hy

variable (R) (S : Type*) [CommRing S] [Algebra R S] [Algebra S B] [IsScalarTower R S B]

/-- **Differentials of a pushout**: if `B = S ⊗_R A`, then `Ω_{B/S}` is spanned over `B` by the
differentials of the image of `A`. -/
theorem span_D_of_isPushout [Algebra.IsPushout R S A B] :
    Submodule.span B (Set.range fun a : A => KaehlerDifferential.D S B (algebraMap A B a)) = ⊤ := by
  set M := Submodule.span B (Set.range fun a : A => KaehlerDifferential.D S B (algebraMap A B a))
  rw [eq_top_iff]
  rintro ω -
  obtain ⟨x, rfl⟩ := (KaehlerDifferential.tensorKaehlerEquiv R S A B).surjective ω
  induction x using TensorProduct.induction_on with
  | zero => rw [map_zero]; exact M.zero_mem
  | tmul b ω' =>
    have hω' : ω' ∈ Submodule.span A (Set.range (KaehlerDifferential.D R A)) := by
      rw [KaehlerDifferential.span_range_derivation]; trivial
    induction hω' using Submodule.span_induction generalizing b with
    | mem x hx =>
      obtain ⟨a, rfl⟩ := hx
      rw [KaehlerDifferential.tensorKaehlerEquiv_tmul_D]
      exact M.smul_mem b (Submodule.subset_span ⟨a, rfl⟩)
    | zero => rw [TensorProduct.tmul_zero, map_zero]; exact M.zero_mem
    | add x y _ _ hx hy => rw [TensorProduct.tmul_add, map_add]; exact M.add_mem (hx b) (hy b)
    | smul c x _ hx =>
      rw [TensorProduct.tmul_smul, TensorProduct.smul_tmul']
      exact hx _
  | add x y hx hy => rw [map_add]; exact M.add_mem hx hy

end Algebra

section Scheme

variable {X S Y : Scheme.{u}} (f : X ⟶ S) {K : Type u} [Field K] (q : Y ⟶ Spec (.of K))
  (ν : Y ⟶ X) (a : Spec (.of K) ⟶ S) (sq : ν ≫ f = q ≫ a)

set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- **Unramified into the geometric fibre implies unramified relative to the base change**
(blueprint `lem:sm-omega-bcf-unramified-bridge`): if `ν' = pullback.lift ν q sq : Y ⟶ X ×_S Spec K`
is formally unramified, then `ν` is unramified relative to the base change at every point. -/
theorem isUnramifiedAt_of_formallyUnramified [FormallyUnramified (pullback.lift ν q sq)] (y : Y) :
    RosenlichtComponent.IsUnramifiedAt f q ν y := by
  intro V_S W hV_S hW hWV hyW
  set ν' := pullback.lift ν q sq
  have H : IsPullback (pullback.fst f a) (pullback.snd f a) f a := IsPullback.of_hasPullback f a
  have hUST : (⊤ : (Spec (.of K)).Opens) ≤ a ⁻¹ᵁ V_S := by
    intro z _
    have hz : z = q y := Subsingleton.elim _ _
    subst hz
    change (q ≫ a) y ∈ V_S
    rw [← sq]
    exact hWV hyW
  set UY := pullback.fst f a ⁻¹ᵁ W ⊓ pullback.snd f a ⁻¹ᵁ ⊤ with hUYdef
  have hUYaff : IsAffineOpen UY := by
    have : IsAffine V_S := hV_S
    have : IsAffine (⊤ : (Spec (.of K)).Opens) := isAffineOpen_top _
    have : IsAffine W := hW
    exact .of_isIso (Scheme.Hom.isPullback_resLE H hUST hWV hUYdef).isoPullback.hom
  have hpush := (isIso_pushoutSection_iff H hUST hWV hUYdef).mp
    (isIso_pushoutSection_of_isAffineOpen H hUST hWV hUYdef hV_S (isAffineOpen_top _) hW)
  obtain ⟨V, hV, hyV, hVW⟩ := exists_isAffineOpen_mem_and_subset (x := y) (U := ν ⁻¹ᵁ W) hyW
  have hVUY : V ≤ ν' ⁻¹ᵁ UY := by
    intro z hz
    refine ⟨?_, trivial⟩
    change (ν' ≫ pullback.fst f a) z ∈ W
    rw [pullback.lift_fst]
    exact hVW hz
  refine ⟨V, hV, hyV, hVW, ?_⟩
  have hfu : (ν'.appLE UY V hVUY).hom.FormallyUnramified :=
    HasRingHomProperty.appLE @FormallyUnramified ν' inferInstance ⟨UY, hUYaff⟩ ⟨V, hV⟩ hVUY
  have hle : V ≤ q ⁻¹ᵁ ⊤ := le_top
  -- the rings and their algebra structures
  let _ : Algebra Γ(S, V_S) Γ(X, W) := (f.appLE V_S W hWV).hom.toAlgebra
  let _ : Algebra Γ(S, V_S) Γ(Spec (.of K), ⊤) := (a.appLE V_S ⊤ hUST).hom.toAlgebra
  let _ : Algebra Γ(X, W) Γ(pullback f a, UY) :=
    ((pullback.fst f a).appLE W UY (by rw [hUYdef]; exact inf_le_left)).hom.toAlgebra
  let _ : Algebra Γ(Spec (.of K), ⊤) Γ(pullback f a, UY) :=
    ((pullback.snd f a).appLE ⊤ UY (by rw [hUYdef]; exact inf_le_right)).hom.toAlgebra
  let _ : Algebra Γ(S, V_S) Γ(pullback f a, UY) :=
    ((f.appLE V_S W hWV) ≫ (pullback.fst f a).appLE W UY
      (by rw [hUYdef]; exact inf_le_left)).hom.toAlgebra
  let _ : Algebra Γ(pullback f a, UY) Γ(Y, V) := (ν'.appLE UY V hVUY).hom.toAlgebra
  let _ : Algebra Γ(Spec (.of K), ⊤) Γ(Y, V) := (q.appLE ⊤ V hle).hom.toAlgebra
  let _ : Algebra Γ(X, W) Γ(Y, V) := (ν.appLE W V hVW).hom.toAlgebra
  have : IsScalarTower Γ(S, V_S) Γ(X, W) Γ(pullback f a, UY) :=
    IsScalarTower.of_algebraMap_eq fun _ => rfl
  have : IsScalarTower Γ(S, V_S) Γ(Spec (.of K), ⊤) Γ(pullback f a, UY) := by
    refine IsScalarTower.of_algebraMap_eq fun r => ?_
    change ((f.appLE V_S W hWV) ≫ (pullback.fst f a).appLE W UY _) r =
      ((a.appLE V_S ⊤ hUST) ≫ (pullback.snd f a).appLE ⊤ UY _) r
    rw [Scheme.Hom.appLE_comp_appLE, Scheme.Hom.appLE_comp_appLE]
    simp only [H.w]
  have : IsScalarTower Γ(Spec (.of K), ⊤) Γ(pullback f a, UY) Γ(Y, V) := by
    refine IsScalarTower.of_algebraMap_eq fun r => ?_
    change (q.appLE ⊤ V hle) r = ((pullback.snd f a).appLE ⊤ UY _ ≫ ν'.appLE UY V hVUY) r
    rw [Scheme.Hom.appLE_comp_appLE]
    simp only [ν', pullback.lift_snd]
  have : Algebra.IsPushout Γ(S, V_S) Γ(X, W) Γ(Spec (.of K), ⊤) Γ(pullback f a, UY) :=
    CommRingCat.isPushout_iff_isPushout.mp hpush
  have : Algebra.IsPushout Γ(S, V_S) Γ(Spec (.of K), ⊤) Γ(X, W) Γ(pullback f a, UY) :=
    Algebra.IsPushout.symm inferInstance
  have hC := span_D_of_isPushout Γ(S, V_S) Γ(Spec (.of K), ⊤) (A := Γ(X, W))
    (B := Γ(pullback f a, UY))
  have : Algebra.FormallyUnramified Γ(pullback f a, UY) Γ(Y, V) := hfu
  have hB := span_D_of_formallyUnramified (R := Γ(Spec (.of K), ⊤)) (A := Γ(pullback f a, UY))
    (B := Γ(Y, V)) (Set.range (algebraMap Γ(X, W) Γ(pullback f a, UY))) (by
      rw [← Set.range_comp]; exact hC)
  have himg : algebraMap Γ(pullback f a, UY) Γ(Y, V) ''
      Set.range (algebraMap Γ(X, W) Γ(pullback f a, UY)) =
        Set.range (ν.appLE W V hVW) := by
    rw [← Set.range_comp]
    congr 1
    funext b
    change ((pullback.fst f a).appLE W UY _ ≫ ν'.appLE UY V hVUY) b = ν.appLE W V hVW b
    rw [Scheme.Hom.appLE_comp_appLE]
    simp only [ν', pullback.lift_fst]
  rw [himg] at hB
  -- transport along `Γ(V, Ω¹_{Y/K}) ≅ Ω_{Γ(Y, V)/Γ(Spec K, ⊤)}`
  set e := sectionsEquiv q hV (isAffineOpen_top _) hle
  have hrange : (Set.range fun b : Γ(X, W) =>
      (universalDerivation q).sec V (ν.appLE W V hVW b)) =
      e '' (KaehlerDifferential.D Γ(Spec (.of K), ⊤) Γ(Y, V) '' Set.range (ν.appLE W V hVW)) := by
    ext ω
    constructor
    · rintro ⟨b, rfl⟩
      exact ⟨_, ⟨_, ⟨b, rfl⟩, rfl⟩, sectionsEquiv_d q hV (isAffineOpen_top _) hle _⟩
    · rintro ⟨_, ⟨_, ⟨b, rfl⟩, rfl⟩, rfl⟩
      exact ⟨b, (sectionsEquiv_d q hV (isAffineOpen_top _) hle _).symm⟩
  rw [hrange, show (⇑e : _ → _) = ⇑(e : _ →ₗ[Γ(Y, V)] _) from rfl, ← Submodule.map_span, hB,
    Submodule.map_top, LinearMap.range_eq_top]
  exact e.surjective

end Scheme


section Degree

open Module DeJongAlterations.StableModification.Cohomology
open DeJongAlterations.StableModification.CurvesField RosenlichtComponent
open DeJong (IsNodalCurve IsSmoothAt)

variable {X S Y : Scheme.{u}} (f : X ⟶ S) {K : Type u} [Field K] [IsAlgClosed K]
  (q : Y ⟶ Spec (.of K)) (ν : Y ⟶ X) (a : Spec (.of K) ⟶ S) (sq : ν ≫ f = q ≫ a)

/-- **The degree of `ω` on a curve formally unramified over a geometric fibre of a nodal curve**
(blueprint `cor:sm-omega-bcf-restriction-component`, conditional on the pole charts
`RosenlichtComponent.HasPoleCharts` at the points over the nodes): with the hypotheses of
`RosenlichtComponent.degree_pullback_dualizingSheaf_of_isNodalCurve`, unramifiedness relative to the
base change replaced by formal unramifiedness of `Y ⟶ X ×_S Spec K`,
`deg ν^* ω = 2 p_a(Y) - 2 + #E`. For the normalization `Y = Z̃` of an irreducible component of the
geometric fibre this is the degree statement of `cor:sm-omega-restriction-component`. -/
theorem degree_pullback_dualizingSheaf_of_formallyUnramified [IsNodalCurve f] [IsIntegral S]
    [IsLocallyNoetherian S] (hS : IsNormalScheme S)
    (hgen : ∀ x : X, f x = genericPoint S → IsSmoothAt f x)
    [IsIntegral Y] [CompactSpace Y]
    [IsAffineHom (Limits.pullback.diagonal (Limits.terminal.from Y))]
    [SmoothOfRelativeDimension 1 q] [TopologicalSpace.NoetherianSpace Y]
    [FormallyUnramified (pullback.lift ν q sq)]
    (hp : IsProjectiveOver q) (hdim : topologicalKrullDim Y ≤ 1)
    (hpt : ∃ y : Y, y ≠ genericPoint Y) (hnormal : IsNormalScheme Y) (E : Finset Y)
    (hE : ∀ y, y ∈ E ↔ ν y ∉ f.smoothLocus) (hEc : ∀ y ∈ E, IsClosed ({y} : Set Y))
    (hpole : HasPoleCharts f q ν a sq E) :
    (∀ i, FiniteDimensional K
        (cohomology ((Scheme.Modules.pullback ν).obj (dualizingSheaf f)) (structureCoeff q) i)) ∧
      DualityScheme.eulerCharOf ((Scheme.Modules.pullback ν).obj (dualizingSheaf f))
          (structureCoeff q) - Genus.eulerChar Y (structureCoeff q) =
        2 * Genus.arithmeticGenus Y (structureCoeff q) - 2 + E.card :=
  degree_pullback_dualizingSheaf_of_isNodalCurve f q ν a sq hS hgen hp hdim hpt hnormal E hE hEc
    (fun y _ => isUnramifiedAt_of_formallyUnramified f q ν a sq y) hpole

end Degree

end DeJongAlterations.StableModification.Omega
