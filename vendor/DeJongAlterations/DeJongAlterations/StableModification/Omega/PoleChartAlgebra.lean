/-!
# The local algebra of the pole charts at the nodes

Blueprint `sm-omega-component-degree.tex`, `lem:sm-omega-cd-pole-algebra` (the algebraic core of
`lem:sm-omega-bcf-pole-chart` in `sm-omega-base-change-fibre.tex`). Let `R → O` be étale,
`N = O[u,v]/(uv - c)`, `A → T` étale and faithfully flat with an étale `N → T` (an étale node
chart of a nodal curve over `Spec R`, with `A = Γ(X, W)`), and let `A → B` be a map to a
`K`-algebra `B`, `K = K̄`, compatible over `R` (the sections of the normalization of a component
of a geometric fibre over `ν⁻¹ W`). Let `𝔫 ⊆ B` be a maximal ideal over a point all of whose
preimages in `Spec T` are nodes (`u, v` vanish there), with `B_𝔫` a discrete valuation ring with
uniformizer `t`, `Ω_{B/K}` free on `β₀` and spanned by the differentials of the image of `A`
(unramifiedness). Suppose `σ` generates `ω` on `Spec A` with `da = c_a σ` (`coef a = c_a`), that on
`Spec T` the pullback of `σ` is `g · du/u = -g · dv/v` with `g` a unit, and that `ζ = θ(σ)` is a
differential on `D(t) ⊆ Spec B` with `d(ν a) = ν(c_a) ζ`. Then
`t ζ = (e₁/e₂) β₀` with `e₁, e₂ ∉ 𝔫` (`exists_mul_eq_of_node`): **the base change of `σ` has a
simple pole at `𝔫`**.

## Proof

Let `L` be the local ring of `B ⊗_A T` at a prime over `𝔫` (`exists_etale_local_extension`; it
exists since `B → B ⊗_A T` is faithfully flat). `B → L` is étale, so `𝔫 L = 𝔪_L = (t)`, `t` is a
non-zero-divisor of `L`, and `L` is a discrete valuation ring
(`isDiscreteValuationRing_of_maximalIdeal_eq_span`). The images `ū, v̄` lie in `𝔪_L`, `ūv̄ = c̄ = 0`
(the local rings of `K ⊗_R O` are fields), and `Ω_{L/K}` is spanned by `dū, dv̄`
(`span_D_coordinates`, unramifiedness, `span_map_eq_top_of_formallyEtale`). By `branch_of_node`
one of `ū, v̄`, say `x̄`, is a uniformizer with `dx̄` a basis. In `F = L[1/t]` the relation
`x̄ ζ = ±g dx̄` gives `t ζ = (unit of L) · β₀`, and comparing valuations in `B_𝔫` and `L`
(`exists_mul_eq_of_branch`) gives `e₁, e₂`.

M. Temkin, *Stable modification of relative curves*, J. Algebraic Geom. 19 (2010), §1.2 (b)
(`semi-stable.tex`, T:1702–1704: `ω` is generated near a node by `du/u = -dv/v`, whose residues on
the two branches are `±1`).
-/

noncomputable section

universe u

open IsLocalRing TensorProduct
open DeJongAlterations.Algebra.NodeBlowupChart

namespace DeJongAlterations.StableModification.Omega.PoleChart

section DVR

variable {L : Type*} [CommRing L] [IsLocalRing L] [IsNoetherianRing L]

/-- In a Noetherian local ring whose maximal ideal is generated by a non-zero-divisor `t`, every
nonzero element is `t ^ n` times a unit (Krull's intersection theorem). -/
theorem exists_eq_pow_mul_unit {t : L} (hm : maximalIdeal L = Ideal.span {t}) {x : L}
    (hx : x ≠ 0) : ∃ (n : ℕ) (w : Lˣ), x = t ^ n * w := by
  classical
  have hK := Ideal.iInf_pow_eq_bot_of_isLocalRing (maximalIdeal L) (maximalIdeal.isMaximal L).ne_top
  have hex : ∃ n : ℕ, x ∉ Ideal.span {t ^ n} := by
    by_contra h
    push Not at h
    apply hx
    rw [← Ideal.mem_bot, ← hK, Ideal.mem_iInf]
    intro n
    rw [hm, Ideal.span_singleton_pow]
    exact h n
  set N := Nat.find hex with hN
  have hNspec : x ∉ Ideal.span {t ^ N} := Nat.find_spec hex
  have hN0 : N ≠ 0 := by
    intro h0
    apply hNspec
    rw [h0, pow_zero, Ideal.span_singleton_one]
    trivial
  obtain ⟨n, hn⟩ := Nat.exists_eq_add_one_of_ne_zero hN0
  have hxn : x ∈ Ideal.span {t ^ n} := by
    have := Nat.find_min hex (show n < N by omega)
    push Not at this
    exact this
  obtain ⟨y, rfl⟩ := Ideal.mem_span_singleton'.mp hxn
  refine ⟨n, ?_⟩
  have hy : y ∉ maximalIdeal L := by
    intro hy
    rw [hm] at hy
    obtain ⟨z, rfl⟩ := Ideal.mem_span_singleton'.mp hy
    apply hNspec
    rw [hn, Ideal.mem_span_singleton']
    exact ⟨z, by ring⟩
  have hyu : IsUnit y := by
    by_contra h
    exact hy ((mem_maximalIdeal y).mpr h)
  exact ⟨hyu.unit, by rw [IsUnit.unit_spec, mul_comm]⟩

/-- **A Noetherian local ring whose maximal ideal is generated by a non-zero-divisor is a discrete
valuation ring** with uniformizer the generator. -/
theorem isDiscreteValuationRing_of_maximalIdeal_eq_span {t : L} (ht : IsSMulRegular L t)
    (hm : maximalIdeal L = Ideal.span {t}) :
    ∃ _ : IsDomain L, IsDiscreteValuationRing L ∧ Irreducible t := by
  have ht0 : t ≠ 0 := by
    intro h0
    have := ht (show t • (1 : L) = t • 0 by rw [h0, zero_smul, smul_zero])
    exact one_ne_zero this
  have htn : ∀ n : ℕ, t ^ n ≠ 0 := by
    intro n hn
    have hreg : IsSMulRegular L (t ^ n) := ht.pow n
    have := hreg (show t ^ n • (1 : L) = t ^ n • 0 by rw [hn, zero_smul, smul_zero])
    exact one_ne_zero this
  have hnzd : NoZeroDivisors L := by
    refine ⟨fun {a b} hab => ?_⟩
    by_contra h
    push Not at h
    obtain ⟨n, w, rfl⟩ := exists_eq_pow_mul_unit hm h.1
    obtain ⟨m, w', rfl⟩ := exists_eq_pow_mul_unit hm h.2
    apply htn (n + m)
    have : t ^ (n + m) * ((w : L) * w') = 0 := by
      rw [← hab]; ring
    exact (Units.mul_left_eq_zero (w * w')).mp (by simpa using this)
  have hdom : IsDomain L := NoZeroDivisors.to_isDomain L
  have hirr : Irreducible t := IsDiscreteValuationRing.irreducible_of_span_eq_maximalIdeal t ht0 hm
  refine ⟨hdom, ?_, hirr⟩
  refine IsDiscreteValuationRing.ofHasUnitMulPowIrreducibleFactorization ⟨t, hirr, fun {x} hx => ?_⟩
  obtain ⟨n, w, rfl⟩ := exists_eq_pow_mul_unit hm hx
  exact ⟨n, w, rfl⟩

end DVR


section Kaehler

/-- **Differentials of an étale node chart**: if `T` is formally étale over `O[u,v]/(uv - c)` and
`O` is formally unramified over `R`, then `Ω_{T/R}` is spanned by `du` and `dv`. -/
theorem span_D_coordinates {R O : Type u} [CommRing R] [CommRing O] [Algebra R O] (c : O)
    {T : Type*} [CommRing T] [Algebra (Node O c) T] [Algebra R T] [IsScalarTower R (Node O c) T]
    [Algebra.FormallyUnramified R O] [Algebra.FormallyEtale (Node O c) T] :
    Submodule.span T {KaehlerDifferential.D R T (algebraMap (Node O c) T (coordinate c 0)),
      KaehlerDifferential.D R T (algebraMap (Node O c) T (coordinate c 1))} = ⊤ := by
  set N := Submodule.span T {KaehlerDifferential.D R T (algebraMap (Node O c) T (coordinate c 0)),
      KaehlerDifferential.D R T (algebraMap (Node O c) T (coordinate c 1))}
  have hj : ∀ j : Fin 2,
      KaehlerDifferential.D R T (algebraMap (Node O c) T (coordinate c j)) ∈ N := by
    intro j
    fin_cases j
    · exact Submodule.subset_span (Set.mem_insert _ _)
    · exact Submodule.subset_span (Set.mem_insert_of_mem _ rfl)
  rw [eq_top_iff, ← span_D_algebraMap_eq_top (R := R) (S := Node O c) (T := T), Submodule.span_le]
  rintro _ ⟨b, rfl⟩
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective b
  dsimp only
  induction p using MvPolynomial.induction_on with
  | C r =>
    change KaehlerDifferential.D R T (algebraMap (Node O c) T (algebraMap O (Node O c) r)) ∈ N
    rw [D_algebraMap_base_eq_zero]
    exact N.zero_mem
  | add p q hp hq =>
    rw [map_add, map_add, map_add]
    exact N.add_mem hp hq
  | mul_X p j hp =>
    rw [map_mul, map_mul, Derivation.leibniz]
    exact N.add_mem (N.smul_mem _ (hj j)) (N.smul_mem _ hp)

variable {R S S' : Type*} [CommRing R] [CommRing S] [CommRing S'] [Algebra R S] [Algebra S S']
  [Algebra R S'] [IsScalarTower R S S']

/-- The image of a spanning set of `Ω_{S/R}` spans `Ω_{S'/R}` along a formally étale `S → S'`. -/
theorem span_map_eq_top_of_formallyEtale [Algebra.FormallyEtale S S'] {s : Set Ω[S⁄R]}
    (hs : Submodule.span S s = ⊤) :
    Submodule.span S' (KaehlerDifferential.map R R S S' '' s) = ⊤ := by
  set N := Submodule.span S' (KaehlerDifferential.map R R S S' '' s)
  have hmap : ∀ ω : Ω[S⁄R], KaehlerDifferential.map R R S S' ω ∈ N := by
    intro ω
    have hω : ω ∈ Submodule.span S s := by rw [hs]; trivial
    induction hω using Submodule.span_induction with
    | mem x hx => exact Submodule.subset_span ⟨x, hx, rfl⟩
    | zero => rw [map_zero]; exact N.zero_mem
    | add x y _ _ hx hy => rw [map_add]; exact N.add_mem hx hy
    | smul a x _ hx =>
      rw [LinearMap.map_smul_of_tower, ← algebraMap_smul S' a]
      exact N.smul_mem _ hx
  rw [eq_top_iff, ← span_D_algebraMap_eq_top (R := R) (S := S) (T := S'), Submodule.span_le]
  rintro _ ⟨b, rfl⟩
  change KaehlerDifferential.D R S' (algebraMap S S' b) ∈ N
  rw [← KaehlerDifferential.map_D R R S S' b]
  exact hmap _

/-- **Free generators of `Ω` base change along formally étale maps**: if `β` freely generates
`Ω_{S/R}`, then its image freely generates `Ω_{S'/R}`. -/
theorem bijective_smul_map_of_formallyEtale [Algebra.FormallyEtale S S'] {β : Ω[S⁄R]}
    (hβ : Function.Bijective fun s : S => s • β) :
    Function.Bijective fun s' : S' => s' • KaehlerDifferential.map R R S S' β := by
  let e : S ≃ₗ[S] Ω[S⁄R] := LinearEquiv.ofBijective (LinearMap.toSpanSingleton S _ β) hβ
  let E : S' ≃ₗ[S'] Ω[S'⁄R] :=
    (Algebra.TensorProduct.rid S S' S').toLinearEquiv.symm ≪≫ₗ (e.baseChange S S' _ _) ≪≫ₗ
      KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale R S S'
  have h1 : e 1 = β := by
    change (1 : S) • β = β
    exact one_smul S β
  have hE : (fun s' : S' => s' • KaehlerDifferential.map R R S S' β) = E := by
    funext s'
    change _ = KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale R S S'
      (e.baseChange S S' _ _ ((Algebra.TensorProduct.rid S S' S').toLinearEquiv.symm s'))
    rw [show (Algebra.TensorProduct.rid S S' S').toLinearEquiv.symm s' = s' ⊗ₜ 1 from
      Algebra.TensorProduct.rid_symm_apply S S' s', LinearEquiv.baseChange_tmul, h1,
      KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale_apply,
      KaehlerDifferential.mapBaseChange_tmul]
  rw [hE]
  exact E.bijective

end Kaehler

section LocalExtension

variable {A : Type u} [CommRing A] {T : Type u} [CommRing T] [Algebra A T]
  {B : Type u} [CommRing B] [Algebra A B]

/-- **The local ring of `B ⊗_A T` over a maximal ideal of `B`.** Let `A → T` be étale and
faithfully flat, `B` a Noetherian `A`-algebra and `𝔫 ⊆ B` a maximal ideal which is generated by
`t` locally (`𝔫 B_𝔫 = t B_𝔫`). Then there is a Noetherian local ring `L` with a formally étale,
flat map `B → L` and a map `T → L` agreeing on `A`, such that `𝔪_L` lies over `𝔫` and
`𝔪_L = (t)`: the local ring of `B ⊗_A T` at a prime over `𝔫`. -/
theorem exists_etale_local_extension [Algebra.Etale A T] [Module.FaithfullyFlat A T]
    [IsNoetherianRing B] (𝔫 : Ideal B) [𝔫.IsMaximal] (t : B) (ht : t ∈ 𝔫)
    (htgen : ∀ n ∈ 𝔫, ∃ s ∉ 𝔫, ∃ b, s * n = t * b) :
    ∃ (L : Type u) (_ : CommRing L) (_ : IsLocalRing L) (_ : IsNoetherianRing L)
      (_ : Algebra B L) (_ : Algebra.FormallyEtale B L) (_ : Module.Flat B L) (φL : T →+* L),
      (∀ a, φL (algebraMap A T a) = algebraMap B L (algebraMap A B a)) ∧
      (maximalIdeal L).comap (algebraMap B L) = 𝔫 ∧
      maximalIdeal L = Ideal.span {algebraMap B L t} := by
  obtain ⟨P, hP⟩ := PrimeSpectrum.comap_surjective_of_faithfullyFlat (A := B) (B := B ⊗[A] T)
    ⟨𝔫, inferInstance⟩
  have hP' : P.asIdeal.comap (algebraMap B (B ⊗[A] T)) = 𝔫 := congrArg PrimeSpectrum.asIdeal hP
  let L := Localization.AtPrime P.asIdeal
  have : Algebra.FiniteType B (B ⊗[A] T) := inferInstance
  have : IsNoetherianRing (B ⊗[A] T) := Algebra.FiniteType.isNoetherianRing B _
  have hcomap : (maximalIdeal L).comap (algebraMap B L) = 𝔫 := by
    have h1 : (maximalIdeal L).comap (algebraMap (B ⊗[A] T) L) = P.asIdeal :=
      Localization.AtPrime.under_maximalIdeal (I := P.asIdeal)
    rw [IsScalarTower.algebraMap_eq B (B ⊗[A] T) L, ← Ideal.comap_comap, h1, hP']
  have : P.asIdeal.LiesOver 𝔫 := ⟨hP'.symm⟩
  let := Localization.AtPrime.algebraOfLiesOver 𝔫 P.asIdeal
  have hmap : 𝔫.map (algebraMap B L) = maximalIdeal L :=
    ((Algebra.isUnramifiedAt_iff_map_eq B 𝔫 P.asIdeal).mp inferInstance).2
  have hspan : maximalIdeal L = Ideal.span {algebraMap B L t} := by
    rw [← hmap]
    apply le_antisymm
    · rw [Ideal.map_le_iff_le_comap]
      intro n hn
      obtain ⟨s, hs, b, hsn⟩ := htgen n hn
      have hsu : IsUnit (algebraMap B L s) := by
        by_contra hnu
        apply hs
        rw [← hcomap]
        exact (mem_maximalIdeal _).mpr hnu
      rw [Ideal.mem_comap, Ideal.mem_span_singleton']
      refine ⟨(hsu.unit⁻¹ : Lˣ) * algebraMap B L b, ?_⟩
      have := congrArg (algebraMap B L) hsn
      rw [map_mul, map_mul] at this
      calc ((hsu.unit⁻¹ : Lˣ) : L) * algebraMap B L b * algebraMap B L t
          = ((hsu.unit⁻¹ : Lˣ) : L) * (algebraMap B L t * algebraMap B L b) := by ring
        _ = ((hsu.unit⁻¹ : Lˣ) : L) * (algebraMap B L s * algebraMap B L n) := by rw [this]
        _ = algebraMap B L n := by rw [← mul_assoc, IsUnit.val_inv_mul, one_mul]
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      exact Ideal.mem_map_of_mem _ ht
  refine ⟨L, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance,
    inferInstance, (algebraMap (B ⊗[A] T) L).comp Algebra.TensorProduct.includeRight.toRingHom,
    fun a => ?_, hcomap, hspan⟩
  rw [RingHom.comp_apply, IsScalarTower.algebraMap_apply B (B ⊗[A] T) L]
  congr 1
  change (1 : B) ⊗ₜ[A] algebraMap A T a = algebraMap A B a ⊗ₜ[A] (1 : T)
  rw [Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one, TensorProduct.tmul_smul,
    TensorProduct.smul_tmul']

end LocalExtension

section MapMap

variable {K : Type*} [CommRing K] {B L F : Type*} [CommRing B] [CommRing L] [CommRing F]
  [Algebra K B] [Algebra K L] [Algebra K F] [Algebra B L] [Algebra L F] [Algebra B F]
  [IsScalarTower K B L] [IsScalarTower K L F] [IsScalarTower K B F] [IsScalarTower B L F]

/-- Composition of the maps of Kähler differentials along `B → L → F`. -/
theorem map_map_apply (ω : Ω[B⁄K]) :
    KaehlerDifferential.map K K L F (KaehlerDifferential.map K K B L ω) =
      KaehlerDifferential.map K K B F ω := by
  have hω : ω ∈ Submodule.span B (Set.range (KaehlerDifferential.D K B)) := by
    rw [KaehlerDifferential.span_range_derivation]; trivial
  induction hω using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨b, rfl⟩ := hx
    rw [KaehlerDifferential.map_D, KaehlerDifferential.map_D, KaehlerDifferential.map_D,
      ← IsScalarTower.algebraMap_apply]
  | zero => simp only [map_zero]
  | add x y _ _ hx hy => simp only [map_add, hx, hy]
  | smul a x _ hx =>
    rw [LinearMap.map_smul_of_tower, LinearMap.map_smul_of_tower, LinearMap.map_smul_of_tower,
      hx]

end MapMap

section Branch

variable {K : Type u} [Field K]
  {R : Type u} [CommRing R] [Algebra R K]
  {A : Type u} [CommRing A] [Algebra R A]
  {T : Type u} [CommRing T] [Algebra A T] [Algebra R T] [IsScalarTower R A T]
  {B : Type u} [CommRing B] [IsDomain B] [Algebra A B] [Algebra K B] [Algebra R B]
  [IsScalarTower R A B] [IsScalarTower R K B]

omit [Algebra R A] [IsScalarTower R A T] [Algebra R B] [IsScalarTower R A B]
  [IsScalarTower R K B] in
/-- **The pole along a branch.** In the situation of `exists_mul_eq_of_node`, let `L` be a discrete
valuation ring, formally étale over `B`, with `𝔪_L` over `𝔫` and uniformizer `t`, and let `x ∈ T`
map to a uniformizer `x̄` of `L` with `dx̄` spanning `Ω_{L/K}`. If `x · d(φ a₀) = c₀ γ · dx` on
`D(x) ⊆ Spec T` (`γ` a unit at the point, `c₀ = coef a₀ ≠ 0` on `B`) and `d(ν a₀) = ν(c₀) ζ` on
`D(t) ⊆ Spec B`, then `t ζ = (e₁/e₂) β₀` with `e₁, e₂ ∉ 𝔫`. -/
theorem exists_mul_eq_of_branch
    (𝔫 : Ideal B) [𝔫.IsMaximal] [IsDiscreteValuationRing (Localization.AtPrime 𝔫)]
    {t : B} (ht : Irreducible (algebraMap B (Localization.AtPrime 𝔫) t))
    {β₀ : Ω[B⁄K]} (hβ₀ : Function.Bijective fun b : B => b • β₀)
    (L : Type u) [CommRing L] [IsDomain L] [IsDiscreteValuationRing L] [Algebra B L]
    [Algebra.FormallyEtale B L] [Algebra K L] [IsScalarTower K B L] [Algebra R L]
    [IsScalarTower R K L]
    (hinj : Function.Injective (algebraMap B L))
    (hcomap : (maximalIdeal L).comap (algebraMap B L) = 𝔫)
    (htL : Irreducible (algebraMap B L t))
    (φL : T →+* L) (hφA : ∀ a, φL (algebraMap A T a) = algebraMap B L (algebraMap A B a))
    (hφR : ∀ r, φL (algebraMap R T r) = algebraMap R L r)
    {x : T} (hx : Irreducible (φL x))
    (hDx : Submodule.span L {KaehlerDifferential.D K L (φL x)} = ⊤)
    {γ : T} (hγ : IsUnit (φL γ)) {a₀ c₀ : A} (hc₀ : algebraMap A B c₀ ≠ 0)
    (Tx : Type u) [CommRing Tx] [Algebra T Tx] [IsLocalization.Away x Tx] [Algebra R Tx]
    [IsScalarTower R T Tx]
    (hTx : algebraMap T Tx x • KaehlerDifferential.D R Tx (algebraMap T Tx (algebraMap A T a₀)) =
      algebraMap T Tx (algebraMap A T c₀ * γ) • KaehlerDifferential.D R Tx (algebraMap T Tx x))
    (Bt : Type u) [CommRing Bt] [Algebra B Bt] [IsLocalization.Away t Bt] [Algebra K Bt]
    [IsScalarTower K B Bt] (ζ : Ω[Bt⁄K])
    (hζ : KaehlerDifferential.D K Bt (algebraMap B Bt (algebraMap A B a₀)) =
      algebraMap B Bt (algebraMap A B c₀) • ζ) :
    ∃ e₁ e₂ : B, e₁ ∉ 𝔫 ∧ e₂ ∉ 𝔫 ∧
      algebraMap B Bt e₂ • (algebraMap B Bt t • ζ) =
        algebraMap B Bt e₁ • KaehlerDifferential.map K K B Bt β₀ := by
  classical
  set tL := algebraMap B L t with htLdef
  have htL0 : tL ≠ 0 := htL.ne_zero
  let F := Localization.Away tL
  have hLF : Function.Injective (algebraMap L F) :=
    IsLocalization.injective F (powers_le_nonZeroDivisors_of_noZeroDivisors htL0)
  have htF : IsUnit (algebraMap L F tL) := IsLocalization.Away.algebraMap_isUnit tL
  have hunitF : ∀ y : L, y ≠ 0 → IsUnit (algebraMap L F y) := by
    intro y hy
    obtain ⟨n, w, hw⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hy htL
    rw [hw, map_mul, map_pow]
    exact (w.isUnit.map _).mul (htF.pow n)
  have : IsScalarTower K B F := IsScalarTower.of_algebraMap_eq fun k => by
    rw [IsScalarTower.algebraMap_apply K L F, IsScalarTower.algebraMap_apply K B L,
      ← IsScalarTower.algebraMap_apply B L F]
  have : IsScalarTower R K F := IsScalarTower.of_algebraMap_eq fun r => by
    rw [IsScalarTower.algebraMap_apply R L F, IsScalarTower.algebraMap_apply R K L,
      ← IsScalarTower.algebraMap_apply K L F]
  have : Algebra.FormallyEtale B F := Algebra.FormallyEtale.comp B L F
  -- the maps `Bt → F` and `Tx → F`
  have htBF : IsUnit (algebraMap B F t) := by
    rw [IsScalarTower.algebraMap_apply B L F]; exact htF
  let ρB : Bt →+* F := IsLocalization.Away.lift t htBF
  let : Algebra Bt F := ρB.toAlgebra
  have hρB : ∀ b, ρB (algebraMap B Bt b) = algebraMap B F b := fun b =>
    IsLocalization.Away.lift_eq t htBF b
  have : IsScalarTower B Bt F := IsScalarTower.of_algebraMap_eq fun b => (hρB b).symm
  have : IsScalarTower K Bt F := IsScalarTower.of_algebraMap_eq fun k => by
    change algebraMap K F k = ρB (algebraMap K Bt k)
    rw [IsScalarTower.algebraMap_apply K B Bt, hρB, ← IsScalarTower.algebraMap_apply]
  have hxF : IsUnit (((algebraMap L F).comp φL) x) := hunitF _ hx.ne_zero
  let ρT : Tx →+* F := IsLocalization.Away.lift x hxF
  let : Algebra Tx F := ρT.toAlgebra
  have hρT : ∀ y, ρT (algebraMap T Tx y) = algebraMap L F (φL y) := fun y =>
    IsLocalization.Away.lift_eq x hxF y
  have : IsScalarTower R Tx F := IsScalarTower.of_algebraMap_eq fun r => by
    change algebraMap R F r = ρT (algebraMap R Tx r)
    rw [IsScalarTower.algebraMap_apply R T Tx, hρT, hφR, IsScalarTower.algebraMap_apply R L F]
  -- the relations in `Ω_{F/K}`
  have hA : ∀ a : A, algebraMap L F (φL (algebraMap A T a)) = algebraMap B F (algebraMap A B a) :=
    fun a => by rw [hφA, ← IsScalarTower.algebraMap_apply]
  have h1 := congrArg (KaehlerDifferential.map R K Tx F) hTx
  rw [LinearMap.map_smul, LinearMap.map_smul, KaehlerDifferential.map_D,
    KaehlerDifferential.map_D, ← algebraMap_smul F (algebraMap T Tx x),
    ← algebraMap_smul F (algebraMap T Tx (algebraMap A T c₀ * γ))] at h1
  change ρT (algebraMap T Tx x) • KaehlerDifferential.D K F (ρT (algebraMap T Tx
      (algebraMap A T a₀))) = ρT (algebraMap T Tx (algebraMap A T c₀ * γ)) •
        KaehlerDifferential.D K F (ρT (algebraMap T Tx x)) at h1
  rw [hρT, hρT, hρT, hA, map_mul, map_mul, hA] at h1
  have h2 := congrArg (KaehlerDifferential.map K K Bt F) hζ
  rw [LinearMap.map_smul, KaehlerDifferential.map_D, ← algebraMap_smul F] at h2
  change KaehlerDifferential.D K F (ρB (algebraMap B Bt (algebraMap A B a₀))) =
    ρB (algebraMap B Bt (algebraMap A B c₀)) • KaehlerDifferential.map K K Bt F ζ at h2
  rw [hρB, hρB] at h2
  set ζF := KaehlerDifferential.map K K Bt F ζ with hζF
  set xF := algebraMap L F (φL x) with hxFdef
  set cF := algebraMap B F (algebraMap A B c₀) with hcF
  set γF := algebraMap L F (φL γ) with hγF
  have hcFu : IsUnit cF := by
    rw [hcF, IsScalarTower.algebraMap_apply B L F]
    refine hunitF _ fun h0 => hc₀ (hinj ?_)
    rw [h0, map_zero]
  rw [h2, smul_smul, mul_comm, ← smul_smul, ← smul_smul] at h1
  have h3 : xF • ζF = γF • KaehlerDifferential.D K F xF := hcFu.smul_left_cancel.mp h1
  -- the free generators on `L`, `F`, `Bt`
  have : Algebra.FormallyEtale B Bt := Algebra.FormallyEtale.of_isLocalization (Submonoid.powers t)
  have hβL := bijective_smul_map_of_formallyEtale (S' := L) hβ₀
  have hβF := bijective_smul_map_of_formallyEtale (S' := F) hβ₀
  have hβBt := bijective_smul_map_of_formallyEtale (S' := Bt) hβ₀
  set βL := KaehlerDifferential.map K K B L β₀ with hβLdef
  set βF := KaehlerDifferential.map K K B F β₀ with hβFdef
  set βBt := KaehlerDifferential.map K K B Bt β₀ with hβBtdef
  -- `dx̄ = w βL` with `w` a unit
  obtain ⟨w, hw⟩ := hβL.surjective (KaehlerDifferential.D K L (φL x))
  have hβLmem : βL ∈ Submodule.span L {KaehlerDifferential.D K L (φL x)} := by
    rw [hDx]; trivial
  obtain ⟨w', hw'⟩ := Submodule.mem_span_singleton.mp hβLmem
  have hwu : IsUnit w := by
    have : (w' * w) • βL = (1 : L) • βL := by
      rw [mul_smul, one_smul]
      change w' • (fun l : L => l • βL) w = βL
      rw [hw, hw']
    exact IsUnit.of_mul_eq_one_right w' (hβL.injective this)
  have hDxF : KaehlerDifferential.D K F xF = algebraMap L F w • βF := by
    rw [hxFdef, ← KaehlerDifferential.map_D K K L F, ← show w • βL = _ from hw,
      LinearMap.map_smul, algebraMap_smul, hβLdef, map_map_apply]
  -- `t ζ = h βBt`
  obtain ⟨h, hh⟩ := hβBt.surjective (algebraMap B Bt t • ζ)
  change h • βBt = algebraMap B Bt t • ζ at hh
  have hhF : algebraMap B F t • ζF = ρB h • βF := by
    have := congrArg (KaehlerDifferential.map K K Bt F) hh
    rw [LinearMap.map_smul, LinearMap.map_smul, ← algebraMap_smul F h,
      ← algebraMap_smul F (algebraMap B Bt t), hβBtdef, map_map_apply] at this
    change ρB h • βF = ρB (algebraMap B Bt t) • ζF at this
    rw [hρB] at this
    exact this.symm
  -- compare coefficients: `x̄ h = t γ w` in `F`
  have h4 : (xF * ρB h) • βF = (algebraMap B F t * (γF * algebraMap L F w)) • βF := by
    rw [mul_smul, ← hhF, smul_comm, h3, hDxF, mul_smul, mul_smul]
  have h5 : xF * ρB h = algebraMap B F t * (γF * algebraMap L F w) := hβF.injective h4
  obtain ⟨w₀, hw₀⟩ := IsDiscreteValuationRing.associated_of_irreducible L htL hx
  have hxF' : xF = algebraMap B F t * algebraMap L F w₀ := by
    rw [hxFdef, ← hw₀, map_mul, ← IsScalarTower.algebraMap_apply]
  rw [hxF', mul_assoc] at h5
  have h6 : algebraMap L F w₀ * ρB h = γF * algebraMap L F w := htBF.mul_left_cancel h5
  obtain ⟨w₂, hw₂u, hhw₂⟩ : ∃ w₂ : L, IsUnit w₂ ∧ ρB h = algebraMap L F w₂ :=
    ⟨((w₀⁻¹ : Lˣ) : L) * (φL γ * w), (w₀⁻¹).isUnit.mul (hγ.mul hwu), by
      rw [map_mul, map_mul, ← h6, ← mul_assoc, ← map_mul, Units.inv_mul, map_one, one_mul]⟩
  -- `h = e / t ^ n` and `e = w₂ tⁿ` in `L`
  obtain ⟨⟨e, ⟨_, n, rfl⟩⟩, he⟩ := IsLocalization.mk'_surjective (Submonoid.powers t) h
  have he' : h * algebraMap B Bt (t ^ n) = algebraMap B Bt e := by
    rw [← he]; exact IsLocalization.mk'_spec Bt e _
  have heL : algebraMap B L e = w₂ * tL ^ n := by
    apply hLF
    have := congrArg ρB he'
    rw [map_mul, hρB, hρB, hhw₂] at this
    calc algebraMap L F (algebraMap B L e) = algebraMap B F e :=
          (IsScalarTower.algebraMap_apply B L F e).symm
      _ = algebraMap L F w₂ * algebraMap B F (t ^ n) := this.symm
      _ = algebraMap L F (w₂ * tL ^ n) := by
          rw [map_mul, IsScalarTower.algebraMap_apply B L F, map_pow, map_pow]
  have he0 : e ≠ 0 := by
    rintro rfl
    rw [map_zero] at heL
    exact pow_ne_zero n htL0 ((hw₂u.mul_right_eq_zero).mp heL.symm)
  -- in `B_𝔫`: `e₂ e = e₁ tᵐ`
  have hBD : Function.Injective (algebraMap B (Localization.AtPrime 𝔫)) :=
    IsLocalization.injective (Localization.AtPrime 𝔫) 𝔫.primeCompl_le_nonZeroDivisors
  obtain ⟨m, u₀, hu₀⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible
    (fun h0 => he0 (hBD (h0.trans (map_zero _).symm))) ht
  obtain ⟨⟨e₁, s₂⟩, he₁₂⟩ := IsLocalization.mk'_surjective 𝔫.primeCompl
    (u₀ : Localization.AtPrime 𝔫)
  simp only at he₁₂
  set e₂ : B := s₂.1 with he₂def
  have he₂ : e₂ ∉ 𝔫 := fun h => s₂.2 h
  have he₁ : e₁ ∉ 𝔫 := by
    intro h1
    have : IsLocalization.mk' (Localization.AtPrime 𝔫) e₁ s₂ ∈
        maximalIdeal (Localization.AtPrime 𝔫) := by
      rw [IsLocalization.AtPrime.mk'_mem_maximal_iff (Localization.AtPrime 𝔫) 𝔫]; exact h1
    rw [he₁₂] at this
    exact (mem_maximalIdeal _).mp this u₀.isUnit
  have hB : e₂ * e = e₁ * t ^ m := by
    apply hBD
    rw [map_mul, map_mul, hu₀, map_pow, ← he₁₂, ← mul_assoc,
      mul_comm (algebraMap B (Localization.AtPrime 𝔫) e₂), he₂def, IsLocalization.mk'_spec]
  -- comparing valuations in `L`: `n = m`
  have hunitL : ∀ b : B, b ∉ 𝔫 → IsUnit (algebraMap B L b) := by
    intro b hb
    by_contra hnu
    apply hb
    rw [← hcomap]
    exact (mem_maximalIdeal _).mpr hnu
  have hnm : n = m := by
    have h7 := congrArg (algebraMap B L) hB
    rw [map_mul, map_mul, heL, map_pow] at h7
    have h8 : (((hunitL e₂ he₂).unit * hw₂u.unit : Lˣ) : L) * tL ^ n =
        ((hunitL e₁ he₁).unit : L) * tL ^ m := by
      simp only [Units.val_mul, IsUnit.unit_spec]
      rw [← h7]
      ring
    exact IsDiscreteValuationRing.unit_mul_pow_congr_pow htL htL _ _ n m h8
  subst hnm
  -- in `Bt`: `e₂ h = e₁`
  have htBt : IsUnit (algebraMap B Bt (t ^ n)) := by
    rw [map_pow]; exact (IsLocalization.Away.algebraMap_isUnit t).pow n
  have h9 : algebraMap B Bt e₂ * h = algebraMap B Bt e₁ := by
    apply htBt.mul_right_cancel
    rw [mul_assoc, he', ← map_mul, ← map_mul, hB]
  refine ⟨e₁, e₂, he₁, he₂, ?_⟩
  rw [← hh, smul_smul, h9]

end Branch

section Node

variable {K : Type u} [Field K] [IsAlgClosed K]
  {R : Type u} [CommRing R] [Algebra R K]
  {A : Type u} [CommRing A] [Algebra R A]
  {T : Type u} [CommRing T] [Algebra A T] [Algebra R T] [IsScalarTower R A T]
  {B : Type u} [CommRing B] [IsDomain B] [Algebra A B] [Algebra K B] [Algebra R B]
  [IsScalarTower R A B] [IsScalarTower R K B]

/-- **The base change of a generator of `ω` has a simple pole over a node** (blueprint
`lem:sm-omega-cd-pole-algebra`). Let `R → O` be étale, `A → T` étale and faithfully flat with an
étale `O[u,v]/(uv - c) → T` over `R`, and `A → B` a map to a Noetherian `K`-domain `B`
(`K = K̄`) compatible over `R`. Let `𝔫 ⊆ B` be a maximal ideal such that every prime of `T` over
`𝔫 ∩ A` contains `u` and `v`, with `B_𝔫` a discrete valuation ring with uniformizer `t`. Let
`Ω_{B/K}` be free on `β₀` and spanned by the differentials of the image of `A`. Let
`coef : A → A` and a unit `g ∈ T` satisfy `u · dφ(a) = φ(coef a) g · du` on `D(u)` and
`v · dφ(a) = -φ(coef a) g · dv` on `D(v)`, and let `ζ ∈ Ω_{B_t/K}` satisfy `dν(a) = ν(coef a) ζ`.
Then `e₂ · t ζ = e₁ · β₀` on `D(t)` for some `e₁, e₂ ∉ 𝔫`. -/
theorem exists_mul_eq_of_node
    [Algebra.Etale A T] [Module.FaithfullyFlat A T] [IsNoetherianRing B]
    {O : Type u} [CommRing O] [Algebra R O] [Algebra.Etale R O] (c : O)
    [Algebra (Node O c) T] [IsScalarTower R (Node O c) T] [Algebra.Etale (Node O c) T]
    (𝔫 : Ideal B) [𝔫.IsMaximal] [IsDiscreteValuationRing (Localization.AtPrime 𝔫)]
    {t : B} (ht : Irreducible (algebraMap B (Localization.AtPrime 𝔫) t))
    (hnode : ∀ P : Ideal T, P.IsPrime → P.comap (algebraMap A T) = 𝔫.comap (algebraMap A B) →
      algebraMap (Node O c) T (coordinate c 0) ∈ P ∧
        algebraMap (Node O c) T (coordinate c 1) ∈ P)
    {β₀ : Ω[B⁄K]} (hβ₀ : Function.Bijective fun b : B => b • β₀)
    (hun : Submodule.span B
      (Set.range fun a : A => KaehlerDifferential.D K B (algebraMap A B a)) = ⊤)
    (coef : A → A) {g : T} (hg : IsUnit g)
    (Tu : Type u) [CommRing Tu] [Algebra T Tu]
    [IsLocalization.Away (algebraMap (Node O c) T (coordinate c 0)) Tu] [Algebra R Tu]
    [IsScalarTower R T Tu]
    (hTu : ∀ a, algebraMap T Tu (algebraMap (Node O c) T (coordinate c 0)) •
        KaehlerDifferential.D R Tu (algebraMap T Tu (algebraMap A T a)) =
      algebraMap T Tu (algebraMap A T (coef a) * g) •
        KaehlerDifferential.D R Tu (algebraMap T Tu (algebraMap (Node O c) T (coordinate c 0))))
    (Tv : Type u) [CommRing Tv] [Algebra T Tv]
    [IsLocalization.Away (algebraMap (Node O c) T (coordinate c 1)) Tv] [Algebra R Tv]
    [IsScalarTower R T Tv]
    (hTv : ∀ a, algebraMap T Tv (algebraMap (Node O c) T (coordinate c 1)) •
        KaehlerDifferential.D R Tv (algebraMap T Tv (algebraMap A T a)) =
      algebraMap T Tv (algebraMap A T (coef a) * -g) •
        KaehlerDifferential.D R Tv (algebraMap T Tv (algebraMap (Node O c) T (coordinate c 1))))
    (Bt : Type u) [CommRing Bt] [Algebra B Bt] [IsLocalization.Away t Bt] [Algebra K Bt]
    [IsScalarTower K B Bt] (ζ : Ω[Bt⁄K])
    (hζ : ∀ a, KaehlerDifferential.D K Bt (algebraMap B Bt (algebraMap A B a)) =
      algebraMap B Bt (algebraMap A B (coef a)) • ζ) :
    ∃ e₁ e₂ : B, e₁ ∉ 𝔫 ∧ e₂ ∉ 𝔫 ∧
      algebraMap B Bt e₂ • (algebraMap B Bt t • ζ) =
        algebraMap B Bt e₁ • KaehlerDifferential.map K K B Bt β₀ := by
  classical
  set u := algebraMap (Node O c) T (coordinate c 0) with hudef
  set v := algebraMap (Node O c) T (coordinate c 1) with hvdef
  -- `t` generates `𝔫` locally
  have hBD : Function.Injective (algebraMap B (Localization.AtPrime 𝔫)) :=
    IsLocalization.injective (Localization.AtPrime 𝔫) 𝔫.primeCompl_le_nonZeroDivisors
  have hmD : maximalIdeal (Localization.AtPrime 𝔫) =
      Ideal.span {algebraMap B (Localization.AtPrime 𝔫) t} :=
    (IsDiscreteValuationRing.irreducible_iff_uniformizer _).mp ht
  have ht𝔫 : t ∈ 𝔫 := by
    have h1 : algebraMap B (Localization.AtPrime 𝔫) t ∈ maximalIdeal (Localization.AtPrime 𝔫) :=
      ht.not_isUnit
    have h2 := Localization.AtPrime.under_maximalIdeal (I := 𝔫)
    rw [← h2]
    exact h1
  have htgen : ∀ n ∈ 𝔫, ∃ s ∉ 𝔫, ∃ b, s * n = t * b := by
    intro n hn
    have h1 : algebraMap B (Localization.AtPrime 𝔫) n ∈ maximalIdeal (Localization.AtPrime 𝔫) := by
      rw [← Localization.AtPrime.map_eq_maximalIdeal]
      exact Ideal.mem_map_of_mem _ hn
    rw [hmD, Ideal.mem_span_singleton'] at h1
    obtain ⟨d, hd⟩ := h1
    obtain ⟨⟨b, s⟩, hbs⟩ := IsLocalization.mk'_surjective 𝔫.primeCompl d
    simp only at hbs
    refine ⟨s.1, fun h => s.2 h, b, hBD ?_⟩
    rw [map_mul, map_mul, ← hd, ← hbs,
      ← IsLocalization.mk'_spec (Localization.AtPrime 𝔫) b s]
    ring
  -- the local ring `L` of `B ⊗_A T` over `𝔫`
  obtain ⟨L, _, _, _, _, _, _, φL, hφA, hcomap, hmL⟩ :=
    exists_etale_local_extension (A := A) (T := T) (B := B) 𝔫 t ht𝔫 htgen
  let : Algebra K L := ((algebraMap B L).comp (algebraMap K B)).toAlgebra
  have : IsScalarTower K B L := IsScalarTower.of_algebraMap_eq fun _ => rfl
  let : Algebra R L := ((algebraMap K L).comp (algebraMap R K)).toAlgebra
  have : IsScalarTower R K L := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have hφR : ∀ r, φL (algebraMap R T r) = algebraMap R L r := by
    intro r
    rw [IsScalarTower.algebraMap_apply R A T, hφA, ← IsScalarTower.algebraMap_apply R A B,
      IsScalarTower.algebraMap_apply R K B]
    rfl
  -- `L` is a discrete valuation ring with uniformizer `t`
  have hregB : ∀ b : B, b ≠ 0 → IsSMulRegular L b := fun b hb =>
    Module.Flat.isSMulRegular_of_nonZeroDivisors (mem_nonZeroDivisors_of_ne_zero hb)
  have ht0 : t ≠ 0 := by
    rintro rfl
    exact ht.ne_zero (map_zero _)
  have htreg : IsSMulRegular L (algebraMap B L t) := by
    intro x y hxy
    apply hregB t ht0
    change t • x = t • y
    rw [Algebra.smul_def, Algebra.smul_def]
    exact hxy
  obtain ⟨_, _, htL⟩ := isDiscreteValuationRing_of_maximalIdeal_eq_span htreg hmL
  have hinj : Function.Injective (algebraMap B L) := by
    rw [injective_iff_map_eq_zero]
    intro b hb
    by_contra hb0
    apply one_ne_zero (α := L)
    apply hregB b hb0
    change b • (1 : L) = b • 0
    rw [Algebra.smul_def, hb, zero_mul, smul_zero]
  -- `ū, v̄ ∈ 𝔪_L`
  have hmem : φL u ∈ maximalIdeal L ∧ φL v ∈ maximalIdeal L := by
    have hP : ((maximalIdeal L).comap φL).comap (algebraMap A T) = 𝔫.comap (algebraMap A B) := by
      rw [Ideal.comap_comap, ← hcomap, Ideal.comap_comap]
      congr 1
      ext a
      exact hφA a
    exact hnode _ (Ideal.comap_isPrime _ _) hP
  -- `ū v̄ = 0`: the local rings of `K ⊗_R O` are fields
  have huv : φL u * φL v = 0 := by
    let gO : O →ₐ[R] L :=
      { toRingHom := φL.comp ((algebraMap (Node O c) T).comp (algebraMap O (Node O c)))
        commutes' := fun r => by
          change φL (algebraMap (Node O c) T (algebraMap O (Node O c) (algebraMap R O r))) =
            algebraMap R L r
          rw [← IsScalarTower.algebraMap_apply R O (Node O c),
            ← IsScalarTower.algebraMap_apply R (Node O c) T, hφR] }
    let ρ : K ⊗[R] O →ₐ[R] L :=
      Algebra.TensorProduct.productMap (IsScalarTower.toAlgHom R K L) gO
    have hρc : ρ ((1 : K) ⊗ₜ c) = φL u * φL v := by
      rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, one_mul]
      change φL (algebraMap (Node O c) T (algebraMap O (Node O c) c)) = _
      rw [← DeJongAlterations.Algebra.NodeDomain.nodeCoordinateProduct c, map_mul, map_mul]
      rfl
    let 𝔮 := (maximalIdeal L).comap ρ.toRingHom
    have : 𝔮.IsPrime := Ideal.comap_isPrime _ _
    have h𝔮 : (1 : K) ⊗ₜ[R] c ∈ 𝔮 := by
      change ρ (1 ⊗ₜ c) ∈ maximalIdeal L
      rw [hρc]; exact Ideal.mul_mem_right _ _ hmem.1
    have : Algebra.FormallyUnramified K (Localization.AtPrime 𝔮) :=
      Algebra.FormallyUnramified.comp K (K ⊗[R] O) (Localization.AtPrime 𝔮)
    have : Algebra.EssFiniteType K (Localization.AtPrime 𝔮) :=
      Algebra.EssFiniteType.comp K (K ⊗[R] O) (Localization.AtPrime 𝔮)
    have hfield : IsField (Localization.AtPrime 𝔮) :=
      Algebra.FormallyUnramified.isField_of_isAlgClosed_of_isLocalRing K _
    have hmax := (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime 𝔮) 𝔮
      ((1 : K) ⊗ₜ[R] c)).mpr h𝔮
    rw [IsLocalRing.isField_iff_maximalIdeal_eq.mp hfield, Ideal.mem_bot] at hmax
    obtain ⟨⟨s, hs⟩, hsc⟩ :=
      (IsLocalization.map_eq_zero_iff 𝔮.primeCompl (Localization.AtPrime 𝔮) _).mp hmax
    have hsu : IsUnit (ρ s) := by
      by_contra h
      exact hs ((mem_maximalIdeal _).mpr h)
    rw [← hρc]
    have := congrArg ρ hsc
    rw [map_mul, map_zero] at this
    exact (hsu.mul_right_eq_zero).mp this
  -- `Ω_{L/K}` is free of rank one and spanned by `dū, dv̄`
  have hβL := bijective_smul_map_of_formallyEtale (S' := L) hβ₀
  let eL : L ≃ₗ[L] Ω[L⁄K] := LinearEquiv.ofBijective
    (LinearMap.toSpanSingleton L _ (KaehlerDifferential.map K K B L β₀)) hβL
  have : Module.Finite L Ω[L⁄K] := Module.Finite.equiv eL
  have : Nontrivial Ω[L⁄K] := eL.injective.nontrivial
  let : Algebra T L := φL.toAlgebra
  have : IsScalarTower R T L := IsScalarTower.of_algebraMap_eq fun r => (hφR r).symm
  have hΩ : Submodule.span L {KaehlerDifferential.D K L (φL u),
      KaehlerDifferential.D K L (φL v)} = ⊤ := by
    set N := Submodule.span L {KaehlerDifferential.D K L (φL u),
      KaehlerDifferential.D K L (φL v)}
    have hmapN : ∀ ω ∈ Submodule.span T
        {KaehlerDifferential.D R T u, KaehlerDifferential.D R T v},
        KaehlerDifferential.map R K T L ω ∈ N := by
      intro ω hω
      induction hω using Submodule.span_induction with
      | mem y hy =>
        rcases hy with rfl | rfl
        · rw [KaehlerDifferential.map_D]
          exact Submodule.subset_span (Set.mem_insert _ _)
        · rw [KaehlerDifferential.map_D]
          exact Submodule.subset_span (Set.mem_insert_of_mem _ rfl)
      | zero => rw [map_zero]; exact N.zero_mem
      | add y z _ _ hy hz => rw [map_add]; exact N.add_mem hy hz
      | smul a y _ hy =>
        rw [LinearMap.map_smul, ← algebraMap_smul L a]
        exact N.smul_mem _ hy
    have hT : ∀ τ : T, KaehlerDifferential.D K L (φL τ) ∈ N := by
      intro τ
      have hτ : KaehlerDifferential.D R T τ ∈ Submodule.span T
          {KaehlerDifferential.D R T u, KaehlerDifferential.D R T v} := by
        rw [span_D_coordinates (R := R) c]; trivial
      change KaehlerDifferential.D K L (algebraMap T L τ) ∈ N
      rw [← KaehlerDifferential.map_D R K T L]
      exact hmapN _ hτ
    have hspanL := span_map_eq_top_of_formallyEtale (S' := L) hun
    rw [eq_top_iff, ← hspanL, Submodule.span_le]
    rintro _ ⟨_, ⟨a, rfl⟩, rfl⟩
    change KaehlerDifferential.map K K B L (KaehlerDifferential.D K B (algebraMap A B a)) ∈ N
    rw [KaehlerDifferential.map_D, ← hφA]
    exact hT _
  -- some `coef a₀` is nonzero on `B`
  obtain ⟨a₀, ha₀⟩ : ∃ a₀ : A, algebraMap A B (coef a₀) ≠ 0 := by
    by_contra hall
    push Not at hall
    have : Algebra.FormallyEtale B Bt :=
      Algebra.FormallyEtale.of_isLocalization (Submonoid.powers t)
    have hspan := span_map_eq_top_of_formallyEtale (S' := Bt) hun
    have hzero : ∀ ω ∈ KaehlerDifferential.map K K B Bt ''
        Set.range (fun a : A => KaehlerDifferential.D K B (algebraMap A B a)), ω = 0 := by
      rintro _ ⟨_, ⟨a, rfl⟩, rfl⟩
      rw [KaehlerDifferential.map_D, hζ, hall, map_zero, zero_smul]
    have hbot : (⊤ : Submodule Bt Ω[Bt⁄K]) = ⊥ := by
      rw [← hspan, Submodule.span_eq_bot]
      exact hzero
    have hβBt := bijective_smul_map_of_formallyEtale (S' := Bt) hβ₀
    have hnt : Nontrivial Bt := by
      have hinjBt : Function.Injective (algebraMap B Bt) :=
        IsLocalization.injective Bt (powers_le_nonZeroDivisors_of_noZeroDivisors ht0)
      exact hinjBt.nontrivial
    have h1 : (1 : Bt) • KaehlerDifferential.map K K B Bt β₀ =
        (0 : Bt) • KaehlerDifferential.map K K B Bt β₀ := by
      rw [zero_smul]
      have : KaehlerDifferential.map K K B Bt β₀ ∈ (⊥ : Submodule Bt Ω[Bt⁄K]) := by
        rw [← hbot]; trivial
      rw [Submodule.mem_bot] at this
      rw [this, smul_zero]
    exact one_ne_zero (hβBt.injective h1)
  -- one of `ū, v̄` is a uniformizer of `L` with differential a basis of `Ω_{L/K}`
  rcases RosenlichtComponent.branch_of_node (K := K) hmem.1 hmem.2 huv hΩ with ⟨-, hirr, hspan⟩ | ⟨-, hirr, hspan⟩
  · exact exists_mul_eq_of_branch 𝔫 ht hβ₀ L hinj hcomap htL φL hφA hφR hirr hspan
      (hg.map φL) ha₀ Tu (hTu a₀) Bt ζ (hζ a₀)
  · exact exists_mul_eq_of_branch 𝔫 ht hβ₀ L hinj hcomap htL φL hφA hφR hirr hspan
      (hg.neg.map φL) ha₀ Tv (hTv a₀) Bt ζ (hζ a₀)

end Node

end DeJongAlterations.StableModification.Omega.PoleChart
