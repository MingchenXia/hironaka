import Mathlib.RingTheory.Valuation.LocalSubring
import Mathlib.RingTheory.Spectrum.Prime.Topology
import Mathlib.RingTheory.FiniteType

/-!
# Riemann–Zariski spaces of a field

Let `L` be a field. Its (absolute) *Riemann–Zariski space* is the set of valuation subrings of `L`,
with the Zariski topology generated by the sets `{V | F ⊆ V}` for finite subsets `F ⊆ L`.
For a ring `A` with a ring homomorphism `A → L`, the Riemann–Zariski space `RZ(A)` of `A` with
respect to `L` is the subspace of valuation rings containing the image of `A`. This is the
valuation-theoretic description of the Riemann–Zariski spaces of affine schemes in
Temkin, *Stable modification of relative curves* (J. Algebraic Geom. 19 (2010); arXiv v3
numbering), §3.2, Remark 3.2.8 (i)–(ii); here it is the definition.

## Main definitions

* `RiemannZariskiSpace L`: the valuation subrings of `L`, with the Zariski topology.
* `RiemannZariskiSpace.containing T`: the valuation rings containing a subset `T ⊆ L`.
* `RiemannZariskiSpace.basicOpen F`: the basic open `{V | F ⊆ V}` of a finite set `F`.
* `RiemannZariskiSpace.ofRingHom g`, `RiemannZariskiSpace.ofAlgebra A L`: the Riemann–Zariski space
  of a ring homomorphism `g : A →+* L`, resp. of an `A`-algebra `L`.
* `RiemannZariskiSpace.center`: the center map `RZ(A) → Spec A`, `V ↦ 𝔪_V ∩ A`.
* `RiemannZariskiSpace.patchMap`: the indicator map `V ↦ 1_V : L → Bool`, whose image is closed in
  the compact space `L → Bool`; it defines the patch (constructible) topology.

## Main results

* `RiemannZariskiSpace.isTopologicalBasis_basicOpen`: the basic opens form a basis, closed under
  finite intersections (`basicOpen_union`).
* `RiemannZariskiSpace.specializes_iff`: `V ⤳ W ↔ W ≤ V`; in particular the space is `T0`.
* `RiemannZariskiSpace.isCompact_containing`: every `containing T` is quasi-compact; in particular
  the space, every `RZ(A)` and every basic open are quasi-compact (Zariski's compactness theorem,
  Zariski–Samuel, Vol. II, Ch. VI, §17, Thm. 40).
* `RiemannZariskiSpace.continuous_center`, `RiemannZariskiSpace.center_surjective`: the center map
  is continuous, and surjective when `A → L` is injective.
* `RiemannZariskiSpace.ofAlgebra_adjoin`, `RiemannZariskiSpace.ofAlgebraAdjoinHomeomorph`:
  `RZ(A[F]) = RZ(A) ∩ basicOpen F`, a homeomorphism onto the basic open of `RZ(A)`.
* `RiemannZariskiSpace.exists_finset_ofRingHom_eq`,
  `RiemannZariskiSpace.isOpenEmbedding_inclusion_ofAlgebra`: for `A → B → L` with `B` of finite
  type over `A`, `RZ(B) ⊆ RZ(A)` is an open embedding.

## Implementation notes

Temkin proves quasi-compactness through projective limits of constructible topologies (proof of
Proposition 3.2.1, `quacomprop`). We use instead the direct argument: the patch map embeds the space
as a closed subset of the compact space `L → Bool` (Tychonoff), and every Zariski-open set is open
for the induced (patch) topology.
-/

open Topology TopologicalSpace Set.Notation

universe u

namespace DeJongAlterations.StableModification

/-- The (absolute) Riemann–Zariski space of a field `L`: its points are the valuation subrings of
`L`. It carries the Zariski topology generated by the sets `{V | F ⊆ V}` with `F` finite
(Temkin 2010, Remark 3.2.8 (ii)). -/
@[ext]
structure RiemannZariskiSpace (L : Type u) [Field L] where
  /-- The valuation subring of `L` underlying a point of the Riemann–Zariski space. -/
  valuationSubring : ValuationSubring L

namespace RiemannZariskiSpace

variable {L : Type u} [Field L]

/-- The set of points of the Riemann–Zariski space whose valuation ring contains `T`; it is the
Riemann–Zariski space of the subring generated by `T`. -/
def containing (T : Set L) : Set (RiemannZariskiSpace L) :=
  {V | T ⊆ V.valuationSubring}

@[simp]
lemma mem_containing {T : Set L} {V : RiemannZariskiSpace L} :
    V ∈ containing T ↔ T ⊆ V.valuationSubring :=
  Iff.rfl

lemma containing_antitone {T T' : Set L} (h : T ⊆ T') : containing T' ⊆ containing T :=
  fun _ hV => h.trans hV

lemma containing_union (T T' : Set L) :
    containing (T ∪ T') = containing T ∩ containing T' := by
  ext V
  simp [Set.union_subset_iff]

@[simp]
lemma containing_empty : containing (∅ : Set L) = Set.univ := by
  ext V
  simp

/-- The basic open set `{V | F ⊆ V}` of a finite subset `F ⊆ L`. -/
def basicOpen (F : Finset L) : Set (RiemannZariskiSpace L) :=
  containing (F : Set L)

@[simp]
lemma mem_basicOpen {F : Finset L} {V : RiemannZariskiSpace L} :
    V ∈ basicOpen F ↔ (F : Set L) ⊆ V.valuationSubring :=
  Iff.rfl

lemma basicOpen_union [DecidableEq L] (F G : Finset L) :
    basicOpen (F ∪ G) = basicOpen F ∩ basicOpen G := by
  rw [basicOpen, Finset.coe_union, containing_union]
  rfl

@[simp]
lemma basicOpen_empty : basicOpen (∅ : Finset L) = Set.univ := by
  simp [basicOpen]

/-- The Zariski topology on the Riemann–Zariski space: generated by the basic opens. -/
instance instTopologicalSpace : TopologicalSpace (RiemannZariskiSpace L) :=
  .generateFrom (Set.range basicOpen)

lemma isOpen_basicOpen (F : Finset L) : IsOpen (basicOpen F) :=
  isOpen_generateFrom_of_mem ⟨F, rfl⟩

/-- The basic opens form a basis of the topology of the Riemann–Zariski space. -/
theorem isTopologicalBasis_basicOpen :
    IsTopologicalBasis (Set.range (basicOpen (L := L))) where
  exists_subset_inter := by
    classical
    rintro _ ⟨F, rfl⟩ _ ⟨G, rfl⟩ V hV
    exact ⟨_, ⟨F ∪ G, rfl⟩, by rwa [basicOpen_union], by rw [basicOpen_union]⟩
  sUnion_eq := Set.sUnion_eq_univ_iff.2 fun _ => ⟨_, ⟨∅, rfl⟩, by simp⟩
  eq_generateFrom := rfl

/-- A point specializes to another iff its valuation ring is larger: `V ⤳ W ↔ W ≤ V`. -/
theorem specializes_iff {V W : RiemannZariskiSpace L} :
    V ⤳ W ↔ W.valuationSubring ≤ V.valuationSubring := by
  classical
  rw [specializes_iff_forall_open]
  constructor
  · intro h x hx
    have := h _ (isOpen_basicOpen {x}) (by simpa using hx)
    simpa using this
  · intro h s hs hW
    obtain ⟨_, ⟨F, rfl⟩, hWF, hFs⟩ := isTopologicalBasis_basicOpen.exists_subset_of_mem_open hW hs
    exact hFs (fun x hx => h (hWF hx))

/-- The Riemann–Zariski space is `T0`: the specialization order is the reverse inclusion. -/
instance instT0Space : T0Space (RiemannZariskiSpace L) :=
  ⟨fun _ _ h => RiemannZariskiSpace.ext
    (le_antisymm (specializes_iff.1 h.specializes') (specializes_iff.1 h.specializes))⟩

/-! ### The patch map and quasi-compactness -/

open scoped Classical in
/-- The patch map sends a valuation ring to its indicator function `L → Bool`. -/
noncomputable def patchMap (V : RiemannZariskiSpace L) : L → Bool :=
  fun x => decide (x ∈ V.valuationSubring)

@[simp]
lemma patchMap_eq_true {V : RiemannZariskiSpace L} {x : L} :
    patchMap V x = true ↔ x ∈ V.valuationSubring := by
  simp [patchMap]

@[simp]
lemma patchMap_eq_false {V : RiemannZariskiSpace L} {x : L} :
    patchMap V x = false ↔ x ∉ V.valuationSubring := by
  simp [patchMap]

lemma patchMap_injective : Function.Injective (patchMap (L := L)) := by
  intro V W h
  ext x
  rw [← patchMap_eq_true, ← patchMap_eq_true, h]

omit [Field L] in
private lemma isClosed_setOf_three (x y z : L) (P : Bool → Bool → Bool → Prop) :
    IsClosed {f : L → Bool | P (f x) (f y) (f z)} := by
  have hc : Continuous fun f : L → Bool => (f x, f y, f z) := by fun_prop
  exact (isClosed_discrete {p : Bool × Bool × Bool | P p.1 p.2.1 p.2.2}).preimage hc

omit [Field L] in
private lemma isOpen_setOf_eq (x : L) (b : Bool) : IsOpen {f : L → Bool | f x = b} := by
  have hc : Continuous fun f : L → Bool => f x := by fun_prop
  exact (isOpen_discrete {b}).preimage hc

omit [Field L] in
private lemma isClosed_setOf_eq (x : L) (b : Bool) : IsClosed {f : L → Bool | f x = b} := by
  have hc : Continuous fun f : L → Bool => f x := by fun_prop
  exact (isClosed_discrete {b}).preimage hc

/-- The image of the patch map is closed in `L → Bool`: it is cut out by the conditions defining a
valuation subring, each of which involves finitely many coordinates. -/
theorem isClosed_range_patchMap : IsClosed (Set.range (patchMap (L := L))) := by
  let C : Set (L → Bool) :=
    {f | f 1 = true} ∩
    (⋂ x : L, ⋂ y : L, {f | f x = true → f y = true → f (x + y) = true}) ∩
    (⋂ x : L, ⋂ y : L, {f | f x = true → f y = true → f (x * y) = true}) ∩
    (⋂ x : L, {f | f x = true → f (-x) = true}) ∩
    (⋂ x : L, {f | f x = true ∨ f x⁻¹ = true})
  have hC : IsClosed C := by
    refine (((IsClosed.inter ?_ ?_).inter ?_).inter ?_).inter ?_
    · exact isClosed_setOf_three 1 1 1 fun a _ _ => a = true
    · exact isClosed_iInter fun x => isClosed_iInter fun y =>
        isClosed_setOf_three x y (x + y) fun a b c => a = true → b = true → c = true
    · exact isClosed_iInter fun x => isClosed_iInter fun y =>
        isClosed_setOf_three x y (x * y) fun a b c => a = true → b = true → c = true
    · exact isClosed_iInter fun x =>
        isClosed_setOf_three x (-x) x fun a b _ => a = true → b = true
    · exact isClosed_iInter fun x =>
        isClosed_setOf_three x x⁻¹ x fun a b _ => a = true ∨ b = true
  convert hC using 1
  ext f
  constructor
  · rintro ⟨V, rfl⟩
    simp only [C, Set.mem_inter_iff, Set.mem_ofPred_eq, Set.mem_iInter, patchMap_eq_true]
    exact ⟨⟨⟨⟨V.valuationSubring.one_mem, fun x y => V.valuationSubring.add_mem x y⟩,
      fun x y => V.valuationSubring.mul_mem x y⟩, fun x => V.valuationSubring.neg_mem x⟩,
      fun x => V.valuationSubring.mem_or_inv_mem x⟩
  · intro hf
    simp only [C, Set.mem_inter_iff, Set.mem_ofPred_eq, Set.mem_iInter] at hf
    obtain ⟨⟨⟨⟨h1, hadd⟩, hmul⟩, hneg⟩, hinv⟩ := hf
    have h0 : f 0 = true := by simpa using hinv 0
    let V : ValuationSubring L :=
      { carrier := {x | f x = true}
        mul_mem' := fun {x y} hx hy => hmul x y hx hy
        one_mem' := h1
        add_mem' := fun {x y} hx hy => hadd x y hx hy
        zero_mem' := h0
        neg_mem' := fun {x} hx => hneg x hx
        mem_or_inv_mem' := hinv }
    refine ⟨⟨V⟩, funext fun x => ?_⟩
    cases hfx : f x
    · rw [patchMap_eq_false]
      change ¬ f x = true
      simp [hfx]
    · rw [patchMap_eq_true]
      exact hfx

/-- A set is *patch-closed* if it is the preimage of a closed subset of `L → Bool` under the patch
map, i.e. closed in the patch (constructible) topology. -/
def IsPatchClosed (s : Set (RiemannZariskiSpace L)) : Prop :=
  ∃ C : Set (L → Bool), IsClosed C ∧ patchMap ⁻¹' C = s

/-- A set is *patch-open* if it is the preimage of an open subset of `L → Bool` under the patch
map. -/
def IsPatchOpen (s : Set (RiemannZariskiSpace L)) : Prop :=
  ∃ O : Set (L → Bool), IsOpen O ∧ patchMap ⁻¹' O = s

lemma isPatchClosed_univ : IsPatchClosed (Set.univ : Set (RiemannZariskiSpace L)) :=
  ⟨Set.univ, isClosed_univ, rfl⟩

lemma isPatchClosed_empty : IsPatchClosed (∅ : Set (RiemannZariskiSpace L)) :=
  ⟨∅, isClosed_empty, rfl⟩

lemma IsPatchClosed.inter {s t : Set (RiemannZariskiSpace L)} (hs : IsPatchClosed s)
    (ht : IsPatchClosed t) : IsPatchClosed (s ∩ t) := by
  obtain ⟨C, hC, rfl⟩ := hs
  obtain ⟨D, hD, rfl⟩ := ht
  exact ⟨C ∩ D, hC.inter hD, rfl⟩

lemma IsPatchClosed.union {s t : Set (RiemannZariskiSpace L)} (hs : IsPatchClosed s)
    (ht : IsPatchClosed t) : IsPatchClosed (s ∪ t) := by
  obtain ⟨C, hC, rfl⟩ := hs
  obtain ⟨D, hD, rfl⟩ := ht
  exact ⟨C ∪ D, hC.union hD, rfl⟩

lemma isPatchClosed_iInter {ι : Sort*} {s : ι → Set (RiemannZariskiSpace L)}
    (hs : ∀ i, IsPatchClosed (s i)) : IsPatchClosed (⋂ i, s i) := by
  choose C hC hCs using hs
  exact ⟨⋂ i, C i, isClosed_iInter hC, by simp [Set.preimage_iInter, hCs]⟩

lemma isPatchClosed_biUnion_finset {ι : Type*} (t : Finset ι) {s : ι → Set (RiemannZariskiSpace L)}
    (hs : ∀ i ∈ t, IsPatchClosed (s i)) : IsPatchClosed (⋃ i ∈ t, s i) := by
  classical
  induction t using Finset.induction_on with
  | empty => simpa using isPatchClosed_empty
  | insert i t hi ih =>
    rw [Finset.set_biUnion_insert]
    exact (hs i (Finset.mem_insert_self i t)).union
      (ih fun j hj => hs j (Finset.mem_insert_of_mem hj))

lemma isPatchClosed_iUnion {ι : Type*} [Finite ι] {s : ι → Set (RiemannZariskiSpace L)}
    (hs : ∀ i, IsPatchClosed (s i)) : IsPatchClosed (⋃ i, s i) := by
  cases nonempty_fintype ι
  simpa using isPatchClosed_biUnion_finset Finset.univ fun i _ => hs i

lemma isPatchClosed_mem (x : L) :
    IsPatchClosed {V : RiemannZariskiSpace L | x ∈ V.valuationSubring} :=
  ⟨{f | f x = true}, isClosed_setOf_eq x true, by ext; simp⟩

lemma isPatchClosed_not_mem (x : L) :
    IsPatchClosed {V : RiemannZariskiSpace L | x ∉ V.valuationSubring} :=
  ⟨{f | f x = false}, isClosed_setOf_eq x false, by ext; simp⟩

lemma isPatchOpen_not_mem (x : L) :
    IsPatchOpen {V : RiemannZariskiSpace L | x ∉ V.valuationSubring} :=
  ⟨{f | f x = false}, isOpen_setOf_eq x false, by ext; simp⟩

lemma isPatchClosed_mem_nonunits (x : L) :
    IsPatchClosed {V : RiemannZariskiSpace L | x ∈ V.valuationSubring.nonunits} := by
  by_cases hx : x = 0
  · convert isPatchClosed_univ (L := L)
    ext V
    simp [hx]
  · convert isPatchClosed_not_mem x⁻¹ using 1
    ext V
    rw [Set.mem_ofPred_eq, Set.mem_ofPred_eq, ValuationSubring.mem_nonunits_iff_or]
    simp [hx]

lemma isPatchClosed_containing (T : Set L) : IsPatchClosed (containing T) := by
  have : containing T = ⋂ x : T, {V : RiemannZariskiSpace L | (x : L) ∈ V.valuationSubring} := by
    ext V
    simp [Set.subset_def]
  rw [this]
  exact isPatchClosed_iInter fun x => isPatchClosed_mem x.1

/-- Every Zariski-open set is patch-open. -/
theorem isPatchOpen_of_isOpen {s : Set (RiemannZariskiSpace L)} (hs : IsOpen s) :
    IsPatchOpen s := by
  have hle : TopologicalSpace.induced (patchMap (L := L)) inferInstance ≤
      (inferInstance : TopologicalSpace (RiemannZariskiSpace L)) := by
    refine le_generateFrom ?_
    rintro _ ⟨F, rfl⟩
    rw [isOpen_induced_iff]
    refine ⟨⋂ x ∈ F, {f : L → Bool | f x = true},
      isOpen_biInter_finset fun x _ => isOpen_setOf_eq x true, ?_⟩
    ext V
    simp [Set.subset_def]
  have := TopologicalSpace.le_def.1 hle s hs
  exact isOpen_induced_iff.1 this

/-- Compactness of the patch topology: a patch-closed set covered by patch-open sets is covered by
finitely many of them. -/
theorem IsPatchClosed.elim_finite_subcover {K : Set (RiemannZariskiSpace L)} (hK : IsPatchClosed K)
    {ι : Type*} (U : ι → Set (RiemannZariskiSpace L)) (hU : ∀ i, IsPatchOpen (U i))
    (hcover : K ⊆ ⋃ i, U i) : ∃ t : Finset ι, K ⊆ ⋃ i ∈ t, U i := by
  obtain ⟨C, hC, rfl⟩ := hK
  choose O hO hOU using hU
  have hcomp : IsCompact (C ∩ Set.range (patchMap (L := L))) :=
    (hC.inter isClosed_range_patchMap).isCompact
  obtain ⟨t, ht⟩ := hcomp.elim_finite_subcover O hO (by
    rintro _ ⟨hxC, V, rfl⟩
    obtain ⟨i, hi⟩ := Set.mem_iUnion.1 (hcover hxC)
    rw [← hOU i] at hi
    exact Set.mem_iUnion.2 ⟨i, hi⟩)
  refine ⟨t, fun V hV => ?_⟩
  have := ht ⟨hV, V, rfl⟩
  simp only [Set.mem_iUnion] at this ⊢
  obtain ⟨i, hi, hVi⟩ := this
  exact ⟨i, hi, by rw [← hOU i]; exact hVi⟩

/-- A patch-closed set is quasi-compact for the Zariski topology. -/
theorem IsPatchClosed.isCompact {K : Set (RiemannZariskiSpace L)} (hK : IsPatchClosed K) :
    IsCompact K := by
  rw [isCompact_iff_finite_subcover]
  intro ι U hU hcover
  exact hK.elim_finite_subcover U (fun i => isPatchOpen_of_isOpen (hU i)) hcover

/-- **Zariski's compactness theorem**: the valuation rings containing a given subset form a
quasi-compact subset of the Riemann–Zariski space. -/
theorem isCompact_containing (T : Set L) : IsCompact (containing T) :=
  (isPatchClosed_containing T).isCompact

theorem isCompact_basicOpen (F : Finset L) : IsCompact (basicOpen F) :=
  isCompact_containing _

/-- The Riemann–Zariski space of a field is quasi-compact. -/
instance instCompactSpace : CompactSpace (RiemannZariskiSpace L) :=
  ⟨by simpa using isCompact_containing (∅ : Set L)⟩

/-! ### Riemann–Zariski spaces of rings -/

section Ring

variable {A B : Type*} [CommRing A] [CommRing B]

/-- The Riemann–Zariski space `RZ(A)` of a ring homomorphism `g : A →+* L`: valuation rings of
`L` containing the image of `g`. -/
def ofRingHom (g : A →+* L) : Set (RiemannZariskiSpace L) :=
  containing (Set.range g)

lemma mem_ofRingHom {g : A →+* L} {V : RiemannZariskiSpace L} :
    V ∈ ofRingHom g ↔ ∀ a, g a ∈ V.valuationSubring := by
  simp [ofRingHom, Set.range_subset_iff]

theorem isCompact_ofRingHom (g : A →+* L) : IsCompact (ofRingHom g) :=
  isCompact_containing _

lemma ofRingHom_subset_comp (φ : A →+* B) (g : B →+* L) :
    ofRingHom g ⊆ ofRingHom (g.comp φ) := by
  intro V hV
  rw [mem_ofRingHom] at hV ⊢
  exact fun a => hV (φ a)

/-- If `B` is of finite type over `A`, then `RZ(B) = RZ(A) ∩ basicOpen F` for a finite set `F`
contained in the image of `B` (the images of algebra generators of `B` over `A`). -/
theorem exists_finset_ofRingHom_eq (φ : A →+* B) (hφ : φ.FiniteType) (g : B →+* L) :
    ∃ F : Finset L, (F : Set L) ⊆ Set.range g ∧
      ofRingHom g = ofRingHom (g.comp φ) ∩ basicOpen F := by
  classical
  let := φ.toAlgebra
  obtain ⟨t, ht⟩ := hφ.out
  refine ⟨t.image g, by simp, ?_⟩
  ext V
  simp only [Set.mem_inter_iff, mem_ofRingHom, mem_basicOpen, Finset.coe_image,
    RingHom.comp_apply, Set.image_subset_iff]
  constructor
  · intro hV
    exact ⟨fun a => hV (φ a), fun b _ => hV b⟩
  · rintro ⟨hA, hF⟩ b
    have hb : b ∈ Algebra.adjoin A (t : Set B) := by rw [ht]; trivial
    induction hb using Algebra.adjoin_induction with
    | mem x hx => exact hF hx
    | algebraMap a => exact hA a
    | add x y _ _ hx hy => simpa using V.valuationSubring.add_mem _ _ hx hy
    | mul x y _ _ hx hy => simpa using V.valuationSubring.mul_mem _ _ hx hy

/-- For `B` of finite type over `A`, `RZ(B)` is open in `RZ(A)`. -/
theorem isOpen_ofRingHom_of_finiteType (φ : A →+* B) (hφ : φ.FiniteType) (g : B →+* L) :
    IsOpen ((ofRingHom (g.comp φ)) ↓∩ ofRingHom g) := by
  obtain ⟨F, -, hF⟩ := exists_finset_ofRingHom_eq φ hφ g
  have : (ofRingHom (g.comp φ)) ↓∩ ofRingHom g = (ofRingHom (g.comp φ)) ↓∩ basicOpen F := by
    ext V
    simp [hF]
  rw [this]
  exact (isOpen_basicOpen F).preimage continuous_subtype_val

end Ring

/-- The Riemann–Zariski space `RZ(A)` of an `A`-algebra `L` that is a field: the valuation
subrings of `L` containing the image of `A` (Temkin 2010, Remark 3.2.8 (i)). -/
abbrev ofAlgebra (A : Type*) [CommRing A] (L : Type u) [Field L] [Algebra A L] :
    Set (RiemannZariskiSpace L) :=
  ofRingHom (algebraMap A L)

section Algebra

variable {A : Type*} [CommRing A] [Algebra A L]

lemma mem_ofAlgebra {V : RiemannZariskiSpace L} :
    V ∈ ofAlgebra A L ↔ ∀ a : A, algebraMap A L a ∈ V.valuationSubring :=
  mem_ofRingHom

/-- Every valuation ring contains the image of `ℤ`: `RZ(ℤ)` is the whole Riemann–Zariski space
(Temkin 2010, Remark 3.2.8 (ii)). -/
@[simp]
lemma ofAlgebra_int : ofAlgebra ℤ L = Set.univ := by
  ext V
  simp only [Set.mem_univ, iff_true, mem_ofAlgebra, algebraMap_int_eq, eq_intCast]
  exact fun n => intCast_mem V.valuationSubring n

instance compactSpace_ofAlgebra : CompactSpace (ofAlgebra A L) :=
  isCompact_iff_compactSpace.1 (isCompact_ofRingHom _)

/-- The basic opens of `RZ(A)` are quasi-compact. -/
theorem isCompact_basicOpen_ofAlgebra (F : Finset L) :
    IsCompact ((ofAlgebra A L) ↓∩ basicOpen F) := by
  rw [Topology.IsInducing.subtypeVal.isCompact_iff, Subtype.image_preimage_coe]
  have : ofAlgebra A L ∩ basicOpen F = containing (Set.range (algebraMap A L) ∪ F) := by
    rw [containing_union]
    rfl
  rw [this]
  exact isCompact_containing _

/-- The basic opens of `RZ(A)` form a basis of its topology. -/
theorem isTopologicalBasis_basicOpen_ofAlgebra :
    IsTopologicalBasis (Set.range fun F : Finset L => (ofAlgebra A L) ↓∩ basicOpen F) := by
  have := isTopologicalBasis_basicOpen.isInducing
    (Topology.IsInducing.subtypeVal (t := ofAlgebra A L))
  convert this using 1
  ext s
  simp

/-- For `V ∈ RZ(A)`, the ring homomorphism `A → V`. -/
noncomputable def toValuationSubring (V : ofAlgebra A L) : A →+* V.1.valuationSubring :=
  (algebraMap A L).codRestrict V.1.valuationSubring fun a => mem_ofAlgebra.1 V.2 a

@[simp]
lemma coe_toValuationSubring (V : ofAlgebra A L) (a : A) :
    (toValuationSubring V a : L) = algebraMap A L a :=
  rfl

/-- The center map `RZ(A) → Spec A`: a valuation ring `V ⊇ A` is sent to the prime `𝔪_V ∩ A`. -/
noncomputable def center (V : ofAlgebra A L) : PrimeSpectrum A :=
  ⟨(IsLocalRing.maximalIdeal V.1.valuationSubring).comap (toValuationSubring V), inferInstance⟩

lemma mem_center {V : ofAlgebra A L} {a : A} :
    a ∈ (center V).asIdeal ↔ algebraMap A L a ∈ V.1.valuationSubring.nonunits := by
  change toValuationSubring V a ∈ IsLocalRing.maximalIdeal _ ↔ _
  rw [← ValuationSubring.coe_mem_nonunits_iff, coe_toValuationSubring]

/-- The center map `RZ(A) → Spec A` is continuous. -/
theorem continuous_center : Continuous (center (A := A) (L := L)) := by
  rw [PrimeSpectrum.isTopologicalBasis_basic_opens.continuous_iff]
  rintro _ ⟨a, rfl⟩
  by_cases ha : algebraMap A L a = 0
  · convert isOpen_empty
    ext V
    simp [mem_center, ha]
  · convert (isOpen_basicOpen {(algebraMap A L a)⁻¹}).preimage continuous_subtype_val
    ext V
    simp [mem_center, ha, ValuationSubring.mem_nonunits_iff_or]

/-- If `A → L` is injective, the center map `RZ(A) → Spec A` is surjective: every prime of `A` is
the center of a valuation ring of `L` dominating `A_𝔭`. -/
theorem center_surjective (h : Function.Injective (algebraMap A L)) :
    Function.Surjective (center (A := A) (L := L)) := by
  intro p
  let R := Localization.AtPrime p.asIdeal
  have hu : ∀ y : p.asIdeal.primeCompl, IsUnit (algebraMap A L y) := by
    intro ⟨y, hy⟩
    refine IsUnit.mk0 _ fun h0 => hy ?_
    have hy0 : y = 0 := (map_eq_zero_iff _ h).1 h0
    rw [hy0]
    exact p.asIdeal.zero_mem
  let g : R →+* L := IsLocalization.lift (M := p.asIdeal.primeCompl) hu
  have hg : ∀ a : A, g (algebraMap A R a) = algebraMap A L a := IsLocalization.lift_eq hu
  obtain ⟨B, hB, hloc⟩ := IsLocalRing.exists_factor_valuationRing g
  have hV : (⟨B⟩ : RiemannZariskiSpace L) ∈ ofAlgebra A L := by
    rw [mem_ofAlgebra]
    intro a
    rw [← hg]
    exact hB _
  refine ⟨⟨_, hV⟩, PrimeSpectrum.ext ?_⟩
  ext a
  rw [mem_center, ← IsLocalization.AtPrime.to_map_mem_maximal_iff R p.asIdeal a,
    IsLocalRing.mem_maximalIdeal, ← map_mem_nonunits_iff (g.codRestrict B.toSubring hB)]
  rw [← hg]
  exact (ValuationSubring.coe_mem_nonunits_iff (A := B) (a := ⟨_, hB _⟩)).trans Iff.rfl

/-- `RZ(A[F]) = RZ(A) ∩ basicOpen F`, where `A[F]` is the `A`-subalgebra of `L` generated by `F`. -/
theorem ofAlgebra_adjoin (F : Finset L) :
    ofAlgebra (Algebra.adjoin A (F : Set L)) L = ofAlgebra A L ∩ basicOpen F := by
  ext V
  simp only [Set.mem_inter_iff, mem_ofAlgebra, mem_basicOpen]
  constructor
  · intro hV
    refine ⟨fun a => hV (algebraMap A _ a), fun x hx => hV ⟨x, Algebra.subset_adjoin hx⟩⟩
  · rintro ⟨hA, hF⟩ ⟨x, hx⟩
    change x ∈ V.valuationSubring
    induction hx using Algebra.adjoin_induction with
    | mem x hx => exact hF hx
    | algebraMap a => exact hA a
    | add x y _ _ hx hy => exact V.valuationSubring.add_mem _ _ hx hy
    | mul x y _ _ hx hy => exact V.valuationSubring.mul_mem _ _ hx hy

lemma ofAlgebra_adjoin_subset (F : Finset L) :
    ofAlgebra (Algebra.adjoin A (F : Set L)) L ⊆ ofAlgebra A L := by
  rw [ofAlgebra_adjoin]
  exact Set.inter_subset_left

/-- `RZ(A[F])` is homeomorphic to the basic open `{V ∈ RZ(A) | F ⊆ V}` of `RZ(A)`. -/
noncomputable def ofAlgebraAdjoinHomeomorph (F : Finset L) :
    ofAlgebra (Algebra.adjoin A (F : Set L)) L ≃ₜ ((ofAlgebra A L) ↓∩ basicOpen F) :=
  (Topology.IsEmbedding.inclusion (ofAlgebra_adjoin_subset F)).toHomeomorph.trans
    (Homeomorph.setCongr (by
      ext V
      simp [Set.range_inclusion, ofAlgebra_adjoin]))

@[simp]
lemma coe_ofAlgebraAdjoinHomeomorph (F : Finset L)
    (V : ofAlgebra (Algebra.adjoin A (F : Set L)) L) :
    ((ofAlgebraAdjoinHomeomorph F V : ofAlgebra A L) : RiemannZariskiSpace L) = V :=
  rfl

/-- Functoriality: for `A → B → L`, every valuation ring containing `B` contains `A`. -/
lemma ofAlgebra_subset_of_isScalarTower (B : Type*) [CommRing B] [Algebra A B] [Algebra B L]
    [IsScalarTower A B L] : ofAlgebra B L ⊆ ofAlgebra A L := by
  have := ofRingHom_subset_comp (algebraMap A B) (algebraMap B L)
  rwa [← IsScalarTower.algebraMap_eq] at this

/-- For `A → B → L` with `B` of finite type over `A`, the inclusion `RZ(B) ⊆ RZ(A)` is an open
embedding. -/
theorem isOpenEmbedding_inclusion_ofAlgebra (B : Type*) [CommRing B] [Algebra A B] [Algebra B L]
    [IsScalarTower A B L] [Algebra.FiniteType A B] :
    IsOpenEmbedding (Set.inclusion (ofAlgebra_subset_of_isScalarTower (A := A) (L := L) B)) := by
  refine Topology.IsOpenEmbedding.inclusion _ ?_
  have := isOpen_ofRingHom_of_finiteType (algebraMap A B)
    (RingHom.finiteType_algebraMap.2 inferInstance) (algebraMap B L)
  rwa [← IsScalarTower.algebraMap_eq] at this

end Algebra

