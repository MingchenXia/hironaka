import Mathlib.FieldTheory.IsAlgClosed.AlgebraicClosure
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.RingTheory.MvPolynomial.Expand
import Mathlib.RingTheory.Polynomial.UniqueFactorization
import Mathlib.RingTheory.FiniteType
import Mathlib.RingTheory.IntegralClosure.IntegrallyClosed
import Mathlib.RingTheory.Polynomial.RationalRoot
import Mathlib.RingTheory.Algebraic.Integral

/-!
# Finite coefficient-root covers for arbitrary ground fields

This constructs a finite field of prescribed coefficient roots and the genuine
finite polynomial map obtained by replacing each variable by a positive power.
These are ingredients for arbitrary-field normalization finiteness. The final
normalization-finiteness theorem is not asserted in this module.
-/

noncomputable section

namespace DeJongAlterations.Algebra.IntegralClosureFiniteTypeRoots

universe u v

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

variable {k : Type u} [Field k]

/-- A root is chosen in the actual algebraic closure, for every positive exponent. -/
def chosenRoot (q : ℕ) (hq : 0 < q) (a : k) : AlgebraicClosure k :=
  Classical.choose (IsAlgClosed.exists_pow_nat_eq (algebraMap k (AlgebraicClosure k) a) hq)

theorem chosenRoot_pow (q : ℕ) (hq : 0 < q) (a : k) :
    chosenRoot q hq a ^ q = algebraMap k (AlgebraicClosure k) a :=
  Classical.choose_spec (IsAlgClosed.exists_pow_nat_eq
    (algebraMap k (AlgebraicClosure k) a) hq)

/-- The actual intermediate field generated by roots of the specified finite coefficients. -/
def coefficientRootField (s : Finset k) (q : ℕ) (hq : 0 < q) :
    IntermediateField k (AlgebraicClosure k) :=
  IntermediateField.adjoin k ((s : Set k).image (chosenRoot q hq))

/-- Finiteness is derived from the actual finite set of algebraic generators. -/
instance coefficientRootField_finiteDimensional (s : Finset k) (q : ℕ) (hq : 0 < q) :
    FiniteDimensional k (coefficientRootField s q hq) := by
  let := ((s.finite_toSet).image (chosenRoot q hq)).fintype
  exact IntermediateField.finiteDimensional_adjoin fun x _ =>
    Algebra.IsIntegral.isIntegral x

/-- The chosen coefficient root as an element of the actual finite intermediate field. -/
def coefficientRoot (s : Finset k) (q : ℕ) (hq : 0 < q) (a : k) (ha : a ∈ s) :
    coefficientRootField s q hq :=
  ⟨chosenRoot q hq a, IntermediateField.subset_adjoin k _ ⟨a, ha, rfl⟩⟩

/-- The coefficient power identity is the exact identity in the finite root field. -/
theorem coefficientRoot_pow (s : Finset k) (q : ℕ) (hq : 0 < q) (a : k) (ha : a ∈ s) :
    coefficientRoot s q hq a ha ^ q = algebraMap k (coefficientRootField s q hq) a := by
  apply Subtype.ext
  exact chosenRoot_pow q hq a

section PolynomialCover

variable (k) (E : Type u) [Field E] [Algebra k E] {ι : Type v}

/-- The literal map of polynomial rings: coefficients extend and variables become powers. -/
def polynomialRootMap (q : ℕ) : MvPolynomial ι k →+* MvPolynomial ι E :=
  (MvPolynomial.expand q).toRingHom.comp (MvPolynomial.map (algebraMap k E))

@[simp]
theorem polynomialRootMap_C (q : ℕ) (a : k) :
    polynomialRootMap k E q (MvPolynomial.C a : MvPolynomial ι k) =
      MvPolynomial.C (algebraMap k E a) := by
  simp only [polynomialRootMap, RingHom.comp_apply, MvPolynomial.map_C,
    AlgHom.toRingHom_eq_coe, RingHom.coe_coe, MvPolynomial.expand_C]

@[simp]
theorem polynomialRootMap_X (q : ℕ) (i : ι) :
    polynomialRootMap k E q (MvPolynomial.X i) = (MvPolynomial.X i) ^ q := by
  simp only [polynomialRootMap, RingHom.comp_apply, MvPolynomial.map_X,
    AlgHom.toRingHom_eq_coe, RingHom.coe_coe, MvPolynomial.expand_X]

/-- The genuine root-cover map is injective, over an arbitrary ground field. -/
theorem polynomialRootMap_injective (q : ℕ) (hq : 0 < q) :
    Function.Injective (polynomialRootMap (ι := ι) k E q) :=
  (MvPolynomial.expand_injective hq).comp
    (MvPolynomial.map_injective _ (algebraMap k E).injective)

/-- Positive variable powers and an actual finite coefficient extension give a finite map. -/
theorem polynomialRootMap_finite [Finite ι] [FiniteDimensional k E] (q : ℕ) (hq : 0 < q) :
    (polynomialRootMap (ι := ι) k E q).Finite := by
  let : Algebra (MvPolynomial ι k) (MvPolynomial ι E) := (polynomialRootMap k E q).toAlgebra
  let : IsScalarTower k (MvPolynomial ι k) (MvPolynomial ι E) :=
    IsScalarTower.of_algebraMap_eq fun a => (polynomialRootMap_C k E q a).symm
  have hconst (a : E) : IsIntegral (MvPolynomial ι k) (MvPolynomial.C a : MvPolynomial ι E) := by
    have ha : IsIntegral k (MvPolynomial.C a : MvPolynomial ι E) :=
      (Algebra.IsIntegral.isIntegral (R := k) a).algebraMap
    exact ha.tower_top
  have hvar (i : ι) : IsIntegral (MvPolynomial ι k) (MvPolynomial.X i : MvPolynomial ι E) := by
    apply IsIntegral.of_pow hq
    rw [← polynomialRootMap_X k E q i]
    exact isIntegral_algebraMap
  have hint : (polynomialRootMap (ι := ι) k E q).IsIntegral := by
    intro P
    change IsIntegral (MvPolynomial ι k) P
    induction P using MvPolynomial.induction_on with
    | C a => exact hconst a
    | add P Q hP hQ => exact hP.add hQ
    | mul_X P i hP => exact hP.mul (hvar i)
  apply hint.to_finite
  apply RingHom.FiniteType.of_comp_finiteType (f := MvPolynomial.C)
  have hcomp : (polynomialRootMap (ι := ι) k E q).comp MvPolynomial.C =
      algebraMap k (MvPolynomial ι E) := by
    apply RingHom.ext
    intro a
    exact polynomialRootMap_C k E q a
  rw [hcomp]
  let : Algebra.FiniteType k E := inferInstance
  let : Algebra.FiniteType k (MvPolynomial ι E) :=
    Algebra.FiniteType.trans (S := E) inferInstance inferInstance
  exact RingHom.finiteType_algebraMap.mpr inferInstance

/-- The actual target ring of the root cover is a normal domain. -/
theorem polynomialRootCover_isIntegrallyClosed : IsIntegrallyClosed (MvPolynomial ι E) := by
  exact UniqueFactorizationMonoid.instIsIntegrallyClosed

/-- The actual fraction-field extension of the literal polynomial root-cover map. -/
def fractionRootMap (q : ℕ) (hq : 0 < q) :
    FractionRing (MvPolynomial ι k) →+* FractionRing (MvPolynomial ι E) :=
  IsFractionRing.lift (g :=
      (algebraMap (MvPolynomial ι E) (FractionRing (MvPolynomial ι E))).comp
        (polynomialRootMap k E q))
    ((IsFractionRing.injective _ _).comp (polynomialRootMap_injective k E q hq))

@[simp]
theorem fractionRootMap_algebraMap (q : ℕ) (hq : 0 < q) (P : MvPolynomial ι k) :
    fractionRootMap k E q hq (algebraMap _ (FractionRing (MvPolynomial ι k)) P) =
      algebraMap _ (FractionRing (MvPolynomial ι E)) (polynomialRootMap k E q P) :=
  IsFractionRing.lift_algebraMap _ _

/-- Localization of the actual finite polynomial module gives the actual finite field map. -/
theorem fractionRootMap_finite [Finite ι] [FiniteDimensional k E] (q : ℕ) (hq : 0 < q) :
    (fractionRootMap (ι := ι) k E q hq).Finite := by
  let : Algebra (MvPolynomial ι k) (MvPolynomial ι E) := (polynomialRootMap k E q).toAlgebra
  let : FaithfulSMul (MvPolynomial ι k) (MvPolynomial ι E) :=
    (faithfulSMul_iff_algebraMap_injective _ _).mpr (polynomialRootMap_injective k E q hq)
  let : Module.Finite (MvPolynomial ι k) (MvPolynomial ι E) := polynomialRootMap_finite k E q hq
  let : Algebra (MvPolynomial ι k) (FractionRing (MvPolynomial ι E)) := inferInstance
  let : FaithfulSMul (MvPolynomial ι k) (FractionRing (MvPolynomial ι E)) := inferInstance
  let : Algebra (FractionRing (MvPolynomial ι k)) (FractionRing (MvPolynomial ι E)) :=
    FractionRing.liftAlgebra _ _
  change Module.Finite (FractionRing (MvPolynomial ι k)) (FractionRing (MvPolynomial ι E))
  infer_instance

end PolynomialCover

section FiniteFamily

variable {ι : Type v}

/-- Only the actual finite supports of the specified polynomials contribute coefficients. -/
def familyCoefficients (S : Finset (MvPolynomial ι k)) : Finset k := by
  classical
  exact S.biUnion fun P => P.support.image P.coeff

theorem coeff_mem_familyCoefficients (S : Finset (MvPolynomial ι k))
    (P : MvPolynomial ι k) (hP : P ∈ S) (d : ι →₀ ℕ) (hd : d ∈ P.support) :
    P.coeff d ∈ familyCoefficients S := by
  classical
  exact Finset.mem_biUnion.mpr ⟨P, hP, Finset.mem_image.mpr ⟨d, hd, rfl⟩⟩

/-- The finite coefficient-root field of the entire prescribed family. -/
abbrev familyRootField (S : Finset (MvPolynomial ι k)) (p n : ℕ) [ExpChar k p] :
    IntermediateField k (AlgebraicClosure k) :=
  coefficientRootField (familyCoefficients S) (p ^ n) (expChar_pow_pos k p n)

instance familyRootField_finiteDimensional (S : Finset (MvPolynomial ι k)) (p n : ℕ)
    [ExpChar k p] : FiniteDimensional k (familyRootField S p n) :=
  coefficientRootField_finiteDimensional _ _ _

instance familyRootField_expChar (S : Finset (MvPolynomial ι k)) (p n : ℕ) [ExpChar k p] :
    ExpChar (familyRootField S p n) p :=
  expChar_of_injective_algebraMap (algebraMap k (familyRootField S p n)).injective p

/-- The actual finite polynomial obtained by taking the chosen roots coefficient by coefficient. -/
def familyPolynomialRoot (S : Finset (MvPolynomial ι k)) (p n : ℕ) [ExpChar k p]
    (P : MvPolynomial ι k) (hP : P ∈ S) : MvPolynomial ι (familyRootField S p n) := by
  classical
  exact ∑ d ∈ P.support.attach, MvPolynomial.monomial d.val
    (coefficientRoot (familyCoefficients S) (p ^ n) (expChar_pow_pos k p n) (P.coeff d.val)
      (coeff_mem_familyCoefficients S P hP d.val d.property))

/-- The coefficient Frobenius of the chosen root polynomial is exactly coefficient extension. -/
theorem familyPolynomialRoot_frobenius (S : Finset (MvPolynomial ι k)) (p n : ℕ)
    [ExpChar k p] (P : MvPolynomial ι k) (hP : P ∈ S) :
    MvPolynomial.map (iterateFrobenius (familyRootField S p n) p n)
        (familyPolynomialRoot S p n P hP) =
      MvPolynomial.map (algebraMap k (familyRootField S p n)) P := by
  classical
  unfold familyPolynomialRoot
  rw [map_sum]
  simp only [MvPolynomial.map_monomial, iterateFrobenius_def, coefficientRoot_pow]
  calc
    _ = ∑ d ∈ P.support, MvPolynomial.monomial d
        (algebraMap k (familyRootField S p n) (P.coeff d)) := Finset.sum_attach _ _
    _ = _ := by
      conv_rhs => rw [P.as_sum]
      rw [map_sum]
      simp only [MvPolynomial.map_monomial]

/-- The root-cover map sends each prescribed polynomial to an actual `p ^ n`-th power. -/
theorem familyPolynomialRoot_pow (S : Finset (MvPolynomial ι k)) (p n : ℕ) [ExpChar k p]
    (P : MvPolynomial ι k) (hP : P ∈ S) :
    familyPolynomialRoot S p n P hP ^ p ^ n =
      polynomialRootMap k (familyRootField S p n) (p ^ n) P := by
  change _ = MvPolynomial.expand (p ^ n)
    (MvPolynomial.map (algebraMap k (familyRootField S p n)) P)
  rw [← familyPolynomialRoot_frobenius S p n P hP, ← MvPolynomial.map_expand]
  exact (MvPolynomial.map_iterateFrobenius_expand p _ n).symm

/-- An actual finite normal polynomial cover with roots for the whole finite family.
The ground field is arbitrary; finiteness of its Frobenius is not assumed. -/
theorem exists_finite_polynomial_root_cover [Finite ι]
    (S : Finset (MvPolynomial ι k)) (p n : ℕ) [ExpChar k p] :
    ∃ E : IntermediateField k (AlgebraicClosure k),
      Module.Finite k E ∧
      Function.Injective (polynomialRootMap (ι := ι) k E (p ^ n)) ∧
      (polynomialRootMap (ι := ι) k E (p ^ n)).Finite ∧
      IsIntegrallyClosed (MvPolynomial ι E) ∧
      ∀ P ∈ S, ∃ Q : MvPolynomial ι E, Q ^ p ^ n = polynomialRootMap k E (p ^ n) P := by
  refine ⟨familyRootField S p n, inferInstance, ?_, ?_, ?_, ?_⟩
  · exact polynomialRootMap_injective k _ _ (expChar_pow_pos k p n)
  · exact polynomialRootMap_finite k _ _ (expChar_pow_pos k p n)
  · exact polynomialRootCover_isIntegrallyClosed _
  · intro P hP
    exact ⟨familyPolynomialRoot S p n P hP, familyPolynomialRoot_pow S p n P hP⟩

/-- A chosen actual fraction presentation, with a denominator in the non-zero-divisor monoid. -/
def fractionPresentation (x : FractionRing (MvPolynomial ι k)) :
    MvPolynomial ι k × MvPolynomial ι k := by
  classical
  exact Classical.choose (show ∃ ab : MvPolynomial ι k × MvPolynomial ι k,
    ab.2 ∈ nonZeroDivisors (MvPolynomial ι k) ∧
      algebraMap _ (FractionRing (MvPolynomial ι k)) ab.1 /
        algebraMap _ (FractionRing (MvPolynomial ι k)) ab.2 = x by
    obtain ⟨a, b, hb, hab⟩ := IsFractionRing.div_surjective (MvPolynomial ι k) x
    exact ⟨(a, b), hb, hab⟩)

theorem fractionPresentation_spec (x : FractionRing (MvPolynomial ι k)) :
    (fractionPresentation x).2 ∈ nonZeroDivisors (MvPolynomial ι k) ∧
      algebraMap _ (FractionRing (MvPolynomial ι k)) (fractionPresentation x).1 /
        algebraMap _ (FractionRing (MvPolynomial ι k)) (fractionPresentation x).2 = x := by
  unfold fractionPresentation
  exact Classical.choose_spec (show ∃ ab : MvPolynomial ι k × MvPolynomial ι k,
    ab.2 ∈ nonZeroDivisors (MvPolynomial ι k) ∧
      algebraMap _ (FractionRing (MvPolynomial ι k)) ab.1 /
        algebraMap _ (FractionRing (MvPolynomial ι k)) ab.2 = x by
    obtain ⟨a, b, hb, hab⟩ := IsFractionRing.div_surjective (MvPolynomial ι k) x
    exact ⟨(a, b), hb, hab⟩)

/-- The actual finite set of all selected numerators and denominators. -/
def fractionPolynomialFamily (T : Finset (FractionRing (MvPolynomial ι k))) :
    Finset (MvPolynomial ι k) := by
  classical
  exact T.biUnion fun x => {(fractionPresentation x).1, (fractionPresentation x).2}

/-- One finite normal cover produces actual roots of all the selected rational functions. -/
theorem exists_finite_rational_root_cover [Finite ι]
    (T : Finset (FractionRing (MvPolynomial ι k))) (p n : ℕ) [ExpChar k p] :
    ∃ E : IntermediateField k (AlgebraicClosure k),
      Module.Finite k E ∧
      (polynomialRootMap (ι := ι) k E (p ^ n)).Finite ∧
      IsIntegrallyClosed (MvPolynomial ι E) ∧
      (fractionRootMap (ι := ι) k E (p ^ n) (expChar_pow_pos k p n)).Finite ∧
      ∀ x ∈ T, ∃ y : FractionRing (MvPolynomial ι E),
        y ^ p ^ n = fractionRootMap k E (p ^ n) (expChar_pow_pos k p n) x := by
  classical
  let S := fractionPolynomialFamily T
  let E := familyRootField S p n
  refine ⟨E, inferInstance, polynomialRootMap_finite k E _ (expChar_pow_pos k p n),
    polynomialRootCover_isIntegrallyClosed E,
    fractionRootMap_finite k E _ (expChar_pow_pos k p n), ?_⟩
  intro x hx
  have ha : (fractionPresentation x).1 ∈ S :=
    Finset.mem_biUnion.mpr ⟨x, hx, by simp⟩
  have hb : (fractionPresentation x).2 ∈ S :=
    Finset.mem_biUnion.mpr ⟨x, hx, by simp⟩
  let Q₁ := familyPolynomialRoot S p n (fractionPresentation x).1 ha
  let Q₂ := familyPolynomialRoot S p n (fractionPresentation x).2 hb
  refine ⟨algebraMap _ (FractionRing (MvPolynomial ι E)) Q₁ /
    algebraMap _ (FractionRing (MvPolynomial ι E)) Q₂, ?_⟩
  rw [div_pow, ← map_pow, ← map_pow, familyPolynomialRoot_pow, familyPolynomialRoot_pow]
  symm
  calc
    _ = fractionRootMap k E (p ^ n) (expChar_pow_pos k p n)
        (algebraMap _ (FractionRing (MvPolynomial ι k)) (fractionPresentation x).1 /
          algebraMap _ (FractionRing (MvPolynomial ι k)) (fractionPresentation x).2) :=
      congrArg _ (fractionPresentation_spec x).2.symm
    _ = _ := by rw [map_div₀, fractionRootMap_algebraMap, fractionRootMap_algebraMap]

end FiniteFamily

end DeJongAlterations.Algebra.IntegralClosureFiniteTypeRoots
