import DeJongAlterations.Algebra.NodeFittingMatrixProduct
import Mathlib.LinearAlgebra.Finsupp.LinearCombination

/-!
# Full minors depend only on the actual finite relation image

This proves independence of finite relations for the same original free
generating module. Independence of the generating surjection still needs
identity-block stabilization and actual comparison of presentations.
-/

noncomputable section

namespace DeJongAlterations.Algebra.NodeFittingMatrix

open scoped BigOperators

universe u v w z
variable {R : Type u} [CommRing R] {m : Type v} {n : Type w} {p : Type z}

/-- The actual original submodule generated by all original relation columns. -/
def columnSpan (A : Matrix m n R) : Submodule R (m → R) :=
  Submodule.span R (Set.range (fun j i => A i j))

/-- The actual original finite free relation map. -/
def relationMap [Fintype n] (A : Matrix m n R) : (n → R) →ₗ[R] (m → R) :=
  Fintype.linearCombination R (fun j i => A i j)

/-- Its full actual image is precisely the original relation column span. -/
theorem relationMap_range [Fintype n] (A : Matrix m n R) :
    LinearMap.range (relationMap A) = columnSpan A :=
  Fintype.range_linearCombination R _

/-- Actual relation-image containment internally supplies the whole original rectangular factorization. -/
theorem exists_matrix_of_columnSpan_le [Fintype n] (A : Matrix m p R) (B : Matrix m n R)
    (h : columnSpan A ≤ columnSpan B) : ∃ C : Matrix n p R, A = B * C := by
  classical
  have he : ∀ j, ∃ c : n → R, ∑ l, c l • (fun i => B i l) = (fun i => A i j) := by
    intro j
    apply (Submodule.mem_span_range_iff_exists_fun R).mp
    exact h (Submodule.subset_span ⟨j, rfl⟩)
  choose C hC using he
  refine ⟨fun i j => C j i, ?_⟩
  ext i j
  change A i j = ∑ l, B i l * C j l
  have hh := congrFun (hC j) i
  simpa only [ Finset.sum_apply, Pi.smul_apply, smul_eq_mul, mul_comm] using hh.symm

/-- Full actual minor ideals respect containment of the actual original finite relation images. -/
theorem determinantalIdeal_le_of_columnSpan_le [Fintype n] (k : ℕ)
    (A : Matrix m p R) (B : Matrix m n R) (h : columnSpan A ≤ columnSpan B) :
    determinantalIdeal k A ≤ determinantalIdeal k B := by
  obtain ⟨C, hC⟩ := exists_matrix_of_columnSpan_le A B h
  rw [hC]
  exact determinantalIdeal_mul_le_left k B C

/-- The whole actual minors ideal is independent of original finite relations with fixed generators. -/
theorem determinantalIdeal_eq_of_columnSpan_eq [Fintype n] [Fintype p] (k : ℕ)
    (A : Matrix m n R) (B : Matrix m p R) (h : columnSpan A = columnSpan B) :
    determinantalIdeal k A = determinantalIdeal k B := by
  apply le_antisymm
  · exact determinantalIdeal_le_of_columnSpan_le k A B h.le
  · exact determinantalIdeal_le_of_columnSpan_le k B A h.ge

/-- This independence uses the actual native relation maps' images. -/
theorem determinantalIdeal_eq_of_relationMap_range_eq [Fintype n] [Fintype p] (k : ℕ)
    (A : Matrix m n R) (B : Matrix m p R)
    (h : LinearMap.range (relationMap A) = LinearMap.range (relationMap B)) :
    determinantalIdeal k A = determinantalIdeal k B := by
  apply determinantalIdeal_eq_of_columnSpan_eq k A B
  simpa only [relationMap_range] using h

end DeJongAlterations.Algebra.NodeFittingMatrix
