import DeJongAlterations.Algebra.NodeFormalMorseCoefficientLimit
import Mathlib.RingTheory.AdicCompletion.Completeness

/-! # Uniqueness of actual formal evaluation into an adically separated target -/

noncomputable section

namespace DeJongAlterations.Algebra.NodeFlatPresentation

open MvPowerSeries

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

universe u v w
variable {A : Type u} [CommRing A] {σ : Type v} [Finite σ]

/-- The actual ideal generated by the original formal variables. -/
def variableIdeal : Ideal (MvPowerSeries σ A) := Ideal.span (Set.range X)

theorem variableIdeal_completion_image :
    (variableIdeal (σ := σ) (A := A)).map (toAdicCompletionAlgEquiv σ A).toRingEquiv =
      (MvPolynomial.idealOfVars σ A).map
        (algebraMap (MvPolynomial σ A) (AdicCompletion (MvPolynomial.idealOfVars σ A) (MvPolynomial σ A))) := by
  simp_rw [variableIdeal, MvPolynomial.idealOfVars, Ideal.map_span, ← Set.range_comp]
  congr 2
  ext i
  simp [AdicCompletion.algebraMap_apply, ← MvPolynomial.coe_X, toAdicCompletion_coe]

/-- The original total-degree truncation approximates a series in the actual variable ideal powers. -/
theorem sub_truncTotal_mem (f : MvPowerSeries σ A) (n : ℕ) :
    f - (f.truncTotal n : MvPolynomial σ A) ∈ (variableIdeal (σ := σ) (A := A)) ^ n := by
  let P := MvPolynomial σ A
  let V : Ideal P := MvPolynomial.idealOfVars σ A
  let e := toAdicCompletionAlgEquiv σ A
  have ht : e (f - (f.truncTotal n : MvPolynomial σ A)) ∈
      (V ^ n).map (algebraMap P (AdicCompletion V P)) := by
    change e (f - (f.truncTotal n : MvPolynomial σ A)) ∈
      ((V ^ n).map (algebraMap P (AdicCompletion V P))).restrictScalars P
    rw [← Ideal.smul_top_eq_map, AdicCompletion.pow_smul_top_eq_ker_eval (M := P) (MvPolynomial.idealOfVars_fg σ A)]
    change (toAdicCompletion σ A (f - (f.truncTotal n : MvPolynomial σ A))).val n = 0
    rw [map_sub, toAdicCompletion_coe, AdicCompletion.val_sub_apply,
      toAdicCompletion_apply_eq_mk_truncTotal]
    simp
  have hm : e (f - (f.truncTotal n : MvPolynomial σ A)) ∈
      ((variableIdeal (σ := σ) (A := A)) ^ n).map e.toRingEquiv := by
    rw [Ideal.map_pow, variableIdeal_completion_image]
    simpa only [Ideal.map_pow] using ht
  obtain ⟨g, hg, he⟩ := Ideal.mem_image_of_mem_map_of_surjective e.toRingEquiv e.surjective hm
  exact e.injective he ▸ hg

variable {T : Type w} [CommRing T]

/-- Original constants and variables determine every actual formal map into a separated target. -/
theorem formal_hom_ext (J : Ideal T) [IsHausdorff J T]
    (f g : MvPowerSeries σ A →+* T)
    (hC : ∀ a : A, f (C a) = g (C a)) (hX : ∀ i : σ, f (X i) = g (X i))
    (hvars : ∀ i : σ, f (X i) ∈ J) : f = g := by
  have hf : (variableIdeal (σ := σ) (A := A)).map f ≤ J := by
    rw [Ideal.map_le_iff_le_comap, variableIdeal, Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    exact hvars i
  have hg : (variableIdeal (σ := σ) (A := A)).map g ≤ J := by
    rw [Ideal.map_le_iff_le_comap, variableIdeal, Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    change g (X i) ∈ J
    rw [← hX i]
    exact hvars i
  have hp (p : MvPolynomial σ A) : f p = g p := by
    induction p using MvPolynomial.induction_on with
    | C a => simpa only [MvPolynomial.coe_C] using hC a
    | add p q hp hq => simp only [MvPolynomial.coe_add, map_add, hp, hq]
    | mul_X p i hp => simp only [MvPolynomial.coe_mul, MvPolynomial.coe_X, map_mul, hp, hX]
  apply RingHom.ext
  intro F
  apply NodeFormalMorse.CoefficientLimit.scalar_ext J
  intro n
  have hfn := Ideal.pow_right_mono hf n
    (show f (F - (F.truncTotal n : MvPolynomial σ A)) ∈ (variableIdeal (σ := σ) (A := A)).map f ^ n by
      rw [← Ideal.map_pow]
      exact Ideal.mem_map_of_mem f (sub_truncTotal_mem F n))
  have hgn := Ideal.pow_right_mono hg n
    (show g (F - (F.truncTotal n : MvPolynomial σ A)) ∈ (variableIdeal (σ := σ) (A := A)).map g ^ n by
      rw [← Ideal.map_pow]
      exact Ideal.mem_map_of_mem g (sub_truncTotal_mem F n))
  have hd : f F - g F = f (F - (F.truncTotal n : MvPolynomial σ A)) -
      g (F - (F.truncTotal n : MvPolynomial σ A)) := by
    rw [map_sub, map_sub, hp]
    abel
  apply sub_eq_zero.mp
  rw [← map_sub]
  apply Ideal.Quotient.eq_zero_iff_mem.mpr
  rw [hd]
  exact (J ^ n).sub_mem hfn hgn

end DeJongAlterations.Algebra.NodeFlatPresentation
