import Mathlib.LinearAlgebra.Matrix.Determinant.Basic
import Mathlib.RingTheory.Ideal.Maps

/-!
# Actual full determinantal ideals and arbitrary coefficient base change

These are the entire ideals of actual minors. Presentation-independence
for modules and geometric Fitting sheaf gluing are separate producers.
-/

noncomputable section

namespace DeJongAlterations.Algebra.NodeFittingMatrix

universe u v w z
variable {R : Type u} [CommRing R] {m : Type v} {n : Type w}

/-- All actual square submatrix determinants. Repeated indices contribute zero. -/
def minorSet (k : ℕ) (A : Matrix m n R) : Set R :=
  {x | ∃ r : Fin k → m, ∃ c : Fin k → n, (A.submatrix r c).det = x}

/-- The full actual ideal generated by the original matrix's actual minors. -/
def determinantalIdeal (k : ℕ) (A : Matrix m n R) : Ideal R := Ideal.span (minorSet k A)

theorem minor_mem (k : ℕ) (A : Matrix m n R) (r : Fin k → m) (c : Fin k → n) :
    (A.submatrix r c).det ∈ determinantalIdeal k A :=
  Ideal.subset_span ⟨r, c, rfl⟩

/-- Repeated original row selections contribute only the actual zero determinant. -/
theorem minor_eq_zero_of_not_injective_rows (k : ℕ) (A : Matrix m n R)
    (r : Fin k → m) (c : Fin k → n) (hr : ¬Function.Injective r) :
    (A.submatrix r c).det = 0 := by
  classical
  have hh : ∃ i j, r i = r j ∧ i ≠ j := by
    by_contra hn
    apply hr
    intro i j hij
    by_contra hne
    exact hn ⟨i, j, hij, hne⟩
  obtain ⟨i, j, hij, hne⟩ := hh
  apply Matrix.det_zero_of_row_eq hne
  ext l
  exact congrArg (fun x => A x (c l)) hij

/-- Repeated original column selections also contribute only the actual zero determinant. -/
theorem minor_eq_zero_of_not_injective_columns (k : ℕ) (A : Matrix m n R)
    (r : Fin k → m) (c : Fin k → n) (hc : ¬Function.Injective c) :
    (A.submatrix r c).det = 0 := by
  change (A.transpose.submatrix c r).transpose.det = 0
  rw [Matrix.det_transpose]
  exact minor_eq_zero_of_not_injective_rows k A.transpose c r hc

/-- These are exactly the usual full ideals of minors using distinct original rows and columns. -/
theorem determinantalIdeal_eq_span_embeddings (k : ℕ) (A : Matrix m n R) :
    determinantalIdeal k A = Ideal.span
      {x | ∃ r : Fin k ↪ m, ∃ c : Fin k ↪ n, (A.submatrix r c).det = x} := by
  classical
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro x ⟨r, c, rfl⟩
    by_cases hr : Function.Injective r
    · by_cases hc : Function.Injective c
      · exact Ideal.subset_span ⟨⟨r, hr⟩, ⟨c, hc⟩, rfl⟩
      · rw [minor_eq_zero_of_not_injective_columns k A r c hc]
        exact Ideal.zero_mem _
    · rw [minor_eq_zero_of_not_injective_rows k A r c hr]
      exact Ideal.zero_mem _
  · apply Ideal.span_le.mpr
    rintro x ⟨r, c, rfl⟩
    exact minor_mem k A r c

/-- Exact full ideal base change for every actual ring map, without flatness. -/
theorem determinantalIdeal_map {S : Type z} [CommRing S] (φ : R →+* S)
    (k : ℕ) (A : Matrix m n R) :
    (determinantalIdeal k A).map φ = determinantalIdeal k (A.map φ) := by
  rw [determinantalIdeal, Ideal.map_span, determinantalIdeal]
  apply congrArg Ideal.span
  ext x
  constructor
  · rintro ⟨y, ⟨r, c, hy⟩, rfl⟩
    refine ⟨r, c, ?_⟩
    rw [← hy]
    exact (φ.map_det (A.submatrix r c)).symm
  · rintro ⟨r, c, rfl⟩
    exact ⟨(A.submatrix r c).det, ⟨r, c, rfl⟩, φ.map_det (A.submatrix r c)⟩

private theorem determinantalIdeal_transpose_le (k : ℕ) (A : Matrix m n R) :
    determinantalIdeal k A.transpose ≤ determinantalIdeal k A := by
  apply Ideal.span_le.mpr
  rintro x ⟨r, c, rfl⟩
  change (A.submatrix c r).transpose.det ∈ determinantalIdeal k A
  rw [Matrix.det_transpose]
  exact minor_mem k A c r

/-- Actual transposition preserves the whole original minors ideal. -/
theorem determinantalIdeal_transpose (k : ℕ) (A : Matrix m n R) :
    determinantalIdeal k A.transpose = determinantalIdeal k A := by
  apply le_antisymm (determinantalIdeal_transpose_le k A)
  simpa only [Matrix.transpose_transpose] using determinantalIdeal_transpose_le k A.transpose

/-- The actual empty minor is one. -/
@[simp]
theorem determinantalIdeal_zero (A : Matrix m n R) : determinantalIdeal 0 A = ⊤ := by
  apply (Ideal.eq_top_iff_one _).mpr
  have hh := minor_mem 0 A Fin.elim0 Fin.elim0
  simpa using hh

/-- The actual one-by-one minors are exactly the same original matrix entries. -/
theorem determinantalIdeal_one (A : Matrix m n R) :
    determinantalIdeal 1 A = Ideal.span (Set.range (fun ij : m × n => A ij.1 ij.2)) := by
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro x ⟨r, c, rfl⟩
    rw [Matrix.det_unique]
    exact Ideal.subset_span ⟨⟨r default, c default⟩, rfl⟩
  · apply Ideal.span_le.mpr
    rintro x ⟨⟨i, j⟩, rfl⟩
    have hh := minor_mem 1 A (fun _ => i) (fun _ => j)
    simpa using hh

end DeJongAlterations.Algebra.NodeFittingMatrix
