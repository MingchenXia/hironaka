import DeJongAlterations.Geometry.AffineBlowupChart
import Mathlib.Algebra.GroupWithZero.Regular
import Mathlib.RingTheory.FractionalIdeal.Inverse

/-!
# The extended ideal in an actual blowup chart

For a domain and a nonzero element g of an arbitrary ideal I, its extension to
the genuine fraction chart R[I/g] is generated by g, a non-zero-divisor.
No finite-generation or principalization certificate is assumed.
-/

noncomputable section

namespace DeJongAlterations

universe u

variable {R : Type u} [CommRing R] [IsDomain R]
variable (I : Ideal R) (g : R)

/-- Every defining ratio is an element of the actual fraction chart. -/
def affineBlowupChartRatio (a : R) (ha : a ∈ I) : affineBlowupFractionChart I g :=
  ⟨algebraMap R (FractionRing R) a / algebraMap R (FractionRing R) g,
    Algebra.subset_adjoin ⟨⟨a, ha⟩, rfl⟩⟩

@[simp]
theorem coe_affineBlowupChartRatio (a : R) (ha : a ∈ I) :
    (affineBlowupChartRatio I g a ha : FractionRing R) =
      algebraMap R (FractionRing R) a / algebraMap R (FractionRing R) g :=
  rfl

/-- Original ideal elements factor by g inside the chart, not merely in its
ambient fraction field. -/
theorem affineBlowupFractionChart_mul_ratio (hg0 : g ≠ 0) (a : R) (ha : a ∈ I) :
    algebraMap R (affineBlowupFractionChart I g) g * affineBlowupChartRatio I g a ha =
      algebraMap R (affineBlowupFractionChart I g) a := by
  apply Subtype.ext
  change algebraMap R (FractionRing R) g *
      (algebraMap R (FractionRing R) a / algebraMap R (FractionRing R) g) =
    algebraMap R (FractionRing R) a
  rw [← mul_div_assoc]
  exact mul_div_cancel_left₀ _ ((map_ne_zero_iff _
    (IsFractionRing.injective R (FractionRing R))).mpr hg0)

/-- The original ideal's actual extension is generated by the chart denominator. -/
theorem affineBlowupFractionChart_mapIdeal (hg : g ∈ I) (hg0 : g ≠ 0) :
    Ideal.map (algebraMap R (affineBlowupFractionChart I g)) I =
      Ideal.span {algebraMap R (affineBlowupFractionChart I g) g} := by
  apply le_antisymm
  · rw [Ideal.map_le_iff_le_comap]
    intro a ha
    change algebraMap R (affineBlowupFractionChart I g) a ∈
      Ideal.span {algebraMap R (affineBlowupFractionChart I g) g}
    rw [← affineBlowupFractionChart_mul_ratio I g hg0 a ha]
    exact Ideal.mul_mem_right _ _ (Ideal.subset_span (by simp))
  · apply Ideal.span_le.mpr
    intro a ha
    rcases Set.mem_singleton_iff.mp ha with rfl
    exact Ideal.mem_map_of_mem _ hg

/-- The chart denominator is a non-zero-divisor in the actual chart ring. -/
theorem affineBlowupFractionChart_generator_isRegular (hg0 : g ≠ 0) :
    IsRegular (algebraMap R (affineBlowupFractionChart I g) g) := by
  apply IsRegular.of_ne_zero
  intro h
  apply hg0
  apply IsFractionRing.injective R (FractionRing R)
  have hh := congrArg (fun z : affineBlowupFractionChart I g => (z : FractionRing R)) h
  simpa only [Subalgebra.coe_algebraMap, Subalgebra.coe_zero, map_zero] using hh

/-- The extended ideal has a genuine inverse in the native fractional-ideal ring. -/
theorem affineBlowupFractionChart_extendedIdeal_mul_inv (hg : g ∈ I) (hg0 : g ≠ 0) :
    let S := affineBlowupFractionChart I g
    let J : FractionalIdeal (nonZeroDivisors S) (FractionRing S) :=
      Ideal.map (algebraMap R S) I
    J * J⁻¹ = 1 := by
  dsimp only
  rw [affineBlowupFractionChart_mapIdeal I g hg hg0]
  exact FractionalIdeal.coe_ideal_span_singleton_mul_inv _
    (affineBlowupFractionChart_generator_isRegular I g hg0).ne_zero

end DeJongAlterations
