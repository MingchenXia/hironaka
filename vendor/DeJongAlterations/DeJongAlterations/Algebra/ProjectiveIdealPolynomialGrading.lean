/-!
# Polynomial grading projections and the irrelevant ideal

These unchanged arbitrary-ring helpers are shared by native polynomial Proj
and the existing paper's normalized projective model. The actual total-degree
projection is the homogeneous-component operator, and the true irrelevant
ideal is the ideal generated by all polynomial variables.
-/

namespace DeJongAlterations.Geometry.ProjectiveIdeal

attribute [local instance] MvPolynomial.gradedAlgebra

section PolynomialGrading

variable {R σ : Type*} [CommRing R]

/-- For the total-degree grading, the abstract graded projection is the usual
homogeneous-component operator. -/
theorem proj_eq_homogeneousComponent (F : MvPolynomial σ R) (d : ℕ) :
    GradedRing.proj (MvPolynomial.homogeneousSubmodule σ R) d F =
      MvPolynomial.homogeneousComponent d F :=
  MvPolynomial.decomposition.decompose'_apply F d

/-- The irrelevant ideal of the polynomial total-degree grading is the actual
ideal generated by all coordinate variables. -/
theorem irrelevant_eq_idealOfVars :
    (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule σ R)).toIdeal =
      MvPolynomial.idealOfVars σ R := by
  classical
  apply le_antisymm
  · rw [HomogeneousIdeal.toIdeal_irrelevant_le]
    intro d hd F hF
    change F ∈ MvPolynomial.idealOfVars σ R
    rw [← pow_one (MvPolynomial.idealOfVars σ R), MvPolynomial.mem_pow_idealOfVars_iff]
    intro m hm
    have heq : m.degree = d := by
      simpa only [MvPolynomial.IsHomogeneous, Pi.one_def, ← Finsupp.degree_eq_weight_one] using
        hF (MvPolynomial.mem_support_iff.1 hm)
    omega
  · rw [MvPolynomial.idealOfVars, Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    exact HomogeneousIdeal.mem_irrelevant_of_mem _ (by decide : 0 < (1 : ℕ))
      (MvPolynomial.isHomogeneous_X R i)

end PolynomialGrading

end DeJongAlterations.Geometry.ProjectiveIdeal
