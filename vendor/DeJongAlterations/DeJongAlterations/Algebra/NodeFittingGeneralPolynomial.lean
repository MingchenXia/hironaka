import Mathlib.RingTheory.Extension.Cotangent.Basic

/-!
# Genuine differentials of the original arbitrary polynomial hypersurface

The polynomial equation and its native cotangent presentation are constructed
from the original polynomial itself. No Jacobian or differential certificate
is an input. Intrinsic global Fitting-independence is separate.
-/

noncomputable section

namespace DeJongAlterations.Algebra.NodeFittingGeneral

open MvPolynomial _root_.Algebra

set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

universe u
variable {R : Type u} [CommRing R]

abbrev polynomialIdeal (f : MvPolynomial (Fin 2) R) : Ideal (MvPolynomial (Fin 2) R) :=
  Ideal.span {f}

abbrev PolynomialHypersurface (f : MvPolynomial (Fin 2) R) :=
  MvPolynomial (Fin 2) R ⧸ polynomialIdeal f

/-- The actual two-generator one-relation polynomial hypersurface presentation. -/
def polynomialPresentation (f : MvPolynomial (Fin 2) R) :
    Presentation R (PolynomialHypersurface f) (Fin 2) Unit where
  toGenerators := Generators.naive
  relation _ := f
  span_range_relation_eq_ker := by
    change Ideal.span (Set.range (fun _ : Unit => f)) =
      RingHom.ker (Ideal.Quotient.mk (polynomialIdeal f))
    simp

/-- The original equation's class in the actual conormal module. -/
def relationClass (f : MvPolynomial (Fin 2) R) :
    (polynomialPresentation f).toExtension.Cotangent :=
  Extension.Cotangent.mk ⟨f,
    (polynomialPresentation f).relation_mem_ker ()⟩

/-- The actual conormal module is generated by the original equation. -/
theorem conormal_span_eq_top (f : MvPolynomial (Fin 2) R) :
    Submodule.span (PolynomialHypersurface f) {relationClass f} = ⊤ := by
  have ht := Extension.Cotangent.span_eq_top_of_span_eq_ker
    (P := (polynomialPresentation f).toExtension)
    (polynomialPresentation f).relation
    (polynomialPresentation f).span_range_relation_eq_ker
  change Submodule.span (PolynomialHypersurface f)
    (Set.range (fun _ : Unit => relationClass f)) = ⊤ at ht
  simpa only [Set.range_const] using ht

/-- The actual differential vector of the original relation. -/
def gradientVector (f : MvPolynomial (Fin 2) R) :
    (polynomialPresentation f).toExtension.CotangentSpace :=
  (polynomialPresentation f).toExtension.cotangentComplex (relationClass f)

/-- The whole actual conormal image is exactly the original gradient-vector span. -/
theorem cotangentComplex_range (f : MvPolynomial (Fin 2) R) :
    LinearMap.range (polynomialPresentation f).toExtension.cotangentComplex =
      Submodule.span (PolynomialHypersurface f) {gradientVector f} := by
  rw [← Submodule.map_top, ← conormal_span_eq_top f,
    Submodule.map_span, Set.image_singleton]
  rfl

/-- The actual native differential map is surjective. -/
theorem toKaehler_surjective (f : MvPolynomial (Fin 2) R) :
    Function.Surjective (polynomialPresentation f).toExtension.toKaehler :=
  (polynomialPresentation f).toExtension.toKaehler_surjective

/-- Its entire actual kernel is the one internally computed gradient relation. -/
theorem toKaehler_kernel (f : MvPolynomial (Fin 2) R) :
    LinearMap.ker (polynomialPresentation f).toExtension.toKaehler =
      Submodule.span (PolynomialHypersurface f) {gradientVector f} := by
  rw [LinearMap.exact_iff.mp
    (polynomialPresentation f).toExtension.exact_cotangentComplex_toKaehler,
    cotangentComplex_range]

/-- Every actual gradient coordinate is the corresponding native polynomial derivative. -/
theorem gradientVector_coordinate (f : MvPolynomial (Fin 2) R) (i : Fin 2) :
    (polynomialPresentation f).cotangentSpaceBasis.repr (gradientVector f) i =
      Ideal.Quotient.mk (polynomialIdeal f) (MvPolynomial.pderiv i (f)) := by
  rw [gradientVector, relationClass, Extension.cotangentComplex_mk,
    Generators.cotangentSpaceBasis_repr_one_tmul]
  have he : aeval (polynomialPresentation f).val = Ideal.Quotient.mkₐ R (polynomialIdeal f) := by
    ext i
    rw [aeval_X]
    rfl
  rw [he]
  rfl

/-- The genuine native Kaehler module is the actual one-relation cokernel. -/
def kaehlerQuotientEquiv (f : MvPolynomial (Fin 2) R) :
    ((polynomialPresentation f).toExtension.CotangentSpace ⧸
      Submodule.span (PolynomialHypersurface f) {gradientVector f}) ≃ₗ[PolynomialHypersurface f]
        KaehlerDifferential R (PolynomialHypersurface f) :=
  (Submodule.quotEquivOfEq _ _ (toKaehler_kernel f).symm).trans
    ((polynomialPresentation f).toExtension.toKaehler.quotKerEquivOfSurjective
      (toKaehler_surjective f))

/-- The actual entry minors of the proved original differential presentation. -/
def presentationFirstFittingIdeal (f : MvPolynomial (Fin 2) R) :
    Ideal (PolynomialHypersurface f) :=
  Ideal.span {(polynomialPresentation f).cotangentSpaceBasis.repr (gradientVector f) 0,
    (polynomialPresentation f).cotangentSpaceBasis.repr (gradientVector f) 1}

/-- The actual minors are precisely the images of the original polynomial derivatives. -/
theorem presentationFirstFittingIdeal_eq_derivatives (f : MvPolynomial (Fin 2) R) :
    presentationFirstFittingIdeal f =
      Ideal.span {Ideal.Quotient.mk (polynomialIdeal f) (MvPolynomial.pderiv 0 f),
        Ideal.Quotient.mk (polynomialIdeal f) (MvPolynomial.pderiv 1 f)} := by
  unfold presentationFirstFittingIdeal
  rw [gradientVector_coordinate, gradientVector_coordinate]

end DeJongAlterations.Algebra.NodeFittingGeneral
