import DeJongAlterations.Algebra.NodeFittingIdealSheafAffinePullback

/-! # Whole native ideal-sheaf stalks, actual pullback and extensionality -/

noncomputable section

namespace DeJongAlterations.Algebra.NodeFittingIdealSheaf

open AlgebraicGeometry CategoryTheory TopologicalSpace Scheme.IdealSheafData

universe u
variable {X Y : Scheme.{u}}

/-- A native original affine neighbourhood exists at every actual scheme point. -/
theorem exists_affineOpens_mem (x : X) : ∃ U : X.affineOpens, x ∈ U.1 := by
  obtain ⟨_, ⟨U, hU, rfl⟩, hx, -⟩ := X.isBasis_affineOpens.exists_subset_of_mem_open
    (Set.mem_univ x) isOpen_univ
  exact ⟨⟨U, hU⟩, hx⟩


/-- The actual whole ideal of germs, without choosing a chart or radical. -/
def stalkIdeal (J : X.IdealSheafData) (x : X) : Ideal (X.presheaf.stalk x) :=
  ⨆ (U : X.affineOpens) (hx : x ∈ U.1), (J.ideal U).map (X.presheaf.germ U.1 x hx).hom

theorem map_germ_ideal_comap (I : X.IdealSheafData) (f : Y ⟶ X) (y : Y) (U : X.affineOpens)
    (V : Y.affineOpens) (hy : y ∈ V.1) (e : V.1 ≤ f ⁻¹ᵁ U.1) :
    ((I.comap f).ideal V).map (Y.presheaf.germ V.1 y hy).hom =
      ((I.ideal U).map (X.presheaf.germ U.1 (f y) (e hy)).hom).map (f.stalkMap y).hom := by
  have hfy : f y ∈ U.1 := e hy
  change _ = ((I.ideal U).map (X.presheaf.germ U.1 (f y) hfy).hom).map (f.stalkMap y).hom
  rw [ideal_comap_of_le I f U V e, Ideal.map_map, Ideal.map_map, ← CommRingCat.hom_comp,
    ← CommRingCat.hom_comp]
  congr 2
  rw [Scheme.Hom.germ_stalkMap, Scheme.Hom.appLE, Category.assoc, TopCat.Presheaf.germ_res]

theorem map_germ_le_stalkIdeal (J : X.IdealSheafData) (U : X.affineOpens) {x : X}
    (hx : x ∈ U.1) : (J.ideal U).map (X.presheaf.germ U.1 x hx).hom ≤ stalkIdeal J x :=
  le_iSup₂ (f := fun (U : X.affineOpens) (hx : x ∈ U.1) =>
    (J.ideal U).map (X.presheaf.germ U.1 x hx).hom) U hx

/-- Germs of sections over a smaller affine open give the same ideal: `J(W) = J(V) Γ(W)` for
affine `W ≤ V` (Mathlib's `map_ideal`) and `germ ∘ res = germ`. -/
theorem map_germ_eq_of_le (J : X.IdealSheafData) {V W : X.affineOpens} (h : W ≤ V) {x : X}
    (hx : x ∈ W.1) :
    (J.ideal W).map (X.presheaf.germ W.1 x hx).hom =
      (J.ideal V).map (X.presheaf.germ V.1 x (h hx)).hom := by
  rw [← J.map_ideal h, Ideal.map_map, ← CommRingCat.hom_comp,
    show X.presheaf.map (homOfLE h).op ≫ X.presheaf.germ W.1 x hx =
      X.presheaf.germ V.1 x (h hx) from X.presheaf.germ_res (homOfLE h) x hx]

/-- Every affine open `U ∋ x` computes the stalk ideal: `J_x` is the image of `J(U)` under the
germ map. -/
theorem stalkIdeal_eq_map_germ (J : X.IdealSheafData) (U : X.affineOpens) {x : X} (hx : x ∈ U.1) :
    stalkIdeal J x = (J.ideal U).map (X.presheaf.germ U.1 x hx).hom := by
  refine le_antisymm (iSup₂_le fun V hxV => ?_) (map_germ_le_stalkIdeal J U hx)
  obtain ⟨s, t, hst, hxs⟩ := exists_basicOpen_le_affine_inter U.2 V.2 x ⟨hx, hxV⟩
  have hWU : X.affineBasicOpen s ≤ U := X.basicOpen_le s
  have hWV : X.affineBasicOpen s ≤ V := by
    change X.basicOpen s ≤ V.1
    rw [hst]
    exact X.basicOpen_le t
  exact ((map_germ_eq_of_le J hWV hxs).symm.trans (map_germ_eq_of_le J hWU hxs)).le

/-- The stalk of the inverse image `I.comap f` at `y` is generated by the image under
`f.stalkMap y` of the stalk of `I` at `f y` (compare the proof of [Sta, Tag 0805]). -/
theorem stalkIdeal_comap (I : X.IdealSheafData) (f : Y ⟶ X) (y : Y) :
    stalkIdeal (I.comap f) y = (stalkIdeal I (f y)).map (f.stalkMap y).hom := by
  obtain ⟨U, hU⟩ := exists_affineOpens_mem (f y)
  obtain ⟨V, hV, e⟩ : ∃ V : Y.affineOpens, y ∈ V.1 ∧ V.1 ≤ f ⁻¹ᵁ U.1 := by
    obtain ⟨V₀, hV₀⟩ := exists_affineOpens_mem y
    obtain ⟨s, hs_le, hys⟩ := V₀.2.exists_basicOpen_le (V := f ⁻¹ᵁ U.1) ⟨y, hU⟩ hV₀
    exact ⟨Y.affineBasicOpen s, hys, hs_le⟩
  rw [stalkIdeal_eq_map_germ _ V hV, stalkIdeal_eq_map_germ _ U hU,
    map_germ_ideal_comap I f y U V hV e]


/-- Native affine germ extensionality detects the actual whole stalk ideals. -/
theorem ext_stalkIdeal {I J : X.IdealSheafData}
    (h : ∀ x, stalkIdeal I x = stalkIdeal J x) : I = J := by
  apply Scheme.IdealSheafData.ext
  funext U
  rw [U.2.ideal_ext_iff]
  intro x hx
  rw [← stalkIdeal_eq_map_germ I U hx, ← stalkIdeal_eq_map_germ J U hx]
  exact h x

end DeJongAlterations.Algebra.NodeFittingIdealSheaf
