import DeJongAlterations.Algebra.NodeFieldCotangentGenerators
import DeJongAlterations.Algebra.NodeGeometricCompletionFieldPresentation

/-! # Original complete binary series presentations from actual second-jet dimension

All generators are internally produced from the original coefficient residue map
and actual second-jet rank. The already proved complete evaluation construction
is reused with its full original coefficient and entire ideal-power triangles.
-/

noncomputable section

open IsLocalRing MvPowerSeries

namespace DeJongAlterations.Algebra.NodeFieldCotangentGeneratorsPresentation

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

universe u v
variable (K : Type u) [Field K] (C : Type v) [CommRing C] [IsLocalRing C]
  [IsNoetherianRing C] [Algebra K C]
  (hres : Function.Bijective ((residue C).comp (algebraMap K C)))
  (hdim : Module.finrank K (C ⧸ maximalIdeal C ^ 2) = 3)

/-- The two actual generators are chosen ONLY from the proved original native dimension producer. -/
def generators : Fin 2 → C :=
  Classical.choose (NodeFieldCotangentGenerators.exists_maximalIdeal_generators K C hres hdim)

/-- The WHOLE original native maximal ideal is generated by the internally produced pair. -/
theorem generators_span : Ideal.span (Set.range (generators K C hres hdim)) = maximalIdeal C :=
  Classical.choose_spec (NodeFieldCotangentGenerators.exists_maximalIdeal_generators K C hres hdim)

variable [IsAdicComplete (maximalIdeal C) C]

/-- Actual complete evaluation from the internally derived generators. -/
def evaluation : MvPowerSeries (Fin 2) K →ₐ[K] C :=
  NodeGeometricCompletionFieldPresentation.evaluation K C
    (generators K C hres hdim) (generators_span K C hres hdim)

/-- EVERY original coefficient follows the SAME original coefficient action. -/
theorem evaluation_C (a : K) :
    evaluation K C hres hdim (MvPowerSeries.C a) = algebraMap K C a :=
  NodeGeometricCompletionFieldPresentation.evaluation_C K C
    (generators K C hres hdim) (generators_span K C hres hdim) a

/-- Both variables map to their internally derived actual original generators. -/
theorem evaluation_X (i : Fin 2) :
    evaluation K C hres hdim (X i) = generators K C hres hdim i :=
  NodeGeometricCompletionFieldPresentation.evaluation_X K C
    (generators K C hres hdim) (generators_span K C hres hdim) i

/-- EVERY entire variable-ideal power has exactly its original maximal-ideal-power image. -/
theorem variableIdeal_pow_image (n : ℕ) :
    ((Ideal.span (Set.range (fun i : Fin 2 => (X i : MvPowerSeries (Fin 2) K)))) ^ n).map
      (evaluation K C hres hdim).toRingHom = maximalIdeal C ^ n :=
  NodeGeometricCompletionFieldPresentation.variableIdeal_pow_image K C
    (generators K C hres hdim) (generators_span K C hres hdim) n

/-- The actual complete evaluation is surjective, with NO supplied maximal generators. -/
theorem evaluation_surjective : Function.Surjective (evaluation K C hres hdim) :=
  NodeGeometricCompletionFieldPresentation.evaluation_surjective K C
    (generators K C hres hdim) (generators_span K C hres hdim) hres.surjective

/-- The ENTIRE kernel of this SAME actual evaluation gives the original K-algebra. -/
def quotientEquiv :
    (MvPowerSeries (Fin 2) K ⧸ RingHom.ker (evaluation K C hres hdim).toRingHom) ≃ₐ[K] C :=
  NodeGeometricCompletionFieldPresentation.quotientEquiv K C
    (generators K C hres hdim) (generators_span K C hres hdim) hres.surjective

/-- EVERY series representative has its actual original evaluation image. -/
theorem quotientEquiv_mk (g : MvPowerSeries (Fin 2) K) :
    quotientEquiv K C hres hdim (Ideal.Quotient.mk _ g) = evaluation K C hres hdim g :=
  NodeGeometricCompletionFieldPresentation.quotientEquiv_mk K C
    (generators K C hres hdim) (generators_span K C hres hdim) hres.surjective g

/-- The actual quotient equivalence preserves EVERY original coefficient. -/
theorem quotientEquiv_C (a : K) :
    quotientEquiv K C hres hdim (Ideal.Quotient.mk _ (MvPowerSeries.C a)) = algebraMap K C a := by
  rw [quotientEquiv_mk, evaluation_C]

/-- The actual quotient equivalence preserves both internally produced original coordinates. -/
theorem quotientEquiv_X (i : Fin 2) :
    quotientEquiv K C hres hdim (Ideal.Quotient.mk _ (X i)) = generators K C hres hdim i := by
  rw [quotientEquiv_mk, evaluation_X]

end DeJongAlterations.Algebra.NodeFieldCotangentGeneratorsPresentation
