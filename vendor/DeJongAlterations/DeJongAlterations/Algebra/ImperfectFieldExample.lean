import Mathlib.FieldTheory.PurelyInseparable.AdjoinPthRoots
import Mathlib.FieldTheory.RatFunc.Degree
import Mathlib.Algebra.Field.ZMod

/-!
# A concrete imperfect field and its finite purely inseparable root extension

The field `F₃(t)` and the cube root of `t` provide the distinguished residue
field in the curve counterexample of de Jong, source 2.10. These algebraic
producers do not assert the separate regular-curve counterexample.
-/

noncomputable section

namespace DeJongAlterations.Algebra.ImperfectFieldExample

instance : Fact (Nat.Prime 3) := ⟨by decide⟩

/-- The actual rational function field over the field with three elements. -/
abbrev BaseField := RatFunc (ZMod 3)

/-- The transcendental coefficient in the source's characteristic-three example. -/
def alpha : BaseField := RatFunc.X

theorem alpha_not_cube (b : BaseField) : b ^ 3 ≠ alpha := by
  intro hb
  have hb0 : b ≠ 0 := by
    intro h
    subst b
    have hdeg := congrArg RatFunc.intDegree hb
    norm_num [alpha] at hdeg
  have hdeg := congrArg RatFunc.intDegree hb
  rw [show b ^ 3 = b * b * b by ring,
    RatFunc.intDegree_mul (mul_ne_zero hb0 hb0) hb0,
    RatFunc.intDegree_mul hb0 hb0] at hdeg
  simp only [alpha, RatFunc.intDegree_X] at hdeg
  omega

/-- The ambient extension obtained by adjoining all actual cube roots. -/
abbrev RootAmbient := AdjoinPthRoots BaseField

/-- The ambient cube root of the explicit transcendental coefficient. -/
def ambientRoot : RootAmbient := AdjoinPthRoots.root BaseField alpha

/-- The actual simple intermediate field generated by the cube root of `t`. -/
abbrev RootField := IntermediateField.adjoin BaseField ({ambientRoot} : Set RootAmbient)

/-- The distinguished generator as an element of the simple intermediate field. -/
def root : RootField := ⟨ambientRoot, IntermediateField.mem_adjoin_simple_self _ _⟩

theorem root_cubed : root ^ 3 = algebraMap BaseField RootField alpha := by
  apply Subtype.ext
  exact AdjoinPthRoots.root_pow 3 alpha

instance rootField_isPurelyInseparable : IsPurelyInseparable BaseField RootField :=
  IsPurelyInseparable.tower_bot BaseField RootField RootAmbient

instance rootField_finiteDimensional : FiniteDimensional BaseField RootField :=
  IntermediateField.adjoin.finiteDimensional
    (Algebra.IsIntegral.isIntegral ambientRoot)

theorem root_not_mem_range : root ∉ Set.range (algebraMap BaseField RootField) := by
  rintro ⟨b, hb⟩
  have h := root_cubed
  rw [← hb, ← map_pow] at h
  exact alpha_not_cube b ((algebraMap BaseField RootField).injective h)

theorem algebraMap_not_surjective :
    ¬ Function.Surjective (algebraMap BaseField RootField) := by
  intro h
  exact root_not_mem_range (h root)

end DeJongAlterations.Algebra.ImperfectFieldExample
