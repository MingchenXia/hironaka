import DeJongAlterations.Algebra.RegularQuotientFamily
import DeJongAlterations.Algebra.RegularLocalDomain

/-! Exact original parameter-ideal heights, from actual cotangent independence and strict original prime chains. -/

noncomputable section

open IsLocalRing

namespace DeJongAlterations.Algebra.CompletionIntersectionRegularityHeight

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

universe u v
variable {R : Type u} [CommRing R] [IsLocalRing R]
variable {ι : Type v}

/-- The full ideal generated by the selected original equations. -/
def parameterIdeal (t : ι → maximalIdeal R) (s : Finset ι) : Ideal R :=
  Ideal.span ((fun i ↦ (t i : R)) '' (s : Set ι))

/-- Actual ideal membership gives membership of the same original cotangent class in the selected span. -/
theorem cotangent_mem_span_of_mem_parameterIdeal (t : ι → maximalIdeal R) (s : Finset ι)
    (x : maximalIdeal R) (hx : x.val ∈ parameterIdeal t s) :
    (maximalIdeal R).toCotangent x ∈ Submodule.span (ResidueField R)
      ((fun i ↦ (maximalIdeal R).toCotangent (t i)) '' (s : Set ι)) := by
  let I := parameterIdeal t s
  let K := Submodule.span (ResidueField R)
    ((fun i ↦ (maximalIdeal R).toCotangent (t i)) '' (s : Set ι))
  have hIm : I ≤ maximalIdeal R := Ideal.span_le.mpr (by
    rintro _ ⟨i, _, rfl⟩
    exact (t i).property)
  have haux : ∀ r (hr : r ∈ I), ∀ hm : r ∈ maximalIdeal R,
      (maximalIdeal R).toCotangent ⟨r, hm⟩ ∈ K := by
    intro r hr
    change r ∈ Submodule.span R ((fun i ↦ (t i : R)) '' (s : Set ι)) at hr
    induction hr using Submodule.span_induction with
    | mem r hr =>
      rintro hm
      obtain ⟨i, hi, rfl⟩ := hr
      exact Submodule.subset_span ⟨i, hi, rfl⟩
    | zero =>
      intro hm
      change (maximalIdeal R).toCotangent 0 ∈ K
      rw [map_zero]
      exact K.zero_mem
    | add r q hr hq ihr ihq =>
      intro hm
      have hrm : r ∈ maximalIdeal R := hIm hr
      have hqm : q ∈ maximalIdeal R := hIm hq
      change (maximalIdeal R).toCotangent (⟨r, hrm⟩ + ⟨q, hqm⟩) ∈ K
      rw [map_add]
      exact K.add_mem (ihr hrm) (ihq hqm)
    | smul a r hr ihr =>
      intro hm
      have hrm : r ∈ maximalIdeal R := hIm hr
      change (maximalIdeal R).toCotangent (a • ⟨r, hrm⟩) ∈ K
      rw [map_smul]
      change residue R a • (maximalIdeal R).toCotangent ⟨r, hrm⟩ ∈ K
      exact K.smul_mem _ (ihr hrm)
  exact haux x.val hx x.property

/-- Independence of the original classes excludes an unselected original equation from the selected ideal. -/
theorem not_mem_parameterIdeal (t : ι → maximalIdeal R)
    (hli : LinearIndependent (ResidueField R) (fun i ↦ (maximalIdeal R).toCotangent (t i)))
    (s : Finset ι) (i : ι) (hi : i ∉ s) : (t i : R) ∉ parameterIdeal t s := by
  intro hmem
  exact hli.notMem_span_image hi (cotangent_mem_span_of_mem_parameterIdeal t s (t i) hmem)

/-- Inclusion of actual original index sets gives inclusion of the full generated ideals. -/
theorem parameterIdeal_mono (t : ι → maximalIdeal R) {s r : Finset ι} (hsr : s ⊆ r) :
    parameterIdeal t s ≤ parameterIdeal t r := Ideal.span_mono (Set.image_mono hsr)

/-- Adding a new original equation strictly increases its actual generated ideal. -/
theorem parameterIdeal_lt_insert [DecidableEq ι] (t : ι → maximalIdeal R)
    (hli : LinearIndependent (ResidueField R) (fun i ↦ (maximalIdeal R).toCotangent (t i)))
    (s : Finset ι) (i : ι) (hi : i ∉ s) : parameterIdeal t s < parameterIdeal t (insert i s) := by
  refine lt_of_le_of_ne (parameterIdeal_mono t (Finset.subset_insert _ _)) ?_
  intro heq
  apply not_mem_parameterIdeal t hli s i hi
  rw [heq]
  exact Ideal.subset_span (Set.mem_image_of_mem _ (Finset.mem_insert_self _ _))

end DeJongAlterations.Algebra.CompletionIntersectionRegularityHeight

namespace DeJongAlterations.Algebra.CompletionIntersectionRegularityHeight

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

universe u v
variable {R : Type u} [CommRing R] [IsRegularLocalRing R]
variable {ι : Type v}

/-- The actual original quotient by each selected subfamily is regular. -/
theorem parameterIdeal_quotient_isRegularLocalRing (t : ι → maximalIdeal R)
    (hli : LinearIndependent (ResidueField R) (fun i ↦ (maximalIdeal R).toCotangent (t i)))
    (s : Finset ι) : IsRegularLocalRing (R ⧸ parameterIdeal t s) := by
  have hrange : Set.range (fun i : s ↦ (t i.val : R)) =
      (fun i ↦ (t i : R)) '' (s : Set ι) := by ext x; simp
  rw [parameterIdeal, ← hrange]
  exact RegularQuotientFamily.isRegularLocalRing_quotient_family R (fun i : s ↦ t i.val)
    (hli.comp _ Subtype.val_injective)

/-- Regular local quotients make every original subfamily ideal genuinely prime. -/
theorem parameterIdeal_isPrime (t : ι → maximalIdeal R)
    (hli : LinearIndependent (ResidueField R) (fun i ↦ (maximalIdeal R).toCotangent (t i)))
    (s : Finset ι) : (parameterIdeal t s).IsPrime := by
  let : IsRegularLocalRing (R ⧸ parameterIdeal t s) := parameterIdeal_quotient_isRegularLocalRing t hli s
  let : IsDomain (R ⧸ parameterIdeal t s) := RegularLocalDomain.isDomain_of_isRegularLocalRing _
  exact (Ideal.Quotient.isDomain_iff_prime _).mp inferInstance

/-- Exact height of the full original selected parameter ideal, with no height certificate input. -/
theorem parameterIdeal_height (t : ι → maximalIdeal R)
    (hli : LinearIndependent (ResidueField R) (fun i ↦ (maximalIdeal R).toCotangent (t i)))
    (s : Finset ι) : (parameterIdeal t s).height = s.card := by
  classical
  have hge : (s.card : ℕ∞) ≤ (parameterIdeal t s).height := by
    induction s using Finset.induction_on with
    | empty => simp
    | @insert i s hi ih =>
      let : (parameterIdeal t s).IsPrime := parameterIdeal_isPrime t hli s
      let : (parameterIdeal t (insert i s)).IsPrime := parameterIdeal_isPrime t hli (insert i s)
      rw [Finset.card_insert_of_notMem hi, Nat.cast_add, Nat.cast_one]
      exact (add_le_add ih (le_refl (1 : ℕ∞))).trans
        (Ideal.height_add_one_le_of_lt_of_isPrime (parameterIdeal_lt_insert t hli s i hi))
  apply le_antisymm ?_ hge
  let : (parameterIdeal t s).IsPrime := parameterIdeal_isPrime t hli s
  have heq : Ideal.span (↑(s.image (fun i ↦ (t i : R))) : Set R) = parameterIdeal t s := by
    simp [parameterIdeal]
  have hmem : parameterIdeal t s ∈
      (Ideal.span (↑(s.image (fun i ↦ (t i : R))) : Set R)).minimalPrimes := by
    rw [heq, Ideal.minimalPrimes_eq_subsingleton_self]
    exact Set.mem_singleton _
  exact (Ideal.height_le_card_of_mem_minimalPrimes_span_finset hmem).trans
    (by exact_mod_cast Finset.card_image_le)

/-- Exact height of the original full finite family, preserving its original generated ideal. -/
theorem span_original_family_height [Fintype ι] (t : ι → maximalIdeal R)
    (hli : LinearIndependent (ResidueField R) (fun i ↦ (maximalIdeal R).toCotangent (t i))) :
    (Ideal.span (Set.range fun i ↦ (t i : R))).height = Fintype.card ι := by
  simpa only [parameterIdeal, Finset.coe_univ, Set.image_univ, Finset.card_univ] using
    parameterIdeal_height t hli Finset.univ

end DeJongAlterations.Algebra.CompletionIntersectionRegularityHeight
