import DeJongAlterations.Algebra.IntegralClosureFiniteTypeRoots
import Mathlib.FieldTheory.SeparableClosure
import Mathlib.FieldTheory.PurelyInseparable.Exponent
import Mathlib.RingTheory.DedekindDomain.IntegralClosure
import Mathlib.RingTheory.NoetherNormalization

/-!
# Separabilizing finite polynomial fraction-field extensions over arbitrary fields

The finite coefficient-root covers are applied to coefficients of separable
equations for powers of field generators. This module constructs the resulting
actual separable field extension, rather than taking it as a certificate.
-/

noncomputable section

open Polynomial
open DeJongAlterations.Algebra.IntegralClosureFiniteTypeRoots

namespace DeJongAlterations.Algebra.IntegralClosureFiniteTypeSeparable

universe u v

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

section Equations

variable {F E Ω : Type u} [Field F] [Field E] [Field Ω] [Algebra E Ω]

/-- Frobenius commutes with actual polynomial evaluation, including its coefficient map. -/
theorem eval₂_pow_frobenius (p n : ℕ) [ExpChar E p] [ExpChar Ω p]
    (Q : E[X]) (x : Ω) :
    aeval x Q ^ p ^ n =
      (Q.map (iterateFrobenius E p n)).eval₂ (algebraMap E Ω) (x ^ p ^ n) := by
  have hcomm : (iterateFrobenius Ω p n).comp (algebraMap E Ω) =
      (algebraMap E Ω).comp (iterateFrobenius E p n) := by
    apply RingHom.ext
    intro a
    simp only [RingHom.comp_apply, iterateFrobenius_def, map_pow]
  have h := Polynomial.hom_eval₂ (p := Q) (f := algebraMap E Ω)
    (g := iterateFrobenius Ω p n) x
  rw [hcomm] at h
  simpa only [iterateFrobenius_def, aeval_def, Polynomial.eval₂_map] using h

/-- Actual roots of the coefficients of a separable equation imply actual separability. -/
theorem isSeparable_of_rooted_frobenius_equation (f : F →+* E)
    (p n : ℕ) [ExpChar E p] [ExpChar Ω p] (P : F[X]) (hP : P.Separable)
    (Q : E[X]) (hQ : Q.map (iterateFrobenius E p n) = P.map f)
    (x : Ω) (hx : (P.map f).eval₂ (algebraMap E Ω) (x ^ p ^ n) = 0) :
    IsSeparable E x := by
  have hsep : Q.Separable := (Polynomial.separable_map (iterateFrobenius E p n)).mp
    (by rw [hQ]; exact hP.map)
  have hpow : aeval x Q ^ p ^ n = 0 := by
    rw [eval₂_pow_frobenius, hQ]
    exact hx
  have hroot : aeval x Q = 0 := (pow_eq_zero_iff (expChar_pow_pos Ω p n).ne').mp hpow
  exact hsep.of_dvd (minpoly.dvd E x hroot)

/-- A finite coefficient-root family produces the whole polynomial Frobenius identity. -/
theorem exists_polynomial_frobenius_root (f : F →+* E) (p n : ℕ) [ExpChar E p]
    (P : F[X]) (hcoeff : ∀ i ∈ P.support, ∃ b : E, b ^ p ^ n = f (P.coeff i)) :
    ∃ Q : E[X], Q.map (iterateFrobenius E p n) = P.map f := by
  classical
  let b (i : {i // i ∈ P.support}) : E := Classical.choose (hcoeff i.val i.property)
  have hb (i : {i // i ∈ P.support}) : b i ^ p ^ n = f (P.coeff i.val) :=
    Classical.choose_spec (hcoeff i.val i.property)
  refine ⟨∑ i ∈ P.support.attach, monomial i.val (b i), ?_⟩
  rw [Polynomial.map_sum]
  simp only [Polynomial.map_monomial, iterateFrobenius_def, hb]
  calc
    _ = ∑ i ∈ P.support, monomial i (f (P.coeff i)) := Finset.sum_attach _ _
    _ = P.map f := by
      conv_rhs => rw [← Polynomial.sum_monomial_eq P, Polynomial.sum_def]
      rw [Polynomial.map_sum]
      simp only [Polynomial.map_monomial]

end Equations

section Container

variable {F E L Ω : Type u} [Field F] [Field E] [Field L] [Field Ω]
  [Algebra F E] [Algebra F L] [Algebra F Ω] [Algebra E Ω] [IsScalarTower F E Ω]
  {ι : Type v} [Fintype ι]

/-- The actual field generated by the images of a finite basis over the new coefficient field. -/
def basisContainer (j : L →ₐ[F] Ω) (b : Module.Basis ι F L) : IntermediateField E Ω :=
  IntermediateField.adjoin E (Set.range fun i => j (b i))

/-- Actual basis expansion puts every image of the original field into the container. -/
theorem mem_basisContainer (j : L →ₐ[F] Ω) (b : Module.Basis ι F L) (x : L) :
    j x ∈ basisContainer (E := E) j b := by
  classical
  rw [← b.sum_repr x, map_sum]
  apply IntermediateField.sum_mem
  intro i _
  rw [map_smul, Algebra.smul_def]
  apply IntermediateField.mul_mem
  · rw [IsScalarTower.algebraMap_apply F E Ω]
    exact IntermediateField.algebraMap_mem _ _
  · exact IntermediateField.subset_adjoin E _ ⟨i, rfl⟩

/-- The actual embedding of the original field into the constructed finite-generator container. -/
def basisContainerMap (j : L →ₐ[F] Ω) (b : Module.Basis ι F L) :
    L →ₐ[F] basisContainer (E := E) j b where
  toFun x := ⟨j x, mem_basisContainer (E := E) j b x⟩
  map_one' := Subtype.ext (map_one j)
  map_mul' x y := Subtype.ext (map_mul j x y)
  map_zero' := Subtype.ext (map_zero j)
  map_add' x y := Subtype.ext (map_add j x y)
  commutes' a := Subtype.ext (j.commutes a)

omit [Algebra F E] [IsScalarTower F E Ω] [Fintype ι] in
/-- Separable basis images give an actual separable container. -/
theorem basisContainer_isSeparable (j : L →ₐ[F] Ω) (b : Module.Basis ι F L)
    (hb : ∀ i, IsSeparable E (j (b i))) :
    Algebra.IsSeparable E (basisContainer (E := E) j b) := by
  apply (IntermediateField.isSeparable_adjoin_iff_isSeparable E Ω).mpr
  rintro x ⟨i, rfl⟩
  exact hb i

omit [Algebra F E] [IsScalarTower F E Ω] in
/-- Its degree is finite by the actual finite list of algebraic generators. -/
theorem basisContainer_finiteDimensional (j : L →ₐ[F] Ω) (b : Module.Basis ι F L)
    (hb : ∀ i, IsSeparable E (j (b i))) :
    FiniteDimensional E (basisContainer (E := E) j b) := by
  exact IntermediateField.finiteDimensional_adjoin fun x hx => by
    obtain ⟨i, rfl⟩ := hx
    exact (hb i).isIntegral

end Container

section Descent

variable {A B K L M : Type u} [CommRing A] [IsNoetherianRing A]
  [CommRing B] [IsDomain B] [IsNoetherianRing B] [IsIntegrallyClosed B]
  [Algebra A B] [Module.Finite A B] [Field K] [Algebra B K] [IsFractionRing B K]
  [Field L] [Algebra A L] [Field M] [Algebra K M] [Algebra B M] [IsScalarTower B K M]
  [Algebra A M] [IsScalarTower A B M] [FiniteDimensional K M] [Algebra.IsSeparable K M]

include B K

/-- An injective map into an actual finite normal separable cover bounds integral closure.
The final arbitrary-field theorem constructs such a cover internally. -/
theorem finite_integralClosure_of_finite_normal_separable_cover (j : L →ₐ[A] M) :
    Module.Finite A (integralClosure A L) := by
  let C := integralClosure B M
  let : Module.Finite B C := IsIntegralClosure.finite B K M C
  let : Module.Finite A C := Module.Finite.trans B C
  let ψ : integralClosure A L →ₐ[A] C :=
    { toFun := fun x => ⟨j x.val, (x.property.map j).tower_top⟩
      map_one' := Subtype.ext (map_one j)
      map_mul' x y := Subtype.ext (map_mul j x.val y.val)
      map_zero' := Subtype.ext (map_zero j)
      map_add' x y := Subtype.ext (map_add j x.val y.val)
      commutes' a := Subtype.ext (j.commutes a) }
  have hψ : Function.Injective ψ := by
    intro x y hxy
    exact Subtype.ext (j.injective (congrArg (fun z : C => (z : M)) hxy))
  let : IsNoetherian A C := isNoetherian_of_isNoetherianRing_of_finite A C
  let : IsNoetherian A (integralClosure A L) :=
    isNoetherian_of_injective ψ.toLinearMap hψ
  exact Module.IsNoetherian.finite A (integralClosure A L)

end Descent

section PolynomialBase

variable (k : Type u) [Field k] (ι : Type v) [Finite ι]
  (L : Type (max u v)) [Field L]
  [Algebra (FractionRing (MvPolynomial ι k)) L] [Algebra (MvPolynomial ι k) L]
  [IsScalarTower (MvPolynomial ι k) (FractionRing (MvPolynomial ι k)) L]
  [FiniteDimensional (FractionRing (MvPolynomial ι k)) L]

set_option maxHeartbeats 1200000 in
/-- Actual finiteness over a polynomial base over an arbitrary field.
The finite normal separable cover is constructed here from coefficient roots. -/
theorem finite_integralClosure_polynomial :
    Module.Finite (MvPolynomial ι k) (integralClosure (MvPolynomial ι k) L) := by
  classical
  let A := MvPolynomial ι k
  let F := FractionRing A
  let : IsNoetherianRing A := Algebra.FiniteType.isNoetherianRing k A
  let : Algebra.IsAlgebraic F L := Algebra.IsAlgebraic.of_finite F L
  obtain ⟨p, hp⟩ := ExpChar.exists k
  let : ExpChar F p := expChar_of_injective_algebraMap (algebraMap k F).injective p
  let : ExpChar L p := expChar_of_injective_algebraMap (algebraMap F L).injective p
  let Fs := separableClosure F L
  let : ExpChar Fs p := expChar_of_injective_algebraMap (algebraMap F Fs).injective p
  let n := IsPurelyInseparable.exponent Fs L
  let ψ : L →+* Fs := IsPurelyInseparable.iterateFrobenius Fs L p (n := n) le_rfl
  have hψ (x : L) : algebraMap Fs L (ψ x) = x ^ p ^ n :=
    IsPurelyInseparable.algebraMap_iterateFrobenius Fs p le_rfl x
  let b := Module.finBasis F L
  let T : Finset F := Finset.univ.biUnion fun i =>
    (minpoly F (b i ^ p ^ n)).support.image (minpoly F (b i ^ p ^ n)).coeff
  obtain ⟨k', hk', hpoly, hnormal, hfield, hroots⟩ :=
    exists_finite_rational_root_cover (ι := ι) T p n
  let : FiniteDimensional k k' := hk'
  let B := MvPolynomial ι k'
  let K := FractionRing B
  let f : F →+* K := fractionRootMap k k' (p ^ n) (expChar_pow_pos k p n)
  let : Algebra A B := (polynomialRootMap k k' (p ^ n)).toAlgebra
  let : Module.Finite A B := hpoly
  let : FaithfulSMul A B := (faithfulSMul_iff_algebraMap_injective _ _).mpr
    (polynomialRootMap_injective k k' (p ^ n) (expChar_pow_pos k p n))
  let : Algebra A K := inferInstance
  let : FaithfulSMul A K := inferInstance
  let : IsScalarTower A B K := inferInstance
  let : Algebra F K := FractionRing.liftAlgebra A K
  let : IsScalarTower A F K := FractionRing.isScalarTower_liftAlgebra A K
  let : Module.Finite F K := hfield
  let : Algebra.IsAlgebraic F K := Algebra.IsAlgebraic.of_finite F K
  let : ExpChar K p := expChar_of_injective_algebraMap (algebraMap F K).injective p
  let Ω := AlgebraicClosure F
  let j : L →ₐ[F] Ω := IsAlgClosed.lift
  let e : K →ₐ[F] Ω := IsAlgClosed.lift
  let : Algebra K Ω := e.toRingHom.toAlgebra
  let : IsScalarTower F K Ω :=
    IsScalarTower.of_algebraMap_eq fun a => (e.commutes a).symm
  let : ExpChar Ω p := expChar_of_injective_algebraMap (algebraMap F Ω).injective p
  have hsep (i : Fin (Module.finrank F L)) : IsSeparable K (j (b i)) := by
    let P := minpoly F (b i ^ p ^ n)
    have hP : P.Separable := by
      change IsSeparable F (b i ^ p ^ n)
      rw [← hψ (b i)]
      exact (ψ (b i)).property
    have hcoeff (m : ℕ) (hm : m ∈ P.support) : ∃ r : K, r ^ p ^ n = f (P.coeff m) := by
      apply hroots
      exact Finset.mem_biUnion.mpr
        ⟨i, Finset.mem_univ _, Finset.mem_image.mpr ⟨m, hm, rfl⟩⟩
    obtain ⟨Q, hQ⟩ := exists_polynomial_frobenius_root f p n P hcoeff
    apply isSeparable_of_rooted_frobenius_equation f p n P hP Q hQ (j (b i))
    have hcomm : (algebraMap K Ω).comp f = algebraMap F Ω := by
      apply RingHom.ext
      intro a
      exact e.commutes a
    rw [Polynomial.eval₂_map, hcomm, ← map_pow]
    change aeval (j (b i ^ p ^ n)) (minpoly F (b i ^ p ^ n)) = 0
    rw [Polynomial.aeval_algHom_apply, minpoly.aeval, map_zero]
  let M := basisContainer (E := K) j b
  let : FiniteDimensional K M := basisContainer_finiteDimensional j b hsep
  let : Algebra.IsSeparable K M := basisContainer_isSeparable j b hsep
  let : IsNoetherianRing B := Algebra.FiniteType.isNoetherianRing k' B
  let : IsIntegrallyClosed B := hnormal
  let : Algebra B M := ((algebraMap K M).comp (algebraMap B K)).toAlgebra
  let : IsScalarTower B K M := IsScalarTower.of_algebraMap_eq' rfl
  let : Algebra A M := ((algebraMap F M).comp (algebraMap A F)).toAlgebra
  let : IsScalarTower A F M := IsScalarTower.of_algebraMap_eq' rfl
  let : IsScalarTower A K M := IsScalarTower.to₁₃₄ A F K M
  let : IsScalarTower A B M := IsScalarTower.to₁₂₄ A B K M
  exact finite_integralClosure_of_finite_normal_separable_cover (B := B) (K := K)
    ((basisContainerMap (E := K) j b).restrictScalars A)

end PolynomialBase

end DeJongAlterations.Algebra.IntegralClosureFiniteTypeSeparable
