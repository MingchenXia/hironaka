import DeJongAlterations.Geometry.AffineBlowup
import Mathlib.RingTheory.Localization.FractionRing

/-!
# Fraction coordinates on the native affine blowup

The actual homogeneous localization of the Rees algebra at `g*T` is identified with the
subalgebra generated by `a/g`, for `a` in the ideal, in the fraction field of a domain.
-/

open CategoryTheory AlgebraicGeometry Polynomial

noncomputable section

namespace DeJongAlterations

universe u

variable {R : Type u} [CommRing R]

/-- The genuine degree-zero homogeneous localization at the Rees element `g*T`. -/
abbrev reesHomogeneousChart (I : Ideal R) (g : R) (hg : g ∈ I) :=
  HomogeneousLocalization.Away (reesGrading I) (reesDegreeOne I g hg)

/-- Coefficients in the native homogeneous chart, using the true degree-zero identification. -/
def reesHomogeneousChartCoefficients (I : Ideal R) (g : R) (hg : g ∈ I) :
    R →+* reesHomogeneousChart I g hg :=
  (HomogeneousLocalization.fromZeroRingHom (reesGrading I)
    (.powers (reesDegreeOne I g hg))).comp (reesConstants I)

/-- The coefficient algebra structure on the native homogeneous chart. -/
instance reesHomogeneousChartAlgebra (I : Ideal R) (g : R) (hg : g ∈ I) :
    Algebra R (reesHomogeneousChart I g hg) :=
  (reesHomogeneousChartCoefficients I g hg).toAlgebra

variable [IsDomain R] (I : Ideal R) (g : R)

/-- The actual fraction subalgebra generated by `a/g`, for all `a ∈ I`. -/
def affineBlowupFractionChart : Subalgebra R (FractionRing R) :=
  Algebra.adjoin R (Set.range fun a : I =>
    algebraMap R (FractionRing R) a / algebraMap R (FractionRing R) g)

/-- Fractions of elements of `Iⁿ` belong to the fraction chart. -/
theorem idealPower_div_pow_mem_fractionChart (n : ℕ) {a : R} (ha : a ∈ I ^ n) :
    algebraMap R (FractionRing R) a / algebraMap R (FractionRing R) g ^ n ∈
      affineBlowupFractionChart I g := by
  induction n generalizing a with
  | zero => simpa only [pow_zero, div_one] using
      (affineBlowupFractionChart I g).algebraMap_mem a
  | succ n ih =>
    rw [pow_succ'] at ha
    refine Submodule.smul_induction_on ha ?_ ?_
    · intro a ha b hb
      change algebraMap R (FractionRing R) (a * b) /
        algebraMap R (FractionRing R) g ^ (n + 1) ∈ _
      rw [map_mul, pow_succ', mul_div_mul_comm]
      exact (affineBlowupFractionChart I g).mul_mem
        (Algebra.subset_adjoin (Set.mem_range_self (⟨a, ha⟩ : I))) (ih hb)
    · intro a b ha hb
      simpa only [map_add, add_div] using (affineBlowupFractionChart I g).add_mem ha hb

/-- Evaluation at `T=1/g` on the original Rees subalgebra. -/
def reesEvaluate : reesAlgebra I →ₐ[R] FractionRing R :=
  (Polynomial.aeval (algebraMap R (FractionRing R) g)⁻¹).comp (reesAlgebra I).val

variable (hg : g ∈ I)

/-- The denominator defining the chart evaluates to one. -/
theorem reesEvaluate_degreeOne (hg0 : g ≠ 0) :
    reesEvaluate I g (reesDegreeOne I g hg) = 1 := by
  change Polynomial.aeval (algebraMap R (FractionRing R) g)⁻¹ (monomial 1 g) = 1
  rw [Polynomial.aeval_monomial, pow_one]
  exact mul_inv_cancel₀ ((map_ne_zero_iff _ (IsFractionRing.injective R (FractionRing R))).2 hg0)

variable (hg0 : g ≠ 0)

/-- Evaluation extends to the full ordinary localization at `g*T`. -/
def reesChartEvaluationLift :
    Localization.Away (reesDegreeOne I g hg) →+* FractionRing R :=
  IsLocalization.Away.lift (reesDegreeOne I g hg)
    (g := (reesEvaluate I g).toRingHom)
    (by change IsUnit (reesEvaluate I g (reesDegreeOne I g hg))
        rw [reesEvaluate_degreeOne I g hg hg0]
        exact isUnit_one)

@[simp]
theorem reesChartEvaluationLift_algebraMap (p : reesAlgebra I) :
    reesChartEvaluationLift I g hg hg0
      (algebraMap (reesAlgebra I) (Localization.Away (reesDegreeOne I g hg)) p) =
      reesEvaluate I g p :=
  IsLocalization.Away.lift_eq _ _ _

/-- Evaluation on the native degree-zero localization is an `R`-algebra map. -/
def reesChartEvaluation : reesHomogeneousChart I g hg →ₐ[R] FractionRing R where
  __ := (reesChartEvaluationLift I g hg hg0).comp
    (algebraMap (reesHomogeneousChart I g hg) (Localization.Away (reesDegreeOne I g hg)))
  commutes' a := by
    change reesChartEvaluationLift I g hg hg0
      (algebraMap (reesAlgebra I) (Localization.Away (reesDegreeOne I g hg))
        (algebraMap R (reesAlgebra I) a)) = _
    rw [reesChartEvaluationLift_algebraMap]
    exact (reesEvaluate I g).commutes a

/-- Since `g*T` evaluates to one, a localized fraction evaluates to its numerator. -/
theorem reesChartEvaluationLift_mk (n : ℕ) (p : reesAlgebra I) :
    reesChartEvaluationLift I g hg hg0
      (Localization.mk p (⟨reesDegreeOne I g hg ^ n, n, rfl⟩ :
        Submonoid.powers (reesDegreeOne I g hg))) = reesEvaluate I g p := by
  rw [Localization.mk_eq_mk']
  have h := congrArg (reesChartEvaluationLift I g hg hg0)
    (IsLocalization.mk'_spec (Localization.Away (reesDegreeOne I g hg)) p
      (⟨reesDegreeOne I g hg ^ n, n, rfl⟩ : Submonoid.powers (reesDegreeOne I g hg)))
  simpa only [map_mul, reesChartEvaluationLift_algebraMap, map_pow,
    reesEvaluate_degreeOne I g hg hg0, one_pow, mul_one] using h

/-- Evaluation of a homogeneous Rees polynomial is its coefficient divided by `gⁿ`. -/
theorem reesEvaluate_of_homogeneous (n : ℕ) (p : reesAlgebra I)
    (hp : p ∈ reesGrading I n) :
    reesEvaluate I g p =
      algebraMap R (FractionRing R) ((p : R[X]).coeff n) /
        algebraMap R (FractionRing R) g ^ n := by
  change Polynomial.aeval (algebraMap R (FractionRing R) g)⁻¹ (p : R[X]) = _
  rw [(mem_reesGrading_iff I n p).mp hp, Polynomial.aeval_monomial, div_eq_mul_inv, inv_pow]
  simp

/-- Every native homogeneous fraction has its actual coefficient fraction as image. -/
theorem reesChartEvaluation_mk (n : ℕ) (p : reesAlgebra I)
    (hp : p ∈ reesGrading I (n • (1 : ℕ))) :
    reesChartEvaluation I g hg hg0
      (HomogeneousLocalization.Away.mk (reesGrading I) (reesDegreeOne_mem I g hg) n p hp) =
        algebraMap R (FractionRing R) ((p : R[X]).coeff n) /
          algebraMap R (FractionRing R) g ^ n := by
  change reesChartEvaluationLift I g hg hg0 (Localization.mk p _) = _
  rw [reesChartEvaluationLift_mk]
  exact reesEvaluate_of_homogeneous I g n p (by simpa only [smul_eq_mul, mul_one] using hp)

/-- Evaluation has trivial kernel on the genuine homogeneous chart. -/
theorem reesChartEvaluation_eq_zero_iff (z : reesHomogeneousChart I g hg) :
    reesChartEvaluation I g hg hg0 z = 0 ↔ z = 0 := by
  constructor
  · intro hz
    obtain ⟨n, p, hp, rfl⟩ := HomogeneousLocalization.Away.mk_surjective
      (reesGrading I) (reesDegreeOne_mem I g hg) z
    rw [reesChartEvaluation_mk] at hz
    have hgn : algebraMap R (FractionRing R) g ^ n ≠ 0 :=
      pow_ne_zero _ ((map_ne_zero_iff _ (IsFractionRing.injective R (FractionRing R))).2 hg0)
    have hc : algebraMap R (FractionRing R) ((p : R[X]).coeff n) = 0 :=
      (div_eq_zero_iff.mp hz).resolve_right hgn
    have hc0 : (p : R[X]).coeff n = 0 :=
      (map_eq_zero_iff _ (IsFractionRing.injective R (FractionRing R))).mp hc
    have hp0 : p = 0 := by
      apply Subtype.ext
      rw [(mem_reesGrading_iff I n p).mp (by simpa only [smul_eq_mul, mul_one] using hp),
        hc0, map_zero]
      rfl
    apply HomogeneousLocalization.val_injective
    simp only [HomogeneousLocalization.Away.val_mk, hp0, Localization.mk_zero,
      HomogeneousLocalization.val_zero]
  · rintro rfl
    exact map_zero _

set_option backward.isDefEq.respectTransparency.types false in
/-- Distinct native homogeneous fractions remain distinct in the fraction field. -/
theorem reesChartEvaluation_injective : Function.Injective (reesChartEvaluation I g hg hg0) := by
  intro z w hzw
  apply sub_eq_zero.mp
  apply (reesChartEvaluation_eq_zero_iff I g hg hg0 (z - w)).mp
  calc
    reesChartEvaluation I g hg hg0 (z - w) =
        reesChartEvaluation I g hg hg0 z - reesChartEvaluation I g hg hg0 w :=
      map_sub (reesChartEvaluation I g hg hg0) z w
    _ = 0 := by rw [hzw, sub_self]

set_option backward.isDefEq.respectTransparency.types false in
/-- The image of the genuine homogeneous chart is exactly the algebra generated by ideal ratios. -/
theorem reesChartEvaluation_range :
    (reesChartEvaluation I g hg hg0).range = affineBlowupFractionChart I g := by
  apply le_antisymm
  · rintro _ ⟨z, rfl⟩
    obtain ⟨n, p, hp, rfl⟩ := HomogeneousLocalization.Away.mk_surjective
      (reesGrading I) (reesDegreeOne_mem I g hg) z
    change reesChartEvaluation I g hg hg0
      (HomogeneousLocalization.Away.mk (reesGrading I) (reesDegreeOne_mem I g hg) n p hp) ∈ _
    rw [reesChartEvaluation_mk]
    exact idealPower_div_pow_mem_fractionChart I g n (p.2 n)
  · apply Algebra.adjoin_le
    rintro _ ⟨a, rfl⟩
    refine ⟨HomogeneousLocalization.Away.mk (reesGrading I) (reesDegreeOne_mem I g hg)
      1 (reesDegreeOne I a a.2) (by simpa using reesDegreeOne_mem I a a.2), ?_⟩
    change reesChartEvaluation I g hg hg0
      (HomogeneousLocalization.Away.mk (reesGrading I) (reesDegreeOne_mem I g hg)
        1 (reesDegreeOne I a a.2) _) = _
    rw [reesChartEvaluation_mk]
    change algebraMap R (FractionRing R) ((monomial 1 (a : R)).coeff 1) /
      algebraMap R (FractionRing R) g ^ 1 = _
    simp

/-- The native degree-zero homogeneous localization is the actual fraction-chart algebra. -/
def reesChartFractionEquiv :
    reesHomogeneousChart I g hg ≃ₐ[R] affineBlowupFractionChart I g :=
  (AlgEquiv.ofInjective (reesChartEvaluation I g hg hg0)
    (reesChartEvaluation_injective I g hg hg0)).trans
      (Subalgebra.equivOfEq _ _ (reesChartEvaluation_range I g hg hg0))

/-- The ring equivalence preserves evaluation as an element of the fraction field. -/
theorem coe_reesChartFractionEquiv (z : reesHomogeneousChart I g hg) :
    (reesChartFractionEquiv I g hg hg0 z : FractionRing R) =
      reesChartEvaluation I g hg hg0 z := rfl

/-- The actual fraction-field value of every homogeneous fraction under the ring equivalence. -/
theorem reesChartFractionEquiv_mk (n : ℕ) (p : reesAlgebra I)
    (hp : p ∈ reesGrading I (n • (1 : ℕ))) :
    (reesChartFractionEquiv I g hg hg0
      (HomogeneousLocalization.Away.mk (reesGrading I) (reesDegreeOne_mem I g hg) n p hp) :
        FractionRing R) = algebraMap R (FractionRing R) ((p : R[X]).coeff n) /
          algebraMap R (FractionRing R) g ^ n :=
  (coe_reesChartFractionEquiv I g hg hg0 _).trans (reesChartEvaluation_mk I g hg hg0 n p hp)

/-- Every genuine degree-one ratio maps to the original ideal ratio `a/g`. -/
theorem reesChartFractionEquiv_generator (a : R) (ha : a ∈ I) :
    (reesChartFractionEquiv I g hg hg0
      (HomogeneousLocalization.Away.mk (reesGrading I) (reesDegreeOne_mem I g hg)
        1 (reesDegreeOne I a ha) (by simpa using reesDegreeOne_mem I a ha)) : FractionRing R) =
      algebraMap R (FractionRing R) a / algebraMap R (FractionRing R) g := by
  rw [reesChartFractionEquiv_mk]
  simp [reesDegreeOne]

/-- The actual basic open of the native blowup defined by `g*T`. -/
def affineBlowupChartOpen : (affineBlowup I).Opens :=
  Proj.basicOpen (reesGrading I) (reesDegreeOne I g hg)

/-- The native Proj affine chart is the spectrum of its actual homogeneous localization. -/
def affineBlowupHomogeneousChartIso :
    (affineBlowupChartOpen I g hg).toScheme ≅
      Spec (CommRingCat.of (reesHomogeneousChart I g hg)) :=
  Proj.basicOpenIsoSpec (reesGrading I) (reesDegreeOne I g hg)
    (reesDegreeOne_mem I g hg) (by decide : 0 < (1 : ℕ))

/-- The actual basic open of the native blowup is the spectrum of `R[I/g]`. -/
def affineBlowupChartIso :
    (affineBlowupChartOpen I g hg).toScheme ≅
      Spec (CommRingCat.of (affineBlowupFractionChart I g)) :=
  (affineBlowupHomogeneousChartIso I g hg).trans
    (Scheme.Spec.mapIso (reesChartFractionEquiv I g hg hg0).toRingEquiv.toCommRingCatIso.symm.op)

/-- The genuine chart embedding from the spectrum of the actual fraction subalgebra. -/
def affineBlowupChartInclusion :
    Spec (CommRingCat.of (affineBlowupFractionChart I g)) ⟶ affineBlowup I :=
  Spec.map (reesChartFractionEquiv I g hg hg0).toRingEquiv.toCommRingCatIso.hom ≫
    Proj.awayι (reesGrading I) (reesDegreeOne I g hg)
      (reesDegreeOne_mem I g hg) (by decide : 0 < (1 : ℕ))

set_option backward.isDefEq.respectTransparency false in
/-- The chart inclusion is an actual open immersion. -/
instance affineBlowupChartInclusion_isOpenImmersion :
    IsOpenImmersion (affineBlowupChartInclusion I g hg hg0) := by
  dsimp only [affineBlowupChartInclusion, affineBlowup]
  infer_instance

set_option backward.isDefEq.respectTransparency.types false in
/-- The chart embedding preserves the canonical structure morphisms to `Spec R`. -/
theorem affineBlowupChartInclusion_structure :
    affineBlowupChartInclusion I g hg hg0 ≫ affineBlowupStructure I =
      Spec.map (CommRingCat.ofHom (algebraMap R (affineBlowupFractionChart I g))) := by
  simp only [affineBlowupChartInclusion, affineBlowupStructure, affineBlowup, Category.assoc,
    Proj.awayι_toSpecZero_assoc]
  rw [← Spec.map_comp, ← Spec.map_comp]
  congr 1
  ext a : 2
  change reesChartFractionEquiv I g hg hg0
    (algebraMap R (reesHomogeneousChart I g hg) a) =
      algebraMap R (affineBlowupFractionChart I g) a
  exact (reesChartFractionEquiv I g hg hg0).commutes a

end DeJongAlterations
