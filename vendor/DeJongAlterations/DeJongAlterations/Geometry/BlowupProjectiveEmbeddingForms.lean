import DeJongAlterations.Geometry.BlowupProjectiveEmbeddingAffine
import DeJongAlterations.Geometry.BlowupCartier

/-!
# Actual affine ideals generated by pulled-back homogeneous forms

Native ideal-sheaf pullback on any affine source/target pair is computed by
actual extension along appLE. Applied to the original homogeneous quotient
ideal, the dehomogenized forms generate precisely its pulled-back ideal.
-/

open AlgebraicGeometry CategoryTheory MvPolynomial

noncomputable section

namespace DeJongAlterations.Geometry.BlowupProjectiveEmbedding

open ProjectiveIdeal SpecIdealSheaf BlowupCartier

universe u

attribute [local instance] MvPolynomial.gradedAlgebra

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

variable {X Y : Scheme.{u}}

/-- Native pullback on arbitrary affine opens is actual extension along appLE. -/
theorem ideal_comap_affine (E : Y.IdealSheafData) (f : X ⟶ Y)
    (U : X.affineOpens) (V : Y.affineOpens) (h : U.1 ≤ f ⁻¹ᵁ V.1) :
    (E.comap f).ideal U = (E.ideal V).map (f.appLE V.1 U.1 h).hom := by
  apply (specIdealSheafEquiv Γ(X, U.1)).symm.injective
  change specIdealSheaf _ ((E.comap f).ideal U) = specIdealSheaf _ _
  rw [← comap_fromSpec, ← specIdealSheaf_comap, ← comap_fromSpec,
    ← Scheme.IdealSheafData.comap_comp, ← Scheme.IdealSheafData.comap_comp]
  exact congrArg E.comap (V.2.SpecMap_appLE_fromSpec f U.2 h).symm

variable {R : Type u} [CommRing R] {n : ℕ} {σ : Type u}

/-- A coordinate open with its actual affine structure. -/
def coordinateAffineOpen (i : Fin (n + 1)) : (projectiveSpace R n).affineOpens :=
  ⟨nativeCoordinateOpen i, nativeCoordinateOpen_isAffine i⟩

/-- Dehomogenized generators give the full original quotient ideal on a native chart. -/
theorem coordinateIdeal_span (J : HomogeneousIdeal (ProjectiveGrading R n))
    (F : σ → MvPolynomial (Fin (n + 1)) R) (hspan : Ideal.span (Set.range F) = J.toIdeal)
    (i : Fin (n + 1)) :
    (GradedQuotient.quotientIdealSheaf (ProjectiveGrading R n) J).ideal
        (coordinateAffineOpen i) = Ideal.span (Set.range (fun a => nativeFormSection i (F a))) := by
  have H := congrArg (Ideal.map (nativeCoordinateSectionsIso (R := R) i).hom.hom)
    (homogeneousQuotient_coordinateSectionIdeal J i)
  rw [Ideal.map_comap_of_surjective _ (ConcreteCategory.bijective_of_isIso
    (nativeCoordinateSectionsIso (R := R) i).hom).2,
    Ideal.map_map, ← hspan, Ideal.map_span, ← Set.range_comp] at H
  exact H

/-- The actual coefficient function obtained by restricting a homogeneous form along the map. -/
def pulledForm (j : X ⟶ projectiveSpace R n) (U : X.affineOpens)
    (i : Fin (n + 1)) (h : U.1 ≤ j ⁻¹ᵁ nativeCoordinateOpen i)
    (F : MvPolynomial (Fin (n + 1)) R) : Γ(X, U.1) :=
  j.appLE (nativeCoordinateOpen i) U.1 h (nativeFormSection i F)

/-- These actual pulled-back forms generate the entire pulled-back native ideal. -/
theorem pulledForm_span (j : X ⟶ projectiveSpace R n) (U : X.affineOpens)
    (J : HomogeneousIdeal (ProjectiveGrading R n))
    (F : σ → MvPolynomial (Fin (n + 1)) R) (hspan : Ideal.span (Set.range F) = J.toIdeal)
    (i : Fin (n + 1)) (h : U.1 ≤ j ⁻¹ᵁ nativeCoordinateOpen i) :
    Ideal.span (Set.range (fun a => pulledForm j U i h (F a))) =
      ((GradedQuotient.quotientIdealSheaf (ProjectiveGrading R n) J).comap j).ideal U := by
  rw [ideal_comap_affine _ j U (coordinateAffineOpen i) h, coordinateIdeal_span J F hspan i,
    Ideal.map_span, ← Set.range_comp]
  rfl

/-- Germs of the restricted form use the actual stalk map of the original morphism. -/
theorem pulledForm_germ (j : X ⟶ projectiveSpace R n) (U : X.affineOpens)
    (i : Fin (n + 1)) (h : U.1 ≤ j ⁻¹ᵁ nativeCoordinateOpen i)
    (F : MvPolynomial (Fin (n + 1)) R) (x : X) (hx : x ∈ U.1) :
    X.presheaf.germ U.1 x hx (pulledForm j U i h F) =
      j.stalkMap x ((projectiveSpace R n).presheaf.germ
        (nativeCoordinateOpen i) (j x) (h hx) (nativeFormSection i F)) := by
  simp only [pulledForm, Scheme.Hom.appLE, CommRingCat.comp_apply,
    X.presheaf.germ_res_apply, Scheme.Hom.germ_stalkMap_apply]

/-- The two actual trivializations differ by the actual ratio to the common degree. -/
theorem pulledForm_ratio (j : X ⟶ projectiveSpace R n) (U : X.affineOpens)
    (i k : Fin (n + 1)) (hi : U.1 ≤ j ⁻¹ᵁ nativeCoordinateOpen i)
    (hk : U.1 ≤ j ⁻¹ᵁ nativeCoordinateOpen k)
    {F : MvPolynomial (Fin (n + 1)) R} {d : ℕ} (hF : F.IsHomogeneous d) :
    pulledForm j U k hk F = pulledForm j U i hi F *
      (pulledForm j U k hk (MvPolynomial.X i)) ^ d := by
  apply TopCat.Presheaf.section_ext X.sheaf U.1
  intro x hx
  change X.presheaf.germ U.1 x hx (pulledForm j U k hk F) =
    X.presheaf.germ U.1 x hx (pulledForm j U i hi F *
      (pulledForm j U k hk (MvPolynomial.X i)) ^ d)
  rw [map_mul, map_pow, pulledForm_germ, pulledForm_germ, pulledForm_germ]
  simpa only [NativeProjectiveScheme, projectiveSpace, ProjectiveGrading,
    projectiveSpaceGrading, map_mul, map_pow] using congrArg (j.stalkMap x)
    (nativeFormSection_germ_ratio i k (j x) (hi hx) (hk hx) hF)

/-- The transition ratio is a genuine unit on the entire common affine open. -/
theorem pulledForm_ratio_isUnit (j : X ⟶ projectiveSpace R n) (U : X.affineOpens)
    (i k : Fin (n + 1)) (hi : U.1 ≤ j ⁻¹ᵁ nativeCoordinateOpen i)
    (hk : U.1 ≤ j ⁻¹ᵁ nativeCoordinateOpen k) :
    IsUnit (pulledForm j U k hk (MvPolynomial.X i)) := by
  apply AlgebraicGeometry.RingedSpace.isUnit_of_isUnit_germ X.toSheafedSpace U.1
  intro x hx
  rw [pulledForm_germ]
  exact ((nativeFormSection_X_unit_iff k i (j x) (hk hx)).mpr (hi hx)).map
    (j.stalkMap x).hom

end DeJongAlterations.Geometry.BlowupProjectiveEmbedding
