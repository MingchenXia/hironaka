import DeJongAlterations.Algebra.BlowupChartIdeal
import DeJongAlterations.Geometry.SpecIdealSheaf
import DeJongAlterations.Geometry.CartierLocality
import DeJongAlterations.Geometry.AffineBlowupCover
import DeJongAlterations.Geometry.AffineBlowupAlteration
import DeJongAlterations.Geometry.AffineBlowupProjective

/-!
# The actual pulled-back blowup ideal

The native ideal-sheaf pullback restricts to the principal non-zero-divisor
ideal on every actual nonzero fraction chart. No reduced-support replacement
is used for this ideal-sheaf equality.
-/

open AlgebraicGeometry CategoryTheory
open DeJongAlterations.Geometry.SpecIdealSheaf

noncomputable section

namespace DeJongAlterations

universe u

set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- A genuine regular principal coordinate ideal defines an effective Cartier divisor. -/
theorem isEffectiveCartierDivisor_specIdealSheaf_span {S : Type u} [CommRing S]
    (t : S) (ht : IsRegular t) :
    IsEffectiveCartierDivisor (specIdealSheaf S (Ideal.span {t})) := by
  intro x
  let e := (Scheme.ΓSpecIso (CommRingCat.of S)).symm.commRingCatIsoToRingEquiv
  let φ : S →+* Γ(Spec (.of S), ⊤) := (Scheme.ΓSpecIso (CommRingCat.of S)).inv.hom
  refine ⟨⟨⊤, isAffineOpen_top _⟩, trivial, φ t,
    Geometry.CartierLocality.isRegular_ringEquiv e ht, ?_⟩
  rw [specIdealSheaf_ideal_top, Ideal.map_span, Set.image_singleton]

/-- The exceptional ideal is the actual scheme-theoretic pullback of the original ideal. -/
def affineBlowupExceptionalIdeal {R : Type u} [CommRing R] (I : Ideal R) :
    (affineBlowup I).IdealSheafData :=
  (specIdealSheaf R I).comap (affineBlowupStructure I)

variable {R : Type u} [CommRing R] [IsDomain R]

/-- On the genuine fraction chart, the actual exceptional ideal is generated by `g`. -/
theorem affineBlowupExceptionalIdeal_comap_chart (I : Ideal R) (g : R)
    (hg : g ∈ I) (hg0 : g ≠ 0) :
    (affineBlowupExceptionalIdeal I).comap (affineBlowupChartInclusion I g hg hg0) =
      specIdealSheaf (affineBlowupFractionChart I g)
        (Ideal.span {algebraMap R (affineBlowupFractionChart I g) g}) := by
  rw [affineBlowupExceptionalIdeal, ← Scheme.IdealSheafData.comap_comp,
    affineBlowupChartInclusion_structure, specIdealSheaf_comap,
    affineBlowupFractionChart_mapIdeal I g hg hg0]

/-- The actual pulled-back ideal has a Cartier equation on every nonzero native fraction chart. -/
theorem affineBlowupExceptionalIdeal_chart_isEffectiveCartier (I : Ideal R) (g : R)
    (hg : g ∈ I) (hg0 : g ≠ 0) :
    IsEffectiveCartierDivisor
      ((affineBlowupExceptionalIdeal I).comap (affineBlowupChartInclusion I g hg hg0)) := by
  rw [affineBlowupExceptionalIdeal_comap_chart I g hg hg0]
  exact isEffectiveCartierDivisor_specIdealSheaf_span _
    (affineBlowupFractionChart_generator_isRegular I g hg0)

/-- The original ideal becomes an actual effective Cartier ideal on the whole native blowup. -/
theorem affineBlowupExceptionalIdeal_isEffectiveCartier (I : Ideal R) :
    IsEffectiveCartierDivisor (affineBlowupExceptionalIdeal I) := by
  apply Geometry.CartierLocality.of_openCover _ (affineBlowupFractionOpenCover I)
  intro a
  exact affineBlowupExceptionalIdeal_chart_isEffectiveCartier I a.val a.val.property a.property

set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- A proper closed subset of an affine Noetherian integral scheme becomes the support of an
effective Cartier divisor under an internally constructed projective alteration. -/
theorem exists_projective_alteration_cartierPreimage [IsNoetherianRing R]
    (Z : TopologicalSpace.Closeds (Spec (CommRingCat.of R))) (hZ : Z ≠ ⊤) :
    ∃ (Y : Scheme.{u}) (f : Y ⟶ Spec (CommRingCat.of R)) (D : Y.IdealSheafData),
      IsProjectiveOver f ∧ IsAlteration f ∧ IsEffectiveCartierDivisor D ∧
        D.support = Z.preimage f.continuous := by
  let I := specIdealSheafEquiv R (Scheme.IdealSheafData.vanishingIdeal Z)
  have hI : I ≠ ⊥ := by
    intro hI
    have hD : Scheme.IdealSheafData.vanishingIdeal Z =
        (⊥ : (Spec (CommRingCat.of R)).IdealSheafData) := by
      apply (specIdealSheafEquiv R).injective
      change I = specIdealSheafEquiv R ⊥
      rw [OrderIso.map_bot]
      exact hI
    have hS := congrArg (fun J : (Spec (CommRingCat.of R)).IdealSheafData =>
      (J.support : Set (Spec (CommRingCat.of R)))) hD
    apply hZ
    apply SetLike.coe_injective
    simpa only [Scheme.IdealSheafData.coe_support_vanishingIdeal,
      Scheme.IdealSheafData.support_bot] using hS
  have hfg : I.FG := I.fg_of_isNoetherianRing
  refine ⟨affineBlowup I, affineBlowupStructure I, affineBlowupExceptionalIdeal I,
    affineBlowupStructure_isProjective I hfg, affineBlowupStructure_isAlteration I hI hfg,
    affineBlowupExceptionalIdeal_isEffectiveCartier I, ?_⟩
  rw [affineBlowupExceptionalIdeal, Scheme.IdealSheafData.support_comap]
  congr 1
  change (specIdealSheaf R (specIdealSheafEquiv R
    (Scheme.IdealSheafData.vanishingIdeal Z))).support = Z
  rw [specIdealSheaf_specIdealSheafEquiv]
  exact SetLike.coe_injective (Scheme.IdealSheafData.coe_support_vanishingIdeal Z)

end DeJongAlterations
