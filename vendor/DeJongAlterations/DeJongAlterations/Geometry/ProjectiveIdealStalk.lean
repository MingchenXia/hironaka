import Mathlib.AlgebraicGeometry.IdealSheaf.Basic
import Mathlib.AlgebraicGeometry.Stalk
/- Reused from EnvelopeProperty/Berkovich/SchemeIdealStalk.lean; SHA256 8e5224d9f27c113922b71a43a191dbf89c1f4f2685374b4f1703a3fa82010e0b. Prefix ends before the zero-ideal-sheaf arithmetic declarations. -/


/-!
# Actual stalk ideals of genuine scheme ideal-sheaf data

Take the supremum of every actual affine-neighborhood germ image. The real
localization law and genuine affine refinement prove that it equals ANY
affine-neighborhood image. The retained prefix supplies the genuine germ
membership API needed for projective-ideal representation. No stalk
equality, finite cover or Noetherian hypothesis is assumed.
-/

open CategoryTheory TopologicalSpace AlgebraicGeometry Opposite

universe u
set_option backward.isDefEq.respectTransparency false
noncomputable section

namespace AlgebraicGeometry.Scheme.IdealSheafData

variable {X : Scheme.{u}}

/-- The actual ideal in a scheme stalk generated by genuine affine ideal-sheaf section germs. -/
def stalkIdeal (I : X.IdealSheafData) (x : X) : Ideal (X.presheaf.stalk x) :=
  ⨆ (U : X.affineOpens) (hx : x ∈ U.1), (I.ideal U).map (X.presheaf.germ U x hx).hom

/-- Actual localization compatibility identifies genuine affine germ-images along an affine inclusion. -/
theorem affineGermIdeal_eq_of_le (I : X.IdealSheafData) {U V : X.affineOpens}
    (h : U ≤ V) (x : X) (hx : x ∈ U.1) :
    (I.ideal U).map (X.presheaf.germ U x hx).hom =
      (I.ideal V).map (X.presheaf.germ V x (h hx)).hom := by
  rw [← I.map_ideal h, Ideal.map_map, ← CommRingCat.hom_comp]
  exact congrArg (fun φ : Γ(X, V) ⟶ X.presheaf.stalk x => Ideal.map φ.hom (I.ideal V))
    (X.presheaf.germ_res (homOfLE (show U.1 ≤ V.1 from h)) x hx)

/-- Genuine affine refinement makes every affine germ-image at a point equal, without an assumed stalk certificate. -/
theorem affineGermIdeal_eq (I : X.IdealSheafData) (U V : X.affineOpens)
    (x : X) (hU : x ∈ U.1) (hV : x ∈ V.1) :
    (I.ideal U).map (X.presheaf.germ U x hU).hom =
      (I.ideal V).map (X.presheaf.germ V x hV).hom := by
  obtain ⟨W, hW, hxW, hWUV⟩ := exists_isAffineOpen_mem_and_subset
    (X := X) (U := U.1 ⊓ V.1) (x := x) ⟨hU, hV⟩
  let W' : X.affineOpens := ⟨W, hW⟩
  exact (affineGermIdeal_eq_of_le I (U := W') (V := U) (hWUV.trans inf_le_left) x hxW).symm.trans
    (affineGermIdeal_eq_of_le I (U := W') (V := V) (hWUV.trans inf_le_right) x hxW)

/-- The intrinsic all-affine germ ideal equals the image from ANY genuine affine neighborhood. -/
theorem stalkIdeal_eq_affine (I : X.IdealSheafData) (x : X) (U : X.affineOpens) (hx : x ∈ U.1) :
    stalkIdeal I x = (I.ideal U).map (X.presheaf.germ U x hx).hom := by
  apply le_antisymm
  · exact iSup_le fun V => iSup_le fun hV => (affineGermIdeal_eq I V U x hV hx).le
  · exact le_iSup_of_le U (le_iSup_of_le hx le_rfl)

/-- Genuine section germs of the ideal belong to its intrinsic stalk ideal. -/
theorem germ_mem_stalkIdeal (I : X.IdealSheafData) (x : X) (U : X.affineOpens) (hx : x ∈ U.1)
    {s : Γ(X, U)} (hs : s ∈ I.ideal U) : X.presheaf.germ U x hx s ∈ stalkIdeal I x := by
  rw [stalkIdeal_eq_affine I x U hx]
  exact Ideal.mem_map_of_mem _ hs


end AlgebraicGeometry.Scheme.IdealSheafData
