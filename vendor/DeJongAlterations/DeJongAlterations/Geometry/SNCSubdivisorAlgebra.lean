import DeJongAlterations.Algebra.RegularSmoothConverseKernel
import Mathlib.RingTheory.Ideal.KrullsHeightTheorem
import Mathlib.RingTheory.Ideal.Quotient.Basic

/-!
# Genuine local equations for regular codimension-one closed immersions

The actual kernel parameters of a regular-local surjection produce the
principal prime equation. Height, rather than a supplied principality or
Cartier certificate, forces that equation to generate the full kernel.
-/

open IsLocalRing
open scoped nonZeroDivisors

noncomputable section

namespace DeJongAlterations.Geometry.SNCSubdivisorAlgebra

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

/-- A genuine nonzero height-one regular-local kernel is generated by an actual regular cotangent parameter. -/
theorem exists_regular_kernel_generator
    {R S : Type*} [CommRing R] [CommRing S]
    [IsRegularLocalRing R] [IsRegularLocalRing S]
    (f : R →+* S) (hf : Function.Surjective f)
    (hne : RingHom.ker f ≠ ⊥) (hheight : (RingHom.ker f).height ≤ 1) :
    ∃ t : R, t ∈ maximalIdeal R ∧ t ∉ maximalIdeal R ^ 2 ∧
      IsRegular t ∧ Ideal.span {t} = RingHom.ker f := by
  let : IsDomain R := Algebra.RegularLocalDomain.isDomain_of_isRegularLocalRing R
  obtain ⟨n, t, hli, hspan⟩ :=
    Algebra.RegularSmoothConverseKernel.exists_kernel_span_independent_parameters f hf
  cases n with
  | zero =>
    apply (hne ?_).elim
    rw [← hspan]
    simp
  | succ n =>
    let a := t 0
    have ha2 : (a : R) ∉ maximalIdeal R ^ 2 := by
      intro h
      exact hli.ne_zero 0 (((maximalIdeal R).toCotangent_eq_zero a).mpr h)
    have hane : (a : R) ≠ 0 := by
      intro h
      apply ha2
      rw [h]
      exact Ideal.zero_mem _
    have haunit : ¬ IsUnit (a : R) := by
      simpa only [mem_maximalIdeal, mem_nonunits_iff] using a.property
    let Q : Ideal R := Ideal.span {(a : R)}
    let : IsRegularLocalRing (R ⧸ Q) :=
      Algebra.RegularQuotient.isRegularLocalRing_quotient_parameter R a a.property ha2
    let : IsDomain (R ⧸ Q) := Algebra.RegularLocalDomain.isDomain_of_isRegularLocalRing _
    let : Q.IsPrime := (Ideal.Quotient.isDomain_iff_prime Q).mp inferInstance
    have hQ : Q.height = 1 :=
      Ideal.height_span_singleton_eq_one_of_mem_nonZeroDivisors
        (mem_nonZeroDivisors_iff_ne_zero.mpr hane) haunit
    have hle : Q ≤ RingHom.ker f := by
      rw [← hspan]
      exact Ideal.span_mono (Set.singleton_subset_iff.mpr ⟨0, rfl⟩)
    have heq : Q = RingHom.ker f :=
      Q.eq_of_le_of_height_le hle (hheight.trans hQ.symm.le)
    exact ⟨a, a.property, ha2,
      ⟨fun _ _ h => mul_left_cancel₀ hane h, fun _ _ h => mul_right_cancel₀ hane h⟩, heq⟩

end DeJongAlterations.Geometry.SNCSubdivisorAlgebra
