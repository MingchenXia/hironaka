import DeJongAlterations.Algebra.NodeCompletionOrigin
import DeJongAlterations.Geometry.CompletedLocalRingAffine

/-!
# The actual completed local ring of the split polynomial node

For every field K, the native scheme stalk at the actual rational origin of
Spec(K[u,v]/(uv)) completes to the literal formal node K[[u,v]]/(uv).
The coefficient map is the actual structural Spec map. Both actual polynomial
coordinates are carried to the corresponding native formal coordinate classes.
This is a computation for the split node, not classification of arbitrary nodes.
-/

noncomputable section

open AlgebraicGeometry CategoryTheory

namespace DeJongAlterations.Geometry.NodeCompletion

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

universe u

variable (K : Type u) [Field K]

open Algebra.NodeCompletion

/-- The actual scheme of the literal polynomial node. -/
abbrev nodeScheme : Scheme.{u} := Spec (.of (Node K))

/-- The actual rational origin, defined by the ideal generated by the two coordinates. -/
def originPoint : nodeScheme K := ⟨originIdeal K, inferInstance⟩

/-- The actual structural morphism to the specified ground field. -/
def structureMap : nodeScheme K ⟶ Spec (.of K) :=
  Spec.map (CommRingCat.ofHom (algebraMap K (Node K)))

/-- The native completed scheme stalk is the literal formal node, over the actual ground field. -/
def completedLocalRingEquiv :
    letI := Scheme.completedLocalRingAlgebra (structureMap K) (originPoint K)
    (nodeScheme K).completedLocalRing (originPoint K) ≃ₐ[K] FormalNode K := by
  letI := Scheme.completedLocalRingAlgebra (structureMap K) (originPoint K)
  exact (Scheme.completedLocalRingSpecAlgEquiv K (Node K) (originPoint K)).trans
    (localNodeCompletionEquiv K)

/-- The isomorphism preserves the actual structural coefficient map. -/
@[simp]
theorem completedLocalRingEquiv_coefficient (a : K) :
    completedLocalRingEquiv K
      (@algebraMap K ((nodeScheme K).completedLocalRing (originPoint K)) _ _
        (Scheme.completedLocalRingAlgebra (structureMap K) (originPoint K)) a) =
      algebraMap K (FormalNode K) a := by
  let := Scheme.completedLocalRingAlgebra (structureMap K) (originPoint K)
  exact (completedLocalRingEquiv K).commutes a

/-- Both actual polynomial coordinate germs become their respective formal coordinate classes. -/
@[simp]
theorem completedLocalRingEquiv_coordinate (i : Fin 2) :
    completedLocalRingEquiv K
      ((nodeScheme K).toCompletedLocalRing (originPoint K)
        (StructureSheaf.toStalk (Node K) (originPoint K)
          (Ideal.Quotient.mk (nodeIdeal K) (MvPolynomial.X i)))) =
      Ideal.Quotient.mk (formalNodeIdeal K) (MvPowerSeries.X i) := by
  change localNodeCompletionEquiv K
    (Scheme.completedLocalRingSpecAlgEquiv K (Node K) (originPoint K)
      ((nodeScheme K).toCompletedLocalRing (originPoint K)
        (StructureSheaf.toStalk (Node K) (originPoint K)
          (Ideal.Quotient.mk (nodeIdeal K) (MvPolynomial.X i))))) = _
  rw [Scheme.completedLocalRingSpecAlgEquiv_coefficient]
  exact localNodeCompletionEquiv_coordinate K i

end DeJongAlterations.Geometry.NodeCompletion
