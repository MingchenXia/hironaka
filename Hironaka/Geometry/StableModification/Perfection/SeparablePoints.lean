import Hironaka.Geometry.StableModification.Perfection.Field
import Mathlib.FieldTheory.SeparableClosure

/-!
# Separable residue fields after a purely inseparable base change

Blueprint chapter `sm-dj-perfection`, node `lem:sm-dj-perfection-separable-points` (plan PL (5);
new route, not in de Jong 1996).

Let `K ⊆ N` be fields and `Ω` an intermediate field which is perfect and algebraic over `K`
(e.g. `Ω = K^{perf}`). Let `κ = K(T) ⊆ N` be generated by a finite set `T` of elements algebraic
over `Ω` (e.g. the residue field of a closed point, finite over some `E₁ ≤ Ω`). Since `Ω` is
perfect, every `t ∈ T` is separable over `Ω`; the finitely many coefficients of its minimal
polynomial over `Ω` lie in a subfield `E_t ≤ Ω` finite over `K`, and over every `E` with
`E_t ≤ E ≤ Ω` that polynomial is a separable polynomial over `E` killing `t`. Hence:

* `exists_isSeparable_of_le`: an element separable over `Ω` is separable over every `E` between
  some `E_t ≤ Ω` finite over `K` and `Ω`;
* `exists_isSeparable_adjoin`: there is `E₂ ≤ Ω` finite over `K` such that for all
  `E₂ ≤ E ≤ Ω` the compositum `E(T) = E · κ` is separable over `E`;
* `exists_isSeparable_adjoin_family`: the same, uniformly for a finite family of finite sets
  (a finite set `Σ` of closed points).

This is "for `L / K_m` finite, `L · K_{m'}` is separable over `K_{m'}` for `m' ≫ m`" of the plan.
-/

noncomputable section

open IntermediateField Polynomial

namespace Hironaka.StableModification.Perfection

universe u v

variable {K : Type u} {N : Type v} [Field K] [Field N] [Algebra K N]

/-- An element separable over `Ω` is separable over every intermediate field `E` between some
`E₁ ≤ Ω` finite over `K` and `Ω`: take for `E₁` the field generated by the coefficients of its
minimal polynomial over `Ω`. -/
theorem exists_isSeparable_of_le (Ω : IntermediateField K N) [Algebra.IsAlgebraic K Ω] {t : N}
    (ht : IsSeparable Ω t) :
    ∃ E₁ : IntermediateField K N, E₁ ≤ Ω ∧ FiniteDimensional K E₁ ∧
      ∀ E : IntermediateField K N, E₁ ≤ E → E ≤ Ω → IsSeparable E t := by
  classical
  let g := minpoly Ω t
  let S : Set N := ((g.coeffs.image Ω.val : Finset N) : Set N)
  have hSΩ : S ⊆ Ω := by
    intro x hx
    simp only [S, Finset.coe_image, Set.mem_image] at hx
    obtain ⟨c, -, rfl⟩ := hx
    exact c.2
  refine ⟨IntermediateField.adjoin K S, IntermediateField.adjoin_le_iff.2 hSΩ, ?_, ?_⟩
  · have : Finite S := (Finset.finite_toSet _).to_subtype
    refine IntermediateField.finiteDimensional_adjoin fun x hx => ?_
    have : IsIntegral K (⟨x, hSΩ hx⟩ : Ω) := Algebra.IsIntegral.isIntegral _
    exact this.map Ω.val
  · intro E hE₁ hEΩ
    let : Algebra E Ω := (IntermediateField.inclusion hEΩ).toAlgebra
    have : IsScalarTower E Ω N := IsScalarTower.of_algebraMap_eq fun _ => rfl
    have hlifts : g ∈ Polynomial.lifts (algebraMap E Ω) := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro n
      by_cases hn : g.coeff n = 0
      · exact ⟨0, by rw [hn, map_zero]⟩
      · have hmem : ((g.coeff n : Ω) : N) ∈ E := by
          refine hE₁ (IntermediateField.subset_adjoin K S ?_)
          simp only [S, Finset.coe_image, Set.mem_image, Finset.mem_coe]
          exact ⟨_, Polynomial.coeff_mem_coeffs hn, rfl⟩
        exact ⟨⟨_, hmem⟩, rfl⟩
    have hg : g.Monic := minpoly.monic (ht.isIntegral)
    obtain ⟨h, hmap, -, hmonic⟩ := Polynomial.lifts_and_degree_eq_and_monic hlifts hg
    have hsep : h.Separable := by
      rw [← Polynomial.separable_map (algebraMap E Ω), hmap]
      exact ht
    have haeval : Polynomial.aeval t h = 0 := by
      rw [← Polynomial.aeval_map_algebraMap Ω, hmap]
      exact minpoly.aeval Ω t
    have hint : IsIntegral E t := ⟨h, hmonic, by rwa [← Polynomial.aeval_def]⟩
    exact hsep.of_dvd (minpoly.dvd E t haeval)

/-- **Separable points.** Let `Ω` be perfect and algebraic over `K`, and `T ⊆ N` a finite set of
elements algebraic over `Ω`. Then there is `E₂ ≤ Ω` finite over `K` such that for every
intermediate field `E₂ ≤ E ≤ Ω` the field `E(T)` is separable over `E`. -/
theorem exists_isSeparable_adjoin (Ω : IntermediateField K N) [Algebra.IsAlgebraic K Ω]
    [PerfectField Ω] (T : Finset N) (hT : ∀ t ∈ T, IsAlgebraic Ω t) :
    ∃ E₂ : IntermediateField K N, E₂ ≤ Ω ∧ FiniteDimensional K E₂ ∧
      ∀ E : IntermediateField K N, E₂ ≤ E → E ≤ Ω →
        Algebra.IsSeparable E (IntermediateField.adjoin E (T : Set N)) := by
  classical
  have hsep : ∀ t ∈ T, IsSeparable Ω t := fun t ht =>
    PerfectField.separable_of_irreducible (minpoly.irreducible (hT t ht).isIntegral)
  have hex : ∀ t : N, ∃ E₁ : IntermediateField K N, (t ∈ T → E₁ ≤ Ω ∧ FiniteDimensional K E₁ ∧
      ∀ E : IntermediateField K N, E₁ ≤ E → E ≤ Ω → IsSeparable E t) := by
    intro t
    by_cases ht : t ∈ T
    · obtain ⟨E₁, h₁, h₂, h₃⟩ := exists_isSeparable_of_le Ω (hsep t ht)
      exact ⟨E₁, fun _ => ⟨h₁, h₂, h₃⟩⟩
    · exact ⟨⊥, fun h => absurd h ht⟩
  choose Et hEt using hex
  have : ∀ t ∈ T, FiniteDimensional K (Et t) := fun t ht => (hEt t ht).2.1
  refine ⟨⨆ t ∈ T, Et t, iSup₂_le fun t ht => (hEt t ht).1,
    IntermediateField.finiteDimensional_iSup_of_finset' this, ?_⟩
  intro E hE₂ hEΩ
  rw [IntermediateField.isSeparable_adjoin_iff_isSeparable]
  intro t ht
  exact (hEt t ht).2.2 E ((le_iSup₂ (f := fun t _ => Et t) t ht).trans hE₂) hEΩ

/-- **Separable points, finitely many at once.** For a finite family `(T_i)` of finite sets of
elements algebraic over the perfect field `Ω`, there is `E₂ ≤ Ω` finite over `K` such that for
every `E₂ ≤ E ≤ Ω` and every `i`, the compositum `E(T_i)` is separable over `E`. -/
theorem exists_isSeparable_adjoin_family (Ω : IntermediateField K N) [Algebra.IsAlgebraic K Ω]
    [PerfectField Ω] {ι : Type*} (s : Finset ι) (T : ι → Finset N)
    (hT : ∀ i ∈ s, ∀ t ∈ T i, IsAlgebraic Ω t) :
    ∃ E₂ : IntermediateField K N, E₂ ≤ Ω ∧ FiniteDimensional K E₂ ∧
      ∀ E : IntermediateField K N, E₂ ≤ E → E ≤ Ω →
        ∀ i ∈ s, Algebra.IsSeparable E (IntermediateField.adjoin E (T i : Set N)) := by
  classical
  have hex : ∀ i : ι, ∃ E₂ : IntermediateField K N, (i ∈ s → E₂ ≤ Ω ∧ FiniteDimensional K E₂ ∧
      ∀ E : IntermediateField K N, E₂ ≤ E → E ≤ Ω →
        Algebra.IsSeparable E (IntermediateField.adjoin E (T i : Set N))) := by
    intro i
    by_cases hi : i ∈ s
    · obtain ⟨E₂, h₁, h₂, h₃⟩ := exists_isSeparable_adjoin Ω (T i) (hT i hi)
      exact ⟨E₂, fun _ => ⟨h₁, h₂, h₃⟩⟩
    · exact ⟨⊥, fun h => absurd h hi⟩
  choose Ei hEi using hex
  have : ∀ i ∈ s, FiniteDimensional K (Ei i) := fun i hi => (hEi i hi).2.1
  refine ⟨⨆ i ∈ s, Ei i, iSup₂_le fun i hi => (hEi i hi).1,
    IntermediateField.finiteDimensional_iSup_of_finset' this, ?_⟩
  intro E hE₂ hEΩ i hi
  exact (hEi i hi).2.2 E ((le_iSup₂ (f := fun i _ => Ei i) i hi).trans hE₂) hEΩ

/-- The compositum `E ⊔ K(T)` is `E(T)` restricted to `K`; in this form `exists_isSeparable_adjoin`
says that `E · κ` is separable over `E` for `κ = K(T)`. -/
theorem restrictScalars_adjoin_eq_sup_adjoin (E : IntermediateField K N) (T : Set N) :
    (IntermediateField.adjoin E T).restrictScalars K = E ⊔ IntermediateField.adjoin K T :=
  IntermediateField.restrictScalars_adjoin_eq_sup K E T

end Hironaka.StableModification.Perfection

end
