import Hironaka.Geometry.StableModification.Blowups.SmoothChart

/-!
# The modification loci of the chart blow-ups over a local base (Temkin, Proposition 4.3.1)

M. Temkin, *Stable modification of relative curves*, J. Algebraic Geom. 19 (2010), proof of
Proposition 4.3.1 (`semi-stable.tex` lines 2972–2975, 2989, 3013–3014), builds the chart blow-ups so
that "`x` is the only closed point of the modification locus". For the two model blow-ups of BL1
over a local domain `A` with `π ∈ 𝔪_A` this file proves the precise local statement: the closed
subscheme `V(u, v, π)` (resp. `V(π, T - a)`) outside of which the blow-up is an isomorphism
(`Blowups.nodeBlowup_isIso`, `Blowups.smoothBlowup_isIso`) has a unique closed point, the origin
`x = (u, v, 𝔪_A)` of the closed fibre (resp. the point `x = (𝔪_A, T - a)`), and every point of it
specializes to `x`. That the locus is closed in a global curve is a separate matter (ERRATA DJA-T33,
handled by the étale transport of lane BND). Blueprint chapter `sm-local-uniformization-model.tex`
(`lem:sm-lu-node-stage`, `lem:sm-lu-smooth-stage`).

## Main results

* `le_ker_of_surjective_algebraMap`: if `A → B/J` is surjective, `A` is local and
  `φ : B → κ(A)` kills `J` and restricts to the residue map on `A`, every prime of `B` containing
  `J` is contained in `ker φ`.
* `nodeOrigin`, `nodeOrigin_mem_range_nodeLocus`, `isClosed_nodeOrigin`,
  `specializes_nodeOrigin`: the origin of the node is the unique closed point of `V(u, v, π)`.
* `smoothOrigin`, `smoothOrigin_mem_range_smoothLocus`, `isClosed_smoothOrigin`,
  `specializes_smoothOrigin`: the same for `V(π, T - a)`.
-/

open AlgebraicGeometry CategoryTheory IsLocalRing Polynomial

noncomputable section

namespace Hironaka.StableModification.LocalUniformization

universe u

open Blowups Curves Algebra.NodeBlowupChart

/-- **Primes over a quotient generated by the base.** Let `A` be local, `B` an `A`-algebra and
`J ⊆ B` an ideal with `A → B/J` surjective, and let `φ : B → κ(A)` be a ring map killing `J` with
`φ(a) = ā` for `a ∈ A`. Then every prime of `B` containing `J` is contained in `ker φ`. -/
theorem le_ker_of_surjective_algebraMap {A B : Type*} [CommRing A] [IsLocalRing A] [CommRing B]
    [Algebra A B] (J : Ideal B) (hsurj : Function.Surjective (algebraMap A (B ⧸ J)))
    (φ : B →+* ResidueField A) (hφ : ∀ c, φ (algebraMap A B c) = residue A c)
    (hJ : J ≤ RingHom.ker φ) (P : PrimeSpectrum B) (hP : J ≤ P.asIdeal) :
    P.asIdeal ≤ RingHom.ker φ := by
  intro r hr
  obtain ⟨c, hc⟩ := hsurj (Ideal.Quotient.mk J r)
  have hrc : r - algebraMap A B c ∈ J := by
    rw [← Ideal.Quotient.eq]
    rw [← hc]
    rfl
  have hcP : algebraMap A B c ∈ P.asIdeal := by
    have := P.asIdeal.sub_mem hr (hP hrc)
    simpa using this
  have hcm : c ∈ maximalIdeal A :=
    IsLocalRing.le_maximalIdeal
      (Ideal.IsPrime.ne_top (Ideal.comap_isPrime (algebraMap A B) P.asIdeal))
      (Ideal.mem_comap.mpr hcP)
  rw [RingHom.mem_ker]
  have h1 := RingHom.mem_ker.mp (hJ hrc)
  rw [map_sub, hφ, (residue_eq_zero_iff c).mpr hcm, sub_zero] at h1
  exact h1

/-- A point of `Spec B` in the image of `Spec B/J` has prime containing `J`. -/
theorem le_asIdeal_of_mem_range {B : Type u} [CommRing B] (J : Ideal B) {y : Spec (.of B)}
    (hy : y ∈ Set.range (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)))) : J ≤ y.asIdeal := by
  obtain ⟨z, rfl⟩ := hy
  change J ≤ Ideal.comap (Ideal.Quotient.mk J) z.asIdeal
  intro r hr
  rw [Ideal.mem_comap, Ideal.Quotient.eq_zero_iff_mem.mpr hr]
  exact z.asIdeal.zero_mem

/-- The kernel of a surjective ring map to a field, as a closed point. -/
theorem isClosed_of_ker_surjective {B K : Type u} [CommRing B] [Field K] (φ : B →+* K)
    (hφ : Function.Surjective φ) :
    IsClosed ({(⟨RingHom.ker φ, RingHom.ker_isPrime φ⟩ : PrimeSpectrum B)} :
      Set (PrimeSpectrum B)) := by
  rw [PrimeSpectrum.isClosed_singleton_iff_isMaximal]
  exact RingHom.ker_isMaximal_of_surjective φ hφ

section Node

variable {A : Type u} [CommRing A] [IsLocalRing A] (π b : A)

/-- The reduction `A[u,v]/(uv - πb) → κ(A)`, `u, v ↦ 0`, for `π ∈ 𝔪_A`. -/
def nodeResidue (hπ : π ∈ maximalIdeal A) : Node A (π * b) →+* ResidueField A :=
  Ideal.Quotient.lift _ (MvPolynomial.eval₂Hom (residue A) fun _ ↦ 0) (by
    intro p hp
    rw [Algebra.NodeChart.uChartIdeal, Ideal.mem_span_singleton] at hp
    obtain ⟨q, rfl⟩ := hp
    simp only [map_mul, map_sub, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C, mul_zero,
      zero_sub, map_mul]
    rw [(residue_eq_zero_iff π).mpr hπ, zero_mul, neg_zero, zero_mul])

theorem nodeResidue_algebraMap (hπ : π ∈ maximalIdeal A) (c : A) :
    nodeResidue π b hπ (algebraMap A (Node A (π * b)) c) = residue A c := by
  change nodeResidue π b hπ (Ideal.Quotient.mk _ (MvPolynomial.C c)) = _
  simp [nodeResidue]

theorem nodeResidue_coordinate (hπ : π ∈ maximalIdeal A) (i : Fin 2) :
    nodeResidue π b hπ (coordinate (π * b) i) = 0 := by
  simp [nodeResidue, coordinate]

theorem nodeResidue_surjective (hπ : π ∈ maximalIdeal A) :
    Function.Surjective (nodeResidue π b hπ) := fun z ↦ by
  obtain ⟨c, rfl⟩ := residue_surjective z
  exact ⟨_, nodeResidue_algebraMap π b hπ c⟩

theorem nodeLocusIdeal_le_ker (hπ : π ∈ maximalIdeal A) :
    nodeLocusIdeal π b ≤ RingHom.ker (nodeResidue π b hπ) := by
  rw [nodeLocusIdeal, Ideal.span_le]
  rintro _ (rfl | rfl | rfl)
  · exact nodeResidue_coordinate π b hπ 0
  · exact nodeResidue_coordinate π b hπ 1
  · change nodeResidue π b hπ _ = 0
    rw [nodeResidue_algebraMap, (residue_eq_zero_iff π).mpr hπ]

/-- The origin `x = (u, v, 𝔪_A)` of the closed fibre of the node `A[u,v]/(uv - πb)`. -/
def nodeOrigin (hπ : π ∈ maximalIdeal A) : Spec (.of (Node A (π * b))) :=
  ⟨RingHom.ker (nodeResidue π b hπ), RingHom.ker_isPrime _⟩

theorem isClosed_nodeOrigin (hπ : π ∈ maximalIdeal A) :
    IsClosed ({nodeOrigin π b hπ} : Set (Spec (.of (Node A (π * b))))) :=
  isClosed_of_ker_surjective _ (nodeResidue_surjective π b hπ)

/-- The origin lies over the closed point of `Spec A`. -/
theorem nodeModel_nodeOrigin (hπ : π ∈ maximalIdeal A) :
    (nodeModel (π * b) (nodeOrigin π b hπ)).asIdeal = maximalIdeal A := by
  ext c
  change algebraMap A (Node A (π * b)) c ∈ RingHom.ker (nodeResidue π b hπ) ↔ _
  rw [RingHom.mem_ker, nodeResidue_algebraMap, residue_eq_zero_iff]

theorem nodeOrigin_mem_range_nodeLocus (hπ : π ∈ maximalIdeal A) :
    nodeOrigin π b hπ ∈ Set.range (nodeLocus π b) := by
  rw [range_nodeLocus]
  have h := nodeLocusIdeal_le_ker π b hπ
  intro hmem
  simp only [nodeLocusComplement, SetLike.mem_coe] at hmem
  rcases hmem with (h0 | h1) | h2
  · exact (PrimeSpectrum.mem_basicOpen _ _).mp h0 (h (Ideal.subset_span (Set.mem_insert _ _)))
  · exact (PrimeSpectrum.mem_basicOpen _ _).mp h1
      (h (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_insert _ _))))
  · exact (PrimeSpectrum.mem_basicOpen _ _).mp h2
      (h (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ rfl))))

/-- **The locus `V(u, v, π)` is local with closed point the origin** (Temkin, T:2989: "`x` is the
only closed point of the modification locus"): every point of `V(u, v, π)` specializes to the
origin `(u, v, 𝔪_A)`. -/
theorem specializes_nodeOrigin (hπ : π ∈ maximalIdeal A) {y : Spec (.of (Node A (π * b)))}
    (hy : y ∈ Set.range (nodeLocus π b)) : y ⤳ nodeOrigin π b hπ := by
  refine (PrimeSpectrum.le_iff_specializes _ _).mp ?_
  exact le_ker_of_surjective_algebraMap (nodeLocusIdeal π b) (algebraMap_nodeLocus_surjective π b)
    (nodeResidue π b hπ) (nodeResidue_algebraMap π b hπ) (nodeLocusIdeal_le_ker π b hπ) _
    (le_asIdeal_of_mem_range _ hy)

end Node

section Smooth

variable {A : Type u} [CommRing A] [IsLocalRing A] (π a : A)

/-- The reduction `A[T] → κ(A)`, `T ↦ ā`. -/
def smoothResidue : A[X] →+* ResidueField A := Polynomial.eval₂RingHom (residue A) (residue A a)

theorem smoothResidue_C (c : A) : smoothResidue a (C c) = residue A c := by
  simp [smoothResidue]

theorem smoothResidue_surjective : Function.Surjective (smoothResidue (A := A) a) := fun z ↦ by
  obtain ⟨c, rfl⟩ := residue_surjective z
  exact ⟨_, smoothResidue_C a c⟩

theorem smoothCenter_le_ker (hπ : π ∈ maximalIdeal A) :
    smoothCenter π a ≤ RingHom.ker (smoothResidue a) := by
  rw [smoothCenter, Ideal.span_le]
  rintro _ (rfl | rfl)
  · change smoothResidue a (C π) = 0
    rw [smoothResidue_C, (residue_eq_zero_iff π).mpr hπ]
  · change smoothResidue a (X - C a) = 0
    simp [smoothResidue]

/-- The point `x = (𝔪_A, T - a)` of the closed fibre of `Spec A[T]`. -/
def smoothOrigin : Spec (.of A[X]) := ⟨RingHom.ker (smoothResidue a), RingHom.ker_isPrime _⟩

theorem isClosed_smoothOrigin : IsClosed ({smoothOrigin a} : Set (Spec (.of A[X]))) :=
  isClosed_of_ker_surjective _ (smoothResidue_surjective a)

/-- The point `(𝔪_A, T - a)` lies over the closed point of `Spec A`. -/
theorem smoothModel_smoothOrigin : (smoothModel A (smoothOrigin a)).asIdeal = maximalIdeal A := by
  ext c
  change algebraMap A A[X] c ∈ RingHom.ker (smoothResidue a) ↔ _
  rw [RingHom.mem_ker, Polynomial.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply,
    smoothResidue_C, residue_eq_zero_iff]

theorem smoothOrigin_mem_range_smoothLocus (hπ : π ∈ maximalIdeal A) :
    smoothOrigin a ∈ Set.range (smoothLocus π a) := by
  rw [range_smoothLocus]
  change smoothOrigin a ∈ ((PrimeSpectrum.zeroLocus (smoothCenter π a : Set A[X]))ᶜ)ᶜ
  rw [compl_compl]
  show (smoothCenter π a : Set A[X]) ⊆ (smoothOrigin a).asIdeal
  exact fun f hf ↦ smoothCenter_le_ker π a hπ hf

/-- **The locus `V(π, T - a)` is local with closed point `(𝔪_A, T - a)`** (Temkin, T:3013–3014):
every point of `V(π, T - a)` specializes to `(𝔪_A, T - a)`. -/
theorem specializes_smoothOrigin (hπ : π ∈ maximalIdeal A) {y : Spec (.of A[X])}
    (hy : y ∈ Set.range (smoothLocus π a)) : y ⤳ smoothOrigin a := by
  refine (PrimeSpectrum.le_iff_specializes _ _).mp ?_
  exact le_ker_of_surjective_algebraMap (smoothCenter π a) (algebraMap_smoothLocus_surjective π a)
    (smoothResidue a) (fun c ↦ by rw [Polynomial.algebraMap_apply, Algebra.algebraMap_self,
      RingHom.id_apply, smoothResidue_C]) (smoothCenter_le_ker π a hπ) _
    (le_asIdeal_of_mem_range _ hy)

end Smooth

end Hironaka.StableModification.LocalUniformization
