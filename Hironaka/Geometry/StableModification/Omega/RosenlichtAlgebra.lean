import Mathlib.RingTheory.Kaehler.Basic
import Mathlib.RingTheory.Localization.Away.Basic
import Mathlib.Tactic.LinearCombination

/-!
# Rosenlicht's description of the dualizing module at a node (algebra)

Let `K → A` be a ring map and `u, v ∈ A` with `uv = 0`, such that `u` is a non-zero-divisor
modulo `v` and `v` modulo `u` (`IsNodeBranching u v`). Geometrically `Spec A` is a neighbourhood
of the node locus `E = V(u, v)` of a curve with the two branches `B₁ = A/(v)` (the `u`-axis) and
`B₂ = A/(u)` (the `v`-axis), whose disjoint union is the normalization near `E`; the
complement of `E` is `D(u) ⊔ D(v)`, with rings `A_u = (B₁)_u` and `A_v = (B₂)_v`. This is the
local form of the geometric fibre of a nodal curve at its nodes (`Omega/RosenlichtEtale.lean`:
`A` flat and formally étale over `O[u,v]/(uv - c)` with `c` vanishing on `A`;
`Omega/RosenlichtFibre.lean`: the geometric fibre of an étale node chart).

M. Temkin, *Stable modification of relative curves*, J. Algebraic Geom. 19 (2010), §1.2,
property (b) (`semi-stable.tex`, T:1700–1704), describes `ω_{C/k}` of a nodal curve over an
algebraically closed field as the forms on the normalization with at most simple poles at the
preimages of the nodes whose residues at the two branches of each node sum to zero (Rosenlicht;
Temkin writes `Res_{x_i} = Res_{y_i}`, which is a sign error, ERRATA T58). Here:

* `logForm K u Aᵤ = du/u ∈ Ω[A_u/K]`;
* `rosenlicht K u v Aᵤ Aᵥ c = (c·du/u, -c·dv/v)`: the image of `c·σ` for the generator
  `σ = du/u = -dv/v` of `ω` (Temkin's `ω` near the node, `Omega/InvertibleNode.lean`);
* `IsRosenlicht K u v α β`: `α = a·du/u` and `β = b·dv/v` with `a ∈ B₁`, `b ∈ B₂` (simple poles
  along `E` on each branch) and `residue₁ a + residue₂ b = 0` in `A/(u, v) = 𝒪_E` (the residues
  of `a·du/u` and `b·dv/v` are the values of `a`, `b` on `E`);
* `isRosenlicht_iff`: **the pairs satisfying Rosenlicht's condition are exactly the
  `rosenlicht c`, `c ∈ A`**, and `rosenlicht_injective`: `c ↦ rosenlicht c` is injective, so
  Rosenlicht's module is free of rank one over `A`, generated by `(du/u, -dv/v)`;
* `residue₁_eq_zero_iff`: a form `a·du/u` on the first branch is regular (comes from
  `Ω[B₁/K]`) iff its residue vanishes, and `kaehlerMap₁_injective`: `Ω[B₁/K] → Ω[A_u/K]` is
  injective. Hence `Ω_{B₁}(E₁)/Ω_{B₁} ≅ B₁/(u) = 𝒪_E`: twisting by the preimage of the nodes adds
  its length to the degree (the consequence `deg ν^*ω|_Z = deg Ω¹_{Z̃} + #E_Z` used by lane OM3).

Blueprint: `sm-omega-base-change.tex` (`def:sm-rosenlicht-branching`,
`lem:sm-rosenlicht-branching-basic`, `def:sm-rosenlicht-module`, `thm:sm-rosenlicht-local`,
`lem:sm-rosenlicht-regular`).
-/

noncomputable section

namespace Hironaka.StableModification.Omega.Rosenlicht

open KaehlerDifferential

variable (K : Type*) {A : Type*} [CommRing K] [CommRing A]

section Branches

variable (u v : A)

/-- The ideal `(u, v)` of the node locus `E = V(u, v)`. -/
def nodeIdeal : Ideal A := Ideal.span {u} ⊔ Ideal.span {v}

/-- The residue (restriction to the node locus) on the first branch: `A/(v) → A/(u, v)`. -/
def residue₁ : A ⧸ Ideal.span {v} →+* A ⧸ nodeIdeal u v :=
  Ideal.Quotient.factor le_sup_right

/-- The residue (restriction to the node locus) on the second branch: `A/(u) → A/(u, v)`. -/
def residue₂ : A ⧸ Ideal.span {u} →+* A ⧸ nodeIdeal u v :=
  Ideal.Quotient.factor le_sup_left

@[simp]
theorem residue₁_mk (a : A) :
    residue₁ u v (Ideal.Quotient.mk _ a) = Ideal.Quotient.mk (nodeIdeal u v) a :=
  Ideal.Quotient.factor_mk _ a

@[simp]
theorem residue₂_mk (a : A) :
    residue₂ u v (Ideal.Quotient.mk _ a) = Ideal.Quotient.mk (nodeIdeal u v) a :=
  Ideal.Quotient.factor_mk _ a

/-- `u, v ∈ A` *branch like a node*: `uv = 0`, `u` is a non-zero-divisor modulo `v` and `v` is a
non-zero-divisor modulo `u`. For `A` flat over `O[u,v]/(uv)` this is
`Rosenlicht.isNodeBranching_of_flat`. -/
structure IsNodeBranching : Prop where
  mul_eq_zero : u * v = 0
  sat₁ : ∀ a : A, u * a ∈ Ideal.span {v} → a ∈ Ideal.span {v}
  sat₂ : ∀ a : A, v * a ∈ Ideal.span {u} → a ∈ Ideal.span {u}

variable {u v}

theorem IsNodeBranching.symm (h : IsNodeBranching u v) : IsNodeBranching v u :=
  ⟨by rw [mul_comm]; exact h.mul_eq_zero, h.sat₂, h.sat₁⟩

/-- The two branches meet only along the node locus: `(u) ∩ (v) = 0`. -/
theorem IsNodeBranching.mem_inf (h : IsNodeBranching u v) {x : A}
    (hu : x ∈ Ideal.span {u}) (hv : x ∈ Ideal.span {v}) : x = 0 := by
  obtain ⟨y, rfl⟩ := Ideal.mem_span_singleton'.mp hu
  have hy : y ∈ Ideal.span {v} := h.sat₁ y (by rw [mul_comm]; exact hv)
  obtain ⟨z, rfl⟩ := Ideal.mem_span_singleton'.mp hy
  rw [mul_assoc, mul_comm v u, h.mul_eq_zero, mul_zero]

/-- Powers of `u` are non-zero-divisors modulo `v`. -/
theorem IsNodeBranching.sat₁_pow (h : IsNodeBranching u v) (n : ℕ) (a : A)
    (ha : u ^ n * a ∈ Ideal.span {v}) : a ∈ Ideal.span {v} := by
  induction n generalizing a with
  | zero => simpa using ha
  | succ n ih =>
    apply ih
    apply h.sat₁
    rw [← mul_assoc, ← pow_succ']
    exact ha

end Branches

section Localization

variable {u v : A} (Aᵤ : Type*) [CommRing Aᵤ] [Algebra A Aᵤ] [IsLocalization.Away u Aᵤ]

/-- On `D(u)` the other coordinate vanishes. -/
theorem algebraMap_eq_zero_of_mul (huv : u * v = 0) :
    algebraMap A Aᵤ v = 0 := by
  have h1 := IsLocalization.Away.algebraMap_isUnit (S := Aᵤ) u
  have h2 : algebraMap A Aᵤ u * algebraMap A Aᵤ v = 0 := by rw [← map_mul, huv, map_zero]
  exact (h1.mul_right_eq_zero).mp h2

/-- The map from the first branch `A/(v)` to its localization `A_u = (A/(v))_u`. -/
def branchMap (huv : u * v = 0) : A ⧸ Ideal.span {v} →+* Aᵤ :=
  Ideal.Quotient.lift _ (algebraMap A Aᵤ) (fun a ha => by
    obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [map_mul, algebraMap_eq_zero_of_mul Aᵤ huv, mul_zero])

@[simp]
theorem branchMap_mk (huv : u * v = 0) (a : A) :
    branchMap Aᵤ huv (Ideal.Quotient.mk _ a) = algebraMap A Aᵤ a :=
  Ideal.Quotient.lift_mk _ _ _

/-- The kernel of `A → A_u` is `(v)`, i.e. `A/(v) → A_u` is injective. -/
theorem mem_span_of_algebraMap_eq_zero (h : IsNodeBranching u v) {a : A}
    (ha : algebraMap A Aᵤ a = 0) : a ∈ Ideal.span {v} := by
  obtain ⟨⟨_, n, rfl⟩, hn⟩ := (IsLocalization.map_eq_zero_iff (Submonoid.powers u) Aᵤ a).mp ha
  exact h.sat₁_pow n a (by rw [hn]; exact Ideal.zero_mem _)

theorem branchMap_injective (h : IsNodeBranching u v) :
    Function.Injective (branchMap Aᵤ h.mul_eq_zero) := by
  rw [injective_iff_map_eq_zero]
  intro a ha
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective a
  rw [branchMap_mk] at ha
  exact Ideal.Quotient.eq_zero_iff_mem.mpr (mem_span_of_algebraMap_eq_zero Aᵤ h ha)

variable (u) [Algebra K Aᵤ]

/-- The logarithmic form `du/u ∈ Ω[A_u/K]`. -/
def logForm : Ω[Aᵤ⁄K] :=
  IsLocalization.Away.invSelf (S := Aᵤ) u • D K Aᵤ (algebraMap A Aᵤ u)

theorem algebraMap_smul_logForm :
    algebraMap A Aᵤ u • logForm K u Aᵤ = D K Aᵤ (algebraMap A Aᵤ u) := by
  rw [logForm, smul_smul, IsLocalization.Away.mul_invSelf, one_smul]

variable {u}

/-- If `Ω[A_u/K]` is free on `du`, it is free on `du/u`. -/
theorem smul_logForm_injective
    (hΩ : Function.Injective fun c : Aᵤ => c • D K Aᵤ (algebraMap A Aᵤ u)) :
    Function.Injective fun c : Aᵤ => c • logForm K u Aᵤ := by
  intro c c' hcc'
  simp only [logForm, smul_smul] at hcc'
  have h := hΩ hcc'
  have hu : IsUnit (IsLocalization.Away.invSelf (S := Aᵤ) u) :=
    IsUnit.of_mul_eq_one_right _ (IsLocalization.Away.mul_invSelf u)
  exact hu.mul_left_injective h

end Localization

section RosenlichtModule

variable (u v : A) (Aᵤ Aᵥ : Type*) [CommRing Aᵤ] [CommRing Aᵥ] [Algebra A Aᵤ] [Algebra A Aᵥ]
  [IsLocalization.Away u Aᵤ] [IsLocalization.Away v Aᵥ] [Algebra K Aᵤ] [Algebra K Aᵥ]

/-- The image `(c·du/u, -c·dv/v)` of `c·σ`, `σ = du/u = -dv/v`, on the two branches near the
node locus. -/
def rosenlicht (c : A) : Ω[Aᵤ⁄K] × Ω[Aᵥ⁄K] :=
  (algebraMap A Aᵤ c • logForm K u Aᵤ, -(algebraMap A Aᵥ c • logForm K v Aᵥ))

/-- The generator: `rosenlicht 1 = (du/u, -dv/v)`. -/
theorem rosenlicht_one :
    rosenlicht K u v Aᵤ Aᵥ 1 = (logForm K u Aᵤ, -logForm K v Aᵥ) := by
  simp [rosenlicht]

theorem rosenlicht_add (c c' : A) :
    rosenlicht K u v Aᵤ Aᵥ (c + c') = rosenlicht K u v Aᵤ Aᵥ c + rosenlicht K u v Aᵤ Aᵥ c' := by
  simp only [rosenlicht, map_add, add_smul, neg_add, Prod.mk_add_mk]

/-- `rosenlicht` is `A`-linear: `rosenlicht (a c) = a • rosenlicht c` componentwise. -/
theorem rosenlicht_mul (a c : A) :
    rosenlicht K u v Aᵤ Aᵥ (a * c) =
      (algebraMap A Aᵤ a • (rosenlicht K u v Aᵤ Aᵥ c).1,
        algebraMap A Aᵥ a • (rosenlicht K u v Aᵤ Aᵥ c).2) := by
  simp only [rosenlicht, map_mul, mul_smul, smul_neg]

variable {u v}

/-- **Rosenlicht's condition** for a pair of forms `α` on `D(u)` and `β` on `D(v)`: `α = a·du/u`,
`β = b·dv/v` with `a`, `b` regular on the branches `A/(v)`, `A/(u)` (simple poles along the node
locus), and `Res(α) + Res(β) = a|_E + b|_E = 0` on the node locus `E = V(u, v)` (the sign of
ERRATA T58). -/
def IsRosenlicht (huv : u * v = 0) (α : Ω[Aᵤ⁄K]) (β : Ω[Aᵥ⁄K]) : Prop :=
  ∃ (a : A ⧸ Ideal.span {v}) (b : A ⧸ Ideal.span {u}),
    α = branchMap Aᵤ huv a • logForm K u Aᵤ ∧
      β = branchMap Aᵥ (v := u) (by rw [mul_comm]; exact huv) b • logForm K v Aᵥ ∧
        residue₁ u v a + residue₂ u v b = 0

/-- **Rosenlicht's description at a node** (Temkin §1.2, property (b), with the sign of
ERRATA T58): the pairs of forms with simple poles along the node locus on the two branches and
residues summing to zero are exactly the images `(c·du/u, -c·dv/v)` of the sections `c·σ`,
`c ∈ A`, of `ω`. -/
theorem isRosenlicht_iff (huv : u * v = 0) (α : Ω[Aᵤ⁄K]) (β : Ω[Aᵥ⁄K]) :
    IsRosenlicht K Aᵤ Aᵥ huv α β ↔ ∃ c : A, rosenlicht K u v Aᵤ Aᵥ c = (α, β) := by
  have hvu : v * u = 0 := by rw [mul_comm]; exact huv
  constructor
  · rintro ⟨a, b, rfl, rfl, hres⟩
    obtain ⟨c₁, rfl⟩ := Ideal.Quotient.mk_surjective a
    obtain ⟨c₂, rfl⟩ := Ideal.Quotient.mk_surjective b
    rw [residue₁_mk, residue₂_mk, ← map_add, Ideal.Quotient.eq_zero_iff_mem, nodeIdeal,
      Submodule.mem_sup] at hres
    obtain ⟨p, hp, q, hq, hpq⟩ := hres
    refine ⟨c₁ - q, ?_⟩
    simp only [rosenlicht, branchMap_mk, Prod.mk.injEq]
    obtain ⟨p', rfl⟩ := Ideal.mem_span_singleton'.mp hp
    obtain ⟨q', rfl⟩ := Ideal.mem_span_singleton'.mp hq
    constructor
    · rw [map_sub, map_mul, algebraMap_eq_zero_of_mul Aᵤ huv, mul_zero, sub_zero]
    · have : c₁ - q' * v = -(c₂ - p' * u) := by linear_combination -hpq
      rw [this, map_neg, neg_smul, neg_neg, map_sub, map_mul,
        algebraMap_eq_zero_of_mul Aᵥ hvu, mul_zero, sub_zero]
  · rintro ⟨c, hc⟩
    simp only [rosenlicht, Prod.mk.injEq] at hc
    obtain ⟨rfl, rfl⟩ := hc
    refine ⟨Ideal.Quotient.mk _ c, Ideal.Quotient.mk _ (-c), ?_, ?_, ?_⟩
    · rw [branchMap_mk]
    · rw [branchMap_mk, map_neg, neg_smul]
    · rw [residue₁_mk, residue₂_mk, ← map_add, add_neg_cancel, map_zero]

/-- **The Rosenlicht module is free of rank one**: `c ↦ (c·du/u, -c·dv/v)` is injective when `u, v`
branch like a node and `Ω[A_u/K]`, `Ω[A_v/K]` are free on `du`, `dv` (the branches are smooth
curves away from the node locus). -/
theorem rosenlicht_injective (h : IsNodeBranching u v)
    (hΩu : Function.Injective fun c : Aᵤ => c • D K Aᵤ (algebraMap A Aᵤ u))
    (hΩv : Function.Injective fun c : Aᵥ => c • D K Aᵥ (algebraMap A Aᵥ v)) :
    Function.Injective (rosenlicht K u v Aᵤ Aᵥ) := by
  intro c c' hcc'
  have h1 := congrArg Prod.fst hcc'
  have h2 := congrArg Prod.snd hcc'
  simp only [rosenlicht, neg_inj] at h1 h2
  have hv : c - c' ∈ Ideal.span {v} := by
    apply mem_span_of_algebraMap_eq_zero Aᵤ h
    rw [map_sub, sub_eq_zero]
    exact smul_logForm_injective K Aᵤ hΩu h1
  have hu : c - c' ∈ Ideal.span {u} := by
    apply mem_span_of_algebraMap_eq_zero Aᵥ h.symm
    rw [map_sub, sub_eq_zero]
    exact smul_logForm_injective K Aᵥ hΩv h2
  exact sub_eq_zero.mp (h.mem_inf hu hv)

/-- The coefficient of a form `a·du/u` is unique, so the residue of a form with a simple pole
along the node locus is well defined. -/
theorem branchMap_smul_logForm_injective (h : IsNodeBranching u v)
    (hΩu : Function.Injective fun c : Aᵤ => c • D K Aᵤ (algebraMap A Aᵤ u)) :
    Function.Injective fun a : A ⧸ Ideal.span {v} =>
      branchMap Aᵤ h.mul_eq_zero a • logForm K u Aᵤ :=
  (smul_logForm_injective K Aᵤ hΩu).comp (branchMap_injective Aᵤ h)

end RosenlichtModule

section Regular

/-! ### Regular forms on a branch: `Ω_{B₁}(E₁) / Ω_{B₁} ≅ 𝒪_E` -/

variable [Algebra K A] {u v : A} (h : IsNodeBranching u v) (Aᵤ : Type*) [CommRing Aᵤ]
  [Algebra A Aᵤ] [IsLocalization.Away u Aᵤ] [Algebra K Aᵤ] [IsScalarTower K A Aᵤ]

/-- The algebra structure of `A_u` over the branch `A/(v)`. -/
abbrev branchAlgebra : Algebra (A ⧸ Ideal.span {v}) Aᵤ :=
  (branchMap Aᵤ h.mul_eq_zero).toAlgebra

theorem branchIsScalarTower :
    letI := branchAlgebra h Aᵤ
    IsScalarTower K (A ⧸ Ideal.span {v}) Aᵤ := by
  let := branchAlgebra h Aᵤ
  refine IsScalarTower.of_algebraMap_eq fun k => ?_
  change algebraMap K Aᵤ k = branchMap Aᵤ h.mul_eq_zero (Ideal.Quotient.mk _ (algebraMap K A k))
  rw [branchMap_mk, ← IsScalarTower.algebraMap_apply]

/-- The pullback of regular forms `Ω[(A/(v))/K] → Ω[A_u/K]` on the first branch. -/
def kaehlerMap₁ : Ω[(A ⧸ Ideal.span {v})⁄K] →+ Ω[Aᵤ⁄K] :=
  letI := branchAlgebra h Aᵤ
  haveI := branchIsScalarTower K h Aᵤ
  (KaehlerDifferential.map K K (A ⧸ Ideal.span {v}) Aᵤ).toAddMonoidHom

theorem kaehlerMap₁_D (a : A ⧸ Ideal.span {v}) :
    kaehlerMap₁ K h Aᵤ (D K _ a) = D K Aᵤ (branchMap Aᵤ h.mul_eq_zero a) := by
  let := branchAlgebra h Aᵤ
  have := branchIsScalarTower K h Aᵤ
  exact KaehlerDifferential.map_D K K (A ⧸ Ideal.span {v}) Aᵤ a

theorem kaehlerMap₁_smul (b : A ⧸ Ideal.span {v}) (ω : Ω[(A ⧸ Ideal.span {v})⁄K]) :
    kaehlerMap₁ K h Aᵤ (b • ω) = branchMap Aᵤ h.mul_eq_zero b • kaehlerMap₁ K h Aᵤ ω := by
  let := branchAlgebra h Aᵤ
  have := branchIsScalarTower K h Aᵤ
  change KaehlerDifferential.map K K (A ⧸ Ideal.span {v}) Aᵤ (b • ω) =
    algebraMap (A ⧸ Ideal.span {v}) Aᵤ b • KaehlerDifferential.map K K (A ⧸ Ideal.span {v}) Aᵤ ω
  rw [LinearMap.map_smul, algebraMap_smul]

variable {K}

/-- Under `kaehlerMap₁`, the regular form `b·du` is `(b u)·du/u`. -/
theorem kaehlerMap₁_smul_D (b : A ⧸ Ideal.span {v}) :
    kaehlerMap₁ K h Aᵤ (b • D K _ (Ideal.Quotient.mk _ u)) =
      branchMap Aᵤ h.mul_eq_zero (b * Ideal.Quotient.mk _ u) • logForm K u Aᵤ := by
  rw [kaehlerMap₁_smul, kaehlerMap₁_D, branchMap_mk, map_mul, branchMap_mk, mul_smul,
    algebraMap_smul_logForm]

/-- **Regular forms on a branch.** If `Ω[(A/(v))/K]` is spanned by `du` and `Ω[A_u/K]` is free on
`du`, a form `a·du/u` (`a ∈ A/(v)`) is the image of a regular form iff its residue on the node
locus vanishes. -/
theorem residue₁_eq_zero_iff
    (hspan : Submodule.span (A ⧸ Ideal.span {v}) {D K _ (Ideal.Quotient.mk (Ideal.span {v}) u)} = ⊤)
    (hΩu : Function.Injective fun c : Aᵤ => c • D K Aᵤ (algebraMap A Aᵤ u))
    (a : A ⧸ Ideal.span {v}) :
    residue₁ u v a = 0 ↔
      branchMap Aᵤ h.mul_eq_zero a • logForm K u Aᵤ ∈ Set.range (kaehlerMap₁ K h Aᵤ) := by
  constructor
  · intro ha
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective a
    rw [residue₁_mk, Ideal.Quotient.eq_zero_iff_mem, nodeIdeal, Submodule.mem_sup] at ha
    obtain ⟨p, hp, q, hq, rfl⟩ := ha
    obtain ⟨p', rfl⟩ := Ideal.mem_span_singleton'.mp hp
    refine ⟨Ideal.Quotient.mk (Ideal.span {v}) p' • D K _ (Ideal.Quotient.mk (Ideal.span {v}) u), ?_⟩
    rw [kaehlerMap₁_smul_D, ← map_mul, map_add,
      (Ideal.Quotient.eq_zero_iff_mem (I := Ideal.span {v})).mpr hq, add_zero]
  · rintro ⟨ω, hω⟩
    have hω' : ω ∈ Submodule.span (A ⧸ Ideal.span {v})
        {D K _ (Ideal.Quotient.mk (Ideal.span {v}) u)} := hspan ▸ Submodule.mem_top
    obtain ⟨b, rfl⟩ := Submodule.mem_span_singleton.mp hω'
    rw [kaehlerMap₁_smul_D] at hω
    have hab := branchMap_smul_logForm_injective K Aᵤ h hΩu hω
    have hu : u ∈ nodeIdeal u v := Ideal.mem_sup_left (Ideal.mem_span_singleton_self u)
    rw [← hab, map_mul, residue₁_mk, Ideal.Quotient.eq_zero_iff_mem.mpr hu, mul_zero]

/-- **Regular forms embed**: `Ω[(A/(v))/K] → Ω[A_u/K]` is injective when the source is spanned
by `du` and the target is free on `du`. -/
theorem kaehlerMap₁_injective
    (hspan : Submodule.span (A ⧸ Ideal.span {v}) {D K _ (Ideal.Quotient.mk (Ideal.span {v}) u)} = ⊤)
    (hΩu : Function.Injective fun c : Aᵤ => c • D K Aᵤ (algebraMap A Aᵤ u)) :
    Function.Injective (kaehlerMap₁ K h Aᵤ) := by
  rw [injective_iff_map_eq_zero]
  intro ω hω
  have hω' : ω ∈ Submodule.span (A ⧸ Ideal.span {v})
      {D K _ (Ideal.Quotient.mk (Ideal.span {v}) u)} := hspan ▸ Submodule.mem_top
  obtain ⟨b, rfl⟩ := Submodule.mem_span_singleton.mp hω'
  rw [kaehlerMap₁_smul, kaehlerMap₁_D, branchMap_mk] at hω
  have hb : branchMap Aᵤ h.mul_eq_zero b = 0 := hΩu (hω.trans (zero_smul _ _).symm)
  rw [(branchMap_injective Aᵤ h) (hb.trans (map_zero _).symm), zero_smul]

end Regular

end Hironaka.StableModification.Omega.Rosenlicht
