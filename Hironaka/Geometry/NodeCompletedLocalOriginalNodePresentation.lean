import Hironaka.Geometry.NodeCompletedLocalOriginalNodeJetDimensions
import Hironaka.Algebra.NodeFieldCotangentGeneratorsPresentation

/-! Actual original singular-point field-series presentation, with NO supplied generators or presentation. -/

noncomputable section

open AlgebraicGeometry IsLocalRing MvPowerSeries

namespace Hironaka.Geometry.NodeCompletedLocalOriginalNodePresentation

open NodeCompletedLocalMap NodeCompletedLocalOriginalNodeJets
  NodeCompletedLocalOriginalNodeJetDimensions

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option quotPrecheck false
set_option maxHeartbeats 800000
set_option maxRecDepth 3000

universe u
variable {X S : Scheme.{u}} (f : X ⟶ S) [IsSemistableCurve f]
  (z : (Algebra.NodeFittingOmegaGluing.idealSheaf f 1).subscheme)

local notation "x" => (Algebra.NodeFittingOmegaGluing.idealSheaf f 1).subschemeι z
local notation "Q" => OriginalFiberRing f x
local notation "κ" => ResidueField Q
local notation "C" => Algebra.CompletionRegularityBasics.Completion Q
local notation "P" => MvPowerSeries (Fin 2) κ

attribute [local instance] originalAlgebra originalFiberResidueAlgebra originalFiber_isNoetherianRing
  originalCompletion_isNoetherianRing originalCompletion_isAdicComplete

local instance originalQuotientLocalRing : IsLocalRing Q := originalFiberLocalRing f x

variable (L : Type u) [Field L] [IsAlgClosed L]
  [Algebra (X.residueField ((Algebra.NodeFittingOmegaGluing.idealSheaf f 1).subschemeι z)) L]

include L

/-- Two actual generators of the SAME original completed closed fibre are internally chosen from genuine source jet dimensions. -/
def generators : Fin 2 → C := by
  letI := originalCompletion_isNoetherianRing f z
  letI := originalPointAlgebra f z
  exact Algebra.NodeFieldCotangentGeneratorsPresentation.generators κ C
    (originalPoint_residue_bijective f z) (jet_finrank_two f z L)

/-- The WHOLE original native maximal ideal is generated by the internally produced actual pair. -/
theorem generators_span : Ideal.span (Set.range (generators f z L)) = maximalIdeal C := by
  let := originalCompletion_isNoetherianRing f z
  let := originalPointAlgebra f z
  exact Algebra.NodeFieldCotangentGeneratorsPresentation.generators_span κ C
    (originalPoint_residue_bijective f z) (jet_finrank_two f z L)

/-- Actual complete evaluation on the SAME original C, derived from genuine original semistable geometry. -/
def evaluation :
    letI := originalPointAlgebra f z
    P →ₐ[κ] C := by
  letI := originalCompletion_isNoetherianRing f z
  letI := originalCompletion_isAdicComplete f z
  letI := originalPointAlgebra f z
  exact Algebra.NodeFieldCotangentGeneratorsPresentation.evaluation κ C
    (originalPoint_residue_bijective f z) (jet_finrank_two f z L)

/-- EVERY original point coefficient has precisely its SAME original diagonal-induced image. -/
theorem evaluation_C (a : κ) :
    letI := originalPointAlgebra f z
    evaluation f z L (MvPowerSeries.C a) = algebraMap κ C a := by
  let := originalCompletion_isNoetherianRing f z
  let := originalCompletion_isAdicComplete f z
  let := originalPointAlgebra f z
  exact Algebra.NodeFieldCotangentGeneratorsPresentation.evaluation_C κ C
    (originalPoint_residue_bijective f z) (jet_finrank_two f z L) a

/-- BOTH formal variables have their internally derived actual original completed-local generator images. -/
theorem evaluation_X (i : Fin 2) :
    letI := originalPointAlgebra f z
    evaluation f z L (MvPowerSeries.X i) = generators f z L i := by
  let := originalCompletion_isNoetherianRing f z
  let := originalCompletion_isAdicComplete f z
  let := originalPointAlgebra f z
  exact Algebra.NodeFieldCotangentGeneratorsPresentation.evaluation_X κ C
    (originalPoint_residue_bijective f z) (jet_finrank_two f z L) i

/-- EVERY entire variable-ideal power has precisely its SAME original completed maximal-ideal-power image. -/
theorem variableIdeal_pow_image (n : ℕ) :
    letI := originalPointAlgebra f z
    ((Ideal.span (Set.range (fun i : Fin 2 => (MvPowerSeries.X i : P)))) ^ n).map
      (evaluation f z L).toRingHom = maximalIdeal C ^ n := by
  let := originalCompletion_isNoetherianRing f z
  let := originalCompletion_isAdicComplete f z
  let := originalPointAlgebra f z
  exact Algebra.NodeFieldCotangentGeneratorsPresentation.variableIdeal_pow_image κ C
    (originalPoint_residue_bijective f z) (jet_finrank_two f z L) n

/-- Genuine original source geometry gives a SURJECTIVE complete series evaluation, without supplied generators or model. -/
theorem evaluation_surjective :
    letI := originalPointAlgebra f z
    Function.Surjective (evaluation f z L) := by
  let := originalCompletion_isNoetherianRing f z
  let := originalCompletion_isAdicComplete f z
  let := originalPointAlgebra f z
  exact Algebra.NodeFieldCotangentGeneratorsPresentation.evaluation_surjective κ C
    (originalPoint_residue_bijective f z) (jet_finrank_two f z L)

/-- The ENTIRE actual evaluation kernel gives the SAME original closed-fibre completion. -/
def quotientEquiv :
    letI := originalPointAlgebra f z
    (P ⧸ RingHom.ker (evaluation f z L).toRingHom) ≃ₐ[κ] C := by
  letI := originalCompletion_isNoetherianRing f z
  letI := originalCompletion_isAdicComplete f z
  letI := originalPointAlgebra f z
  exact Algebra.NodeFieldCotangentGeneratorsPresentation.quotientEquiv κ C
    (originalPoint_residue_bijective f z) (jet_finrank_two f z L)

/-- EVERY original series representative retains its exact actual original evaluation image. -/
theorem quotientEquiv_mk (g : P) :
    letI := originalPointAlgebra f z
    quotientEquiv f z L (Ideal.Quotient.mk _ g) = evaluation f z L g := by
  let := originalCompletion_isNoetherianRing f z
  let := originalCompletion_isAdicComplete f z
  let := originalPointAlgebra f z
  exact Algebra.NodeFieldCotangentGeneratorsPresentation.quotientEquiv_mk κ C
    (originalPoint_residue_bijective f z) (jet_finrank_two f z L) g

end Hironaka.Geometry.NodeCompletedLocalOriginalNodePresentation
