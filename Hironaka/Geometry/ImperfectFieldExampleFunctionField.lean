import Hironaka.Geometry.ImperfectFieldExampleCurve
import Hironaka.Geometry.SeparableGenericSmoothness
import Mathlib.RingTheory.AlgebraicIndependent.AlgebraicClosure
import Mathlib.RingTheory.AlgebraicIndependent.TranscendenceBasis
import Mathlib.FieldTheory.SeparableDegree

/-!
# The actual imperfect-field curve has a separably generated function field

The coordinate `y` is transcendental and `x` satisfies a separable quadratic
over the intermediate field generated by `y`. All generation and canonical
scheme function-field scalar compatibility are proved internally.
-/

noncomputable section

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

open Polynomial AlgebraicGeometry CategoryTheory IntermediateField
open scoped IntermediateField algebraAdjoinAdjoin
open Hironaka.Algebra.ImperfectFieldExample
open Hironaka.Geometry.ImperfectFieldExampleCurve

namespace Hironaka.Geometry.ImperfectFieldExampleFunctionField

section FractionField

variable (K : Type*) [Field K] [Algebra CurveRing K]
    [Algebra BaseField K] [IsScalarTower BaseField CurveRing K]

def fieldX : K := algebraMap CurveRing K curveX

def fieldY : K := algebraMap CurveRing K curveY

def coefficientMap : CoefficientRing →ₐ[BaseField] K :=
  (IsScalarTower.toAlgHom BaseField CurveRing K).comp
    (IsScalarTower.toAlgHom BaseField CoefficientRing CurveRing)

@[simp]
theorem coefficientMap_X : coefficientMap K X = fieldY K := rfl

@[simp]
theorem coefficientMap_C (c : BaseField) : coefficientMap K (C c) = algebraMap BaseField K c :=
  (coefficientMap K).commutes c

theorem coefficientMap_eq_aeval : coefficientMap K = Polynomial.aeval (fieldY K) := by
  ext
  simp

variable [IsFractionRing CurveRing K]

theorem coefficientMap_injective : Function.Injective (coefficientMap K) := by
  exact (IsFractionRing.injective CurveRing K).comp
    (AdjoinRoot.of.injective_of_degree_ne_zero (f := quadraticEquation)
      (by rw [degree_eq_natDegree quadraticEquation_monic.ne_zero]; simp [quadraticEquation]))

theorem fieldY_transcendental : Transcendental BaseField (fieldY K) := by
  rw [transcendental_iff_injective, ← coefficientMap_eq_aeval]
  exact coefficientMap_injective K

abbrev YField := IntermediateField.adjoin BaseField ({fieldY K} : Set K)

omit [Algebra BaseField K] [IsScalarTower BaseField CurveRing K] in
theorem fieldX_ne_zero : fieldX K ≠ 0 := by
  exact (IsFractionRing.injective CurveRing K).ne curveX_ne_zero |>.trans_eq (map_zero _)

theorem adjoin_fieldX_over_YField_eq_top :
    IntermediateField.adjoin (YField K) ({fieldX K} : Set K) = ⊤ := by
  let E := IntermediateField.adjoin (YField K) ({fieldX K} : Set K)
  have hx : fieldX K ∈ E := IntermediateField.mem_adjoin_simple_self _ _
  have hy : fieldY K ∈ E :=
    E.algebraMap_mem ⟨fieldY K, IntermediateField.mem_adjoin_simple_self _ _⟩
  have hc (c : BaseField) : algebraMap BaseField K c ∈ E := by
    exact E.algebraMap_mem (algebraMap BaseField (YField K) c)
  have hcoeff : ∀ a : CoefficientRing, coefficientMap K a ∈ E := by
    intro a
    induction a using Polynomial.induction_on' with
    | add a b ha hb => simpa only [map_add] using E.add_mem ha hb
    | monomial n c =>
      rw [← C_mul_X_pow_eq_monomial, map_mul, map_pow, coefficientMap_C, coefficientMap_X]
      exact E.mul_mem (hc c) (E.toSubalgebra.pow_mem hy n)
  have hB : ∀ b : CurveRing, algebraMap CurveRing K b ∈ E := by
    intro b
    refine AdjoinRoot.induction_on quadraticEquation b ?_
    intro H
    induction H using Polynomial.induction_on' with
    | add a b ha hb => simpa only [map_add] using E.add_mem ha hb
    | monomial n c =>
      simp only [← C_mul_X_pow_eq_monomial, map_mul, map_pow, AdjoinRoot.mk_C, AdjoinRoot.mk_X]
      exact E.mul_mem (hcoeff c) (E.toSubalgebra.pow_mem hx n)
  apply top_unique
  intro z _
  obtain ⟨a, b, _, rfl⟩ := IsFractionRing.div_surjective CurveRing z
  exact E.div_mem (hB a) (hB b)

def cubicInY : YField K :=
  (⟨fieldY K, IntermediateField.mem_adjoin_simple_self _ _⟩ : YField K) ^ 3 -
    algebraMap BaseField (YField K) alpha

omit [IsFractionRing CurveRing K] in
theorem cubicInY_map : algebraMap (YField K) K (cubicInY K) = fieldX K ^ 2 := by
  have h := congrArg (algebraMap CurveRing K) curveX_sq_eq_curveY_cube
  change fieldY K ^ 3 - algebraMap BaseField K alpha = fieldX K ^ 2
  simpa only [map_pow, map_sub, ← IsScalarTower.algebraMap_apply BaseField CurveRing K,
    fieldX, fieldY] using h.symm

theorem cubicInY_ne_zero : cubicInY K ≠ 0 := by
  intro h
  have he := cubicInY_map K
  rw [h, map_zero] at he
  exact pow_ne_zero 2 (fieldX_ne_zero K) he.symm

theorem fieldX_isSeparable : IsSeparable (YField K) (fieldX K) := by
  let : CharP (YField K) 3 :=
    charP_of_injective_algebraMap (algebraMap BaseField (YField K)).injective 3
  change (minpoly (YField K) (fieldX K)).Separable
  apply (Polynomial.separable_X_pow_sub_C' 3 2 (cubicInY K) (by decide)
    (cubicInY_ne_zero K)).of_dvd
  apply minpoly.dvd
  simp only [map_sub, map_pow, Polynomial.aeval_X,
    Polynomial.aeval_C, sub_eq_zero]
  exact (cubicInY_map K).symm

theorem isSeparable_YField : Algebra.IsSeparable (YField K) K := by
  have h : Algebra.IsSeparable (YField K)
      (IntermediateField.adjoin (YField K) ({fieldX K} : Set K)) :=
    (IntermediateField.isSeparable_adjoin_simple_iff_isSeparable (YField K) K).mpr
      (fieldX_isSeparable K)
  rw [adjoin_fieldX_over_YField_eq_top] at h
  exact (IntermediateField.isSeparable_top (YField K) K).mp h

theorem fieldY_isTranscendenceBasis :
    IsTranscendenceBasis BaseField (fun _ : Unit ↦ fieldY K) := by
  have hi : AlgebraicIndependent BaseField (fun _ : Unit ↦ fieldY K) :=
    algebraicIndependent_unique_type_iff.mpr (fieldY_transcendental K)
  apply hi.isTranscendenceBasis_iff_isAlgebraic.mpr
  have hsep : Algebra.IsSeparable
      (IntermediateField.adjoin BaseField (Set.range fun _ : Unit ↦ fieldY K)) K := by
    rw [Set.range_const]
    exact isSeparable_YField K
  exact IntermediateField.isAlgebraic_adjoin_iff_top.mp inferInstance

theorem exists_separating_basis : ∃ s : Finset K,
    IsTranscendenceBasis BaseField ((↑) : s → K) ∧
      Algebra.IsSeparable (IntermediateField.adjoin BaseField (s : Set K)) K := by
  classical
  refine ⟨{fieldY K}, ?_, ?_⟩
  · let e : ({fieldY K} : Finset K) ≃ Unit :=
      { toFun := fun _ ↦ ()
        invFun := fun _ ↦ ⟨fieldY K, by simp⟩
        left_inv := fun z ↦ Subtype.ext (Finset.mem_singleton.mp z.property).symm
        right_inv := fun _ ↦ Subsingleton.elim _ _ }
    have he : (fun _ : Unit ↦ fieldY K) ∘ e =
        ((↑) : ({fieldY K} : Finset K) → K) := by
      funext z
      exact (Finset.mem_singleton.mp z.property).symm
    exact (isTranscendenceBasis_equiv' (R := BaseField) e he).mpr
      (fieldY_isTranscendenceBasis K)
  · rw [Finset.coe_singleton]
    exact isSeparable_YField K

end FractionField

instance nativeFunctionFieldAlgebra :
    Algebra CurveRing (Spec (.of CurveRing)).functionField :=
  AlgebraicGeometry.instAlgebraCarrierFunctionFieldSpec (CommRingCat.of CurveRing)

instance nativeFunctionField_isFractionRing :
    IsFractionRing CurveRing (Spec (.of CurveRing)).functionField :=
  functionField_isFractionRing_of_affine (CommRingCat.of CurveRing)

theorem canonicalFunctionFieldScalarTower :
    letI := SeparableGenericSmoothness.functionFieldAlgebra curveStructure
    IsScalarTower BaseField CurveRing (Spec (.of CurveRing)).functionField := by
  let := SeparableGenericSmoothness.functionFieldAlgebra curveStructure
  apply IsScalarTower.of_algebraMap_eq
  intro a
  exact AlgebraicGeometry.stalkMap_toStalk_apply
    (CommRingCat.ofHom (algebraMap BaseField CurveRing))
    (genericPoint (Spec (.of CurveRing))) a

/-- The actual curve's native structure map has a separably generated native function field. -/
theorem curveFunctionFieldSeparablyGenerated :
    SeparableGenericSmoothness.FunctionFieldSeparablyGenerated curveStructure := by
  let := SeparableGenericSmoothness.functionFieldAlgebra curveStructure
  let := canonicalFunctionFieldScalarTower
  exact exists_separating_basis (Spec (.of CurveRing)).functionField

end Hironaka.Geometry.ImperfectFieldExampleFunctionField
