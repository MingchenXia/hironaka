import Hironaka.Geometry.AlterationDivisor
import Hironaka.Geometry.ReducedClosedSubscheme
import Mathlib.RingTheory.MvPolynomial.Ideal
import Mathlib.RingTheory.RegularLocalRing.Polynomial
import Mathlib.RingTheory.Ideal.KrullsHeightTheorem
import Mathlib.Algebra.Squarefree.Basic

/-!
# Actual standard coordinate divisors

Coordinate ideals and their quotient polynomial rings are computed explicitly.
Their heights are derived from genuine strict chains and Krull's height theorem.
-/

set_option autoImplicit false

noncomputable section

open MvPolynomial AlgebraicGeometry CategoryTheory TopologicalSpace
open Hironaka.Geometry.SpecIdealSheaf
open Hironaka.Geometry.ReducedClosedSubscheme

namespace Hironaka.Geometry.CoordinateSNC

variable {k E : Type*} [Field k] [DecidableEq E]

/-- The actual ideal generated by a finite set of coordinate variables. -/
def coordinateIdeal (s : Finset E) : Ideal (MvPolynomial E k) :=
  Ideal.span (X '' (s : Set E))

/-- Evaluation kills precisely the selected coordinate variables. -/
def killCoordinates (s : Finset E) :
    MvPolynomial E k →ₐ[k] MvPolynomial {i : E // i ∉ s} k :=
  aeval (fun i ↦ if hi : i ∈ s then 0 else X ⟨i, hi⟩)

/-- Inclusion of the coordinates that survive evaluation. -/
def includeCoordinates (s : Finset E) :
    MvPolynomial {i : E // i ∉ s} k →ₐ[k] MvPolynomial E k :=
  rename Subtype.val

theorem kill_include (s : Finset E) (F : MvPolynomial {i : E // i ∉ s} k) :
    killCoordinates s (includeCoordinates s F) = F := by
  have h : (killCoordinates (k := k) s).comp (includeCoordinates s) = AlgHom.id k _ := by
    ext i
    simp [killCoordinates, includeCoordinates, i.property]
  exact DFunLike.congr_fun h F

theorem sub_include_kill_mem (s : Finset E) (F : MvPolynomial E k) :
    F - includeCoordinates s (killCoordinates s F) ∈ coordinateIdeal s := by
  induction F using MvPolynomial.induction_on with
  | C a => simp [includeCoordinates, killCoordinates]
  | add F G hF hG =>
      simpa only [map_add, add_sub_add_comm] using
        (coordinateIdeal (k := k) s).add_mem hF hG
  | mul_X F i hF =>
      by_cases hi : i ∈ s
      · simpa [killCoordinates, hi] using
          (coordinateIdeal (k := k) s).mul_mem_left F
            (Ideal.subset_span (Set.mem_image_of_mem X hi))
      · have h := (coordinateIdeal (k := k) s).mul_mem_right (X i) hF
        simpa [killCoordinates, includeCoordinates, hi, sub_mul] using h

theorem ker_killCoordinates (s : Finset E) :
    RingHom.ker (killCoordinates (k := k) s).toRingHom = coordinateIdeal s := by
  apply le_antisymm
  · intro F hF
    have hzero : killCoordinates s F = 0 := hF
    simpa only [hzero, map_zero, sub_zero] using sub_include_kill_mem s F
  · apply Ideal.span_le.mpr
    rintro _ ⟨i, hi, rfl⟩
    change killCoordinates s (X i) = 0
    change i ∈ s at hi
    simp [killCoordinates, hi]

/-- The actual coordinate quotient is the polynomial ring on the remaining coordinates. -/
def coordinateQuotientEquiv (s : Finset E) :
    (MvPolynomial E k ⧸ coordinateIdeal s) ≃ₐ[k]
      MvPolynomial {i : E // i ∉ s} k :=
  (Ideal.quotientEquivAlgOfEq k (ker_killCoordinates (k := k) s).symm).trans
    (Ideal.quotientKerAlgEquivOfSurjective
      (fun F ↦ ⟨includeCoordinates s F, kill_include s F⟩))

instance coordinateIdeal_isPrime (s : Finset E) : (coordinateIdeal (k := k) s).IsPrime := by
  rw [← ker_killCoordinates]
  exact RingHom.ker_isPrime _

theorem X_not_mem_coordinateIdeal (s : Finset E) {i : E} (hi : i ∉ s) :
    (X i : MvPolynomial E k) ∉ coordinateIdeal s := by
  intro h
  rw [← ker_killCoordinates] at h
  have hzero : killCoordinates s (X i : MvPolynomial E k) = 0 := h
  simp [killCoordinates, hi] at hzero

omit [DecidableEq E] in
theorem coordinateIdeal_mono {s t : Finset E} (h : s ⊆ t) :
    coordinateIdeal (k := k) s ≤ coordinateIdeal t :=
  Ideal.span_mono (Set.image_mono h)

theorem coordinateIdeal_lt_insert (s : Finset E) {i : E} (hi : i ∉ s) :
    coordinateIdeal (k := k) s < coordinateIdeal (insert i s) := by
  refine lt_of_le_of_ne (coordinateIdeal_mono (Finset.subset_insert _ _)) ?_
  intro heq
  apply X_not_mem_coordinateIdeal (k := k) s hi
  rw [heq]
  exact Ideal.subset_span (Set.mem_image_of_mem X (Finset.mem_insert_self _ _))

theorem coordinateIdeal_height_ge (s : Finset E) :
    (s.card : ℕ∞) ≤ (coordinateIdeal (k := k) s).height := by
  induction s using Finset.induction_on with
  | empty => simp
  | @insert i s hi ih =>
      rw [Finset.card_insert_of_notMem hi, Nat.cast_add, Nat.cast_one]
      exact (add_le_add ih (le_refl (1 : ℕ∞))).trans
        (Ideal.height_add_one_le_of_lt_of_isPrime (coordinateIdeal_lt_insert s hi))

/-- Coordinate-prime height is derived, not assumed. -/
theorem coordinateIdeal_height [Finite E] (s : Finset E) :
    (coordinateIdeal (k := k) s).height = s.card := by
  classical
  apply le_antisymm ?_ (coordinateIdeal_height_ge s)
  have heq : Ideal.span (↑(s.image (X (R := k))) : Set (MvPolynomial E k)) =
      coordinateIdeal (k := k) s := by simp [coordinateIdeal]
  have hmem : coordinateIdeal (k := k) s ∈
      (Ideal.span (↑(s.image (X (R := k))) : Set (MvPolynomial E k))).minimalPrimes := by
    rw [heq, Ideal.minimalPrimes_eq_subsingleton_self]
    exact Set.mem_singleton _
  exact (Ideal.height_le_card_of_mem_minimalPrimes_span_finset hmem).trans
    (by exact_mod_cast Finset.card_image_le)

theorem coordinateQuotient_isRegularRing [Finite E] (s : Finset E) :
    IsRegularRing (MvPolynomial E k ⧸ coordinateIdeal s) :=
  IsRegularRing.of_ringEquiv (coordinateQuotientEquiv (k := k) s).toRingEquiv.symm

theorem X_prime (i : E) : Prime (X i : MvPolynomial E k) := by
  apply (Ideal.span_singleton_prime (X_ne_zero i)).mp
  simpa only [coordinateIdeal, Finset.coe_singleton, Set.image_singleton] using
    coordinateIdeal_isPrime (k := k) {i}

theorem X_isRelPrime {i j : E} (hij : i ≠ j) :
    IsRelPrime (X i : MvPolynomial E k) (X j) := by
  apply (X_prime (k := k) i).irreducible.isRelPrime_iff_not_dvd.mpr
  intro h
  apply X_not_mem_coordinateIdeal (k := k) {i} (by simpa using hij.symm)
  simpa only [coordinateIdeal, Finset.coe_singleton, Set.image_singleton,
    Ideal.mem_span_singleton] using h

/-- The ideal of the union of coordinate hyperplanes is genuinely radical. -/
theorem coordinateProduct_isRadical (s : Finset E) :
    (Ideal.span {∏ i ∈ s, (X i : MvPolynomial E k)}).IsRadical := by
  apply isRadical_iff_span_singleton.mp
  apply Squarefree.isRadical
  apply Finset.squarefree_prod_of_pairwise_isCoprime
  · intro i _ j _ hij
    exact X_isRelPrime hij
  · intro i _
    exact (X_prime i).irreducible.squarefree

variable (R : Type*) [CommRing R]

/-- A regular coordinate ring gives regular native spectrum stalks. -/
theorem isRegularScheme_spec_of_isRegularRing [IsRegularRing R] :
    IsRegularScheme (Spec (CommRingCat.of R)) := by
  intro x
  let p : PrimeSpectrum R := x
  let : p.asIdeal.IsPrime := p.isPrime
  exact IsRegularLocalRing.of_ringEquiv
    (Spec.stalkIso (CommRingCat.of R) p).symm.commRingCatIsoToRingEquiv

set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- Regularity of the actual affine quotient passes to its native closed subscheme. -/
theorem isRegularScheme_specIdealSheaf_subscheme (I : Ideal R)
    [IsRegularRing (R ⧸ I)] : IsRegularScheme (specIdealSheaf R I).subscheme := by
  let D := specIdealSheaf R I
  let U : (Spec (CommRingCat.of R)).affineOpens := ⟨⊤, isAffineOpen_top _⟩
  let f := D.subschemeCover.f U
  have htop : f.opensRange = ⊤ := by simp [f, U]
  let : IsIso f := isIso_of_isOpenImmersion_of_opensRange_eq_top f htop
  let e : R ≃+* Γ(Spec (CommRingCat.of R), ⊤) :=
    (Scheme.ΓSpecIso (CommRingCat.of R)).symm.commRingCatIsoToRingEquiv
  let eQ := Ideal.quotientEquiv I (D.ideal U) e (specIdealSheaf_ideal_top R I)
  let : IsRegularRing (Γ(Spec (CommRingCat.of R), ⊤) ⧸ D.ideal U) :=
    IsRegularRing.of_ringEquiv eQ
  exact (isRegularScheme_spec_of_isRegularRing _).of_isOpenImmersion (asIso f).inv

variable {R}

/-- The native closed coordinate intersection. -/
def coordinateClosed (s : Finset E) : Closeds (Spec (CommRingCat.of (MvPolynomial E k))) :=
  (specIdealSheaf (MvPolynomial E k) (coordinateIdeal s)).support

theorem coordinateClosed_isIrreducible (s : Finset E) :
    IsIrreducible (coordinateClosed (k := k) s :
      Set (Spec (CommRingCat.of (MvPolynomial E k)))) := by
  rw [coordinateClosed, specIdealSheaf_support]
  exact (PrimeSpectrum.isIrreducible_zeroLocus_iff_of_radical _
    (coordinateIdeal_isPrime s).isRadical).mpr inferInstance

set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- Pure codimension is computed in the actual ambient scheme stalks. -/
theorem coordinateClosed_hasPureCodimension [Finite E] (s : Finset E) :
    HasPureCodimension (coordinateClosed (k := k) s) s.card := by
  let T := coordinateClosed (k := k) s
  let : IrreducibleSpace T := Subtype.irreducibleSpace (coordinateClosed_isIrreducible s)
  intro C hC x hx
  have hCeq : C = Set.univ := by
    simpa only [irreducibleComponents_eq_singleton, Set.mem_singleton_iff] using hC
  let q : Spec (CommRingCat.of (MvPolynomial E k)) :=
    (⟨coordinateIdeal s, inferInstance⟩ : PrimeSpectrum (MvPolynomial E k))
  have hgeneric : IsGenericPoint q
      (T : Set (Spec (CommRingCat.of (MvPolynomial E k)))) := by
    have h := PrimeSpectrum.closure_singleton
      (⟨coordinateIdeal s, inferInstance⟩ : PrimeSpectrum (MvPolynomial E k))
    exact h.trans (specIdealSheaf_support _ _).symm
  have himage : (Subtype.val : T → Spec (CommRingCat.of (MvPolynomial E k))) '' C =
      (T : Set (Spec (CommRingCat.of (MvPolynomial E k)))) := by
    ext y
    simp [hCeq]
  have hxeq : x = q := by
    rw [himage] at hx
    exact hx.eq hgeneric
  rw [hxeq, ringKrullDim_stalk_eq_coheight, ← idealHeight_eq_coheight]
  exact_mod_cast coordinateIdeal_height (k := k) s

/-- The actual native divisor cut out by a product of distinct coordinates. -/
def coordinateDivisor (s : Finset E) :
    (Spec (CommRingCat.of (MvPolynomial E k))).IdealSheafData :=
  specIdealSheaf (MvPolynomial E k) (Ideal.span {∏ i ∈ s, X i})

set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
omit [DecidableEq E] in
theorem coordinateDivisor_support (s : Finset E) :
    ((coordinateDivisor (k := k) s).support :
      Set (Spec (CommRingCat.of (MvPolynomial E k)))) =
    ⋃ i ∈ s, (coordinateClosed (k := k) {i} :
      Set (Spec (CommRingCat.of (MvPolynomial E k)))) := by
  have hring : PrimeSpectrum.zeroLocus
      (Ideal.span {∏ i ∈ s, (X i : MvPolynomial E k)} : Set (MvPolynomial E k)) =
      ⋃ i ∈ s, PrimeSpectrum.zeroLocus (coordinateIdeal (k := k) {i} : Set (MvPolynomial E k)) := by
    ext p
    let : p.asIdeal.IsPrime := p.isPrime
    simp only [coordinateIdeal, Finset.coe_singleton, Set.image_singleton,
      PrimeSpectrum.zeroLocus_span, PrimeSpectrum.mem_zeroLocus,
      Set.singleton_subset_iff, Set.mem_iUnion]
    constructor
    · intro h
      obtain ⟨i, hi, hXi⟩ := (Ideal.IsPrime.prod_mem_iff (p := p.asIdeal) (s := s)
        (x := fun i ↦ (X i : MvPolynomial E k))).mp h
      exact ⟨i, hi, hXi⟩
    · rintro ⟨i, hi, hXi⟩
      exact (Ideal.IsPrime.prod_mem_iff (p := p.asIdeal) (s := s)
        (x := fun i ↦ (X i : MvPolynomial E k))).mpr ⟨i, hi, hXi⟩
  simpa only [coordinateDivisor, coordinateClosed, specIdealSheaf_support] using hring

theorem coordinateClosed_singleton_injective :
    Function.Injective (coordinateClosed (k := k) ∘ (Singleton.singleton : E → Finset E)) := by
  intro i j hij
  change coordinateClosed (k := k) {i} = coordinateClosed {j} at hij
  by_contra hne
  let p : PrimeSpectrum (MvPolynomial E k) := ⟨coordinateIdeal {i}, inferInstance⟩
  have hpi : p ∈ (coordinateClosed (k := k) {i} :
      Set (Spec (CommRingCat.of (MvPolynomial E k)))) := by
    rw [coordinateClosed, specIdealSheaf_support]
    change coordinateIdeal (k := k) {i} ≤ coordinateIdeal {i}
    exact le_rfl
  have hpj : p ∈ (coordinateClosed (k := k) {j} :
      Set (Spec (CommRingCat.of (MvPolynomial E k)))) := by
    rw [← hij]
    exact hpi
  rw [coordinateClosed, specIdealSheaf_support] at hpj
  apply X_not_mem_coordinateIdeal (k := k) {i} (by simpa using (Ne.symm hne))
  exact hpj (Ideal.subset_span (Set.mem_image_of_mem X (Finset.mem_singleton_self j)))

set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- Actual components of the coordinate union are its coordinate hyperplanes. -/
theorem component_eq_coordinateClosed (s : Finset E)
    (C : DivisorComponent (coordinateDivisor (k := k) s)) :
    ∃ i ∈ s, C.val = coordinateClosed {i} := by
  classical
  let X := Spec (CommRingCat.of (MvPolynomial E k))
  let D := coordinateDivisor (k := k) s
  obtain ⟨S, hS, hC⟩ := C.property
  have hirred : IsIrreducible (C.val : Set X) := by
    rw [← hC]
    exact hS.1.image Subtype.val continuous_subtype_val.continuousOn
  have hcover : (C.val : Set X) ⊆
      ⋃₀ ↑(s.image (fun i ↦ (coordinateClosed (k := k) {i} : Set X))) := by
    intro x hx
    obtain ⟨y, _, rfl⟩ := hC ▸ hx
    have hy : y.val ∈ ((coordinateDivisor (k := k) s).support : Set X) := y.property
    rw [coordinateDivisor_support] at hy
    obtain ⟨i, hxi⟩ := Set.mem_iUnion.mp hy
    obtain ⟨his, hxi⟩ := Set.mem_iUnion.mp hxi
    exact Set.mem_sUnion.mpr ⟨_, Finset.mem_coe.mpr (Finset.mem_image.mpr ⟨i, his, rfl⟩), hxi⟩
  obtain ⟨Z, hZ, hCZ⟩ := isIrreducible_iff_sUnion_isClosed.mp hirred
    (s.image (fun i ↦ (coordinateClosed (k := k) {i} : Set X)))
    (by intro Z hZ; obtain ⟨i, _, rfl⟩ := Finset.mem_image.mp hZ;
        exact (coordinateClosed (k := k) {i}).isClosed) hcover
  obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp hZ
  have haxis : (coordinateClosed (k := k) {i} : Set X) ⊆ D.support := by
    rw [coordinateDivisor_support]
    exact Set.subset_iUnion_of_subset i (Set.subset_iUnion_of_subset hi (Set.Subset.refl _))
  let g : coordinateClosed (k := k) {i} → D.support :=
    fun x ↦ ⟨x.val, haxis x.property⟩
  have hg : Continuous g := continuous_subtype_val.subtype_mk _
  let : IrreducibleSpace (coordinateClosed (k := k) {i}) :=
    Subtype.irreducibleSpace (coordinateClosed_isIrreducible {i})
  have hgirred : IsIrreducible (g '' Set.univ) :=
    (IrreducibleSpace.isIrreducible_univ _).image g hg.continuousOn
  have hSg : S ⊆ g '' Set.univ := by
    intro y hy
    have hyaxis := hCZ (hC ▸ Set.mem_image_of_mem Subtype.val hy)
    exact ⟨⟨y.val, hyaxis⟩, Set.mem_univ _, Subtype.ext rfl⟩
  have hgS : g '' Set.univ ⊆ S := hS.2 hgirred hSg
  refine ⟨i, hi, Closeds.ext (Set.Subset.antisymm hCZ ?_)⟩
  intro x hx
  rw [← hC]
  exact Set.mem_image_of_mem Subtype.val (hgS ⟨⟨x, hx⟩, Set.mem_univ _, rfl⟩)

/-- The unique coordinate index of an actual irreducible component. -/
def componentIndex (s : Finset E) (C : DivisorComponent (coordinateDivisor (k := k) s)) : E :=
  (component_eq_coordinateClosed s C).choose

theorem componentIndex_mem (s : Finset E)
    (C : DivisorComponent (coordinateDivisor (k := k) s)) : componentIndex s C ∈ s :=
  (component_eq_coordinateClosed s C).choose_spec.1

theorem componentIndex_closed (s : Finset E)
    (C : DivisorComponent (coordinateDivisor (k := k) s)) :
    C.val = coordinateClosed {componentIndex s C} :=
  (component_eq_coordinateClosed s C).choose_spec.2

theorem componentIndex_injective (s : Finset E) :
    Function.Injective (componentIndex (k := k) s) := by
  intro C C' h
  apply Subtype.ext
  rw [componentIndex_closed s C, componentIndex_closed s C', h]

theorem vanishingIdeal_coordinateClosed (s : Finset E) :
    Scheme.IdealSheafData.vanishingIdeal (coordinateClosed (k := k) s) =
      specIdealSheaf (MvPolynomial E k) (coordinateIdeal s) := by
  apply idealSheaf_eq_of_radical_of_support_eq
  · exact radical_vanishingIdeal _
  · rw [specIdealSheaf_radical, (coordinateIdeal_isPrime s).isRadical.radical]
  · rfl

/-- The native scheme-theoretic intersection is the coordinate ideal of its
actual distinct components, without taking an extra radical. -/
theorem componentIntersection_coordinateDivisor (s : Finset E)
    (J : Finset (DivisorComponent (coordinateDivisor (k := k) s))) :
    componentIntersection (coordinateDivisor s) J =
      specIdealSheaf (MvPolynomial E k) (coordinateIdeal (J.image (componentIndex s))) := by
  classical
  have hcoord : (⨆ C ∈ J, coordinateIdeal (k := k) {componentIndex s C}) =
      coordinateIdeal (J.image (componentIndex s)) := by
    apply le_antisymm
    · refine iSup_le fun C ↦ iSup_le fun hC ↦ coordinateIdeal_mono ?_
      simpa only [Finset.singleton_subset_iff] using Finset.mem_image_of_mem (componentIndex s) hC
    · apply Ideal.span_le.mpr
      rintro _ ⟨i, hi, rfl⟩
      obtain ⟨C, hC, rfl⟩ := Finset.mem_image.mp hi
      have hinc : coordinateIdeal (k := k) {componentIndex s C} ≤
          ⨆ C ∈ J, coordinateIdeal (k := k) {componentIndex s C} :=
        le_iSup_of_le C (le_iSup_of_le hC le_rfl)
      exact hinc (Ideal.subset_span (Set.mem_image_of_mem X (Finset.mem_singleton_self _)))
  calc
    componentIntersection (coordinateDivisor s) J =
        ⨆ C ∈ J, specIdealSheaf (MvPolynomial E k) (coordinateIdeal {componentIndex s C}) := by
      simp only [componentIntersection, componentIndex_closed s, vanishingIdeal_coordinateClosed]
    _ = specIdealSheaf (MvPolynomial E k)
        (⨆ C ∈ J, coordinateIdeal {componentIndex s C}) :=
      ((specIdealSheafEquiv (MvPolynomial E k)).symm.map_iSup₂ _).symm
    _ = _ := congrArg _ hcoord

theorem coordinateDivisor_isReduced (s : Finset E) :
    IsReduced (coordinateDivisor (k := k) s).subscheme := by
  have hrad : (coordinateDivisor (k := k) s).radical = coordinateDivisor s := by
    rw [coordinateDivisor, specIdealSheaf_radical, (coordinateProduct_isRadical s).radical]
  simpa only [hrad] using isReduced_radical_subscheme (coordinateDivisor (k := k) s)

set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
omit [DecidableEq E] in
theorem coordinateDivisor_isEffectiveCartier (s : Finset E) :
    IsEffectiveCartierDivisor (coordinateDivisor (k := k) s) := by
  intro x
  let e : MvPolynomial E k ≃+* Γ(Spec (CommRingCat.of (MvPolynomial E k)), ⊤) :=
    (Scheme.ΓSpecIso (CommRingCat.of (MvPolynomial E k))).symm.commRingCatIsoToRingEquiv
  have hprod : (∏ i ∈ s, (X i : MvPolynomial E k)) ≠ 0 := by
    exact Finset.prod_ne_zero_iff.mpr (fun i _ ↦ X_ne_zero i)
  have ht : IsRegular (e (∏ i ∈ s, X i)) := by
    constructor
    · intro a b hab
      apply e.symm.injective
      apply mul_left_cancel₀ hprod
      simpa only [map_mul, e.symm_apply_apply] using congrArg e.symm hab
    · intro a b hab
      apply e.symm.injective
      apply mul_right_cancel₀ hprod
      simpa only [map_mul, e.symm_apply_apply] using congrArg e.symm hab
  refine ⟨⟨⊤, isAffineOpen_top _⟩, trivial, e (∏ i ∈ s, X i), ht, ?_⟩
  rw [coordinateDivisor, specIdealSheaf_ideal_top, Ideal.map_span, Set.image_singleton]
  rfl

/-- Every actual standard coordinate divisor has strict normal crossings,
including all its genuine scheme-theoretic component intersections. -/
theorem isStrictNormalCrossings_coordinateDivisor [Finite E] (s : Finset E) :
    IsStrictNormalCrossings (coordinateDivisor (k := k) s) := by
  refine ⟨coordinateDivisor_isEffectiveCartier s, coordinateDivisor_isReduced s,
    ?_, ?_, ?_⟩
  · intro x _
    exact isRegularScheme_spec_of_isRegularRing (MvPolynomial E k) x
  · intro J _
    rw [componentIntersection_coordinateDivisor]
    let : IsRegularRing (MvPolynomial E k ⧸ coordinateIdeal (J.image (componentIndex s))) :=
      coordinateQuotient_isRegularRing _
    exact isRegularScheme_specIdealSheaf_subscheme _ _
  · intro J _
    rw [componentIntersection_coordinateDivisor]
    have hcard : (J.image (componentIndex s)).card = J.card :=
      Finset.card_image_of_injective _ (componentIndex_injective s)
    rw [← hcard]
    exact coordinateClosed_hasPureCodimension _

/-- A nonempty coordinate family gives a genuinely nonempty native divisor. -/
theorem coordinateDivisor_support_nonempty (s : Finset E) (hs : s.Nonempty) :
    ((coordinateDivisor (k := k) s).support :
      Set (Spec (CommRingCat.of (MvPolynomial E k)))).Nonempty := by
  obtain ⟨i, hi⟩ := hs
  obtain ⟨x, hx⟩ := (coordinateClosed_isIrreducible (k := k) {i}).nonempty
  refine ⟨x, ?_⟩
  rw [coordinateDivisor_support]
  exact Set.mem_iUnion.mpr ⟨i, Set.mem_iUnion.mpr ⟨hi, hx⟩⟩

/-- In particular the two actual coordinate axes in the affine plane form an SNC divisor. -/
theorem isStrictNormalCrossings_affinePlane_axes :
    IsStrictNormalCrossings (specIdealSheaf (MvPolynomial (Fin 2) k)
      (Ideal.span {(X 0 * X 1 : MvPolynomial (Fin 2) k)})) := by
  simpa only [coordinateDivisor, Fin.prod_univ_two] using
    isStrictNormalCrossings_coordinateDivisor (k := k) (Finset.univ : Finset (Fin 2))

end Hironaka.Geometry.CoordinateSNC
