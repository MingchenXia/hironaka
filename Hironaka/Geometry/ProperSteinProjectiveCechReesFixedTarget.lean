import Hironaka.Geometry.ProperSteinProjectiveCechReesDegreeTransitions
import Hironaka.Geometry.ProperSteinProjectiveCechReesPowerCohomologyFinite

/-! # Actual original fixed-target cohomology image filtrations

Only closed native proof adapted from
`EnvelopeProperty/EnvelopeProperty/AlgGeom/FormalFunctionsFixedTarget.lean`,
SHA256 1c3ec98dbf68a5df2334783b0718495a6e4a4c71ce7b80beb8785d4ce790a6f7.
Actual ORIGINAL projective endpoints replace external general coherent
finiteness; every native original scalar, transition, image and tail is retained.
-/
open CategoryTheory AlgebraicGeometry
open scoped Polynomial DirectSum
noncomputable section
universe u
namespace Hironaka.Geometry.ProperSteinProjectiveCech.ReesFixedTarget
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option maxHeartbeats 800000
set_option maxRecDepth 4096
section OriginalFamily
private def linearLocus {A M N : Type u} [Semiring A]
    [AddCommGroup M] [Module A M] [AddCommGroup N] [Module A N]
    (L : M →+ N) : Submodule A M where
  carrier := {x | ∀ a : A, L (a • x) = a • L x}
  zero_mem' a := by simp only [smul_zero, map_zero]
  add_mem' hx hy a := by rw [smul_add, map_add, hx a, hy a, map_add, smul_add]
  smul_mem' b x hx a := by rw [smul_smul, hx (a * b), mul_smul, hx b]

variable {R : Type u} [CommRing R] (I : Ideal R)
variable {X : Scheme.{u}} (f : X ⟶ Spec (.of R))
variable [X.IsSeparated] {ι : Type u} [LinearOrder ι] [Fintype ι]
variable (U : ι → X.Opens) (hU : ∀ i, IsAffineOpen (U i))

omit [X.IsSeparated] [Fintype ι] in
private abbrev H (d q : ℕ) := (ReesPowerDiagram.powerComplex I f U d).homology q
omit [X.IsSeparated] [Fintype ι] in
private abbrev M (q : ℕ) := ReesDegreeHomology.powerHomology I f U q


omit [X.IsSeparated] [Fintype ι] in
/-- The SAME actual native original homogeneous-multiplication cohomology map. -/
def homologyMultiply {e : ℕ} (a : ↥(I^e)) (d q : ℕ) :
    H I f U d q ⟶ H I f U (e+d) q :=
  (HomologicalComplex.homologyFunctor (ModuleCat.{u} R) (.up ℕ) q).map
    (ReesPowerDiagram.homogeneousComplexMap I f U a d)

/-- The ACTUAL tail is the genuine Rees submodule generated by ALL
unchanged original cohomology summands of degree at least the original target. -/
def tailSpan (n q : ℕ) :
    letI := ReesDegreeHomology.reesModule I f U hU q
    Submodule (reesAlgebra I) (M I f U q) := by
  let := ReesDegreeHomology.reesModule I f U hU q
  exact Submodule.span (reesAlgebra I)
    {x | ∃ d, ∃ y : H I f U (n + d) q,
      DirectSum.lof R ℕ (fun j => H I f U j q) (n + d) y = x}

omit [X.IsSeparated] [Fintype ι] in
/-- The original transition polynomial map, with zero below the fixed
target and unchanged original transitions and shifted degrees above it. -/
def polynomialMap (n q : ℕ) :
    M I f U q →ₗ[R] PolynomialModule R (H I f U n q) :=
  DirectSum.toModule R ℕ (M := fun d => H I f U d q) _ fun d =>
    if h : n ≤ d then
      (PolynomialModule.lsingle R (d - n)).comp (ReesDegreeTransitions.homologyLower I f U h q).hom
    else 0

omit [X.IsSeparated] [Fintype ι] in
/-- EVERY actual original higher-degree summand retains its entire
literal original transition image and the precise shifted polynomial degree. -/
theorem polynomialMap_lof_of_le (n q d : ℕ) (h : n ≤ d) (x : H I f U d q) :
    polynomialMap I f U n q
        (DirectSum.lof R ℕ (fun j => H I f U j q) d x) =
      PolynomialModule.single R (d - n) ((ReesDegreeTransitions.homologyLower I f U h q).hom x) := by
  simp only [polynomialMap, DirectSum.toModule_lof, dif_pos h]
  rfl

omit [X.IsSeparated] [Fintype ι] in
/-- At EVERY original tail generator the polynomial exponent is exactly
its original excess over the fixed target, with the same whole original class. -/
theorem polynomialMap_lof (n q d : ℕ) (x : H I f U (n + d) q) :
    polynomialMap I f U n q
        (DirectSum.lof R ℕ (fun j => H I f U j q) (n + d) x) =
      PolynomialModule.single R d
        ((ReesDegreeTransitions.homologyLower I f U (Nat.le_add_right n d) q).hom x) := by
  exact (polynomialMap_lof_of_le I f U n q (n + d) (Nat.le_add_right n d) x).trans
    (congrArg (fun k => PolynomialModule.single R k
      ((ReesDegreeTransitions.homologyLower I f U (Nat.le_add_right n d) q).hom x))
        (Nat.add_sub_cancel_left n d))

/-- The original tail transition map commutes with EVERY genuine Rees scalar
on EVERY original tail generator, proved from the ACTUAL homogeneous action. -/
theorem polynomialMap_tail_smul (n q d : ℕ) (x : H I f U (n + d) q)
    (p : reesAlgebra I) :
    letI := ReesDegreeHomology.reesModule I f U hU q
    polynomialMap I f U n q
        (p • DirectSum.lof R ℕ (fun j => H I f U j q) (n + d) x) =
      p • polynomialMap I f U n q
        (DirectSum.lof R ℕ (fun j => H I f U j q) (n + d) x) := by
  let := ReesDegreeHomology.reesModule I f U hU q
  induction p using ReesLinear.rees_induction_on I with
  | hzero => simp only [zero_smul, map_zero]
  | hadd p r hp hr => rw [add_smul, map_add, hp, hr, add_smul]
  | hmonomial e a =>
    rw [ReesHomogeneousAction.reesModule_homogeneous,
      polynomialMap_lof_of_le I f U n q (e + (n + d))
        ((Nat.le_add_right n d).trans (Nat.le_add_left (n + d) e)),
      polynomialMap_lof]
    change PolynomialModule.single R (e + (n + d) - n)
        ((ReesDegreeTransitions.homologyLower I f U
          ((Nat.le_add_right n d).trans (Nat.le_add_left (n + d) e)) q).hom
          ((homologyMultiply I f U a (n + d) q).hom x)) =
      Polynomial.monomial e (a : R) • PolynomialModule.single R d
        ((ReesDegreeTransitions.homologyLower I f U (Nat.le_add_right n d) q).hom x)
    rw [PolynomialModule.monomial_smul_single]
    have h := congrArg (fun b => b.hom x)
      (ReesDegreeTransitions.homologyMultiply_lower I f U a (Nat.le_add_right n d) q)
    have hk : e + (n + d) - n = e + d := by omega
    exact (congrArg (fun k => PolynomialModule.single R k
      ((ReesDegreeTransitions.homologyLower I f U
        ((Nat.le_add_right n d).trans (Nat.le_add_left (n + d) e)) q).hom
        ((homologyMultiply I f U a (n + d) q).hom x))) hk).trans
      (congrArg (PolynomialModule.single R (e + d)) h)

private theorem tailSpan_le_linearLocus (n q : ℕ) :
    letI := ReesDegreeHomology.reesModule I f U hU q
    tailSpan I f U hU n q ≤ linearLocus (polynomialMap I f U n q).toAddMonoidHom := by
  let := ReesDegreeHomology.reesModule I f U hU q
  unfold tailSpan
  apply Submodule.span_le.mpr
  rintro _ ⟨d, x, rfl⟩
  exact polynomialMap_tail_smul I f U hU n q d x

/-- Restrict the ORIGINAL transition polynomial map to the ACTUAL tail;
this is genuinely Rees-linear on the entire original submodule. -/
def tailReesMap (n q : ℕ) :
    letI := ReesDegreeHomology.reesModule I f U hU q
    tailSpan I f U hU n q →ₗ[reesAlgebra I] PolynomialModule R (H I f U n q) := by
  let := ReesDegreeHomology.reesModule I f U hU q
  exact {
    toFun := fun x => polynomialMap I f U n q x.1
    map_add' := fun x y => (polynomialMap I f U n q).map_add x.1 y.1
    map_smul' := fun p x => (tailSpan_le_linearLocus I f U hU n q x.2) p }

omit [X.IsSeparated] [Fintype ι] in
private def imageAt (n q : ℕ) (j : {j : ℕ // n ≤ j}) : Submodule R (H I f U n q) :=
  LinearMap.range (ReesDegreeTransitions.homologyLower I f U j.2 q).hom

omit [X.IsSeparated] [Fintype ι] in
/-- The ENTIRE actual original images into EVERY fixed original ideal-power
cohomology group form their genuine original I-filtration. -/
def imageFiltration (n q : ℕ) : I.Filtration (H I f U n q) where
  N d := imageAt I f U n q ⟨n + d, Nat.le_add_right n d⟩
  mono d := by
    rintro _ ⟨y, rfl⟩
    refine ⟨(ReesDegreeTransitions.homologyLower I f U (Nat.add_le_add_left (Nat.le_succ d) n) q).hom y, ?_⟩
    exact congrArg (fun b => b.hom y)
      (ReesDegreeTransitions.homologyLower_comp I f U (Nat.le_add_right n d)
        (Nat.add_le_add_left (Nat.le_succ d) n) q)
  smul_le d := Submodule.smul_le.mpr (by
    intro a ha x hx
    rcases hx with ⟨y, rfl⟩
    let b : ↥(I ^ 1) := ⟨a, by simpa only [pow_one] using ha⟩
    let j₁ : {j : ℕ // n ≤ j} :=
      ⟨1 + (n + d), (Nat.le_add_right n d).trans (Nat.le_add_left (n + d) 1)⟩
    let j₂ : {j : ℕ // n ≤ j} := ⟨n + (d + 1), Nat.le_add_right n (d + 1)⟩
    have he : j₁ = j₂ := Subtype.ext (by dsimp only [j₁, j₂]; omega)
    have hmem : a • (ReesDegreeTransitions.homologyLower I f U (Nat.le_add_right n d) q).hom y ∈
        imageAt I f U n q j₁ :=
      ⟨(homologyMultiply I f U b (n + d) q).hom y,
        congrArg (fun c => c.hom y)
          (ReesDegreeTransitions.homologyMultiply_lower I f U b (Nat.le_add_right n d) q)⟩
    exact (congrArg (fun j =>
      a • (ReesDegreeTransitions.homologyLower I f U (Nat.le_add_right n d) q).hom y ∈
        imageAt I f U n q j) he).mp hmem)

omit [X.IsSeparated] [Fintype ι] in
/-- The fixed-target ORIGINAL image filtration starts at the WHOLE SAME
original cohomology module. -/
theorem imageFiltration_zero (n q : ℕ) : (imageFiltration I f U n q).N 0 = ⊤ := by
  change LinearMap.range (ReesDegreeTransitions.homologyLower I f U (Nat.le_add_right n 0) q).hom = ⊤
  rw [ReesDegreeTransitions.homologyLower_self]
  exact LinearMap.range_id

omit [X.IsSeparated] [Fintype ι] in
/-- The WHOLE actual original transition polynomial belongs to the SAME
original fixed-target associated image module, retaining every original coefficient. -/
theorem polynomialMap_mem (n q : ℕ) (x : M I f U q) :
    polynomialMap I f U n q x ∈ (imageFiltration I f U n q).submodule := by
  induction x using DirectSum.induction_on with
  | zero =>
    rw [map_zero]
    exact Submodule.zero_mem _
  | add x y hx hy =>
    rw [map_add]
    exact Submodule.add_mem _ hx hy
  | of e y =>
    change polynomialMap I f U n q
      (DirectSum.lof R ℕ (fun j => H I f U j q) e y) ∈ _
    by_cases h : n ≤ e
    · rw [polynomialMap_lof_of_le I f U n q e h]
      intro d
      rw [PolynomialModule.coeff_single, Finsupp.single_apply]
      split_ifs with hd
      · have he : (⟨e, h⟩ : {j : ℕ // n ≤ j}) =
            ⟨n + d, Nat.le_add_right n d⟩ := Subtype.ext (by change e = n + d; omega)
        have hm : (ReesDegreeTransitions.homologyLower I f U h q).hom y ∈
            imageAt I f U n q ⟨e, h⟩ := ⟨y, rfl⟩
        exact (congrArg (fun j => (ReesDegreeTransitions.homologyLower I f U h q).hom y ∈
          imageAt I f U n q j) he).mp hm
      · exact Submodule.zero_mem _
    · have hz : polynomialMap I f U n q
          (DirectSum.lof R ℕ (fun j => H I f U j q) e y) = 0 := by
        simp only [polynomialMap, DirectSum.toModule_lof, dif_neg h, LinearMap.zero_apply]
      rw [hz]
      exact Submodule.zero_mem _

/-- The ACTUAL original tail Rees map has ENTIRE range equal to the SAME
original fixed-target filtration module, not merely a dense or radical submodule. -/
theorem tailReesMap_range (n q : ℕ) :
    letI := ReesDegreeHomology.reesModule I f U hU q
    (tailReesMap I f U hU n q).range = (imageFiltration I f U n q).submodule := by
  let := ReesDegreeHomology.reesModule I f U hU q
  apply le_antisymm
  · rintro _ ⟨x, rfl⟩
    exact polynomialMap_mem I f U n q x.1
  · rw [← (imageFiltration I f U n q).submodule_span_single]
    apply Submodule.span_le.mpr
    rw [Set.iUnion_subset_iff]
    intro d z hz
    rcases hz with ⟨x, hx, rfl⟩
    change x ∈ LinearMap.range
      (ReesDegreeTransitions.homologyLower I f U (Nat.le_add_right n d) q).hom at hx
    rcases hx with ⟨y, rfl⟩
    refine ⟨⟨DirectSum.lof R ℕ (fun j => H I f U j q) (n + d) y, ?_⟩,
      polynomialMap_lof I f U n q d y⟩
    exact Submodule.subset_span ⟨d, y, rfl⟩


end OriginalFamily

variable {R : Type u} [CommRing R] (I : Ideal R)
  {X : Scheme.{u}} {r : ℕ} (i : X ⟶ projectiveSpace R r) [IsClosedImmersion i]

/-- ORIGINAL projective geometry proves finite the SAME actual original fixed-target tail. -/
theorem projective_tailSpan_finite [IsNoetherianRing R] (n q : ℕ) :
    letI := ReesDegreeHomology.projectiveSeparated i
    letI := ReesDegreeHomology.projectiveReesModule I i q
    Module.Finite (reesAlgebra I)
      (tailSpan I (i ≫ projectiveSpaceStructure R r) (originalClosedCoordinateOpens i)
        (originalClosedCoordinateOpens_isAffine i) n q) := by
  let := ReesDegreeHomology.projectiveSeparated i
  let := ReesDegreeHomology.projectiveReesModule I i q
  let : Module.Finite (reesAlgebra I)
      (ReesDegreeHomology.powerHomology I (i ≫ projectiveSpaceStructure R r)
        (originalClosedCoordinateOpens i) q) := ReesDegreeHomology.projective_finite I i q
  infer_instance

/-- ONLY ORIGINAL projective Noetherian data prove stable EVERY actual original fixed-target image filtration. -/
theorem projective_imageFiltration_stable [IsNoetherianRing R] (n q : ℕ) :
    (imageFiltration I (i ≫ projectiveSpaceStructure R r) (originalClosedCoordinateOpens i) n q).Stable := by
  let := ReesDegreeHomology.projectiveSeparated i
  let f := i ≫ projectiveSpaceStructure R r
  let U := originalClosedCoordinateOpens i
  let hU := originalClosedCoordinateOpens_isAffine i
  let := ReesDegreeHomology.reesModule I f U hU q
  let : Module.Finite (reesAlgebra I) (tailSpan I f U hU n q) := projective_tailSpan_finite I i n q
  let L := tailReesMap I f U hU n q
  let : Module.Finite (reesAlgebra I) L.range := Module.Finite.range L
  have hfg : L.range.FG := Module.Finite.iff_fg.mp inferInstance
  let : Module.Finite R (H I f U n q) := ReesPowerCohomologyFinite.projective_powerCech_finite I i n q
  apply ((imageFiltration I f U n q).submodule_fg_iff_stable
    (fun d => IsNoetherian.noetherian ((imageFiltration I f U n q).N d))).mp
  exact (congrArg (fun S : Submodule (reesAlgebra I) (PolynomialModule R (H I f U n q)) => S.FG)
    (tailReesMap_range I f U hU n q)).mp hfg

end Hironaka.Geometry.ProperSteinProjectiveCech.ReesFixedTarget
