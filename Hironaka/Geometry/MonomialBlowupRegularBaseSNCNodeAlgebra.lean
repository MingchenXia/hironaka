import Hironaka.Algebra.NodeNormalCoordinates
import Mathlib.RingTheory.Polynomial.Quotient
import Mathlib.RingTheory.RegularLocalRing.Polynomial
import Mathlib.RingTheory.Ideal.KrullsHeightTheorem

/-! Actual component intersection rings and coordinate prime heights of a one-component node. -/

noncomputable section

open Polynomial

namespace Hironaka.Geometry.MonomialBlowupRegularBaseSNCNodeAlgebra

open Algebra.NodeBlowupChart Algebra.NodeNormalCoordinates

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

universe u
variable {A : Type u} [CommRing A]

/-- The actual ideal generated by a selected family of original node coordinates. -/
def nodeIdeal (t : A) (s : Finset (Fin 2)) : Ideal (Node A t) :=
  Ideal.span (coordinate t '' (s : Set (Fin 2)))

@[simp]
theorem nodeIdeal_empty (t : A) : nodeIdeal t ∅ = ⊥ := by simp [nodeIdeal]

@[simp]
theorem nodeIdeal_singleton (t : A) (i : Fin 2) :
    nodeIdeal t {i} = Ideal.span {coordinate t i} := by simp [nodeIdeal]

theorem nodeIdeal_insert (t : A) (s : Finset (Fin 2)) (i : Fin 2) :
    nodeIdeal t (insert i s) = Ideal.span {coordinate t i} ⊔ nodeIdeal t s := by
  simp only [nodeIdeal, Finset.coe_insert, Set.image_insert_eq, Ideal.span_insert]

theorem nodeIdeal_univ (t : A) : nodeIdeal t Finset.univ =
    Ideal.span {coordinate t 0} ⊔ Ideal.span {coordinate t 1} := by
  have h : (Finset.univ : Finset (Fin 2)) = {0, 1} := by decide
  rw [h, nodeIdeal_insert, nodeIdeal_singleton]

/-- The actual quotient by the second node coordinate, with no assumptions on the base. -/
def quotientCoordinate1Equiv (t : A) :
    (Node A t ⧸ Ideal.span {coordinate t 1}) ≃ₐ[A] (ParameterQuotient t)[X] :=
  (Ideal.quotientEquivAlg _ _ (nodeSwap t) (by
    rw [Ideal.map_span, Set.image_singleton]
    change Ideal.span {coordinate t 0} = Ideal.span {nodeSwap t (coordinate t 1)}
    rw [nodeSwap_coordinate1])).trans
      (coordinateQuotientEquiv t)

/-- The actual quotient by both original coordinates is the actual parameter quotient. -/
def quotientCoordinatesEquiv (t : A) :
    (Node A t ⧸ nodeIdeal t Finset.univ) ≃+* ParameterQuotient t := by
  let I : Ideal (Node A t) := Ideal.span {coordinate t 0}
  let J : Ideal (Node A t) := Ideal.span {coordinate t 1}
  let e := (coordinateQuotientEquiv t).toRingEquiv
  have hmap : Ideal.span {(X : (ParameterQuotient t)[X])} =
      (J.map (Ideal.Quotient.mk I)).map e.toRingHom := by
    rw [Ideal.map_map, Ideal.map_span, Set.image_singleton]
    change Ideal.span {X} = Ideal.span {coordinateQuotientEquiv t
      (mkCoordinate t (coordinate t 1))}
    rw [coordinateQuotientEquiv_coordinate1]
  let e' := Ideal.quotientEquiv (J.map (Ideal.Quotient.mk I))
    (Ideal.span {(X : (ParameterQuotient t)[X])}) e hmap
  let e'' : ((ParameterQuotient t)[X] ⧸ Ideal.span {(X : (ParameterQuotient t)[X])}) ≃+* ParameterQuotient t :=
    (Ideal.quotEquivOfEq (by simp :
      (Ideal.span {(X : (ParameterQuotient t)[X])}) = Ideal.span {X - C 0})).trans
        (Polynomial.quotientSpanXSubCAlgEquiv 0).toRingEquiv
  exact (Ideal.quotEquivOfEq (nodeIdeal_univ t)).trans
    ((DoubleQuot.quotQuotEquivQuotSup I J).symm.trans (e'.trans e''))

variable (t : A) [(Ideal.span {t}).IsPrime]

/-- The actual first coordinate prime has the original polynomial quotient ring. -/
theorem axis0_isPrime : (Ideal.span {coordinate t 0}).IsPrime := by
  have : IsDomain (Node A t ⧸ Ideal.span {coordinate t 0}) :=
    MulEquiv.isDomain _ (coordinateQuotientEquiv t).toRingEquiv.toMulEquiv
  exact (Ideal.Quotient.isDomain_iff_prime _).mp this

/-- The actual second coordinate prime has the original polynomial quotient ring. -/
theorem axis1_isPrime : (Ideal.span {coordinate t 1}).IsPrime := by
  have : IsDomain (Node A t ⧸ Ideal.span {coordinate t 1}) :=
    MulEquiv.isDomain _ (quotientCoordinate1Equiv t).toRingEquiv.toMulEquiv
  exact (Ideal.Quotient.isDomain_iff_prime _).mp this

/-- The actual coordinate intersection is prime, with its literal parameter quotient. -/
theorem pair_isPrime : (nodeIdeal t Finset.univ).IsPrime := by
  have : IsDomain (Node A t ⧸ nodeIdeal t Finset.univ) :=
    MulEquiv.isDomain _ (quotientCoordinatesEquiv t).toMulEquiv
  exact (Ideal.Quotient.isDomain_iff_prime _).mp this

/-- The original surviving coordinate is not in the other axis ideal. -/
theorem coordinate1_not_mem_axis0 : coordinate t 1 ∉ Ideal.span {coordinate t 0} := by
  intro h
  have hz := Ideal.Quotient.eq_zero_iff_mem.mpr h
  have he := congrArg (coordinateQuotientEquiv t) hz
  change coordinateQuotientEquiv t (mkCoordinate t (coordinate t 1)) =
    coordinateQuotientEquiv t 0 at he
  rw [coordinateQuotientEquiv_coordinate1, map_zero] at he
  exact Polynomial.X_ne_zero he

/-- The actual axes are genuinely distinct in the opposite orientation as well. -/
theorem coordinate0_not_mem_axis1 : coordinate t 0 ∉ Ideal.span {coordinate t 1} := by
  intro h
  have hm := Ideal.mem_map_of_mem (nodeSwap t).toRingEquiv.toRingHom h
  rw [Ideal.map_span, Set.image_singleton] at hm
  change nodeSwap t (coordinate t 0) ∈ Ideal.span {nodeSwap t (coordinate t 1)} at hm
  rw [nodeSwap_coordinate0, nodeSwap_coordinate1] at hm
  exact coordinate1_not_mem_axis0 t hm

variable [IsDomain A] (ht : t ≠ 0)


include ht in
/-- Coordinate ideals of all actual selected families are prime. -/
theorem nodeIdeal_isPrime (s : Finset (Fin 2)) : (nodeIdeal t s).IsPrime := by
  let := Algebra.NodeDomain.nodeQuotient_isDomain t ht
  by_cases h0 : 0 ∈ s <;> by_cases h1 : 1 ∈ s
  · have hs : s = Finset.univ := by ext i; fin_cases i <;> simp_all
    rw [hs]
    exact pair_isPrime t
  · have hs : s = {0} := by ext i; fin_cases i <;> simp_all
    rw [hs, nodeIdeal_singleton]
    exact axis0_isPrime t
  · have hs : s = {1} := by ext i; fin_cases i <;> simp_all
    rw [hs, nodeIdeal_singleton]
    exact axis1_isPrime t
  · have hs : s = ∅ := by ext i; fin_cases i <;> simp_all
    rw [hs, nodeIdeal_empty]
    exact Ideal.isPrime_bot

include ht in
/-- Every genuinely unselected original coordinate survives the exact ideal. -/
theorem coordinate_not_mem_nodeIdeal (s : Finset (Fin 2)) {i : Fin 2} (hi : i ∉ s) :
    coordinate t i ∉ nodeIdeal t s := by
  let := Algebra.NodeDomain.nodeQuotient_isDomain t ht
  by_cases h0 : 0 ∈ s <;> by_cases h1 : 1 ∈ s
  · fin_cases i <;> simp_all
  · have hs : s = {0} := by ext j; fin_cases j <;> simp_all
    have hi1 : i = 1 := by fin_cases i <;> simp_all
    rw [hs, hi1, nodeIdeal_singleton]
    exact coordinate1_not_mem_axis0 t
  · have hs : s = {1} := by ext j; fin_cases j <;> simp_all
    have hi0 : i = 0 := by fin_cases i <;> simp_all
    rw [hs, hi0, nodeIdeal_singleton]
    exact coordinate0_not_mem_axis1 t
  · have hs : s = ∅ := by ext j; fin_cases j <;> simp_all
    rw [hs, nodeIdeal_empty, Ideal.mem_bot]
    exact Algebra.NodeDomain.nodeCoordinate_ne_zero t ht i

omit [(Ideal.span {t}).IsPrime] [IsDomain A] in
/-- Inclusion of actual coordinate families gives inclusion of their actual ideals. -/
theorem nodeIdeal_mono {s r : Finset (Fin 2)} (h : s ⊆ r) : nodeIdeal t s ≤ nodeIdeal t r :=
  Ideal.span_mono (Set.image_mono h)

include ht in
/-- Adding a genuinely new coordinate strictly increases the actual prime ideal. -/
theorem nodeIdeal_lt_insert (s : Finset (Fin 2)) {i : Fin 2} (hi : i ∉ s) :
    nodeIdeal t s < nodeIdeal t (insert i s) := by
  refine lt_of_le_of_ne (nodeIdeal_mono t (Finset.subset_insert _ _)) ?_
  intro heq
  apply coordinate_not_mem_nodeIdeal t ht s hi
  rw [heq]
  exact Ideal.subset_span (Set.mem_image_of_mem (coordinate t) (Finset.mem_insert_self _ _))

variable [IsNoetherianRing A]

include ht in
/-- Exact node-coordinate heights follow from actual strict prime chains and Krull's generator bound. -/
theorem nodeIdeal_height (s : Finset (Fin 2)) : (nodeIdeal t s).height = s.card := by
  classical
  let := Algebra.NodeDomain.nodeQuotient_isDomain t ht
  have hge : (s.card : ℕ∞) ≤ (nodeIdeal t s).height := by
    induction s using Finset.induction_on with
    | empty => simp
    | @insert i s hi ih =>
      let : (nodeIdeal t s).IsPrime := nodeIdeal_isPrime t ht _
      let : (nodeIdeal t (insert i s)).IsPrime := nodeIdeal_isPrime t ht _
      rw [Finset.card_insert_of_notMem hi, Nat.cast_add, Nat.cast_one]
      exact (add_le_add ih (le_refl (1 : ℕ∞))).trans
        (Ideal.height_add_one_le_of_lt_of_isPrime (nodeIdeal_lt_insert t ht s hi))
  apply le_antisymm ?_ hge
  let : (nodeIdeal t s).IsPrime := nodeIdeal_isPrime t ht s
  have heq : Ideal.span (↑(s.image (coordinate t)) : Set (Node A t)) = nodeIdeal t s := by
    simp [nodeIdeal]
  have hmem : nodeIdeal t s ∈ (Ideal.span (↑(s.image (coordinate t)) : Set (Node A t))).minimalPrimes := by
    rw [heq, Ideal.minimalPrimes_eq_subsingleton_self]
    exact Set.mem_singleton _
  exact (Ideal.height_le_card_of_mem_minimalPrimes_span_finset hmem).trans
    (by exact_mod_cast Finset.card_image_le)

variable [IsRegularRing (ParameterQuotient t)]

omit [(Ideal.span {t}).IsPrime] [IsDomain A] [IsNoetherianRing A] in
/-- Every nonempty actual coordinate intersection has a genuine regular quotient. -/
theorem nodeIdeal_quotient_isRegularRing (s : Finset (Fin 2)) (hsne : s.Nonempty) :
    IsRegularRing (Node A t ⧸ nodeIdeal t s) := by
  by_cases h0 : 0 ∈ s <;> by_cases h1 : 1 ∈ s
  · have hs : s = Finset.univ := by ext i; fin_cases i <;> simp_all
    rw [hs]
    exact IsRegularRing.of_ringEquiv (quotientCoordinatesEquiv t).symm
  · have hs : s = {0} := by ext i; fin_cases i <;> simp_all
    rw [hs, nodeIdeal_singleton]
    exact IsRegularRing.of_ringEquiv (coordinateQuotientEquiv t).symm.toRingEquiv
  · have hs : s = {1} := by ext i; fin_cases i <;> simp_all
    rw [hs, nodeIdeal_singleton]
    exact IsRegularRing.of_ringEquiv (quotientCoordinate1Equiv t).symm.toRingEquiv
  · obtain ⟨i, hi⟩ := hsne
    fin_cases i <;> contradiction

end Hironaka.Geometry.MonomialBlowupRegularBaseSNCNodeAlgebra
