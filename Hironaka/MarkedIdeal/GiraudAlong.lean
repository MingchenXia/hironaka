/-!
# Giraud--Villamayor along a submanifold

Sources: Bierstone--Milman 2008, §3.2 (the derivative ideal of `𝓘 ⊆ 𝒪_N`, `cosupp(𝓘, d) = V(𝓓^{d-1} 𝓘)`), Włodarczyk
2005, §2.6 (Lemma `le:Vi1`), applied on the submanifold `N` of a marked ideal `(M, N, E, 𝔞, d)`.

`DerivativeIdealAlong` represents the derivative ideal of `𝔞|_N` by the ambient ideal `derivIdealAlong N 𝔞`,
generated by `𝔞`, `𝓘_N` and the derivatives of `𝔞` along holomorphic vector fields tangent to `N`. This module
proves, for a closed submanifold `N`:

* `orderGE_derivIdealAlong_of_orderGE_succ` (any `N`): `ord_x(𝔞|_N) ≥ μ + 1 ⇒ ord_x((𝓓_N 𝔞)|_N) ≥ μ`;
* `orderGE_succ_of_orderGE_derivIdealAlong` (`N` regular at `x`, `μ ≥ 1`): the converse;
* **Giraud--Villamayor along `N`** `cosupport_succ_eq_cosupport_derivIdealAlong`,
  `cosupport_add_eq_cosupport_iterDerivIdealAlong`: `cosupp(𝔞|_N, μ + i) = cosupp((𝓓_N^i 𝔞)|_N, μ)` for
  `μ ≥ 1`, and `cosupport_succ_eq_inter_zeroLocus_iterDerivIdealAlong`: `cosupp(𝔞|_N, j + 1) = N ∩ V(𝓓_N^j 𝔞)`.

## Flat coordinates and the retraction

At `x ∈ N` take the flattening `Φ` of `RegularAtDim` (`ψ = Φ ∘ e`, `e` the preferred chart, `N = ψ⁻¹(ℂᵏ × 0)`, `ψ x
= 0`), its inverse `φ = e⁻¹ ∘ Φ⁻¹` and the linear retraction `P` of `ℂⁿ` onto `ℂᵏ × 0`
(`HadamardBridgeAlong.planeRetract`).

* `flatField Φ u` (`u ∈ ℂᵏ × 0`): the coordinate field `∂/∂ψ` in the direction `u`, written in the chart `e`; it is
  tangent to `N` at every point of the flat domain (`isTangentField_flatField`), and
  `dirDeriv_flatten_eventuallyEq`: `∂_v (f ∘ φ ∘ P) = (ξ_{Pv} f) ∘ φ ∘ P` near `0`.

Then the converse half of Giraud is the `N = M` argument for the flattened function: its derivatives of order `μ`
are derivatives of order `μ - 1` of the flattened functions of the generators `ξ_{Pv} f` of `𝓓_N 𝔞`.
-/

open Set Filter
open scoped Topology Manifold ContDiff

namespace Hironaka.GiraudAlong

open Hironaka.HolomorphicIdealSheaves Hironaka.BlowupSequences
open Hironaka.IdealWeightPowers Hironaka.GermIdealOrder Hironaka.DerivativeIdeal Hironaka.DerivativeIdealAlong Hironaka.HolomorphicTaylorTail Hironaka.OrderTaylor Hironaka.BlowupFlatCoordinates Hironaka.HadamardBridge Hironaka.HadamardBridgeAlong Hironaka.IdealOrderArithmetic

noncomputable section

/-! ### Iterated derivatives of germs -/

section Germ

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]

/-- Iterated directional derivatives only depend on the germ. -/
theorem iterDeriv_eventuallyEq {F G : E → ℂ} {w : E} (h : F =ᶠ[𝓝 w] G) :
    ∀ L : List E, iterDeriv L F =ᶠ[𝓝 w] iterDeriv L G
  | [] => h
  | v :: L => by
    filter_upwards [(iterDeriv_eventuallyEq h L).eventuallyEq_nhds] with z hz
    simp only [iterDeriv_cons, dirDeriv, hz.fderiv_eq]

end Germ

variable {n : ℕ} {M : Type*} [TopologicalSpace M] [ChartedSpace (ComplexModel n) M]
  [IsComplexManifold n M]

/-! ### Elementary facts -/

section Elementary

theorem holomorphicAt_sub {f g : M → ℂ} {x : M} (hf : HolomorphicAt n f x) (hg : HolomorphicAt n g x) :
    HolomorphicAt n (fun p => f p - g p) x := by
  filter_upwards [hf, hg] with y hfy hgy
  exact hfy.sub hgy

/-- The zero function lies in every power of every ideal. -/
theorem zero_mem_idealPow (I : GermIdeal n M) (x : M) : ∀ q : ℕ, (idealPow I q).mem x (fun _ => 0)
  | 0 => holomorphicAt_const 0
  | _ + 1 => mem_idealPow_succ_iff.mpr ⟨holomorphicAt_const 0, 0, Fin.elim0, Fin.elim0,
      fun i => i.elim0, fun i => i.elim0, Eventually.of_forall fun _ => by simp⟩

/-- A germ vanishing on `N` vanishes to every order along `N`. -/
theorem vanishesToOrderOn_of_mem_vanishingIdeal {N : Set M} {x : M} {s : M → ℂ}
    (hs : (vanishingIdeal (n := n) N).mem x s) (q : ℕ) : VanishesToOrderOn n N x q s :=
  ⟨fun _ => 0, zero_mem_idealPow _ x q, hs.2⟩

/-- Derivatives along a vector field are additive (near the point). -/
theorem fieldDeriv_add_eventuallyEq {e : ComplexChart n M} {ξ : Fin n → M → ℂ} {f g : M → ℂ} {x : M}
    (hx : x ∈ e.val.source) (hf : HolomorphicAt n f x) (hg : HolomorphicAt n g x) :
    ∀ᶠ p in 𝓝 x, fieldDeriv e ξ (fun q => f q + g q) p = fieldDeriv e ξ f p + fieldDeriv e ξ g p := by
  filter_upwards [e.val.open_source.mem_nhds hx, hf.eventually_nhds, hg.eventually_nhds] with p hp hfp hgp
  have hdf := (eventually_differentiableAt_comp_symm e hp hfp).self_of_nhds
  have hdg := (eventually_differentiableAt_comp_symm e hp hgp).self_of_nhds
  have hcomp : (fun q => f q + g q) ∘ e.val.symm =
      fun z => (f ∘ e.val.symm) z + (g ∘ e.val.symm) z := rfl
  simp only [fieldDeriv, chartDeriv]
  rw [hcomp, fderiv_fun_add hdf hdg]
  simp [mul_add, Finset.sum_add_distrib]

end Elementary

/-! ### Giraud along `N`, first inclusion -/

section Forward

variable {N : Set M} {𝔞 : GermIdeal n M}

/-- **Derivatives tangent to `N` lower the order along `N` by at most one**: if `ord_x(𝔞|_N) ≥ μ + 1`, then
`ord_x((𝓓_N 𝔞)|_N) ≥ μ` (any subset `N`, any `μ`). -/
theorem orderGE_derivIdealAlong_of_orderGE_succ (h𝔞 : ∀ x g, 𝔞.mem x g → HolomorphicAt n g x)
    {x : M} {μ : ℕ} (hx : OrderGE n N 𝔞 x (μ + 1)) : OrderGE n N (derivIdealAlong N 𝔞) x μ := by
  intro g hg
  refine IsInSpanAt.vanishesToOrderOn hg ?_
  rintro s (hs | hs | ⟨e, ξ, f, hξ, hf, rfl⟩)
  · exact (hx s hs).mono (Nat.le_succ μ)
  · exact vanishesToOrderOn_of_mem_vanishingIdeal hs μ
  · obtain ⟨h, hh, hfh⟩ := hx f hf
    have hfhol := h𝔞 x f hf
    have hhhol : HolomorphicAt n h x := holomorphicAt_of_mem_idealPow hh
    -- `f - h ∈ 𝓘_N`, hence `ξ(f - h) ∈ 𝓘_N`
    have hd : (vanishingIdeal (n := n) N).mem x (fun p => f p - h p) :=
      ⟨holomorphicAt_sub hfhol hhhol, hfh.mono fun p hp hpN => by simp only [hp hpN, sub_self]⟩
    have hξd := hξ.preserves _ hd
    refine ⟨fieldDeriv e ξ h, ?_, ?_⟩
    · -- `ξ(h) ∈ 𝔪_x^μ`
      exact mem_idealPow_sum Finset.univ fun m _ => mul_mem_idealPow (hξ.holomorphicAt m)
        (chartDeriv_mem_idealPow hξ.mem_source μ h hh)
    · have hsplit := fieldDeriv_add_eventuallyEq (ξ := ξ) hξ.mem_source (holomorphicAt_sub hfhol hhhol)
        hhhol
      have hfeq : (fun q => (f q - h q) + h q) = f := funext fun q => sub_add_cancel _ _
      rw [hfeq] at hsplit
      filter_upwards [hsplit, hξd.2] with p hp hp0 hpN
      rw [hp, hp0 hpN, zero_add]

/-- **Giraud--Villamayor along `N`, first inclusion**: `cosupp(𝔞|_N, μ + 1) ⊆ cosupp((𝓓_N 𝔞)|_N, μ)`. -/
theorem cosupport_succ_subset_cosupport_derivIdealAlong
    (h𝔞 : ∀ x g, 𝔞.mem x g → HolomorphicAt n g x) (μ : ℕ) :
    cosupport n N 𝔞 (μ + 1) ⊆ cosupport n N (derivIdealAlong N 𝔞) μ :=
  fun _ hx => ⟨hx.1, orderGE_derivIdealAlong_of_orderGE_succ h𝔞 hx.2⟩

end Forward

/-! ### Flat coordinates at a point of `N` -/

section Flat

variable {x : M} (Φ : LocalHolomorphicEquivAt (n := n) (chartAt (ComplexModel n) x x))

/-- The flat coordinates `ψ = Φ ∘ e`. -/
def flatMap : M → ComplexModel n := fun p => Φ.toFun (chartAt (ComplexModel n) x p)

/-- Their inverse `φ = e⁻¹ ∘ Φ⁻¹`. -/
def flatInv : ComplexModel n → M := fun w => (chartAt (ComplexModel n) x).symm (Φ.invFun w)

/-- **The flattened function** `f ∘ φ ∘ P` of `f` (`P` the retraction onto `ℂᵏ × 0`): the normal form `r^*(f|_N)`
read in the flat coordinates. -/
def flatten (k : ℕ) (f : M → ℂ) : ComplexModel n → ℂ := fun w => f (flatInv Φ (planeRetract k w))

/-- **The coordinate field `∂/∂ψ` in the direction `u`**, written in the chart `e` at `x`: its `m`-th coefficient
at `p` is the `m`-th coordinate of `DΦ⁻¹(ψ p) u`. -/
def flatField (u : ComplexModel n) : Fin n → M → ℂ :=
  fun m p => fderiv ℂ (fun w => Φ.invFun w m) (flatMap Φ p) u

variable {Φ}

theorem flatMap_flatInv {w : ComplexModel n} (hw : w ∈ Φ.target)
    (hΦsrc : Φ.source ⊆ (chartAt (ComplexModel n) x).target) : flatMap Φ (flatInv Φ w) = w :=
  (flatInverse_mem Φ hw hΦsrc).2

theorem flatInv_mem_flatDomain {w : ComplexModel n} (hw : w ∈ Φ.target)
    (hΦsrc : Φ.source ⊆ (chartAt (ComplexModel n) x).target) : flatInv Φ w ∈ flatDomain Φ :=
  (flatInverse_mem Φ hw hΦsrc).1

theorem flatInv_flatMap {p : M} (hp : p ∈ flatDomain Φ) : flatInv Φ (flatMap Φ p) = p :=
  flatInverse_flat Φ hp

theorem flatMap_mem_target {p : M} (hp : p ∈ flatDomain Φ) : flatMap Φ p ∈ Φ.target :=
  Φ.mapsTo_toFun hp.2

theorem flatInv_zero (hΦx : Φ.toFun (chartAt (ComplexModel n) x x) = 0) : flatInv Φ 0 = x := by
  have := flatInv_flatMap (mem_flatDomain_self Φ)
  rwa [flatMap, hΦx] at this

theorem zero_mem_target (hΦx : Φ.toFun (chartAt (ComplexModel n) x x) = 0) : (0 : ComplexModel n) ∈ Φ.target := by
  rw [← hΦx]; exact Φ.mapsTo_toFun Φ.center_mem_source

theorem continuousAt_flatInv {w : ComplexModel n} (hw : w ∈ Φ.target)
    (hΦsrc : Φ.source ⊆ (chartAt (ComplexModel n) x).target) : ContinuousAt (flatInv Φ) w := by
  have hinv : ContinuousAt Φ.invFun w :=
    (Φ.invFun_holomorphic.differentiableAt (Φ.isOpen_target.mem_nhds hw)).continuousAt
  exact ((chartAt (ComplexModel n) x).continuousAt_symm (hΦsrc (Φ.mapsTo_invFun hw))).comp hinv

/-- `f ∘ φ` is differentiable at every point of the target over which `f` is holomorphic. -/
theorem differentiableAt_comp_flatInv {f : M → ℂ} {w : ComplexModel n} (hw : w ∈ Φ.target)
    (hΦsrc : Φ.source ⊆ (chartAt (ComplexModel n) x).target) (hf : HolomorphicAt n f (flatInv Φ w)) :
    DifferentiableAt ℂ (f ∘ flatInv Φ) w := by
  have hsrc : Φ.invFun w ∈ (chartAt (ComplexModel n) x).target := hΦsrc (Φ.mapsTo_invFun hw)
  have hmem : flatInv Φ w ∈ (chartAt (ComplexModel n) x).source :=
    (chartAt (ComplexModel n) x).map_target hsrc
  have hd := (eventually_differentiableAt_comp_symm (complexChartAt (n := n) x) hmem hf).self_of_nhds
  have hex : (chartAt (ComplexModel n) x) (flatInv Φ w) = Φ.invFun w :=
    (chartAt (ComplexModel n) x).right_inv hsrc
  have hex' : (complexChartAt (n := n) x).val (flatInv Φ w) = Φ.invFun w := hex
  rw [hex'] at hd
  exact hd.comp w (Φ.invFun_holomorphic.differentiableAt (Φ.isOpen_target.mem_nhds hw))

variable (hΦsrc : Φ.source ⊆ (chartAt (ComplexModel n) x).target)
  (hΦx : Φ.toFun (chartAt (ComplexModel n) x x) = 0)

include hΦsrc hΦx in
/-- Near `0` the retraction lands in the target of `Φ`. -/
theorem eventually_planeRetract_mem_target (k : ℕ) :
    ∀ᶠ w in 𝓝 (0 : ComplexModel n), planeRetract k w ∈ Φ.target := by
  have hPT : Tendsto (planeRetract (n := n) k) (𝓝 0) (𝓝 0) := by
    have := (planeRetract (n := n) k).continuous.tendsto 0
    rwa [planeRetract_zero] at this
  exact hPT.eventually (Φ.isOpen_target.mem_nhds (zero_mem_target hΦx))

include hΦsrc hΦx in
/-- `φ ∘ P` tends to `x` at `0`. -/
theorem tendsto_flatInv_planeRetract (k : ℕ) :
    Tendsto (fun w => flatInv Φ (planeRetract k w)) (𝓝 0) (𝓝 x) := by
  have hPT : Tendsto (planeRetract (n := n) k) (𝓝 0) (𝓝 0) := by
    have := (planeRetract (n := n) k).continuous.tendsto 0
    rwa [planeRetract_zero] at this
  have h := (continuousAt_flatInv (zero_mem_target hΦx) hΦsrc).tendsto
  rw [flatInv_zero hΦx] at h
  exact h.comp hPT

include hΦsrc hΦx in
/-- The flattened function of a germ holomorphic at `x` is holomorphic near `0`. -/
theorem eventually_differentiableAt_flatten (k : ℕ) {f : M → ℂ} (hf : HolomorphicAt n f x) :
    ∀ᶠ w in 𝓝 (0 : ComplexModel n), DifferentiableAt ℂ (flatten Φ k f) w := by
  filter_upwards [(eventually_planeRetract_mem_target hΦsrc hΦx k).eventually_nhds,
    ((tendsto_flatInv_planeRetract hΦsrc hΦx k).eventually hf.eventually_nhds).eventually_nhds]
    with w hw hfw
  have hP : ∀ᶠ w' in 𝓝 w, DifferentiableAt ℂ (f ∘ flatInv Φ) (planeRetract k w') := by
    filter_upwards [hw, hfw] with w' h1 h2
    exact differentiableAt_comp_flatInv h1 hΦsrc h2
  exact hP.self_of_nhds.comp w (planeRetract (n := n) k).differentiableAt

variable {N : Set M} {k : ℕ}
  (hflat : ∀ {y : M}, y ∈ (chartAt (ComplexModel n) x).source → chartAt (ComplexModel n) x y ∈ Φ.source →
    (y ∈ N ↔ Φ.toFun (chartAt (ComplexModel n) x y) ∈ complexCoordinatePlane n k))

include hflat in
/-- On the flat domain, the points of `N` are those whose flat coordinates lie in `ℂᵏ × 0`. -/
theorem mem_iff_flatMap_mem {p : M} (hp : p ∈ flatDomain Φ) :
    p ∈ N ↔ flatMap Φ p ∈ complexCoordinatePlane n k :=
  hflat hp.1 hp.2

include hΦsrc hflat in
/-- `φ` maps the plane `ℂᵏ × 0` (inside the target) into `N`. -/
theorem flatInv_mem {w : ComplexModel n} (hw : w ∈ Φ.target) (hwk : w ∈ complexCoordinatePlane n k) :
    flatInv Φ w ∈ N :=
  (mem_iff_flatMap_mem hflat (flatInv_mem_flatDomain hw hΦsrc)).mpr
    ((flatMap_flatInv hw hΦsrc).symm ▸ hwk)

include hΦsrc hflat in
/-- **The order along `N` through the flattened function, forward half, at any point `y` of `N` in the flat
domain**: if `f|_N ∈ 𝔪_{N,y}^q`, the iterated derivatives of order `< q` of `f ∘ φ ∘ P` vanish at `ψ y`. -/
theorem iterDeriv_flatten_flatMap_eq_zero {y : M} (hy : y ∈ flatDomain Φ) (hyN : y ∈ N) {f : M → ℂ}
    {q : ℕ} (hf : VanishesToOrderOn n N y q f) (L : List (ComplexModel n)) (hL : L.length < q) :
    iterDeriv L (flatten Φ k f) (flatMap Φ y) = 0 := by
  obtain ⟨h, hh, hfh⟩ := hf
  obtain ⟨w₀, hw₀⟩ : ∃ w₀, flatMap Φ y = w₀ := ⟨_, rfl⟩
  rw [hw₀]
  set P := planeRetract (n := n) k
  have hw₀T : w₀ ∈ Φ.target := hw₀ ▸ flatMap_mem_target hy
  have hw₀k : w₀ ∈ complexCoordinatePlane n k := hw₀ ▸ (mem_iff_flatMap_mem hflat hy).mp hyN
  have hinv : flatInv Φ w₀ = y := hw₀ ▸ flatInv_flatMap hy
  have hPw₀ : P w₀ = w₀ := planeRetract_of_mem hw₀k
  have hPT : Tendsto P (𝓝 w₀) (𝓝 w₀) := by
    have := P.continuous.tendsto w₀
    rwa [hPw₀] at this
  have hPtarget : ∀ᶠ w in 𝓝 w₀, P w ∈ Φ.target := hPT.eventually (Φ.isOpen_target.mem_nhds hw₀T)
  have hT : Tendsto (fun w => flatInv Φ (P w)) (𝓝 w₀) (𝓝 y) := by
    have h := (continuousAt_flatInv hw₀T hΦsrc).tendsto
    rw [hinv] at h
    exact h.comp hPT
  -- `f ∘ φ ∘ P = h ∘ φ ∘ P` near `w₀`
  have heq : flatten Φ k f =ᶠ[𝓝 w₀] fun w => h (flatInv Φ (P w)) := by
    filter_upwards [hPtarget, hT.eventually hfh] with w hw hw'
    exact hw' (flatInv_mem hΦsrc hflat hw (planeRetract_mem k w))
  -- `h ∘ φ ∘ P ∈ 𝔪_{w₀}^q` on the model space
  have hφP : ∀ᶠ w in 𝓝 w₀,
      MDifferentiableAt 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel n) (fun w => flatInv Φ (P w)) w := by
    filter_upwards [hPtarget] with w hw
    have h1 : MDifferentiableAt 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel n) Φ.invFun (P w) :=
      (Φ.invFun_holomorphic.differentiableAt (Φ.isOpen_target.mem_nhds hw)).mdifferentiableAt
    have h2 := (mdifferentiableAt_chart_symm (y₀ := x) (hΦsrc (Φ.mapsTo_invFun hw))).comp (P w) h1
    exact h2.comp w P.differentiableAt.mdifferentiableAt
  have hh' : (idealPow (pointIdeal n ((fun w => flatInv Φ (P w)) w₀)) q).mem
      ((fun w => flatInv Φ (P w)) w₀) h := by
    simp only [hPw₀, hinv]
    exact hh
  have hmem : (idealPow (pointIdeal n w₀) q).mem w₀ (h ∘ fun w => flatInv Φ (P w)) :=
    comp_mem_idealPow_pointIdeal hφP q hh'
  set e₀ := complexChartAt (n := n) w₀
  have hw₀s : w₀ ∈ e₀.val.source := mem_complexChartAt_source w₀
  have h0 := iterChartDeriv_eq_zero_of_mem_idealPow hw₀s hmem L hL
  rw [iterChartDeriv_eq_iterDeriv e₀ _ L hw₀s] at h0
  rw [(iterDeriv_eventuallyEq heq L).self_of_nhds]
  have h0' : iterDeriv L (h ∘ fun w => flatInv Φ (P w)) w₀ = 0 := by
    simpa [e₀, complexChartAt, chartAt_self_eq] using h0
  exact h0'

include hΦsrc hΦx hflat in
/-- The centre `x` of the flat chart lies in `N`. -/
theorem mem_of_flat : x ∈ N :=
  (mem_iff_flatMap_mem hflat (mem_flatDomain_self Φ)).mpr (by
    change Φ.toFun (chartAt (ComplexModel n) x x) ∈ _
    rw [hΦx]
    exact fun _ _ => rfl)

include hΦsrc hΦx hflat in
/-- **The order along `N` through the flattened function, forward half** (at the centre). -/
theorem iterDeriv_flatten_eq_zero_of_vanishesToOrderOn {f : M → ℂ} {q : ℕ}
    (hf : VanishesToOrderOn n N x q f) (L : List (ComplexModel n)) (hL : L.length < q) :
    iterDeriv L (flatten Φ k f) 0 = 0 := by
  have h := iterDeriv_flatten_flatMap_eq_zero hΦsrc hflat (mem_flatDomain_self Φ)
    (mem_of_flat hΦsrc hΦx hflat) hf L hL
  rwa [show flatMap Φ x = 0 from hΦx] at h

include hΦsrc hΦx hflat in
/-- **The order along `N` through the flattened function, converse half**: if `f` is holomorphic at `x` and the
iterated derivatives of order `< q` of `f ∘ φ ∘ P` vanish at `0`, then `f|_N ∈ 𝔪_{N,x}^q`. -/
theorem vanishesToOrderOn_of_iterDeriv_flatten_eq_zero {f : M → ℂ} (hf : HolomorphicAt n f x) (q : ℕ)
    (hvan : ∀ L : List (ComplexModel n), L.length < q → iterDeriv L (flatten Φ k f) 0 = 0) :
    VanishesToOrderOn n N x q f := by
  set F := flatten Φ k f
  have hplane : (0 : ComplexModel n) ∈ complexCoordinatePlane n 0 := fun i _ => rfl
  have hFvan : ∀ᶠ y in 𝓝 (0 : ComplexModel n), y ∈ complexCoordinatePlane n 0 →
      ∀ L : List (ComplexModel n), L.length < q → iterDeriv L F y = 0 := by
    refine Eventually.of_forall fun y hy L hL => ?_
    have hy0 : y = 0 := by
      ext i
      exact hy i (Nat.zero_le _)
    subst hy0
    exact hvan L hL
  have hF : InNormalPow 0 (0 : ComplexModel n) q F :=
    inNormalPow_of_iterDeriv_eq_zero q hplane (eventually_differentiableAt_flatten hΦsrc hΦx k hf) hFvan
  -- pull back along the flat coordinates `ψ`
  have hψx : flatMap Φ x = 0 := hΦx
  have hψ : ∀ᶠ p in 𝓝 x, MDifferentiableAt 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel n) (flatMap Φ) p := by
    filter_upwards [(isOpen_flatDomain Φ).mem_nhds (mem_flatDomain_self Φ)] with p hp
    have h1 : MDifferentiableAt 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel n) Φ.toFun
        (chartAt (ComplexModel n) x p) :=
      (Φ.toFun_holomorphic.differentiableAt (Φ.isOpen_source.mem_nhds hp.2)).mdifferentiableAt
    exact h1.comp p (mdifferentiableAt_chart hp.1)
  have hψI : ∀ i : Fin n, 0 ≤ i.1 → (pointIdeal n x).mem x (fun p => flatMap Φ p i) := by
    intro i _
    refine mem_pointIdeal_of_apply_eq_zero (holomorphicAt_flatCoord Φ i (mem_flatDomain_self Φ)) ?_
    rw [hψx]; rfl
  refine ⟨fun p => F (flatMap Φ p), mem_idealPow_of_inNormalPow hψx hψ hψI q hF
    (Eventually.of_forall fun _ => rfl), ?_⟩
  filter_upwards [(isOpen_flatDomain Φ).mem_nhds (mem_flatDomain_self Φ)] with p hp hpN
  have hψN : flatMap Φ p ∈ complexCoordinatePlane n k := (mem_iff_flatMap_mem hflat hp).mp hpN
  simp only [F, flatten, planeRetract_of_mem hψN, flatInv_flatMap hp]

/-! ### The coordinate fields of the flat chart -/

/-- The coefficients of `flatField` are holomorphic on the flat domain. -/
theorem holomorphicAt_flatField (u : ComplexModel n) (m : Fin n) {y : M} (hy : y ∈ flatDomain Φ) :
    HolomorphicAt n (flatField Φ u m) y := by
  have hd : DifferentiableOn ℂ (fun w => Φ.invFun w m) Φ.target :=
    (EuclideanSpace.proj (𝕜 := ℂ) m).differentiable.comp_differentiableOn Φ.invFun_holomorphic
  have hd' := Hironaka.differentiableOn_fderiv_apply_of_isOpen hd Φ.isOpen_target u
  refine holomorphicAt_comp_flat Φ (G := fun w => fderiv ℂ (fun w => Φ.invFun w m) w u) hy ?_
  filter_upwards [Φ.isOpen_target.mem_nhds (flatMap_mem_target hy)] with w hw
  exact (hd' w hw).differentiableAt (Φ.isOpen_target.mem_nhds hw)

/-- **The derivative along `flatField Φ u` is the derivative of `f ∘ φ` in the direction `u`.** -/
theorem fieldDeriv_flatField {f : M → ℂ} {p : M} (hp : p ∈ flatDomain Φ) (hf : HolomorphicAt n f p)
    (u : ComplexModel n) :
    fieldDeriv (complexChartAt (n := n) x) (flatField Φ u) f p =
      fderiv ℂ (f ∘ flatInv Φ) (flatMap Φ p) u := by
  have hwT : flatMap Φ p ∈ Φ.target := flatMap_mem_target hp
  have hinvd : DifferentiableAt ℂ Φ.invFun (flatMap Φ p) :=
    Φ.invFun_holomorphic.differentiableAt (Φ.isOpen_target.mem_nhds hwT)
  have hinv : Φ.invFun (flatMap Φ p) = chartAt (ComplexModel n) x p := Φ.left_inv _ hp.2
  have hd : DifferentiableAt ℂ (f ∘ (chartAt (ComplexModel n) x).symm) (chartAt (ComplexModel n) x p) :=
    (eventually_differentiableAt_comp_symm (complexChartAt (n := n) x) hp.1 hf).self_of_nhds
  have hd' : DifferentiableAt ℂ (f ∘ (chartAt (ComplexModel n) x).symm) (Φ.invFun (flatMap Φ p)) :=
    hinv ▸ hd
  have hcomp : f ∘ flatInv Φ = (f ∘ (chartAt (ComplexModel n) x).symm) ∘ Φ.invFun := rfl
  rw [hcomp, fderiv_comp (flatMap Φ p) hd' hinvd, ContinuousLinearMap.comp_apply, hinv]
  have hm : ∀ m : Fin n, fderiv ℂ (fun w => Φ.invFun w m) (flatMap Φ p) u =
      fderiv ℂ Φ.invFun (flatMap Φ p) u m := by
    intro m
    have h := ((EuclideanSpace.proj (𝕜 := ℂ) m).hasFDerivAt.comp (flatMap Φ p) hinvd.hasFDerivAt).fderiv
    change fderiv ℂ ((EuclideanSpace.proj (𝕜 := ℂ) m) ∘ Φ.invFun) (flatMap Φ p) u = _
    rw [h]
    rfl
  change ∑ m, fderiv ℂ (fun w => Φ.invFun w m) (flatMap Φ p) u *
      fderiv ℂ (f ∘ (chartAt (ComplexModel n) x).symm) (chartAt (ComplexModel n) x p)
        (EuclideanSpace.single m 1) = _
  simp only [hm]
  conv_rhs => rw [← sum_smul_single (fderiv ℂ Φ.invFun (flatMap Φ p) u)]
  rw [map_sum]
  exact Finset.sum_congr rfl fun m _ => by rw [map_smul, smul_eq_mul]

include hΦsrc hflat in
/-- **The coordinate fields of the flat chart in the directions of `ℂᵏ × 0` are tangent to `N`** at every point
of the flat domain. -/
theorem isTangentField_flatField {u : ComplexModel n} (hu : u ∈ complexCoordinatePlane n k) {y : M}
    (hy : y ∈ flatDomain Φ) : IsTangentField N (complexChartAt (n := n) x) (flatField Φ u) y := by
  refine ⟨hy.1, fun m => holomorphicAt_flatField u m hy, fun g hg => ⟨holomorphicAt_fieldDeriv hy.1
    (fun m => holomorphicAt_flatField u m hy) hg.1, ?_⟩⟩
  filter_upwards [(isOpen_flatDomain Φ).mem_nhds hy, hg.1.eventually_nhds, hg.2.eventually_nhds]
    with p hp hgp hgN hpN
  rw [fieldDeriv_flatField hp hgp u]
  set P := planeRetract (n := n) k
  have hwT : flatMap Φ p ∈ Φ.target := flatMap_mem_target hp
  have hwk : flatMap Φ p ∈ complexCoordinatePlane n k := (mem_iff_flatMap_mem hflat hp).mp hpN
  have hPw : P (flatMap Φ p) = flatMap Φ p := planeRetract_of_mem hwk
  have hPT : Tendsto P (𝓝 (flatMap Φ p)) (𝓝 (flatMap Φ p)) := by
    have := P.continuous.tendsto (flatMap Φ p)
    rwa [hPw] at this
  have hT : Tendsto (fun w => flatInv Φ (P w)) (𝓝 (flatMap Φ p)) (𝓝 p) := by
    have h := (continuousAt_flatInv hwT hΦsrc).tendsto
    rw [flatInv_flatMap hp] at h
    exact h.comp hPT
  -- `g ∘ φ ∘ P` vanishes near `ψ p`
  have hzero : (fun w => (g ∘ flatInv Φ) (P w)) =ᶠ[𝓝 (flatMap Φ p)] fun _ => 0 := by
    filter_upwards [hPT.eventually (Φ.isOpen_target.mem_nhds hwT), hT.eventually hgN] with w hw hw'
    exact hw' (flatInv_mem hΦsrc hflat hw (planeRetract_mem k w))
  have hdg : DifferentiableAt ℂ (g ∘ flatInv Φ) (P (flatMap Φ p)) := by
    rw [hPw]
    exact differentiableAt_comp_flatInv hwT hΦsrc (by rw [flatInv_flatMap hp]; exact hgp)
  have hchain := (hdg.hasFDerivAt.comp (flatMap Φ p) P.hasFDerivAt).fderiv
  have h0 : fderiv ℂ (fun w => (g ∘ flatInv Φ) (P w)) (flatMap Φ p) = 0 := by
    rw [hzero.fderiv_eq]
    exact fderiv_const_apply _
  have h1 : (fderiv ℂ (g ∘ flatInv Φ) (P (flatMap Φ p))).comp P = 0 := by
    rw [← hchain]
    exact h0
  have hPu : P u = u := planeRetract_of_mem hu
  have h2 : ((fderiv ℂ (g ∘ flatInv Φ) (P (flatMap Φ p))).comp P) u =
      (0 : ComplexModel n →L[ℂ] ℂ) u := by rw [h1]
  rw [ContinuousLinearMap.comp_apply, hPw, hPu] at h2
  simpa using h2

include hΦsrc hΦx in
/-- **Derivatives of the flattened function**: near `0`, `∂_v (f ∘ φ ∘ P) = (ξ_{Pv} f) ∘ φ ∘ P`. -/
theorem dirDeriv_flatten_eventuallyEq {f : M → ℂ} (hf : HolomorphicAt n f x) (v : ComplexModel n) :
    dirDeriv v (flatten Φ k f) =ᶠ[𝓝 0]
      flatten Φ k (fieldDeriv (complexChartAt (n := n) x) (flatField Φ (planeRetract k v)) f) := by
  filter_upwards [eventually_planeRetract_mem_target hΦsrc hΦx k,
    (tendsto_flatInv_planeRetract hΦsrc hΦx k).eventually hf.eventually_nhds] with w hw hfw
  have hd : DifferentiableAt ℂ (f ∘ flatInv Φ) (planeRetract k w) :=
    differentiableAt_comp_flatInv hw hΦsrc hfw
  have hchain : fderiv ℂ (flatten Φ k f) w =
      (fderiv ℂ (f ∘ flatInv Φ) (planeRetract k w)).comp (planeRetract (n := n) k) :=
    (hd.hasFDerivAt.comp w (planeRetract (n := n) k).hasFDerivAt).fderiv
  simp only [dirDeriv, hchain, ContinuousLinearMap.comp_apply, flatten]
  rw [fieldDeriv_flatField (flatInv_mem_flatDomain hw hΦsrc) hfw, flatMap_flatInv hw hΦsrc]

end Flat

/-! ### Giraud along `N`, second inclusion -/

section Converse

variable {N : Set M} {𝔞 : GermIdeal n M}

/-- **Converse half of Giraud along `N`**: at a point `x` where `N` is a submanifold, for `μ ≥ 1`,
`ord_x((𝓓_N 𝔞)|_N) ≥ μ ⇒ ord_x(𝔞|_N) ≥ μ + 1`. -/
theorem orderGE_succ_of_orderGE_derivIdealAlong (h𝔞 : ∀ x g, 𝔞.mem x g → HolomorphicAt n g x)
    {x : M} {k : ℕ} (hN : RegularAtDim (n := n) N x k) {μ : ℕ} (hμ : 1 ≤ μ)
    (hx : OrderGE n N (derivIdealAlong N 𝔞) x μ) : OrderGE n N 𝔞 x (μ + 1) := by
  obtain ⟨-, -, Φ, hΦsrc, hΦx, hflat⟩ := hN
  intro f hf
  have hfhol := h𝔞 x f hf
  refine vanishesToOrderOn_of_iterDeriv_flatten_eq_zero hΦsrc hΦx hflat hfhol (μ + 1) fun L hL => ?_
  rcases List.eq_nil_or_concat L with rfl | ⟨L', v, rfl⟩
  · exact iterDeriv_flatten_eq_zero_of_vanishesToOrderOn hΦsrc hΦx hflat
      (hx f (le_derivIdealAlong h𝔞 x f hf)) [] (by simp; omega)
  · rw [List.concat_eq_append, iterDeriv_append]
    have hL' : L'.length < μ := by simp at hL; omega
    have hD := dirDeriv_flatten_eventuallyEq hΦsrc hΦx (k := k) hfhol v
    have hv : iterDeriv [v] (flatten Φ k f) = dirDeriv v (flatten Φ k f) := rfl
    rw [hv, (iterDeriv_eventuallyEq hD L').self_of_nhds]
    have hξ : IsTangentField N (complexChartAt (n := n) x) (flatField Φ (planeRetract k v)) x :=
      isTangentField_flatField hΦsrc hflat (planeRetract_mem k v) (mem_flatDomain_self Φ)
    have hgen : (derivIdealAlong N 𝔞).mem x
        (fieldDeriv (complexChartAt (n := n) x) (flatField Φ (planeRetract k v)) f) :=
      isInSpanAt_of_eq_mul (Or.inr (Or.inr ⟨_, _, f, hξ, hf, rfl⟩))
        (holomorphicAt_fieldDeriv hξ.mem_source hξ.holomorphicAt hfhol) (holomorphicAt_const 1)
        (Eventually.of_forall fun _ => (one_mul _).symm)
    exact iterDeriv_flatten_eq_zero_of_vanishesToOrderOn hΦsrc hΦx hflat (hx _ hgen) L' hL'

/-- **Giraud--Villamayor along `N`, second inclusion**: for `N` a submanifold at each of its points and `μ ≥ 1`,
`cosupp((𝓓_N 𝔞)|_N, μ) ⊆ cosupp(𝔞|_N, μ + 1)`. -/
theorem cosupport_derivIdealAlong_subset_cosupport_succ (h𝔞 : ∀ x g, 𝔞.mem x g → HolomorphicAt n g x)
    (hN : ∀ x ∈ N, ∃ k, RegularAtDim (n := n) N x k) {μ : ℕ} (hμ : 1 ≤ μ) :
    cosupport n N (derivIdealAlong N 𝔞) μ ⊆ cosupport n N 𝔞 (μ + 1) := by
  rintro x ⟨hxN, hx⟩
  obtain ⟨k, hk⟩ := hN x hxN
  exact ⟨hxN, orderGE_succ_of_orderGE_derivIdealAlong h𝔞 hk hμ hx⟩

/-- **Giraud--Villamayor along `N`**: for `μ ≥ 1`, `cosupp(𝔞|_N, μ + 1) = cosupp((𝓓_N 𝔞)|_N, μ)`. -/
theorem cosupport_succ_eq_cosupport_derivIdealAlong (h𝔞 : ∀ x g, 𝔞.mem x g → HolomorphicAt n g x)
    (hN : ∀ x ∈ N, ∃ k, RegularAtDim (n := n) N x k) {μ : ℕ} (hμ : 1 ≤ μ) :
    cosupport n N 𝔞 (μ + 1) = cosupport n N (derivIdealAlong N 𝔞) μ :=
  Subset.antisymm (cosupport_succ_subset_cosupport_derivIdealAlong h𝔞 μ)
    (cosupport_derivIdealAlong_subset_cosupport_succ h𝔞 hN hμ)

/-- The germs of the iterated derivative ideals along `N` are holomorphic. -/
theorem holomorphicAt_of_mem_iterDerivIdealAlong (h𝔞 : ∀ x g, 𝔞.mem x g → HolomorphicAt n g x) :
    ∀ (j : ℕ) (x : M) (g : M → ℂ), (iterDerivIdealAlong N 𝔞 j).mem x g → HolomorphicAt n g x
  | 0 => h𝔞
  | _ + 1 => fun _ _ hg => hg.1

/-- **Giraud--Villamayor along `N`, iterated**: for `μ ≥ 1` and every `i`,
`cosupp(𝔞|_N, μ + i) = cosupp((𝓓_N^i 𝔞)|_N, μ)`. -/
theorem cosupport_add_eq_cosupport_iterDerivIdealAlong (h𝔞 : ∀ x g, 𝔞.mem x g → HolomorphicAt n g x)
    (hN : ∀ x ∈ N, ∃ k, RegularAtDim (n := n) N x k) :
    ∀ (i : ℕ) {μ : ℕ}, 1 ≤ μ → cosupport n N 𝔞 (μ + i) = cosupport n N (iterDerivIdealAlong N 𝔞 i) μ
  | 0, _, _ => rfl
  | i + 1, μ, hμ => by
    rw [show μ + (i + 1) = (μ + 1) + i by omega,
      cosupport_add_eq_cosupport_iterDerivIdealAlong h𝔞 hN i (by omega : 1 ≤ μ + 1),
      cosupport_succ_eq_cosupport_derivIdealAlong (holomorphicAt_of_mem_iterDerivIdealAlong h𝔞 i) hN hμ]
    rfl

/-- **The cosupport along `N` is the trace on `N` of a zero locus**: `cosupp(𝔞|_N, j + 1) = N ∩ V(𝓓_N^j 𝔞)`. -/
theorem cosupport_succ_eq_inter_zeroLocus_iterDerivIdealAlong
    (h𝔞 : ∀ x g, 𝔞.mem x g → HolomorphicAt n g x) (hN : ∀ x ∈ N, ∃ k, RegularAtDim (n := n) N x k)
    (j : ℕ) : cosupport n N 𝔞 (j + 1) = N ∩ (iterDerivIdealAlong N 𝔞 j).zeroLocus := by
  rw [show j + 1 = 1 + j by omega, cosupport_add_eq_cosupport_iterDerivIdealAlong h𝔞 hN j le_rfl,
    cosupport_one (holomorphicAt_of_mem_iterDerivIdealAlong h𝔞 j)]

/-- **The cosupport along a closed submanifold of a coherent ideal is closed.** -/
theorem isClosed_cosupport_along (h𝔞 : 𝔞.IsCoherent) (hN : IsClosedSubmanifold n N) (μ : ℕ) :
    IsClosed (cosupport n N 𝔞 μ) := by
  refine isOpen_compl_iff.mp (isOpen_iff_mem_nhds.mpr fun x hx => ?_)
  by_cases hxN : x ∈ N
  swap
  · filter_upwards [hN.1.isOpen_compl.mem_nhds hxN] with y hy hyc
    exact hy hyc.1
  have hhol : ∀ x g, 𝔞.mem x g → HolomorphicAt n g x := fun x g hg =>
    RelativePrincipalizationSpan.GermIdeal.IsCoherent.holomorphicAt_mem h𝔞 hg
  obtain ⟨k, -, -, Φ, hΦsrc, hΦx, hflat⟩ := hN.2 x hxN
  -- a germ of `𝔞_x` of order `< μ` along `N`
  obtain ⟨f, hf, hfo⟩ : ∃ f, 𝔞.mem x f ∧ ¬ VanishesToOrderOn n N x μ f := by
    by_contra! h
    exact hx ⟨hxN, h⟩
  obtain ⟨L, hL, hLne⟩ : ∃ L : List (ComplexModel n), L.length < μ ∧
      iterDeriv L (flatten Φ k f) 0 ≠ 0 := by
    by_contra! h
    exact hfo (vanishesToOrderOn_of_iterDeriv_flatten_eq_zero hΦsrc hΦx hflat (hhol x f hf) μ h)
  -- the derivative stays nonzero near `0`
  obtain ⟨U, hU, hUo, h0U⟩ := eventually_nhds_iff.mp
    (eventually_differentiableAt_flatten hΦsrc hΦx k (hhol x f hf))
  have hdU : DifferentiableOn ℂ (flatten Φ k f) U := fun w hw => (hU w hw).differentiableWithinAt
  have hcont : ContinuousAt (iterDeriv L (flatten Φ k f)) 0 :=
    ((differentiableOn_iterDeriv hdU hUo L).differentiableAt (hUo.mem_nhds h0U)).continuousAt
  have hne : ∀ᶠ w in 𝓝 (0 : ComplexModel n), iterDeriv L (flatten Φ k f) w ≠ 0 :=
    hcont.eventually (isOpen_ne.mem_nhds hLne)
  have hψ : Tendsto (flatMap Φ) (𝓝 x) (𝓝 0) := by
    have h1 : ContinuousAt (flatMap Φ) x :=
      ((Φ.toFun_holomorphic.differentiableAt
        (Φ.isOpen_source.mem_nhds Φ.center_mem_source)).continuousAt).comp
        ((chartAt (ComplexModel n) x).continuousAt (mem_chart_source _ x))
    have h2 : flatMap Φ x = 0 := hΦx
    rw [ContinuousAt, h2] at h1
    exact h1
  filter_upwards [(isOpen_flatDomain Φ).mem_nhds (mem_flatDomain_self Φ), hψ.eventually hne,
    eventually_mem_of_isCoherent h𝔞 hf] with y hy hyne hyf hyc
  exact hyne (iterDeriv_flatten_flatMap_eq_zero hΦsrc hflat hy hyc.1 (hyc.2 f hyf) L hL)

end Converse

end

end Hironaka.GiraudAlong
