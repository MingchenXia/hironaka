/-!
# Tangent directions along a submanifold and hypersurfaces of maximal contact inside it

Sources: Włodarczyk 2005, §2.7 (tangent directions, Giraud), applied on the submanifold `N` of a marked ideal `(M,
N, E, 𝔞, μ)` with the derivative ideals `𝓓_N` along `N` (`DerivativeIdealAlong.derivIdealAlong`); Bierstone--Milman
2008, §3 (maximal contact on `N`).

* `IsTangentDirectionAlong N 𝔞 μ U u`: `u` is a germ of `𝓓_N^{μ-1}(𝔞)` at every point of the open set `U`, and at
  each of its zeros in `U` some holomorphic vector field tangent to `N` has `ξ(u) ≠ 0` (the restriction `u|_N` has
  nonvanishing differential there).
* `IsTangentDirectionAlong.cosupport_inter_subset`: `cosupp(𝔞|_N, μ) ∩ U ⊆ V(u)` (any `N`, `μ ≥ 1`).
* `exists_isTangentDirectionAlong`: for `𝔞` coherent, `N` a closed submanifold and `x ∈ cosupp(𝔞|_N, μ)` with
  `ord_x(𝔞|_N) ≤ μ` (maximal order AT `x`), there is a tangent direction along `N` on a neighbourhood of `x`.  It is a
  generator `sᵢ` of `𝓓_N^{μ-1}(𝔞)` one of whose tangential flat partials `∂sᵢ/∂ψ_j` does not vanish at `x`
  (`DerivativeIdealAlongCoherent.derivIdealAlong_mem_iff_of_generators` applied to `𝓓_N^μ = 𝓓_N(𝓓_N^{μ-1})` and
  Giraud--Villamayor along `N`, `GiraudAlong.cosupport_succ_eq_inter_zeroLocus_iterDerivIdealAlong`).
* The hypersurface of maximal contact inside `N`: if `N` is flattened at `x` onto `ℂᵏ × 0` and `u` (holomorphic on `U`)
  vanishes at `x ∈ N` with `ξ(u)(x) ≠ 0` for a field `ξ` tangent to `N`, then `N ∩ V(u) ∩ U` is regular of dimension
  `k - 1` at `x` (`regularAtDim_inter_zeroSet`), and near `x` its vanishing ideal is generated by `u` and the normal
  coordinates of `N` (`exists_vanishingIdeal_inter_zeroSet_mem_iff`).  The coordinates are `ψ` with the `j`-th one
  (`∂u/∂ψ_j(x) ≠ 0`, `j < k`) replaced by `u` and moved to the place `k - 1` (`contactCoords`).

Not here: the behaviour along multiple test blow-ups (the cosupports stay in the strict transforms of `V(u) ∩ N`), which
needs the transforms along `N` (item (2) of `hir:along-calculus`).
-/

open Set Filter
open scoped Topology Manifold ContDiff

namespace Hironaka.TangentDirectionAlong

open Hironaka.HolomorphicIdealSheaves Hironaka.BlowupSequences
open Hironaka.GermIdealOrder Hironaka.DerivativeIdeal Hironaka.DerivativeIdealAlong Hironaka.GiraudAlong Hironaka.BlowupFlatCoordinates Hironaka.DerivativeIdealAlongCoherent Hironaka.RelativePrincipalizationSpan Hironaka.SimultaneousNormalCrossings Hironaka.BlowupSNCTransform Hironaka.BlowupStrictIdeal Hironaka.BlowupStrictSubmanifold

noncomputable section

variable {n : ℕ} {M : Type*} [TopologicalSpace M] [ChartedSpace (ComplexModel n) M]
  [IsComplexManifold n M]

/-! ### Tangent directions along a submanifold -/

/-- **A tangent direction of `(𝔞|_N, μ)` on the open set `U`**: a germ of `𝓓_N^{μ-1}(𝔞)` at every point of `U` whose
derivative along some holomorphic vector field tangent to `N` does not vanish at any of its zeros in `U`. -/
structure IsTangentDirectionAlong (N : Set M) (𝔞 : GermIdeal n M) (μ : ℕ) (U : Set M) (u : M → ℂ) : Prop where
  isOpen : IsOpen U
  mem : ∀ x ∈ U, (iterDerivIdealAlong N 𝔞 (μ - 1)).mem x u
  multiplicity_one : ∀ x ∈ U, u x = 0 →
    ∃ (e : ComplexChart n M) (ξ : Fin n → M → ℂ), IsTangentField N e ξ x ∧ fieldDeriv e ξ u x ≠ 0

variable {N : Set M} {𝔞 : GermIdeal n M}

/-- **Giraud's inclusion along `N`, iterated**: `cosupp(𝔞|_N, μ + j) ⊆ cosupp((𝓓_N^j 𝔞)|_N, μ)` (any `N`). -/
theorem cosupport_add_subset_cosupport_iterDerivIdealAlong (h𝔞 : ∀ x g, 𝔞.mem x g → HolomorphicAt n g x)
    (μ : ℕ) : ∀ j, cosupport n N 𝔞 (μ + j) ⊆ cosupport n N (iterDerivIdealAlong N 𝔞 j) μ
  | 0 => subset_rfl
  | j + 1 => by
    have h1 : cosupport n N 𝔞 (μ + (j + 1)) ⊆ cosupport n N (iterDerivIdealAlong N 𝔞 j) (μ + 1) := by
      rw [show μ + (j + 1) = (μ + 1) + j by omega]
      exact cosupport_add_subset_cosupport_iterDerivIdealAlong h𝔞 (μ + 1) j
    exact h1.trans (cosupport_succ_subset_cosupport_derivIdealAlong
      (holomorphicAt_of_mem_iterDerivIdealAlong h𝔞 j) μ)

/-- Every germ of `𝓓_N^{μ-1}(𝔞)` vanishes on `cosupp(𝔞|_N, μ)` (`μ ≥ 1`, any `N`). -/
theorem apply_eq_zero_of_mem_cosupport (h𝔞 : ∀ x g, 𝔞.mem x g → HolomorphicAt n g x) {μ : ℕ} (hμ : 1 ≤ μ)
    {x : M} (hx : x ∈ cosupport n N 𝔞 μ) {g : M → ℂ} (hg : (iterDerivIdealAlong N 𝔞 (μ - 1)).mem x g) :
    g x = 0 := by
  have hx' : x ∈ cosupport n N (iterDerivIdealAlong N 𝔞 (μ - 1)) 1 := by
    refine cosupport_add_subset_cosupport_iterDerivIdealAlong h𝔞 1 (μ - 1) ?_
    rwa [Nat.add_sub_cancel' hμ]
  exact (vanishesToOrderOn_one_iff hx'.1
    (holomorphicAt_of_mem_iterDerivIdealAlong h𝔞 (μ - 1) x g hg)).mp (hx'.2 g hg)

/-- **The cosupport along `N` lies on every tangent direction along `N`**: `cosupp(𝔞|_N, μ) ∩ U ⊆ V(u)`. -/
theorem IsTangentDirectionAlong.cosupport_inter_subset (h𝔞 : ∀ x g, 𝔞.mem x g → HolomorphicAt n g x) {μ : ℕ}
    (hμ : 1 ≤ μ) {U : Set M} {u : M → ℂ} (hu : IsTangentDirectionAlong N 𝔞 μ U u) :
    cosupport n N 𝔞 μ ∩ U ⊆ {x | u x = 0} :=
  fun x hx => apply_eq_zero_of_mem_cosupport h𝔞 hμ hx.1 (hu.mem x hx.2)

/-! ### Existence of tangent directions along `N` -/

/-- **Existence of tangent directions along `N`** (Włodarczyk §2.7 on the submanifold `N`): for `𝔞` coherent, `N` a closed
submanifold, `μ ≥ 1` and `x ∈ cosupp(𝔞|_N, μ)` at which `ord_x(𝔞|_N) ≤ μ` (maximal order at `x`), there is a tangent
direction of `(𝔞|_N, μ)` along `N` on an open neighbourhood of `x`. -/
theorem exists_isTangentDirectionAlong (h𝔞 : 𝔞.IsCoherent) (hN : IsClosedSubmanifold n N) {μ : ℕ} (hμ : 1 ≤ μ)
    {x : M} (hx : x ∈ cosupport n N 𝔞 μ) (hmax : ¬ OrderGE n N 𝔞 x (μ + 1)) :
    ∃ (U : Set M) (u : M → ℂ), x ∈ U ∧ IsTangentDirectionAlong N 𝔞 μ U u := by
  classical
  have hhol : ∀ x g, 𝔞.mem x g → HolomorphicAt n g x := fun x g hg =>
    RelativePrincipalizationSpan.GermIdeal.IsCoherent.holomorphicAt_mem h𝔞 hg
  obtain ⟨μ', rfl⟩ : ∃ μ', μ = μ' + 1 := ⟨μ - 1, by omega⟩
  have hsub : μ' + 1 - 1 = μ' := Nat.add_sub_cancel μ' 1
  have hxN : x ∈ N := hx.1
  -- a germ of `𝓓_N^{μ}(𝔞)` not vanishing at `x` (Giraud--Villamayor along `N`)
  obtain ⟨g, hg, hgx⟩ : ∃ g, (iterDerivIdealAlong N 𝔞 (μ' + 1)).mem x g ∧ g x ≠ 0 := by
    by_contra hall
    push Not at hall
    apply hmax
    have hmem : x ∈ N ∩ (iterDerivIdealAlong N 𝔞 (μ' + 1)).zeroLocus := ⟨hxN, fun g hg => hall g hg⟩
    rw [← cosupport_succ_eq_inter_zeroLocus_iterDerivIdealAlong hhol hN.2] at hmem
    exact hmem.2
  -- generators of `𝓓_N^{μ-1}(𝔞)` near `x` and a flat chart of `N` at `x`
  obtain ⟨k, -, -, Φ, hΦsrc, hΦx, hflat⟩ := hN.2 x hxN
  obtain ⟨U₀, hU₀o, hxU₀, r, s, hs, hgen⟩ := isCoherent_iterDerivIdealAlong h𝔞 hN μ' x
  have hOo : IsOpen (U₀ ∩ flatDomain Φ) := hU₀o.inter (isOpen_flatDomain Φ)
  have hxO : x ∈ U₀ ∩ flatDomain Φ := ⟨hxU₀, mem_flatDomain_self Φ⟩
  have hshol : ∀ i, ∀ z ∈ U₀, HolomorphicAt n (s i) z := fun i z hz =>
    eventually_of_mem (hU₀o.mem_nhds hz) fun w hw => (hs i w hw).mdifferentiableAt (hU₀o.mem_nhds hw)
  have hsmem : ∀ i, ∀ y ∈ U₀, (iterDerivIdealAlong N 𝔞 μ').mem y (s i) := fun i y hy =>
    (hgen y hy (s i)).mpr (isInSpanAt_of_eq_mul ⟨i, rfl⟩ (hshol i y hy) (holomorphicAt_const 1)
      (Eventually.of_forall fun _ => (one_mul _).symm))
  have hg' := (derivIdealAlong_mem_iff_of_generators hΦsrc hflat hOo inter_subset_right
    (fun i => (hs i).mono inter_subset_left) (fun w hw => hgen w hw.1) hxO g).mp hg
  obtain ⟨-, K, t, a, ht, -, hsum⟩ := hg'
  -- some member of the generating family does not vanish at `x`
  obtain ⟨c, hc⟩ : ∃ c, derivFamilyAlong Φ k s c x ≠ 0 := by
    by_contra hall
    push Not at hall
    apply hgx
    rw [hsum.self_of_nhds]
    refine Finset.sum_eq_zero fun l _ => ?_
    obtain ⟨c, hc⟩ := ht l
    rw [← hc, hall c, mul_zero]
  rcases c with i | j | ⟨i, j⟩
  · -- a generator of `𝓓_N^{μ-1}(𝔞)` vanishes on the cosupport
    exact absurd (apply_eq_zero_of_mem_cosupport hhol hμ hx (by rw [hsub]; exact hsmem i x hxU₀)) hc
  · -- a normal coordinate vanishes at `x`
    exfalso
    by_cases hj : k ≤ j.1
    · apply hc
      have h0 := congrArg (fun w : ComplexModel n => w j) hΦx
      simp only [derivFamilyAlong, hj, if_true, flatCoord]
      exact h0
    · exact hc (by simp [derivFamilyAlong, hj])
  · by_cases hj : j.1 < k
    swap
    · exact absurd (by simp [derivFamilyAlong, hj]) hc
    -- a tangential partial `∂sᵢ/∂ψ_j` does not vanish at `x`: take `u = sᵢ`
    have hne : flatPartial Φ j (s i) x ≠ 0 := by simpa [derivFamilyAlong, hj] using hc
    have hcont : ContinuousAt (flatPartial Φ j (s i)) x :=
      (holomorphicAt_flatPartial j (mem_flatDomain_self Φ) (hshol i x hxU₀)).self_of_nhds.continuousAt
    obtain ⟨V, hVsub, hVo, hxV⟩ := mem_nhds_iff.mp (hcont.eventually (isOpen_ne.mem_nhds hne))
    refine ⟨V ∩ (U₀ ∩ flatDomain Φ), s i, ⟨hxV, hxO⟩, hVo.inter hOo, fun y hy => ?_, fun y hy _ => ?_⟩
    · rw [hsub]
      exact hsmem i y hy.2.1
    · exact ⟨complexChartAt (n := n) x, flatField Φ (EuclideanSpace.single j 1),
        isTangentField_flatField hΦsrc hflat (single_mem_complexCoordinatePlane hj) hy.2.2, hVsub hy.1⟩

/-! ### The hypersurface of maximal contact inside `N` -/

section Contact

variable {x : M} {Φ : LocalHolomorphicEquivAt (n := n) (chartAt (ComplexModel n) x x)}
  (hΦsrc : Φ.source ⊆ (chartAt (ComplexModel n) x).target) {k : ℕ}
  (hflat : ∀ {y : M}, y ∈ (chartAt (ComplexModel n) x).source → chartAt (ComplexModel n) x y ∈ Φ.source →
    (y ∈ N ↔ Φ.toFun (chartAt (ComplexModel n) x y) ∈ complexCoordinatePlane n k))

include hΦsrc hflat in
/-- **A field tangent to `N` only sees the tangential flat partials**: at `y ∈ N` in the flat domain, if `ξ(u)(y) ≠ 0` for a
field `ξ` tangent to `N` at `y`, then `∂u/∂ψ_j(y) ≠ 0` for some tangential index `j < k`. -/
theorem exists_flatPartial_ne_zero {y : M} (hy : y ∈ flatDomain Φ) (hyN : y ∈ N) {u : M → ℂ}
    (hu : HolomorphicAt n u y) {e : ComplexChart n M} {ξ : Fin n → M → ℂ} (hξ : IsTangentField N e ξ y)
    (hne : fieldDeriv e ξ u y ≠ 0) : ∃ j : Fin n, j.1 < k ∧ flatPartial Φ j u y ≠ 0 := by
  have hsum := (fieldDeriv_eventuallyEq_sum_flatPartial hΦsrc e ξ hξ.mem_source hy hu).self_of_nhds
  rw [hsum] at hne
  obtain ⟨j, -, hj⟩ := Finset.exists_ne_zero_of_sum_ne_zero hne
  refine ⟨j, ?_, right_ne_zero_of_mul hj⟩
  by_contra hjk
  push Not at hjk
  have hvan := hξ.preserves _ (flatCoord_mem_vanishingIdeal Φ hflat hjk hy)
  exact hj (by rw [hvan.2.self_of_nhds hyN, zero_mul])

variable (Φ) in
/-- **Coordinates adapted to `N ∩ V(u)`**: the flat coordinates `ψ` of `N`, permuted by the transposition of `j` and `l`,
with the `l`-th coordinate replaced by `u`. -/
def contactCoords (j l : Fin n) (u : M → ℂ) (y : M) : ComplexModel n :=
  selMap (Equiv.swap j l) (fun r => r ≠ l) (flatMap Φ y) + u y • EuclideanSpace.single l (1 : ℂ)

theorem contactCoords_apply (j l : Fin n) (u : M → ℂ) (y : M) (r : Fin n) :
    contactCoords Φ j l u y r = if r = l then u y else flatMap Φ y (Equiv.swap j l r) := by
  by_cases hr : r = l
  · subst hr
    simp [contactCoords, selMap_apply]
  · simp [contactCoords, selMap_apply, hr]

include hflat in
/-- On the flat domain, `contactCoords` lies in `ℂ^{k-1} × 0` exactly at the points of `N ∩ V(u)`
(`j < k`, `l = k - 1`). -/
theorem contactCoords_mem_plane_iff {j l : Fin n} (hj : j.1 < k) (hl : l.1 + 1 = k) (u : M → ℂ) {y : M}
    (hy : y ∈ flatDomain Φ) :
    contactCoords Φ j l u y ∈ complexCoordinatePlane n (k - 1) ↔ y ∈ N ∧ u y = 0 := by
  rw [mem_iff_flatMap_mem hflat hy]
  have hswap : ∀ r : Fin n, k ≤ r.1 → Equiv.swap j l r = r := fun r hr =>
    Equiv.swap_apply_of_ne_of_ne (fun h => by subst h; omega) (fun h => by subst h; omega)
  constructor
  · intro h
    refine ⟨fun r hr => ?_, ?_⟩
    · have := h r (by omega)
      rwa [contactCoords_apply, if_neg (fun h => by subst h; omega), hswap r hr] at this
    · have := h l (by omega)
      rwa [contactCoords_apply, if_pos rfl] at this
  · rintro ⟨hN', hu'⟩ r hr
    rw [contactCoords_apply]
    by_cases hrl : r = l
    · rw [if_pos hrl, hu']
    · have hrk : k ≤ r.1 := by
        have : r.1 ≠ l.1 := fun h => hrl (Fin.ext h)
        omega
      rw [if_neg hrl, hswap r hrk]
      exact hN' r hrk

/-- `contactCoords` is holomorphic wherever `u` is, on the flat domain. -/
theorem mdifferentiableAt_contactCoords (j l : Fin n) {u : M → ℂ} {y : M} (hy : y ∈ flatDomain Φ)
    (hu : HolomorphicAt n u y) :
    MDifferentiableAt 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel n) (contactCoords Φ j l u) y := by
  have h1 : MDifferentiableAt 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel n) (flatMap Φ) y := by
    have h2 : MDifferentiableAt 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel n) Φ.toFun
        (chartAt (ComplexModel n) x y) :=
      (Φ.toFun_holomorphic.differentiableAt (Φ.isOpen_source.mem_nhds hy.2)).mdifferentiableAt
    exact h2.comp y (mdifferentiableAt_chart hy.1)
  have h3 := (selMap (Equiv.swap j l) (fun r => r ≠ l)).differentiableAt.mdifferentiableAt.comp y h1
  have hu' : MDifferentiableAt 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ℂ) u y := hu.self_of_nhds
  exact h3.add (MDifferentiableAt.smul hu' mdifferentiableAt_const)

include hΦsrc in
/-- **The differential of `contactCoords` at `x` is injective** when `∂u/∂ψ_j(x) ≠ 0`. -/
theorem injective_fderiv_contactCoords {j l : Fin n} {u : M → ℂ} (hu : HolomorphicAt n u x)
    (hne : flatPartial Φ j u x ≠ 0) :
    Function.Injective (fderiv ℂ (fun ζ => contactCoords Φ j l u ((chartAt (ComplexModel n) x).symm ζ))
      (chartAt (ComplexModel n) x x)) := by
  classical
  have hx0 : x ∈ flatDomain Φ := mem_flatDomain_self Φ
  have hcs : chartAt (ComplexModel n) x x ∈ Φ.source := Φ.center_mem_source
  -- `u ∘ ψ⁻¹` is differentiable at `ψ x`
  have hud : DifferentiableAt ℂ (u ∘ flatInv Φ) (flatMap Φ x) :=
    differentiableAt_comp_flatInv (flatMap_mem_target hx0) hΦsrc (by rw [flatInv_flatMap hx0]; exact hu)
  have haj : fderiv ℂ (u ∘ flatInv Φ) (flatMap Φ x) (EuclideanSpace.single j 1) ≠ 0 := by
    rw [← flatPartial_eq hx0 hu j]
    exact hne
  -- the map in the chart is `G ∘ Φ` near `c = e x`
  have hloc : (fun ζ => contactCoords Φ j l u ((chartAt (ComplexModel n) x).symm ζ)) =ᶠ[𝓝 (chartAt (ComplexModel n) x x)]
      (fun w => selMap (Equiv.swap j l) (fun r => r ≠ l) w +
        (u ∘ flatInv Φ) w • EuclideanSpace.single l (1 : ℂ)) ∘ Φ.toFun := by
    filter_upwards [(chartAt (ComplexModel n) x).open_target.mem_nhds
      ((chartAt (ComplexModel n) x).map_source (mem_chart_source _ x)),
      Φ.isOpen_source.mem_nhds hcs] with ζ hζt hζs
    have h1 : flatMap Φ ((chartAt (ComplexModel n) x).symm ζ) = Φ.toFun ζ := by
      simp only [flatMap, (chartAt (ComplexModel n) x).right_inv hζt]
    have h2 : flatInv Φ (Φ.toFun ζ) = (chartAt (ComplexModel n) x).symm ζ := by
      simp only [flatInv, Φ.left_inv ζ hζs]
    simp only [contactCoords, Function.comp_apply, h1, h2]
  have hΦd : HasFDerivAt Φ.toFun (fderiv ℂ Φ.toFun (chartAt (ComplexModel n) x x))
      (chartAt (ComplexModel n) x x) :=
    (Φ.toFun_holomorphic.differentiableAt (Φ.isOpen_source.mem_nhds hcs)).hasFDerivAt
  have hGd : HasFDerivAt (fun w => selMap (Equiv.swap j l) (fun r => r ≠ l) w +
        (u ∘ flatInv Φ) w • EuclideanSpace.single l (1 : ℂ))
      (selMap (Equiv.swap j l) (fun r => r ≠ l) +
        (fderiv ℂ (u ∘ flatInv Φ) (flatMap Φ x)).smulRight (EuclideanSpace.single l (1 : ℂ)))
      (Φ.toFun (chartAt (ComplexModel n) x x)) :=
    (selMap (Equiv.swap j l) (fun r => r ≠ l)).hasFDerivAt.add (hud.hasFDerivAt.smul_const _)
  have hD := (hGd.comp (chartAt (ComplexModel n) x x) hΦd).congr_of_eventuallyEq hloc
  rw [hD.fderiv]
  -- `DΦ(c)` is injective (left inverse `DΦ⁻¹`)
  have hΦinj : Function.Injective (fderiv ℂ Φ.toFun (chartAt (ComplexModel n) x x)) := by
    have hinvd : HasFDerivAt Φ.invFun (fderiv ℂ Φ.invFun (Φ.toFun (chartAt (ComplexModel n) x x)))
        (Φ.toFun (chartAt (ComplexModel n) x x)) :=
      (Φ.invFun_holomorphic.differentiableAt
        (Φ.isOpen_target.mem_nhds (Φ.mapsTo_toFun hcs))).hasFDerivAt
    have hid : (Φ.invFun ∘ Φ.toFun) =ᶠ[𝓝 (chartAt (ComplexModel n) x x)] id := by
      filter_upwards [Φ.isOpen_source.mem_nhds hcs] with ζ hζ
      exact Φ.left_inv ζ hζ
    have hcomp := ((hinvd.comp (chartAt (ComplexModel n) x x) hΦd).congr_of_eventuallyEq hid.symm)
    have hid' := hcomp.unique (hasFDerivAt_id (chartAt (ComplexModel n) x x))
    intro v w hvw
    have h1 := congrArg (fun L : ComplexModel n →L[ℂ] ComplexModel n => L v) hid'
    have h2 := congrArg (fun L : ComplexModel n →L[ℂ] ComplexModel n => L w) hid'
    simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.id_apply] at h1 h2
    rw [← h1, ← h2, hvw]
  set τ : Equiv.Perm (Fin n) := Equiv.swap j l with hτ
  set Lsel := selMap τ (fun r => r ≠ l) with hLsel
  set a := fderiv ℂ (u ∘ flatInv Φ) (flatMap Φ x) with ha
  -- the linear algebra: `Lsel + a ⊗ e_l` is injective since `a(e_j) ≠ 0`
  have hLinj : Function.Injective (Lsel + a.smulRight (EuclideanSpace.single l (1 : ℂ))) := by
    rw [injective_iff_map_eq_zero]
    intro w hw
    have hcomp : ∀ r, Lsel w r + a w * (EuclideanSpace.single l (1 : ℂ)) r = 0 := by
      intro r
      have := congrArg (fun z : ComplexModel n => z r) hw
      simpa using this
    have hoff : ∀ m, m ≠ j → w m = 0 := by
      intro m hm
      have hτm : τ m ≠ l := by
        intro h
        apply hm
        have := congrArg τ h
        rwa [hτ, Equiv.swap_apply_self, Equiv.swap_apply_right] at this
      have := hcomp (τ m)
      simp only [hLsel, selMap_apply, hτm, ne_eq, not_false_eq_true, if_true, PiLp.ofLp_single,
        Pi.single_apply, if_false, mul_zero, add_zero] at this
      rwa [hτ, Equiv.swap_apply_self] at this
    have hwj : w = w j • EuclideanSpace.single j (1 : ℂ) := by
      have := eq_sum_single_of_support (T := {j}) (v := w) fun t ht => hoff t (by simpa using ht)
      simpa using this
    have hlc := hcomp l
    simp only [hLsel, selMap_apply, ne_eq, not_true_eq_false, if_false, PiLp.ofLp_single,
      Pi.single_apply, if_true, mul_one, zero_add] at hlc
    rw [hwj, map_smul, smul_eq_mul] at hlc
    have hwj0 : w j = 0 := (mul_eq_zero.mp hlc).resolve_right haj
    rw [hwj, hwj0, zero_smul]
  exact hLinj.comp hΦinj

include hΦsrc hflat in
/-- **The hypersurface of maximal contact inside `N` is a submanifold of `N` of codimension one**: let `N` be flattened
at `x` onto `ℂᵏ × 0`, `u` holomorphic on the open set `U ∋ x` with `u(x) = 0`, `x ∈ N`, and `ξ(u)(x) ≠ 0` for a field `ξ`
tangent to `N` at `x`. Then `N ∩ V(u) ∩ U` is regular of dimension `k - 1` at `x`. -/
theorem regularAtDim_inter_zeroSet (hk : k ≤ n) {U : Set M} (hU : IsOpen U) {u : M → ℂ}
    (hu : ∀ y ∈ U, HolomorphicAt n u y) (hxU : x ∈ U) (hxN : x ∈ N) (hux : u x = 0) {e : ComplexChart n M}
    {ξ : Fin n → M → ℂ} (hξ : IsTangentField N e ξ x) (hne : fieldDeriv e ξ u x ≠ 0) :
    RegularAtDim (n := n) (N ∩ {y | u y = 0} ∩ U) x (k - 1) := by
  obtain ⟨j, hj, hjne⟩ :=
    exists_flatPartial_ne_zero hΦsrc hflat (mem_flatDomain_self Φ) hxN (hu x hxU) hξ hne
  set l : Fin n := ⟨k - 1, by omega⟩ with hl_def
  have hl : l.1 + 1 = k := by simp only [hl_def]; omega
  have hO : IsOpen (U ∩ flatDomain Φ) := hU.inter (isOpen_flatDomain Φ)
  have hxO : x ∈ U ∩ flatDomain Φ := ⟨hxU, mem_flatDomain_self Φ⟩
  have hWs : ∀ z ∈ U ∩ flatDomain Φ,
      ContMDiffAt 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel n) ∞ (contactCoords Φ j l u) z := fun z hz =>
    contMDiffAt_of_eventually_mdifferentiableAt (eventually_of_mem (hO.mem_nhds hz) fun w hw =>
      mdifferentiableAt_contactCoords j l hw.2 (hu w hw.1))
  obtain ⟨Θ, hΘt, hΘ0, hΘ⟩ := exists_recentred_coords hO hWs hxO
    (injective_fderiv_contactCoords hΦsrc (hu x hxU) hjne)
  have hWx := (contactCoords_mem_plane_iff hflat hj hl u (mem_flatDomain_self Φ)).mpr ⟨hxN, hux⟩
  refine ⟨by omega, ⟨⟨hxN, hux⟩, hxU⟩, Θ, hΘt, hΘ0, fun {y} hy hyΘ => ?_⟩
  obtain ⟨hyO, hΘy⟩ := hΘ hy hyΘ
  rw [hΘy, sub_mem_plane_iff hWx, contactCoords_mem_plane_iff hflat hj hl u hyO.2]
  exact ⟨fun h => ⟨h.1.1, h.1.2⟩, fun h => ⟨⟨h.1, h.2⟩, hyO.1⟩⟩

include hΦsrc hflat in
/-- **The ideal of the hypersurface of maximal contact inside `N`**: under the hypotheses of `regularAtDim_inter_zeroSet`,
near `x` the vanishing ideal of `N ∩ V(u) ∩ U` is generated by `u` and the normal coordinates `ψ_i` (`i ≥ k`) of `N`:
`𝓘_{N ∩ V(u)} = 𝓘_N + (u)`. -/
theorem exists_vanishingIdeal_inter_zeroSet_mem_iff (hk : k ≤ n) {U : Set M} (hU : IsOpen U) {u : M → ℂ}
    (hu : ∀ y ∈ U, HolomorphicAt n u y) (hxU : x ∈ U) (hxN : x ∈ N) (hux : u x = 0) {e : ComplexChart n M}
    {ξ : Fin n → M → ℂ} (hξ : IsTangentField N e ξ x) (hne : fieldDeriv e ξ u x ≠ 0) :
    ∃ V : Set M, IsOpen V ∧ x ∈ V ∧ V ⊆ U ∧ ∀ y ∈ V, ∀ g : M → ℂ,
      (vanishingIdeal (n := n) (N ∩ {y | u y = 0} ∩ U)).mem y g ↔
        IsInSpanAt (n := n) (fun s => s = u ∨ ∃ i : Fin n, k ≤ i.1 ∧ s = flatCoord Φ i) y g := by
  classical
  obtain ⟨j, hj, hjne⟩ :=
    exists_flatPartial_ne_zero hΦsrc hflat (mem_flatDomain_self Φ) hxN (hu x hxU) hξ hne
  set l : Fin n := ⟨k - 1, by omega⟩ with hl_def
  have hl : l.1 + 1 = k := by simp only [hl_def]; omega
  have hO : IsOpen (U ∩ flatDomain Φ) := hU.inter (isOpen_flatDomain Φ)
  have hxO : x ∈ U ∩ flatDomain Φ := ⟨hxU, mem_flatDomain_self Φ⟩
  have hWs : ∀ z ∈ U ∩ flatDomain Φ,
      ContMDiffAt 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel n) ∞ (contactCoords Φ j l u) z := fun z hz =>
    contMDiffAt_of_eventually_mdifferentiableAt (eventually_of_mem (hO.mem_nhds hz) fun w hw =>
      mdifferentiableAt_contactCoords j l hw.2 (hu w hw.1))
  have hWx := (contactCoords_mem_plane_iff hflat hj hl u (mem_flatDomain_self Φ)).mpr ⟨hxN, hux⟩
  obtain ⟨V, hVo, hxV, hVO, hiff⟩ := exists_vanishingIdeal_mem_iff_planeCoords hO hWs hxO
    (injective_fderiv_contactCoords hΦsrc (hu x hxU) hjne) hWx (A := N ∩ {y | u y = 0} ∩ U)
    fun y hy => by
      rw [contactCoords_mem_plane_iff hflat hj hl u hy.2]
      exact ⟨fun h => ⟨h.1.1, h.1.2⟩, fun h => ⟨⟨h.1, h.2⟩, hy.1⟩⟩
  have hswap : ∀ r : Fin n, k ≤ r.1 → Equiv.swap j l r = r := fun r hr =>
    Equiv.swap_apply_of_ne_of_ne (fun h => by subst h; omega) (fun h => by subst h; omega)
  -- the generators `planeCoords W (k - 1)` are `u`, the `ψ_i` (`i ≥ k`) and `0`
  have hpl : planeCoords (contactCoords Φ j l u) (k - 1) l = u := by
    funext y
    simp [planeCoords, hl_def, contactCoords_apply]
  have hpi : ∀ i : Fin n, k ≤ i.1 → planeCoords (contactCoords Φ j l u) (k - 1) i = flatCoord Φ i := by
    intro i hi
    funext y
    have hil : i ≠ l := fun h => by subst h; omega
    simp only [planeCoords, show k - 1 ≤ i.1 by omega, if_true, contactCoords_apply, hil, if_false,
      hswap i hi, flatMap, flatCoord]
  have hp0 : ∀ i : Fin n, i ≠ l → ¬ k ≤ i.1 →
      planeCoords (contactCoords Φ j l u) (k - 1) i = fun _ => 0 := by
    intro i hil hik
    have : ¬ k - 1 ≤ i.1 := by
      intro h
      apply hil
      exact Fin.ext (by simp only [hl_def]; omega)
    simp [planeCoords, this]
  refine ⟨V, hVo, hxV, fun y hy => (hVO hy).1, fun y hy g => ?_⟩
  rw [hiff y hy g]
  have hyO := hVO hy
  constructor
  · intro hg
    refine IsInSpanAt.trans (fun s hs => ?_) hg
    obtain ⟨i, rfl⟩ := hs
    by_cases hil : i = l
    · subst hil
      rw [hpl]
      exact isInSpanAt_of_eq_mul (Or.inl rfl) (hu y hyO.1) (holomorphicAt_const 1)
        (Eventually.of_forall fun _ => (one_mul _).symm)
    · by_cases hik : k ≤ i.1
      · rw [hpi i hik]
        exact isInSpanAt_of_eq_mul (Or.inr ⟨i, hik, rfl⟩) (holomorphicAt_flatCoord Φ i hyO.2)
          (holomorphicAt_const 1) (Eventually.of_forall fun _ => (one_mul _).symm)
      · rw [hp0 i hil hik]
        exact isInSpanAt_zero
  · intro hg
    refine hg.mono fun s hs => ?_
    rcases hs with rfl | ⟨i, hik, rfl⟩
    · exact ⟨l, hpl⟩
    · exact ⟨i, hpi i hik⟩

end Contact

/-- **Hypersurfaces of maximal contact inside `N`**: for a tangent direction `u` of `(𝔞|_N, μ)` along a closed submanifold
`N` on `U`, the set `N ∩ V(u) ∩ U` is regular, of dimension one less than `N`, at each of its points. -/
theorem IsTangentDirectionAlong.regularAtDim_contact (h𝔞 : ∀ x g, 𝔞.mem x g → HolomorphicAt n g x)
    (hN : IsClosedSubmanifold n N) {μ : ℕ} {U : Set M} {u : M → ℂ} (hu : IsTangentDirectionAlong N 𝔞 μ U u)
    {y : M} (hy : y ∈ N ∩ {y | u y = 0} ∩ U) :
    ∃ k, RegularAtDim (n := n) N y k ∧ RegularAtDim (n := n) (N ∩ {y | u y = 0} ∩ U) y (k - 1) := by
  obtain ⟨⟨hyN, hyu⟩, hyU⟩ := hy
  obtain ⟨k, hk⟩ := hN.2 y hyN
  refine ⟨k, hk, ?_⟩
  obtain ⟨hkn, -, Φ, hΦsrc, -, hflat⟩ := hk
  obtain ⟨e, ξ, hξ, hne⟩ := hu.multiplicity_one y hyU hyu
  have huhol : ∀ z ∈ U, HolomorphicAt n u z := fun z hz =>
    holomorphicAt_of_mem_iterDerivIdealAlong h𝔞 (μ - 1) z u (hu.mem z hz)
  exact TangentDirectionAlong.regularAtDim_inter_zeroSet hΦsrc hflat hkn hu.isOpen huhol hyU hyN hyu hξ hne

/-- `N ∩ V(u)` is closed in the open set `U` when `N` is closed and `u` is holomorphic on `U`. -/
theorem isClosed_preimage_val_inter_zeroSet (hN : IsClosed N) {U : TopologicalSpace.Opens M} {u : M → ℂ}
    (hu : ∀ y ∈ (U : Set M), HolomorphicAt n u y) :
    IsClosed (((↑) : U → M) ⁻¹' (N ∩ {y | u y = 0} ∩ (U : Set M))) := by
  have heq : ((↑) : U → M) ⁻¹' (N ∩ {y | u y = 0} ∩ (U : Set M)) =
      ((↑) : U → M) ⁻¹' N ∩ {y : U | u y = 0} := by
    ext y
    simp
  rw [heq]
  refine (hN.preimage continuous_subtype_val).inter (isClosed_eq ?_ continuous_const)
  refine continuous_iff_continuousAt.mpr fun y => ?_
  exact (hu y y.2).self_of_nhds.continuousAt.comp continuous_subtype_val.continuousAt

end

