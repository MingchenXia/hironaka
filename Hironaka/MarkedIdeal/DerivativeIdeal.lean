/-!
# Derivative ideals

Sources: Włodarczyk 2005 §2.6 (Giraud--Villamayor: `𝓓(𝓘)` is generated by the functions of `𝓘` and their first
derivatives; `𝓓^i(𝓘) = 𝓓(𝓓^{i-1}(𝓘))`), Bierstone--Milman 2008 §3.2 (`𝓓(𝓘)` is the image of `Der_N × 𝓘 → 𝒪_N`; in a
chart it is generated by local generators `f_i` and their partial derivatives).

## Chart-free definition

`derivIdeal 𝔞` is generated, at `x`, by the germs of `𝔞` at `x` and their first partial derivatives
`chartDeriv e v f = (y ↦ D(f ∘ e⁻¹)(e y) v)` in EVERY chart `e` of the atlas around `x` and every direction
`v`.  This is independent of any choice by construction.  That one chart already suffices (so that
`𝓓(𝔞)` is generated near `x` by local generators of `𝔞` and their partial derivatives in a single chart,
hence coherent) is the chain rule, `chartDeriv_eventuallyEq_sum` (derivatives in `e'` are holomorphic
combinations of those in `e`, the coefficients being entries of the Jacobian of the transition map), together
with the product rule `chartDeriv_eventuallyEq_sum_mul`.

## Main declarations

* `chartDeriv e v f`; `holomorphicAt_chartDeriv`;
* `derivIdeal 𝔞` (`𝓓(𝔞)`), `iterDerivIdeal 𝔞 j` (`𝓓^j(𝔞)`)
* calculus of `chartDeriv`: `chartDeriv_congr` (locality), `chartDeriv_eventuallyEq_sum_mul`
  (product rule for finite combinations), `chartDeriv_eventuallyEq_sum` (change of chart);
-/

open Set Filter
open scoped Topology Manifold ContDiff

namespace Hironaka.DerivativeIdeal

open Hironaka.HolomorphicIdealSheaves

noncomputable section

variable {n : ℕ} {M : Type*} [TopologicalSpace M] [ChartedSpace (ComplexModel n) M]
  [IsComplexManifold n M]

/-! ### Holomorphic functions in an arbitrary chart of the atlas -/

section Coordinates

variable (e : ComplexChart n M)

/-- A function holomorphic near `y` is holomorphic near `e y` in the coordinates of any chart `e` of the
atlas containing `y`. -/
theorem eventually_differentiableAt_comp_symm {f : M → ℂ} {y : M} (hy : y ∈ e.val.source)
    (hf : HolomorphicAt n f y) :
    ∀ᶠ z in 𝓝 (e.val y), DifferentiableAt ℂ (f ∘ e.val.symm) z := by
  have hT : Tendsto e.val.symm (𝓝 (e.val y)) (𝓝 y) := by
    have := e.val.continuousAt_symm (e.val.map_source hy)
    rwa [ContinuousAt, e.val.left_inv hy] at this
  filter_upwards [e.val.open_target.mem_nhds (e.val.map_source hy), hT.eventually hf] with z hz hfz
  rw [← mdifferentiableAt_iff_differentiableAt]
  exact hfz.comp z (mdifferentiableAt_atlas_symm (I := 𝓘(ℂ, ComplexModel n)) e.property hz)

/-- A function holomorphic near `e y`, composed with a chart `e` of the atlas, is holomorphic near `y`. -/
theorem holomorphicAt_comp_chart {W : ComplexModel n → ℂ} {y : M} (hy : y ∈ e.val.source)
    (hW : ∀ᶠ z in 𝓝 (e.val y), DifferentiableAt ℂ W z) :
    HolomorphicAt n (fun p => W (e.val p)) y := by
  filter_upwards [e.val.open_source.mem_nhds hy, (e.val.continuousAt hy).eventually hW] with p hp hWp
  have hWm : MDifferentiableAt 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ℂ) W (e.val p) := by
    rw [mdifferentiableAt_iff_differentiableAt]
    exact hWp
  exact hWm.comp p (mdifferentiableAt_atlas (I := 𝓘(ℂ, ComplexModel n)) e.property hp)

/-- A holomorphic germ has a holomorphic germ at every point of a neighbourhood. -/
theorem HolomorphicAt.eventually_holomorphicAt {f : M → ℂ} {y : M} (hf : HolomorphicAt n f y) :
    ∀ᶠ p in 𝓝 y, HolomorphicAt n f p :=
  hf.eventually_nhds

end Coordinates

/-! ### Partial derivatives in a chart -/

/-- **The partial derivative of `f` in the chart `e`, in the direction `v`**:
`y ↦ D(f ∘ e⁻¹)(e y) v` (meaningful on `e.source`). -/
def chartDeriv (e : ComplexChart n M) (v : ComplexModel n) (f : M → ℂ) : M → ℂ :=
  fun p => fderiv ℂ (f ∘ e.val.symm) (e.val p) v

variable {e : ComplexChart n M} {v : ComplexModel n} {f g : M → ℂ} {y : M}

/-- Partial derivatives of holomorphic functions are holomorphic. -/
theorem holomorphicAt_chartDeriv (hy : y ∈ e.val.source) (hf : HolomorphicAt n f y) :
    HolomorphicAt n (chartDeriv e v f) y := by
  obtain ⟨U, hU, hUo, hyU⟩ := eventually_nhds_iff.mp (eventually_differentiableAt_comp_symm e hy hf)
  have hd : DifferentiableOn ℂ (f ∘ e.val.symm) U := fun z hz => (hU z hz).differentiableWithinAt
  have hd' := Hironaka.differentiableOn_fderiv_apply_of_isOpen hd hUo v
  refine holomorphicAt_comp_chart e (W := fun z => fderiv ℂ (f ∘ e.val.symm) z v) hy ?_
  filter_upwards [hUo.mem_nhds hyU] with z hz
  exact (hd' z hz).differentiableAt (hUo.mem_nhds hz)

/-- **Locality**: the partial derivative only depends on the germ. -/
theorem chartDeriv_congr (hy : y ∈ e.val.source) (hfg : f =ᶠ[𝓝 y] g) :
    chartDeriv e v f =ᶠ[𝓝 y] chartDeriv e v g := by
  obtain ⟨U, hU, hUo, hyU⟩ := eventually_nhds_iff.mp hfg
  filter_upwards [hUo.mem_nhds hyU, e.val.open_source.mem_nhds hy] with p hpU hp
  have hloc : f ∘ e.val.symm =ᶠ[𝓝 (e.val p)] g ∘ e.val.symm := by
    have hT : Tendsto e.val.symm (𝓝 (e.val p)) (𝓝 p) := by
      have := e.val.continuousAt_symm (e.val.map_source hp)
      rwa [ContinuousAt, e.val.left_inv hp] at this
    filter_upwards [hT.eventually (hUo.mem_nhds hpU)] with z hz
    exact hU _ hz
  simp only [chartDeriv, hloc.fderiv_eq]

/-- **Product rule** for a finite holomorphic combination: if `f = ∑ aᵢ sᵢ` near `y`, then near `y`
`∂f = ∑ (∂aᵢ) sᵢ + aᵢ (∂sᵢ)`. -/
theorem chartDeriv_eventuallyEq_sum_mul {N : ℕ} {a s : Fin N → M → ℂ} (hy : y ∈ e.val.source)
    (ha : ∀ i, HolomorphicAt n (a i) y) (hs : ∀ i, HolomorphicAt n (s i) y)
    (hf : f =ᶠ[𝓝 y] fun p => ∑ i, a i p * s i p) :
    chartDeriv e v f =ᶠ[𝓝 y] fun p =>
      ∑ i, (chartDeriv e v (a i) p * s i p + a i p * chartDeriv e v (s i) p) := by
  have hall : ∀ᶠ p in 𝓝 y, (∀ i, HolomorphicAt n (a i) p) ∧ ∀ i, HolomorphicAt n (s i) p :=
    (eventually_all.2 fun i => (ha i).eventually_nhds).and
      (eventually_all.2 fun i => (hs i).eventually_nhds)
  filter_upwards [chartDeriv_congr (v := v) hy hf, hall, e.val.open_source.mem_nhds hy] with
    p hp ⟨hap, hsp⟩ hpe
  rw [hp]
  have hda : ∀ i, DifferentiableAt ℂ (a i ∘ e.val.symm) (e.val p) := fun i =>
    (eventually_differentiableAt_comp_symm e hpe (hap i)).self_of_nhds
  have hds : ∀ i, DifferentiableAt ℂ (s i ∘ e.val.symm) (e.val p) := fun i =>
    (eventually_differentiableAt_comp_symm e hpe (hsp i)).self_of_nhds
  have H : HasFDerivAt (fun z => ∑ i ∈ Finset.univ, (a i ∘ e.val.symm) z * (s i ∘ e.val.symm) z)
      (∑ i ∈ Finset.univ, ((a i ∘ e.val.symm) (e.val p) • fderiv ℂ (s i ∘ e.val.symm) (e.val p) +
        (s i ∘ e.val.symm) (e.val p) • fderiv ℂ (a i ∘ e.val.symm) (e.val p))) (e.val p) :=
    HasFDerivAt.fun_sum fun i _ => (hda i).hasFDerivAt.mul (hds i).hasFDerivAt
  have hcomp : (fun q => ∑ i, a i q * s i q) ∘ e.val.symm =
      fun z => ∑ i ∈ Finset.univ, (a i ∘ e.val.symm) z * (s i ∘ e.val.symm) z := rfl
  simp only [chartDeriv]
  rw [hcomp, H.fderiv]
  simp only [FunLike.coe_sum, Finset.sum_apply, add_apply,
    smul_apply, smul_eq_mul, Function.comp_apply, e.val.left_inv hpe]
  refine Finset.sum_congr rfl fun i _ => ?_
  ring

/-! ### Change of chart -/

/-- The transition `e ∘ e'⁻¹` is holomorphic near `e' y` for `y` in both chart domains. -/
theorem eventually_differentiableAt_transition (e e' : ComplexChart n M) (hy : y ∈ e.val.source)
    (hy' : y ∈ e'.val.source) :
    ∀ᶠ z in 𝓝 (e'.val y), DifferentiableAt ℂ (e.val ∘ e'.val.symm) z := by
  have hT : Tendsto e'.val.symm (𝓝 (e'.val y)) (𝓝 y) := by
    have := e'.val.continuousAt_symm (e'.val.map_source hy')
    rwa [ContinuousAt, e'.val.left_inv hy'] at this
  filter_upwards [e'.val.open_target.mem_nhds (e'.val.map_source hy'),
    hT.eventually (e.val.open_source.mem_nhds hy)] with z hz hze
  rw [← mdifferentiableAt_iff_differentiableAt]
  exact (mdifferentiableAt_atlas (I := 𝓘(ℂ, ComplexModel n)) e.property hze).comp z
    (mdifferentiableAt_atlas_symm (I := 𝓘(ℂ, ComplexModel n)) e'.property hz)

/-- A vector of `ℂⁿ` is the combination of the standard basis vectors with its coordinates. -/
theorem sum_smul_single (w : ComplexModel n) :
    ∑ j, w j • EuclideanSpace.single j (1 : ℂ) = w := by
  ext i
  simp [Pi.single_apply]

/-- The coefficient of the change of chart: the `j`-th coordinate of `D(e ∘ e'⁻¹)(e' p) v`. -/
def transitionCoeff (e e' : ComplexChart n M) (v : ComplexModel n) (j : Fin n) : M → ℂ :=
  fun p => fderiv ℂ (e.val ∘ e'.val.symm) (e'.val p) v j

/-- The coefficients of a change of chart are holomorphic. -/
theorem holomorphicAt_transitionCoeff (e e' : ComplexChart n M) (hy : y ∈ e.val.source)
    (hy' : y ∈ e'.val.source) (j : Fin n) : HolomorphicAt n (transitionCoeff e e' v j) y := by
  obtain ⟨U, hU, hUo, hyU⟩ := eventually_nhds_iff.mp (eventually_differentiableAt_transition e e' hy hy')
  have hd : DifferentiableOn ℂ (e.val ∘ e'.val.symm) U := fun z hz => (hU z hz).differentiableWithinAt
  have hd' := Hironaka.differentiableOn_fderiv_apply_of_isOpen hd hUo v
  refine holomorphicAt_comp_chart e' (W := fun z => fderiv ℂ (e.val ∘ e'.val.symm) z v j) hy' ?_
  filter_upwards [hUo.mem_nhds hyU] with z hz
  have hlin : DifferentiableAt ℂ (fun w : ComplexModel n => w j) (fderiv ℂ (e.val ∘ e'.val.symm) z v) :=
    (EuclideanSpace.proj (𝕜 := ℂ) j).differentiableAt
  exact hlin.comp z ((hd' z hz).differentiableAt (hUo.mem_nhds hz))

/-- **Change of chart (chain rule)**: the partial derivative in the chart `e'` is a holomorphic
combination of the partial derivatives in the chart `e` along the standard basis. -/
theorem chartDeriv_eventuallyEq_sum (e e' : ComplexChart n M) (hy : y ∈ e.val.source)
    (hy' : y ∈ e'.val.source) (hf : HolomorphicAt n f y) :
    chartDeriv e' v f =ᶠ[𝓝 y] fun p =>
      ∑ j, transitionCoeff e e' v j p * chartDeriv e (EuclideanSpace.single j 1) f p := by
  filter_upwards [hf.eventually_nhds, e.val.open_source.mem_nhds hy,
    e'.val.open_source.mem_nhds hy'] with p hfp hpe hpe'
  have hT := (eventually_differentiableAt_transition (y := p) e e' hpe hpe').self_of_nhds
  have hF : DifferentiableAt ℂ (f ∘ e.val.symm) ((e.val ∘ e'.val.symm) (e'.val p)) := by
    simp only [Function.comp_apply, e'.val.left_inv hpe']
    exact (eventually_differentiableAt_comp_symm e hpe hfp).self_of_nhds
  have hloc : f ∘ e'.val.symm =ᶠ[𝓝 (e'.val p)] (f ∘ e.val.symm) ∘ (e.val ∘ e'.val.symm) := by
    have hTc : Tendsto e'.val.symm (𝓝 (e'.val p)) (𝓝 p) := by
      have := e'.val.continuousAt_symm (e'.val.map_source hpe')
      rwa [ContinuousAt, e'.val.left_inv hpe'] at this
    filter_upwards [hTc.eventually (e.val.open_source.mem_nhds hpe)] with z hz
    simp only [Function.comp_apply, e.val.left_inv hz]
  simp only [chartDeriv]
  rw [hloc.fderiv_eq, fderiv_comp _ hF hT, ContinuousLinearMap.comp_apply]
  simp only [Function.comp_apply, e'.val.left_inv hpe']
  conv_lhs => rw [← sum_smul_single (fderiv ℂ (e.val ∘ e'.val.symm) (e'.val p) v)]
  rw [map_sum]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [map_smul, smul_eq_mul]
  rfl

/-! ### The derivative ideal -/

/-- The generators of `𝓓(𝔞)` at `x`: the germs of `𝔞` and their partial derivatives in every chart
around `x`. -/
def DerivGen (𝔞 : GermIdeal n M) (x : M) (s : M → ℂ) : Prop :=
  𝔞.mem x s ∨ ∃ (e : ComplexChart n M) (v : ComplexModel n) (f : M → ℂ),
    x ∈ e.val.source ∧ 𝔞.mem x f ∧ s = chartDeriv e v f

/-- **The derivative ideal** `𝓓(𝔞)` (Giraud, Villamayor; Włodarczyk §2.6, BM08 §3.2). -/
def derivIdeal (𝔞 : GermIdeal n M) : GermIdeal n M where
  mem x := IsInSpanAt (n := n) (DerivGen 𝔞 x) x

/-- **The iterated derivative ideals** `𝓓^j(𝔞)`, `𝓓^0(𝔞) = 𝔞`. -/
def iterDerivIdeal (𝔞 : GermIdeal n M) : ℕ → GermIdeal n M
  | 0 => 𝔞
  | j + 1 => derivIdeal (iterDerivIdeal 𝔞 j)

@[simp] theorem iterDerivIdeal_zero (𝔞 : GermIdeal n M) : iterDerivIdeal 𝔞 0 = 𝔞 := rfl

@[simp] theorem iterDerivIdeal_succ (𝔞 : GermIdeal n M) (j : ℕ) :
    iterDerivIdeal 𝔞 (j + 1) = derivIdeal (iterDerivIdeal 𝔞 j) := rfl

variable {𝔞 𝔟 : GermIdeal n M}

/-! ### Generators in one chart, and coherence -/

/-- Span membership only depends on the germ (local copy of `InvertibleIdealQuotient.IsInSpanAt.congr'`). -/
theorem isInSpanAt_congr {S : (M → ℂ) → Prop} {x : M} (hg : IsInSpanAt (n := n) S x f)
    (h : f =ᶠ[𝓝 x] g) : IsInSpanAt (n := n) S x g := by
  obtain ⟨hhol, N, s, a, hs, ha, hsum⟩ := hg
  refine ⟨hhol.congr h, N, s, a, hs, ha, ?_⟩
  filter_upwards [hsum, h] with p hp hp'
  rw [← hp']
  exact hp

/-! ### Derivatives lower the order by at most one; one half of Giraud's lemma -/

section Order

open GermIdealOrder IdealWeightPowers

variable {x : M}

theorem memPow_of_eq {k : ℕ} {t t' : M → ℂ} (h : (idealPow (pointIdeal n x) k).mem x t)
    (heq : t = t') : (idealPow (pointIdeal n x) k).mem x t' :=
  heq ▸ h

/-- `𝔪_x^{k+1}` at `x` is closed under addition. -/
theorem memPow_add {k : ℕ} {t t' : M → ℂ} (h : (idealPow (pointIdeal n x) (k + 1)).mem x t)
    (h' : (idealPow (pointIdeal n x) (k + 1)).mem x t') :
    (idealPow (pointIdeal n x) (k + 1)).mem x (fun p => t p + t' p) :=
  mem_idealPow_succ_iff.mpr (RelativePrincipalizationSpan.IsInSpanAt.add
    (mem_idealPow_succ_iff.mp h) (mem_idealPow_succ_iff.mp h'))

/-- `𝔪_x^{k+1}` at `x` is closed under finite sums. -/
theorem memPow_sum {k K : ℕ} {t : Fin K → M → ℂ}
    (h : ∀ i, (idealPow (pointIdeal n x) (k + 1)).mem x (t i)) :
    (idealPow (pointIdeal n x) (k + 1)).mem x (fun p => ∑ i, t i p) :=
  mem_idealPow_succ_iff.mpr (RelativePrincipalizationSpan.IsInSpanAt.sum Finset.univ
    fun i _ => mem_idealPow_succ_iff.mp (h i))

/-- `𝔪_x^{k+1}` at `x` only depends on the germ. -/
theorem memPow_congr {k : ℕ} {t t' : M → ℂ} (h : (idealPow (pointIdeal n x) (k + 1)).mem x t)
    (heq : t =ᶠ[𝓝 x] t') : (idealPow (pointIdeal n x) (k + 1)).mem x t' :=
  mem_idealPow_succ_iff.mpr (isInSpanAt_congr (mem_idealPow_succ_iff.mp h) heq)

/-- A germ of `𝔪_x` is a germ of `𝔪_x^1`. -/
theorem mem_idealPow_one_of_mem_pointIdeal {b : M → ℂ} (hb : (pointIdeal n x).mem x b) :
    (idealPow (pointIdeal n x) 1).mem x b :=
  mem_idealPow_succ_iff.mpr (isInSpanAt_of_eq_mul (s := (fun _ => (1 : ℂ)) * b)
    (a := fun _ => (1 : ℂ)) ⟨fun _ => (1 : ℂ), b, holomorphicAt_const 1, hb, rfl⟩ hb.1
    (holomorphicAt_const 1) (Eventually.of_forall fun z => by simp))

/-- **Derivatives lower the order by at most one**: a partial derivative (in any chart) of a germ of
`𝔪_x^{q+1}` is a germ of `𝔪_x^q`. -/
theorem chartDeriv_mem_idealPow (hx : x ∈ e.val.source) :
    ∀ (q : ℕ) (g : M → ℂ), (idealPow (pointIdeal n x) (q + 1)).mem x g →
      (idealPow (pointIdeal n x) q).mem x (chartDeriv e v g)
  | 0, g, hg => holomorphicAt_chartDeriv hx (holomorphicAt_of_mem_idealPow hg)
  | q + 1, g, hg => by
    have hpt : ∀ y g, (pointIdeal n x).mem y g → HolomorphicAt n g y := fun _ _ h => h.1
    obtain ⟨-, K, r, c, hr, hc, hsum⟩ := mem_idealPow_succ_iff.mp hg
    choose a b ha hb hab using hr
    have hahol : ∀ k, HolomorphicAt n (a k) x := fun k => holomorphicAt_of_mem_idealPow (ha k)
    have hbhol : ∀ k, HolomorphicAt n (b k) x := fun k => (hb k).1
    have hrhol : ∀ k, HolomorphicAt n (r k) x := fun k => by
      rw [hab k]
      exact (hahol k).mul (hbhol k)
    have hprod := chartDeriv_eventuallyEq_sum_mul (e := e) (v := v) hx hc hrhol hsum
    have hab' : ∀ k, chartDeriv e v (r k) =ᶠ[𝓝 x] fun p =>
        chartDeriv e v (a k) p * b k p + a k p * chartDeriv e v (b k) p := by
      intro k
      have h1 := chartDeriv_eventuallyEq_sum_mul (e := e) (v := v) (f := r k) (N := 1)
        (a := fun _ => a k) (s := fun _ => b k) hx (fun _ => hahol k) (fun _ => hbhol k)
        (by rw [hab k]; exact Eventually.of_forall fun p => by simp)
      simpa using h1
    have hexp : (fun p => ∑ k, (chartDeriv e v (c k) p * r k p +
        (c k p * (chartDeriv e v (a k) p * b k p) + c k p * (a k p * chartDeriv e v (b k) p))))
        =ᶠ[𝓝 x] chartDeriv e v g := by
      filter_upwards [hprod, eventually_all.2 hab'] with p hp hp'
      rw [hp]
      exact Finset.sum_congr rfl fun k _ => by rw [hp' k]; ring
    refine memPow_congr (memPow_sum fun k => memPow_add ?_ (memPow_add ?_ ?_)) hexp
    · -- `∂cₖ · rₖ = (∂cₖ · bₖ) · aₖ`
      exact memPow_of_eq (mul_mem_idealPow ((holomorphicAt_chartDeriv hx (hc k)).mul (hbhol k))
        (ha k)) (by funext p; rw [hab k]; simp only [Pi.mul_apply]; ring)
    · -- `cₖ · (∂aₖ · bₖ)`, with `∂aₖ ∈ 𝔪^q` and `bₖ ∈ 𝔪`
      have h2 := mul_mem_idealPow_add (q := 1) hpt (chartDeriv_mem_idealPow hx q (a k) (ha k))
        (mem_idealPow_one_of_mem_pointIdeal (hb k))
      exact memPow_of_eq (mul_mem_idealPow (hc k) h2) (by funext p; ring)
    · -- `cₖ · (aₖ · ∂bₖ) = (cₖ · ∂bₖ) · aₖ`
      exact memPow_of_eq (mul_mem_idealPow ((hc k).mul (holomorphicAt_chartDeriv hx (hbhol k)))
        (ha k)) (by funext p; ring)

end Order

end

end Hironaka.DerivativeIdeal
