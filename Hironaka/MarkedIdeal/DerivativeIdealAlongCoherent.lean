set_option autoImplicit false
set_option linter.unusedSectionVars false

/-!
# Coherence of the derivative ideal along a submanifold, and its generators in one flat chart

Sources: Bierstone--Milman 2008, §3.2 (`𝓓(𝓘)` is coherent; in a chart it is generated by local generators of `𝓘` and
their partial derivatives), Włodarczyk 2005, §2.6, applied on the submanifold `N` of a marked ideal `(M, N, E, 𝔞,
d)`.

`DerivativeIdealAlong.derivIdealAlong N 𝔞` is generated at `x` by the germs of `𝔞`, those of `𝓘_N`, and the
derivatives of germs of `𝔞` along ALL holomorphic vector fields (in all charts) tangent to `N` at `x`.  This
module shows that one flat chart suffices.  Let `ψ = Φ ∘ e` be flattening coordinates of `N` (the data of
`RegularAtDim`: `N = ψ⁻¹(ℂᵏ × 0)` on `flatDomain Φ`), and write `∂/∂ψ_j` for the coordinate fields of `ψ`
(`flatPartial Φ j`, i.e. `GiraudAlong.flatField Φ (e_j)`).  If `s₁, …, s_r` generate `𝔞` on an open
`U ⊆ flatDomain Φ`, then at every point of `U` (on `N` or not) `𝓓_N(𝔞)` is generated by

* the `sᵢ`,
* the normal coordinates `ψ_j`, `j ≥ k` (generators of `𝓘_N`, Hadamard), and
* the tangential partials `∂sᵢ/∂ψ_j`, `j < k`

(`derivIdealAlong_mem_iff_of_generators`).  Hence `𝓓_N(𝔞)` and all `𝓓_N^j(𝔞)` are coherent for `𝔞` coherent
and `N` a closed submanifold (`isCoherent_derivIdealAlong`, `isCoherent_iterDerivIdealAlong`).

## Proof

That the listed functions lie in `𝓓_N(𝔞)` is the definition (the tangential coordinate fields are tangent to `N`:
`GiraudAlong.isTangentField_flatField`). Conversely, a generator `ξ(f)` (`ξ` tangent to `N` at `y`, written in any
chart `e`, `f = ∑ aₗ sₗ` near `y`) is, by the product rule, `∑ ξ(aₗ) sₗ + aₗ ξ(sₗ)`, and by the chain rule in the
flat coordinates (`fieldDeriv_eventuallyEq_sum_flatPartial`) `ξ(sₗ) = ∑_j ξ(ψ_j) ∂sₗ/∂ψ_j`. For `j < k` the factor
`∂sₗ/∂ψ_j` is a generator; for `j ≥ k`, `ψ_j ∈ 𝓘_N`, so `ξ(ψ_j) ∈ 𝓘_N` by tangency, a combination of the normal
coordinates by Hadamard's lemma (`BlowupFlatCoordinates.exists_eq_sum_flatCoord`). Off `N` (closed), `𝓘_N` and hence
`𝓓_N(𝔞)` is the unit ideal.
-/

open Set Filter
open scoped Topology Manifold ContDiff

namespace Hironaka.DerivativeIdealAlongCoherent

open Hironaka.HolomorphicIdealSheaves Hironaka.BlowupSequences
open Hironaka.DerivativeIdeal Hironaka.DerivativeIdealAlong Hironaka.GiraudAlong Hironaka.BlowupFlatCoordinates Hironaka.RelativePrincipalizationSpan

noncomputable section

variable {n : ℕ} {M : Type*} [TopologicalSpace M] [ChartedSpace (ComplexModel n) M]
  [IsComplexManifold n M]

/-! ### The product rule for derivatives along a vector field -/

/-- **Product rule** along a vector field, for a finite holomorphic combination: if `f = ∑ aᵢ sᵢ` near `y`, then
near `y`, `ξ(f) = ∑ ξ(aᵢ) sᵢ + aᵢ ξ(sᵢ)`. -/
theorem fieldDeriv_eventuallyEq_sum_mul {e : ComplexChart n M} {ξ : Fin n → M → ℂ} {y : M} {f : M → ℂ}
    {K : ℕ} {a s : Fin K → M → ℂ} (hy : y ∈ e.val.source) (ha : ∀ i, HolomorphicAt n (a i) y)
    (hs : ∀ i, HolomorphicAt n (s i) y) (hf : f =ᶠ[𝓝 y] fun p => ∑ i, a i p * s i p) :
    fieldDeriv e ξ f =ᶠ[𝓝 y] fun p =>
      ∑ i, (fieldDeriv e ξ (a i) p * s i p + a i p * fieldDeriv e ξ (s i) p) := by
  filter_upwards [eventually_all.2 fun m =>
    chartDeriv_eventuallyEq_sum_mul (v := EuclideanSpace.single m (1 : ℂ)) hy ha hs hf] with p hp
  simp only [fieldDeriv, hp, Finset.mul_sum, Finset.sum_mul, mul_add, Finset.sum_add_distrib]
  rw [Finset.sum_comm (f := fun m i => ξ m p * (chartDeriv e (EuclideanSpace.single m 1) (a i) p * s i p)),
    Finset.sum_comm (f := fun m i => ξ m p * (a i p * chartDeriv e (EuclideanSpace.single m 1) (s i) p))]
  congr 1 <;> refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun m _ => by ring

/-! ### The chain rule in flat coordinates -/

section Flat

variable {x : M} (Φ : LocalHolomorphicEquivAt (n := n) (chartAt (ComplexModel n) x x))

/-- **The partial derivative `∂/∂ψ_j` in the flat coordinates `ψ = Φ ∘ e`** (`e` the preferred chart at `x`),
as the derivative along the coordinate field `GiraudAlong.flatField Φ (e_j)`. -/
def flatPartial (j : Fin n) (h : M → ℂ) : M → ℂ :=
  fieldDeriv (complexChartAt (n := n) x) (flatField Φ (EuclideanSpace.single j 1)) h

variable {Φ}

/-- The flat partial derivatives of a holomorphic germ are holomorphic (on the flat domain). -/
theorem holomorphicAt_flatPartial (j : Fin n) {h : M → ℂ} {y : M} (hy : y ∈ flatDomain Φ)
    (hh : HolomorphicAt n h y) : HolomorphicAt n (flatPartial Φ j h) y :=
  holomorphicAt_fieldDeriv hy.1 (fun m => holomorphicAt_flatField _ m hy) hh

/-- `flatPartial Φ j h` is the derivative of `h ∘ ψ⁻¹` in the direction `e_j`. -/
theorem flatPartial_eq {h : M → ℂ} {p : M} (hp : p ∈ flatDomain Φ) (hh : HolomorphicAt n h p) (j : Fin n) :
    flatPartial Φ j h p = fderiv ℂ (h ∘ flatInv Φ) (flatMap Φ p) (EuclideanSpace.single j 1) :=
  fieldDeriv_flatField hp hh _

variable (hΦsrc : Φ.source ⊆ (chartAt (ComplexModel n) x).target)

include hΦsrc in
/-- **Chain rule in the flat coordinates, one direction**: at a point `p` of the flat domain and of the source of
an atlas chart `e`, `∂_v^e h = ∑_j (∂_v^e ψ_j) · ∂h/∂ψ_j`. -/
theorem chartDeriv_eq_sum_flat (e : ComplexChart n M) (v : ComplexModel n) {h : M → ℂ} {p : M}
    (hpe : p ∈ e.val.source) (hp : p ∈ flatDomain Φ) (hh : HolomorphicAt n h p) :
    chartDeriv e v h p =
      ∑ j, chartDeriv e v (flatCoord Φ j) p *
        fderiv ℂ (h ∘ flatInv Φ) (flatMap Φ p) (EuclideanSpace.single j 1) := by
  set G : ComplexModel n → ComplexModel n := flatMap Φ ∘ e.val.symm with hG_def
  have hGp : G (e.val p) = flatMap Φ p := by simp only [hG_def, Function.comp_apply, e.val.left_inv hpe]
  -- `G = Φ ∘ (e₀ ∘ e⁻¹)` is holomorphic at `e p`
  have hT := (eventually_differentiableAt_transition (complexChartAt (n := n) x) e hp.1 hpe).self_of_nhds
  have hTp : ((complexChartAt (n := n) x).val ∘ e.val.symm) (e.val p) = chartAt (ComplexModel n) x p := by
    simp only [Function.comp_apply, e.val.left_inv hpe]; rfl
  have hΦd : DifferentiableAt ℂ Φ.toFun (((complexChartAt (n := n) x).val ∘ e.val.symm) (e.val p)) := by
    rw [hTp]; exact Φ.toFun_holomorphic.differentiableAt (Φ.isOpen_source.mem_nhds hp.2)
  have hGd : DifferentiableAt ℂ G (e.val p) := hΦd.comp (e.val p) hT
  -- `h ∘ ψ⁻¹` is holomorphic at `ψ p`
  have hHd : DifferentiableAt ℂ (h ∘ flatInv Φ) (G (e.val p)) := by
    rw [hGp]
    exact differentiableAt_comp_flatInv (flatMap_mem_target hp) hΦsrc (by rw [flatInv_flatMap hp]; exact hh)
  -- near `e p`, `h ∘ e⁻¹ = (h ∘ ψ⁻¹) ∘ G`
  have hloc : h ∘ e.val.symm =ᶠ[𝓝 (e.val p)] (h ∘ flatInv Φ) ∘ G := by
    have hTc : Tendsto e.val.symm (𝓝 (e.val p)) (𝓝 p) := by
      have := e.val.continuousAt_symm (e.val.map_source hpe)
      rwa [ContinuousAt, e.val.left_inv hpe] at this
    filter_upwards [hTc.eventually ((isOpen_flatDomain Φ).mem_nhds hp)] with z hz
    simp only [hG_def, Function.comp_apply, flatInv_flatMap hz]
  have hcoord : ∀ j : Fin n, fderiv ℂ G (e.val p) v j = chartDeriv e v (flatCoord Φ j) p := by
    intro j
    have h1 := ((EuclideanSpace.proj (𝕜 := ℂ) j).hasFDerivAt.comp (e.val p) hGd.hasFDerivAt).fderiv
    have h2 : flatCoord Φ j ∘ e.val.symm = (EuclideanSpace.proj (𝕜 := ℂ) j) ∘ G := rfl
    simp only [chartDeriv, h2, h1]
    rfl
  simp only [chartDeriv]
  rw [hloc.fderiv_eq, fderiv_comp _ hHd hGd, ContinuousLinearMap.comp_apply, hGp]
  conv_lhs => rw [← sum_smul_single (fderiv ℂ G (e.val p) v)]
  rw [map_sum]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [map_smul, smul_eq_mul, hcoord j]
  rfl

include hΦsrc in
/-- **Chain rule in the flat coordinates**: near a point `y` of the flat domain and of the source of an atlas
chart `e`, the derivative of a holomorphic `h` along any field `ξ` written in `e` is
`ξ(h) = ∑_j ξ(ψ_j) · ∂h/∂ψ_j`. -/
theorem fieldDeriv_eventuallyEq_sum_flatPartial (e : ComplexChart n M) (ξ : Fin n → M → ℂ) {h : M → ℂ}
    {y : M} (hye : y ∈ e.val.source) (hy : y ∈ flatDomain Φ) (hh : HolomorphicAt n h y) :
    fieldDeriv e ξ h =ᶠ[𝓝 y] fun p => ∑ j, fieldDeriv e ξ (flatCoord Φ j) p * flatPartial Φ j h p := by
  filter_upwards [e.val.open_source.mem_nhds hye, (isOpen_flatDomain Φ).mem_nhds hy, hh.eventually_nhds]
    with p hpe hp hhp
  simp only [fieldDeriv, Finset.sum_mul]
  simp only [chartDeriv_eq_sum_flat hΦsrc e _ hpe hp hhp, Finset.mul_sum]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun j _ => Finset.sum_congr rfl fun m _ => ?_
  rw [flatPartial_eq hp hhp j]
  ring

/-! ### Generators of `𝓓_N(𝔞)` in one flat chart -/

variable {N : Set M} {k : ℕ}

/-- **The generating family of `𝓓_N(𝔞)` in a flat chart**: generators `sᵢ` of `𝔞`, the normal coordinates `ψ_j`
(`j ≥ k`), and the tangential partials `∂sᵢ/∂ψ_j` (`j < k`); the other slots are `0`. -/
def derivFamilyAlong (Φ : LocalHolomorphicEquivAt (n := n) (chartAt (ComplexModel n) x x)) (k : ℕ) {r : ℕ}
    (s : Fin r → M → ℂ) : Fin r ⊕ Fin n ⊕ (Fin r × Fin n) → M → ℂ
  | .inl i => s i
  | .inr (.inl j) => if k ≤ j.1 then flatCoord Φ j else fun _ => 0
  | .inr (.inr ij) => if ij.2.1 < k then flatPartial Φ ij.2 (s ij.1) else fun _ => 0

variable (hflat : ∀ {y : M}, y ∈ (chartAt (ComplexModel n) x).source → chartAt (ComplexModel n) x y ∈ Φ.source →
    (y ∈ N ↔ Φ.toFun (chartAt (ComplexModel n) x y) ∈ complexCoordinatePlane n k))

include hΦsrc hflat in
/-- The germs of `𝓘_N` at a point of the flat domain are combinations of the normal coordinates (Hadamard). -/
theorem isInSpanAt_of_mem_vanishingIdeal {r : ℕ} (s : Fin r → M → ℂ) {y : M} (hy : y ∈ flatDomain Φ)
    {t : M → ℂ} (ht : (vanishingIdeal (n := n) N).mem y t) :
    IsInSpanAt (n := n) (· ∈ range (derivFamilyAlong Φ k s)) y t := by
  classical
  obtain ⟨b, hb0, hbhol, hbeq⟩ := exists_eq_sum_flatCoord Φ hΦsrc hflat hy ht
  refine ⟨ht.1, n, fun j => derivFamilyAlong Φ k s (.inr (.inl j)), b, fun j => ⟨_, rfl⟩, hbhol, ?_⟩
  filter_upwards [hbeq] with p hp
  rw [hp]
  refine Finset.sum_congr rfl fun j _ => ?_
  by_cases hj : k ≤ j.1
  · simp [derivFamilyAlong, hj]
  · rw [hb0 j (Nat.lt_of_not_le hj)]
    simp

/-- A tangential direction `e_j`, `j < k`, lies in `ℂᵏ × 0`. -/
theorem single_mem_complexCoordinatePlane {j : Fin n} (hj : j.1 < k) :
    EuclideanSpace.single j (1 : ℂ) ∈ complexCoordinatePlane n k := fun i hi => by
  have hij : i ≠ j := fun h => by subst h; omega
  simp [hij]

variable {𝔞 : GermIdeal n M}

include hΦsrc hflat in
/-- **Generators of `𝓓_N(𝔞)` in one flat chart.**  If `s₁, …, s_r`, holomorphic on the open set
`U ⊆ flatDomain Φ`, generate `𝔞` at every point of `U`, then at every point of `U` the ideal `𝓓_N(𝔞)` is generated
by the `sᵢ`, the normal coordinates `ψ_j` (`j ≥ k`) and the tangential partials `∂sᵢ/∂ψ_j` (`j < k`). -/
theorem derivIdealAlong_mem_iff_of_generators {U : Set M} (hUo : IsOpen U) (hUΦ : U ⊆ flatDomain Φ) {r : ℕ}
    {s : Fin r → M → ℂ} (hs : ∀ i, MDifferentiableOn 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ℂ) (s i) U)
    (hgen : ∀ y ∈ U, ∀ g, 𝔞.mem y g ↔ IsInSpanAt (n := n) (· ∈ range s) y g) {y : M} (hy : y ∈ U)
    (g : M → ℂ) :
    (derivIdealAlong N 𝔞).mem y g ↔ IsInSpanAt (n := n) (· ∈ range (derivFamilyAlong Φ k s)) y g := by
  classical
  have hhol : ∀ i, ∀ z ∈ U, HolomorphicAt n (s i) z := fun i z hz =>
    eventually_of_mem (hUo.mem_nhds hz) fun w hw => (hs i w hw).mdifferentiableAt (hUo.mem_nhds hw)
  have hsmem : ∀ i, 𝔞.mem y (s i) := fun i => (hgen y hy (s i)).mpr
    (isInSpanAt_of_eq_mul ⟨i, rfl⟩ (hhol i y hy) (holomorphicAt_const 1)
      (Eventually.of_forall fun _ => (one_mul _).symm))
  have hyΦ : y ∈ flatDomain Φ := hUΦ hy
  have hfam : ∀ c, HolomorphicAt n (derivFamilyAlong Φ k s c) y := by
    rintro (i | j | ij)
    · exact hhol i y hy
    · by_cases hj : k ≤ j.1
      · simpa [derivFamilyAlong, hj] using holomorphicAt_flatCoord Φ j hyΦ
      · simpa [derivFamilyAlong, hj] using holomorphicAt_const (n := n) (x := y) (0 : ℂ)
    · by_cases hj : ij.2.1 < k
      · simpa [derivFamilyAlong, hj] using holomorphicAt_flatPartial ij.2 hyΦ (hhol ij.1 y hy)
      · simpa [derivFamilyAlong, hj] using holomorphicAt_const (n := n) (x := y) (0 : ℂ)
  have hgenFam : ∀ c, IsInSpanAt (n := n) (· ∈ range (derivFamilyAlong Φ k s)) y (derivFamilyAlong Φ k s c) :=
    fun c => isInSpanAt_of_eq_mul ⟨c, rfl⟩ (hfam c) (holomorphicAt_const 1)
      (Eventually.of_forall fun _ => (one_mul _).symm)
  constructor
  · intro hg
    refine IsInSpanAt.trans ?_ hg
    rintro t (ht | ht | ⟨e, ξ, f, hξ, hf, rfl⟩)
    · exact ((hgen y hy t).mp ht).mono fun r ⟨i, hi⟩ => ⟨.inl i, hi⟩
    · exact isInSpanAt_of_mem_vanishingIdeal hΦsrc hflat s hyΦ ht
    · -- `ξ(f)`, `f = ∑ aₗ sₗ`: product rule, then the chain rule in the flat coordinates for each `ξ(sₗ)`
      have hξhol : ∀ m, HolomorphicAt n (ξ m) y := hξ.holomorphicAt
      -- `ξ(sᵢ)` lies in the span
      have hξs : ∀ i, IsInSpanAt (n := n) (· ∈ range (derivFamilyAlong Φ k s)) y (fieldDeriv e ξ (s i)) := by
        intro i
        refine isInSpanAt_congr ?_ (fieldDeriv_eventuallyEq_sum_flatPartial hΦsrc e ξ hξ.mem_source hyΦ
          (hhol i y hy)).symm
        refine IsInSpanAt.sum Finset.univ fun j _ => ?_
        have hψ : HolomorphicAt n (fieldDeriv e ξ (flatCoord Φ j)) y :=
          holomorphicAt_fieldDeriv hξ.mem_source hξhol (holomorphicAt_flatCoord Φ j hyΦ)
        have hF : HolomorphicAt n (flatPartial Φ j (s i)) y := holomorphicAt_flatPartial j hyΦ (hhol i y hy)
        by_cases hj : j.1 < k
        · -- a tangential partial: a generator
          have hmem : flatPartial Φ j (s i) = derivFamilyAlong Φ k s (.inr (.inr (i, j))) := by
            simp [derivFamilyAlong, hj]
          rw [hmem]
          exact IsInSpanAt.mul_left hψ (hgenFam _)
        · -- a normal coordinate: `ξ(ψ_j) ∈ 𝓘_N` by tangency
          have hvan : (vanishingIdeal (n := n) N).mem y (fieldDeriv e ξ (flatCoord Φ j)) :=
            hξ.preserves _ (flatCoord_mem_vanishingIdeal Φ hflat (Nat.le_of_not_lt hj) hyΦ)
          have h1 := IsInSpanAt.mul_left hF (isInSpanAt_of_mem_vanishingIdeal hΦsrc hflat s hyΦ hvan)
          exact isInSpanAt_congr h1 (Eventually.of_forall fun p => mul_comm _ _)
      obtain ⟨-, K, t, a, ht, ha, hsum⟩ := (hgen y hy f).mp hf
      choose σ hσ using ht
      have hthol : ∀ l, HolomorphicAt n (t l) y := fun l => hσ l ▸ hhol (σ l) y hy
      refine isInSpanAt_congr ?_ (fieldDeriv_eventuallyEq_sum_mul hξ.mem_source ha hthol hsum).symm
      refine IsInSpanAt.sum Finset.univ fun l _ => IsInSpanAt.add ?_ ?_
      · rw [← hσ l]
        exact IsInSpanAt.mul_left (holomorphicAt_fieldDeriv hξ.mem_source hξhol (ha l)) (hgenFam (.inl (σ l)))
      · rw [← hσ l]
        exact IsInSpanAt.mul_left (ha l) (hξs (σ l))
  · intro hg
    refine IsInSpanAt.trans ?_ hg
    rintro t ⟨c, rfl⟩
    have hgen1 : ∀ {u : M → ℂ}, DerivGenAlong N 𝔞 y u → HolomorphicAt n u y →
        IsInSpanAt (n := n) (DerivGenAlong N 𝔞 y) y u := fun hu hhu =>
      isInSpanAt_of_eq_mul hu hhu (holomorphicAt_const 1) (Eventually.of_forall fun _ => (one_mul _).symm)
    have hzero : DerivGenAlong N 𝔞 y (fun _ => (0 : ℂ)) :=
      Or.inr (Or.inl ⟨holomorphicAt_const 0, Eventually.of_forall fun _ _ => rfl⟩)
    rcases c with i | j | ij
    · exact hgen1 (Or.inl (hsmem i)) (hfam _)
    · by_cases hj : k ≤ j.1
      · have h := flatCoord_mem_vanishingIdeal Φ hflat hj hyΦ
        simpa [derivFamilyAlong, hj] using hgen1 (Or.inr (Or.inl h)) h.1
      · simpa [derivFamilyAlong, hj] using hgen1 hzero (holomorphicAt_const 0)
    · by_cases hj : ij.2.1 < k
      · have hξ : IsTangentField N (complexChartAt (n := n) x) (flatField Φ (EuclideanSpace.single ij.2 1)) y :=
          isTangentField_flatField hΦsrc hflat (single_mem_complexCoordinatePlane hj) hyΦ
        have h : DerivGenAlong N 𝔞 y (flatPartial Φ ij.2 (s ij.1)) :=
          Or.inr (Or.inr ⟨_, _, s ij.1, hξ, hsmem ij.1, rfl⟩)
        simpa [derivFamilyAlong, hj] using hgen1 h (holomorphicAt_flatPartial ij.2 hyΦ (hhol ij.1 y hy))
      · simpa [derivFamilyAlong, hj] using hgen1 hzero (holomorphicAt_const 0)

end Flat

/-! ### Coherence -/

variable {N : Set M} {𝔞 : GermIdeal n M}

/-- Off a closed set `N`, the derivative ideal along `N` contains every holomorphic germ. -/
theorem derivIdealAlong_mem_of_notMem (hN : IsClosed N) {y : M} (hy : y ∉ N) {g : M → ℂ}
    (hg : HolomorphicAt n g y) : (derivIdealAlong N 𝔞).mem y g := by
  have hvan : (vanishingIdeal (n := n) N).mem y g :=
    ⟨hg, by filter_upwards [hN.isOpen_compl.mem_nhds hy] with p hp hpN using absurd hpN hp⟩
  exact vanishingIdeal_le_derivIdealAlong y g hvan

/-- **`𝓓_N(𝔞)` is coherent** for `𝔞` coherent and `N` a closed submanifold. -/
theorem isCoherent_derivIdealAlong (h𝔞 : 𝔞.IsCoherent) (hN : IsClosedSubmanifold n N) :
    (derivIdealAlong N 𝔞).IsCoherent := by
  classical
  intro x
  by_cases hx : x ∈ N
  · obtain ⟨k, -, -, Φ, hΦsrc, -, hflat⟩ := hN.2 x hx
    obtain ⟨U, hUo, hxU, r, s, hs, hgen⟩ := h𝔞 x
    have hU'o : IsOpen (U ∩ flatDomain Φ) := hUo.inter (isOpen_flatDomain Φ)
    have hhol : ∀ i, ∀ z ∈ U, HolomorphicAt n (s i) z := fun i z hz =>
      eventually_of_mem (hUo.mem_nhds hz) fun w hw => (hs i w hw).mdifferentiableAt (hUo.mem_nhds hw)
    have hfam : ∀ c z, z ∈ U ∩ flatDomain Φ → HolomorphicAt n (derivFamilyAlong Φ k s c) z := by
      rintro (i | j | ij) z hz
      · exact hhol i z hz.1
      · by_cases hj : k ≤ j.1
        · simpa [derivFamilyAlong, hj] using holomorphicAt_flatCoord Φ j hz.2
        · simpa [derivFamilyAlong, hj] using holomorphicAt_const (n := n) (x := z) (0 : ℂ)
      · by_cases hj : ij.2.1 < k
        · simpa [derivFamilyAlong, hj] using holomorphicAt_flatPartial ij.2 hz.2 (hhol ij.1 z hz.1)
        · simpa [derivFamilyAlong, hj] using holomorphicAt_const (n := n) (x := z) (0 : ℂ)
    let eqv := Fintype.equivFin (Fin r ⊕ Fin n ⊕ (Fin r × Fin n))
    refine ⟨U ∩ flatDomain Φ, hU'o, ⟨hxU, mem_flatDomain_self Φ⟩,
      Fintype.card (Fin r ⊕ Fin n ⊕ (Fin r × Fin n)), fun c => derivFamilyAlong Φ k s (eqv.symm c), ?_, ?_⟩
    · intro c z hz
      exact (hfam _ z hz).self_of_nhds.mdifferentiableWithinAt
    · intro z hz g
      have hrange : range (fun c => derivFamilyAlong Φ k s (eqv.symm c)) = range (derivFamilyAlong Φ k s) := by
        ext t
        constructor
        · rintro ⟨c, rfl⟩
          exact ⟨_, rfl⟩
        · rintro ⟨c, rfl⟩
          exact ⟨eqv c, by simp⟩
      rw [hrange]
      exact derivIdealAlong_mem_iff_of_generators hΦsrc hflat hU'o inter_subset_right
        (fun i => (hs i).mono inter_subset_left) (fun w hw => hgen w hw.1) hz g
  · refine ⟨Nᶜ, hN.1.isOpen_compl, hx, 1, fun _ _ => (1 : ℂ), fun _ => mdifferentiableOn_const,
      fun y hy g => ⟨fun hg => ?_, fun hg => derivIdealAlong_mem_of_notMem hN.1 hy hg.1⟩⟩
    exact isInSpanAt_of_eq_mul ⟨0, rfl⟩ hg.1 hg.1 (Eventually.of_forall fun _ => (mul_one _).symm)

/-- **`𝓓_N^j(𝔞)` is coherent** for `𝔞` coherent and `N` a closed submanifold. -/
theorem isCoherent_iterDerivIdealAlong (h𝔞 : 𝔞.IsCoherent) (hN : IsClosedSubmanifold n N) :
    ∀ j, (iterDerivIdealAlong N 𝔞 j).IsCoherent
  | 0 => h𝔞
  | j + 1 => isCoherent_derivIdealAlong (isCoherent_iterDerivIdealAlong h𝔞 hN j) hN

end

end Hironaka.DerivativeIdealAlongCoherent
