set_option autoImplicit false

/-!
# Division by an ideal invertible only along `W`

Step 1 needs the same division **on the strict transform**: `𝔅̄_M 𝒪_{W_m}` is invertible as a sheaf on `W_m` only,
and `𝔣_B := (𝔅 𝒪_{W_1})·𝒪_{W_1}(G_M-pG_m)` is exactly such a quotient.

`IsInvertibleAlong W 𝔩` asks for a single local generator `h` whose zero set contains no
nonempty relatively open subset of `W` — the nonvanishing clause of
`GermIdeal.IsInvertible` tested against `W` instead of against the ambient manifold.  It
is neither stronger nor weaker than `IsInvertible`, and it is what holds for an ideal
that becomes invertible only after restriction.

The quotient is `𝔠 = (𝔣̃: 𝔩)` with `𝔣̃ = restrictOn W 𝔞` the ambient extension of `Res_W 𝔞` — taking the colon of
`𝔞` itself would be wrong, since `𝔞 ⊆ 𝔩` fails: only `Res_W 𝔞 ⊆ Res_W 𝔩` is available. Three facts:

* `restrictLe_mul_colon`, `restrictLe_mul_colon'` — `Res_W 𝔞 = Res_W (𝔩 𝔠)`.  No division
  is performed: the coefficients of the `IsInSpanOnAt` relation, multiplied by the
  cofactors of `h`, already produce the quotient germ.
* `isCoherent_colonAlong` — `𝔠` is COHERENT, which is what the next application of
  relative principalization requires.  Away from the closed set `W` the extension `𝔣̃` is
  the whole structure sheaf, so `𝔠` is generated by `1`; along `W` it is generated by the
  quotients of the generators of `𝔣̃` together with those of `𝓘_W`, and the inclusion that
  needs an argument uses cancellation of `h` along `W`.

`eventuallyEq_within_of_mul_eventuallyEq_within` is the restricted cancellation: it is the
only place the nonvanishing clause is used, and it is why the clause must be tested on
`V ∩ W` rather than on `V`.
-/

open Set Filter
open scoped Topology Manifold ContDiff

namespace Hironaka.RestrictedIdealQuotient

noncomputable section

open Hironaka.HolomorphicIdealSheaves
open Hironaka.RelativePrincipalizationSpan
open Hironaka.InvertibleIdealQuotient
open Hironaka.IdealWeightComparison
open Hironaka.RestrictedIdealWeight
open Hironaka.RestrictedIdealExtension

variable {n : ℕ} {M : Type*} [TopologicalSpace M] [ChartedSpace (ComplexModel n) M]

/-! ### Invertibility along a subset, and cancellation along it -/

variable (n) in
/-- `𝔩` is **invertible along `W`**: near every point of `W` it is generated by a single
holomorphic function whose zero set contains no nonempty relatively open subset of `W`. -/
def IsInvertibleAlong (W : Set M) (𝔩 : GermIdeal n M) : Prop :=
  ∀ x ∈ W, ∃ U : Set M, IsOpen U ∧ x ∈ U ∧ ∃ h : M → ℂ,
    MDifferentiableOn 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ℂ) h U ∧
    (∀ V : Set M, IsOpen V → V ⊆ U → (V ∩ W).Nonempty → ∃ y ∈ V ∩ W, h y ≠ 0) ∧
    ∀ y ∈ U, ∀ g, 𝔩.mem y g ↔ IsInSpanAt (n := n) (· = h) y g

variable {W : Set M}

/-- **Cancellation of the generator along `W`.**  If `h` vanishes identically on no
nonempty relatively open subset of `W`, then `h·F = h·G` on `W` near a point of `U`
forces `F = G` on `W` near that point.  This is the only use of the nonvanishing clause,
and the reason it is tested on `V ∩ W`. -/
theorem eventuallyEq_within_of_mul_eventuallyEq_within {U : Set M} (hU : IsOpen U)
    {h : M → ℂ}
    (hnon : ∀ V : Set M, IsOpen V → V ⊆ U → (V ∩ W).Nonempty → ∃ y ∈ V ∩ W, h y ≠ 0)
    {x : M} (hxU : x ∈ U) {F G : M → ℂ}
    (hF : HolomorphicAt n F x) (hG : HolomorphicAt n G x)
    (heq : ∀ᶠ y in 𝓝 x, y ∈ W → h y * F y = h y * G y) :
    ∀ᶠ y in 𝓝 x, y ∈ W → F y = G y := by
  have hmem : {y | y ∈ U ∧ HolomorphicAt n F y ∧ HolomorphicAt n G y ∧
      (y ∈ W → h y * F y = h y * G y)} ∈ 𝓝 x := by
    filter_upwards [hU.mem_nhds hxU, hF.eventually, hG.eventually, heq] with y h1 h2 h3 h4
    exact ⟨h1, h2, h3, h4⟩
  obtain ⟨V, hVsub, hVopen, hxV⟩ := mem_nhds_iff.mp hmem
  have hall : ∀ y ∈ V, y ∈ W → F y = G y := by
    intro z hzV hzW
    by_contra hz
    have hVopen' : IsOpen {y ∈ V | F y ≠ G y} := by
      rw [isOpen_iff_mem_nhds]
      intro y hy
      have hyV : y ∈ V := hy.1
      have hFy : HolomorphicAt n F y := (hVsub hyV).2.1
      have hGy : HolomorphicAt n G y := (hVsub hyV).2.2.1
      have hne : ∀ᶠ w in 𝓝 y, F w ≠ G w := by
        have hcont : ContinuousAt (fun w => F w - G w) y :=
          hFy.continuousAt.sub hGy.continuousAt
        filter_upwards [hcont.eventually_ne (sub_ne_zero_of_ne hy.2)] with w hw
        exact fun hcontra => hw (by rw [hcontra]; ring)
      filter_upwards [hVopen.mem_nhds hyV, hne] with w h1 h2
      exact ⟨h1, h2⟩
    obtain ⟨y, hyW, hy0⟩ :=
      hnon _ hVopen' (fun y hy => (hVsub hy.1).1) ⟨z, ⟨hzV, hz⟩, hzW⟩
    exact hyW.1.2 (mul_left_cancel₀ hy0 ((hVsub hyW.1.1).2.2.2 hyW.2))
  filter_upwards [hVopen.mem_nhds hxV] with y hy
  exact hall y hy

/-! ### The restricted quotient -/

variable {𝔞 𝔩 : GermIdeal n M}

variable (n W 𝔞 𝔩) in
/-- **The quotient `(Res_W 𝔞 : 𝔩)`**, realised ambiently as the colon of the extension
`𝔣̃ = restrictOn W 𝔞` by `𝔩`.  The colon of `𝔞` itself would be the wrong object: only
`Res_W 𝔞 ⊆ Res_W 𝔩` is available, never `𝔞 ⊆ 𝔩`. -/
def colonAlong : GermIdeal n M := colon (restrictOn n W 𝔞) 𝔩

/-- **The quotient germ, produced rather than divided for.**  If `g` agrees on `W` near
`x` with a combination of germs of `𝔩`, and `𝔩` is generated near `x` by `h`, then the
coefficients of that combination, multiplied by the cofactors of `h`, give a single
holomorphic `c` with `g = h·c` on `W` near `x`.  No cancellation is used here. -/
theorem exists_eventuallyEq_within_mul {U : Set M} (_hU : IsOpen U) {h : M → ℂ} {x : M}
    (hxU : x ∈ U)
    (hgen : ∀ y ∈ U, ∀ g, 𝔩.mem y g ↔ IsInSpanAt (n := n) (· = h) y g)
    {g : M → ℂ} (hg : IsInSpanOnAt (n := n) W (𝔩.mem x) x g) :
    ∃ c : M → ℂ, HolomorphicAt n c x ∧ ∀ᶠ y in 𝓝 x, y ∈ W → g y = h y * c y := by
  obtain ⟨N, s, a, hs, ha, hsum⟩ := hg
  choose e he hee using fun i => (isInSpanAt_eq_iff.mp ((hgen x hxU (s i)).mp (hs i))).2
  refine ⟨fun y => ∑ i, a i y * e i y,
    HolomorphicAt.sum Finset.univ fun i _ => (ha i).mul (he i), ?_⟩
  have hall : ∀ᶠ y in 𝓝 x, ∀ i, s i y = e i y * h y := eventually_all.mpr hee
  filter_upwards [hsum, hall] with y hy hall' hyW
  rw [hy hyW]
  simp only [Finset.mul_sum]
  exact Finset.sum_congr rfl fun i _ => by rw [hall' i]; ring

theorem restrictLe_mul_colon' (h𝔞 : 𝔞.IsCoherent)
    (hW : (vanishingIdeal (n := n) W).IsCoherent) :
    RestrictLe W (𝔩.mul (colonAlong n W 𝔞 𝔩)) 𝔞 := by
  intro x _ g hg
  exact (mul_colon_le (isCoherent_restrictOn h𝔞 hW) x g hg).2

/-- The other half: `Res_W 𝔞 ⊆ Res_W (𝔩 𝔠)`.  The quotient germ is produced, not divided
for: the coefficients `aᵢ` of the restricted span relation `g = ∑ aᵢ sᵢ` on `W`, times the
cofactors `eᵢ` of `h` in `sᵢ = eᵢ h`, give `g = (∑ aᵢ eᵢ) h` on `W`. -/
theorem restrictLe_mul_colon (h𝔞 : 𝔞.IsCoherent) (h𝔩 : IsInvertibleAlong n W 𝔩)
    (hle : RestrictLe W 𝔞 𝔩) :
    RestrictLe W 𝔞 (𝔩.mul (colonAlong n W 𝔞 𝔩)) := by
  intro x hx g hg
  obtain ⟨U, hU, hxU, h, hhdiff, -, hgen⟩ := h𝔩 x hx
  have hhhol : HolomorphicAt n h x := holomorphicAt_of_mdifferentiableOn hU hhdiff hxU
  have hhmem : 𝔩.mem x h := (hgen x hxU h).mpr (isInSpanAt_self rfl hhhol)
  obtain ⟨c, hchol, hcheq⟩ := exists_eventuallyEq_within_mul hU hxU hgen (hle x hx g hg)
  have hghol : HolomorphicAt n g x := GermIdeal.IsCoherent.holomorphicAt_mem h𝔞 hg
  have hgmem : (restrictOn n W 𝔞).mem x g :=
    ⟨hghol, IsInSpanAt.restrict (isInSpanAt_self hg hghol)⟩
  have hcmem : (colonAlong n W 𝔞 𝔩).mem x c := by
    refine ⟨hchol, fun g' hg' => ?_⟩
    obtain ⟨hg'hol, b, hb, hbeq⟩ := isInSpanAt_eq_iff.mp ((hgen x hxU g').mp hg')
    refine restrictOn_congr (𝔞 := 𝔞) (W := W) (restrictOn_mul_left hb hgmem)
      (hg'hol.mul hchol) ?_
    filter_upwards [hbeq, hcheq] with y hy hy' hyW
    show g' y * c y = b y * g y
    rw [hy, hy' hyW]
    ring
  refine ⟨1, fun _ => fun y => h y * c y, fun _ => fun _ => 1, fun _ => ?_,
    fun _ => holomorphicAt_const 1, ?_⟩
  · exact mem_mul_iff.mpr (isInSpanAt_of_eq_mul (s := h * c) ⟨h, c, hhmem, hcmem, rfl⟩
      (hhhol.mul hchol) (holomorphicAt_const 1)
      (Eventually.of_forall fun y => (one_mul _).symm))
  · filter_upwards [hcheq] with y hy hyW
    simpa using hy hyW

/-! ### Coherence of the restricted quotient -/

/-- `𝔠` is closed under holomorphic combinations of its own germs. -/
theorem mem_colonAlong_of_isInSpanAt (h𝔩c : 𝔩.IsCoherent) {y : M} {f : M → ℂ}
    (hf : IsInSpanAt (n := n) ((colonAlong n W 𝔞 𝔩).mem y) y f) :
    (colonAlong n W 𝔞 𝔩).mem y f := by
  obtain ⟨hfhol, K, s, a, hs, ha, hsum⟩ := hf
  refine ⟨hfhol, fun g' hg' => ?_⟩
  have hg'hol : HolomorphicAt n g' y := GermIdeal.IsCoherent.holomorphicAt_mem h𝔩c hg'
  refine restrictOn_of_isInSpanAt (𝔞 := 𝔞) ⟨hg'hol.mul hfhol, K,
    fun k y' => g' y' * s k y', a, fun k => (hs k).2 g' hg', ha, ?_⟩
  filter_upwards [hsum] with y' hy'
  show g' y' * f y' = ∑ k, a k y' * (g' y' * s k y')
  rw [hy', Finset.mul_sum]
  exact Finset.sum_congr rfl fun k _ => by ring

/-- **The restricted quotient is coherent** — what the next application of relative
principalization requires of it.  Off the closed set `W` the extension `𝔣̃` is the whole
structure sheaf, so `𝔠` is generated by `1`.  Along `W` it is generated by the quotients
`c_j` of the generators of `𝔣̃` together with the generators of `𝓘_W`; the inclusion that
needs an argument divides `h·f = ∑ aₖ t_{j(k)} = h·∑ aₖ c_{j(k)}` on `W` and cancels `h`
along `W`, which is where the nonvanishing clause of `IsInvertibleAlong` is used. -/
theorem isCoherent_colonAlong (hWclosed : IsClosed W) (h𝔞 : 𝔞.IsCoherent)
    (hIW : (vanishingIdeal (n := n) W).IsCoherent) (h𝔩c : 𝔩.IsCoherent)
    (h𝔩 : IsInvertibleAlong n W 𝔩) (hle : RestrictLe W 𝔞 𝔩) :
    (colonAlong n W 𝔞 𝔩).IsCoherent := by
  have h𝔟 : (restrictOn n W 𝔞).IsCoherent := isCoherent_restrictOn h𝔞 hIW
  intro x
  by_cases hxW : x ∈ W
  · obtain ⟨U₁, hU₁, hxU₁, h, hhdiff, hnon, hgen⟩ := h𝔩 x hxW
    obtain ⟨U₂, hU₂, hxU₂, N, t, htdiff, htgen⟩ := h𝔟 x
    obtain ⟨U₃, hU₃, hxU₃, P, w, hwdiff, hwgen⟩ := hIW x
    have hmemt : ∀ j, IsInSpanOnAt (n := n) W (𝔩.mem x) x (t j) := fun j =>
      IsInSpanOnAt.trans (fun s hs => hle x hxW s hs)
        (mem_of_isPresentation hU₂ hxU₂ htdiff htgen j).2
    choose c hchol hceq using fun j =>
      exists_eventuallyEq_within_mul hU₁ hxU₁ hgen (hmemt j)
    have hall : ∀ᶠ y in 𝓝 x, (∀ j, y ∈ W → t j y = h y * c j y) ∧
        (∀ j, MDifferentiableAt 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ℂ) (c j) y) :=
      (eventually_all.mpr hceq).and (eventually_all.mpr fun j => hchol j)
    obtain ⟨U₄, hU₄sub, hU₄, hxU₄⟩ := mem_nhds_iff.mp hall
    refine ⟨U₁ ∩ U₂ ∩ U₃ ∩ U₄, ((hU₁.inter hU₂).inter hU₃).inter hU₄,
      ⟨⟨⟨hxU₁, hxU₂⟩, hxU₃⟩, hxU₄⟩, N + P, sumFamily c w, ?_, ?_⟩
    · intro i
      refine Fin.addCases (fun j z hz => ?_) (fun j z hz => ?_) i
      · simpa [sumFamily] using ((hU₄sub hz.2).2 j).mdifferentiableWithinAt
      · simpa [sumFamily] using (hwdiff j z hz.1.2).mono (fun _ h' => h'.1.2)
    · rintro y ⟨⟨⟨hy₁, hy₂⟩, hy₃⟩, hy₄⟩ f
      have hhholy : HolomorphicAt n h y :=
        holomorphicAt_of_mdifferentiableOn hU₁ hhdiff hy₁
      have hhmemy : 𝔩.mem y h := (hgen y hy₁ h).mpr (isInSpanAt_self rfl hhholy)
      have hcholy : ∀ j, HolomorphicAt n (c j) y := by
        intro j
        filter_upwards [hU₄.mem_nhds hy₄] with z hz using (hU₄sub hz).2 j
      have htmemy : ∀ j, (restrictOn n W 𝔞).mem y (t j) := fun j =>
        mem_of_isPresentation hU₂ hy₂ htdiff htgen j
      have hteq : ∀ᶠ z in 𝓝 y, ∀ j, z ∈ W → t j z = h z * c j z := by
        filter_upwards [hU₄.mem_nhds hy₄] with z hz using (hU₄sub hz).1
      -- the two families of generators lie in the quotient
      have hcmem : ∀ j, (colonAlong n W 𝔞 𝔩).mem y (c j) := by
        intro j
        refine ⟨hcholy j, fun g' hg' => ?_⟩
        obtain ⟨hg'hol, b, hb, hbeq⟩ := isInSpanAt_eq_iff.mp ((hgen y hy₁ g').mp hg')
        refine restrictOn_congr (𝔞 := 𝔞) (W := W) (restrictOn_mul_left hb (htmemy j))
          (hg'hol.mul (hcholy j)) ?_
        filter_upwards [hbeq, hteq] with z hz hz' hzW
        show g' z * c j z = b z * t j z
        rw [hz, hz' j hzW]
        ring
      have hwmem : ∀ k, (colonAlong n W 𝔞 𝔩).mem y (w k) := by
        intro k
        have hwk : (vanishingIdeal (n := n) W).mem y (w k) :=
          mem_of_isPresentation hU₃ hy₃ hwdiff hwgen k
        refine ⟨hwk.1, fun g' hg' => ?_⟩
        have hg'hol : HolomorphicAt n g' y :=
          GermIdeal.IsCoherent.holomorphicAt_mem h𝔩c hg'
        refine vanishingIdeal_le_restrictOn (𝔞 := 𝔞) y _ ⟨hg'hol.mul hwk.1, ?_⟩
        filter_upwards [hwk.2] with z hz hzW
        show g' z * w k z = 0
        rw [hz hzW, mul_zero]
      have hgensmem : ∀ s, s ∈ range (sumFamily c w) → (colonAlong n W 𝔞 𝔩).mem y s := by
        intro s hs
        rcases mem_range_sumFamily hs with ⟨j, rfl⟩ | ⟨j, rfl⟩
        · exact hcmem j
        · exact hwmem j
      constructor
      · -- `f` in the quotient: divide and cancel along `W`
        intro hf
        obtain ⟨-, K, s, a, hs, ha, hsum⟩ :=
          (htgen y hy₂ (fun z => h z * f z)).mp (hf.2 h hhmemy)
        choose jj hjj using hs
        set F : M → ℂ := fun z => ∑ k, a k z * c (jj k) z with hFdef
        have hFhol : HolomorphicAt n F y :=
          HolomorphicAt.sum Finset.univ fun k _ => (ha k).mul (hcholy (jj k))
        have hcancel : ∀ᶠ z in 𝓝 y, z ∈ W → h z * f z = h z * F z := by
          filter_upwards [hsum, hteq] with z hz hz' hzW
          rw [hz, hFdef]
          simp only [Finset.mul_sum]
          refine Finset.sum_congr rfl fun k _ => ?_
          rw [← hjj k, hz' (jj k) hzW]
          ring
        have hfF : ∀ᶠ z in 𝓝 y, z ∈ W → f z = F z :=
          eventuallyEq_within_of_mul_eventuallyEq_within hU₁ hnon hy₁ hf.1 hFhol hcancel
        have hFspan : IsInSpanAt (n := n) (· ∈ range (sumFamily c w)) y F :=
          ⟨hFhol, K, fun k => c (jj k), a,
            fun k => range_left_subset_sumFamily ⟨jj k, rfl⟩, ha,
            Eventually.of_forall fun _ => rfl⟩
        have hrest : IsInSpanAt (n := n) (· ∈ range (sumFamily c w)) y
            (fun z => f z - F z) := by
          refine IsInSpanAt.mono (fun _ => range_right_subset_sumFamily)
            ((hwgen y hy₃ (fun z => f z - F z)).mp ⟨?_, ?_⟩)
          · refine HolomorphicAt.congr
              (HolomorphicAt.add hf.1 ((holomorphicAt_const (-1 : ℂ)).mul hFhol)) ?_
            filter_upwards with z
            ring
          · filter_upwards [hfF] with z hz hzW
            rw [hz hzW, sub_self]
        obtain ⟨-, K', s', a', hs', ha', hsum'⟩ := IsInSpanAt.add hrest hFspan
        refine ⟨hf.1, K', s', a', hs', ha', ?_⟩
        filter_upwards [hsum'] with z hz
        simpa using hz
      · intro hf
        exact mem_colonAlong_of_isInSpanAt h𝔩c (IsInSpanAt.mono hgensmem hf)
  · refine ⟨Wᶜ, hWclosed.isOpen_compl, hxW, 1, fun _ _ => (1 : ℂ), ?_, ?_⟩
    · intro i z _
      exact (mdifferentiableAt_const (c := (1 : ℂ))).mdifferentiableWithinAt
    · intro y hy f
      constructor
      · intro hf
        exact isInSpanAt_of_eq_mul (S := fun s => s ∈ range (fun (_ : Fin 1) (_ : M) => (1 : ℂ)))
          ⟨0, rfl⟩ hf.1 hf.1 (Eventually.of_forall fun _ => (mul_one _).symm)
      · intro hf
        refine ⟨hf.holomorphicAt, fun g' hg' => ?_⟩
        have hg'hol : HolomorphicAt n g' y :=
          GermIdeal.IsCoherent.holomorphicAt_mem h𝔩c hg'
        exact restrictOn_eq_top_of_disjoint (𝔞 := 𝔞) hWclosed.isOpen_compl hy
          (by simp) (hg'hol.mul hf.holomorphicAt)

end

end Hironaka.RestrictedIdealQuotient
