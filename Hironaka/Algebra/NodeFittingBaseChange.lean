import Hironaka.Algebra.NodeFittingPolynomial
import Hironaka.Algebra.NodeSingularJacobian
import Mathlib.LinearAlgebra.TensorProduct.RightExactness

/-!
# Actual polynomial coherent differentials pulled to the original formal node

The native module here is the actual scalar extension of the genuine
polynomial-model Kaehler module. Its comparison with the original geometric
coherent module after completion is not an input or a conclusion here.
-/

noncomputable section

namespace Hironaka.Algebra.NodeFitting

open NodeNonsplit NodeSingular NodeFormalMorse
open scoped TensorProduct

set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

universe u
variable {R : Type u} [CommRing R]

/-- The actual original polynomial-to-formal-series coefficient map. -/
def polynomialSeriesMap : MvPolynomial (Fin 2) R →ₐ[R] Series R :=
  MvPolynomial.aeval MvPowerSeries.X

/-- The original equation goes to the same literal original formal equation. -/
@[simp]
theorem polynomialSeriesMap_equation (Q : Quadratic R) (h : R) :
    polynomialSeriesMap (polynomialEquation Q h) = Q.series - MvPowerSeries.C h := by
  simp [polynomialSeriesMap, polynomialEquation, Quadratic.series, Quadratic.value, Quadratic.map,
    MvPowerSeries.algebraMap_apply]

/-- The actual original polynomial hypersurface maps to its original formal hypersurface. -/
def polynomialToFormal (Q : Quadratic R) (h : R) : PolynomialNode Q h →ₐ[R] Node Q h :=
  Ideal.Quotient.liftₐ _
    ((Ideal.Quotient.mkₐ R (equationIdeal Q h)).comp polynomialSeriesMap) (by
      change polynomialIdeal Q h ≤ RingHom.ker
        ((Ideal.Quotient.mkₐ R (equationIdeal Q h)).comp polynomialSeriesMap).toRingHom
      apply Ideal.span_le.mpr
      rintro f rfl
      change Ideal.Quotient.mk (equationIdeal Q h)
        (polynomialSeriesMap (polynomialEquation Q h)) = 0
      rw [polynomialSeriesMap_equation]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton _)))

@[simp]
theorem polynomialToFormal_mk (Q : Quadratic R) (h : R) (f : MvPolynomial (Fin 2) R) :
    polynomialToFormal Q h (Ideal.Quotient.mk (polynomialIdeal Q h) f) =
      Ideal.Quotient.mk (equationIdeal Q h) (polynomialSeriesMap f) := rfl

@[simp]
theorem polynomialToFormal_coordinate (Q : Quadratic R) (h : R) (i : Fin 2) :
    polynomialToFormal Q h (Ideal.Quotient.mk (polynomialIdeal Q h) (MvPolynomial.X i)) =
      coordinate Q h i := by
  rw [polynomialToFormal_mk]
  simp [polynomialSeriesMap, coordinate]

instance polynomialNodeAlgebra (Q : Quadratic R) (h : R) :
    Algebra (PolynomialNode Q h) (Node Q h) := (polynomialToFormal Q h).toAlgebra

instance polynomialNodeScalarTower (Q : Quadratic R) (h : R) :
    IsScalarTower R (PolynomialNode Q h) (Node Q h) := by
  constructor
  intro r a b
  change polynomialToFormal Q h (r • a) * b = r • (polynomialToFormal Q h a * b)
  rw [map_smul, smul_mul_assoc]

/-- The actual polynomial-model coherent module pulled to the original formal node. -/
abbrev FormalModelDifferentials (Q : Quadratic R) (h : R) :=
  Node Q h ⊗[PolynomialNode Q h] KaehlerDifferential R (PolynomialNode Q h)

/-- The actual base-changed original differential map. -/
def formalDifferentialMap (Q : Quadratic R) (h : R) :=
  (polynomialPresentation Q h).toExtension.toKaehler.baseChange (Node Q h)

/-- The actual base-changed original conormal map. -/
def formalConormalMap (Q : Quadratic R) (h : R) :=
  (polynomialPresentation Q h).toExtension.cotangentComplex.baseChange (Node Q h)

/-- Native right exactness retains the whole original differential kernel. -/
theorem formalDifferential_exact (Q : Quadratic R) (h : R) :
    Function.Exact (formalConormalMap Q h) (formalDifferentialMap Q h) :=
  lTensor_exact (Node Q h)
    (polynomialPresentation Q h).toExtension.exact_cotangentComplex_toKaehler
    (toKaehler_surjective Q h)

/-- Every element of the actual pulled differential module is an actual image. -/
theorem formalDifferential_surjective (Q : Quadratic R) (h : R) :
    Function.Surjective (formalDifferentialMap Q h) :=
  LinearMap.lTensor_surjective (Node Q h) (toKaehler_surjective Q h)

/-- The actual original relation vector after scalar extension. -/
def formalGradientVector (Q : Quadratic R) (h : R) :
    Node Q h ⊗[PolynomialNode Q h] (polynomialPresentation Q h).toExtension.CotangentSpace :=
  1 ⊗ₜ gradientVector Q h

/-- The whole actual base-changed conormal image is generated by the original relation vector. -/
theorem formalConormal_range (Q : Quadratic R) (h : R) :
    LinearMap.range (formalConormalMap Q h) =
      Submodule.span (Node Q h) {formalGradientVector Q h} := by
  have he : LinearMap.range (formalConormalMap Q h) =
      (LinearMap.range (polynomialPresentation Q h).toExtension.cotangentComplex).baseChange
        (Node Q h) := by
    apply Submodule.restrictScalars_injective (PolynomialNode Q h)
    exact LinearMap.lTensor_range
      (g := (polynomialPresentation Q h).toExtension.cotangentComplex) (Node Q h)
  rw [he, cotangentComplex_range, Submodule.baseChange_span, Set.image_singleton]
  rfl

/-- The actual pulled differential kernel is precisely the original single relation. -/
theorem formalDifferential_kernel (Q : Quadratic R) (h : R) :
    LinearMap.ker (formalDifferentialMap Q h) =
      Submodule.span (Node Q h) {formalGradientVector Q h} := by
  rw [LinearMap.exact_iff.mp (formalDifferential_exact Q h), formalConormal_range]

/-- The genuine pulled coherent module is the actual original one-relation cokernel. -/
def formalDifferentialQuotientEquiv (Q : Quadratic R) (h : R) :
    ((Node Q h ⊗[PolynomialNode Q h] (polynomialPresentation Q h).toExtension.CotangentSpace) ⧸
      Submodule.span (Node Q h) {formalGradientVector Q h}) ≃ₗ[Node Q h]
        FormalModelDifferentials Q h :=
  (Submodule.quotEquivOfEq _ _ (formalDifferential_kernel Q h).symm).trans
    ((formalDifferentialMap Q h).quotKerEquivOfSurjective (formalDifferential_surjective Q h))

/-- The actual original two-dimensional cotangent basis after scalar extension. -/
def formalCotangentBasis (Q : Quadratic R) (h : R) :=
  (polynomialPresentation Q h).cotangentSpaceBasis.baseChange (Node Q h)

/-- The original relation-column coordinates are transported through the actual coefficient map. -/
theorem formalGradient_coordinate (Q : Quadratic R) (h : R) (i : Fin 2) :
    (formalCotangentBasis Q h).repr (formalGradientVector Q h) i =
      algebraMap (PolynomialNode Q h) (Node Q h)
        ((polynomialPresentation Q h).cotangentSpaceBasis.repr (gradientVector Q h) i) := by
  simp [formalCotangentBasis, formalGradientVector, Module.Basis.baseChange_repr_tmul,
    Algebra.smul_def]

/-- The actual first determinantal ideal of the pulled original one-relation presentation. -/
def formalPresentationFirstFittingIdeal (Q : Quadratic R) (h : R) : Ideal (Node Q h) :=
  Ideal.span {(formalCotangentBasis Q h).repr (formalGradientVector Q h) 0,
    (formalCotangentBasis Q h).repr (formalGradientVector Q h) 1}

/-- The actual first presentation minors commute with this actual scalar extension. -/
theorem formalPresentationFirstFittingIdeal_eq_map (Q : Quadratic R) (h : R) :
    formalPresentationFirstFittingIdeal Q h =
      (presentationFirstFittingIdeal Q h).map (algebraMap (PolynomialNode Q h) (Node Q h)) := by
  unfold formalPresentationFirstFittingIdeal presentationFirstFittingIdeal
  rw [formalGradient_coordinate, formalGradient_coordinate, Ideal.map_span,
    Set.image_insert_eq, Set.image_singleton]

/-- The actual pulled presentation's determinantal ideal is the native original formal Jacobian ideal. -/
theorem formalPresentationFirstFittingIdeal_eq_jacobian (Q : Quadratic R) (h : R) :
    formalPresentationFirstFittingIdeal Q h = jacobianIdeal Q h := by
  rw [formalPresentationFirstFittingIdeal_eq_map, presentationFirstFittingIdeal_eq,
    jacobianIdeal_eq_coordinateIdeal, Ideal.map_span, Set.image_insert_eq, Set.image_singleton]
  change Ideal.span {
    polynomialToFormal Q h (Ideal.Quotient.mk (polynomialIdeal Q h) (MvPolynomial.X 0)),
    polynomialToFormal Q h (Ideal.Quotient.mk (polynomialIdeal Q h) (MvPolynomial.X 1))} = _
  rw [polynomialToFormal_coordinate, polynomialToFormal_coordinate]
  rfl

end Hironaka.Algebra.NodeFitting
