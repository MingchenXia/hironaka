import Hironaka.Algebra.NodeNonsplitPresentationFiber
import Hironaka.Algebra.NodeFlatPresentationFlatKernel
import Mathlib.RingTheory.Nakayama
import Mathlib.RingTheory.MvPowerSeries.Equiv

/-! # The actual principal kernel forced by the original quadratic fibre and original flatness -/

noncomputable section

namespace Hironaka.Algebra.NodeNonsplit

open MvPowerSeries IsLocalRing NodeFormalMorse NodeFlatPresentation

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

universe u v
variable (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
  [IsAdicComplete (maximalIdeal A) A]
  (B : Type v) [CommRing B] [IsLocalRing B] [IsNoetherianRing B]
  [Algebra A B] [IsLocalHom (algebraMap A B)] [Module.Flat A B]
  [IsAdicComplete (maximalIdeal B) B]
  (Q : Quadratic A)

/-- The actual kernel is generated by a literal lift of the original nodal equation. -/
theorem exists_error_kernel
    (e : QuadraticNode (Q.map (Ideal.Quotient.mk (maximalIdeal A))) ≃ₐ[CoefficientResidue A] ClosedFiber A B) :
    ∃ H : MvPowerSeries (Fin 2) A, (∀ d, coeff d H ∈ maximalIdeal A) ∧
      RingHom.ker (presentationMap A B Q e).toRingHom =
        Ideal.span {Q.series - H} := by
  let S := MvPowerSeries (Fin 2) A
  let φ := presentationMap A B Q e
  let M : Ideal S := (maximalIdeal A).map C
  let K : Ideal S := RingHom.ker φ.toRingHom
  let q := MvPowerSeries.map (σ := Fin 2) (Ideal.Quotient.mk (maximalIdeal A))
  let originalQ : S := Q.series
  have hφ : Function.Surjective φ := presentationMap_surjective A B Q e
  have hM : M.map φ.toRingHom = closedFiberIdeal A B := presentationMap_image_coefficientIdeal A B Q e
  have hcomp := presentationMap_closedFiber A B Q e
  have hkernel (f : S) : φ f = 0 → q f ∈ quadraticNodeIdeal (Q.map (Ideal.Quotient.mk (maximalIdeal A))) := by
    intro hf
    apply (closedFiberMap_eq_zero_iff A B Q e f).mp
    rw [← hcomp]
    change Ideal.Quotient.mk _ (φ f) = 0
    rw [hf, map_zero]
  have hQimage : φ originalQ ∈ closedFiberIdeal A B := by
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    change ((Ideal.Quotient.mk (closedFiberIdeal A B)).comp φ.toRingHom) originalQ = 0
    rw [hcomp]
    apply (closedFiberMap_eq_zero_iff A B Q e originalQ).mpr
    change q originalQ ∈ Ideal.span {(Q.map (Ideal.Quotient.mk (maximalIdeal A))).series}
    rw [show q originalQ = (Q.map (Ideal.Quotient.mk (maximalIdeal A))).series from Q.map_series _]
    exact Ideal.subset_span (Set.mem_singleton _)
  rw [← hM] at hQimage
  obtain ⟨H, hHM, hHφ⟩ := (Ideal.mem_map_iff_of_surjective φ.toRingHom hφ).mp hQimage
  change φ H = φ originalQ at hHφ
  let F : S := originalQ - H
  have hFφ : φ F = 0 := by
    change φ (originalQ - H) = 0
    rw [map_sub, hHφ, sub_self]
  have hF : F ∈ K := hFφ
  have hHq : q H = 0 := by
    have hk := ker_coefficientReduction (σ := Fin 2) (maximalIdeal A) (IsNoetherian.noetherian _)
    have hh : H ∈ RingHom.ker q := by rw [hk]; exact hHM
    exact hh
  have hFq : q F = (Q.map (Ideal.Quotient.mk (maximalIdeal A))).series := by
    change q (originalQ - H) = _
    rw [map_sub, hHq, sub_zero]
    exact Q.map_series _
  have hinter : K ⊓ M = M * K := ker_inf_extended φ hφ (maximalIdeal A)
  have hK : K ≤ Ideal.span {F} ⊔ M * K := by
    intro x hx
    have hqx : q x ∈ Ideal.span {(Q.map (Ideal.Quotient.mk (maximalIdeal A))).series} := hkernel x hx
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hqx
    obtain ⟨a, ha⟩ := map_surjective (Ideal.Quotient.mk (maximalIdeal A))
      Ideal.Quotient.mk_surjective c
    have hrK : x - a * F ∈ K := by
      change φ (x - a * F) = 0
      change φ x = 0 at hx
      rw [map_sub, map_mul, hx, hFφ, mul_zero, sub_self]
    have hrM : x - a * F ∈ M := by
      have hz : q (x - a * F) = 0 := by
        rw [map_sub, map_mul, hFq]
        rw [ha, hc, sub_self]
      have hk := ker_coefficientReduction (σ := Fin 2) (maximalIdeal A) (IsNoetherian.noetherian _)
      change x - a * F ∈ (maximalIdeal A).map C
      rw [← hk]
      exact hz
    have hr : x - a * F ∈ M * K := by rw [← hinter]; exact ⟨hrK, hrM⟩
    apply Submodule.mem_sup.mpr
    exact ⟨a * F, (Ideal.span {F}).mul_mem_left a (Ideal.subset_span (Set.mem_singleton _)),
      x - a * F, hr, by ring⟩
  have hMmax : M ≤ maximalIdeal S := by
    intro f hf
    have hc := coeff_mem_of_mem_extended (maximalIdeal A) hf 0
    change constantCoeff f ∈ maximalIdeal A at hc
    intro hu
    exact hc ((MvPowerSeries.isUnit_iff_constantCoeff).mp hu)
  have hkle : K ≤ Ideal.span {F} := by
    apply Submodule.le_of_le_smul_of_le_jacobson_bot (IsNoetherian.noetherian K)
      (hMmax.trans (maximalIdeal_le_jacobson _))
    simpa only [Ideal.smul_eq_mul] using hK
  refine ⟨H, coeff_mem_of_mem_extended (maximalIdeal A) hHM, le_antisymm hkle ?_⟩
  exact Ideal.span_le.mpr (by intro x hx; obtain rfl := Set.mem_singleton_iff.mp hx; exact hF)

end Hironaka.Algebra.NodeNonsplit
