import Hironaka.Algebra.ProjectiveProjectionFiniteRelevance
import Hironaka.Geometry.ProjectiveIdealCoordinateIdeal

/-!
# Original affine coordinates of the actual projective projection

The original homogeneous quotient chart is generated over the original
target homogeneous chart by the actual discarded-coordinate ratio.
-/

noncomputable section

open MvPolynomial AlgebraicGeometry HomogeneousLocalization

namespace Hironaka.Algebra.ProjectiveProjectionFinite

open Geometry.ProjectiveIdeal

universe u

attribute [local instance] MvPolynomial.gradedAlgebra

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

variable (k : Type u) [Field k] (n : ℕ)
  (J : HomogeneousIdeal (ProjectiveGrading k (n + 1))) (j : Fin (n + 1))

private local instance chartBaseAlgebra {m : ℕ} (i : Fin (m + 1)) :
    Algebra k (HomogeneousChartRing k i) := homogeneousChartAlgebra i

/-- The original target affine variable is the same remaining original source coordinate. -/
def chartIndexLift (i : ChartIndex j) : ChartIndex j.succ :=
  ⟨i.val.succ, fun h => i.property (Fin.succ_inj.mp h)⟩

/-- The discarded original coordinate exists on each remaining-coordinate chart. -/
def discardedChartIndex : ChartIndex j.succ := ⟨0, (Fin.succ_ne_zero j).symm⟩

/-- The actual degree-zero homogeneous chart of the original quotient. -/
abbrev QuotientChart := Away (GradedQuotient.grading (ProjectiveGrading k (n + 1)) J.toIdeal)
  (Ideal.Quotient.mk J.toIdeal (X j.succ))

/-- The original affine polynomial coordinates map into the actual quotient chart. -/
def fullChartPolynomialMap : CoordinateRing k j.succ →+* QuotientChart k n J j :=
  (Away.map (GradedQuotient.gradedMk (ProjectiveGrading k (n + 1)) J.toIdeal) (X j.succ)).comp
    (homogeneousChartRatioHom j.succ).toRingHom

/-- The literal map from the target homogeneous chart to the original source quotient chart. -/
def projectionChartMap : HomogeneousChartRing k j →+* QuotientChart k n J j :=
  (fullChartPolynomialMap k n J j).comp
    ((MvPolynomial.rename (chartIndexLift n j)).toRingHom.comp (homogeneousChartDehom j).toRingHom)

/-- The actual discarded-coordinate ratio X0/Xj in the original quotient chart. -/
def discardedRatio : QuotientChart k n J j :=
  fullChartPolynomialMap k n J j (X (discardedChartIndex n j))

/-- The literal chart map retains every actual original affine coordinate. -/
theorem projectionChartMap_ratio (P : CoordinateRing k j) :
    projectionChartMap k n J j (homogeneousChartRatioHom j P) =
      fullChartPolynomialMap k n J j (MvPolynomial.rename (chartIndexLift n j) P) := by
  change fullChartPolynomialMap k n J j
    (MvPolynomial.rename (chartIndexLift n j)
      (homogeneousChartDehom j (homogeneousChartRatioHom j P))) = _
  have h := AlgHom.congr_fun (homogeneousChartDehom_comp_ratioHom (R := k) j) P
  change homogeneousChartDehom j (homogeneousChartRatioHom j P) = P at h
  rw [h]

/-- The full original affine coordinate map surjects onto the entire actual source chart. -/
theorem fullChartPolynomialMap_surjective : Function.Surjective (fullChartPolynomialMap k n J j) := by
  apply (GradedQuotient.awayMap_surjective (ProjectiveGrading k (n + 1)) J
    (MvPolynomial.isHomogeneous_X k j.succ)).comp
  change Function.Surjective (homogeneousChartEquiv (R := k) j.succ).symm
  exact (homogeneousChartEquiv j.succ).symm.surjective

/-- The original homogeneous relation dehomogenizes to an actual zero in the source chart. -/
theorem fullChartPolynomialMap_dehom_eq_zero {F : MvPolynomial (Fin (n + 2)) k} (hF : F ∈ J) :
    fullChartPolynomialMap k n J j (coordinateDehom j.succ F) = 0 := by
  have h := Ideal.mem_map_of_mem (coordinateDehom j.succ).toRingHom hF
  rw [← homogeneousQuotient_coordinateKernel J j.succ] at h
  exact h

/-- Every actual source chart element is generated by its original discarded ratio
and the original remaining coordinate ratios. -/
theorem chart_adjoin_discardedRatio_eq_top :
    letI := (projectionChartMap k n J j).toAlgebra
    Algebra.adjoin (HomogeneousChartRing k j) {discardedRatio k n J j} =
      (⊤ : Subalgebra _ (QuotientChart k n J j)) := by
  let := (projectionChartMap k n J j).toAlgebra
  let S := Algebra.adjoin (HomogeneousChartRing k j) {discardedRatio k n J j}
  apply top_unique
  intro z hz
  clear hz
  obtain ⟨P, rfl⟩ := fullChartPolynomialMap_surjective k n J j z
  have hC (a : k) : fullChartPolynomialMap k n J j (C a) ∈ S := by
    have h := S.algebraMap_mem (homogeneousChartRatioHom j (C a))
    change projectionChartMap k n J j _ ∈ S at h
    simpa only [projectionChartMap_ratio, MvPolynomial.rename_C] using h
  have hX (i : ChartIndex j.succ) : fullChartPolynomialMap k n J j (X i) ∈ S := by
    rcases i with ⟨i, hi⟩
    refine Fin.cases ?_ (fun ℓ => ?_) i hi
    · intro hi0
      exact Algebra.subset_adjoin (Set.mem_singleton _)
    · intro hℓ
      let a : ChartIndex j := ⟨ℓ, fun h => hℓ (congrArg Fin.succ h)⟩
      have h := S.algebraMap_mem (homogeneousChartRatioHom j (X a))
      change projectionChartMap k n J j _ ∈ S at h
      simpa only [projectionChartMap_ratio, MvPolynomial.rename_X, chartIndexLift, a] using h
  induction P using MvPolynomial.induction_on with
  | C a => exact hC a
  | add P Q hP hQ => simpa only [map_add] using S.add_mem hP hQ
  | mul_X P i hP => simpa only [map_mul] using S.mul_mem hP (hX i)

end Hironaka.Algebra.ProjectiveProjectionFinite
