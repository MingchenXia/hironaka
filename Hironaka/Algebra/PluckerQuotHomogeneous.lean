import Hironaka.Algebra.ModuleFlatteningMinors
import Mathlib.RingTheory.MvPolynomial.Homogeneous
import Mathlib.RingTheory.GradedAlgebra.Homogeneous.Ideal

/-!
# The literal homogeneous relations of the original generic maximal minors

The homogeneous relation ideal is generated by actual polynomial identities of
the actual generic matrix. It is constructed over the original coefficient ring,
not assumed as a Grassmannian or Hilbert representability certificate.
-/

noncomputable section

open MvPolynomial

namespace Hironaka.Algebra.PluckerQuot

open ModuleFlatteningMinors

universe u v

attribute [local instance] MvPolynomial.gradedAlgebra

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

variable (R : Type u) [CommRing R] (ι κ : Type u) (σ : Type v) [Fintype ι] [DecidableEq ι]
  (s : σ → ι → κ)

/-- Evaluate every original projective coordinate as its actual generic maximal minor. -/
def genericMinorEval : MvPolynomial σ R →ₐ[R] MvPolynomial (ι × κ) R :=
  MvPolynomial.aeval fun j ↦ columnMinor (Matrix.mvPolynomialX ι κ R) (s j)

/-- The actual homogeneous polynomial identities of the original generic minors. -/
def homogeneousMinorRelations : Set (MvPolynomial σ R) :=
  {F | (∃ d : ℕ, F.IsHomogeneous d) ∧ genericMinorEval R ι κ σ s F = 0}

/-- The actual homogeneous ideal spanned by all original homogeneous minor identities. -/
def minorRelationIdeal : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule σ R) :=
  ⟨Ideal.span (homogeneousMinorRelations R ι κ σ s),
    Ideal.homogeneous_span _ _ (fun _ h ↦ h.1)⟩

/-- Every actual homogeneous minor relation belongs to the original homogeneous ideal. -/
theorem mem_minorRelationIdeal {F : MvPolynomial σ R} (hhom : ∃ d, F.IsHomogeneous d)
    (hzero : genericMinorEval R ι κ σ s F = 0) :
    F ∈ (minorRelationIdeal R ι κ σ s).toIdeal := Ideal.subset_span ⟨hhom, hzero⟩

/-- The whole original ideal vanishes under the actual original minor evaluation. -/
theorem minorRelationIdeal_le_ker :
    (minorRelationIdeal R ι κ σ s).toIdeal ≤ RingHom.ker (genericMinorEval R ι κ σ s).toRingHom := by
  apply Ideal.span_le.mpr
  intro F hF
  exact hF.2

/-- Evaluating the generic matrix at the original entries preserves every selected minor. -/
theorem genericMinorEval_comp_aeval {A : Type u} [CommRing A] [Algebra R A]
    (M : Matrix ι κ A) :
    (MvPolynomial.aeval (R := R) (fun ij : ι × κ ↦ M ij.1 ij.2)).comp
      (genericMinorEval R ι κ σ s) =
      MvPolynomial.aeval (R := R) (fun j ↦ columnMinor M (s j)) := by
  ext j
  simp only [AlgHom.comp_apply, genericMinorEval, MvPolynomial.aeval_X]
  let e := MvPolynomial.aeval (R := R) (fun ij : ι × κ ↦ M ij.1 ij.2)
  have he : e.mapMatrix (selectedMatrix (Matrix.mvPolynomialX ι κ R) (s j)) =
      selectedMatrix M (s j) := by
    ext i k
    simp [e, selectedMatrix, Matrix.mvPolynomialX]
  exact (e.map_det _).trans (congrArg Matrix.det he)

/-- Every relation in the whole actual ideal vanishes on every actual coefficient matrix. -/
theorem minorRelationIdeal_aeval_eq_zero {A : Type u} [CommRing A] [Algebra R A]
    (M : Matrix ι κ A) {F : MvPolynomial σ R}
    (hF : F ∈ (minorRelationIdeal R ι κ σ s).toIdeal) :
    MvPolynomial.aeval (R := R) (fun j ↦ columnMinor M (s j)) F = 0 := by
  rw [← genericMinorEval_comp_aeval R ι κ σ s M]
  change MvPolynomial.aeval _ (genericMinorEval R ι κ σ s F) = 0
  have hz : genericMinorEval R ι κ σ s F = 0 :=
    minorRelationIdeal_le_ker R ι κ σ s hF
  exact (congrArg (MvPolynomial.aeval (R := R) (fun ij : ι × κ ↦ M ij.1 ij.2)) hz).trans
    (map_zero _)

/-- Every original noninjective selector coordinate vanishes in the actual relation quotient. -/
theorem X_mem_minorRelationIdeal_of_not_injective (j : σ)
    (hj : ¬ Function.Injective (s j)) :
    MvPolynomial.X j ∈ (minorRelationIdeal R ι κ σ s).toIdeal := by
  apply mem_minorRelationIdeal R ι κ σ s ⟨1, MvPolynomial.isHomogeneous_X R j⟩
  simp only [genericMinorEval, MvPolynomial.aeval_X]
  obtain ⟨i, k, hik, hne⟩ := Function.not_injective_iff.mp hj
  apply Matrix.det_zero_of_column_eq hne
  intro l
  exact congrArg (Matrix.mvPolynomialX ι κ R l) hik

end Hironaka.Algebra.PluckerQuot
