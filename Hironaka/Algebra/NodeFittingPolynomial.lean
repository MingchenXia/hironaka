import Hironaka.Algebra.NodeSingularGradient
import Mathlib.RingTheory.Extension.Cotangent.Basic

/-!
# Actual polynomial hypersurface differentials

This finite polynomial model has genuine algebraic Kaehler differentials.
Its actual conormal sequence constructs the one-relation differential
presentation internally. Comparison with the original completed coherent
module is separate.
-/

noncomputable section

namespace Hironaka.Algebra.NodeFitting

open NodeNonsplit MvPolynomial _root_.Algebra

set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

universe u
variable {R : Type u} [CommRing R]

def polynomialEquation (Q : Quadratic R) (h : R) : MvPolynomial (Fin 2) R :=
  C Q.a0 * X 0 ^ 2 + C Q.a1 * X 0 * X 1 + C Q.a2 * X 1 ^ 2 - C h

abbrev polynomialIdeal (Q : Quadratic R) (h : R) : Ideal (MvPolynomial (Fin 2) R) :=
  Ideal.span {polynomialEquation Q h}

abbrev PolynomialNode (Q : Quadratic R) (h : R) :=
  MvPolynomial (Fin 2) R ⧸ polynomialIdeal Q h

/-- The actual two-generator one-relation polynomial hypersurface presentation. -/
def polynomialPresentation (Q : Quadratic R) (h : R) :
    Presentation R (PolynomialNode Q h) (Fin 2) Unit where
  toGenerators := Generators.naive
  relation _ := polynomialEquation Q h
  span_range_relation_eq_ker := by
    change Ideal.span (Set.range (fun _ : Unit => polynomialEquation Q h)) =
      RingHom.ker (Ideal.Quotient.mk (polynomialIdeal Q h))
    simp

/-- The original equation's class in the actual conormal module. -/
def relationClass (Q : Quadratic R) (h : R) :
    (polynomialPresentation Q h).toExtension.Cotangent :=
  Extension.Cotangent.mk ⟨polynomialEquation Q h,
    (polynomialPresentation Q h).relation_mem_ker ()⟩

/-- The actual conormal module is generated by the original equation. -/
theorem conormal_span_eq_top (Q : Quadratic R) (h : R) :
    Submodule.span (PolynomialNode Q h) {relationClass Q h} = ⊤ := by
  have ht := Extension.Cotangent.span_eq_top_of_span_eq_ker
    (P := (polynomialPresentation Q h).toExtension)
    (polynomialPresentation Q h).relation
    (polynomialPresentation Q h).span_range_relation_eq_ker
  change Submodule.span (PolynomialNode Q h)
    (Set.range (fun _ : Unit => relationClass Q h)) = ⊤ at ht
  simpa only [Set.range_const] using ht

/-- The actual differential vector of the original relation. -/
def gradientVector (Q : Quadratic R) (h : R) :
    (polynomialPresentation Q h).toExtension.CotangentSpace :=
  (polynomialPresentation Q h).toExtension.cotangentComplex (relationClass Q h)

/-- The whole actual conormal image is exactly the original gradient-vector span. -/
theorem cotangentComplex_range (Q : Quadratic R) (h : R) :
    LinearMap.range (polynomialPresentation Q h).toExtension.cotangentComplex =
      Submodule.span (PolynomialNode Q h) {gradientVector Q h} := by
  rw [← Submodule.map_top, ← conormal_span_eq_top Q h,
    Submodule.map_span, Set.image_singleton]
  rfl

/-- The actual native differential map is surjective. -/
theorem toKaehler_surjective (Q : Quadratic R) (h : R) :
    Function.Surjective (polynomialPresentation Q h).toExtension.toKaehler :=
  (polynomialPresentation Q h).toExtension.toKaehler_surjective

/-- Its entire actual kernel is the one internally computed gradient relation. -/
theorem toKaehler_kernel (Q : Quadratic R) (h : R) :
    LinearMap.ker (polynomialPresentation Q h).toExtension.toKaehler =
      Submodule.span (PolynomialNode Q h) {gradientVector Q h} := by
  rw [LinearMap.exact_iff.mp
    (polynomialPresentation Q h).toExtension.exact_cotangentComplex_toKaehler,
    cotangentComplex_range]

/-- Every actual gradient coordinate is the corresponding native polynomial derivative. -/
theorem gradientVector_coordinate (Q : Quadratic R) (h : R) (i : Fin 2) :
    (polynomialPresentation Q h).cotangentSpaceBasis.repr (gradientVector Q h) i =
      Ideal.Quotient.mk (polynomialIdeal Q h) (MvPolynomial.pderiv i (polynomialEquation Q h)) := by
  rw [gradientVector, relationClass, Extension.cotangentComplex_mk,
    Generators.cotangentSpaceBasis_repr_one_tmul]
  have he : aeval (polynomialPresentation Q h).val = Ideal.Quotient.mkₐ R (polynomialIdeal Q h) := by
    ext i
    rw [aeval_X]
    rfl
  rw [he]
  rfl

/-- The genuine native Kaehler module is the actual one-relation cokernel. -/
def kaehlerQuotientEquiv (Q : Quadratic R) (h : R) :
    ((polynomialPresentation Q h).toExtension.CotangentSpace ⧸
      Submodule.span (PolynomialNode Q h) {gradientVector Q h}) ≃ₗ[PolynomialNode Q h]
        KaehlerDifferential R (PolynomialNode Q h) :=
  (Submodule.quotEquivOfEq _ _ (toKaehler_kernel Q h).symm).trans
    ((polynomialPresentation Q h).toExtension.toKaehler.quotKerEquivOfSurjective
      (toKaehler_surjective Q h))

@[simp]
theorem polynomialNode_mk_C (Q : Quadratic R) (h a : R) :
    Ideal.Quotient.mk (polynomialIdeal Q h) (C a) =
      algebraMap R (PolynomialNode Q h) a := rfl

/-- The first actual relation coordinate is the original first quadratic gradient. -/
theorem gradientVector_zero (Q : Quadratic R) (h : R) :
    (polynomialPresentation Q h).cotangentSpaceBasis.repr (gradientVector Q h) 0 =
      NodeSingular.leftGradient (Q.map (algebraMap R (PolynomialNode Q h)))
        (Ideal.Quotient.mk _ (X 0)) (Ideal.Quotient.mk _ (X 1)) := by
  rw [gradientVector_coordinate]
  simp [polynomialEquation, NodeSingular.leftGradient, Quadratic.map,
    Derivation.leibniz, smul_eq_mul, map_ofNat]
  ring

/-- The second actual relation coordinate is the original second quadratic gradient. -/
theorem gradientVector_one (Q : Quadratic R) (h : R) :
    (polynomialPresentation Q h).cotangentSpaceBasis.repr (gradientVector Q h) 1 =
      NodeSingular.rightGradient (Q.map (algebraMap R (PolynomialNode Q h)))
        (Ideal.Quotient.mk _ (X 0)) (Ideal.Quotient.mk _ (X 1)) := by
  rw [gradientVector_coordinate]
  simp [polynomialEquation, NodeSingular.rightGradient, Quadratic.map,
    Derivation.leibniz, smul_eq_mul, map_ofNat]
  ring

/-- The first determinantal ideal of the internally constructed actual Kaehler presentation.
For its two generators and one relation, the relevant minors are its two entries. -/
def presentationFirstFittingIdeal (Q : Quadratic R) (h : R) : Ideal (PolynomialNode Q h) :=
  Ideal.span {
    (polynomialPresentation Q h).cotangentSpaceBasis.repr (gradientVector Q h) 0,
    (polynomialPresentation Q h).cotangentSpaceBasis.repr (gradientVector Q h) 1}

/-- This actual differential-presentation determinantal ideal is the original coordinate ideal. -/
theorem presentationFirstFittingIdeal_eq (Q : Quadratic R) (h : R) :
    presentationFirstFittingIdeal Q h =
      Ideal.span {Ideal.Quotient.mk (polynomialIdeal Q h) (X 0),
        Ideal.Quotient.mk (polynomialIdeal Q h) (X 1)} := by
  unfold presentationFirstFittingIdeal
  rw [gradientVector_zero, gradientVector_one]
  exact NodeSingular.gradientIdeal_eq_coordinateIdeal _ _ _

end Hironaka.Algebra.NodeFitting
