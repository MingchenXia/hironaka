import Hironaka.Algebra.BlowupChartIdeal
import Mathlib.LinearAlgebra.Matrix.Adjugate
import Mathlib.Algebra.BigOperators.Field

/-!
# Cramer coefficients in the actual maximal-minor blowup charts

All column minors belong to one literal ideal. Updating a selected column
produces another actual selector, so the Cramer coefficients are genuine
members of the original fraction blowup chart. The coordinate identity is
proved using the original ring matrix and actual fraction-field inclusion.
-/

noncomputable section

open scoped BigOperators Matrix

namespace Hironaka.Algebra.ModuleFlatteningMinors

universe u v w

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

variable {R : Type u} [CommRing R]
variable {ι : Type v} {κ : Type w} [Fintype ι] [DecidableEq ι]

/-- The square matrix formed by the original selected columns. -/
def selectedMatrix (A : Matrix ι κ R) (s : ι → κ) : Matrix ι ι R :=
  fun i j ↦ A i (s j)

/-- An original maximal column minor, allowing every actual selector. -/
def columnMinor (A : Matrix ι κ R) (s : ι → κ) : R := (selectedMatrix A s).det

/-- The literal ideal generated by all original maximal column minors. -/
def minorIdeal (A : Matrix ι κ R) : Ideal R := Ideal.span (Set.range (columnMinor A))

/-- Every original column minor belongs to that very same ideal. -/
theorem columnMinor_mem_minorIdeal (A : Matrix ι κ R) (s : ι → κ) :
    columnMinor A s ∈ minorIdeal A := Ideal.subset_span ⟨s, rfl⟩

omit [CommRing R] [Fintype ι] in
/-- Updating a selected column is literally another original column selector. -/
theorem updateCol_selectedMatrix (A : Matrix ι κ R) (s : ι → κ) (a : κ) (j : ι) :
    (selectedMatrix A s).updateCol j (fun i ↦ A i a) =
      selectedMatrix A (Function.update s j a) := by
  ext i k
  by_cases hk : k = j
  · subst k
    simp [selectedMatrix, Matrix.updateCol]
  · simp [selectedMatrix, Matrix.updateCol, hk]

/-- Every original Cramer numerator is an original maximal minor in the literal ideal. -/
theorem cramer_mem_minorIdeal (A : Matrix ι κ R) (s : ι → κ) (a : κ) (j : ι) :
    (selectedMatrix A s).cramer (fun i ↦ A i a) j ∈ minorIdeal A := by
  rw [Matrix.cramer_apply, updateCol_selectedMatrix]
  exact columnMinor_mem_minorIdeal A (Function.update s j a)

variable [IsDomain R]

/-- The actual Cramer coefficient in the native fraction blowup chart. -/
def chartCoefficient (A : Matrix ι κ R) (s : ι → κ) (a : κ) (j : ι) :
    affineBlowupFractionChart (minorIdeal A) (columnMinor A s) :=
  affineBlowupChartRatio (minorIdeal A) (columnMinor A s)
    ((selectedMatrix A s).cramer (fun i ↦ A i a) j) (cramer_mem_minorIdeal A s a j)

/-- Every original column has its actual Cramer expansion by original chart coefficients. -/
theorem column_eq_sum_chartCoefficient
    (A : Matrix ι κ R) (s : ι → κ) (hs : columnMinor A s ≠ 0) (a : κ) (i : ι) :
    algebraMap R (FractionRing R) (A i a) =
      ∑ j, (chartCoefficient A s a j : FractionRing R) *
        algebraMap R (FractionRing R) (A i (s j)) := by
  have hD : algebraMap R (FractionRing R) (columnMinor A s) ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective R (FractionRing R))).mpr hs
  have hrow := congrArg (fun v : ι → R ↦ algebraMap R (FractionRing R) (v i))
    (Matrix.mulVec_cramer (selectedMatrix A s) (fun i ↦ A i a))
  simp only [Matrix.mulVec, dotProduct, selectedMatrix, map_sum, map_mul,
    Pi.smul_apply, smul_eq_mul] at hrow
  symm
  change (∑ j, (algebraMap R (FractionRing R)
      ((selectedMatrix A s).cramer (fun i ↦ A i a) j) /
      algebraMap R (FractionRing R) (columnMinor A s)) *
      algebraMap R (FractionRing R) (A i (s j))) = _
  simp_rw [div_mul_eq_mul_div, mul_comm (algebraMap R (FractionRing R)
    ((selectedMatrix A s).cramer (fun i ↦ A i a) _))]
  rw [← Finset.sum_div, hrow]
  exact mul_div_cancel_left₀ _ hD

end Hironaka.Algebra.ModuleFlatteningMinors
