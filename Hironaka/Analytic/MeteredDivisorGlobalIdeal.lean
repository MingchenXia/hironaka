import Hironaka.Analytic.MeteredDivisorSingleGenerator
import Hironaka.Analytic.MeteredDivisorWeightBounds
import Hironaka.Analytic.HolomorphicBoundedQuotient

set_option autoImplicit false

/-!
# A metered `ℚ`-divisor has analytic singularities along a global invertible ideal

Source: Copy-4, `sec:fixed-data` — `transcendental-nakamaye-copy4-20260911`.

`Pending/MeteredDivisorSingleGenerator` proved the local half of the
metered-divisor bridge: on a compact manifold there is ONE positive natural `q`
such that near every point

  `ψ_E = (1/q) log |G|² + h`,  `G` holomorphic, `h` continuous,

with `G` vanishing identically on no nonempty open subset.  This module assembles
those local presentations into a single **global** invertible ideal sheaf `𝔞`
with `HasAnalyticSingularitiesOfType ψ_E (1/q) 𝔞`, which is the encoding all of
Copy-4 Steps 4–5 uses.

The assembly turns on one classical input, `isInSpanAt_iff_of_sameSingularityTypeAt`:
two holomorphic functions on an open set, neither vanishing identically on any
nonempty open subset, whose weights `log|G|²` and `log|G'|²` agree up to an
additive constant near a point, generate the *same* ideal germ there.  That is
the Riemann extension theorem, and it is **proved** here, from
`Pending/HolomorphicBoundedQuotient.exists_holomorphicAt_eventuallyEq_mul`: the
bound makes `G/G'` bounded and holomorphic off `{G' = 0}`, hence holomorphic, and
symmetrically for `G'/G`, so each generator is a holomorphic multiple of the
other.

Everything else here is proved:

* `le_of_coe_mul_le_coe_mul` — cancelling a positive real factor on `EReal`.
* `sameSingularityTypeAt_of_weight_eq` — two presentations of the SAME weight
  with the same positive coefficient and continuous remainders have generators of
  the same singularity type.  This is what feeds the Riemann-extension step.
* `exists_norm_le_mul_of_moreSingularAt` — `log|f|² ≤ log|g|² + C` near `x` is
  `‖f‖ ≤ e^{C/2}‖g‖` near `x`, the value `⊥` included.
* `exists_hasAnalyticSingularitiesOfType` — the conclusion, with the ideal built
  pointwise as `𝔞_y = (G_y)` from the generator chosen at `y` itself; the
  Riemann-extension step is what makes that independent of the choice, hence
  locally generated by one function.

The whole module is sorry-free.
-/

open Set Filter
open scoped Topology Manifold ContDiff BigOperators

namespace Hironaka.MeteredDivisorGlobalIdeal

noncomputable section

open Hironaka.HolomorphicIdealSheaves Hironaka.GlobalAnalyticSingularities
open Hironaka.MeteredDivisorSingleGenerator
open Hironaka.HolomorphicBoundedQuotient

variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (ComplexModel n) M] [IsComplexManifold n M]

/-! ### Two `EReal` helpers -/

/-- A positive real factor can be cancelled on `EReal`. -/
theorem le_of_coe_mul_le_coe_mul {c : ℝ} (hc : 0 < c) {A B : EReal}
    (h : (c : EReal) * A ≤ (c : EReal) * B) : A ≤ B := by
  have hc0 : (0 : EReal) ≤ ((c⁻¹ : ℝ) : EReal) := EReal.coe_nonneg.mpr (by positivity)
  have h2 : ((c⁻¹ : ℝ) : EReal) * ((c : EReal) * A)
      ≤ ((c⁻¹ : ℝ) : EReal) * ((c : EReal) * B) :=
    mul_le_mul_of_nonneg_left h hc0
  rwa [← mul_assoc, ← mul_assoc, ← EReal.coe_mul, inv_mul_cancel₀ hc.ne',
    EReal.coe_one, one_mul, one_mul] at h2

/-- Cancelling a finite additive term on `EReal`. -/
theorem eq_add_sub_of_add_eq_add {A B : EReal} {a b : ℝ}
    (h : A + (a : EReal) = B + (b : EReal)) : A = B + ((b - a : ℝ) : EReal) := by
  have h0 : A = A + (a : EReal) + ((-a : ℝ) : EReal) := by
    rw [add_assoc, ← EReal.coe_add]
    simp
  rw [h0, h, add_assoc, ← EReal.coe_add, sub_eq_add_neg]

/-! ### From a singularity-type bound to a norm bound -/

omit [IsComplexManifold n M] in
/-- `log|f|² ≤ log|g|² + C` near `x` is `‖f‖ ≤ e^{C/2} ‖g‖` near `x`.  The value
`⊥` is handled by the first case: where `g` vanishes the bound forces `f` to
vanish too. -/
theorem exists_norm_le_mul_of_moreSingularAt {f g : M → ℂ} {x : M}
    (h : MoreSingularAt (singleLog f) (singleLog g) x) :
    ∃ D : ℝ, ∀ᶠ y in 𝓝 x, ‖f y‖ ≤ D * ‖g y‖ := by
  obtain ⟨C, hC⟩ := h
  refine ⟨Real.exp (C / 2), ?_⟩
  filter_upwards [hC] with y hy
  by_cases hfy : f y = 0
  · rw [hfy, norm_zero]
    positivity
  have hgy : g y ≠ 0 := by
    intro hg0
    refine hfy ((singleLog_eq_bot_iff f y).mp ?_)
    have hbot : singleLog g y = ⊥ := (singleLog_eq_bot_iff g y).mpr hg0
    rw [hbot] at hy
    simpa using hy
  have hlogf : singleLog f y = ((Real.log (‖f y‖ ^ 2) : ℝ) : EReal) :=
    MeteredDivisorWeightBounds.generatorLog_single_eq_coe hfy
  have hlogg : singleLog g y = ((Real.log (‖g y‖ ^ 2) : ℝ) : EReal) :=
    MeteredDivisorWeightBounds.generatorLog_single_eq_coe hgy
  rw [hlogf, hlogg, ← EReal.coe_add, EReal.coe_le_coe_iff] at hy
  have hf2 : 0 < ‖f y‖ ^ 2 := by positivity
  have hg2 : 0 < ‖g y‖ ^ 2 := by positivity
  have hexp : ‖f y‖ ^ 2 ≤ ‖g y‖ ^ 2 * Real.exp C := by
    have hmono := Real.exp_le_exp.mpr hy
    rwa [Real.exp_log hf2, Real.exp_add, Real.exp_log hg2] at hmono
  have hE : Real.exp (C / 2) ^ 2 = Real.exp C := by
    rw [sq, ← Real.exp_add]
    ring_nf
  have hsq : ‖f y‖ ^ 2 ≤ (Real.exp (C / 2) * ‖g y‖) ^ 2 := by
    rw [mul_pow, hE]
    linarith [hexp]
  have hnn : 0 ≤ Real.exp (C / 2) * ‖g y‖ := by positivity
  nlinarith [norm_nonneg (f y), hsq, hnn]

/-! ### Riemann extension: two generators of the same singularity type -/

omit [IsComplexManifold n M] in
/-- Holomorphy on an open set gives a holomorphic germ at each of its points. -/
theorem holomorphicAt_of_mdifferentiableOn {G : M → ℂ} {U : Set M} (hU : IsOpen U)
    (hG : MDifferentiableOn 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ℂ) G U) {x : M} (hx : x ∈ U) :
    HolomorphicAt n G x := by
  filter_upwards [hU.mem_nhds hx] with y hy
  exact hG.mdifferentiableAt (hU.mem_nhds hy)

/-- **Two single generators of the same singularity type generate the same ideal
germ.**  `G/G'` is bounded and holomorphic off `{G' = 0}`, hence holomorphic
(`HolomorphicBoundedQuotient.exists_holomorphicAt_eventuallyEq_mul`), and
symmetrically for `G'/G`; so each generator is a holomorphic multiple of the
other, and the two principal germ ideals coincide. -/
theorem isInSpanAt_iff_of_sameSingularityTypeAt {U : Set M} (hU : IsOpen U)
    {G G' : M → ℂ}
    (hG : MDifferentiableOn 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ℂ) G U)
    (hG' : MDifferentiableOn 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ℂ) G' U)
    (hGne : NowhereIdenticallyZeroOn G U) (hG'ne : NowhereIdenticallyZeroOn G' U)
    {x : M} (hx : x ∈ U)
    (hsame : SameSingularityTypeAt (singleLog G) (singleLog G') x)
    (v : M → ℂ) :
    IsInSpanAt (n := n) (· = G) x v ↔ IsInSpanAt (n := n) (· = G') x v := by
  obtain ⟨w, hw, hwe⟩ := exists_holomorphicAt_eventuallyEq_mul hU hx
    (holomorphicAt_of_mdifferentiableOn hU hG hx)
    (holomorphicAt_of_mdifferentiableOn hU hG' hx) hG'ne
    (exists_norm_le_mul_of_moreSingularAt hsame.1)
  obtain ⟨w', hw', hw'e⟩ := exists_holomorphicAt_eventuallyEq_mul hU hx
    (holomorphicAt_of_mdifferentiableOn hU hG' hx)
    (holomorphicAt_of_mdifferentiableOn hU hG hx) hGne
    (exists_norm_le_mul_of_moreSingularAt hsame.2)
  constructor
  · intro hv
    obtain ⟨hvhol, a, ha, heq⟩ := isInSpanAt_eq_iff.mp hv
    refine isInSpanAt_eq_iff.mpr ⟨hvhol, fun y => a y * w y, ha.mul hw, ?_⟩
    filter_upwards [heq, hwe] with y hy hy'
    rw [hy, hy']
    ring
  · intro hv
    obtain ⟨hvhol, a, ha, heq⟩ := isInSpanAt_eq_iff.mp hv
    refine isInSpanAt_eq_iff.mpr ⟨hvhol, fun y => a y * w' y, ha.mul hw', ?_⟩
    filter_upwards [heq, hw'e] with y hy hy'
    rw [hy, hy']
    ring

/-! ### Comparing two presentations of the same weight -/

/-- `NowhereIdenticallyZeroOn` only shrinks. -/
theorem NowhereIdenticallyZeroOn.mono {X : Type*} [TopologicalSpace X] {f : X → ℂ}
    {U V : Set X} (hf : NowhereIdenticallyZeroOn f U) (hVU : V ⊆ U) :
    NowhereIdenticallyZeroOn f V :=
  fun W hWopen hWV hWne => hf W hWopen (hWV.trans hVU) hWne

/-- **Two presentations of the same weight have generators of the same
singularity type.**  The coefficient is one and the same positive real; the two
remainders are merely continuous at the point, which is all the presentations of
a metered `ℚ`-divisor give. -/
theorem sameSingularityTypeAt_of_weight_eq {c : ℝ} (hc : 0 < c)
    {L L' : M → EReal} {h h' : M → ℝ} {z : M} {W : Set M} (hW : W ∈ 𝓝 z)
    (heq : ∀ y ∈ W, (c : EReal) * L y + (h y : EReal)
      = (c : EReal) * L' y + (h' y : EReal))
    (hh : ContinuousAt h z) (hh' : ContinuousAt h' z) :
    SameSingularityTypeAt L L' z := by
  obtain ⟨B, -, hBh⟩ := boundedRealGermAt_of_continuousAt hh
  obtain ⟨B', -, hBh'⟩ := boundedRealGermAt_of_continuousAt hh'
  have key : ∀ {A A' : M → EReal} {r r' : M → ℝ} {b b' : ℝ},
      (∀ y ∈ W, (c : EReal) * A y + (r y : EReal) = (c : EReal) * A' y + (r' y : EReal)) →
      (∀ᶠ y in 𝓝 z, |r y| ≤ b) → (∀ᶠ y in 𝓝 z, |r' y| ≤ b') →
      MoreSingularAt A A' z := by
    intro A A' r r' b b' hAeq hrb hrb'
    refine ⟨(b + b') / c, ?_⟩
    filter_upwards [hW, hrb, hrb'] with y hyW hy hy'
    have hstep : (c : EReal) * A y
        = (c : EReal) * A' y + ((r' y - r y : ℝ) : EReal) :=
      eq_add_sub_of_add_eq_add (hAeq y hyW)
    have hle : ((r' y - r y : ℝ) : EReal) ≤ ((c * ((b + b') / c) : ℝ) : EReal) := by
      refine EReal.coe_le_coe_iff.mpr ?_
      have hcb : c * ((b + b') / c) = b + b' := by field_simp
      have h1 : r' y ≤ b' := (abs_le.mp hy').2
      have h2 : -b ≤ r y := (abs_le.mp hy).1
      rw [hcb]
      linarith
    have hmul : (c : EReal) * A y ≤ (c : EReal) * (A' y + (((b + b') / c : ℝ) : EReal)) := by
      rw [EReal.left_distrib_of_nonneg_of_ne_top (EReal.coe_nonneg.mpr hc.le)
        (EReal.coe_ne_top c), ← EReal.coe_mul, hstep]
      gcongr
    exact le_of_coe_mul_le_coe_mul hc hmul
  exact ⟨key heq hBh hBh', key (fun y hy => (heq y hy).symm) hBh' hBh⟩

/-! ### The global ideal -/

omit [IsComplexManifold n M] in
/-- Membership in a principal germ ideal only depends on the generating
predicate. -/
theorem isInSpanAt_congr_pred {S S' : (M → ℂ) → Prop} (hSS' : ∀ w, S w ↔ S' w)
    (x : M) (v : M → ℂ) :
    IsInSpanAt (n := n) S x v ↔ IsInSpanAt (n := n) S' x v := by
  constructor <;> rintro ⟨hv, N, s, a, hs, ha, hsum⟩
  · exact ⟨hv, N, s, a, fun i => (hSS' _).mp (hs i), ha, hsum⟩
  · exact ⟨hv, N, s, a, fun i => (hSS' _).mpr (hs i), ha, hsum⟩

/-- **The assembly, from any uniform local single-generator presentation.**  The
ideal is built pointwise as `𝔞_y = (G_y)` from the generator chosen at `y`
itself; `isInSpanAt_iff_of_sameSingularityTypeAt` is what makes that choice
irrelevant, hence the ideal locally principal, coherent, and independent of the
point. -/
theorem exists_invertible_hasAnalyticSingularitiesOfType_of_presentation [CompactSpace M]
    (E : MeteredEffectiveQDivisor n M) {q : ℕ} (hqpos : 0 < q)
    (hdata : IsUniformSingleGeneratorPresentation E q) :
    ∃ 𝔞 : GermIdeal n M, 𝔞.IsInvertible ∧
      HasAnalyticSingularitiesOfType E.weight (1 / (q : ℚ)) 𝔞 := by
  classical
  choose U hUopen hxU G hsm hGdiff hGne hhsmooth hweight using hdata
  set c : ℝ := 1 / (q : ℝ) with hc
  have hcpos : 0 < c := by
    rw [hc]
    have : (0 : ℝ) < (q : ℝ) := by exact_mod_cast hqpos
    positivity
  have hcQ : (0 : ℚ) < 1 / (q : ℚ) := by
    have : (0 : ℚ) < (q : ℚ) := by exact_mod_cast hqpos
    positivity
  have hcoe : ((1 / (q : ℚ) : ℚ) : ℝ) = c := by
    rw [hc]
    push_cast
    ring
  have hcont : ∀ x : M, ∀ z ∈ U x, ContinuousAt (hsm x) z := fun x z hz =>
    MeteredDivisorWeightBounds.continuousAt_of_chartContDiffOn (hUopen x) (hhsmooth x) hz
  -- the germ ideal at a point does not depend on which local generator presents it
  have hagree : ∀ (x z : M), z ∈ U x → ∀ v : M → ℂ,
      IsInSpanAt (n := n) (· = G z) z v ↔ IsInSpanAt (n := n) (· = G x) z v := by
    intro x z hz v
    have hopen : IsOpen (U z ∩ U x) := (hUopen z).inter (hUopen x)
    have hmem : z ∈ U z ∩ U x := ⟨hxU z, hz⟩
    refine isInSpanAt_iff_of_sameSingularityTypeAt hopen
      ((hGdiff z).mono inter_subset_left) ((hGdiff x).mono inter_subset_right)
      (NowhereIdenticallyZeroOn.mono (hGne z) inter_subset_left)
      (NowhereIdenticallyZeroOn.mono (hGne x) inter_subset_right) hmem ?_ v
    refine sameSingularityTypeAt_of_weight_eq hcpos (hopen.mem_nhds hmem) ?_
      (hcont z z (hxU z)) (hcont x z hz)
    intro y hy
    rw [← hweight z y hy.1, ← hweight x y hy.2]
  -- the single generator of the ideal is also a one-element generating family
  have hrange : ∀ (x : M) (w : M → ℂ),
      w = G x ↔ w ∈ range (fun _ : Fin 1 => G x) := by
    intro x w
    simp
  refine ⟨⟨fun y v => IsInSpanAt (n := n) (· = G y) y v⟩, ?_, hcQ, ?_, ?_⟩
  · intro x
    exact ⟨U x, hUopen x, hxU x, G x, hGdiff x, hGne x, fun y hy v => hagree x y hy v⟩
  · -- coherence: locally one generator
    intro x
    refine ⟨U x, hUopen x, hxU x, 1, fun _ => G x, fun _ => hGdiff x, ?_⟩
    intro y hy v
    exact (hagree x y hy v).trans (isInSpanAt_congr_pred (hrange x) y v)
  · -- the local presentation, with a bounded remainder
    intro x
    obtain ⟨C, -, hCev⟩ := boundedRealGermAt_of_continuousAt (hcont x x (hxU x))
    obtain ⟨V, hVsub, hVopen, hxV⟩ := mem_nhds_iff.mp hCev
    refine ⟨U x ∩ V, (hUopen x).inter hVopen, ⟨hxU x, hxV⟩, 1, fun _ => G x,
      fun _ => (hGdiff x).mono inter_subset_left, ?_, hsm x, C, ?_, ?_⟩
    · intro y hy v
      exact (hagree x y hy.1 v).trans (isInSpanAt_congr_pred (hrange x) y v)
    · intro y hy
      exact hVsub hy.2
    · intro y hy
      rw [hweight x y hy.1, hcoe]
      rfl

/-- **A metered effective `ℚ`-divisor on a compact manifold has analytic
singularities of type `(1/q, 𝔞)` for a global invertible ideal `𝔞`.**  This is
the bridge between `MeteredEffectiveQDivisor.weight` and
`HasAnalyticSingularitiesOfType`; both encodings are then available for the same
object, which is what Copy-4 Steps 4–5 need. -/
theorem exists_hasAnalyticSingularitiesOfType [CompactSpace M]
    (E : MeteredEffectiveQDivisor n M) :
    ∃ (c : ℚ) (𝔞 : GermIdeal n M), 0 < c ∧ 𝔞.IsInvertible ∧
      HasAnalyticSingularitiesOfType E.weight c 𝔞 := by
  obtain ⟨q, hqpos, hdata⟩ := exists_uniformDenominator E
  obtain ⟨𝔞, hinv, hpres⟩ :=
    exists_invertible_hasAnalyticSingularitiesOfType_of_presentation E hqpos hdata
  exact ⟨1 / (q : ℚ), 𝔞, hpres.1, hinv, hpres⟩

/-- **Two metered divisors can be presented with one and the same coefficient.**
Every combinator of the `O(1)` calculus — `hasAnalyticSingularitiesOfType_mul`,
`..._pow`, `sameSingularityTypeOn_univ_of_eq_type`, `eq:IV-H` — requires the two
weights to carry the same rational `c`.  The denominators produced by
`exists_uniformDenominator` are unrelated, but each may be enlarged to their
product. -/
theorem exists_common_hasAnalyticSingularitiesOfType [CompactSpace M]
    (E E' : MeteredEffectiveQDivisor n M) :
    ∃ (c : ℚ) (𝔞 𝔞' : GermIdeal n M), 0 < c ∧ 𝔞.IsInvertible ∧ 𝔞'.IsInvertible ∧
      HasAnalyticSingularitiesOfType E.weight c 𝔞 ∧
      HasAnalyticSingularitiesOfType E'.weight c 𝔞' := by
  obtain ⟨q, hq, hd⟩ := exists_uniformDenominator_multiple E
  obtain ⟨q', hq', hd'⟩ := exists_uniformDenominator_multiple E'
  obtain ⟨𝔞, hinv, hpres⟩ :=
    exists_invertible_hasAnalyticSingularitiesOfType_of_presentation E
      (Nat.mul_pos hq' hq) (hd q' hq')
  obtain ⟨𝔞', hinv', hpres'⟩ :=
    exists_invertible_hasAnalyticSingularitiesOfType_of_presentation E'
      (Nat.mul_pos hq hq') (hd' q hq)
  refine ⟨1 / ((q' * q : ℕ) : ℚ), 𝔞, 𝔞', hpres.1, hinv, hinv', hpres, ?_⟩
  rw [Nat.mul_comm q' q]
  exact hpres'

end

end Hironaka.MeteredDivisorGlobalIdeal
