import Hironaka.Coherence.OkaRelationSheaf

/-!
# Analytic subsheaves of `𝒪^ι` recorded by germs

This file starts lane SERRE-CORE (Serre's GAGA on `ℙᴺ`, towards source `lma:GAGA`,
`chapter_NApotential.tex` lines 1143--1145). Serre's induction on hyperplane sections leaves
the class of ideal sheaves, so the core works with coherent analytic *modules*. Here they are
recorded, as the ideals of `Hironaka` (`GermIdeal`, `OkaIdealOperations`), by
membership of germs.

Let `X` be a complex normed space and `ι` a finite type. A *germ module* `M` on `X` with
values in `𝒪^ι` is a predicate `M.mem y a` on points `y` and tuples `a : ι → X → ℂ`: it says
that the germ of `a` at `y` lies in the stalk `M_y ⊆ 𝒪_y^ι`. Nothing is required of `M` by the
definition itself; coherence carries the content.

* `GermModule.GeneratedOn M U σ`: finitely many tuples `σ_k`, holomorphic on `U`, generate the
  stalk `M_y` at EVERY point `y ∈ U`: `a ∈ M_y` iff `a = ∑ c_k σ_k` near `y` with `c_k`
  holomorphic at `y` (TN's `IsCombinationAt`).
* `GermModule.CoherentAt M x₀`: `M` is generated by finitely many sections on some open
  neighbourhood of `x₀`; `IsCoherentOn M Ω` at every point of `Ω`. For subsheaves of `𝒪^ι`
  this is coherence (by Oka's theorem, `CoreOkaModules`, finite type implies coherent).

At a point of coherence the stalk is an `𝒪_y`-submodule depending only on germs
(`CoherentAt.zero_mem`, `add_mem`, `smul_mem`, `congr_mem`, `holTupleAt_of_mem`). The
constructions not needing Oka's theorem are here: the zero module `bot`, the free module `top`,
the module `span σ` generated by finitely many tuples, the sum `sup`, and the image
`map A M` under a holomorphic matrix `A`. Coherence is invariant under biholomorphic
homeomorphisms (`CoherentAt.comapHomeomorph`).
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open Filter Topology Set
open Hironaka.OkaRelationSheaf

namespace Hironaka.Analytic.GAGA.Core

variable {X : Type*} [NormedAddCommGroup X] [NormedSpace ℂ X]

/-! ### Holomorphic tuples and combinations -/

section Tuples

variable {ι κ μ ν : Type} [Fintype ι] [Fintype κ] [Fintype μ] [Fintype ν]

/-- A tuple of functions is holomorphic on a neighbourhood of `y`. -/
def HolTupleAt (a : ι → X → ℂ) (y : X) : Prop :=
  ∀ j, HolAt (a j) y

/-- Finitely many functions holomorphic at `x₀` are holomorphic on a common open
neighbourhood of `x₀`. -/
theorem exists_isOpen_differentiableOn {α : Type} [Finite α] {f : α → X → ℂ} {x₀ : X}
    (hf : ∀ i, HolAt (f i) x₀) :
    ∃ V : Set X, IsOpen V ∧ x₀ ∈ V ∧ ∀ i, DifferentiableOn ℂ (f i) V := by
  have h : ∀ᶠ x in 𝓝 x₀, ∀ i, DifferentiableAt ℂ (f i) x := eventually_all.2 hf
  obtain ⟨V, hVf, hV, hx₀V⟩ := eventually_nhds_iff.1 h
  exact ⟨V, hV, hx₀V, fun i x hx => (hVf x hx i).differentiableWithinAt⟩

/-- The action of a matrix of functions on a tuple: `(A a)_i = ∑_j A_{ij} a_j`. -/
def matApply (A : κ → ι → X → ℂ) (a : ι → X → ℂ) : κ → X → ℂ :=
  fun i x => ∑ j, A i j x * a j x

theorem matApply_apply (A : κ → ι → X → ℂ) (a : ι → X → ℂ) (i : κ) (x : X) :
    matApply A a i x = ∑ j, A i j x * a j x := rfl

/-- The matrix of a family of tuples: column `k` is `σ k`. -/
def colMatrix (σ : μ → ι → X → ℂ) : ι → μ → X → ℂ :=
  fun j k => σ k j

theorem matApply_colMatrix (σ : μ → ι → X → ℂ) (c : μ → X → ℂ) (j : ι) (x : X) :
    matApply (colMatrix σ) c j x = ∑ k, c k x * σ k j x := by
  simp only [matApply, colMatrix]
  exact Finset.sum_congr rfl fun k _ => mul_comm _ _

theorem HolTupleAt.matApply {A : κ → ι → X → ℂ} {a : ι → X → ℂ} {y : X}
    (hA : ∀ i j, HolAt (A i j) y) (ha : HolTupleAt a y) :
    HolTupleAt (Core.matApply A a) y :=
  fun i => HolAt.fintype_sum fun j => (hA i j).mul (ha j)

theorem matApply_matApply (B : κ → ι → X → ℂ) (A : ι → μ → X → ℂ) (a : μ → X → ℂ) :
    matApply B (matApply A a) = matApply (fun i k x => ∑ j, B i j x * A j k x) a := by
  funext i x
  simp only [matApply, Finset.mul_sum, Finset.sum_mul]
  rw [Finset.sum_comm]
  exact Finset.sum_congr rfl fun k _ => Finset.sum_congr rfl fun j _ => by ring

theorem holTupleAt_zero (y : X) : HolTupleAt (fun (_ : ι) (_ : X) => (0 : ℂ)) y :=
  fun _ => holAt_const 0 y

/-- The zero combination. -/
theorem isCombinationAt_zero (σ : μ → ι → X → ℂ) (y : X) :
    IsCombinationAt σ y (fun _ _ => 0) :=
  ⟨fun _ _ => 0, fun _ => holAt_const 0 y, fun _ => Eventually.of_forall fun x => by simp⟩

theorem IsCombinationAt.congr {σ : μ → ι → X → ℂ} {y : X} {a b : ι → X → ℂ}
    (ha : IsCombinationAt σ y a) (hab : ∀ j, a j =ᶠ[𝓝 y] b j) : IsCombinationAt σ y b := by
  obtain ⟨c, hc, h⟩ := ha
  exact ⟨c, hc, fun j => (hab j).symm.trans (h j)⟩

theorem IsCombinationAt.add {σ : μ → ι → X → ℂ} {y : X} {a b : ι → X → ℂ}
    (ha : IsCombinationAt σ y a) (hb : IsCombinationAt σ y b) :
    IsCombinationAt σ y (fun j x => a j x + b j x) := by
  obtain ⟨c, hc, hca⟩ := ha
  obtain ⟨d, hd, hdb⟩ := hb
  refine ⟨fun k x => c k x + d k x, fun k => (hc k).add (hd k), fun j => ?_⟩
  filter_upwards [hca j, hdb j] with x h1 h2
  rw [h1, h2, ← Finset.sum_add_distrib]
  exact Finset.sum_congr rfl fun k _ => by ring

theorem IsCombinationAt.smul {σ : μ → ι → X → ℂ} {y : X} {a : ι → X → ℂ} {f : X → ℂ}
    (hf : HolAt f y) (ha : IsCombinationAt σ y a) :
    IsCombinationAt σ y (fun j x => f x * a j x) := by
  obtain ⟨c, hc, hca⟩ := ha
  refine ⟨fun k x => f x * c k x, fun k => hf.mul (hc k), fun j => ?_⟩
  filter_upwards [hca j] with x h1
  rw [h1, Finset.mul_sum]
  exact Finset.sum_congr rfl fun k _ => by ring

theorem IsCombinationAt.neg {σ : μ → ι → X → ℂ} {y : X} {a : ι → X → ℂ}
    (ha : IsCombinationAt σ y a) : IsCombinationAt σ y (fun j x => -a j x) :=
  IsCombinationAt.congr (IsCombinationAt.smul (holAt_const (-1) y) ha)
    fun j => Eventually.of_forall fun x => by ring

theorem IsCombinationAt.sub {σ : μ → ι → X → ℂ} {y : X} {a b : ι → X → ℂ}
    (ha : IsCombinationAt σ y a) (hb : IsCombinationAt σ y b) :
    IsCombinationAt σ y (fun j x => a j x - b j x) :=
  IsCombinationAt.congr (IsCombinationAt.add ha (IsCombinationAt.neg hb))
    fun j => Eventually.of_forall fun x => by ring

theorem IsCombinationAt.finset_sum {α : Type*} (s : Finset α) {σ : μ → ι → X → ℂ} {y : X}
    {a : α → ι → X → ℂ} (ha : ∀ i ∈ s, IsCombinationAt σ y (a i)) :
    IsCombinationAt σ y (fun j x => ∑ i ∈ s, a i j x) := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using isCombinationAt_zero σ y
  | insert i s hi ih =>
      have h := IsCombinationAt.add (ha i (Finset.mem_insert_self i s))
        (ih fun i' hi' => ha i' (Finset.mem_insert_of_mem hi'))
      refine IsCombinationAt.congr h fun j => Eventually.of_forall fun x => ?_
      simp only [Finset.sum_insert hi]

/-- Each generator is a combination of the generators. -/
theorem isCombinationAt_gen [DecidableEq μ] (σ : μ → ι → X → ℂ) (y : X) (k : μ) :
    IsCombinationAt σ y (σ k) :=
  ⟨fun l _ => if l = k then 1 else 0, fun _ => holAt_const _ y,
    fun j => Eventually.of_forall fun x => by simp⟩

/-- A combination of generators holomorphic at `y` is holomorphic at `y`. -/
theorem IsCombinationAt.holTupleAt {σ : μ → ι → X → ℂ} {y : X} {a : ι → X → ℂ}
    (hσ : ∀ k j, HolAt (σ k j) y) (ha : IsCombinationAt σ y a) : HolTupleAt a y := by
  obtain ⟨c, hc, hca⟩ := ha
  exact fun j => (HolAt.fintype_sum fun k => (hc k).mul (hσ k j)).congr (hca j).symm

/-- **Transitivity**: a combination of combinations is a combination. -/
theorem IsCombinationAt.trans {σ : μ → ι → X → ℂ} {τ : ν → ι → X → ℂ} {y : X}
    {a : ι → X → ℂ} (ha : IsCombinationAt τ y a) (hτ : ∀ l, IsCombinationAt σ y (τ l)) :
    IsCombinationAt σ y a := by
  obtain ⟨d, hd, hda⟩ := ha
  have h : IsCombinationAt σ y (fun j x => ∑ l, d l x * τ l j x) :=
    IsCombinationAt.finset_sum Finset.univ fun l _ => IsCombinationAt.smul (hd l) (hτ l)
  exact IsCombinationAt.congr h fun j => (hda j).symm

/-- A tuple is a combination of the unit vectors iff it is holomorphic. -/
theorem isCombinationAt_unit_iff [DecidableEq ι] {y : X} {a : ι → X → ℂ} :
    IsCombinationAt (fun k j (_ : X) => if k = j then (1 : ℂ) else 0) y a ↔
      HolTupleAt a y := by
  constructor
  · exact fun h => IsCombinationAt.holTupleAt (fun _ _ => holAt_const _ y) h
  · intro ha
    exact ⟨a, ha, fun j => Eventually.of_forall fun x => by simp⟩

/-- Combinations are preserved by a matrix of functions holomorphic at `y`. -/
theorem IsCombinationAt.matApply {σ : μ → ι → X → ℂ} {y : X} {a : ι → X → ℂ}
    (A : κ → ι → X → ℂ) (ha : IsCombinationAt σ y a) :
    IsCombinationAt (fun k => Core.matApply A (σ k)) y (Core.matApply A a) := by
  obtain ⟨c, hc, hca⟩ := ha
  refine ⟨c, hc, fun i => ?_⟩
  have hall : ∀ᶠ x in 𝓝 y, ∀ j, a j x = ∑ k, c k x * σ k j x := eventually_all.2 hca
  filter_upwards [hall] with x hx
  simp only [Core.matApply, hx, Finset.mul_sum]
  rw [Finset.sum_comm]
  exact Finset.sum_congr rfl fun k _ => Finset.sum_congr rfl fun j _ => by ring

/-- A combination of a family of combinations, written with explicit coefficients. -/
theorem isCombinationAt_of_eventuallyEq {σ : μ → ι → X → ℂ} {y : X} {a : ι → X → ℂ}
    (c : μ → X → ℂ) (hc : ∀ k, HolAt (c k) y)
    (h : ∀ᶠ x in 𝓝 y, ∀ j, a j x = ∑ k, c k x * σ k j x) : IsCombinationAt σ y a :=
  ⟨c, hc, fun j => h.mono fun _ hx => hx j⟩

end Tuples

/-! ### Germ modules -/

/-- A subsheaf of `𝒪^ι` on `X`, recorded by membership of germs: `M.mem y a` says that the
germ at `y` of the tuple `a` lies in the stalk `M_y`. -/
@[ext] structure GermModule (X : Type*) (ι : Type) where
  /-- Membership of the germ of a tuple in a stalk. -/
  mem : X → (ι → X → ℂ) → Prop

namespace GermModule

variable {ι κ μ ν : Type} [Fintype ι] [Fintype κ] [Fintype μ] [Fintype ν]

/-- The tuples `σ_k`, holomorphic on `U`, generate the stalk of `M` at every point of `U`. -/
def GeneratedOn (M : GermModule X ι) (U : Set X) (σ : μ → ι → X → ℂ) : Prop :=
  (∀ k j, DifferentiableOn ℂ (σ k j) U) ∧ ∀ y ∈ U, ∀ a, M.mem y a ↔ IsCombinationAt σ y a

/-- `M` is generated by finitely many holomorphic sections on a neighbourhood of `x₀`. -/
def CoherentAt (M : GermModule X ι) (x₀ : X) : Prop :=
  ∃ U : Set X, IsOpen U ∧ x₀ ∈ U ∧
    ∃ (μ : Type) (_ : Fintype μ) (σ : μ → ι → X → ℂ), M.GeneratedOn U σ

/-- `M` is coherent at every point of `Ω`. -/
def IsCoherentOn (M : GermModule X ι) (Ω : Set X) : Prop :=
  ∀ x ∈ Ω, M.CoherentAt x

/-- Stalkwise inclusion over `Ω`. -/
def LeOn (M N : GermModule X ι) (Ω : Set X) : Prop :=
  ∀ y ∈ Ω, ∀ a, M.mem y a → N.mem y a

/-- Stalkwise equality over `Ω`. -/
def EqOn (M N : GermModule X ι) (Ω : Set X) : Prop :=
  ∀ y ∈ Ω, ∀ a, M.mem y a ↔ N.mem y a

theorem LeOn.refl (M : GermModule X ι) (Ω : Set X) : M.LeOn M Ω := fun _ _ _ h => h

theorem LeOn.trans {M N P : GermModule X ι} {Ω : Set X} (h₁ : M.LeOn N Ω) (h₂ : N.LeOn P Ω) :
    M.LeOn P Ω := fun y hy a ha => h₂ y hy a (h₁ y hy a ha)

theorem LeOn.mono {M N : GermModule X ι} {Ω Ω' : Set X} (h : M.LeOn N Ω) (hΩ : Ω' ⊆ Ω) :
    M.LeOn N Ω' := fun y hy => h y (hΩ hy)

theorem EqOn.symm {M N : GermModule X ι} {Ω : Set X} (h : M.EqOn N Ω) : N.EqOn M Ω :=
  fun y hy a => (h y hy a).symm

theorem EqOn.trans {M N P : GermModule X ι} {Ω : Set X} (h₁ : M.EqOn N Ω) (h₂ : N.EqOn P Ω) :
    M.EqOn P Ω := fun y hy a => (h₁ y hy a).trans (h₂ y hy a)

theorem EqOn.mono {M N : GermModule X ι} {Ω Ω' : Set X} (h : M.EqOn N Ω) (hΩ : Ω' ⊆ Ω) :
    M.EqOn N Ω' := fun y hy => h y (hΩ hy)

theorem EqOn.le {M N : GermModule X ι} {Ω : Set X} (h : M.EqOn N Ω) : M.LeOn N Ω :=
  fun y hy a => (h y hy a).1

theorem LeOn.antisymm {M N : GermModule X ι} {Ω : Set X} (h₁ : M.LeOn N Ω)
    (h₂ : N.LeOn M Ω) : M.EqOn N Ω := fun y hy a => ⟨h₁ y hy a, h₂ y hy a⟩

/-! #### Generation and coherence -/

section Generation

variable {M N : GermModule X ι} {U V : Set X} {σ : μ → ι → X → ℂ}

theorem GeneratedOn.mono (h : M.GeneratedOn U σ) (hVU : V ⊆ U) : M.GeneratedOn V σ :=
  ⟨fun k j => (h.1 k j).mono hVU, fun y hy => h.2 y (hVU hy)⟩

theorem GeneratedOn.congr (h : M.GeneratedOn U σ) (hMN : M.EqOn N U) : N.GeneratedOn U σ :=
  ⟨h.1, fun y hy a => (hMN y hy a).symm.trans (h.2 y hy a)⟩

theorem GeneratedOn.holAt (h : M.GeneratedOn U σ) (hU : IsOpen U) {y : X} (hy : y ∈ U)
    (k : μ) (j : ι) : HolAt (σ k j) y :=
  holAt_of_differentiableOn hU (h.1 k j) hy

/-- Members of a stalk of a generated module are holomorphic. -/
theorem GeneratedOn.holTupleAt (h : M.GeneratedOn U σ) (hU : IsOpen U) {y : X} (hy : y ∈ U)
    {a : ι → X → ℂ} (ha : M.mem y a) : HolTupleAt a y :=
  IsCombinationAt.holTupleAt (h.holAt hU hy) ((h.2 y hy a).1 ha)

/-- The generators are sections of the module. -/
theorem GeneratedOn.gen_mem (h : M.GeneratedOn U σ) {y : X} (hy : y ∈ U) (k : μ) :
    M.mem y (σ k) := by
  classical
  exact (h.2 y hy _).2 (isCombinationAt_gen σ y k)

/-- **Change of generators**: sections `τ_l` of `M` over `U` in terms of which the given
generators are combinations at every point of `U` generate `M` on `U`. -/
theorem GeneratedOn.of_generators {τ : ν → ι → X → ℂ} (h : M.GeneratedOn U σ)
    (hτd : ∀ l j, DifferentiableOn ℂ (τ l j) U) (hτM : ∀ y ∈ U, ∀ l, M.mem y (τ l))
    (hστ : ∀ y ∈ U, ∀ k, IsCombinationAt τ y (σ k)) : M.GeneratedOn U τ := by
  refine ⟨hτd, fun y hy a => ⟨fun ha =>
    IsCombinationAt.trans ((h.2 y hy a).1 ha) (hστ y hy), fun ha => ?_⟩⟩
  exact (h.2 y hy a).2 (IsCombinationAt.trans ha fun l => (h.2 y hy (τ l)).1 (hτM y hy l))

theorem CoherentAt.of_eqOn {x₀ : X} (hM : M.CoherentAt x₀) {Ω : Set X} (hΩ : Ω ∈ 𝓝 x₀)
    (hMN : M.EqOn N Ω) : N.CoherentAt x₀ := by
  obtain ⟨U, hU, hx₀U, μ', _, σ', hσ'⟩ := hM
  obtain ⟨W, hWΩ, hW, hx₀W⟩ := mem_nhds_iff.1 hΩ
  exact ⟨U ∩ W, hU.inter hW, ⟨hx₀U, hx₀W⟩, μ', inferInstance, σ',
    (hσ'.mono inter_subset_left).congr (hMN.mono fun y hy => hWΩ hy.2)⟩

/-- The coherence locus is open. -/
theorem CoherentAt.eventually {x₀ : X} (hM : M.CoherentAt x₀) :
    ∀ᶠ y in 𝓝 x₀, M.CoherentAt y := by
  obtain ⟨U, hU, hx₀U, μ', _, σ', hσ'⟩ := hM
  exact eventually_of_mem (hU.mem_nhds hx₀U) fun y hy => ⟨U, hU, hy, μ', inferInstance, σ', hσ'⟩

theorem IsCoherentOn.mono {Ω Ω' : Set X} (h : M.IsCoherentOn Ω) (hΩ : Ω' ⊆ Ω) :
    M.IsCoherentOn Ω' := fun x hx => h x (hΩ hx)

theorem IsCoherentOn.of_eqOn {Ω : Set X} (hΩ : IsOpen Ω) (h : M.IsCoherentOn Ω)
    (hMN : M.EqOn N Ω) : N.IsCoherentOn Ω :=
  fun x hx => (h x hx).of_eqOn (hΩ.mem_nhds hx) hMN

end Generation

/-! #### Stalks at points of coherence -/

section Stalk

variable {M : GermModule X ι} {y : X}

theorem CoherentAt.mem_iff (hM : M.CoherentAt y) :
    ∃ (μ : Type) (_ : Fintype μ) (σ : μ → ι → X → ℂ), (∀ k j, HolAt (σ k j) y) ∧
      ∀ a, M.mem y a ↔ IsCombinationAt σ y a := by
  obtain ⟨U, hU, hyU, μ', _, σ', hσ'⟩ := hM
  exact ⟨μ', inferInstance, σ', hσ'.holAt hU hyU, hσ'.2 y hyU⟩

theorem CoherentAt.holTupleAt_of_mem (hM : M.CoherentAt y) {a : ι → X → ℂ}
    (ha : M.mem y a) : HolTupleAt a y := by
  obtain ⟨μ', _, σ', hσ', hmem⟩ := hM.mem_iff
  exact IsCombinationAt.holTupleAt hσ' ((hmem a).1 ha)

theorem CoherentAt.zero_mem (hM : M.CoherentAt y) : M.mem y (fun _ _ => 0) := by
  obtain ⟨μ', _, σ', _, hmem⟩ := hM.mem_iff
  exact (hmem _).2 (isCombinationAt_zero σ' y)

theorem CoherentAt.congr_mem (hM : M.CoherentAt y) {a b : ι → X → ℂ} (ha : M.mem y a)
    (hab : ∀ j, a j =ᶠ[𝓝 y] b j) : M.mem y b := by
  obtain ⟨μ', _, σ', _, hmem⟩ := hM.mem_iff
  exact (hmem b).2 (IsCombinationAt.congr ((hmem a).1 ha) hab)

theorem CoherentAt.add_mem (hM : M.CoherentAt y) {a b : ι → X → ℂ} (ha : M.mem y a)
    (hb : M.mem y b) : M.mem y (fun j x => a j x + b j x) := by
  obtain ⟨μ', _, σ', _, hmem⟩ := hM.mem_iff
  exact (hmem _).2 (IsCombinationAt.add ((hmem a).1 ha) ((hmem b).1 hb))

theorem CoherentAt.smul_mem (hM : M.CoherentAt y) {a : ι → X → ℂ} {f : X → ℂ}
    (hf : HolAt f y) (ha : M.mem y a) : M.mem y (fun j x => f x * a j x) := by
  obtain ⟨μ', _, σ', _, hmem⟩ := hM.mem_iff
  exact (hmem _).2 (IsCombinationAt.smul hf ((hmem a).1 ha))

theorem CoherentAt.neg_mem (hM : M.CoherentAt y) {a : ι → X → ℂ} (ha : M.mem y a) :
    M.mem y (fun j x => -a j x) := by
  obtain ⟨μ', _, σ', _, hmem⟩ := hM.mem_iff
  exact (hmem _).2 (IsCombinationAt.neg ((hmem a).1 ha))

theorem CoherentAt.sub_mem (hM : M.CoherentAt y) {a b : ι → X → ℂ} (ha : M.mem y a)
    (hb : M.mem y b) : M.mem y (fun j x => a j x - b j x) := by
  obtain ⟨μ', _, σ', _, hmem⟩ := hM.mem_iff
  exact (hmem _).2 (IsCombinationAt.sub ((hmem a).1 ha) ((hmem b).1 hb))

theorem CoherentAt.finset_sum_mem (hM : M.CoherentAt y) {α : Type*} (s : Finset α)
    {a : α → ι → X → ℂ} (ha : ∀ i ∈ s, M.mem y (a i)) :
    M.mem y (fun j x => ∑ i ∈ s, a i j x) := by
  obtain ⟨μ', _, σ', _, hmem⟩ := hM.mem_iff
  exact (hmem _).2 (IsCombinationAt.finset_sum s fun i hi => (hmem _).1 (ha i hi))

/-- Combinations of members are members. -/
theorem CoherentAt.mem_of_isCombinationAt (hM : M.CoherentAt y) {τ : ν → ι → X → ℂ}
    (hτ : ∀ l, M.mem y (τ l)) {a : ι → X → ℂ} (ha : IsCombinationAt τ y a) : M.mem y a := by
  obtain ⟨μ', _, σ', _, hmem⟩ := hM.mem_iff
  exact (hmem a).2 (IsCombinationAt.trans ha fun l => (hmem _).1 (hτ l))

end Stalk

/-! #### The zero module, the free module and finitely generated modules -/

section Basic

/-- The zero subsheaf of `𝒪^ι`. -/
def bot (X : Type*) [NormedAddCommGroup X] [NormedSpace ℂ X] (ι : Type) :
    GermModule X ι :=
  ⟨fun y a => ∀ j, a j =ᶠ[𝓝 y] fun _ => 0⟩

/-- The free module `𝒪^ι`: all holomorphic germs. -/
def top (X : Type*) [NormedAddCommGroup X] [NormedSpace ℂ X] (ι : Type) [Fintype ι] :
    GermModule X ι :=
  ⟨fun y a => HolTupleAt a y⟩

/-- The submodule generated by finitely many tuples. -/
def span (σ : μ → ι → X → ℂ) : GermModule X ι :=
  ⟨fun y a => IsCombinationAt σ y a⟩

theorem bot_generatedOn (U : Set X) :
    (bot X ι).GeneratedOn U (fun (_ : Empty) (_ : ι) (_ : X) => (0 : ℂ)) := by
  refine ⟨fun k => k.elim, fun y _ a => ⟨fun ha => ⟨fun k _ => k.elim, fun k => k.elim,
    fun j => (ha j).mono fun x hx => by simpa using hx⟩, fun ⟨c, _, hc⟩ j =>
      (hc j).mono fun x hx => by simpa using hx⟩⟩

theorem bot_isCoherentOn (Ω : Set X) : (bot X ι).IsCoherentOn Ω :=
  fun _ _ => ⟨univ, isOpen_univ, mem_univ _, Empty, inferInstance, _, bot_generatedOn univ⟩

theorem top_generatedOn [DecidableEq ι] (U : Set X) :
    (top X ι).GeneratedOn U (fun k j (_ : X) => if k = j then (1 : ℂ) else 0) :=
  ⟨fun _ _ => differentiableOn_const _, fun _ _ _ => isCombinationAt_unit_iff.symm⟩

theorem top_isCoherentOn (Ω : Set X) : (top X ι).IsCoherentOn Ω := by
  classical
  exact fun _ _ => ⟨univ, isOpen_univ, mem_univ _, ι, inferInstance, _, top_generatedOn univ⟩

theorem span_generatedOn {σ : μ → ι → X → ℂ} {U : Set X}
    (hσ : ∀ k j, DifferentiableOn ℂ (σ k j) U) : (span σ).GeneratedOn U σ :=
  ⟨hσ, fun _ _ _ => Iff.rfl⟩

theorem span_isCoherentOn {σ : μ → ι → X → ℂ} {U : Set X} (hU : IsOpen U)
    (hσ : ∀ k j, DifferentiableOn ℂ (σ k j) U) : (span σ).IsCoherentOn U :=
  fun _ hx => ⟨U, hU, hx, μ, inferInstance, σ, span_generatedOn hσ⟩

theorem GeneratedOn.eqOn_span {M : GermModule X ι} {U : Set X} {σ : μ → ι → X → ℂ}
    (h : M.GeneratedOn U σ) : M.EqOn (span σ) U := h.2

/-- Every coherent module is contained in the free module. -/
theorem LeOn.top {M : GermModule X ι} {Ω : Set X} (hM : M.IsCoherentOn Ω) :
    M.LeOn (top X ι) Ω := fun y hy _ ha => (hM y hy).holTupleAt_of_mem ha

theorem bot_le {M : GermModule X ι} {Ω : Set X} (hM : M.IsCoherentOn Ω) :
    (bot X ι).LeOn M Ω :=
  fun y hy _ ha => (hM y hy).congr_mem (hM y hy).zero_mem fun j => (ha j).symm

end Basic

/-! #### Sums and images -/

section SupMap

/-- The sum `M + N` of two subsheaves of `𝒪^ι`. -/
def sup (M N : GermModule X ι) : GermModule X ι :=
  ⟨fun y a => ∃ b c, M.mem y b ∧ N.mem y c ∧ ∀ j, a j =ᶠ[𝓝 y] fun x => b j x + c j x⟩

/-- The image `A(M) ⊆ 𝒪^κ` of `M ⊆ 𝒪^ι` under the matrix `A : 𝒪^ι → 𝒪^κ`. -/
def map (A : κ → ι → X → ℂ) (M : GermModule X ι) : GermModule X κ :=
  ⟨fun y b => ∃ a, M.mem y a ∧ ∀ i, b i =ᶠ[𝓝 y] matApply A a i⟩

theorem isCombinationAt_sumElim_iff {σ : μ → ι → X → ℂ} {τ : ν → ι → X → ℂ} {y : X}
    {a : ι → X → ℂ} :
    IsCombinationAt (Sum.elim σ τ) y a ↔ ∃ b c, IsCombinationAt σ y b ∧
      IsCombinationAt τ y c ∧ ∀ j, a j =ᶠ[𝓝 y] fun x => b j x + c j x := by
  constructor
  · rintro ⟨e, he, hea⟩
    refine ⟨fun j x => ∑ k, e (Sum.inl k) x * σ k j x,
      fun j x => ∑ l, e (Sum.inr l) x * τ l j x,
      ⟨fun k => e (Sum.inl k), fun k => he _, fun _ => EventuallyEq.rfl⟩,
      ⟨fun l => e (Sum.inr l), fun l => he _, fun _ => EventuallyEq.rfl⟩, fun j => ?_⟩
    filter_upwards [hea j] with x hx
    rw [hx, Fintype.sum_sum_type]
    rfl
  · rintro ⟨b, c, ⟨d₁, hd₁, h₁⟩, ⟨d₂, hd₂, h₂⟩, hbc⟩
    refine ⟨Sum.elim d₁ d₂, fun k => ?_, fun j => ?_⟩
    · cases k with
      | inl k => exact hd₁ k
      | inr l => exact hd₂ l
    · filter_upwards [hbc j, h₁ j, h₂ j] with x hx hx₁ hx₂
      rw [hx, hx₁, hx₂, Fintype.sum_sum_type]
      rfl

/-- Generators of a sum: the union of generators. -/
theorem GeneratedOn.sup {M N : GermModule X ι} {U : Set X} {σ : μ → ι → X → ℂ}
    {τ : ν → ι → X → ℂ} (hM : M.GeneratedOn U σ) (hN : N.GeneratedOn U τ) :
    (M.sup N).GeneratedOn U (Sum.elim σ τ) := by
  refine ⟨fun k j => ?_, fun y hy a => ?_⟩
  · cases k with
    | inl k => exact hM.1 k j
    | inr l => exact hN.1 l j
  · rw [isCombinationAt_sumElim_iff]
    constructor
    · rintro ⟨b, c, hb, hc, h⟩
      exact ⟨b, c, (hM.2 y hy b).1 hb, (hN.2 y hy c).1 hc, h⟩
    · rintro ⟨b, c, hb, hc, h⟩
      exact ⟨b, c, (hM.2 y hy b).2 hb, (hN.2 y hy c).2 hc, h⟩

theorem CoherentAt.sup {M N : GermModule X ι} {x₀ : X} (hM : M.CoherentAt x₀)
    (hN : N.CoherentAt x₀) : (M.sup N).CoherentAt x₀ := by
  obtain ⟨U, hU, hx₀U, μ', _, σ, hσ⟩ := hM
  obtain ⟨V, hV, hx₀V, ν', _, τ, hτ⟩ := hN
  exact ⟨U ∩ V, hU.inter hV, ⟨hx₀U, hx₀V⟩, μ' ⊕ ν', inferInstance, _,
    (hσ.mono inter_subset_left).sup (hτ.mono inter_subset_right)⟩

theorem IsCoherentOn.sup {M N : GermModule X ι} {Ω : Set X} (hM : M.IsCoherentOn Ω)
    (hN : N.IsCoherentOn Ω) : (M.sup N).IsCoherentOn Ω :=
  fun x hx => (hM x hx).sup (hN x hx)

theorem le_sup_left {M N : GermModule X ι} {Ω : Set X} (hN : N.IsCoherentOn Ω) :
    M.LeOn (M.sup N) Ω :=
  fun y hy a ha => ⟨a, fun _ _ => 0, ha, (hN y hy).zero_mem,
    fun _ => Eventually.of_forall fun x => by simp⟩

theorem le_sup_right {M N : GermModule X ι} {Ω : Set X} (hM : M.IsCoherentOn Ω) :
    N.LeOn (M.sup N) Ω :=
  fun y hy a ha => ⟨fun _ _ => 0, a, (hM y hy).zero_mem, ha,
    fun _ => Eventually.of_forall fun x => by simp⟩

theorem sup_le {M N P : GermModule X ι} {Ω : Set X} (hP : P.IsCoherentOn Ω)
    (hMP : M.LeOn P Ω) (hNP : N.LeOn P Ω) : (M.sup N).LeOn P Ω := by
  rintro y hy a ⟨b, c, hb, hc, h⟩
  exact (hP y hy).congr_mem ((hP y hy).add_mem (hMP y hy b hb) (hNP y hy c hc))
    fun j => (h j).symm

/-- Generators of an image: the images of generators. -/
theorem GeneratedOn.map {M : GermModule X ι} {U : Set X} {σ : μ → ι → X → ℂ}
    (hM : M.GeneratedOn U σ) {A : κ → ι → X → ℂ} (hA : ∀ i j, DifferentiableOn ℂ (A i j) U) :
    (M.map A).GeneratedOn U (fun k => matApply A (σ k)) := by
  refine ⟨fun k i => DifferentiableOn.fun_sum fun j _ => (hA i j).mul (hM.1 k j),
    fun y hy b => ⟨?_, fun hb => ?_⟩⟩
  · rintro ⟨a, ha, hba⟩
    exact IsCombinationAt.congr (IsCombinationAt.matApply A ((hM.2 y hy a).1 ha))
      fun i => (hba i).symm
  · obtain ⟨c, hc, hcb⟩ := hb
    refine ⟨fun j x => ∑ k, c k x * σ k j x,
      (hM.2 y hy _).2 ⟨c, hc, fun _ => EventuallyEq.rfl⟩, fun i => ?_⟩
    filter_upwards [hcb i] with x hx
    rw [hx]
    simp only [matApply, Finset.mul_sum]
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl fun k _ => Finset.sum_congr rfl fun j _ => by ring

theorem CoherentAt.map {M : GermModule X ι} {x₀ : X} (hM : M.CoherentAt x₀)
    {A : κ → ι → X → ℂ} (hA : ∀ i j, HolAt (A i j) x₀) : (M.map A).CoherentAt x₀ := by
  obtain ⟨U, hU, hx₀U, μ', _, σ, hσ⟩ := hM
  obtain ⟨V, hV, hx₀V, hAV⟩ := exists_isOpen_differentiableOn (f := fun p : κ × ι => A p.1 p.2)
    (x₀ := x₀) fun p => hA p.1 p.2
  exact ⟨U ∩ V, hU.inter hV, ⟨hx₀U, hx₀V⟩, μ', inferInstance, _,
    (hσ.mono inter_subset_left).map (fun i j => (hAV (i, j)).mono inter_subset_right)⟩

theorem IsCoherentOn.map {M : GermModule X ι} {Ω : Set X} (hM : M.IsCoherentOn Ω)
    {A : κ → ι → X → ℂ} (hA : ∀ x ∈ Ω, ∀ i j, HolAt (A i j) x) : (M.map A).IsCoherentOn Ω :=
  fun x hx => (hM x hx).map (hA x hx)

/-- The image is contained in any module containing the images of the members. -/
theorem map_le {M : GermModule X ι} {P : GermModule X κ} {Ω : Set X} (hP : P.IsCoherentOn Ω)
    {A : κ → ι → X → ℂ} (h : ∀ y ∈ Ω, ∀ a, M.mem y a → P.mem y (matApply A a)) :
    (M.map A).LeOn P Ω := by
  rintro y hy b ⟨a, ha, hab⟩
  exact (hP y hy).congr_mem (h y hy a ha) fun i => (hab i).symm

theorem mem_map_of_mem {M : GermModule X ι} {A : κ → ι → X → ℂ} {y : X} {a : ι → X → ℂ}
    (ha : M.mem y a) : (M.map A).mem y (matApply A a) :=
  ⟨a, ha, fun _ => EventuallyEq.rfl⟩

end SupMap

/-! #### Transport along biholomorphic homeomorphisms -/

section Transport

variable {Y : Type*} [NormedAddCommGroup Y] [NormedSpace ℂ Y]

/-- The pull-back of a germ module along a homeomorphism `φ : X ≃ₜ Y`: `a ∈ (φ^* M)_x` iff
`a ∘ φ⁻¹ ∈ M_{φ x}`. -/
def comapHomeomorph (φ : X ≃ₜ Y) (M : GermModule Y ι) : GermModule X ι :=
  ⟨fun x a => M.mem (φ x) (fun j => a j ∘ φ.symm)⟩

/-- Combinations transport along biholomorphic homeomorphisms. -/
theorem isCombinationAt_comp_homeomorph (φ : X ≃ₜ Y) (hφ : ∀ x, DifferentiableAt ℂ φ x)
    (hφs : ∀ y, DifferentiableAt ℂ φ.symm y) {σ : μ → ι → Y → ℂ} {x : X}
    {a : ι → X → ℂ} :
    IsCombinationAt (fun k j => σ k j ∘ φ) x a ↔
      IsCombinationAt σ (φ x) (fun j => a j ∘ φ.symm) := by
  have hsy : φ.symm (φ x) = x := φ.symm_apply_apply x
  have hφs_t : Tendsto φ.symm (𝓝 (φ x)) (𝓝 x) := by
    have := φ.symm.continuous.tendsto (φ x)
    rwa [hsy] at this
  have hφ_t : Tendsto φ (𝓝 x) (𝓝 (φ x)) := φ.continuous.tendsto x
  constructor
  · rintro ⟨c, hc, hca⟩
    refine ⟨fun k => c k ∘ φ.symm, fun k => ?_, fun j => ?_⟩
    · have h1 : HolAt (c k) (φ.symm (φ x)) := by rw [hsy]; exact hc k
      exact h1.comp φ.symm.continuous hφs
    · filter_upwards [hφs_t.eventually (hca j)] with y hy
      simpa only [Function.comp_apply, Homeomorph.apply_symm_apply] using hy
  · rintro ⟨c, hc, hca⟩
    refine ⟨fun k => c k ∘ φ, fun k => (hc k).comp φ.continuous hφ, fun j => ?_⟩
    filter_upwards [hφ_t.eventually (hca j)] with y hy
    simpa only [Function.comp_apply, Homeomorph.symm_apply_apply] using hy

/-- Generators pull back to generators. -/
theorem GeneratedOn.comapHomeomorph (φ : X ≃ₜ Y) (hφ : ∀ x, DifferentiableAt ℂ φ x)
    (hφs : ∀ y, DifferentiableAt ℂ φ.symm y) {M : GermModule Y ι} {V : Set Y}
    {σ : μ → ι → Y → ℂ} (h : M.GeneratedOn V σ) :
    (M.comapHomeomorph φ).GeneratedOn (φ ⁻¹' V) (fun k j => σ k j ∘ φ) :=
  ⟨fun k j => (h.1 k j).comp (fun x _ => (hφ x).differentiableWithinAt) fun _ hx => hx,
    fun x hx _ => (h.2 (φ x) hx _).trans (isCombinationAt_comp_homeomorph φ hφ hφs).symm⟩

/-- **Coherence is invariant under biholomorphic homeomorphisms.** -/
theorem CoherentAt.comapHomeomorph (φ : X ≃ₜ Y) (hφ : ∀ x, DifferentiableAt ℂ φ x)
    (hφs : ∀ y, DifferentiableAt ℂ φ.symm y) {M : GermModule Y ι} {x : X}
    (hM : M.CoherentAt (φ x)) : (M.comapHomeomorph φ).CoherentAt x := by
  obtain ⟨V, hV, hxV, μ', _, σ, hσ⟩ := hM
  exact ⟨φ ⁻¹' V, hV.preimage φ.continuous, hxV, μ', inferInstance, _,
    hσ.comapHomeomorph φ hφ hφs⟩

end Transport

end GermModule

