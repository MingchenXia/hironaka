import Hironaka.Analytic.GAGA.CoreBCartanGen
import Hironaka.Analytic.GAGA.CoreGermModule

/-!
# Theorem A: gluing generators across a hyperplane

Infrastructure of lane SERRE-CORE2 (Serre's GAGA, towards source `lma:GAGA`), step M2.4 of the
plan in `blueprint/src/claude-serre-core.tex` (see `blueprint/src/claude-serre-core2.tex`).
Source for the mathematics: Cartan's Theorem A on closed cubes (Gunning--Rossi, *Analytic
functions of several complex variables*, VIII.A; Grauert--Remmert, *Theory of Stein spaces*,
IV §2), the step "from two halves to the whole".

Let `Q = ∏ C_l` be a compact convex product set split by `Re(θ z_i) = t` into `Q'`, `Q''` with
face `K`. Let `M ⊆ 𝒪^ι` be a germ module generated by `σ'` on a neighbourhood of `Q'` and by
`σ''` on a neighbourhood of `Q''`, and suppose that near `K` each system is a combination of the
other: `σ'' = σ' T`, `σ' = σ'' S` (this is division by generators on the face). Then `M` is
generated by finitely many sections on a neighbourhood of `Q` (`exists_generatedOn_union`).

Proof: `(σ', 0) U(T) L(-S) = (0, σ'')` near `K`, and Cartan's lemma for unipotent products
(`exists_factor_unipotent`) gives `U(T) L(-S) = B' B''⁻¹`, so `(σ', 0) B' = (0, σ'') B''` near
`K`. The two sides glue (`exists_glue`) to a system `Σ` near `Q`, which generates `M` because
`B'`, `B''` are invertible.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open Set Filter Metric Complex Matrix
open scoped Topology
open Hironaka.OkaRelationSheaf

namespace Hironaka.Analytic.GAGA.Core.TheoremA

open Mat Cartan

noncomputable section

/-! ### Gluing across a hyperplane -/

section Glue

variable {X : Type*} [TopologicalSpace X] {β : Type*}

/-- **Gluing across a hyperplane.** Two functions on open sets `V₁`, `V₂` that agree on
`V₀ ∩ V₁ ∩ V₂` glue to a function on an open set containing `V₁ ∩ {L < t}`, `V₂ ∩ {L > t}` and
`V₀ ∩ V₁ ∩ V₂`, which near each of its points agrees with `g₁` (inside `V₁`) or with `g₂`
(inside `V₂`). -/
theorem exists_glue {V₀ V₁ V₂ : Set X} (h₀ : IsOpen V₀) (h₁ : IsOpen V₁) (h₂ : IsOpen V₂)
    {L : X → ℝ} (hL : Continuous L) (t : ℝ) (g₁ g₂ : X → β)
    (h : ∀ z ∈ V₀ ∩ V₁ ∩ V₂, g₁ z = g₂ z) :
    ∃ (V : Set X) (g : X → β), IsOpen V ∧ (∀ z ∈ V₁, L z < t → z ∈ V) ∧
      (∀ z ∈ V₂, t < L z → z ∈ V) ∧ V₀ ∩ V₁ ∩ V₂ ⊆ V ∧
      ∀ z ∈ V, ∃ N ∈ 𝓝 z, (N ⊆ V₁ ∧ ∀ y ∈ N, g y = g₁ y) ∨ (N ⊆ V₂ ∧ ∀ y ∈ N, g y = g₂ y) := by
  classical
  have hlt : IsOpen {z | L z < t} := isOpen_lt hL continuous_const
  have hgt : IsOpen {z | t < L z} := isOpen_lt continuous_const hL
  refine ⟨(V₁ ∩ {z | L z < t}) ∪ (V₂ ∩ {z | t < L z}) ∪ (V₀ ∩ V₁ ∩ V₂),
    fun z => if L z ≤ t then g₁ z else g₂ z, ((h₁.inter hlt).union (h₂.inter hgt)).union
      ((h₀.inter h₁).inter h₂), fun z hz hzt => Or.inl (Or.inl ⟨hz, hzt⟩),
    fun z hz hzt => Or.inl (Or.inr ⟨hz, hzt⟩), fun z hz => Or.inr hz, fun z hz => ?_⟩
  rcases hz with (⟨hz1, hzt⟩ | ⟨hz2, hzt⟩) | hz0
  · refine ⟨V₁ ∩ {z | L z < t}, (h₁.inter hlt).mem_nhds ⟨hz1, hzt⟩, Or.inl ⟨inter_subset_left,
      fun y hy => ?_⟩⟩
    have h' : L y < t := hy.2
    simp [le_of_lt h']
  · refine ⟨V₂ ∩ {z | t < L z}, (h₂.inter hgt).mem_nhds ⟨hz2, hzt⟩, Or.inr ⟨inter_subset_left,
      fun y hy => ?_⟩⟩
    have h' : t < L y := hy.2
    simp [not_le.2 h']
  · refine ⟨V₀ ∩ V₁ ∩ V₂, ((h₀.inter h₁).inter h₂).mem_nhds hz0, Or.inl
      ⟨fun y hy => hy.1.2, fun y hy => ?_⟩⟩
    by_cases hy' : L y ≤ t
    · simp [hy']
    · simp only [hy', if_false]
      exact (h y hy).symm

end Glue

/-! ### Generators related by invertible matrices -/

section Generators

variable {X : Type*} [NormedAddCommGroup X] [NormedSpace ℂ X]
variable {ι μ ν : Type} [Fintype ι] [Fintype μ] [Fintype ν] [DecidableEq ν]

/-- If `Σ = σ B` on a neighbourhood of `y` (as matrices with columns the tuples) with `B`
holomorphic and invertible near `y`, then `σ` and `Σ` are combinations of each other at `y`. -/
theorem isCombinationAt_of_mul {σ : μ → ι → X → ℂ} {τ : ν → ι → X → ℂ} {y : X}
    {N : Set X} (hN : IsOpen N) (hy : y ∈ N) {B : X → Matrix μ ν ℂ} (hB : MatHolOn B N)
    (heq : ∀ z ∈ N, ∀ x j, τ x j z = ∑ k, B z k x * σ k j z) (x : ν) :
    IsCombinationAt σ y (τ x) :=
  isCombinationAt_of_eventuallyEq (fun k z => B z k x)
    (fun k => holAt_of_differentiableOn hN (hB k x) hy)
    (eventually_of_mem (hN.mem_nhds hy) fun z hz j => heq z hz x j)

end Generators

/-! ### Theorem A for the union of two halves -/

variable {n : ℕ}

/-- **Theorem A from the two halves.** Let `C_l ⊆ ℂ` be compact and convex, `Q = ∏ C_l`, and
`Q' = Q ∩ {Re(θ z_i) ≤ t}`, `Q'' = Q ∩ {Re(θ z_i) ≥ t}`, `K = Q ∩ {Re(θ z_i) = t}`. Let `M` be
generated by `σ'` on an open `U₁ ⊇ Q'` and by `σ''` on an open `U₂ ⊇ Q''`, and suppose that on
an open `W ⊇ K` we have `σ''_m = ∑_k T_{km} σ'_k` and `σ'_k = ∑_m S_{mk} σ''_m` with holomorphic
`T`, `S`. Then `M` is generated by finitely many tuples on an open set containing `Q`. -/
theorem exists_generatedOn_union (i : Fin n) (θ : ℂ) (t : ℝ) {C : Fin n → Set ℂ}
    (hC : ∀ l, IsCompact (C l)) (hconv : ∀ l, Convex ℝ (C l)) {ι : Type} [Fintype ι]
    {M : GermModule (EuclideanSpace ℂ (Fin n)) ι} {μ' μ'' : Type} [Fintype μ'] [DecidableEq μ']
    [Fintype μ''] [DecidableEq μ''] {U₁ U₂ W : Set (EuclideanSpace ℂ (Fin n))}
    (hU₁ : IsOpen U₁) (hU₂ : IsOpen U₂) (hW : IsOpen W)
    (hQ'U : {z | (∀ l, z l ∈ C l) ∧ (θ * z i).re ≤ t} ⊆ U₁)
    (hQ''U : {z | (∀ l, z l ∈ C l) ∧ t ≤ (θ * z i).re} ⊆ U₂)
    (hKW : {z | (∀ l, z l ∈ C l) ∧ (θ * z i).re = t} ⊆ W)
    {σ' : μ' → ι → EuclideanSpace ℂ (Fin n) → ℂ} {σ'' : μ'' → ι → EuclideanSpace ℂ (Fin n) → ℂ}
    (h₁ : M.GeneratedOn U₁ σ') (h₂ : M.GeneratedOn U₂ σ'')
    {T : EuclideanSpace ℂ (Fin n) → Matrix μ' μ'' ℂ}
    {S : EuclideanSpace ℂ (Fin n) → Matrix μ'' μ' ℂ} (hT : MatHolOn T W) (hS : MatHolOn S W)
    (hσ'' : ∀ z ∈ W, ∀ m j, σ'' m j z = ∑ k, T z k m * σ' k j z)
    (hσ' : ∀ z ∈ W, ∀ k j, σ' k j z = ∑ m, S z m k * σ'' m j z) :
    ∃ U : Set (EuclideanSpace ℂ (Fin n)), IsOpen U ∧ {z | ∀ l, z l ∈ C l} ⊆ U ∧
      ∃ τ : μ' ⊕ μ'' → ι → EuclideanSpace ℂ (Fin n) → ℂ, M.GeneratedOn U τ := by
  classical
  set W₀ := W ∩ U₁ ∩ U₂ with hW₀
  have hW₀o : IsOpen W₀ := (hW.inter hU₁).inter hU₂
  have hKW₀ : {z : EuclideanSpace ℂ (Fin n) | (∀ l, z l ∈ C l) ∧ (θ * z i).re = t} ⊆ W₀ :=
    fun z hz => ⟨⟨hKW hz, hQ'U ⟨hz.1, hz.2.le⟩⟩, hQ''U ⟨hz.1, hz.2.ge⟩⟩
  obtain ⟨ε, hε, hslabW, B', B'', hB'h, hB''h, hB'd, hB''d, hfac⟩ :=
    exists_factor_unipotent i θ t hC hconv μ' μ'' hW₀o hKW₀ (hT.mono fun z hz => hz.1.1)
      (hS.mono fun z hz => hz.1.1)
  -- the two systems as matrices with columns the tuples
  set Φ' : EuclideanSpace ℂ (Fin n) → Matrix ι (μ' ⊕ μ'') ℂ := fun z =>
    Matrix.of fun j x => Sum.elim (fun k => σ' k j z) (fun _ => 0) x with hΦ'def
  set Φ'' : EuclideanSpace ℂ (Fin n) → Matrix ι (μ' ⊕ μ'') ℂ := fun z =>
    Matrix.of fun j x => Sum.elim (fun _ => 0) (fun m => σ'' m j z) x with hΦ''def
  -- `(σ', 0) U(T) L(-S) = (0, σ'')` on `W`
  have hΦA : ∀ z ∈ W, Φ' z * (upperU (T z) * lowerU (-S z)) = Φ'' z := by
    intro z hz
    have hA : upperU (T z) * lowerU (-S z) = fromBlocks (1 - T z * S z) (T z) (-S z) 1 := by
      simp [upperU, lowerU, fromBlocks_multiply, sub_eq_add_neg]
    rw [hA]
    ext j x
    rcases x with k₀ | m
    · simp only [hΦ'def, hΦ''def, Matrix.mul_apply, Fintype.sum_sum_type, Matrix.of_apply,
        Sum.elim_inl, Sum.elim_inr, fromBlocks_apply₁₁, fromBlocks_apply₂₁, zero_mul,
        Finset.sum_const_zero, add_zero, Matrix.sub_apply, mul_sub, Finset.sum_sub_distrib]
      have h2 : ∑ k, σ' k j z * ∑ m, T z k m * S z m k₀ = σ' k₀ j z := by
        simp only [Finset.mul_sum]
        rw [Finset.sum_comm, hσ' z hz k₀ j]
        refine Finset.sum_congr rfl fun m _ => ?_
        rw [hσ'' z hz m j, Finset.mul_sum]
        exact Finset.sum_congr rfl fun k _ => by ring
      have h1 : ∑ k, σ' k j z * (1 : Matrix μ' μ' ℂ) k k₀ = σ' k₀ j z := by
        simp [Matrix.one_apply]
      exact sub_eq_zero.2 (h1.trans h2.symm)
    · simp only [hΦ'def, hΦ''def, Matrix.mul_apply, Fintype.sum_sum_type, Matrix.of_apply,
        Sum.elim_inl, Sum.elim_inr, fromBlocks_apply₁₂, fromBlocks_apply₂₂, zero_mul,
        Finset.sum_const_zero, add_zero]
      rw [hσ'' z hz m j]
      exact Finset.sum_congr rfl fun k _ => by ring
  -- the two glued systems
  set G' : EuclideanSpace ℂ (Fin n) → Matrix ι (μ' ⊕ μ'') ℂ := fun z => Φ' z * B' z
  set G'' : EuclideanSpace ℂ (Fin n) → Matrix ι (μ' ⊕ μ'') ℂ := fun z => Φ'' z * B'' z
  have hGeq : ∀ z ∈ slab C ε i θ t ε, G' z = G'' z := by
    intro z hz
    have hzW : z ∈ W := (hslabW hz).1.1
    have hzR : z ∈ rightSide C ε i θ t ε := ((slab_eq_inter C i θ t ε ε) ▸ hz).2
    have hu : IsUnit (B'' z).det := isUnit_iff_ne_zero.2 (hB''d z hzR)
    calc G' z = Φ' z * (B' z * (B'' z)⁻¹) * B'' z := by
          simp only [G', Matrix.mul_assoc, Matrix.nonsing_inv_mul _ hu, Matrix.mul_one]
      _ = G'' z := by rw [← hfac z hz, hΦA z hzW]
  set V₁ := U₁ ∩ leftSide C ε i θ t ε
  set V₂ := U₂ ∩ rightSide C ε i θ t ε
  have hV₁ : IsOpen V₁ := hU₁.inter (isOpen_leftSide C i θ t ε ε)
  have hV₂ : IsOpen V₂ := hU₂.inter (isOpen_rightSide C i θ t ε ε)
  obtain ⟨V, G, hVo, hV1, hV2, hV0, hloc⟩ := exists_glue (isOpen_slab C i θ t ε ε) hV₁ hV₂
    (continuous_linForm i θ) t G' G'' fun z hz => hGeq z hz.1.1
  -- `Q ⊆ V`
  have hQV : {z : EuclideanSpace ℂ (Fin n) | ∀ l, z l ∈ C l} ⊆ V := by
    intro z hz
    have hthick : ∀ l, z l ∈ thickening ε (C l) := fun l => self_subset_thickening hε _ (hz l)
    rcases lt_trichotomy (θ * z i).re t with h | h | h
    · exact hV1 z ⟨hQ'U ⟨hz, h.le⟩, hthick, by linarith⟩ h
    · refine hV0 ⟨⟨⟨hthick, by rw [h, sub_self, abs_zero]; exact hε⟩, hQ'U ⟨hz, h.le⟩,
        hthick, by linarith⟩, hQ''U ⟨hz, h.ge⟩, hthick, by linarith⟩
    · exact hV2 z ⟨hQ''U ⟨hz, h.le⟩, hthick, by linarith⟩ h
  refine ⟨V, hVo, hQV, fun x j z => G z j x, fun x j => ?_, fun y hy a => ?_⟩
  · -- holomorphy
    intro z hz
    obtain ⟨N, hN, hside⟩ := hloc z hz
    have hm' : MatHolOn Φ' V₁ := by
      intro j' x'
      rcases x' with k | m
      · simpa [hΦ'def] using (h₁.1 k j').mono fun z hz => hz.1
      · simp [hΦ'def]
    have hm'' : MatHolOn Φ'' V₂ := by
      intro j' x'
      rcases x' with k | m
      · simp [hΦ''def]
      · simpa [hΦ''def] using (h₂.1 m j').mono fun z hz => hz.1
    rcases hside with ⟨hNV, hNg⟩ | ⟨hNV, hNg⟩
    · have hd : DifferentiableAt ℂ (fun z => G' z j x) z :=
        ((hm'.mul (hB'h.mono fun z hz => hz.2)) j x).differentiableAt
          (hV₁.mem_nhds (hNV (mem_of_mem_nhds hN)))
      exact (hd.congr_of_eventuallyEq (eventually_of_mem hN fun y hy => by
        simp only [hNg y hy])).differentiableWithinAt
    · have hd : DifferentiableAt ℂ (fun z => G'' z j x) z :=
        ((hm''.mul (hB''h.mono fun z hz => hz.2)) j x).differentiableAt
          (hV₂.mem_nhds (hNV (mem_of_mem_nhds hN)))
      exact (hd.congr_of_eventuallyEq (eventually_of_mem hN fun y hy => by
        simp only [hNg y hy])).differentiableWithinAt
  · -- generation at `y`
    obtain ⟨N, hN, hside⟩ := hloc y hy
    obtain ⟨N', hN'N, hN'o, hyN'⟩ := _root_.mem_nhds_iff.1 hN
    rcases hside with ⟨hNV, hNg⟩ | ⟨hNV, hNg⟩
    · have hyU : y ∈ U₁ := (hNV (hN'N hyN')).1
      have hBinv : MatHolOn (fun z => (B' z)⁻¹) N' :=
        (hB'h.inv hB'd).mono fun z hz => (hNV (hN'N hz)).2
      rw [h₁.2 y hyU a]
      constructor
      · intro ha
        refine IsCombinationAt.trans ha fun k => ?_
        refine isCombinationAt_of_mul (σ := fun x j z => G z j x) (τ := σ')
          (B := fun z => Matrix.of fun x k => (B' z)⁻¹ x (Sum.inl k)) hN'o hyN'
          (fun x k => by simpa using hBinv x (Sum.inl k)) (fun z hz k' j => ?_) k
        have hu : IsUnit (B' z).det := isUnit_iff_ne_zero.2 (hB'd z (hNV (hN'N hz)).2)
        have hΦ : Φ' z = G z * (B' z)⁻¹ := by
          rw [hNg z (hN'N hz)]
          simp only [G', Matrix.mul_assoc, Matrix.mul_nonsing_inv _ hu, Matrix.mul_one]
        have := congrFun (congrFun hΦ j) (Sum.inl k')
        rw [Matrix.mul_apply] at this
        simp only [hΦ'def, Matrix.of_apply, Sum.elim_inl] at this
        rw [this]
        exact Finset.sum_congr rfl fun x _ => by simp [mul_comm]
      · intro ha
        refine IsCombinationAt.trans ha fun x => ?_
        refine isCombinationAt_of_mul (σ := σ') (τ := fun x j z => G z j x)
          (B := fun z => Matrix.of fun k x => B' z (Sum.inl k) x) hN'o hyN'
          (fun k x' => by simpa using (hB'h _ x').mono fun z hz => (hNV (hN'N hz)).2)
          (fun z hz x' j => ?_) x
        rw [hNg z (hN'N hz)]
        simp only [G', Matrix.mul_apply, Fintype.sum_sum_type, hΦ'def, Matrix.of_apply,
          Sum.elim_inl, Sum.elim_inr, zero_mul, Finset.sum_const_zero, add_zero]
        exact Finset.sum_congr rfl fun k _ => mul_comm _ _
    · have hyU : y ∈ U₂ := (hNV (hN'N hyN')).1
      have hBinv : MatHolOn (fun z => (B'' z)⁻¹) N' :=
        (hB''h.inv hB''d).mono fun z hz => (hNV (hN'N hz)).2
      rw [h₂.2 y hyU a]
      constructor
      · intro ha
        refine IsCombinationAt.trans ha fun m => ?_
        refine isCombinationAt_of_mul (σ := fun x j z => G z j x) (τ := σ'')
          (B := fun z => Matrix.of fun x m => (B'' z)⁻¹ x (Sum.inr m)) hN'o hyN'
          (fun x m => by simpa using hBinv x (Sum.inr m)) (fun z hz m' j => ?_) m
        have hu : IsUnit (B'' z).det := isUnit_iff_ne_zero.2 (hB''d z (hNV (hN'N hz)).2)
        have hΦ : Φ'' z = G z * (B'' z)⁻¹ := by
          rw [hNg z (hN'N hz)]
          simp only [G'', Matrix.mul_assoc, Matrix.mul_nonsing_inv _ hu, Matrix.mul_one]
        have := congrFun (congrFun hΦ j) (Sum.inr m')
        rw [Matrix.mul_apply] at this
        simp only [hΦ''def, Matrix.of_apply, Sum.elim_inr] at this
        rw [this]
        exact Finset.sum_congr rfl fun x _ => by simp [mul_comm]
      · intro ha
        refine IsCombinationAt.trans ha fun x => ?_
        refine isCombinationAt_of_mul (σ := σ'') (τ := fun x j z => G z j x)
          (B := fun z => Matrix.of fun m x => B'' z (Sum.inr m) x) hN'o hyN'
          (fun m x' => by simpa using (hB''h _ x').mono fun z hz => (hNV (hN'N hz)).2)
          (fun z hz x' j => ?_) x
        rw [hNg z (hN'N hz)]
        simp only [G'', Matrix.mul_apply, Fintype.sum_sum_type, hΦ''def, Matrix.of_apply,
          Sum.elim_inl, Sum.elim_inr, zero_mul, Finset.sum_const_zero, zero_add]
        exact Finset.sum_congr rfl fun k _ => mul_comm _ _


/-- **Division from the two halves (step of Theorem B).** Let `σ` be tuples and `ρ_r` relations
among them (`∑_k ρ_{rk} σ_k = 0`) on an open `Ω ⊇ Q`. Suppose `f = ∑ c'_k σ_k` near `Q'` and
`f = ∑ c''_k σ_k` near `Q''`, and that near the face `K` the difference of coefficients is a
combination of the relations: `c' - c'' = ∑_r e_r ρ_r`. Then `f = ∑ c_k σ_k` on an open set
containing `Q`, with holomorphic coefficients `c_k`. (The coefficients `e_r` are split by
Cousin I across the hyperplane and absorbed into `c'`, `c''`.) -/
theorem exists_combination_union (i : Fin n) (θ : ℂ) (t : ℝ) {C : Fin n → Set ℂ}
    (hC : ∀ l, IsCompact (C l)) {ι μ ν : Type} [Fintype ι] [Fintype μ] [Fintype ν]
    {σ : μ → ι → EuclideanSpace ℂ (Fin n) → ℂ} {ρ : ν → μ → EuclideanSpace ℂ (Fin n) → ℂ}
    {f : ι → EuclideanSpace ℂ (Fin n) → ℂ} {Ω U₁ U₂ W : Set (EuclideanSpace ℂ (Fin n))}
    (hΩ : IsOpen Ω) (hU₁ : IsOpen U₁) (hU₂ : IsOpen U₂) (hW : IsOpen W)
    (hQΩ : {z | ∀ l, z l ∈ C l} ⊆ Ω)
    (hQ'U : {z | (∀ l, z l ∈ C l) ∧ (θ * z i).re ≤ t} ⊆ U₁)
    (hQ''U : {z | (∀ l, z l ∈ C l) ∧ t ≤ (θ * z i).re} ⊆ U₂)
    (hKW : {z | (∀ l, z l ∈ C l) ∧ (θ * z i).re = t} ⊆ W)
    (hρh : ∀ r k, DifferentiableOn ℂ (ρ r k) Ω)
    (hρ : ∀ z ∈ Ω, ∀ r j, ∑ k, ρ r k z * σ k j z = 0)
    {c' c'' : μ → EuclideanSpace ℂ (Fin n) → ℂ} (hc' : ∀ k, DifferentiableOn ℂ (c' k) U₁)
    (hc'' : ∀ k, DifferentiableOn ℂ (c'' k) U₂)
    (hf' : ∀ z ∈ U₁, ∀ j, f j z = ∑ k, c' k z * σ k j z)
    (hf'' : ∀ z ∈ U₂, ∀ j, f j z = ∑ k, c'' k z * σ k j z)
    {e : ν → EuclideanSpace ℂ (Fin n) → ℂ} (he : ∀ r, DifferentiableOn ℂ (e r) W)
    (hce : ∀ z ∈ W, ∀ k, c' k z - c'' k z = ∑ r, e r z * ρ r k z) :
    ∃ V : Set (EuclideanSpace ℂ (Fin n)), IsOpen V ∧ {z | ∀ l, z l ∈ C l} ⊆ V ∧
      ∃ c : μ → EuclideanSpace ℂ (Fin n) → ℂ, (∀ k, DifferentiableOn ℂ (c k) V) ∧
        ∀ z ∈ V, ∀ j, f j z = ∑ k, c k z * σ k j z := by
  classical
  have hsplit := fun r => Cousin.exists_cousin_split_compact i θ t hC hW (he r) hKW
  choose W' W'' hW'o hW''o hQW' hQW'' e' e'' he' he'' hee using hsplit
  set V₁ := U₁ ∩ Ω ∩ ⋂ r, W' r
  set V₂ := U₂ ∩ Ω ∩ ⋂ r, W'' r
  set V₀ := W ∩ ⋂ r, (W' r ∩ W'' r)
  have hV₁ : IsOpen V₁ := (hU₁.inter hΩ).inter (isOpen_iInter_of_finite hW'o)
  have hV₂ : IsOpen V₂ := (hU₂.inter hΩ).inter (isOpen_iInter_of_finite hW''o)
  have hV₀ : IsOpen V₀ := hW.inter (isOpen_iInter_of_finite fun r => (hW'o r).inter (hW''o r))
  set g₁ : EuclideanSpace ℂ (Fin n) → μ → ℂ := fun z k => c' k z - ∑ r, e' r z * ρ r k z
  set g₂ : EuclideanSpace ℂ (Fin n) → μ → ℂ := fun z k => c'' k z - ∑ r, e'' r z * ρ r k z
  obtain ⟨V, g, hVo, hV1, hV2, hV0, hloc⟩ := exists_glue hV₀ hV₁ hV₂ (continuous_linForm i θ) t
    g₁ g₂ (by
      intro z hz
      funext k
      have h1 := hce z hz.1.1.1 k
      have h2 : ∀ r, e r z = e' r z - e'' r z := fun r =>
        hee r z ⟨(mem_iInter.1 hz.1.1.2 r).1, (mem_iInter.1 hz.1.1.2 r).2⟩
      simp only [g₁, g₂, h2, sub_mul, Finset.sum_sub_distrib] at h1 ⊢
      linear_combination h1)
  have hQ' : ∀ z, (∀ l, z l ∈ C l) → (θ * z i).re ≤ t → z ∈ V₁ := fun z hz hzt =>
    ⟨⟨hQ'U ⟨hz, hzt⟩, hQΩ hz⟩, mem_iInter.2 fun r => hQW' r ⟨hz, hzt⟩⟩
  have hQ'' : ∀ z, (∀ l, z l ∈ C l) → t ≤ (θ * z i).re → z ∈ V₂ := fun z hz hzt =>
    ⟨⟨hQ''U ⟨hz, hzt⟩, hQΩ hz⟩, mem_iInter.2 fun r => hQW'' r ⟨hz, hzt⟩⟩
  refine ⟨V, hVo, fun z hz => ?_, fun k z => g z k, fun k => ?_, fun z hz j => ?_⟩
  · rcases lt_trichotomy (θ * z i).re t with h | h | h
    · exact hV1 z (hQ' z hz h.le) h
    · exact hV0 ⟨⟨⟨hKW ⟨hz, h⟩, mem_iInter.2 fun r => ⟨hQW' r ⟨hz, h.le⟩,
        hQW'' r ⟨hz, h.ge⟩⟩⟩, hQ' z hz h.le⟩, hQ'' z hz h.ge⟩
    · exact hV2 z (hQ'' z hz h.le) h
  · intro z hz
    obtain ⟨N, hN, hside⟩ := hloc z hz
    have hρN : ∀ {N : Set (EuclideanSpace ℂ (Fin n))}, N ⊆ Ω → z ∈ N → IsOpen N →
        ∀ r, DifferentiableAt ℂ (ρ r k) z := fun hNΩ hzN hNo r =>
      (hρh r k).differentiableAt (hΩ.mem_nhds (hNΩ hzN))
    rcases hside with ⟨hNV, hNg⟩ | ⟨hNV, hNg⟩
    · have hzV : z ∈ V₁ := hNV (mem_of_mem_nhds hN)
      have hd : DifferentiableAt ℂ (fun y => g₁ y k) z := by
        refine ((hc' k).differentiableAt (hU₁.mem_nhds hzV.1.1)).sub ?_
        refine DifferentiableAt.fun_sum fun r _ => ?_
        exact ((he' r).differentiableAt ((hW'o r).mem_nhds (mem_iInter.1 hzV.2 r))).mul
          ((hρh r k).differentiableAt (hΩ.mem_nhds hzV.1.2))
      exact (hd.congr_of_eventuallyEq (eventually_of_mem hN fun y hy => by
        simp only [hNg y hy])).differentiableWithinAt
    · have hzV : z ∈ V₂ := hNV (mem_of_mem_nhds hN)
      have hd : DifferentiableAt ℂ (fun y => g₂ y k) z := by
        refine ((hc'' k).differentiableAt (hU₂.mem_nhds hzV.1.1)).sub ?_
        refine DifferentiableAt.fun_sum fun r _ => ?_
        exact ((he'' r).differentiableAt ((hW''o r).mem_nhds (mem_iInter.1 hzV.2 r))).mul
          ((hρh r k).differentiableAt (hΩ.mem_nhds hzV.1.2))
      exact (hd.congr_of_eventuallyEq (eventually_of_mem hN fun y hy => by
        simp only [hNg y hy])).differentiableWithinAt
  · obtain ⟨N, hN, hside⟩ := hloc z hz
    have hzN := mem_of_mem_nhds hN
    rcases hside with ⟨hNV, hNg⟩ | ⟨hNV, hNg⟩
    · have hzV := hNV hzN
      show f j z = ∑ k, g z k * σ k j z
      rw [hNg z hzN, hf' z hzV.1.1 j]
      simp only [g₁, sub_mul, Finset.sum_sub_distrib, Finset.sum_mul]
      rw [Finset.sum_comm (f := fun k r => e' r z * ρ r k z * σ k j z)]
      have : ∀ r, ∑ k, e' r z * ρ r k z * σ k j z = 0 := fun r => by
        simp only [mul_assoc, ← Finset.mul_sum, hρ z hzV.1.2 r j, mul_zero]
      simp [this]
    · have hzV := hNV hzN
      show f j z = ∑ k, g z k * σ k j z
      rw [hNg z hzN, hf'' z hzV.1.1 j]
      simp only [g₂, sub_mul, Finset.sum_sub_distrib, Finset.sum_mul]
      rw [Finset.sum_comm (f := fun k r => e'' r z * ρ r k z * σ k j z)]
      have : ∀ r, ∑ k, e'' r z * ρ r k z * σ k j z = 0 := fun r => by
        simp only [mul_assoc, ← Finset.mul_sum, hρ z hzV.1.2 r j, mul_zero]
      simp [this]

end

end Hironaka.Analytic.GAGA.Core.TheoremA
