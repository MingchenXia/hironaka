import Hironaka.Analytic.Unibranch.HironakaG10FirstOrderNormalAlgebraEquiv
import Mathlib.LinearAlgebra.Matrix.ToLin

/-! Imposing linear matrix relations in a trivial square-zero extension. -/
set_option autoImplicit false
set_option maxHeartbeats 1000000
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
open Set
namespace Hironaka.Analytic.Unibranch.HironakaG10SquareZeroMatrixQuotient
noncomputable section
variable {B : Type*} [CommRing B] {a b : ℕ}

/-- The ideal of the literal matrix columns in the square-zero extension. -/
def matrixColumnIdeal (F : Matrix (Fin a) (Fin b) B) : Ideal (TrivSqZeroExt B (Fin a → B)) :=
  Ideal.span (Set.range fun j => TrivSqZeroExt.inr (F.col j))

/-- Quotienting the square-zero linear part by the matrix image. -/
def matrixQuotientMap (F : Matrix (Fin a) (Fin b) B) :
    TrivSqZeroExt B (Fin a → B) →ₐ[B] TrivSqZeroExt B ((Fin a → B) ⧸ LinearMap.range F.mulVecLin) :=
  TrivSqZeroExt.map (LinearMap.range F.mulVecLin).mkQ

theorem matrixQuotientMap_surjective (F : Matrix (Fin a) (Fin b) B) :
    Function.Surjective (matrixQuotientMap F) := by
  intro y
  obtain ⟨v,hv⟩ := Submodule.mkQ_surjective (LinearMap.range F.mulVecLin) y.snd
  refine ⟨(y.fst,v), ?_⟩
  apply TrivSqZeroExt.ext
  · change (TrivSqZeroExt.map (LinearMap.range F.mulVecLin).mkQ (y.fst,v)).fst = y.fst
    rw [TrivSqZeroExt.fst_map]
    rfl
  · change (TrivSqZeroExt.map (LinearMap.range F.mulVecLin).mkQ (y.fst,v)).snd = y.snd
    rw [TrivSqZeroExt.snd_map]
    exact hv

/-- The kernel is exactly the ideal generated by the original matrix columns. -/
theorem matrixQuotientMap_ker (F : Matrix (Fin a) (Fin b) B) :
    RingHom.ker (matrixQuotientMap F).toRingHom = matrixColumnIdeal F := by
  classical
  let I := matrixColumnIdeal F
  let L := LinearMap.range F.mulVecLin
  have hspan : I ≤ RingHom.ker (matrixQuotientMap F).toRingHom := by
    apply Ideal.span_le.mpr
    rintro _ ⟨j,rfl⟩
    change matrixQuotientMap F (TrivSqZeroExt.inr (F.col j)) = 0
    rw [matrixQuotientMap,TrivSqZeroExt.map_inr]
    have hj : F.col j ∈ L := by
      change F.col j ∈ LinearMap.range F.mulVecLin
      rw [Matrix.range_mulVecLin]
      exact Submodule.subset_span ⟨j,rfl⟩
    have hq : L.mkQ (F.col j) = 0 := (Submodule.Quotient.mk_eq_zero L).mpr hj
    rw [hq, TrivSqZeroExt.inr_zero]
  have hlinear : ∀ v ∈ L, TrivSqZeroExt.inr v ∈ I := by
    let P : Submodule B (Fin a → B) := (I.restrictScalars B).comap (TrivSqZeroExt.inrHom B (Fin a → B))
    have hcols : Set.range F.col ⊆ P := by
      rintro _ ⟨j,rfl⟩
      change TrivSqZeroExt.inr (F.col j) ∈ I
      exact Ideal.subset_span ⟨j,rfl⟩
    have hLP : L ≤ P := by
      change LinearMap.range F.mulVecLin ≤ P
      rw [Matrix.range_mulVecLin]
      exact Submodule.span_le.mpr hcols
    intro v hv
    exact hLP hv
  apply le_antisymm
  · intro x hx
    have hx0 : matrixQuotientMap F x = 0 := hx
    have hfst : x.fst = 0 := by
      have h := congrArg TrivSqZeroExt.fst hx0
      simpa [matrixQuotientMap] using h
    have hsnd : x.snd ∈ L := by
      have h := congrArg TrivSqZeroExt.snd hx0
      have hq : L.mkQ x.snd = 0 := by simpa [matrixQuotientMap,L] using h
      exact (Submodule.Quotient.mk_eq_zero L).mp hq
    have hx' : x = TrivSqZeroExt.inr x.snd := by
      apply TrivSqZeroExt.ext <;> simp [hfst]
    rw [hx']
    exact hlinear x.snd hsnd
  · exact hspan
end
end Hironaka.Analytic.Unibranch.HironakaG10SquareZeroMatrixQuotient
