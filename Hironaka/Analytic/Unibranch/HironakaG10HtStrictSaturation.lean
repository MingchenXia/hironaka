import Hironaka.Analytic.Unibranch.HironakaG10SbTorsionSaturation
import Hironaka.Resolution.HironakaG10ChowArtinReesCentre
import Hironaka.Resolution.HironakaG10StrictIdealGenerator

/-!
# N5.a — strict generation passes from an ambient blowup chart to a strict-transform quotient

Lane G10HT, run 0081, sub-item N5.a of `G10HT/hT-route-decision.md` (towards N5 of
`G10SB/G10-02-10b-native-strict-flat-route.md`).  Hironaka 1975, Lemma 3.2, printed p. 532: "It is known that the
ideal of the strict transform `Z₁` in `𝒪_{Y₁,t}` … is generated by those elements `G^{-k} h` … `h ∈ I_Z ∩ I_D^k`",
i.e. the algebraic strict ideal (`HironakaG10ChowArtinReesCentre.strictIdeal`) is the whole `G`-saturation of the
total transform ((4.2.2), p. 534).

Setting: an ambient chart `Φ : O →+* O'` (e.g. `actualAnalyticBlowupPullback A e b` on `HolGerm`), a centre ideal `W`
of `O`, the exceptional equation `e ∈ O'`, and a closed subspace `V(P)` of the ambient (e.g. the graph `Γ` of the
centre's generators, whose geometric strict transform has the ideal `(Φ(P) : e^∞)`).  The strict transform of `V(P)` is
`O' ⧸ (Φ(P) : e^∞)`, with chart map `quotChartMap Φ P e : O ⧸ P → O' ⧸ (Φ(P) : e^∞)`.

* `strictIdeal_le_powerSat` — the strict ideal always lies in the saturation of the total transform;
* `map_strictIdeal_le`, `map_powerSat_le` — functoriality along commutative squares;
* **`quot_strictIdeal_eq_powerSat`** — if the ambient chart has strict generation for an ideal `Ĩ ⊇ P`
  (`powerSat (map Φ Ĩ) e ≤ strictIdeal Φ Ĩ W e`), then on the strict transform `O' ⧸ (Φ(P) : e^∞)` the strict ideal of
  `Ĩ ⧸ P` (centre `W ⧸ P`, equation `e`) is the whole saturation of its total transform.  No Artin–Rees, no
  regularity of `e`;
* **`strictIdeal_eq_powerSat_of_chart`** — the same for any ring map `φ : A → R` isomorphic to the chart map
  (rings `A ≅ O ⧸ P`, `R ≅ O' ⧸ (Φ(P) : e^∞)`), with any regular generator `G` of the pulled centre: the form consumed
  by the native N5 (`𝒪_{X,x} → 𝒪_{X',x'}` read on a graph chart of the blowup = N5.b).

Pure commutative algebra; no named input.
-/

set_option autoImplicit false

namespace Hironaka.Analytic.Unibranch.HironakaG10HtStrictSaturation

open Hironaka.HironakaG10ChowArtinReesCentre
  Hironaka.HironakaG10StrictIdealGenerator
  Hironaka.Analytic.Unibranch.HironakaG10SbTorsionSaturation

section General

variable {A R : Type*} [CommRing A] [CommRing R]

/-- The algebraic strict ideal lies in the `G`-saturation of the total transform. -/
theorem strictIdeal_le_powerSat (φ : A →+* R) (I D : Ideal A) (G : R) :
    strictIdeal φ I D G ≤ powerSat (Ideal.map φ I) G := by
  refine Ideal.span_le.mpr ?_
  rintro h' ⟨k, h, hh, hφ⟩
  refine mem_powerSat.mpr ⟨k, ?_⟩
  rw [← hφ]
  exact Ideal.mem_map_of_mem φ hh.1

/-- **Functoriality of the algebraic strict ideal** along a commutative square `ρ ∘ φ = φ₂ ∘ α`. -/
theorem map_strictIdeal_le {A₂ R₂ : Type*} [CommRing A₂] [CommRing R₂]
    (φ : A →+* R) (φ₂ : A₂ →+* R₂) (α : A →+* A₂) (ρ : R →+* R₂)
    (hsq : ∀ a, ρ (φ a) = φ₂ (α a)) (I D : Ideal A) (G : R) :
    Ideal.map ρ (strictIdeal φ I D G) ≤
      strictIdeal φ₂ (Ideal.map α I) (Ideal.map α D) (ρ G) := by
  rw [strictIdeal, Ideal.map_span]
  refine Ideal.span_le.mpr ?_
  rintro _ ⟨h', ⟨k, h, hh, hφ⟩, rfl⟩
  refine Ideal.subset_span ⟨k, α h, ⟨Ideal.mem_map_of_mem α hh.1, ?_⟩, ?_⟩
  · rw [← Ideal.map_pow]
    exact Ideal.mem_map_of_mem α hh.2
  · rw [← hsq, hφ, map_mul, map_pow]

/-- Functoriality of the saturation. -/
theorem map_powerSat_le {R₂ : Type*} [CommRing R₂] (ρ : R →+* R₂) (K : Ideal R) (h : R) :
    Ideal.map ρ (powerSat K h) ≤ powerSat (Ideal.map ρ K) (ρ h) := by
  rw [Ideal.map_le_iff_le_comap]
  intro a ha
  obtain ⟨m, hm⟩ := mem_powerSat.mp ha
  refine mem_powerSat.mpr ⟨m, ?_⟩
  rw [← map_pow, ← map_mul]
  exact Ideal.mem_map_of_mem ρ hm

/-- The saturation does not see a unit factor of the equation. -/
theorem powerSat_unit_mul (K : Ideal R) (h : R) (u : Rˣ) :
    powerSat K ((u : R) * h) = powerSat K h := by
  ext a
  rw [mem_powerSat, mem_powerSat]
  refine exists_congr fun m => ?_
  constructor
  · intro hm
    have := K.mul_mem_left ((↑(u⁻¹) : R) ^ m) hm
    rwa [mul_pow, ← mul_assoc, ← mul_assoc, ← mul_pow, Units.inv_mul, one_pow, one_mul] at this
  · intro hm
    rw [mul_pow, mul_assoc]
    exact K.mul_mem_left _ hm

/-- Two regular generators of the same principal ideal have the same saturations. -/
theorem powerSat_eq_of_regular_span_eq (K : Ideal R) {G H : R} (hG : IsRegular G)
    (hspan : Ideal.span {G} = Ideal.span {H}) : powerSat K G = powerSat K H := by
  obtain ⟨u, hu⟩ := exists_unit_mul_of_regular_span_eq hG hspan
  rw [hu, powerSat_unit_mul]

end General

section Quotient

variable {O O' : Type*} [CommRing O] [CommRing O']

/-- The chart map of the strict transform of `V(P)`: `O ⧸ P → O' ⧸ (Φ(P) : e^∞)`. -/
def quotChartMap (Φ : O →+* O') (P : Ideal O) (e : O') :
    O ⧸ P →+* O' ⧸ powerSat (Ideal.map Φ P) e :=
  Ideal.Quotient.lift P ((Ideal.Quotient.mk _).comp Φ) fun a ha => by
    rw [RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
    exact le_powerSat _ _ (Ideal.mem_map_of_mem Φ ha)

theorem quotChartMap_mk (Φ : O →+* O') (P : Ideal O) (e : O') (a : O) :
    quotChartMap Φ P e (Ideal.Quotient.mk P a) = Ideal.Quotient.mk _ (Φ a) :=
  Ideal.Quotient.lift_mk _ _ _

theorem quotChartMap_comp_mk (Φ : O →+* O') (P : Ideal O) (e : O') :
    (quotChartMap Φ P e).comp (Ideal.Quotient.mk P) = (Ideal.Quotient.mk _).comp Φ :=
  Ideal.Quotient.lift_comp_mk _ _ _

/-- The total transform of `Ĩ ⧸ P` on the strict transform is the image of the ambient total transform. -/
theorem map_quotChartMap (Φ : O →+* O') (P I : Ideal O) (e : O') :
    Ideal.map (quotChartMap Φ P e) (Ideal.map (Ideal.Quotient.mk P) I) =
      Ideal.map (Ideal.Quotient.mk (powerSat (Ideal.map Φ P) e)) (Ideal.map Φ I) := by
  rw [Ideal.map_map, Ideal.map_map, quotChartMap_comp_mk]

/-- **Saturation lifts to the ambient chart.**  An element of the strict transform whose `e`-multiple lies in the
total transform of `Ĩ ⧸ P` (`P ≤ Ĩ`) lifts to an element of the ambient saturation of the total transform of `Ĩ`. -/
theorem powerSat_quot_le_map (Φ : O →+* O') (P I : Ideal O) (e : O') (hPI : P ≤ I) :
    powerSat (Ideal.map (quotChartMap Φ P e) (Ideal.map (Ideal.Quotient.mk P) I))
        (Ideal.Quotient.mk (powerSat (Ideal.map Φ P) e) e) ≤
      Ideal.map (Ideal.Quotient.mk (powerSat (Ideal.map Φ P) e)) (powerSat (Ideal.map Φ I) e) := by
  intro a ha
  obtain ⟨m, hm⟩ := mem_powerSat.mp ha
  obtain ⟨a', rfl⟩ := Ideal.Quotient.mk_surjective a
  rw [map_quotChartMap, ← map_pow, ← map_mul] at hm
  obtain ⟨j, hj, hjeq⟩ :=
    (Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective).mp hm
  have hK : e ^ m * a' - j ∈ powerSat (Ideal.map Φ P) e :=
    Ideal.Quotient.eq.mp hjeq.symm
  obtain ⟨m', hm'⟩ := mem_powerSat.mp hK
  refine Ideal.mem_map_of_mem _ (mem_powerSat.mpr ⟨m' + m, ?_⟩)
  have h1 : e ^ m' * (e ^ m * a' - j) ∈ Ideal.map Φ I := Ideal.map_mono hPI hm'
  have h2 : e ^ m' * j ∈ Ideal.map Φ I := Ideal.mul_mem_left _ _ hj
  have heq : e ^ (m' + m) * a' = e ^ m' * (e ^ m * a' - j) + e ^ m' * j := by ring
  rw [heq]
  exact Ideal.add_mem _ h1 h2

/-- **N5.a.**  Strict generation in the ambient chart for `Ĩ ⊇ P` gives strict generation on the strict transform
`O' ⧸ (Φ(P) : e^∞)` of `V(P)`, for the image of `Ĩ`, with centre the image of `W` and equation `e`. -/
theorem quot_powerSat_le_strictIdeal (Φ : O →+* O') (P I W : Ideal O) (e : O') (hPI : P ≤ I)
    (hSG : powerSat (Ideal.map Φ I) e ≤ strictIdeal Φ I W e) :
    powerSat (Ideal.map (quotChartMap Φ P e) (Ideal.map (Ideal.Quotient.mk P) I))
        (Ideal.Quotient.mk (powerSat (Ideal.map Φ P) e) e) ≤
      strictIdeal (quotChartMap Φ P e) (Ideal.map (Ideal.Quotient.mk P) I)
        (Ideal.map (Ideal.Quotient.mk P) W) (Ideal.Quotient.mk (powerSat (Ideal.map Φ P) e) e) :=
  (powerSat_quot_le_map Φ P I e hPI).trans
    ((Ideal.map_mono hSG).trans
      (map_strictIdeal_le Φ (quotChartMap Φ P e) (Ideal.Quotient.mk P) _
        (fun a => (quotChartMap_mk Φ P e a).symm) I W e))

/-- **N5.a, equality form.** -/
theorem quot_strictIdeal_eq_powerSat (Φ : O →+* O') (P I W : Ideal O) (e : O') (hPI : P ≤ I)
    (hSG : powerSat (Ideal.map Φ I) e ≤ strictIdeal Φ I W e) :
    strictIdeal (quotChartMap Φ P e) (Ideal.map (Ideal.Quotient.mk P) I)
        (Ideal.map (Ideal.Quotient.mk P) W) (Ideal.Quotient.mk (powerSat (Ideal.map Φ P) e) e) =
      powerSat (Ideal.map (quotChartMap Φ P e) (Ideal.map (Ideal.Quotient.mk P) I))
        (Ideal.Quotient.mk (powerSat (Ideal.map Φ P) e) e) :=
  le_antisymm (strictIdeal_le_powerSat _ _ _ _) (quot_powerSat_le_strictIdeal Φ P I W e hPI hSG)

/-- **N5.a, transported to any ring map isomorphic to the chart map**, with any regular generator `G` of the same
principal ideal as the equation: the form consumed by the native N5 (`σ^♯ : 𝒪_{X,x} → 𝒪_{X',x'}` read on a graph
chart of the blowup, sub-item N5.b). -/
theorem strictIdeal_eq_powerSat_of_chart {A R : Type*} [CommRing A] [CommRing R] (φ : A →+* R)
    (Φ : O →+* O') (P Ĩ W : Ideal O) (e : O') (hPI : P ≤ Ĩ)
    (hSG : powerSat (Ideal.map Φ Ĩ) e ≤ strictIdeal Φ Ĩ W e)
    (α : A ≃+* O ⧸ P) (ρ : R ≃+* O' ⧸ powerSat (Ideal.map Φ P) e)
    (hsq : ∀ a, ρ (φ a) = quotChartMap Φ P e (α a))
    (I D : Ideal A) (hI : Ideal.map (α : A →+* O ⧸ P) I = Ideal.map (Ideal.Quotient.mk P) Ĩ)
    (hD : Ideal.map (α : A →+* O ⧸ P) D = Ideal.map (Ideal.Quotient.mk P) W)
    (G : R) (hG : IsRegular G)
    (hGe : Ideal.span {ρ G} = Ideal.span {Ideal.Quotient.mk (powerSat (Ideal.map Φ P) e) e}) :
    strictIdeal φ I D G = powerSat (Ideal.map φ I) G := by
  refine le_antisymm (strictIdeal_le_powerSat φ I D G) ?_
  have hρG : IsRegular (ρ G) := by
    refine ⟨fun x y hxy => ?_, fun x y hxy => ?_⟩
    · obtain ⟨x, rfl⟩ := ρ.surjective x
      obtain ⟨y, rfl⟩ := ρ.surjective y
      dsimp only at hxy
      rw [← map_mul, ← map_mul] at hxy
      exact congrArg ρ (hG.left (ρ.injective hxy))
    · obtain ⟨x, rfl⟩ := ρ.surjective x
      obtain ⟨y, rfl⟩ := ρ.surjective y
      dsimp only at hxy
      rw [← map_mul, ← map_mul] at hxy
      exact congrArg ρ (hG.right (ρ.injective hxy))
  -- the square read backwards
  have hsq' : ∀ b, ρ.symm (quotChartMap Φ P e b) = φ (α.symm b) := by
    intro b
    apply ρ.injective
    rw [RingEquiv.apply_symm_apply, hsq, RingEquiv.apply_symm_apply]
  -- the total transform of `I` read on the chart
  have htot : Ideal.map (ρ : R →+* O' ⧸ powerSat (Ideal.map Φ P) e) (Ideal.map φ I) =
      Ideal.map (quotChartMap Φ P e) (Ideal.map (Ideal.Quotient.mk P) Ĩ) := by
    rw [← hI, Ideal.map_map, Ideal.map_map]
    congr 1
    ext a
    exact hsq a
  -- chart strict generation, in the chart equation
  have hchart := quot_powerSat_le_strictIdeal Φ P Ĩ W e hPI hSG
  rw [← powerSat_eq_of_regular_span_eq _ hρG hGe, ← strictIdeal_eq_of_regular_span_eq _ _ _ hρG hGe,
    ← hI, ← hD] at hchart
  -- pull back along `ρ`
  intro a ha
  have h1 : ρ a ∈ powerSat (Ideal.map (ρ : R →+* O' ⧸ powerSat (Ideal.map Φ P) e) (Ideal.map φ I)) (ρ G) :=
    map_powerSat_le (ρ : R →+* O' ⧸ powerSat (Ideal.map Φ P) e) _ G (Ideal.mem_map_of_mem _ ha)
  rw [htot, ← hI] at h1
  have h2 := map_strictIdeal_le (quotChartMap Φ P e) φ (α.symm : O ⧸ P →+* A)
    (ρ.symm : O' ⧸ powerSat (Ideal.map Φ P) e →+* R) hsq' (Ideal.map (α : A →+* O ⧸ P) I)
    (Ideal.map (α : A →+* O ⧸ P) D) (ρ G)
    (Ideal.mem_map_of_mem _ (hchart h1))
  have hIα : Ideal.map (α.symm : O ⧸ P →+* A) (Ideal.map (α : A →+* O ⧸ P) I) = I := by
    rw [Ideal.map_map]
    convert Ideal.map_id I
    ext x
    exact α.symm_apply_apply x
  have hDα : Ideal.map (α.symm : O ⧸ P →+* A) (Ideal.map (α : A →+* O ⧸ P) D) = D := by
    rw [Ideal.map_map]
    convert Ideal.map_id D
    ext x
    exact α.symm_apply_apply x
  simp only [RingEquiv.coe_toRingHom, RingEquiv.symm_apply_apply] at h2
  rwa [hIα, hDα] at h2

end Quotient

end Hironaka.Analytic.Unibranch.HironakaG10HtStrictSaturation
