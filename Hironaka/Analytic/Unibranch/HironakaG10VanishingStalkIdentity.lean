import Hironaka.Analytic.Unibranch.HironakaG10RelativeNonflatStrata
import Hironaka.Resolution.HironakaIntrinsicReducedCentreOpenPullback

/-! # The relative-stratum vanishing ideal is the native ideal stalk -/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
open Set TopologicalSpace CategoryTheory Opposite AlgebraicGeometry

namespace Hironaka.Analytic.Unibranch.HironakaG10VanishingStalkIdentity

open Hironaka HironakaSingularModuleSheafStalk
  HironakaIntrinsicReducedCentreIdealSheaf HironakaIntrinsicReducedCentreIdealModel HironakaIntrinsicReducedCentreOpenPullback
open Hironaka.Analytic.Unibranch.HironakaG10RelativeNonflatStrata

/-- The ideal generated by actual section germs vanishing on `C` is exactly
  the whole stalk image of the native reduced-centre ideal module. -/
theorem vanishingIdealAt_eq_intrinsicCentreStalkRange (X : LocallyRingedSpace.{0})
    (C : Set X) (x : X) : vanishingIdealAt X C x = intrinsicCentreStalkRange X C x := by
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro g ⟨U,hxU,t,ht,hvan⟩
    let s : intrinsicReducedCentreSectionIdeal X C U := ⟨t,hvan⟩
    change g ∈ LinearMap.range (intrinsicReducedCentreStalkInclusion X C x)
    refine ⟨TopCat.Presheaf.germ (intrinsicReducedCentreIdealModule X C).val.presheaf U x hxU s, ?_⟩
    rw [intrinsicReducedCentreStalkInclusion_germ]
    exact ht
  · rintro g ⟨m,rfl⟩
    obtain ⟨U,hxU,s,rfl⟩ := TopCat.Presheaf.exists_germ_eq
      (intrinsicReducedCentreIdealModule X C).val.presheaf m
    rw [intrinsicReducedCentreStalkInclusion_germ]
    exact Ideal.subset_span ⟨U,hxU,s.val,rfl,s.property⟩

end Hironaka.Analytic.Unibranch.HironakaG10VanishingStalkIdentity
