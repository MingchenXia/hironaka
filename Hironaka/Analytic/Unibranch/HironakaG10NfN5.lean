  Hironaka.Analytic.Unibranch.HironakaG10SbTorsionSaturation Hironaka.Analytic.Unibranch.HironakaG10ChowFlatteningDriver
  Hironaka.Analytic.Unibranch.HironakaG10ChowCentreMachine Hironaka.Analytic.Unibranch.HironakaG10RdPermRun
  Hironaka.Analytic.Unibranch.CompatibleCanonicalIdealBlowupSquareCharts
  Hironaka.Analytic.Unibranch.CompatibleCanonicalIdealBlowupNormalSections
  Hironaka.Analytic.Unibranch.CompatibleCanonicalIdealBlowupExplicitProductCharts
  Hironaka.Analytic.Unibranch.CompatibleCanonicalIdealBlowupPivotOpenRanges
  Hironaka.Analytic.Unibranch.HironakaG10NfPresentation Hironaka.Analytic.Unibranch.HironakaG10NfStalkSquare
  Hironaka.Analytic.Unibranch.HironakaG10NfTargetChart Hironaka.Analytic.Unibranch.HironakaG10NfTargetPresentation
  Hironaka.Analytic.Unibranch.HironakaG10SbBlowupComparison

/-! ### Transfer along ring isomorphisms and isomorphisms over the base -/

/-- A presentation stays one after composing with a ring isomorphism of the target. -/
theorem presentation_comp_equiv {A R R₂ : Type*} [CommRing A] [CommRing R] [CommRing R₂]
    {φ : A →+* R} {D : Ideal A} (h : GraphChartPresentation φ D) (e : R ≃+* R₂) :
    GraphChartPresentation (e.toRingHom.comp φ) D := by
  obtain ⟨d, r, hr, b, j, g, IX, α, ρ, hsq, hD⟩ := h
  refine ⟨d, r, hr, b, j, g, IX, α, e.symm.trans ρ, ?_, hD⟩
  intro a
  rw [RingEquiv.trans_apply, RingHom.comp_apply]
  change ρ (e.symm (e (φ a))) = _
  rw [RingEquiv.symm_apply_apply, hsq]

/-- **Transfer along an isomorphism over the base** (e.g. the native ≅ geometric blowup, BC3). -/
theorem presentation_of_iso {X₁ X₂ X : SourceReducedComplexSpace} (ι : X₁ ≅ X₂) (σ₂ : X₂ ⟶ X) (σ₁ : X₁ ⟶ X)
    (hσ : ι.hom ≫ σ₂ = σ₁) (D : ∀ x : X.obj.left, Ideal (X.obj.left.presheaf.stalk x)) (x₁ : X₁.obj.left)
    (h : GraphChartPresentation (σ₂.hom.left.stalkMap (ι.hom.hom.left.base x₁)).hom
      (D (σ₂.hom.left.base (ι.hom.hom.left.base x₁)))) :
    GraphChartPresentation (σ₁.hom.left.stalkMap x₁).hom (D (σ₁.hom.left.base x₁)) := by
  subst hσ
  have hiso : IsIso ι.hom.hom.left :=
    ⟨⟨ι.inv.hom.left, congrArg (fun f => f.hom.left) ι.hom_inv_id,
      congrArg (fun f => f.hom.left) ι.inv_hom_id⟩⟩
  have : LocallyRingedSpace.IsOpenImmersion ι.hom.hom.left := inferInstance
  have h2 := presentation_comp_equiv h (oiStalkEquiv ι.hom.hom.left x₁)
  have hc : ((ι.hom ≫ σ₂).hom.left.stalkMap x₁).hom =
      (oiStalkEquiv ι.hom.hom.left x₁).toRingHom.comp (σ₂.hom.left.stalkMap (ι.hom.hom.left.base x₁)).hom :=
    congrArg CommRingCat.Hom.hom (LocallyRingedSpace.stalkMap_comp ι.hom.hom.left σ₂.hom.left x₁)
  rw [hc]
  exact h2

/-! ### The geometric blowup -/

variable {X : SourceReducedComplexSpace}
  (B : SheafOfModules.{0} (forgetRing X.obj.left.toSheafedSpace.sheaf))
  (b : B ⟶ SheafOfModules.unit (forgetRing X.obj.left.toSheafedSpace.sheaf)) [B.IsFiniteType]

/-- **N5.b on the geometric blowup**: over the centre the native stalk map of the projection is a graph-chart
presentation. -/
theorem presentation_geometric (y : (OriginalFiniteIdealGeometricBlowup.sourceObject B b).obj.left)
    (hy : centre B b ((OriginalFiniteIdealGeometricBlowup.projectionMorphism B b).hom.left.base y) ≠ ⊤) :
    GraphChartPresentation (((OriginalFiniteIdealGeometricBlowup.projectionMorphism B b).hom.left.stalkMap y).hom)
      (centre B b ((OriginalFiniteIdealGeometricBlowup.projectionMorphism B b).hom.left.base y)) := by
  obtain ⟨t, c, g, d, ⟨E⟩⟩ := exists_same_canonical_explicit_product_models B b (𝟙 X)
    ((OriginalFiniteIdealGeometricBlowup.projectionMorphism B b).hom.left.base y) y rfl
  obtain ⟨P⟩ := pivot_open_ranges_of_models B b (𝟙 X) _ t c g d E
  have hy' : y ∈ d.target.targetOpen.1 := d.target.target_mem
  rw [← P.target_cover] at hy'
  obtain ⟨j, hj⟩ := Set.mem_iUnion.mp hy'
  rw [← P.chart_ranges.target_range j] at hj
  obtain ⟨p, hp⟩ := hj
  have : LocallyRingedSpace.IsOpenImmersion (targetCanonicalMap B b t E.target).hom.left :=
    E.target_maps.open_immersion
  have hp' : (chartMap B b t E.target j).base p = y := hp
  have hne : centre B b ((OriginalFiniteIdealGeometricBlowup.projectionMorphism B b).hom.left.base
      ((chartMap B b t E.target j).base p)) ≠ ⊤ := by
    rw [hp']
    exact hy
  have key := presentation_at B b t E.target j p d.target E.target_maps E.target_normals hne
  rw [hp'] at key
  exact key

/-! ### Every step of the flattening algorithm -/

/-- **N5 at every point of every blowup step.** -/
theorem n5Holds_step (s : Stage) (c : AdmissibleCentre s.f) (x' : (nextWith s c).X.obj.left) :
    N5Holds ((stepσ s c).hom.left.stalkMap x').hom (centreIdeal c ((stepσ s c).hom.left.base x')) := by
  have : c.B.IsFiniteType := c.finiteType
  by_cases hD : centreIdeal c ((stepσ s c).hom.left.base x') = ⊤
  · exact n5Holds_of_eq_top _ hD
  · apply n5Holds_of_presentation
    have hpt : (OriginalFiniteIdealGeometricBlowup.projectionMorphism c.B c.b).hom.left.base
        ((blowupIso c.B c.b c.dense).hom.hom.left.base x') = (stepσ s c).hom.left.base x' :=
      congrArg (fun f => f.hom.left.base x') (blowupIso_hom_comp c.B c.b c.dense)
    have hy : centre c.B c.b ((OriginalFiniteIdealGeometricBlowup.projectionMorphism c.B c.b).hom.left.base
        ((blowupIso c.B c.b c.dense).hom.hom.left.base x')) ≠ ⊤ := by
      rw [hpt]
      exact hD
    exact presentation_of_iso (blowupIso c.B c.b c.dense)
      (OriginalFiniteIdealGeometricBlowup.projectionMorphism c.B c.b) (stepσ s c)
      (blowupIso_hom_comp c.B c.b c.dense) (centre c.B c.b) x'
      (presentation_geometric c.B c.b _ hy)

/-- **N5 (Hironaka 1975, p. 532), native form of `G10HT/STATUS.md`**: at every point `x'` of every blowup step, for
every ideal `I` and every regular generator `G` of the pulled centre, the algebraic strict ideal is the whole
`G`-saturation of the total transform. -/
theorem hN5 : ∀ (s : Stage) (c : AdmissibleCentre s.f) (x' : (nextWith s c).X.obj.left)
    (I : Ideal (s.X.obj.left.presheaf.stalk ((stepσ s c).hom.left.base x')))
    (G : (nextWith s c).X.obj.left.presheaf.stalk x'), IsRegular G →
    Ideal.map ((stepσ s c).hom.left.stalkMap x').hom (centreIdeal c ((stepσ s c).hom.left.base x')) =
      Ideal.span {G} →
    strictIdeal ((stepσ s c).hom.left.stalkMap x').hom I (centreIdeal c ((stepσ s c).hom.left.base x')) G =
      powerSat (Ideal.map ((stepσ s c).hom.left.stalkMap x').hom I) G :=
  fun s c x' I G hG hGD => n5Holds_step s c x' I G hG hGD

end

end Hironaka.Analytic.Unibranch.HironakaG10NfN5
