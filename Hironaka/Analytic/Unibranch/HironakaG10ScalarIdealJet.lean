import Hironaka.Analytic.Unibranch.HironakaG10AllBanachJetsSeparate
import Hironaka.Analytic.Unibranch.HironakaG10AllCoefficientOperatorsSeparate

/-! Scalar germs of actual Banach-valued families detected by all quotient jets. -/
set_option autoImplicit false
open Filter
open scoped Topology TensorProduct
namespace Hironaka.Analytic.Unibranch.HironakaG10ScalarIdealJet
open Hironaka Hironaka
  HolGerm HironakaG10ArtinianBaseChange HironakaG10ArtinianFlatQuotient
  HironakaHolomorphicPointJets
  HironakaActualWholeIdealJetDetection
  Hironaka.Analytic.Unibranch.HironakaG10BanachParameterJet
  Hironaka.Analytic.Unibranch.HironakaG10BanachJetScalarization
  Hironaka.Analytic.Unibranch.HironakaG10CoefficientOperatorFaithful
  Hironaka.Analytic.Unibranch.HironakaG10CoefficientTensorOperator
noncomputable section

/-- Vanishing of every actual finite parameter jet modulo the given whole
ideal forces every scalarized original holomorphic germ to lie in that ideal. -/
theorem scalar_germ_mem_of_all_quotient_banachJets_zero
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E] [CompleteSpace E]
    (d : ℕ) (I : Ideal (HolGerm (ComplexModel d))) (f : ComplexModel d → E)
    (hf : ∀ᶠ z in 𝓝 (0 : ComplexModel d), DifferentiableAt ℂ f z)
    (hjets : ∀ q : ℕ, banachJet d q (parameterQuotientMap d q I) f = 0)
    (L : E →L[ℂ] ℂ) :
    HolGerm.mk (L ∘ f) (hf.mono fun _ h => L.differentiableAt.comp _ h) ∈ I := by
  let g : HolGerm (ComplexModel d) :=
    HolGerm.mk (L ∘ f) (hf.mono fun _ h => L.differentiableAt.comp _ h)
  apply (mem_original_ideal_iff_all_positive_thickenings I g).mpr
  intro q
  have hq := scalarize_banachJet d q (parameterQuotientMap d q I)
    (parameterQuotientMap_kills d q I) f hf L
  rw [hjets q] at hq
  have hmap : (parameterQuotientMap d q I) g = 0 := by simpa [g] using hq.symm
  exact Ideal.Quotient.eq_zero_iff_mem.mp hmap

/-- Vanishing of every actual finite-coefficient action forces every literal
scalar matrix coefficient of the original operator germ into the whole ideal. -/
theorem scalar_operator_germ_mem_of_all_coefficient_actions_zero
    {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    [NormedAddCommGroup F] [NormedSpace ℂ F] [CompleteSpace F]
    (d : ℕ) (I : Ideal (HolGerm (ComplexModel d)))
    (T : ComplexModel d → (E →L[ℂ] F))
    (hT : ∀ᶠ x in 𝓝 (0 : ComplexModel d), DifferentiableAt ℂ T x)
    (hcoeff : ∀ q : ℕ,
      let Q := HolGerm (ComplexModel d) ⧸ truncatedParameterIdeal d q I
      letI : FiniteDimensional ℂ Q := finiteDimensional_quotient_sup_maximalIdeal_pow d (q+1) I
      let basis := Module.finBasis ℂ Q
      coefficientTensorOperator (E := E) (F := F) basis
        (banachJet d q (parameterQuotientMap d q I) T) = 0)
    (v : E) (ell : F →L[ℂ] ℂ) :
    let L := ell.comp (ContinuousLinearMap.apply ℂ F v)
    HolGerm.mk (L ∘ T) (hT.mono fun _ h => L.differentiableAt.comp _ h) ∈ I := by
  apply scalar_germ_mem_of_all_quotient_banachJets_zero d I T hT ?_
  intro q
  let Q := HolGerm (ComplexModel d) ⧸ truncatedParameterIdeal d q I
  let : FiniteDimensional ℂ Q := finiteDimensional_quotient_sup_maximalIdeal_pow d (q+1) I
  let basis := Module.finBasis ℂ Q
  apply (coefficientTensorOperator_injective (E := E) (F := F) basis)
  have h0 : coefficientTensorOperator (E := E) (F := F) basis (0 : Q ⊗[ℂ] (E →L[ℂ] F)) = 0 := by
    ext x i
    simp [coefficientTensorOperator]
  exact (hcoeff q).trans h0.symm

/-- The whole ideal generated by all literal scalar operator germs lies in
I when all actual finite-coefficient actions vanish modulo I's thickenings. -/
theorem scalar_operator_ideal_le_of_all_coefficient_actions_zero
    {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    [NormedAddCommGroup F] [NormedSpace ℂ F] [CompleteSpace F]
    (d : ℕ) (I : Ideal (HolGerm (ComplexModel d)))
    (T : ComplexModel d → (E →L[ℂ] F))
    (hT : ∀ᶠ x in 𝓝 (0 : ComplexModel d), DifferentiableAt ℂ T x)
    (hcoeff : ∀ q : ℕ,
      let Q := HolGerm (ComplexModel d) ⧸ truncatedParameterIdeal d q I
      letI : FiniteDimensional ℂ Q := finiteDimensional_quotient_sup_maximalIdeal_pow d (q+1) I
      let basis := Module.finBasis ℂ Q
      coefficientTensorOperator (E := E) (F := F) basis
        (banachJet d q (parameterQuotientMap d q I) T) = 0) :
    Ideal.span (Set.range fun p : E × (F →L[ℂ] ℂ) =>
      let L := p.2.comp (ContinuousLinearMap.apply ℂ F p.1)
      HolGerm.mk (L ∘ T) (hT.mono fun _ h => L.differentiableAt.comp _ h)) ≤ I := by
  apply Ideal.span_le.mpr
  rintro _ ⟨⟨v,ell⟩,rfl⟩
  exact scalar_operator_germ_mem_of_all_coefficient_actions_zero d I T hT hcoeff v ell

end
end Hironaka.Analytic.Unibranch.HironakaG10ScalarIdealJet
