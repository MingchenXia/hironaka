import Hironaka.Analytic.Unibranch.HironakaG10ChowCentreMachine

/-!
# The unit-ideal admissible centre: continuing a run after flatness (lane G10TM)

Plan item G10-04-06.c (re-split in `work/hironaka-run0081-20261117/G10TM/G10-04-01-hclosed-hfg-first-gap.md`
§7).  A centre machine (`HironakaG10ChowCentreMachine.CentreMachine`) must choose an admissible centre at
EVERY stage, and the round data consumed by the terminal theorem
(`HironakaG10ChowLeavingRounds.RoundData`) come from an infinite run.  At a flat stage the admissibility
condition `nonunitLocus ⊆ nonflatImage = ∅` forces a centre with empty nonunit locus; Hironaka's
sequences simply stop there (an empty sequence of blowups).  This module supplies that centre and the
persistence of flatness along every run:

* `unit_isFiniteType` — the unit sheaf of modules of a complex space is of finite type (one global
  generator);
* `range_stalkInclusionLinearMap_unit` — the stalk image of `𝟙 : 𝒪 ⟶ 𝒪` is the whole stalk;
* `unitCentre f` — the unit ideal `(𝒪, 𝟙)` as an admissible centre for ANY family `f` (dense unit locus,
  empty nonunit locus); `nonunitLocus_unitCentre`;
* `nonflatImage_nextWith_eq_empty` — a step from a flat stage (with any admissible centre) is flat;
* `machine_nonflatImage_eq_empty_of_le` — along the run of any centre machine, once the non-flat image is
  empty it stays empty.

No named `Prop` is introduced.
-/

set_option autoImplicit false

open Set TopologicalSpace CategoryTheory Limits AlgebraicGeometry
open scoped Topology

namespace Hironaka.Analytic.Unibranch.HironakaG10TmUnitCentre

open Hironaka HironakaSingularModuleSheafStalk
open Hironaka.Analytic.Unibranch
open Hironaka.Analytic.Unibranch.EmbeddedIdealBlowupNonunitLocus Hironaka.Analytic.Unibranch.HironakaG10ChowStrictFlatLocus
  Hironaka.Analytic.Unibranch.HironakaG10ChowFlatteningDriver Hironaka.Analytic.Unibranch.HironakaG10ChowCentreMachine
  Hironaka.Analytic.Unibranch.HironakaG10ChowStrictTransformCalculus

noncomputable section

/-- **The unit sheaf of modules is of finite type**: it is generated by the single global section `1`
(the split epimorphism `free PUnit ⟶ 𝒪` with section `ιFree`). -/
theorem unit_isFiniteType (X : SourceReducedComplexSpace) :
    (SheafOfModules.unit (forgetRing X.obj.left.toSheafedSpace.sheaf)).IsFiniteType := by
  let M := SheafOfModules.unit (forgetRing X.obj.left.toSheafedSpace.sheaf)
  let s : PUnit.{1} → M.sections := fun _ => M.unitHomEquiv (𝟙 M)
  have hsplit : SheafOfModules.ιFree PUnit.unit ≫ M.freeHomEquiv.symm s = 𝟙 M := by
    rw [← SheafOfModules.unitHomEquiv_symm_freeHomEquiv_apply, Equiv.apply_symm_apply,
      Equiv.symm_apply_apply]
  have : IsSplitEpi (M.freeHomEquiv.symm s) := IsSplitEpi.mk' ⟨_, hsplit⟩
  let G : M.GeneratingSections := { I := PUnit.{1}, s := s }
  refine ⟨G.localGeneratorsData, ⟨fun i => ⟨?_⟩⟩⟩
  change Finite PUnit.{1}
  infer_instance

/-- The stalk image of the identity of the unit module is the whole stalk. -/
theorem range_stalkInclusionLinearMap_unit (X : SourceReducedComplexSpace) (x : X.obj.left) :
    LinearMap.range (stalkInclusionLinearMap X.obj.left.toSheafedSpace.sheaf
      (SheafOfModules.unit (forgetRing X.obj.left.toSheafedSpace.sheaf)) (𝟙 _) x) = ⊤ := by
  rw [LinearMap.range_eq_top]
  intro a
  obtain ⟨U, hx, r, rfl⟩ := TopCat.Presheaf.exists_germ_eq X.obj.left.toSheafedSpace.sheaf.obj a
  refine ⟨TopCat.Presheaf.germ (SheafOfModules.unit (forgetRing X.obj.left.toSheafedSpace.sheaf)).val.presheaf
    U x hx r, ?_⟩
  exact stalkInclusionLinearMap_germ X.obj.left.toSheafedSpace.sheaf _ (𝟙 _) x U hx r

/-- **The unit-ideal centre** `(𝒪_X, 𝟙)`: admissible for every family over `X` (its nonunit locus is
empty, its unit locus is everything).  Its blowup is the trivial step of a run after flatness. -/
def unitCentre {X Y : SourceReducedComplexSpace} (f : Y ⟶ X) : AdmissibleCentre f where
  B := SheafOfModules.unit (forgetRing X.obj.left.toSheafedSpace.sheaf)
  b := 𝟙 _
  finiteType := unit_isFiniteType X
  dense := by
    have h : {x : X.obj.left | LinearMap.range (stalkInclusionLinearMap X.obj.left.toSheafedSpace.sheaf
        (SheafOfModules.unit (forgetRing X.obj.left.toSheafedSpace.sheaf)) (𝟙 _) x) = ⊤} = univ :=
      eq_univ_of_forall fun x => range_stalkInclusionLinearMap_unit X x
    rw [h]
    exact dense_univ
  admissible := fun x hx => absurd (range_stalkInclusionLinearMap_unit X x) hx

/-- The unit centre has empty nonunit locus. -/
theorem nonunitLocus_unitCentre {X Y : SourceReducedComplexSpace} (f : Y ⟶ X) :
    nonunitLocus (unitCentre f).B (unitCentre f).b = ∅ :=
  eq_empty_of_forall_notMem fun x hx => hx (range_stalkInclusionLinearMap_unit X x)

/-- **A step from a flat stage is flat** (any admissible centre; admissible steps map non-flat images
into non-flat images). -/
theorem nonflatImage_nextWith_eq_empty (s : Stage) (c : AdmissibleCentre s.f)
    (h : nonflatImage s.f = ∅) : nonflatImage (nextWith s c).f = ∅ := by
  let _ := c.finiteType
  refine eq_empty_of_forall_notMem fun x hx => ?_
  have hx' := mapsTo_nonflatImage c.B c.b c.dense s.f c.admissible hx
  rw [h] at hx'
  exact hx'

/-- **Flatness persists along every run**: once a stage of the run of a centre machine has empty
non-flat image, so do all later stages. -/
theorem machine_nonflatImage_eq_empty_of_le (M : CentreMachine) (s₀ : Stage) (d₀ : M.St s₀)
    (hf : IsProperMap s₀.f.hom.left.base) {n : ℕ}
    (h : (toFlatteningSequence M s₀ d₀ hf).nonflatImage n = ∅) :
    ∀ m, n ≤ m → (toFlatteningSequence M s₀ d₀ hf).nonflatImage m = ∅ := by
  intro m hm
  induction m, hm using Nat.le_induction with
  | base => exact h
  | succ m _ ih =>
    refine eq_empty_of_forall_notMem fun x hx => ?_
    have hx' := toFlatteningSequence_mapsTo M s₀ d₀ hf m hx
    rw [ih] at hx'
    exact hx'

end

end Hironaka.Analytic.Unibranch.HironakaG10TmUnitCentre
