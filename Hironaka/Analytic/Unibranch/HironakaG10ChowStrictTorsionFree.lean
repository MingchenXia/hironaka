import Hironaka.Analytic.Unibranch.HironakaG10ChowOneStepStrictTransform
import Hironaka.Analytic.Unibranch.EmbeddedGeometricIdealGlobalCartier
import Hironaka.Resolution.HironakaNativePulledIdealComposition
import Hironaka.Resolution.HironakaG10ChowGermIdealDictionary

/-!
# The strict transform kills the exceptional torsion (route step (4.3), native half of HLT §2.2)

For the one-step strict transform `(Y', p, q)` of a proper `f : Y ⟶ X` under the blowup
`σ : X' = Bl_B X ⟶ X` (`HironakaG10ChowOneStepStrictTransform`), the ideal of `B` pulled back to
`Y'` is generated, at every point `y'`, by ONE nonzerodivisor (`strict_pulledIdeal_regular`).
Consequently, if `a` generates the exceptional ideal of `X'` at `p y'`, then `p^♯ a` is a
nonzerodivisor of `𝒪_{Y',y'}` generating the pulled ideal (`strictP_generator_regular`): the
`a`-torsion of the base-changed family dies on the strict transform
(`strictP_torsion_eq_zero`).  This is the native form of the step "killing torsion with respect to
`U` kills `a`-torsion" in the improvement lemma (Rydh, arXiv:2501.08394, Lemma 1.18; HLT 1973 §2.2),
which combined with the germ-level torsion witness
`HironakaChowQuotientBaseFlattenerTorsion.exists_analytic_quotient_base_fibre_torsion` yields the
strict decrease of fibres.
-/

set_option autoImplicit false

open Set TopologicalSpace CategoryTheory AlgebraicGeometry
open scoped Topology

namespace Hironaka.Analytic.Unibranch.HironakaG10ChowStrictTorsionFree

open Hironaka HironakaSingularModuleSheafStalk HironakaNativePulledIdealSheaf
  SourceReducedComplexSpace EmbeddedIdealBlowupNonunitLocus HironakaG10ChowOneStepStrictTransform

noncomputable section

/-- Two generators of the same principal ideal: if one is a nonzerodivisor, so is the other. -/
theorem isRegular_of_span_singleton_eq {R : Type*} [CommRing R] {e g : R}
    (he : IsRegular e) (h : Ideal.span {g} = Ideal.span {e}) : IsRegular g := by
  have hg : g ∈ Ideal.span {e} := h ▸ Ideal.mem_span_singleton_self g
  have he' : e ∈ Ideal.span {g} := h ▸ Ideal.mem_span_singleton_self e
  obtain ⟨u, hu⟩ := Ideal.mem_span_singleton'.mp hg
  obtain ⟨v, hv⟩ := Ideal.mem_span_singleton'.mp he'
  have hvu : v * u = 1 := by
    have h1 : (v * u) * e = 1 * e := by rw [one_mul, mul_assoc, hu, hv]
    exact he.right (by simpa only [mul_comm] using h1)
  have hunit : IsUnit u := IsUnit.of_mul_eq_one v (by rw [mul_comm]; exact hvu)
  rw [← hu]
  exact (hunit.isRegular).mul he

variable {X Y : SourceReducedComplexSpace}
  (B : SheafOfModules.{0} (forgetRing X.obj.left.toSheafedSpace.sheaf))
  (b : B ⟶ SheafOfModules.unit (forgetRing X.obj.left.toSheafedSpace.sheaf))
  [B.IsFiniteType] (f : Y ⟶ X)

/-- **The pulled ideal is locally generated by a nonzerodivisor on the strict transform.** -/
theorem strict_pulledIdeal_regular (y : (strictSource B b f).obj.left) :
    ∃ e : ((strictSource B b f).obj.left.presheaf.stalk y).carrier,
      nativePulledIdealStalkIdeal (strictQ B b f ≫ f).hom.left B b y = Ideal.span {e} ∧
        IsRegular e := by
  have hcomp : nativePulledIdealStalkIdeal (strictQ B b f ≫ f).hom.left B b y =
      nativePulledIdealStalkIdeal (strictQ B b f).hom.left (nativePulledIdealModule f.hom.left B b)
        (nativePulledIdealInclusion f.hom.left B b) y :=
    (HironakaNativePulledIdealComposition.stalkIdeal_comp f.hom.left (strictQ B b f).hom.left
      B b y).symm
  rw [hcomp]
  unfold strictQ OriginalFiniteIdealGeometricBlowup.projectionMorphism
  obtain ⟨U, hyU, s, hs⟩ :=
    EmbeddedGeometricIdealGlobalCartier.exists_local_projection_ideal_generator _ _ _ _ _ _ y
  exact ⟨_, hs y hyU⟩

variable (hDense : Dense {x : X.obj.left |
    LinearMap.range (stalkInclusionLinearMap X.obj.left.toSheafedSpace.sheaf B b x) = ⊤})

/-- **The pulled exceptional generator is a nonzerodivisor on the strict transform.**  If `a`
generates the exceptional ideal of `X' = Bl_B X` at `p y'`, then `p^♯ a` generates the pulled ideal
at `y'` and is a nonzerodivisor of `𝒪_{Y',y'}`. -/
theorem strictP_generator_regular (y : (strictSource B b f).obj.left)
    (a : ((OriginalFiniteIdealBlowup.sourceObject B b hDense).obj.left.presheaf.stalk
      ((strictP B b hDense f).hom.left.base y)).carrier)
    (ha : nativePulledIdealStalkIdeal (stepProj B b hDense).hom.left B b
      ((strictP B b hDense f).hom.left.base y) = Ideal.span {a}) :
    nativePulledIdealStalkIdeal (strictQ B b f ≫ f).hom.left B b y =
        Ideal.span {(strictP B b hDense f).hom.left.stalkMap y a} ∧
      IsRegular ((strictP B b hDense f).hom.left.stalkMap y a) := by
  have hsq : (strictQ B b f ≫ f).hom.left =
      (strictP B b hDense f).hom.left ≫ (stepProj B b hDense).hom.left :=
    congrArg (fun H => H.hom.left) (strictP_comp B b hDense f).symm
  have h1 : nativePulledIdealStalkIdeal (strictQ B b f ≫ f).hom.left B b y =
      Ideal.span {(strictP B b hDense f).hom.left.stalkMap y a} := by
    rw [hsq, HironakaG10ChowGermIdealDictionary.nativePulledIdealStalkIdeal_comp B b _ _ y, ha,
      Ideal.map_span, Set.image_singleton]
  obtain ⟨e, he, hreg⟩ := strict_pulledIdeal_regular B b f y
  exact ⟨h1, isRegular_of_span_singleton_eq hreg (h1.symm.trans he)⟩

/-- **The exceptional torsion dies on the strict transform.** -/
theorem strictP_torsion_eq_zero (y : (strictSource B b f).obj.left)
    (a : ((OriginalFiniteIdealBlowup.sourceObject B b hDense).obj.left.presheaf.stalk
      ((strictP B b hDense f).hom.left.base y)).carrier)
    (ha : nativePulledIdealStalkIdeal (stepProj B b hDense).hom.left B b
      ((strictP B b hDense f).hom.left.base y) = Ideal.span {a})
    (h : ((strictSource B b f).obj.left.presheaf.stalk y).carrier)
    (hh : (strictP B b hDense f).hom.left.stalkMap y a * h = 0) : h = 0 :=
  (strictP_generator_regular B b f hDense y a ha).2.left (show _ * h = _ * 0 by rw [hh, mul_zero])

end

end Hironaka.Analytic.Unibranch.HironakaG10ChowStrictTorsionFree
