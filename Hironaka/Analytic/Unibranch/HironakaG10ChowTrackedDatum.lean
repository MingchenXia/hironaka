import Hironaka.Analytic.Unibranch.HironakaG10ChowLeavingRounds

/-!
# Tracked flatteners and permissible steps at germ level (Phase C)

Hironaka 1975, Def. 4.4.2 ((F)-datum), Def. 4.4.3 (permissible blowups), Lemma 4.4.5 (transport
of the tracked flatteners), Lemma 4.5.4 and Lemma 4.6.1 (printed pp. 536–538, 542–545), at germ
level: the ideal of a tracked flattener at a point of its support is the whole-fibre flattener
(`HironakaG10ChowLeavingRounds.germFlattener`, Hironaka's (*) for germs of test spaces), so a
tracked flattener is recorded by an open set `V_p` and its support `Z_p ⊆ V_p`.

* `germFlattener_le_maximalIdeal`;
* `OnStrictTransform` — germ-level membership in the strict transform `Z_p^*` (the ideal of
  `G^{-k} h`, `h ∈ I_Z ∩ I_D^k`, is proper);
* `TrackedDatum`, `TrackedDatum.tracked`, `TrackedDatum.transport` — the (F)-datum and its
  transport along one blowup (`V_{p1} = σ⁻¹ V_p`, `|Z_{p1}| = |Z_p^*|`, Lemma 4.4.5 at germ level);
* `IsSumCentreFor` — the centre is `I_S^β + I_Z` at each of its points, `I_Z` the flattener stalk and
  `β ≥` an Artin–Rees number (Hironaka's `D_β`, p. 542);
* `mem_transport_of_not_mem_nonunitLocus` — off the centre, tracked points stay tracked;
* `principalPullbackAt_of_leave` — **every point leaving the tracked set at a step whose centre is a
  sum centre, or avoids the tracked set (the steps of `II_{n-1}` inside `I_n`, Lemma 4.5.1 (2)),
  satisfies the leaving condition** (hence decreases the fibre).
-/

set_option autoImplicit false

open Set TopologicalSpace CategoryTheory AlgebraicGeometry IsLocalRing
open scoped Topology

namespace Hironaka.Analytic.Unibranch.HironakaG10ChowTrackedDatum

open Hironaka Hironaka
  HironakaSingularModuleSheafStalk HironakaNativePulledIdealSheaf
  SourceReducedComplexSpace HironakaG10ChowOneStepStrictTransform HironakaG10ChowStrictTorsionFree
  HironakaG10ChowProductCentre HironakaG10ChowFlattenerDecrease HironakaG10ChowLeavingRounds
  HironakaG10ChowArtinReesCentre EmbeddedIdealBlowupNonunitLocus

noncomputable section

variable {X Y : SourceReducedComplexSpace}

/-- The whole-fibre flattener is contained in the maximal ideal (the base change to the reduced
point is flat). -/
theorem germFlattener_le_maximalIdeal (f : Y ⟶ X) (x : X.obj.left) :
    germFlattener f x ≤ maximalIdeal (X.obj.left.presheaf.stalk x) := by
  refine (isGermFlattenerAt_germFlattener f x _).mp fun y h => ?_
  exact RingHom.Flat.of_isField ((Ideal.Quotient.maximal_ideal_iff_isField_quotient _).mp
    (maximalIdeal.isMaximal _)) _

/-- The strict-transform ideal is proper when the centre generator is a unit (off the centre). -/
theorem strictIdeal_le_maximalIdeal_of_isUnit {A R : Type*} [CommRing A] [CommRing R]
    [IsLocalRing A] [IsLocalRing R] (φ : A →+* R) [IsLocalHom φ] (IZ ID : Ideal A)
    (hIZ : IZ ≤ maximalIdeal A) (G : R) (hG : IsUnit G) :
    strictIdeal φ IZ ID G ≤ maximalIdeal R := by
  refine Ideal.span_le.mpr fun h' hh' => ?_
  obtain ⟨k, h, hh, hφ⟩ := hh'
  refine (mem_maximalIdeal _).mpr fun hu => ?_
  have hu' : IsUnit (φ h) := hφ ▸ (hG.pow k).mul hu
  exact (mem_maximalIdeal _).mp (hIZ (Ideal.mem_inf.mp hh).1) (isUnit_of_map_unit φ h hu')

/-- **Germ-level membership of `x'` in the strict transform of `V(I_Z)`** under `σ` with centre
`I_D`: for every regular generator `G` of the pulled centre, the ideal generated by the `h'` with
`σ^♯ h = G^k h'`, `h ∈ I_Z ∩ I_D^k`, is proper. -/
def OnStrictTransform {X' : SourceReducedComplexSpace} (σ : X' ⟶ X) (x' : X'.obj.left)
    (IZ ID : Ideal (X.obj.left.presheaf.stalk (σ.hom.left.base x'))) : Prop :=
  ∀ G : X'.obj.left.presheaf.stalk x', IsRegular G →
    Ideal.map (σ.hom.left.stalkMap x').hom ID = Ideal.span {G} →
      strictIdeal (σ.hom.left.stalkMap x').hom IZ ID G ≠ ⊤

/-- A **tracked-flattener datum** at germ level (Hironaka Def. 4.4.2 (3)): finitely many open sets
`V_p` and supports `Z_p ⊆ V_p` of local flatteners; the ideal of `Z_p` at a point of `Z_p` is the
whole-fibre flattener there. -/
structure TrackedDatum (X : SourceReducedComplexSpace) where
  q : ℕ
  V : Fin q → Set X.obj.left
  Z : Fin q → Set X.obj.left
  isOpen : ∀ p, IsOpen (V p)
  sub : ∀ p, Z p ⊆ V p

/-- The tracked set `⋃_p |Z_p|`. -/
def TrackedDatum.tracked (d : TrackedDatum X) : Set X.obj.left := ⋃ p, d.Z p

section Step

variable (B : SheafOfModules.{0} (forgetRing X.obj.left.toSheafedSpace.sheaf))
  (b : B ⟶ SheafOfModules.unit (forgetRing X.obj.left.toSheafedSpace.sheaf)) [B.IsFiniteType]
  (hDense : Dense {x : X.obj.left |
    LinearMap.range (stalkInclusionLinearMap X.obj.left.toSheafedSpace.sheaf B b x) = ⊤})
  (f : Y ⟶ X)

/-- **Transport of a tracked datum along one blowup** (Hironaka Lemma 4.4.5 at germ level):
`V_{p1} = σ⁻¹(V_p)` and `|Z_{p1}| = |Z_p^*|`, the germ-level strict transform of the flattener. -/
def TrackedDatum.transport (d : TrackedDatum X) :
    TrackedDatum (OriginalFiniteIdealBlowup.sourceObject B b hDense) where
  q := d.q
  V p := (stepProj B b hDense).hom.left.base ⁻¹' d.V p
  Z p := {x' | (stepProj B b hDense).hom.left.base x' ∈ d.Z p ∧
    OnStrictTransform (stepProj B b hDense) x'
      (germFlattener f ((stepProj B b hDense).hom.left.base x'))
      (LinearMap.range (stalkInclusionLinearMap X.obj.left.toSheafedSpace.sheaf B b
        ((stepProj B b hDense).hom.left.base x')) :)}
  isOpen p := (d.isOpen p).preimage (stepProj B b hDense).hom.left.base.hom.continuous
  sub p _ hx := d.sub p hx.1

/-- **Hironaka's sum centres** `D_β = V(I_Z + I_S^β)` (p. 542) at germ level: at every point of the
centre its stalk is `I_S^β + I_Z` with `I_Z` the whole-fibre flattener stalk and `β` at least an
Artin–Rees number of `(I_Z, I_S)`. -/
def IsSumCentreFor (β : ℕ) : Prop :=
  ∀ x ∈ nonunitLocus B b, ∃ (IS : Ideal (X.obj.left.presheaf.stalk x)) (α : ℕ), α ≤ β ∧
    (∀ m, α ≤ m → germFlattener f x ⊓ IS ^ m ≤ IS ^ (m - α) * (germFlattener f x ⊓ IS ^ α)) ∧
    LinearMap.range (stalkInclusionLinearMap X.obj.left.toSheafedSpace.sheaf B b x) =
      IS ^ β ⊔ germFlattener f x

/-- **Off the centre, tracked points stay tracked.** -/
theorem mem_transport_of_not_mem_nonunitLocus (d : TrackedDatum X) (p : Fin d.q)
    (x' : (OriginalFiniteIdealBlowup.sourceObject B b hDense).obj.left)
    (hx : (stepProj B b hDense).hom.left.base x' ∈ d.Z p)
    (hc : (stepProj B b hDense).hom.left.base x' ∉ nonunitLocus B b) :
    x' ∈ (d.transport B b hDense f).Z p := by
  refine ⟨hx, fun G _ hG htop => ?_⟩
  have hrange : LinearMap.range (stalkInclusionLinearMap X.obj.left.toSheafedSpace.sheaf B b
      ((stepProj B b hDense).hom.left.base x')) = ⊤ := not_not.mp hc
  have hGu : IsUnit G := Ideal.span_singleton_eq_top.mp (hG.symm.trans
    ((congrArg (Ideal.map ((stepProj B b hDense).hom.left.stalkMap x').hom) hrange).trans
      (Ideal.map_top _)))
  have hle : strictIdeal ((stepProj B b hDense).hom.left.stalkMap x').hom
      (germFlattener f ((stepProj B b hDense).hom.left.base x'))
      (LinearMap.range (stalkInclusionLinearMap X.obj.left.toSheafedSpace.sheaf B b
        ((stepProj B b hDense).hom.left.base x')) :) G ≤ maximalIdeal _ :=
    strictIdeal_le_maximalIdeal_of_isUnit _ _ _ (germFlattener_le_maximalIdeal f _) G hGu
  rw [htop] at hle
  exact (maximalIdeal.isMaximal _).ne_top (top_le_iff.mp hle)

/-- **The leaving condition at every leaving point of a permissible step** (Hironaka Lemma 4.5.4
with Lemma 3.2, and Lemma 4.5.1 (2) for the steps of `II_{n-1}`): if the centre is a sum centre,
or avoids the tracked set, every point `x'` over a tracked point which is not tracked after the
step satisfies `PrincipalPullbackAt`. -/
theorem principalPullbackAt_of_leave (d : TrackedDatum X) (β : ℕ)
    (hc : IsSumCentreFor B b f β ∨ Disjoint (nonunitLocus B b) d.tracked)
    (x' : (OriginalFiniteIdealBlowup.sourceObject B b hDense).obj.left)
    (hx : (stepProj B b hDense).hom.left.base x' ∈ d.tracked)
    (hx' : x' ∉ (d.transport B b hDense f).tracked) :
    PrincipalPullbackAt f (stepProj B b hDense) (strictP B b hDense f) x' := by
  obtain ⟨p, hp⟩ := mem_iUnion.mp hx
  have hnot : x' ∉ (d.transport B b hDense f).Z p := fun h => hx' (mem_iUnion.mpr ⟨p, h⟩)
  by_cases hcent : (stepProj B b hDense).hom.left.base x' ∈ nonunitLocus B b
  · rcases hc with hsum | hdisj
    · obtain ⟨IS, α, hαβ, hAR, hB⟩ := hsum _ hcent
      have hns : ¬ OnStrictTransform (stepProj B b hDense) x'
          (germFlattener f ((stepProj B b hDense).hom.left.base x'))
          (LinearMap.range (stalkInclusionLinearMap X.obj.left.toSheafedSpace.sheaf B b
            ((stepProj B b hDense).hom.left.base x')) :) := fun h => hnot ⟨hp, h⟩
      unfold OnStrictTransform at hns
      push Not at hns
      obtain ⟨G, hG, hD, htop⟩ := hns
      rw [hB] at hD htop
      exact principalPullbackAt_of_sumCentre B b hDense f x' _ IS α β hαβ hAR hB rfl G hG hD htop
    · exact absurd hp (Set.disjoint_left.mp hdisj hcent ∘ fun h => mem_iUnion.mpr ⟨p, h⟩)
  · exact absurd (mem_transport_of_not_mem_nonunitLocus B b hDense f d p x' hp hcent) hnot

end Step

end

end Hironaka.Analytic.Unibranch.HironakaG10ChowTrackedDatum
