import Hironaka.Analytic.Unibranch.HironakaG10HirGermFlattener

/-! # Relative non-flat sets and the flatness filtration

The relative non-flat set over a closed subset is contained in the ordinary
non-flat image. The only input is base change of flatness; no analyticity or
closedness of the filtration is assumed.
-/

set_option autoImplicit false
open Set TopologicalSpace CategoryTheory AlgebraicGeometry Opposite

namespace Hironaka.Analytic.Unibranch.HironakaG10RelativeNonflatStrata

open Hironaka.Analytic.Unibranch.HironakaG10HirGermFlattener
  Hironaka.Analytic.Unibranch.HironakaG10ChowStrictFlatLocus

noncomputable section

/-- The stalk ideal generated by germs of sections vanishing pointwise on
  the given subset, the source's reduced closed-subspace ideal. -/
def vanishingIdealAt (X : LocallyRingedSpace.{0}) (A : Set X) (x : X) :
    Ideal (X.presheaf.stalk x) :=
  Ideal.span {g | ∃ (U : Opens X) (hx : x ∈ U) (t : X.presheaf.obj (op U)),
    X.presheaf.germ U x hx t = g ∧ ∀ (z : X) (hz : z ∈ U), z ∈ A →
      X.presheaf.germ U z hz t ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk z)}

/-- Relative non-flat set `s₁(f/B)` over the reduced ideal of `B`. -/
def relNonflat {X Y : SourceReducedComplexSpace} (f : Y ⟶ X) (B : Set X.obj.left) :
    Set X.obj.left :=
  {x | x ∈ B ∧ ¬ FlatOverAt f x (vanishingIdealAt X.obj.left B x)}

/-- The iterated relative non-flat sets. Their analytic nature is a separate
  theorem and is not used in the implications below. -/
def strata {X Y : SourceReducedComplexSpace} (f : Y ⟶ X) (B : Set X.obj.left) :
    ℕ → Set X.obj.left
  | 0 => B
  | i + 1 => relNonflat f (strata f B i)

/-- Every relative non-flat point is non-flat for the original family. -/
theorem relNonflat_subset_nonflatImage {X Y : SourceReducedComplexSpace}
    (f : Y ⟶ X) (B : Set X.obj.left) : relNonflat f B ⊆ nonflatImage f := by
  intro x hx
  by_contra h
  apply hx.2
  exact FlatOverAt.mono bot_le (flatOverAt_bot_iff_not_mem_nonflatImage.mpr h)

/-- Each successive stratum is contained in the preceding one. -/
theorem strata_succ_subset {X Y : SourceReducedComplexSpace}
    (f : Y ⟶ X) (B : Set X.obj.left) (i : ℕ) : strata f B (i + 1) ⊆ strata f B i :=
  fun _ hx => hx.1

/-- Every positive stratum lies in the non-flat image of the original map. -/
theorem strata_succ_subset_nonflatImage {X Y : SourceReducedComplexSpace}
    (f : Y ⟶ X) (B : Set X.obj.left) (i : ℕ) :
    strata f B (i + 1) ⊆ nonflatImage f :=
  relNonflat_subset_nonflatImage f (strata f B i)

/-- For a closed positive stratum, the closure used to define Hironaka's
  boundary $E_i$ remains in the ordinary non-flat image. -/
theorem closed_stratum_boundary_subset_nonflatImage {X Y : SourceReducedComplexSpace}
    (f : Y ⟶ X) (B V Z : Set X.obj.left) (i : ℕ)
    (hclosed : IsClosed (strata f B (i + 1))) :
    closure ((strata f B (i + 1) ∩ V) \ Z) ∩ Z ⊆ nonflatImage f := by
  have hclosure : closure ((strata f B (i + 1) ∩ V) \ Z) ⊆ strata f B (i + 1) :=
    closure_minimal (fun _ hx => hx.1.1) hclosed
  exact (inter_subset_left.trans hclosure).trans (strata_succ_subset_nonflatImage f B i)

end
end Hironaka.Analytic.Unibranch.HironakaG10RelativeNonflatStrata
