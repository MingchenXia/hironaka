section Generic

theorem map_span_singleton' {R S : Type*} [CommRing R] [CommRing S] (f : R →+* S) (a : R) :
    Ideal.map f (Ideal.span {a}) = Ideal.span {f a} := by
  rw [Ideal.map_span, Set.image_singleton]

variable {n r : ℕ} {P : Type} [TopologicalSpace P] [ChartedSpace (ComplexModel n) P] [IsComplexManifold n P]

/-- At a point of the pivot chart the strict centre ideal is generated by the pivot coordinate class. -/
theorem pivot_generator (a : ProductNormalCharts n r P) (hr : 0 < r) (W : Set (P × ComplexModel r))
    (hW : IsClosed W) (j : Fin r) (z : actualStrictCarrier (n := n) W)
    (hzs : z.val ∈ (productNormalChart (n := n) a.base j).source) :
    ∃ hz : z.val.base ∈ (productNormalChart (n := n) a.base j).dom,
      strictCentreStalkIdeal W z =
        Ideal.span {geometricCoordinateClass W (productNormalChart (n := n) a.base j) z hz (j.natAdd n)} := by
  have he := Set.ext_iff.mp (strict_pivot_generator_locus
    (HironakaProductZeroPlaneBlowup.interior_product_zero_plane_eq_empty hr)
    W hW (productNormalChart (n := n) a.base j) (j.natAdd n)
    (by simp [productNormalChart])) z
  exact he.mpr hzs

/-- The same, at a point of the strict chart. -/
theorem pivot_generator' (a : ProductNormalCharts n r P) (hr : 0 < r) (W : Set (P × ComplexModel r))
    (hW : IsClosed W) (j : Fin r) (p : strictChartCarrier a W j) :
    ∃ hz : ((strictChartInclusion a W j).base p).val.base ∈ (productNormalChart (n := n) a.base j).dom,
      strictCentreStalkIdeal W ((strictChartInclusion a W j).base p) =
        Ideal.span {geometricCoordinateClass W (productNormalChart (n := n) a.base j)
          ((strictChartInclusion a W j).base p) hz (j.natAdd n)} :=
  pivot_generator a hr W hW j _ p.val.property

/-- The pivot flat coordinate on the pivot chart open is holomorphic. -/
theorem tauVal_holomorphicAt (a : ProductNormalCharts n r P) (j : Fin r) (u : strictChartAmbientOpen a j) :
    HolomorphicAt (n+r) ((productNormalChart (n := n) a.base j).τ (j.natAdd n) ∘
      blowupProj (n+r) {q : P × ComplexModel r | q.2=0} ∘ (Subtype.val : strictChartAmbientOpen a j → _)) u := by
  have hz : u.val.base ∈ (productNormalChart (n := n) a.base j).dom := by
    rw [a.domain j]
    trivial
  exact ((holomorphicAt_flatCoord (productNormalChart (n := n) a.base j).Φ (j.natAdd n) hz).comp_contMDiff
    (Eventually.of_forall fun q => contMDiff_blowupProj q)).comp_contMDiff
      (Eventually.of_forall fun _ => contMDiff_subtype_val.contMDiffAt)

/-- The pivot coordinate class read on the strict chart. -/
theorem inclusion_coordinateClass (a : ProductNormalCharts n r P) (W : Set (P × ComplexModel r)) (j : Fin r)
    (p : strictChartCarrier a W j)
    (hz : ((strictChartInclusion a W j).base p).val.base ∈ (productNormalChart (n := n) a.base j).dom) :
    ((strictChartInclusion a W j).stalkMap p).hom
        (geometricCoordinateClass W (productNormalChart (n := n) a.base j) ((strictChartInclusion a W j).base p)
          hz (j.natAdd n)) =
      (actualSubspaceInclusion (n := n+r) (strictChartCarrier a W j)).stalkMap p
        (actualOriginalFunctionGerm p.val
          ((productNormalChart (n := n) a.base j).τ (j.natAdd n) ∘
            blowupProj (n+r) {q : P × ComplexModel r | q.2=0} ∘ Subtype.val)
          (tauVal_holomorphicAt a j p.val)) :=
  actualSubspaceMap_stalkMap_germ (f := (Subtype.val : strictChartAmbientOpen a j → _))
    contMDiff_subtype_val (C := strictChartCarrier a W j) (D := actualStrictCarrier (n := n) W) (fun _ hx => hx) p
    ((productNormalChart (n := n) a.base j).τ (j.natAdd n) ∘ blowupProj (n+r) {q : P × ComplexModel r | q.2=0})
    ((holomorphicAt_flatCoord (productNormalChart (n := n) a.base j).Φ (j.natAdd n) hz).comp_contMDiff
      (Eventually.of_forall fun q => contMDiff_blowupProj q))

/-- **On a pivot strict chart the pulled centre is generated by the pivot coordinate class** (generic form: any
explicit model `K` of the strict transform satisfying the whole-ideal law). -/
theorem strictChartTo_span_pivot (a : ProductNormalCharts n r P) (hr : 0 < r) (W : Set (P × ComplexModel r))
    (hW : IsClosed W) (j : Fin r) {A S : LocallyRingedSpace.{0}}
    (K : actualSubspaceLocallyRingedSpace (n := n+r) (actualStrictCarrier (n := n) W) ⟶ A) (πA : A ⟶ S)
    (Cen : ∀ s : S, Ideal (S.presheaf.stalk s))
    (hwhole : ∀ z, Ideal.map (K.stalkMap z).hom
        (Ideal.map (πA.stalkMap (K.base z)).hom (Cen (πA.base (K.base z)))) = strictCentreStalkIdeal W z)
    (p : strictChartCarrier a W j) (G : A.presheaf.stalk ((strictChartTo a W K j).base p))
    (hspan : Ideal.map (πA.stalkMap ((strictChartTo a W K j).base p)).hom
        (Cen (πA.base ((strictChartTo a W K j).base p))) = Ideal.span {G}) :
    Ideal.span {((strictChartTo a W K j).stalkMap p).hom G} =
      Ideal.span {(actualSubspaceInclusion (n := n+r) (strictChartCarrier a W j)).stalkMap p
        (actualOriginalFunctionGerm p.val
          ((productNormalChart (n := n) a.base j).τ (j.natAdd n) ∘
            blowupProj (n+r) {q : P × ComplexModel r | q.2=0} ∘ Subtype.val)
          (tauVal_holomorphicAt a j p.val))} := by
  obtain ⟨hz, hgen⟩ := pivot_generator' a hr W hW j p
  have hcomp : ((strictChartTo a W K j).stalkMap p).hom =
      ((strictChartInclusion a W j).stalkMap p).hom.comp (K.stalkMap ((strictChartInclusion a W j).base p)).hom :=
    RingHom.ext fun r => ConcreteCategory.congr_hom (LocallyRingedSpace.stalkMap_comp (strictChartInclusion a W j) K p) r
  calc Ideal.span {((strictChartTo a W K j).stalkMap p).hom G}
      = Ideal.map ((strictChartTo a W K j).stalkMap p).hom (Ideal.span {G}) := by
        rw [Ideal.map_span, Set.image_singleton]
    _ = Ideal.map ((strictChartInclusion a W j).stalkMap p).hom
          (strictCentreStalkIdeal W ((strictChartInclusion a W j).base p)) := by
        rw [← hspan, hcomp, ← Ideal.map_map, ← hwhole]
        rfl
    _ = _ := (congrArg (Ideal.map ((strictChartInclusion a W j).stalkMap p).hom) hgen).trans
        ((map_span_singleton' _ _).trans
          (congrArg (fun a => Ideal.span {a}) (inclusion_coordinateClass a W j p hz)))

end Generic

variable {X Y : SourceReducedComplexSpace}
  (B : SheafOfModules.{0} (forgetRing Y.obj.left.toSheafedSpace.sheaf))
  (b : B ⟶ SheafOfModules.unit (forgetRing Y.obj.left.toSheafedSpace.sheaf))
  [B.IsFiniteType] (F : X ⟶ Y) (x : X.obj.left)
  {y : (OriginalFiniteIdealGeometricBlowup.sourceObject B b).obj.left}

local instance : (nativePulledIdealModule F.hom.left B b).IsFiniteType :=
  HironakaNativePulledIdealFiniteType.nativePulledIdealModule_isFiniteType F.hom.left B b

variable (t : CanonicalTargetGraph B b y)
  (c : CanonicalCompatibleSourceGraph B b F x t)
  (g : CanonicalSquareGeometry B b F x t c)
  (d : CanonicalNormalSectionData B b F x t c g)
  (E : SameCanonicalExplicitProductModels B b F x t c g d)
  (M : AllAmbientMonomialLiftData B b F x t c g d E)
  (j : Fin t.rank) (v : ComplexModel (c.embedding.dim+t.rank))
  (hvj : v (j.natAdd c.embedding.dim) = 0)

/-- The pivot flat coordinate of the target product chart. -/
abbrev tau : t.domain × ComplexModel t.rank → ℂ :=
  (productNormalChart (n := t.embedding.dim) E.target.charts.base j).τ (j.natAdd t.embedding.dim)

/-- The pivot flat coordinate pulls back along `actualMap` to the pivot coordinate of the recentred chart. -/
theorem tau_actualMap (w : sourceDomain B b F x t c g d E j v) :
    tau B b F x t c g d E j (blowupProj (t.embedding.dim+t.rank) {q : t.domain × ComplexModel t.rank | q.2=0}
      (actualMap B b F x t c g d E j v hvj w).val) =
      w.val (j.natAdd c.embedding.dim) := by
  have h := lift_pivot_flatCoord c.embedding.dim E.source.charts E.target.charts c.holomorphic
    (explicitAmbientLift B b F x t c g E.target E.source) E.square.holomorphic E.square.ambient_projection j
    (arbitraryCanonicalRecenteredChart E.source.charts j v hvj w)
  refine h.trans ?_
  rw [arbitrary_canonical_recentered_coordinates]
  change w.val (j.natAdd c.embedding.dim) + v (j.natAdd c.embedding.dim) = _
  rw [hvj, add_zero]

variable (w : sourceDomain B b F x t c g d E j v)
  (hV : actualMap B b F x t c g d E j v hvj w ∈ targetStrict B b F x t c g d E j)

/-- The canonical base map `ψ` (G10GL's `canonicalPsi`). -/
abbrev psi :
    (OriginalFiniteIdealGeometricBlowup.sourceObject B b).obj.left.presheaf.stalk
        ((targetChartMap B b F x t c g d E j).base ⟨actualMap B b F x t c g d E j v hvj w, hV⟩) →+*
      JointQuotient (n := t.embedding.dim+t.rank) c.embedding.dim t.rank j (fun i => v i)
        (targetOpen B b F x t c g d E j v) (originalGraph B b F x t c g d E j v)
        (actualMap B b F x t c g d E j v hvj) (targetStrict B b F x t c g d E j) w :=
  (targetStalkToJoint (n := t.embedding.dim+t.rank) c.embedding.dim t.rank j (fun i => v i)
      (targetOpen B b F x t c g d E j v) (originalGraph B b F x t c g d E j v)
      (actualMap B b F x t c g d E j v hvj) (targetStrict B b F x t c g d E j)
      (actualMap_holomorphic B b F x t c g d E M j v hvj) (targetStrict_analytic B b F x t c g d E j) w hV).comp
    ((targetChartMap B b F x t c g d E j).stalkMap ⟨actualMap B b F x t c g d E j v hvj w, hV⟩).hom

theorem tau_holomorphicAt :
    HolomorphicAt (t.embedding.dim+t.rank)
      (tau B b F x t c g d E j ∘ (blowupProj (t.embedding.dim+t.rank) {q : t.domain × ComplexModel t.rank | q.2=0} ∘
        (Subtype.val : productChartOpen E.target.charts j → _)))
      (actualMap B b F x t c g d E j v hvj w) := by
  have hz : (actualMap B b F x t c g d E j v hvj w).val.base ∈
      (productNormalChart (n := t.embedding.dim) E.target.charts.base j).dom := by
    rw [E.target.charts.domain j]
    trivial
  exact ((holomorphicAt_flatCoord _ _ hz).comp_contMDiff
    (Eventually.of_forall fun p => contMDiff_blowupProj p)).comp_contMDiff
      (Eventually.of_forall fun _ => contMDiff_subtype_val.contMDiffAt)

/-- The class of the pivot flat coordinate at the target chart point. -/
abbrev pivotGerm : TargetStalk (n := t.embedding.dim+t.rank) c.embedding.dim t.rank j (fun i => v i)
    (targetOpen B b F x t c g d E j v) (actualMap B b F x t c g d E j v hvj) (targetStrict B b F x t c g d E j) w hV :=
  (actualSubspaceInclusion (n := t.embedding.dim+t.rank) (targetStrict B b F x t c g d E j)).stalkMap
    ⟨actualMap B b F x t c g d E j v hvj w, hV⟩
    (actualOriginalFunctionGerm (actualMap B b F x t c g d E j v hvj w) _
      (tau_holomorphicAt B b F x t c g d E j v hvj w))

/-- The same class, typed in the stalk of the target strict chart. -/
abbrev pivotGerm' : (actualSubspaceLocallyRingedSpace (n := t.embedding.dim+t.rank)
    (strictChartCarrier E.target.charts (targetGraphSet B b t) j)).presheaf.stalk
      ⟨actualMap B b F x t c g d E j v hvj w, hV⟩ :=
  pivotGerm B b F x t c g d E j v hvj w hV

include M in
/-- **`ψ` sends the pivot coordinate class to the pivot class.** -/
theorem psi_pivot :
    targetStalkToJoint (n := t.embedding.dim+t.rank) c.embedding.dim t.rank j (fun i => v i)
        (targetOpen B b F x t c g d E j v) (originalGraph B b F x t c g d E j v)
        (actualMap B b F x t c g d E j v hvj) (targetStrict B b F x t c g d E j)
        (actualMap_holomorphic B b F x t c g d E M j v hvj) (targetStrict_analytic B b F x t c g d E j) w hV
        (pivotGerm B b F x t c g d E j v hvj w hV) =
      pivotClass (n := t.embedding.dim+t.rank) c.embedding.dim t.rank j (fun i => v i)
        (targetOpen B b F x t c g d E j v) (originalGraph B b F x t c g d E j v)
        (actualMap B b F x t c g d E j v hvj) (targetStrict B b F x t c g d E j) w :=
  targetStalkToJoint_pivot c.embedding.dim t.rank j (fun i => v i)
    (targetOpen B b F x t c g d E j v) (originalGraph B b F x t c g d E j v)
    (actualMap B b F x t c g d E j v hvj) (targetStrict B b F x t c g d E j)
    (actualMap_holomorphic B b F x t c g d E M j v hvj) (targetStrict_analytic B b F x t c g d E j) w hV _
    (tau_holomorphicAt B b F x t c g d E j v hvj w)
    (Eventually.of_forall fun w' => tau_actualMap B b F x t c g d E j v hvj w')

/-- The stalk map of the target chart factors through the explicit model. -/
theorem targetChartMap_stalk_apply (r : (OriginalFiniteIdealGeometricBlowup.sourceObject B b).obj.left.presheaf.stalk
      ((targetChartMap B b F x t c g d E j).base ⟨actualMap B b F x t c g d E j v hvj w, hV⟩)) :
    ((targetChartMap B b F x t c g d E j).stalkMap ⟨actualMap B b F x t c g d E j v hvj w, hV⟩).hom r =
      ((strictChartInclusion E.target.charts (targetGraphSet B b t) j).stalkMap
          ⟨actualMap B b F x t c g d E j v hvj w, hV⟩).hom
        (((targetCanonicalMap B b t E.target).hom.left.stalkMap
          ((strictChartInclusion E.target.charts (targetGraphSet B b t) j).base
            ⟨actualMap B b F x t c g d E j v hvj w, hV⟩)).hom r) :=
  ConcreteCategory.congr_hom (LocallyRingedSpace.stalkMap_comp
    (strictChartInclusion E.target.charts (targetGraphSet B b t) j) (targetCanonicalMap B b t E.target).hom.left
    ⟨actualMap B b F x t c g d E j v hvj w, hV⟩) r

/-- **On the target strict chart the pulled centre is generated by the pivot coordinate class.** -/
theorem chart_span_eq (G : (OriginalFiniteIdealGeometricBlowup.sourceObject B b).obj.left.presheaf.stalk
      ((targetChartMap B b F x t c g d E j).base ⟨actualMap B b F x t c g d E j v hvj w, hV⟩))
    (hspan : Ideal.map ((OriginalFiniteIdealGeometricBlowup.projectionMorphism B b).hom.left.stalkMap
        ((targetChartMap B b F x t c g d E j).base ⟨actualMap B b F x t c g d E j v hvj w, hV⟩)).hom
        (HironakaG10NfGeoFibreModel.geoCentre B b ((OriginalFiniteIdealGeometricBlowup.projectionMorphism B b).hom.left.base
          ((targetChartMap B b F x t c g d E j).base ⟨actualMap B b F x t c g d E j v hvj w, hV⟩))) = Ideal.span {G}) :
    Ideal.span {((targetChartMap B b F x t c g d E j).stalkMap ⟨actualMap B b F x t c g d E j v hvj w, hV⟩).hom G} =
      Ideal.span {pivotGerm' B b F x t c g d E j v hvj w hV} := by
  exact strictChartTo_span_pivot E.target.charts t.positive (targetGraphSet B b t) t.analytic.isClosed j
    (targetCanonicalMap B b t E.target).hom.left (OriginalFiniteIdealGeometricBlowup.projectionMorphism B b).hom.left
    (HironakaG10NfGeoFibreModel.geoCentre B b) (fun z => E.target_normals.whole_ideal z)
    ⟨actualMap B b F x t c g d E j v hvj w, hV⟩ G hspan

include M in
/-- **The joint pivot torsion is the whole torsion of `ψ G`** for every regular generator `G` of the pulled centre
at the target chart point. -/
theorem pivotTorsion_eq_powerSat_canonical
    (G : (OriginalFiniteIdealGeometricBlowup.sourceObject B b).obj.left.presheaf.stalk
      ((targetChartMap B b F x t c g d E j).base ⟨actualMap B b F x t c g d E j v hvj w, hV⟩)) (hG : IsRegular G)
    (hspan : Ideal.map ((OriginalFiniteIdealGeometricBlowup.projectionMorphism B b).hom.left.stalkMap
        ((targetChartMap B b F x t c g d E j).base ⟨actualMap B b F x t c g d E j v hvj w, hV⟩)).hom
        (HironakaG10NfGeoFibreModel.geoCentre B b ((OriginalFiniteIdealGeometricBlowup.projectionMorphism B b).hom.left.base
          ((targetChartMap B b F x t c g d E j).base ⟨actualMap B b F x t c g d E j v hvj w, hV⟩))) = Ideal.span {G}) :
    pivotTorsion (n := t.embedding.dim+t.rank) c.embedding.dim t.rank j (fun i => v i)
        (targetOpen B b F x t c g d E j v) (originalGraph B b F x t c g d E j v)
        (actualMap B b F x t c g d E j v hvj) (targetStrict B b F x t c g d E j) w =
      powerSat ⊥ (psi B b F x t c g d E M j v hvj w hV G) := by
  have hreg : IsRegular (((targetChartMap B b F x t c g d E j).stalkMap ⟨actualMap B b F x t c g d E j v hvj w, hV⟩).hom G) :=
    HironakaG10NfGeoFibreModel.isRegular_equiv
      (Hironaka.Analytic.Unibranch.HironakaG10NfStalkSquare.oiStalkEquiv (targetChartMap B b F x t c g d E j)
        ⟨actualMap B b F x t c g d E j v hvj w, hV⟩) hG
  have key := chart_span_eq B b F x t c g d E j v hvj w hV G hspan
  have hex := exists_unit_of_span_eq
    (a := ((targetChartMap B b F x t c g d E j).stalkMap ⟨actualMap B b F x t c g d E j v hvj w, hV⟩).hom G)
    (c := pivotGerm' B b F x t c g d E j v hvj w hV) hreg key
  refine hex.elim fun s hsh => ?_
  have hs := hsh.1
  have hsG := hsh.2
  have hpsi : psi B b F x t c g d E M j v hvj w hV G =
      targetStalkToJoint (n := t.embedding.dim+t.rank) c.embedding.dim t.rank j (fun i => v i)
        (targetOpen B b F x t c g d E j v) (originalGraph B b F x t c g d E j v)
        (actualMap B b F x t c g d E j v hvj) (targetStrict B b F x t c g d E j)
        (actualMap_holomorphic B b F x t c g d E M j v hvj) (targetStrict_analytic B b F x t c g d E j) w hV s *
      pivotClass (n := t.embedding.dim+t.rank) c.embedding.dim t.rank j (fun i => v i)
        (targetOpen B b F x t c g d E j v) (originalGraph B b F x t c g d E j v)
        (actualMap B b F x t c g d E j v hvj) (targetStrict B b F x t c g d E j) w :=
    (congrArg (targetStalkToJoint (n := t.embedding.dim+t.rank) c.embedding.dim t.rank j (fun i => v i)
        (targetOpen B b F x t c g d E j v) (originalGraph B b F x t c g d E j v)
        (actualMap B b F x t c g d E j v hvj) (targetStrict B b F x t c g d E j)
        (actualMap_holomorphic B b F x t c g d E M j v hvj) (targetStrict_analytic B b F x t c g d E j) w hV) hsG).trans
      ((map_mul (targetStalkToJoint (n := t.embedding.dim+t.rank) c.embedding.dim t.rank j (fun i => v i)
        (targetOpen B b F x t c g d E j v) (originalGraph B b F x t c g d E j v)
        (actualMap B b F x t c g d E j v hvj) (targetStrict B b F x t c g d E j)
        (actualMap_holomorphic B b F x t c g d E M j v hvj) (targetStrict_analytic B b F x t c g d E j) w hV) s (pivotGerm' B b F x t c g d E j v hvj w hV)).trans
        (congrArg (fun u => (targetStalkToJoint (n := t.embedding.dim+t.rank) c.embedding.dim t.rank j (fun i => v i)
        (targetOpen B b F x t c g d E j v) (originalGraph B b F x t c g d E j v)
        (actualMap B b F x t c g d E j v hvj) (targetStrict B b F x t c g d E j)
