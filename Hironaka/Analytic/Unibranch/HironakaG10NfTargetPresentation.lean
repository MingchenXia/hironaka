/-! ### The product graph coordinate ideal -/

section Graph

variable {n k : ℕ} {M : Type} [TopologicalSpace M] [ChartedSpace (ComplexModel n) M] [IsComplexManifold n M]

omit [IsComplexManifold n M] in
theorem component_holomorphic (G : M → ComplexModel k)
    (hG : ContMDiff 𝓘(ℂ,ComplexModel n) 𝓘(ℂ,ComplexModel k) ∞ G) (p : M) (i : Fin k) :
    HolomorphicAt n (fun q : M => G q i) p :=
  Eventually.of_forall fun _ =>
    (((EuclideanSpace.proj i : ComplexModel k →L[ℂ] ℂ).contMDiff.comp hG).contMDiffAt).mdifferentiableAt
      (by simp)

theorem native_function {a b : ℕ} {P Q : Type}
    [TopologicalSpace P] [TopologicalSpace Q]
    [ChartedSpace (ComplexModel a) P] [IsComplexManifold a P]
    [ChartedSpace (ComplexModel b) Q] [IsComplexManifold b Q]
    {F : P → Q} (hF : ContMDiff 𝓘(ℂ,ComplexModel a) 𝓘(ℂ,ComplexModel b) ∞ F)
    (p : P) (f : Q → ℂ) (hf : HolomorphicAt b f (F p)) :
    (ChartedSpace.locallyRingedSpaceMap F hF).stalkMap p
      (actualOriginalFunctionGerm (F p) f hf) =
      actualOriginalFunctionGerm p (f ∘ F)
        (hf.comp_contMDiff (Eventually.of_forall fun _ => hF.contMDiffAt)) := by
  apply (actualStalkChartEquiv (n := a) p).injective
  rw [actualNativeStalk_chart_pullback, actualOriginalFunctionGerm_chart,
    actualHolomorphicGermPullback_original_function, actualOriginalFunctionGerm_chart]

/-- The zero-plane ideal pulled back by the graph isomorphism (`HironakaFiniteSectionProductGraph`, private there). -/
theorem product_graph_coordinate_ideal (S : Set M) (G : M → ComplexModel k)
    (hG : ContMDiff 𝓘(ℂ,ComplexModel n) 𝓘(ℂ,ComplexModel k) ∞ G) (y : S) :
    Ideal.map (((productGraphIso S G hG).hom ≫
      actualSubspaceInclusion (n := n+k) (productGraph S G)).stalkMap y).hom
      (actualWholeSheafStalkIdeal (vanishingIdeal (n := n+k)
        {q : M × ComplexModel k | q.2 = 0})
          (((productGraphIso S G hG).hom ≫ actualSubspaceInclusion (n := n+k) (productGraph S G)).base y)) =
      Ideal.span (Set.range fun i : Fin k => (actualSubspaceInclusion (n := n) S).stalkMap y
        (actualOriginalFunctionGerm y.val (fun u : M => G u i) (component_holomorphic G hG y.val i))) := by
  rw [productGraphIso_inclusion, whole_product_zero_plane_ideal, Ideal.map_span, ← Set.range_comp]
  apply congrArg Ideal.span
  apply congrArg Set.range
  funext i
  simp only [Function.comp_apply]
  rw [LocallyRingedSpace.stalkMap_comp]
  change (actualSubspaceInclusion (n := n) S).stalkMap y
      ((ChartedSpace.locallyRingedSpaceMap (fun u : M => (u,G u))
        (ProductComplexManifold.contMDiff_prodMk contMDiff_id hG)).stalkMap y.val
          (actualOriginalFunctionGerm (y.val,G y.val) (fun q : M × ComplexModel k => q.2 i) _)) = _
  exact congrArg ((actualSubspaceInclusion (n := n) S).stalkMap y)
    (native_function (ProductComplexManifold.contMDiff_prodMk contMDiff_id hG) y.val (fun q : M × ComplexModel k => q.2 i) _)

end Graph

/-! ### Point transports -/

theorem presentation_of_fibreMap {T S : LocallyRingedSpace.{0}} (σ : T ⟶ S)
    (D : ∀ x : S, Ideal (S.presheaf.stalk x)) (y y' : T) (hy : y' = y) (x : S) (h : σ.base y' = x)
    (hp : GraphChartPresentation (fibreMap σ x y' h) (D x)) :
    GraphChartPresentation (σ.stalkMap y).hom (D (σ.base y)) := by
  subst hy
  subst h
  exact hp

/-! ### The canonical chart -/

variable {X : SourceReducedComplexSpace}
  (B : SheafOfModules.{0} (forgetRing X.obj.left.toSheafedSpace.sheaf))
  (b : B ⟶ SheafOfModules.unit (forgetRing X.obj.left.toSheafedSpace.sheaf)) [B.IsFiniteType]
  {y : (OriginalFiniteIdealGeometricBlowup.sourceObject B b).obj.left}
  (t : CanonicalTargetGraph B b y) (e : TargetExplicitGeometry B b t)

/-- The centre ideal `b·𝒪_{X,x}`. -/
abbrev centre (x : X.obj.left) : Ideal (X.obj.left.presheaf.stalk x) :=
  (LinearMap.range (stalkInclusionLinearMap X.obj.left.toSheafedSpace.sheaf B b x) :)

variable (j : Fin t.rank) (p : strictChartCarrier e.charts (graph B b t) j)
  (hvj : coords B b t e j p (j.natAdd t.embedding.dim) = 0)

/-- The base point of the origin, as a point of the base carrier. -/
abbrev baseCarrierPt : baseSet B b t := (projMap B b t e j p hvj).base (originPt B b t e j p hvj)

/-- **P4: the centre corresponds to `(g)`** under the base chart isomorphism. -/
theorem centre_eq :
    Ideal.map (baseEquiv (baseMap B b t) (baseCarrierPt B b t e j p hvj)).toRingHom
        (centre B b ((baseMap B b t).base (baseCarrierPt B b t e j p hvj))) =
      Ideal.map (Ideal.Quotient.mk _)
        (Ideal.span (Set.range (graphGerms (graphFun B b t e j p hvj) (graphFun_differentiable B b t e j p hvj)))) := by
  set s := baseCarrierPt B b t e j p hvj
  set E := productGraphIso (baseSet B b t) t.functions t.holomorphic
  set z₀ := E.hom.base s
  have hw := t.wholeIdeal z₀
  change Ideal.map ((actualSubspaceInclusion (n := t.embedding.dim+t.rank) (graph B b t)).stalkMap z₀).hom
      (actualWholeSheafStalkIdeal (vanishingIdeal (n := t.embedding.dim+t.rank)
        {q : t.domain × ComplexModel t.rank | q.2 = 0}) z₀.val) =
    Ideal.map ((E.inv ≫ baseMap B b t).stalkMap z₀).hom (centre B b ((baseMap B b t).base s)) at hw
  have hEE : E.hom ≫ E.inv ≫ baseMap B b t = baseMap B b t := E.hom_inv_id_assoc _
  have hθ : ((E.hom ≫ E.inv ≫ baseMap B b t).stalkMap s).hom = ((baseMap B b t).stalkMap s).hom :=
    RingHom.ext fun r => stalkMap_eq_of_eq _ _ hEE s rfl r
  have h1 : Ideal.map ((baseMap B b t).stalkMap s).hom (centre B b ((baseMap B b t).base s)) =
      Ideal.map (E.hom.stalkMap s).hom (Ideal.map ((E.inv ≫ baseMap B b t).stalkMap z₀).hom
        (centre B b ((baseMap B b t).base s))) := by
    have hc : ((E.hom ≫ E.inv ≫ baseMap B b t).stalkMap s).hom =
        (E.hom.stalkMap s).hom.comp ((E.inv ≫ baseMap B b t).stalkMap z₀).hom :=
      congrArg CommRingCat.Hom.hom (LocallyRingedSpace.stalkMap_comp E.hom (E.inv ≫ baseMap B b t) s)
    exact (congrArg (fun φ => Ideal.map φ (centre B b ((baseMap B b t).base s))) (hθ.symm.trans hc)).trans
      (Ideal.map_map _ _).symm
  have h2 : Ideal.map (E.hom.stalkMap s).hom
      (Ideal.map ((actualSubspaceInclusion (n := t.embedding.dim+t.rank) (graph B b t)).stalkMap z₀).hom
        (actualWholeSheafStalkIdeal (vanishingIdeal (n := t.embedding.dim+t.rank)
          {q : t.domain × ComplexModel t.rank | q.2 = 0}) z₀.val)) =
      Ideal.map ((E.hom ≫ actualSubspaceInclusion (n := t.embedding.dim+t.rank) (graph B b t)).stalkMap s).hom
        (actualWholeSheafStalkIdeal (vanishingIdeal (n := t.embedding.dim+t.rank)
          {q : t.domain × ComplexModel t.rank | q.2 = 0})
          ((E.hom ≫ actualSubspaceInclusion (n := t.embedding.dim+t.rank) (graph B b t)).base s)) := by
    have hc : ((E.hom ≫ actualSubspaceInclusion (n := t.embedding.dim+t.rank) (graph B b t)).stalkMap s).hom =
        (E.hom.stalkMap s).hom.comp
          ((actualSubspaceInclusion (n := t.embedding.dim+t.rank) (graph B b t)).stalkMap z₀).hom :=
      congrArg CommRingCat.Hom.hom (LocallyRingedSpace.stalkMap_comp E.hom
        (actualSubspaceInclusion (n := t.embedding.dim+t.rank) (graph B b t)) s)
    exact (Ideal.map_map _ _).trans (congrArg (fun φ => Ideal.map φ (actualWholeSheafStalkIdeal
      (vanishingIdeal (n := t.embedding.dim+t.rank) {q : t.domain × ComplexModel t.rank | q.2 = 0}) z₀.val))
        hc.symm)
  have hF : Ideal.map ((baseMap B b t).stalkMap s).hom (centre B b ((baseMap B b t).base s)) =
      Ideal.span (Set.range fun i : Fin t.rank => (actualSubspaceInclusion (n := t.embedding.dim)
        (baseSet B b t)).stalkMap s (actualOriginalFunctionGerm s.val (fun u => t.functions u i)
          (component_holomorphic t.functions t.holomorphic s.val i))) := by
    exact h1.trans ((congrArg (Ideal.map (E.hom.stalkMap s).hom) hw.symm).trans
      (h2.trans (product_graph_coordinate_ideal (baseSet B b t) t.functions t.holomorphic s)))
  change Ideal.map ((actualSubspaceStalkChartEquiv (n := t.embedding.dim) (baseSet B b t) s).toRingHom.comp
    ((baseMap B b t).stalkMap s).hom) _ = _
  rw [← Ideal.map_map, hF, Ideal.map_span, Ideal.map_span, ← Set.range_comp, ← Set.range_comp]
  congr 2
  funext i
  exact (inclusion_stalk_chart (m := t.embedding.dim) (baseSet B b t) s _).trans
    (congrArg (Ideal.Quotient.mk _) (actualOriginalFunctionGerm_chart s.val _ _))

variable (d : CanonicalTargetNormalSectionData B b t)

/-- **P5: a pivot strict chart point over the centre has zero pivot coordinate.** -/
theorem pivot_zero [LocallyRingedSpace.IsOpenImmersion (targetCanonicalMap B b t e).hom.left]
    (hnorm : TargetExplicitNormalLaws B b t d e)
    (hne : centre B b ((OriginalFiniteIdealGeometricBlowup.projectionMorphism B b).hom.left.base
      ((chartMap B b t e j).base p)) ≠ ⊤) :
    coords B b t e j p (j.natAdd t.embedding.dim) = 0 := by
  have hwh := hnorm.whole_ideal ((strictChartInclusion e.charts (graph B b t) j).base p)
  have hcent : nativePulledIdealStalkIdeal (OriginalFiniteIdealGeometricBlowup.projectionMorphism B b).hom.left
      B b ((targetCanonicalMap B b t e).hom.left.base ((strictChartInclusion e.charts (graph B b t) j).base p)) ≠ ⊤ :=
    @map_ne_top_of_ne_top _ _ _ _ (LocallyRingedSpace.isLocalRing _ _) (LocallyRingedSpace.isLocalRing _ _)
      _ (LocallyRingedSpace.isLocalHomStalkMap _ _) _ hne
  have hne' : CompatibleCanonicalIdealBlowupPivotChart.strictCentreStalkIdeal (graph B b t) ((strictChartInclusion e.charts (graph B b t) j).base p) ≠ ⊤ :=
    fun htop => @map_ne_top_of_ne_top _ _ _ _ (LocallyRingedSpace.isLocalRing _ _)
      ((explicitTarget B b t).obj.left.isLocalRing _) _
      (LocallyRingedSpace.isLocalHomStalkMap (targetCanonicalMap B b t e).hom.left _) _ hcent (hwh.trans htop)
  exact pivot_coordinate_eq_zero_of_ne_top e.charts t.positive (graph B b t) t.analytic.isClosed j p hne'

/-- **N5.b at a pivot strict chart point over the centre**: the native stalk map of the geometric blowup map is a
graph-chart presentation with centre `b·𝒪_{X,π y}`. -/
theorem presentation_at (hmap : TargetExplicitMapLaws B b t d e) (hnorm : TargetExplicitNormalLaws B b t d e)
    (hne : centre B b ((OriginalFiniteIdealGeometricBlowup.projectionMorphism B b).hom.left.base
      ((chartMap B b t e j).base p)) ≠ ⊤) :
    GraphChartPresentation
      (((OriginalFiniteIdealGeometricBlowup.projectionMorphism B b).hom.left.stalkMap
        ((chartMap B b t e j).base p)).hom)
      (centre B b ((OriginalFiniteIdealGeometricBlowup.projectionMorphism B b).hom.left.base
        ((chartMap B b t e j).base p))) := by
  have := hmap.open_immersion
  have hvj := pivot_zero B b t e j p d hnorm hne
  have h := graphChartPresentation_of_square (proj_contMDiff B b t e j p hvj) (proj_mem B b t e j p hvj)
    (OriginalFiniteIdealGeometricBlowup.projectionMorphism B b).hom.left (baseMap B b t)
    (targetMap B b t e j p hvj) (square B b t e j p hvj d hmap) t.positive
    (fibreVec (coords B b t e j p)) j
    (graphGerms (graphFun B b t e j p hvj) (graphFun_differentiable B b t e j p hvj))
    (originPt B b t e j p hvj) (strict_eq_chartIdeal B b t e j p hvj) (pullback_proj B b t e j p hvj)
    _ (centre_eq B b t e j p hvj)
  exact presentation_of_fibreMap (OriginalFiniteIdealGeometricBlowup.projectionMorphism B b).hom.left
    (centre B b) _ _ (targetMap_origin B b t e j p hvj) _ _ h

end

