import Hironaka.Analytic.Unibranch.HironakaG10LfCyclicFlat
import Mathlib.LinearAlgebra.Matrix.ToLin

/-!
# Cyclic pieces of a cokernel modulo an ideal, from exact starts of its lower blocks (route N, item N4)

Lane G10GN, run 0081 (`work/hironaka-run0081-20261117/G10GN/hGF-route.md`, item G10GN-N4). Pure algebra. Let
`A` be an `a × b` matrix over a commutative ring `B`, `J` an ideal and, for a row index `i`, `Gᵢ` an exact start
modulo `J` of the block of rows `> i` of `A` (every vector killed modulo `J` by the rows `> i` is a combination of
the columns of `Gᵢ` modulo `J`, and the rows `> i` kill the columns of `Gᵢ` modulo `J`). Then
**`cyclicIdeal_range_eq`**: the `i`-th cyclic ideal (lane G10LF's `cyclicIdeal`) of the image of `A` in
`(B ⧸ J)ᵃ` is generated by the entries of the `i`-th row of `A Gᵢ`.

No named input. BP: hironaka-g10gn-hgf.tex.
-/

set_option autoImplicit false

open Function

namespace Hironaka.Analytic.Unibranch.HironakaG10GnCyclicStart

open Hironaka.Analytic.Unibranch.HironakaG10LfCyclicFlat

variable {B : Type*} [CommRing B]

theorem mulVecLin_map_mk {a b : ℕ} (J : Ideal B) (A : Matrix (Fin a) (Fin b) B) (u : Fin b → B) (l : Fin a) :
    (A.map (Ideal.Quotient.mk J)).mulVecLin (fun j => Ideal.Quotient.mk J (u j)) l =
      Ideal.Quotient.mk J (∑ j, A l j * u j) := by
  simp only [Matrix.mulVecLin_apply, Matrix.mulVec, dotProduct, Matrix.map_apply, map_sum, map_mul]

/-- **The cyclic ideals of a cokernel modulo `J`.** -/
theorem cyclicIdeal_range_eq {a b c : ℕ} (J : Ideal B) (A : Matrix (Fin a) (Fin b) B) (i : Fin a)
    (Gi : Matrix (Fin b) (Fin c) B)
    (hcomp : ∀ l, i < l → ∀ k, ∑ j, A l j * Gi j k ∈ J)
    (hexact : ∀ v : Fin b → B, (∀ l, i < l → ∑ j, A l j * v j ∈ J) →
      ∃ w : Fin c → B, ∀ j, v j - ∑ k, Gi j k * w k ∈ J) :
    cyclicIdeal (LinearMap.range (A.map (Ideal.Quotient.mk J)).mulVecLin) i =
      (Ideal.span (Set.range fun k => ∑ j, A i j * Gi j k)).map (Ideal.Quotient.mk J) := by
  apply le_antisymm
  · rintro f ⟨v, ⟨ū, rfl⟩, rfl, hv0⟩
    choose u hu using fun j => Ideal.Quotient.mk_surjective (ū j)
    have hū : ū = fun j => Ideal.Quotient.mk J (u j) := funext fun j => (hu j).symm
    subst hū
    have hlow : ∀ l, i < l → ∑ j, A l j * u j ∈ J := by
      intro l hl
      have := hv0 l hl
      rw [mulVecLin_map_mk] at this
      exact Ideal.Quotient.eq_zero_iff_mem.mp this
    obtain ⟨w, hw⟩ := hexact u hlow
    rw [mulVecLin_map_mk]
    have hsplit : ∑ j, A i j * u j = ∑ k, (∑ j, A i j * Gi j k) * w k +
        ∑ j, A i j * (u j - ∑ k, Gi j k * w k) := by
      simp only [mul_sub, Finset.sum_sub_distrib, Finset.mul_sum, Finset.sum_mul]
      rw [Finset.sum_comm (f := fun k j => A i j * Gi j k * w k)]
      simp only [mul_assoc, add_sub_cancel]
    rw [hsplit, map_add]
    have h2 : Ideal.Quotient.mk J (∑ j, A i j * (u j - ∑ k, Gi j k * w k)) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (J.sum_mem fun j _ => J.mul_mem_left _ (hw j))
    rw [h2, add_zero]
    apply Ideal.mem_map_of_mem
    exact Ideal.sum_mem _ fun k _ => Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨k, rfl⟩)
  · rw [Ideal.map_le_iff_le_comap, Ideal.span_le]
    rintro _ ⟨k, rfl⟩
    refine ⟨(A.map (Ideal.Quotient.mk J)).mulVecLin (fun j => Ideal.Quotient.mk J (Gi j k)),
      ⟨_, rfl⟩, ?_, fun l hl => ?_⟩
    · rw [mulVecLin_map_mk]
    · rw [mulVecLin_map_mk]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (hcomp l hl k)

end Hironaka.Analytic.Unibranch.HironakaG10GnCyclicStart
