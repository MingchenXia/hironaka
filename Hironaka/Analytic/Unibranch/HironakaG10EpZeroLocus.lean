/-!
# Zero loci of locally finitely generated ideal families are analytic (G10-03-09.a.1)

Run 0081 lane G10EP.  Blueprint: `hironaka-g10ep-zero-locus.tex`.

For a family `J` of stalk ideals of a reduced complex space `X` which is locally finitely generated on
an open set `V` (`HironakaG10HirIdealGerms.IsLocallyFinitelyGeneratedOn`), the zero locus
`{x ∈ V | J x ≠ ⊤}` is locally analytic on `V` (`isLocallyAnalyticOn_zeroLocus`); for `V = univ` the
zero locus is an analytic subset of `X` (`isAnalyticSubset_zeroLocus`).

Proof: near `x`, `J` is generated by the germs of finitely many sections `s_i` of `𝒪_X`, so `J y ≠ ⊤`
iff every germ `s_{i,y}` lies in the maximal ideal.  In a local embedding `(Ω, C) → X` with image in
the domain of the `s_i`, the pulled-back sections are restrictions of holomorphic functions `t_i` on an
ambient open set (`exists_finite_ambient_sections`), and a germ lies in the maximal ideal iff its
residue value vanishes (`actualSubspaceStalkEval_ker`, `actualSubspaceStalkEval_inclusion_germ`).  On
the chart restricted to that ambient open set, the trace of the zero locus is the common zero set of
the `t_i`, an analytic set.
-/

set_option autoImplicit false

open Set TopologicalSpace CategoryTheory AlgebraicGeometry Opposite
open scoped Topology Manifold ContDiff

namespace Hironaka.Analytic.Unibranch.HironakaG10EpZeroLocus

open Hironaka Hironaka
  HironakaReducedComplexAnalyticSpaces HironakaActualAnalyticSubspace
  HironakaSmoothCentreRealDomainActualSheafStalk HironakaG10HirIdealGerms
  SourceReducedComplexSpace HironakaG10LocallyAnalyticTrace HironakaSingularModuleSheafStalk

noncomputable section

local instance actualStalkLocal {n : ℕ} {M : Type} [TopologicalSpace M]
    [ChartedSpace (ComplexModel n) M] [IsComplexManifold n M] (C : Set M) (x : C) :
    IsLocalRing ((actualSubspaceSheaf (n := n) C).presheaf.stalk x).carrier :=
  actualSubspaceStalk_isLocalRing (n := n) C x

/-- The zero locus of a family of stalk ideals: the points where the ideal is proper. -/
def zeroLocus {X : LocallyRingedSpace.{0}} (J : ∀ x : X, Ideal (X.presheaf.stalk x)) : Set X :=
  {x | J x ≠ ⊤}

theorem mem_zeroLocus_iff_le_maximalIdeal {X : LocallyRingedSpace.{0}}
    (J : ∀ x : X, Ideal (X.presheaf.stalk x)) (x : X) :
    x ∈ zeroLocus J ↔ J x ≤ IsLocalRing.maximalIdeal (X.presheaf.stalk x) := by
  constructor
  · exact IsLocalRing.le_maximalIdeal
  · intro h htop
    apply (IsLocalRing.maximalIdeal.isMaximal (X.presheaf.stalk x)).ne_top
    rw [eq_top_iff, ← htop]
    exact h

/-- In a local ring, the ideal spanned by finitely many elements is proper iff all of them lie in
the maximal ideal. -/
theorem span_range_ne_top_iff {R : Type*} [CommRing R] [IsLocalRing R] {ι : Type*} (g : ι → R) :
    Ideal.span (range g) ≠ ⊤ ↔ ∀ i, g i ∈ IsLocalRing.maximalIdeal R := by
  constructor
  · intro h i
    exact IsLocalRing.le_maximalIdeal h (Ideal.subset_span ⟨i, rfl⟩)
  · intro h htop
    have hle : Ideal.span (range g) ≤ IsLocalRing.maximalIdeal R :=
      Ideal.span_le.mpr (by rintro _ ⟨i, rfl⟩; exact h i)
    apply (IsLocalRing.maximalIdeal.isMaximal R).ne_top
    rw [eq_top_iff, ← htop]
    exact hle

/-- Stalk maps of locally ringed spaces preserve and reflect the maximal ideals. -/
theorem stalkMap_mem_maximalIdeal_iff {A B : LocallyRingedSpace.{0}} (f : A ⟶ B) (a : A)
    (g : B.presheaf.stalk (f.base a)) :
    (f.stalkMap a).hom g ∈ IsLocalRing.maximalIdeal (A.presheaf.stalk a) ↔
      g ∈ IsLocalRing.maximalIdeal (B.presheaf.stalk (f.base a)) := by
  rw [IsLocalRing.mem_maximalIdeal, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
    mem_nonunits_iff]
  exact not_congr (isUnit_map_iff (f.stalkMap a).hom g)

/-- The holomorphic vector of finitely many ambient sections along a map into their domain, through
their total representatives. -/
def sectionVector {n k : ℕ} {M : Type} [TopologicalSpace M] [ChartedSpace (ComplexModel n) M]
    (O : Opens M) (t : Fin k → actualComplexSection (n := n) O) {P : Type} (ι : P → M) :
    P → ComplexModel k :=
  fun z => WithLp.toLp 2 (fun i => sectionExtension O (t i) (ι z))

theorem sectionVector_contMDiff {n k : ℕ} {M : Type} [TopologicalSpace M]
    [ChartedSpace (ComplexModel n) M] (O : Opens M) (t : Fin k → actualComplexSection (n := n) O)
    {m : ℕ} {P : Type} [TopologicalSpace P] [ChartedSpace (ComplexModel m) P] {ι : P → M}
    (hι : ContMDiff 𝓘(ℂ, ComplexModel m) 𝓘(ℂ, ComplexModel n) ∞ ι) (hιO : ∀ z, ι z ∈ O) :
    ContMDiff 𝓘(ℂ, ComplexModel m) 𝓘(ℂ, ComplexModel k) ∞ (sectionVector O t ι) := by
  let E := (PiLp.continuousLinearEquiv 2 ℂ (fun _ : Fin k => ℂ)).symm
  have ht : ContMDiff 𝓘(ℂ, ComplexModel m) 𝓘(ℂ, Fin k → ℂ) ∞
      (fun z : P => fun i => sectionExtension O (t i) (ι z)) := by
    refine contMDiff_pi_space.mpr fun i => ?_
    intro z
    exact (sectionExtension_contMDiffAt O (t i) (ι z) (hιO z)).comp z (hι z)
  exact E.toContinuousLinearMap.contMDiff.comp ht

theorem sectionVector_eq_zero_iff {n k : ℕ} {M : Type} [TopologicalSpace M]
    [ChartedSpace (ComplexModel n) M] (O : Opens M) (t : Fin k → actualComplexSection (n := n) O)
    {P : Type} (ι : P → M) (z : P) :
    sectionVector O t ι z = 0 ↔ ∀ i, sectionExtension O (t i) (ι z) = 0 := by
  constructor
  · intro h i
    have := congrArg (fun v : ComplexModel k => v i) h
    simpa [sectionVector] using this
  · intro h
    ext i
    simpa [sectionVector] using h i

/-- **Zero loci of locally finitely generated ideal families are locally analytic.** -/
theorem isLocallyAnalyticOn_zeroLocus {X : SourceReducedComplexSpace} {V : Set X.obj.left}
    (hV : IsOpen V) {J : ∀ x : X.obj.left, Ideal (X.obj.left.presheaf.stalk x)}
    (hJ : IsLocallyFinitelyGeneratedOn X.obj.left V J) :
    IsLocallyAnalyticOn X V (V ∩ zeroLocus J) := by
  intro x hxV
  obtain ⟨W, hxW, r, s, hs⟩ := hJ x hxV
  obtain ⟨e, ⟨c₀, hc₀⟩, heWV, -⟩ :=
    LocalEmbedding.exists_domain x (W.isOpen.inter hV) ⟨hxW, hxV⟩
  -- the sections pulled back to the model
  let U' : Opens (TopCat.of e.carrier) := (Opens.map e.map.base).obj W
  have hU' : ∀ c : e.carrier, c ∈ U' := fun c => (heWV ⟨c, rfl⟩).1
  let u : Fin r → ((actualSubspaceSheaf (n := e.dim) e.carrier).presheaf.obj (op U')).carrier :=
    fun i => e.map.c.app (op W) (s i)
  obtain ⟨O, hc₀O, t, hOV, ht⟩ :=
    HironakaFiniteSectionGraph.exists_finite_ambient_sections e.carrier U' u c₀ (hU' c₀)
  -- the ambient open set as an open set of the coordinate space
  let T : Opens (ComplexModel e.dim) :=
    ⟨Subtype.val '' (O : Set e.ambient), e.ambient.isOpen.isOpenMap_subtype_val _ O.isOpen⟩
  have hT : T ≤ e.ambient := by
    rintro _ ⟨z, -, rfl⟩
    exact z.property
  have hmemO : ∀ p : T, Opens.inclusion hT p ∈ O := by
    rintro ⟨_, ⟨w, hw, rfl⟩⟩
    exact hw
  -- the key equivalence on the model
  have hkey : ∀ c : e.carrier, c.val ∈ O →
      (e.toPoint c ∈ V ∩ zeroLocus J ↔ ∀ i, sectionExtension O (t i) c.val = 0) := by
    intro c hcO
    have hcW : e.toPoint c ∈ W := (heWV ⟨c, rfl⟩).1
    have hcV : e.toPoint c ∈ V := (heWV ⟨c, rfl⟩).2
    have hJc := hs (e.toPoint c) hcW hcV
    have hloc : ∀ i, X.obj.left.presheaf.germ W (e.toPoint c) hcW (s i) ∈
        IsLocalRing.maximalIdeal (X.obj.left.presheaf.stalk (e.toPoint c)) ↔
          sectionExtension O (t i) c.val = 0 := by
      intro i
      have h1 := stalkMap_mem_maximalIdeal_iff e.map c
        (X.obj.left.presheaf.germ W (e.map.base c) hcW (s i))
      rw [LocallyRingedSpace.stalkMap_germ_apply e.map W c hcW (s i)] at h1
      refine h1.symm.trans ?_
      change (actualSubspaceSheaf (n := e.dim) e.carrier).presheaf.germ U' c (hU' c) (u i) ∈
        IsLocalRing.maximalIdeal
          ((actualSubspaceSheaf (n := e.dim) e.carrier).presheaf.stalk c).carrier ↔ _
      rw [ht i c hcO, ← HironakaActualAnalyticSubspaceResidue.actualSubspaceStalkEval_ker,
        RingHom.mem_ker,
        HironakaActualAnalyticSubspaceLocalFunctions.actualSubspaceStalkEval_inclusion_germ,
        sectionExtension_apply O (t i) c.val hcO]
    constructor
    · rintro ⟨-, hz⟩ i
      change J (e.toPoint c) ≠ ⊤ at hz
      rw [hJc] at hz
      exact (hloc i).mp ((span_range_ne_top_iff _).mp hz i)
    · intro h
      refine ⟨hcV, ?_⟩
      change J (e.toPoint c) ≠ ⊤
      rw [hJc]
      exact (span_range_ne_top_iff _).mpr fun i => (hloc i).mpr (h i)
  -- the restricted chart and the common zero set
  have hι : ContMDiff 𝓘(ℂ, ComplexModel e.dim) 𝓘(ℂ, ComplexModel e.dim) ∞
      (Opens.inclusion hT) := contMDiff_inclusion hT
  have hg := sectionVector_contMDiff O t hι hmemO
  refine ⟨e.restrict T hT, ?_, sectionVector O t (Opens.inclusion hT) ⁻¹' {0},
    AnalyticSubsetPreimage.isComplexAnalyticSubset_preimage hg
      (FibreDimensionLowerBound.isComplexAnalyticSubset_singleton 0), ?_⟩
  · have hc₀T : c₀.val.val ∈ T := ⟨c₀.val, hc₀O, rfl⟩
    exact ⟨⟨⟨c₀.val.val, hc₀T⟩, c₀.property⟩, hc₀⟩
  · ext z
    change e.toPoint ⟨Opens.inclusion hT z.val, z.property⟩ ∈ V ∩ zeroLocus J ↔
      sectionVector O t (Opens.inclusion hT) z.val ∈ ({0} : Set (ComplexModel r))
    rw [mem_singleton_iff]
    exact (hkey _ (hmemO z.val)).trans (sectionVector_eq_zero_iff O t (Opens.inclusion hT) z.val).symm

/-- **Zero loci of locally finitely generated ideal families are analytic** (`V = univ`). -/
theorem isAnalyticSubset_zeroLocus {X : SourceReducedComplexSpace}
    {J : ∀ x : X.obj.left, Ideal (X.obj.left.presheaf.stalk x)}
    (hJ : IsLocallyFinitelyGeneratedOn X.obj.left univ J) : X.IsAnalyticSubset (zeroLocus J) := by
  intro x
  obtain ⟨e, hx, A', hA', htr⟩ := isLocallyAnalyticOn_zeroLocus isOpen_univ hJ x (mem_univ x)
  refine ⟨e, hx, A', hA', ?_⟩
  rw [← htr, univ_inter]

/-- The zero locus in the form `{x | J x ≤ 𝔪_x}`. -/
theorem isAnalyticSubset_setOf_le_maximalIdeal {X : SourceReducedComplexSpace}
    {J : ∀ x : X.obj.left, Ideal (X.obj.left.presheaf.stalk x)}
    (hJ : IsLocallyFinitelyGeneratedOn X.obj.left univ J) :
    X.IsAnalyticSubset {x | J x ≤ IsLocalRing.maximalIdeal (X.obj.left.presheaf.stalk x)} := by
  have h : {x | J x ≤ IsLocalRing.maximalIdeal (X.obj.left.presheaf.stalk x)} = zeroLocus J := by
    ext x
    exact (mem_zeroLocus_iff_le_maximalIdeal J x).symm
  rw [h]
  exact isAnalyticSubset_zeroLocus hJ

/-! ### Nonunit loci of finite-type ideals -/

/-- The stalk images of a finite-type ideal `b : B ⟶ 𝒪_X` form a locally finitely generated family. -/
theorem isLocallyFinitelyGeneratedOn_stalkRange {X : LocallyRingedSpace.{0}}
    (B : SheafOfModules.{0} (forgetRing X.toSheafedSpace.sheaf))
    (b : B ⟶ SheafOfModules.unit (forgetRing X.toSheafedSpace.sheaf)) [B.IsFiniteType] :
    IsLocallyFinitelyGeneratedOn X univ
      (fun x => (LinearMap.range (stalkInclusionLinearMap X.toSheafedSpace.sheaf B b x) :)) := by
  intro x _
  obtain ⟨U, hx, r, s, -, hspan⟩ := HironakaNativeFiniteIdealSections.exists_finite_ideal_sections B b x
  exact ⟨U, hx, r, fun i => b.val.app (op U) (s i), fun y hy _ => hspan y hy⟩

/-- **The nonunit locus of a finite-type ideal is analytic.** -/
theorem isAnalyticSubset_nonunitLocus {X : SourceReducedComplexSpace}
    (B : SheafOfModules.{0} (forgetRing X.obj.left.toSheafedSpace.sheaf))
    (b : B ⟶ SheafOfModules.unit (forgetRing X.obj.left.toSheafedSpace.sheaf)) [B.IsFiniteType] :
    X.IsAnalyticSubset (EmbeddedIdealBlowupNonunitLocus.nonunitLocus B b) :=
  isAnalyticSubset_zeroLocus (isLocallyFinitelyGeneratedOn_stalkRange B b)

end

