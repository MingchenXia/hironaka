import Hironaka.Analytic.Unibranch.HironakaG10ChowStrictTorsionFree
import Hironaka.Analytic.Unibranch.EmbeddedIdealBlowupGlobalCartier

/-!
# Product centres resolve every factor (route step N7, the invariant (RR))

Route step N7 of the global flattening algorithm
(`work/hironaka-resume-20261111/G10C/GLOBAL-FLATTENING-ROUTE.md` §3.3a, §3.3b).  The termination
argument (`HironakaG10ChowFibreChain`) consumes the invariant **(RR)**: after blowing up the centre,
the pull-back of the pointed canonical flattener `I_{T_s}` at every point over `s` is principal with a
regular generator.  McQuillan's mechanism (*Flattening and algebrisation*, arXiv:2412.00998,
Definition 5.1 and the proof of Fact 5.2: "étale locally, the Fitting ideal of the compactification
decomposes as a product `J_s^* · (stuff)`, so the blow up in the fitted flatifier factors through the
blow up in the pointed flatifier") is the following elementary fact: **in a local ring, a factor of
an invertible product is invertible.**

* `exists_regular_generator_of_mul_eq` — if `I * K = (a)` with `a` a nonzerodivisor of a local ring,
  then `I = (i)` with `i` a nonzerodivisor;
* `exists_regular_generator_map_of_mul_eq` — the same for pull-backs along a ring map;
* `stepProj_pulledIdeal_regular` — the ideal of the centre pulls back, on the blowup
  `σ : Bl_B X ⟶ X`, to an ideal generated by a nonzerodivisor at every point;
* `stepProj_factor_regular` — **(RR) for product centres**: if the stalk of the centre at `σ x'` is a
  product `I * K`, then `σ^♯ I` is principal with a regular generator at `x'`.

So a centre rule whose centre has, at every point `s` of the non-flat image, a stalk of the form
`I_{T_s} · K_s` satisfies (RR) after ONE blowup, at every point over the centre (no case (B2)).
-/

set_option autoImplicit false

open Set TopologicalSpace CategoryTheory AlgebraicGeometry IsLocalRing

namespace Hironaka.Analytic.Unibranch.HironakaG10ChowProductCentre

open Hironaka HironakaSingularModuleSheafStalk HironakaNativePulledIdealSheaf
  SourceReducedComplexSpace HironakaG10ChowOneStepStrictTransform

noncomputable section

section Algebra

variable {R : Type*} [CommRing R] [IsLocalRing R]

/-- **A factor of an invertible product is invertible** (local ring): if `I * K = (a)` with `a` a
nonzerodivisor, then `I` is generated by one nonzerodivisor. -/
theorem exists_regular_generator_of_mul_eq {I K : Ideal R} {a : R} (ha : IsRegular a)
    (h : I * K = Ideal.span {a}) : ∃ i : R, I = Ideal.span {i} ∧ IsRegular i := by
  classical
  -- some product `i₀ k₀` is a unit multiple of `a`
  have hex : ∃ i ∈ I, ∃ k ∈ K, i * k ∉ Ideal.span {a} * maximalIdeal R := by
    by_contra hcon
    simp only [not_exists, not_and, not_not] at hcon
    have hle : I * K ≤ Ideal.span {a} * maximalIdeal R := Ideal.mul_le.mpr hcon
    have ha' : a ∈ Ideal.span {a} * maximalIdeal R := hle (h ▸ Ideal.mem_span_singleton_self a)
    obtain ⟨t, ht, hat⟩ := Ideal.mem_span_singleton_mul.mp ha'
    have h1 : a * (1 - t) = a * 0 := by rw [mul_sub, mul_one, hat, sub_self, mul_zero]
    have ht1 : t = 1 := (sub_eq_zero.mp (ha.left h1)).symm
    exact (maximalIdeal.isMaximal R).ne_top ((Ideal.eq_top_iff_one _).mpr (ht1 ▸ ht))
  obtain ⟨i₀, hi₀, k₀, hk₀, hnot⟩ := hex
  have hmem : i₀ * k₀ ∈ Ideal.span {a} := h ▸ Ideal.mul_mem_mul hi₀ hk₀
  obtain ⟨r, hr⟩ := Ideal.mem_span_singleton'.mp hmem
  have hru : IsUnit r := by
    by_contra hr'
    exact hnot (Ideal.mem_span_singleton_mul.mpr
      ⟨r, (IsLocalRing.mem_maximalIdeal r).mpr hr', by rw [← hr, mul_comm]⟩)
  obtain ⟨u, rfl⟩ := hru
  -- `i₀` is a nonzerodivisor
  have hl : IsLeftRegular i₀ := by
    intro y y' hyy
    have h0 : i₀ * (y - y') = 0 := by
      rw [mul_sub]
      exact sub_eq_zero.mpr hyy
    have h2 : a * (↑u * (y - y')) = a * 0 := by
      rw [mul_zero, ← mul_assoc, mul_comm a, hr, mul_comm i₀, mul_assoc, h0, mul_zero]
    have h3 : (↑u : R) * (y - y') = 0 := ha.left h2
    have h4 : y - y' = 0 := by
      have := congrArg (fun x => (↑u⁻¹ : R) * x) h3
      simpa [← mul_assoc] using this
    exact sub_eq_zero.mp h4
  refine ⟨i₀, le_antisymm ?_ ((Ideal.span_singleton_le_iff_mem I).mpr hi₀),
    ⟨hl, fun y y' h => hl (by simpa only [mul_comm] using h)⟩⟩
  intro x hx
  have hxk : x * k₀ ∈ Ideal.span {a} := h ▸ Ideal.mul_mem_mul hx hk₀
  obtain ⟨s, hs⟩ := Ideal.mem_span_singleton'.mp hxk
  -- `a (x u - i₀ s) = 0`
  have h1 : a * (x * ↑u) = a * (i₀ * s) := by
    calc a * (x * ↑u) = x * (↑u * a) := by ring
      _ = x * (i₀ * k₀) := by rw [hr]
      _ = i₀ * (x * k₀) := by ring
      _ = i₀ * (s * a) := by rw [hs]
      _ = a * (i₀ * s) := by ring
  have h2 : x * ↑u = i₀ * s := ha.left h1
  refine Ideal.mem_span_singleton'.mpr ⟨s * ↑u⁻¹, ?_⟩
  calc s * ↑u⁻¹ * i₀ = (i₀ * s) * ↑u⁻¹ := by ring
    _ = (x * ↑u) * ↑u⁻¹ := by rw [h2]
    _ = x := by rw [mul_assoc, Units.mul_inv, mul_one]

/-- **Pull-backs**: if the pull-back of a product is principal with a regular generator, so is the
pull-back of each factor. -/
theorem exists_regular_generator_map_of_mul_eq {A : Type*} [CommRing A] (φ : A →+* R)
    {I K : Ideal A} {a : R} (ha : IsRegular a) (h : Ideal.map φ (I * K) = Ideal.span {a}) :
    ∃ i : R, Ideal.map φ I = Ideal.span {i} ∧ IsRegular i :=
  exists_regular_generator_of_mul_eq (K := Ideal.map φ K) ha (by rw [← Ideal.map_mul]; exact h)

end Algebra

section Native

variable {X : SourceReducedComplexSpace}
  (B : SheafOfModules.{0} (forgetRing X.obj.left.toSheafedSpace.sheaf))
  (b : B ⟶ SheafOfModules.unit (forgetRing X.obj.left.toSheafedSpace.sheaf))
  [B.IsFiniteType]
  (hDense : Dense {x : X.obj.left |
    LinearMap.range (stalkInclusionLinearMap X.obj.left.toSheafedSpace.sheaf B b x) = ⊤})

/-- **The centre becomes Cartier**: on the blowup `σ : Bl_B X ⟶ X` the pulled ideal of `B` is
generated at every point by one nonzerodivisor. -/
theorem stepProj_pulledIdeal_regular (x' : (OriginalFiniteIdealBlowup.sourceObject B b hDense).obj.left) :
    ∃ e : ((OriginalFiniteIdealBlowup.sourceObject B b hDense).obj.left.presheaf.stalk x').carrier,
      nativePulledIdealStalkIdeal (stepProj B b hDense).hom.left B b x' = Ideal.span {e} ∧
        IsRegular e := by
  unfold stepProj OriginalFiniteIdealBlowup.projectionMorphism
  obtain ⟨U, hxU, s, hs⟩ :=
    EmbeddedIdealBlowupGlobalCartier.exists_local_projection_ideal_generator _ _ _ B b _ _ x'
  exact ⟨_, hs x' hxU⟩

/-- **(RR) for product centres.**  If the stalk of the centre at `σ x'` is a product `I * K`, then
the pull-back of `I` to `x'` is principal with a regular generator. -/
theorem stepProj_factor_regular (x' : (OriginalFiniteIdealBlowup.sourceObject B b hDense).obj.left)
    (I K : Ideal (X.obj.left.presheaf.stalk ((stepProj B b hDense).hom.left.base x')).carrier)
    (hIK : LinearMap.range (stalkInclusionLinearMap X.obj.left.toSheafedSpace.sheaf B b
      ((stepProj B b hDense).hom.left.base x')) = I * K) :
    ∃ i : ((OriginalFiniteIdealBlowup.sourceObject B b hDense).obj.left.presheaf.stalk x').carrier,
      Ideal.map ((stepProj B b hDense).hom.left.stalkMap x').hom I = Ideal.span {i} ∧
        IsRegular i := by
  obtain ⟨e, he, hreg⟩ := stepProj_pulledIdeal_regular B b hDense x'
  refine exists_regular_generator_map_of_mul_eq _ (K := K) hreg ?_
  rw [← hIK]
  exact he

end Native

end

end Hironaka.Analytic.Unibranch.HironakaG10ChowProductCentre
