import Hironaka.Analytic.Unibranch.HironakaG10HtStrictSaturation
import Hironaka.Analytic.Unibranch.HironakaG10HtPolynomialGermFlat
import Mathlib.RingTheory.Flat.EquationalCriterion
import Mathlib.RingTheory.Localization.Away.Basic

/-!
# N5.c2 — the strict ideal is saturated on a flat graph chart of a blowup

Lane G10HT, run 0081, sub-item N5.c2 of `G10HT/hT-route-decision.md` (Hironaka 1975, Lemma 3.2, printed p. 532: "It
is known that the ideal of the strict transform … is generated by those elements `G^{-k} h` …").

Setting (the graph chart of the blowup of `V(IX) ⊆ Spec B` along `D = (g_0, …, g_{n-1})`, pivot `j`): the algebraic Rees
chart is `B[X] ⧸ L`, `L = IX·B[X] + (X_j − g_j) + (X_j X_i − g_i)_{i ≠ j}` (`relIdeal`); a ring map `ev : B[X] → H`
(e.g. `HironakaG10HtPolynomialGermFlat.evPoly`) carries it to `H ⧸ K`, `K = (ev(L) : ev(X_j)^∞)` (`chartIdeal`), with
chart map `chartMap : B ⧸ IX → H ⧸ K` and exceptional equation `G = ev(X_j)`.

* `reduce` — every polynomial times a power of `X_j` is, modulo `L`, a constant in `D^N`;
* `kernel` — a constant in `L + I·B[X]` is killed by a power of `g_j` modulo `I` (`IX ≤ I`);
* `flat_powerSat_le` — saturations commute with a flat ring map (equational criterion);
* **`chart_strictIdeal_eq_powerSat`** — if `ev` is flat and `B` Noetherian, then for every ideal `I ⊇ IX` the
  algebraic strict ideal of `I ⧸ IX` (centre `D`, equation `G`) is the whole `G`-saturation of its total transform.

Pure commutative algebra; no named input.
-/

set_option autoImplicit false

namespace Hironaka.Analytic.Unibranch.HironakaG10HtChartSaturation

open MvPolynomial
open Hironaka.HironakaG10ChowArtinReesCentre
  Hironaka.Analytic.Unibranch.HironakaG10SbTorsionSaturation Hironaka.Analytic.Unibranch.HironakaG10HtStrictSaturation

noncomputable section

/-! ### Saturation and flat ring maps -/

/-- **Saturations commute with flat ring maps** (one inclusion; the other is `map_powerSat_le`). -/
theorem flat_powerSat_le {P H : Type*} [CommRing P] [CommRing H] [IsNoetherianRing P]
    (f : P →+* H) (hf : f.Flat) (J : Ideal P) (s : P) :
    powerSat (Ideal.map f J) (f s) ≤ Ideal.map f (powerSat J s) := by
  intro a ha
  obtain ⟨m, hm⟩ := mem_powerSat.mp ha
  obtain ⟨k, G, hG⟩ := Submodule.fg_iff_exists_fin_generating_family.mp (IsNoetherian.noetherian J)
  have hspan : Ideal.span (Set.range G) = J := hG
  have hmapspan : Ideal.map f J = Ideal.span (Set.range fun i => f (G i)) := by
    rw [← hspan, Ideal.map_span, ← Set.range_comp]
    rfl
  rw [hmapspan] at hm
  obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hm
  let _ : Algebra P H := f.toAlgebra
  have hflat : Module.Flat P H := hf
  -- the relation `s^m • a + ∑ G i • (-c i) = 0`
  let fr : Fin (k + 1) → P := Fin.cons (s ^ m) G
  let xr : Fin (k + 1) → H := Fin.cons a fun i => -c i
  have hrel : ∑ i, fr i • xr i = 0 := by
    rw [Fin.sum_univ_succ]
    simp only [fr, xr, Fin.cons_zero, Fin.cons_succ, Algebra.smul_def, RingHom.algebraMap_toAlgebra,
      map_pow, mul_neg, Finset.sum_neg_distrib]
    rw [← hc]
    simp only [mul_comm (c _)]
    ring
  obtain ⟨q, A, y, hxy, hA⟩ := Module.Flat.iff_forall_isTrivialRelation.mp hflat hrel
  have h0 : a = ∑ l, A 0 l • y l := by simpa [xr] using hxy 0
  rw [h0]
  refine Ideal.sum_mem _ fun l _ => ?_
  rw [Algebra.smul_def, RingHom.algebraMap_toAlgebra]
  refine Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem f (mem_powerSat.mpr ⟨m, ?_⟩))
  have hl := hA l
  rw [Fin.sum_univ_succ] at hl
  simp only [fr, Fin.cons_zero, Fin.cons_succ] at hl
  have hsum : ∑ i, G i * A i.succ l ∈ J := by
    rw [← hspan]
    exact Ideal.sum_mem _ fun i _ => Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨i, rfl⟩)
  have : s ^ m * A 0 l = -∑ i, G i * A i.succ l := eq_neg_of_add_eq_zero_left hl
  rw [this]
  exact J.neg_mem hsum

/-! ### The graph chart -/

section Chart

variable {B H : Type*} [CommRing B] [CommRing H] {n : ℕ}

/-- The Rees-chart relations `IX, X_j − g_j, X_j X_i − g_i (i ≠ j)` of the graph chart. -/
def relIdeal (j : Fin n) (g : Fin n → B) (IX : Ideal B) : Ideal (MvPolynomial (Fin n) B) :=
  Ideal.map (C : B →+* MvPolynomial (Fin n) B) IX ⊔
    Ideal.span (Set.range fun i => (if i = j then X j else X j * X i) - C (g i))

theorem C_mem_relIdeal (j : Fin n) (g : Fin n → B) (IX : Ideal B) {x : B} (hx : x ∈ IX) :
    C x ∈ relIdeal j g IX :=
  Ideal.mem_sup_left (Ideal.mem_map_of_mem _ hx)

theorem pivot_mem_relIdeal (j : Fin n) (g : Fin n → B) (IX : Ideal B) :
    X j - C (g j) ∈ relIdeal j g IX := by
  refine Ideal.mem_sup_right (Ideal.subset_span ⟨j, ?_⟩)
  simp

theorem ratio_mem_relIdeal (j : Fin n) (g : Fin n → B) (IX : Ideal B) {i : Fin n} (hi : i ≠ j) :
    X j * X i - C (g i) ∈ relIdeal j g IX := by
  refine Ideal.mem_sup_right (Ideal.subset_span ⟨i, ?_⟩)
  simp [hi]

/-- `X_j^M ≡ g_j^M` modulo the relations, times any polynomial. -/
theorem pow_mul_sub_mem (j : Fin n) (g : Fin n → B) (IX : Ideal B) (M : ℕ) (p : MvPolynomial (Fin n) B) :
    X j ^ M * p - C (g j ^ M) * p ∈ relIdeal j g IX := by
  rw [← sub_mul, map_pow]
  exact Ideal.mul_mem_right _ _ (Ideal.mem_of_dvd _ (sub_dvd_pow_sub_pow _ _ M)
    (pivot_mem_relIdeal j g IX))

/-- Raising the exponent of a reduction. -/
theorem reduce_up (j : Fin n) (g : Fin n → B) (IX : Ideal B) (p : MvPolynomial (Fin n) B) (N : ℕ) (q : B)
    (hq : q ∈ Ideal.span (Set.range g) ^ N) (hp : X j ^ N * p - C q ∈ relIdeal j g IX) (N' : ℕ)
    (hN' : N ≤ N') :
    ∃ q' : B, q' ∈ Ideal.span (Set.range g) ^ N' ∧ X j ^ N' * p - C q' ∈ relIdeal j g IX := by
  have hgj : g j ∈ Ideal.span (Set.range g) := Ideal.subset_span ⟨j, rfl⟩
  obtain ⟨e, rfl⟩ := Nat.exists_eq_add_of_le hN'
  refine ⟨g j ^ e * q, ?_, ?_⟩
  · rw [pow_add, mul_comm (Ideal.span (Set.range g) ^ N)]
    exact Ideal.mul_mem_mul (Ideal.pow_mem_pow hgj e) hq
  · have h1 := (relIdeal j g IX).mul_mem_left (X j ^ e) hp
    have h2 := pow_mul_sub_mem j g IX e (C q)
    have : X j ^ (N + e) * p - C (g j ^ e * q) =
        X j ^ e * (X j ^ N * p - C q) + (X j ^ e * C q - C (g j ^ e) * C q) := by
      rw [map_mul, pow_add]
      ring
    rw [this]
    exact (relIdeal j g IX).add_mem h1 h2

/-- **Reduction to constants**: `X_j^N p ≡ C q` modulo the relations with `q ∈ D^N`. -/
theorem reduce (j : Fin n) (g : Fin n → B) (IX : Ideal B) (p : MvPolynomial (Fin n) B) :
    ∃ (N : ℕ) (q : B), q ∈ Ideal.span (Set.range g) ^ N ∧ X j ^ N * p - C q ∈ relIdeal j g IX := by
  induction p using MvPolynomial.induction_on with
  | C a => exact ⟨0, a, by simp, by simp⟩
  | add p p' hp hp' =>
    obtain ⟨N₁, q₁, hq₁, h₁⟩ := hp
    obtain ⟨N₂, q₂, hq₂, h₂⟩ := hp'
    obtain ⟨r₁, hr₁, k₁⟩ := reduce_up j g IX p N₁ q₁ hq₁ h₁ (N₁ + N₂) (Nat.le_add_right _ _)
    obtain ⟨r₂, hr₂, k₂⟩ := reduce_up j g IX p' N₂ q₂ hq₂ h₂ (N₁ + N₂) (Nat.le_add_left _ _)
    refine ⟨N₁ + N₂, r₁ + r₂, Ideal.add_mem _ hr₁ hr₂, ?_⟩
    have : X j ^ (N₁ + N₂) * (p + p') - C (r₁ + r₂) =
        (X j ^ (N₁ + N₂) * p - C r₁) + (X j ^ (N₁ + N₂) * p' - C r₂) := by
      rw [map_add]
      ring
    rw [this]
    exact Ideal.add_mem _ k₁ k₂
  | mul_X p i hp =>
    obtain ⟨N, q, hq, h⟩ := hp
    by_cases hij : i = j
    · subst hij
      obtain ⟨q', hq', h'⟩ := reduce_up i g IX p N q hq h (N + 1) (Nat.le_succ N)
      refine ⟨N, q', Ideal.pow_le_pow_right (Nat.le_succ N) hq', ?_⟩
      have : X i ^ N * (p * X i) = X i ^ (N + 1) * p := by ring
      rw [this]
      exact h'
    · refine ⟨N + 1, q * g i, ?_, ?_⟩
      · rw [pow_succ]
        exact Ideal.mul_mem_mul hq (Ideal.subset_span ⟨i, rfl⟩)
      · have h1 := (relIdeal j g IX).mul_mem_right (X j * X i) h
        have h2 := (relIdeal j g IX).mul_mem_left (C q) (ratio_mem_relIdeal j g IX hij)
        have : X j ^ (N + 1) * (p * X i) - C (q * g i) =
            (X j ^ N * p - C q) * (X j * X i) + C q * (X j * X i - C (g i)) := by
          rw [map_mul]
          ring
        rw [this]
        exact Ideal.add_mem _ h1 h2

/-- **Kernel**: a constant in `L + I·B[X]` (`IX ≤ I`) is killed by a power of `g_j` modulo `I` (evaluate at
`X_j ↦ g_j`, `X_i ↦ g_i / g_j` in `(B ⧸ I)[1/g_j]`). -/
theorem kernel (j : Fin n) (g : Fin n → B) (IX I : Ideal B) (hXI : IX ≤ I) (c : B)
    (hc : C c ∈ relIdeal j g IX ⊔ Ideal.map (C : B →+* MvPolynomial (Fin n) B) I) :
    ∃ M : ℕ, g j ^ M * c ∈ I := by
  let s : B ⧸ I := Ideal.Quotient.mk I (g j)
  let ψ : MvPolynomial (Fin n) B →+* Localization.Away s :=
    eval₂Hom ((algebraMap (B ⧸ I) (Localization.Away s)).comp (Ideal.Quotient.mk I))
      fun i => if i = j then algebraMap (B ⧸ I) (Localization.Away s) s
        else algebraMap (B ⧸ I) (Localization.Away s) (Ideal.Quotient.mk I (g i)) *
          IsLocalization.Away.invSelf (S := Localization.Away s) s
  have hC : ∀ x : B, ψ (C x) = algebraMap (B ⧸ I) (Localization.Away s) (Ideal.Quotient.mk I x) := by
    intro x
    simp [ψ]
  have hCI : ∀ x ∈ I, ψ (C x) = 0 := by
    intro x hx
    rw [hC, Ideal.Quotient.eq_zero_iff_mem.mpr hx, map_zero]
  have hker : relIdeal j g IX ⊔ Ideal.map (C : B →+* MvPolynomial (Fin n) B) I ≤ RingHom.ker ψ := by
    refine sup_le (sup_le ?_ ?_) ?_
    · rw [Ideal.map_le_iff_le_comap]
      intro x hx
      exact hCI x (hXI hx)
    · rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      change ψ _ = 0
      by_cases hij : i = j
      · subst hij
        simp [ψ, s]
      · have hinv := IsLocalization.Away.mul_invSelf (S := Localization.Away s) s
        simp only [hij, if_false, map_sub, map_mul, hC, ψ, eval₂Hom_X', if_true]
        calc algebraMap (B ⧸ I) (Localization.Away s) s *
              (algebraMap (B ⧸ I) (Localization.Away s) (Ideal.Quotient.mk I (g i)) *
                IsLocalization.Away.invSelf (S := Localization.Away s) s) -
              algebraMap (B ⧸ I) (Localization.Away s) (Ideal.Quotient.mk I (g i))
            = algebraMap (B ⧸ I) (Localization.Away s) (Ideal.Quotient.mk I (g i)) *
                (algebraMap (B ⧸ I) (Localization.Away s) s *
                  IsLocalization.Away.invSelf (S := Localization.Away s) s) -
              algebraMap (B ⧸ I) (Localization.Away s) (Ideal.Quotient.mk I (g i)) := by ring
          _ = 0 := by rw [hinv]; ring
    · rw [Ideal.map_le_iff_le_comap]
      intro x hx
      exact hCI x hx
  have h0 : algebraMap (B ⧸ I) (Localization.Away s) (Ideal.Quotient.mk I c) = 0 := by
    rw [← hC]
    exact hker hc
  obtain ⟨⟨_, M, rfl⟩, hM⟩ :=
    (IsLocalization.map_eq_zero_iff (Submonoid.powers s) (Localization.Away s) _).mp h0
  refine ⟨M, ?_⟩
  rw [← Ideal.Quotient.eq_zero_iff_mem, map_mul, map_pow]
  exact hM

variable (ev : MvPolynomial (Fin n) B →+* H)

/-- The ideal of the strict transform of `V(IX)` in the chart ring: `(ev(L) : ev(X_j)^∞)`. -/
def chartIdeal (j : Fin n) (g : Fin n → B) (IX : Ideal B) : Ideal H :=
  powerSat (Ideal.map ev (relIdeal j g IX)) (ev (X j))

/-- The chart map `B ⧸ IX → H ⧸ (ev(L) : ev(X_j)^∞)`. -/
def chartMap (j : Fin n) (g : Fin n → B) (IX : Ideal B) : B ⧸ IX →+* H ⧸ chartIdeal ev j g IX :=
  Ideal.Quotient.lift IX ((Ideal.Quotient.mk _).comp (ev.comp C)) fun a ha => by
    rw [RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
    exact le_powerSat _ _ (Ideal.mem_map_of_mem ev (C_mem_relIdeal j g IX ha))

theorem chartMap_mk (j : Fin n) (g : Fin n → B) (IX : Ideal B) (a : B) :
    chartMap ev j g IX (Ideal.Quotient.mk IX a) = Ideal.Quotient.mk _ (ev (C a)) :=
  Ideal.Quotient.lift_mk _ _ _

/-- **N5.c2.**  On a FLAT graph chart (`ev` flat, `B` Noetherian), for every ideal `I ⊇ IX`, the `G`-saturation of
the total transform of `I ⧸ IX` lies in the algebraic strict ideal (centre `D = (g)`, equation `G = ev(X_j)`). -/
theorem chart_powerSat_le_strictIdeal [IsNoetherianRing B] (hev : ev.Flat) (j : Fin n) (g : Fin n → B)
    (IX I : Ideal B) (hXI : IX ≤ I) :
    powerSat (Ideal.map (chartMap ev j g IX) (Ideal.map (Ideal.Quotient.mk IX) I))
        (Ideal.Quotient.mk (chartIdeal ev j g IX) (ev (X j))) ≤
      strictIdeal (chartMap ev j g IX) (Ideal.map (Ideal.Quotient.mk IX) I)
        (Ideal.map (Ideal.Quotient.mk IX) (Ideal.span (Set.range g)))
        (Ideal.Quotient.mk (chartIdeal ev j g IX) (ev (X j))) := by
  set K := chartIdeal ev j g IX with hKdef
  set L := relIdeal j g IX with hLdef
  set J := L ⊔ Ideal.map (C : B →+* MvPolynomial (Fin n) B) I with hJdef
  set D := Ideal.span (Set.range g) with hDdef
  have hLK : Ideal.map ev L ≤ K := le_powerSat _ _
  -- the polynomial saturation lands in the strict ideal
  have key : ∀ p ∈ powerSat J (X j), Ideal.Quotient.mk K (ev p) ∈
      strictIdeal (chartMap ev j g IX) (Ideal.map (Ideal.Quotient.mk IX) I)
        (Ideal.map (Ideal.Quotient.mk IX) D) (Ideal.Quotient.mk K (ev (X j))) := by
    intro p hp
    obtain ⟨M, hM⟩ := mem_powerSat.mp hp
    obtain ⟨N, q, hq, hqp⟩ := reduce j g IX p
    have hc : C (g j ^ M * q) ∈ J := by
      have e1 : X j ^ M * (X j ^ N * p - C q) ∈ J := Ideal.mem_sup_left (L.mul_mem_left _ hqp)
      have e2 : X j ^ N * (X j ^ M * p) ∈ J := J.mul_mem_left _ hM
      have e3 : X j ^ M * C q - C (g j ^ M) * C q ∈ J :=
        Ideal.mem_sup_left (pow_mul_sub_mem j g IX M (C q))
      have : C (g j ^ M * q) =
          X j ^ N * (X j ^ M * p) - X j ^ M * (X j ^ N * p - C q) - (X j ^ M * C q - C (g j ^ M) * C q) := by
        rw [map_mul]
        ring
      rw [this]
      exact J.sub_mem (J.sub_mem e2 e1) e3
    obtain ⟨M', hM'⟩ := kernel j g IX I hXI _ hc
    have hgj : g j ∈ D := Ideal.subset_span ⟨j, rfl⟩
    refine Ideal.subset_span ⟨M' + M + N, Ideal.Quotient.mk IX (g j ^ M' * (g j ^ M * q)),
      ⟨Ideal.mem_map_of_mem _ hM', ?_⟩, ?_⟩
    · rw [← Ideal.map_pow]
      refine Ideal.mem_map_of_mem _ ?_
      rw [← mul_assoc, pow_add, pow_add]
      exact Ideal.mul_mem_mul (Ideal.mul_mem_mul (Ideal.pow_mem_pow hgj _) (Ideal.pow_mem_pow hgj _)) hq
    · have hg : Ideal.Quotient.mk K (ev (C (g j))) = Ideal.Quotient.mk K (ev (X j)) := by
        rw [Ideal.Quotient.eq, ← map_sub]
        have := hLK (Ideal.mem_map_of_mem ev (pivot_mem_relIdeal j g IX))
        rw [map_sub] at this ⊢
        rw [← neg_sub]
        exact K.neg_mem this
      have hq' : Ideal.Quotient.mk K (ev (C q)) =
          Ideal.Quotient.mk K (ev (X j)) ^ N * Ideal.Quotient.mk K (ev p) := by
        rw [← map_pow, ← map_mul, ← map_pow, ← map_mul, Ideal.Quotient.eq]
        have := hLK (Ideal.mem_map_of_mem ev hqp)
        rw [map_sub] at this
        rw [← neg_sub]
        exact K.neg_mem this
      rw [chartMap_mk]
      change Ideal.Quotient.mk K (ev (C (g j ^ M' * (g j ^ M * q)))) = _
      simp only [map_mul, map_pow, hg, hq']
      ring
  -- lift to `H`, use flatness, conclude
  intro a ha
  obtain ⟨m, hm⟩ := mem_powerSat.mp ha
  obtain ⟨a', rfl⟩ := Ideal.Quotient.mk_surjective a
  have hmap : Ideal.map (chartMap ev j g IX) (Ideal.map (Ideal.Quotient.mk IX) I) =
      Ideal.map (Ideal.Quotient.mk K) (Ideal.map ev (Ideal.map (C : B →+* MvPolynomial (Fin n) B) I)) := by
    rw [Ideal.map_map, Ideal.map_map, Ideal.map_map]
    rfl
  rw [hmap, ← map_pow, ← map_mul] at hm
  obtain ⟨x, hx, hxeq⟩ := (Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective).mp hm
  have hK : ev (X j) ^ m * a' - x ∈ K := Ideal.Quotient.eq.mp hxeq.symm
  obtain ⟨m', hm'⟩ := mem_powerSat.mp hK
  have hsat : a' ∈ powerSat (Ideal.map ev J) (ev (X j)) := by
    refine mem_powerSat.mpr ⟨m' + m, ?_⟩
    have h1 : ev (X j) ^ m' * (ev (X j) ^ m * a' - x) ∈ Ideal.map ev J :=
      Ideal.map_mono le_sup_left hm'
    have h2 : ev (X j) ^ m' * x ∈ Ideal.map ev J :=
      Ideal.mul_mem_left _ _ (Ideal.map_mono le_sup_right hx)
    have : ev (X j) ^ (m' + m) * a' = ev (X j) ^ m' * (ev (X j) ^ m * a' - x) + ev (X j) ^ m' * x := by
      ring
    rw [this]
    exact Ideal.add_mem _ h1 h2
  have hsat' := flat_powerSat_le ev hev J (X j) hsat
  have hle : Ideal.map (Ideal.Quotient.mk K) (Ideal.map ev (powerSat J (X j))) ≤
      strictIdeal (chartMap ev j g IX) (Ideal.map (Ideal.Quotient.mk IX) I)
        (Ideal.map (Ideal.Quotient.mk IX) D) (Ideal.Quotient.mk K (ev (X j))) := by
    rw [Ideal.map_map, Ideal.map_le_iff_le_comap]
    intro p hp
    exact key p hp
  exact hle (Ideal.mem_map_of_mem _ hsat')

/-- **N5.c2, equality form**: on a flat graph chart the algebraic strict ideal IS the saturation. -/
theorem chart_strictIdeal_eq_powerSat [IsNoetherianRing B] (hev : ev.Flat) (j : Fin n) (g : Fin n → B)
    (IX I : Ideal B) (hXI : IX ≤ I) :
    strictIdeal (chartMap ev j g IX) (Ideal.map (Ideal.Quotient.mk IX) I)
        (Ideal.map (Ideal.Quotient.mk IX) (Ideal.span (Set.range g)))
        (Ideal.Quotient.mk (chartIdeal ev j g IX) (ev (X j))) =
      powerSat (Ideal.map (chartMap ev j g IX) (Ideal.map (Ideal.Quotient.mk IX) I))
        (Ideal.Quotient.mk (chartIdeal ev j g IX) (ev (X j))) :=
  le_antisymm (strictIdeal_le_powerSat _ _ _ _) (chart_powerSat_le_strictIdeal ev hev j g IX I hXI)

end Chart

/-! ### The analytic graph chart -/

open Hironaka.Analytic.Unibranch.HironakaG10HtPolynomialGermFlat Hironaka
  Hironaka in
/-- **N5 on the analytic graph chart.**  `X ⊆ (ℂ^d, 0)` with ideal `IX`, centre generated by `g_0, …, g_r`,
pivot `j`, chart point `b`: on `𝒪_{ℂ^{d+r+1}} ⧸ (evPoly(L) : ev(X_j)^∞)` (the analytic chart ring of the blowup),
for every ideal `I ⊇ IX` the algebraic strict ideal is the whole saturation of the total transform (flatness
`HironakaG10HtPolynomialGermFlat.evPoly_flat` + `chart_strictIdeal_eq_powerSat`). -/
theorem analyticChart_strictIdeal_eq_powerSat (d r : ℕ) (b : Fin (r + 1) → ℂ) (j : Fin (r + 1))
    (g : Fin (r + 1) → HolGerm (ComplexModel d)) (IX I : Ideal (HolGerm (ComplexModel d))) (hXI : IX ≤ I) :
    strictIdeal (chartMap (evPoly d (r + 1) b) j g IX) (Ideal.map (Ideal.Quotient.mk IX) I)
        (Ideal.map (Ideal.Quotient.mk IX) (Ideal.span (Set.range g)))
        (Ideal.Quotient.mk (chartIdeal (evPoly d (r + 1) b) j g IX) (evPoly d (r + 1) b (X j))) =
      powerSat (Ideal.map (chartMap (evPoly d (r + 1) b) j g IX) (Ideal.map (Ideal.Quotient.mk IX) I))
        (Ideal.Quotient.mk (chartIdeal (evPoly d (r + 1) b) j g IX) (evPoly d (r + 1) b (X j))) := by
  have := isNoetherianRing_holGerm_euclidean d
  exact chart_strictIdeal_eq_powerSat _ (evPoly_flat d r b) j g IX I hXI


end

end Hironaka.Analytic.Unibranch.HironakaG10HtChartSaturation
