/-!
# The fibre algebras of the one-step strict transform are quotients of the original ones (N6)

Route step N6 of the global half of Hironaka's flattening theorem
(`work/hironaka-resume-20261111/G10C/GLOBAL-FLATTENING-ROUTE.md` §5, r6 order item 1), natively.  For
a proper `f : Y ⟶ X` of reduced complex spaces and a finite-type ideal `b : B ⟶ 𝒪_X` with dense unit
locus, let `σ : X' = Bl_B X ⟶ X`, `q : Y' = Bl_{f*B} Y ⟶ Y`, `p : Y' ⟶ X'` be the one-step strict
transform (`HironakaG10ChowOneStepStrictTransform`).  Then at every `y' ∈ Y'` the fibre algebra of
`p` is a quotient of the fibre algebra of `f`:

* `strict_fibreSurjective`: every `β ∈ 𝒪_{Y',y'}` is `q^♯ a` modulo `m_{p y'} 𝒪_{Y',y'}`.

Consequently `StepFibreSurjective` holds for every stage of the algorithm
(`stage_stepFibreSurjective`) and the hypothesis `hsurj` of
`HironakaG10ChowFibreChain.exists_flattening_of_fibreDecreases'` is discharged
(`exists_flattening_of_fibreDecreases''`).

Ingredients:
* residue fields: every germ of a reduced complex space is congruent to a constant modulo the maximal
  ideal, constants coming from the structure map to the complex point
  (`exists_sub_structure_mem_maximalIdeal`, `exists_sub_stalkMap_mem_maximalIdeal`);
* the base side: on `X'` the pulled centre is generated by a regular `ε`
  (`HironakaG10ChowProductCentre.stepProj_pulledIdeal_regular`), so every element of the centre pulls
  back to `c · p^♯ ε` with `c` congruent to a pull-back modulo the fibre ideal
  (`exists_mul_of_square`);
* the strict-transform side: the local ring of `Y'` is generated over `𝒪_{Y,qy'}` by the direction
  ratios (`hasRatioGeneration_model`, for arbitrary local model data of the geometric blowup, from the
  chart lemma `HironakaG10ChowRatioGeneration.hasRatioGeneration_geoStrictTransform`);
* the algebra: `HironakaG10ChowRatioAlgebra.exists_sub_mem_fibreIdeal_of_hasRatioGeneration`;
* over the unit locus `q` is an open immersion near `y'` (`strict_openImmersionOn`).
-/

set_option autoImplicit false

open Set TopologicalSpace Topology CategoryTheory AlgebraicGeometry IsLocalRing
open scoped Topology Manifold ContDiff

namespace Hironaka.Analytic.Unibranch.HironakaG10ChowFibreSurjective

open Hironaka Hironaka.HolomorphicIdealSheaves
  Hironaka.BlowupSequences Hironaka
  HironakaSmoothCentreRealDomainActualSheafStalk HironakaActualAnalyticSubspace
  HironakaReducedComplexAnalyticSpaces HironakaActualAnalyticSubspaceResidue
  HironakaSingularModuleSheafStalk HironakaNativePulledIdealSheaf HironakaNativePulledIdealStalk
  HironakaG10ChowFibreAlgebra HironakaG10ChowRatioAlgebra HironakaG10ChowRatioGeneration
  SourceReducedComplexSpace EmbeddedIdealBlowupNonunitLocus BlowupStrictSubmanifold
  HironakaG10ChowOneStepStrictTransform HironakaG10ChowStrictTorsionFree
  HironakaG10ChowProductCentre HironakaG10ChowFlatteningDriver HironakaG10ChowFibreChain
  HironakaNativePulledIdealFiniteType HironakaG10ChowStrictFlatLocus HironakaG10PNIdealFamily

noncomputable section

/-! ### Residue fields -/

section Residue

/-- On an embedded model, every germ is congruent to a constant modulo the maximal ideal. -/
theorem exists_sub_structure_mem_maximalIdeal_model {n : ℕ} (U : Opens (ComplexModel n))
    (C : Set U) (Ψ : (modelOver U C).left ⟶ complexPoint) (hΨ : Ψ = (modelOver U C).hom)
    (c : (modelOver U C).left) (r : (modelOver U C).left.presheaf.stalk c) :
    ∃ κ : complexPoint.presheaf.stalk (Ψ.base c),
      r - (Ψ.stalkMap c).hom κ ∈ maximalIdeal ((modelOver U C).left.presheaf.stalk c) := by
  subst hΨ
  refine ⟨actualComplexPointStalkEquiv.symm (actualSubspaceStalkEval (n := n) C c r), ?_⟩
  have h2 : ((modelOver U C).hom.stalkMap c).hom
      (actualComplexPointStalkEquiv.symm (actualSubspaceStalkEval (n := n) C c r)) =
        actualSubspaceStalkConst (n := n) C c (actualSubspaceStalkEval (n := n) C c r) :=
    actualSubspacePointMap_stalk_const (n := n) C c (actualSubspaceStalkEval (n := n) C c r)
  apply (actualSubspaceStalkEval_ker (n := n) C c).le
  refine (RingHom.sub_mem_ker_iff _).mpr ?_
  rw [h2]
  exact (actualSubspaceStalkEval_const (n := n) C c _).symm

/-- **Residue fields of reduced complex spaces are `ℂ`**: every germ is congruent to a constant
(an element in the image of the structure map to the complex point) modulo the maximal ideal. -/
theorem exists_sub_structure_mem_maximalIdeal (X : SourceReducedComplexSpace)
    (Ψ : X.obj.left ⟶ complexPoint) (hΨ : Ψ = X.obj.hom) (x : X.obj.left)
    (τ : X.obj.left.presheaf.stalk x) :
    ∃ κ : complexPoint.presheaf.stalk (Ψ.base x),
      τ - (Ψ.stalkMap x).hom κ ∈ maximalIdeal (X.obj.left.presheaf.stalk x) := by
  subst hΨ
  obtain ⟨n, U, C, -, i, hi, hpoint, c, rfl⟩ := X.property.2.2 x
  let : LocallyRingedSpace.IsOpenImmersion i := hi
  obtain ⟨κ, hκ⟩ := exists_sub_structure_mem_maximalIdeal_model U C (i ≫ X.obj.hom) hpoint c
    ((i.stalkMap c).hom τ)
  refine ⟨κ, ?_⟩
  have hcomp : ((i ≫ X.obj.hom).stalkMap c).hom κ =
      (i.stalkMap c).hom ((X.obj.hom.stalkMap (i.base c)).hom κ) :=
    congrArg (fun φ => CommRingCat.Hom.hom φ κ) (LocallyRingedSpace.stalkMap_comp i X.obj.hom c)
  rw [hcomp, ← map_sub] at hκ
  intro hu
  exact hκ (hu.map (i.stalkMap c).hom)

/-- **Residue fields along a morphism**: for `S : X' ⟶ X`, every germ of `X'` at `x'` is congruent
modulo the maximal ideal to the pull-back of a germ of `X` at `S x'`. -/
theorem exists_sub_stalkMap_mem_maximalIdeal {X X' : SourceReducedComplexSpace} (S : X' ⟶ X)
    (x' : X'.obj.left) (τ : X'.obj.left.presheaf.stalk x') :
    ∃ d : X.obj.left.presheaf.stalk (S.hom.left.base x'),
      τ - (S.hom.left.stalkMap x').hom d ∈ maximalIdeal (X'.obj.left.presheaf.stalk x') := by
  obtain ⟨κ, hκ⟩ := exists_sub_structure_mem_maximalIdeal X' (S.hom.left ≫ X.obj.hom)
    (Over.w S.hom) x' τ
  refine ⟨(X.obj.hom.stalkMap (S.hom.left.base x')).hom κ, ?_⟩
  have hcomp : ((S.hom.left ≫ X.obj.hom).stalkMap x').hom κ =
      (S.hom.left.stalkMap x').hom ((X.obj.hom.stalkMap (S.hom.left.base x')).hom κ) :=
    congrArg (fun φ => CommRingCat.Hom.hom φ κ)
      (LocallyRingedSpace.stalkMap_comp S.hom.left X.obj.hom x')
  rwa [hcomp] at hκ

end Residue

/-! ### The base side of the square -/

section Square

/-- **The ratios of the base blowup are constant modulo the fibre ideal.**  In a square
`Θ = P ≫ σ` where the ideal of `B` pulls back to `X'` at `P y'` as `(ε)`, every element `d` of the
stalk of `B` at `Θ y'` pulls back to `Y'` as `c · P^♯ ε` with `c` congruent modulo the fibre ideal of
`P` to the pull-back of a germ of `X`. -/
theorem exists_mul_of_square {X X' Y' : SourceReducedComplexSpace} (P : Y' ⟶ X') (σ : X' ⟶ X)
    (B : SheafOfModules.{0} (forgetRing X.obj.left.toSheafedSpace.sheaf))
    (b : B ⟶ SheafOfModules.unit (forgetRing X.obj.left.toSheafedSpace.sheaf))
    (y' : Y'.obj.left) (ε : X'.obj.left.presheaf.stalk (P.hom.left.base y'))
    (hε : nativePulledIdealStalkIdeal σ.hom.left B b (P.hom.left.base y') = Ideal.span {ε})
    (Θ : Y'.obj.left ⟶ X.obj.left) (hΘ : Θ = P.hom.left ≫ σ.hom.left) :
    ∀ d ∈ LinearMap.range (stalkInclusionLinearMap X.obj.left.toSheafedSpace.sheaf B b (Θ.base y')),
      ∃ c, (Θ.stalkMap y').hom d = c * (P.hom.left.stalkMap y').hom ε ∧
        ∃ d'' : X.obj.left.presheaf.stalk (Θ.base y'),
          c - (Θ.stalkMap y').hom d'' ∈ lrsFibreIdeal P.hom.left y' := by
  subst hΘ
  intro d hd
  have hσd : (σ.hom.left.stalkMap (P.hom.left.base y')).hom d ∈ Ideal.span {ε} := by
    rw [← hε]
    exact Ideal.mem_map_of_mem _ hd
  obtain ⟨τ, hτ⟩ := Ideal.mem_span_singleton'.mp hσd
  obtain ⟨d'', hd''⟩ := exists_sub_stalkMap_mem_maximalIdeal σ (P.hom.left.base y') τ
  have hcomp : ∀ r, ((P.hom.left ≫ σ.hom.left).stalkMap y').hom r =
      (P.hom.left.stalkMap y').hom ((σ.hom.left.stalkMap (P.hom.left.base y')).hom r) := fun r =>
    congrArg (fun φ => CommRingCat.Hom.hom φ r)
      (LocallyRingedSpace.stalkMap_comp P.hom.left σ.hom.left y')
  refine ⟨(P.hom.left.stalkMap y').hom τ, (hcomp d).trans (by rw [← hτ, map_mul]), d'', ?_⟩
  have e2 : (P.hom.left.stalkMap y').hom τ - ((P.hom.left ≫ σ.hom.left).stalkMap y').hom d'' =
      (P.hom.left.stalkMap y').hom (τ - (σ.hom.left.stalkMap (P.hom.left.base y')).hom d'') :=
    (congrArg (fun x => (P.hom.left.stalkMap y').hom τ - x) (hcomp d'')).trans (map_sub _ _ _).symm
  rw [e2]
  exact Ideal.mem_map_of_mem _ hd''

end Square

/-! ### The strict-transform side, for arbitrary local model data -/

section Model

variable {Y : SourceReducedComplexSpace}
  (𝔍 : SheafOfModules.{0} (forgetRing Y.obj.left.toSheafedSpace.sheaf))
  (b' : 𝔍 ⟶ SheafOfModules.unit (forgetRing Y.obj.left.toSheafedSpace.sheaf))
  {ι : Type} {n : ι → ℕ} {M Z : ι → Type} [∀ j, TopologicalSpace (M j)]
  [∀ j, TopologicalSpace (Z j)]
  [∀ j, ChartedSpace (ComplexModel (n j)) (M j)] [∀ j, IsComplexManifold (n j) (M j)]
  [∀ j, ChartedSpace (ComplexModel (n j)) (Z j)] [∀ j, IsComplexManifold (n j) (Z j)]
  {C W : ∀ j, Set (M j)} {π : ∀ j, Z j → M j}
  (hW : ∀ j, IsComplexAnalyticSubset (n := n j) (W j))
  (hπ : ∀ j, IsBlowupAlong (n j) (C j) (π j))
  (J : ∀ j, ofClosedAnalytic (W j) (hW j) ⟶ Y)
  [hJopen : ∀ j, LocallyRingedSpace.IsOpenImmersion (J j).hom.left]
  (hJ : ∀ j (y : W j),
    Ideal.map ((actualSubspaceInclusion (n := n j) (W j)).stalkMap y).hom
      (actualWholeSheafStalkIdeal (vanishingIdeal (n := n j) (C j)) y.val) =
        nativePulledIdealStalkIdeal (J j).hom.left 𝔍 b' y)
  (hcover : ∀ y : Y.obj.left, ∃ (j : ι) (w : W j), (J j).hom.left.base w = y)

include hJ hJopen in
/-- Ratio generation on one chart, for any morphism `Θ` equal to the chart projection. -/
theorem hasRatioGeneration_chart (j : ι) (z : geoStrictTransform (π j) (C j) (W j))
    (hz : π j z.val ∈ C j)
    (Θ : actualSubspaceLocallyRingedSpace (n := n j) (geoStrictTransform (π j) (C j) (W j)) ⟶
      Y.obj.left)
    (hΘ : Θ = EmbeddedGeometricBlowup.geometricProjection (hπ j) (hW j).isClosed ≫
      (J j).hom.left) :
    HasRatioGeneration (Θ.stalkMap z).hom
      (LinearMap.range (stalkInclusionLinearMap Y.obj.left.toSheafedSpace.sheaf 𝔍 b' (Θ.base z)) :) := by
  subst hΘ
  have h0 := hasRatioGeneration_geoStrictTransform (hπ j) (hW j).isClosed z hz
  have h1 : HasRatioGeneration ((geoProj (hπ j) (hW j).isClosed).stalkMap z).hom
      (nativePulledIdealStalkIdeal (J j).hom.left 𝔍 b' ((geoProj (hπ j) (hW j).isClosed).base z)) := by
    rw [← hJ j]
    exact h0
  have := @LocallyRingedSpace.IsOpenImmersion.stalk_iso _ _ (J j).hom.left (hJopen j)
    ((geoProj (hπ j) (hW j).isClosed).base z)
  have h2 := HasRatioGeneration.comp_bijective
    ((J j).hom.left.stalkMap ((geoProj (hπ j) (hW j).isClosed).base z)).hom
    (ConcreteCategory.bijective_of_isIso
      ((J j).hom.left.stalkMap ((geoProj (hπ j) (hW j).isClosed).base z))) h1
  have h3 : ((EmbeddedGeometricBlowup.geometricProjection (hπ j) (hW j).isClosed ≫
      (J j).hom.left).stalkMap z).hom =
        ((geoProj (hπ j) (hW j).isClosed).stalkMap z).hom.comp
          ((J j).hom.left.stalkMap ((geoProj (hπ j) (hW j).isClosed).base z)).hom :=
    congrArg CommRingCat.Hom.hom (LocallyRingedSpace.stalkMap_comp
      (geoProj (hπ j) (hW j).isClosed) (J j).hom.left z)
  rw [h3]
  exact h2

include hJ hJopen in
/-- Ratio generation through an open immersion of a chart. -/
theorem hasRatioGeneration_chart' (j : ι) (z : geoStrictTransform (π j) (C j) (W j))
    (hz : π j z.val ∈ C j) {G : LocallyRingedSpace.{0}}
    (k : actualSubspaceLocallyRingedSpace (n := n j) (geoStrictTransform (π j) (C j) (W j)) ⟶ G)
    [hk : LocallyRingedSpace.IsOpenImmersion k] (q : G ⟶ Y.obj.left)
    (hsq : k ≫ q = EmbeddedGeometricBlowup.geometricProjection (hπ j) (hW j).isClosed ≫
      (J j).hom.left) :
    HasRatioGeneration (q.stalkMap (k.base z)).hom
      (LinearMap.range (stalkInclusionLinearMap Y.obj.left.toSheafedSpace.sheaf 𝔍 b'
        (q.base (k.base z))) :) := by
  have h1 := hasRatioGeneration_chart 𝔍 b' hW hπ J hJ j z hz (k ≫ q) hsq
  have h2 : ((k ≫ q).stalkMap z).hom = (k.stalkMap z).hom.comp (q.stalkMap (k.base z)).hom :=
    congrArg CommRingCat.Hom.hom (LocallyRingedSpace.stalkMap_comp k q z)
  rw [h2] at h1
  exact HasRatioGeneration.of_comp_bijective (k.stalkMap z).hom
    (ConcreteCategory.bijective_of_isIso (k.stalkMap z)) h1

include hJ hJopen in
/-- **Ratio generation on the geometric blowup of a finite-type ideal**, over its nonunit locus,
for arbitrary local model data. -/
theorem hasRatioGeneration_model
    (y' : (EmbeddedGeometricIdealOriginalObject.sourceObject hW hπ J 𝔍 b' hJ hcover).obj.left)
    (hnu : (EmbeddedGeometricIdealOriginalObject.projectionMorphism hW hπ J 𝔍 b' hJ
      hcover).hom.left.base y' ∈ nonunitLocus 𝔍 b') :
    HasRatioGeneration ((EmbeddedGeometricIdealOriginalObject.projectionMorphism hW hπ J 𝔍 b' hJ
        hcover).hom.left.stalkMap y').hom
      (LinearMap.range (stalkInclusionLinearMap Y.obj.left.toSheafedSpace.sheaf 𝔍 b'
        ((EmbeddedGeometricIdealOriginalObject.projectionMorphism hW hπ J 𝔍 b' hJ
          hcover).hom.left.base y')) :) := by
  obtain ⟨j, z, rfl⟩ :=
    EmbeddedGeometricIdealObjectGluing.inclusion_jointly_surjective hW hπ J 𝔍 b' hJ y'
  let k := EmbeddedGeometricIdealObjectGluing.inclusion hW hπ J 𝔍 b' hJ j
  let qg := EmbeddedGeometricIdealObjectGluing.projection hW hπ J 𝔍 b' hJ
  let gp := EmbeddedGeometricBlowup.geometricProjection (hπ j) (hW j).isClosed
  have hsq : k ≫ qg = gp ≫ (J j).hom.left :=
    EmbeddedGeometricIdealObjectGluing.inclusion_projection hW hπ J 𝔍 b' hJ j
  have hpt : qg.base (k.base z) = (J j).hom.left.base (gp.base z) :=
    congrArg (fun H => H.base z) hsq
  have hzC : π j z.val ∈ C j :=
    (chart_mem_nonunitLocus 𝔍 b' hW hπ J hJ j (gp.base z)).mpr (by rw [← hpt]; exact hnu)
  exact hasRatioGeneration_chart' 𝔍 b' hW hπ J hJ j z hzC k qg hsq
    (hk := EmbeddedGeometricIdealObjectGluing.inclusion_isOpenImmersion hW hπ J 𝔍 b' hJ j)

end Model

/-! ### The one-step strict transform -/

section Step

variable {X Y : SourceReducedComplexSpace}
  (B : SheafOfModules.{0} (forgetRing X.obj.left.toSheafedSpace.sheaf))
  (b : B ⟶ SheafOfModules.unit (forgetRing X.obj.left.toSheafedSpace.sheaf))
  [B.IsFiniteType]
  (hDense : Dense {x : X.obj.left |
    LinearMap.range (stalkInclusionLinearMap X.obj.left.toSheafedSpace.sheaf B b x) = ⊤})
  (f : Y ⟶ X)

local instance pulled_isFiniteType' : (nativePulledIdealModule f.hom.left B b).IsFiniteType :=
  nativePulledIdealModule_isFiniteType f.hom.left B b

/-- Ratio generation for the strict-transform map `q : Y' ⟶ Y` over the nonunit locus. -/
theorem strictQ_hasRatioGeneration (y' : (strictSource B b f).obj.left)
    (hnu : f.hom.left.base ((strictQ B b f).hom.left.base y') ∈ nonunitLocus B b) :
    HasRatioGeneration ((strictQ B b f).hom.left.stalkMap y').hom
      (nativePulledIdealStalkIdeal f.hom.left B b ((strictQ B b f).hom.left.base y')) := by
  have hnu' : (strictQ B b f).hom.left.base y' ∈
      nonunitLocus (nativePulledIdealModule f.hom.left B b)
        (nativePulledIdealInclusion f.hom.left B b) := by
    by_contra h
    exact ((mem_pulledUnitLocus_iff B b f _).mp h) hnu
  rw [← nativePulledIdealStalkInclusion_range]
  revert hnu'
  unfold strictQ OriginalFiniteIdealGeometricBlowup.projectionMorphism
  intro hnu'
  exact hasRatioGeneration_model (nativePulledIdealModule f.hom.left B b)
    (nativePulledIdealInclusion f.hom.left B b) _ _ _ _ _ y' hnu'

/-- **N6: the fibre algebras of the one-step strict transform are quotients of the original
ones.**  Every germ of `Y'` at `y'` is congruent to the pull-back of a germ of `Y` at `q y'` modulo
the fibre ideal `m_{p y'} 𝒪_{Y',y'}`. -/
theorem strict_fibreSurjective (y' : (strictSource B b f).obj.left)
    (β : (strictSource B b f).obj.left.presheaf.stalk y') :
    ∃ a : Y.obj.left.presheaf.stalk ((strictQ B b f).hom.left.base y'),
      β - ((strictQ B b f).hom.left.stalkMap y').hom a ∈
        lrsFibreIdeal (strictP B b hDense f).hom.left y' := by
  by_cases hnu : f.hom.left.base ((strictQ B b f).hom.left.base y') ∈ nonunitLocus B b
  · -- over the centre: the chart computation
    obtain ⟨ε, hε, -⟩ := stepProj_pulledIdeal_regular B b hDense
      ((strictP B b hDense f).hom.left.base y')
    obtain ⟨h0', hreg⟩ := strictP_generator_regular B b f hDense y' ε hε
    have h0 : Ideal.map ((strictQ B b f).hom.left.stalkMap y').hom
        (nativePulledIdealStalkIdeal f.hom.left B b ((strictQ B b f).hom.left.base y')) =
          Ideal.span {((strictP B b hDense f).hom.left.stalkMap y').hom ε} := by
      rw [← HironakaG10ChowGermIdealDictionary.nativePulledIdealStalkIdeal_comp B b
        (strictQ B b f).hom.left f.hom.left y']
      exact h0'
    have hΘ : (strictQ B b f).hom.left ≫ f.hom.left =
        (strictP B b hDense f).hom.left ≫ (stepProj B b hDense).hom.left :=
      congrArg (fun H => H.hom.left) (strictP_comp B b hDense f).symm
    have hsq := exists_mul_of_square (strictP B b hDense f) (stepProj B b hDense) B b y' ε hε
      ((strictQ B b f).hom.left ≫ f.hom.left) hΘ
    have hcompQ : ∀ r, (((strictQ B b f).hom.left ≫ f.hom.left).stalkMap y').hom r =
        ((strictQ B b f).hom.left.stalkMap y').hom
          ((f.hom.left.stalkMap ((strictQ B b f).hom.left.base y')).hom r) := fun r =>
      congrArg (fun φ => CommRingCat.Hom.hom φ r)
        (LocallyRingedSpace.stalkMap_comp (strictQ B b f).hom.left f.hom.left y')
    have hx : ∀ a ∈ nativePulledIdealStalkIdeal f.hom.left B b ((strictQ B b f).hom.left.base y'),
        ∃ c, ((strictQ B b f).hom.left.stalkMap y').hom a =
            c * ((strictP B b hDense f).hom.left.stalkMap y').hom ε ∧
          ∃ a', c - ((strictQ B b f).hom.left.stalkMap y').hom a' ∈
            fibreIdeal ((strictP B b hDense f).hom.left.stalkMap y').hom := by
      apply exists_mul_of_mem_map
      intro d hd
      obtain ⟨c, hc, d'', hd''⟩ := hsq d hd
      refine ⟨c, (hcompQ d).symm.trans hc, (f.hom.left.stalkMap _).hom d'', ?_⟩
      rw [← hcompQ]
      exact hd''
    exact exists_sub_mem_fibreIdeal_of_hasRatioGeneration _ _ _ ε h0 hreg hx
      (strictQ_hasRatioGeneration B b f y' hnu) β
  · -- off the centre: `q` is an open immersion near `y'`
    have hmem : y' ∈ (strictP B b hDense f).hom.left.base ⁻¹' (stepExcep B b hDense)ᶜ := by
      change (stepProj B b hDense).hom.left.base ((strictP B b hDense f).hom.left.base y') ∉
        nonunitLocus B b
      rw [strictP_comp_apply B b hDense f y']
      exact hnu
    obtain ⟨V, jV, hjV, hrange, hjVQ⟩ := strict_openImmersionOn B b hDense f
    rw [← hrange] at hmem
    obtain ⟨v, rfl⟩ := hmem
    let : LocallyRingedSpace.IsOpenImmersion jV := hjV
    let : LocallyRingedSpace.IsOpenImmersion (jV ≫ (strictQ B b f).hom.left) := hjVQ
    have hbij1 : Function.Bijective (jV.stalkMap v).hom := ConcreteCategory.bijective_of_isIso _
    have hbij2 : Function.Bijective ((jV ≫ (strictQ B b f).hom.left).stalkMap v).hom :=
      ConcreteCategory.bijective_of_isIso _
    obtain ⟨a, ha⟩ := hbij2.2 ((jV.stalkMap v).hom β)
    refine ⟨a, ?_⟩
    have hqa : ((strictQ B b f).hom.left.stalkMap (jV.base v)).hom a = β := by
      apply hbij1.1
      rw [← ha]
      exact (congrArg (fun φ => CommRingCat.Hom.hom φ a)
        (LocallyRingedSpace.stalkMap_comp jV (strictQ B b f).hom.left v)).symm
    rw [hqa, sub_self]
    exact Ideal.zero_mem _

end Step

/-! ### Every stage of the algorithm -/

section Driver

/-- **N6 for every step of the algorithm.** -/
theorem stage_stepFibreSurjective (rule : ∀ s : Stage, AdmissibleCentre s.f) (s : Stage) :
    StepFibreSurjective rule s := by
  let c := rule s
  let _ := c.finiteType
  intro y b
  exact strict_fibreSurjective c.B c.b c.dense s.f y b

/-- **Flattening from strict fibre decrease, with Noether and N6 discharged**: for compact `X` and
proper `f`, the conclusion of `HironakaFlattening` for `f` follows from closed non-flat images
(4.1), strict fibre decrease at the non-flat points of the next stage (Lemma 1.18 under (RR)) and
locally finitely generated fibre kernels. -/
theorem exists_flattening_of_fibreDecreases'' (rule : ∀ s : Stage, AdmissibleCentre s.f)
    (s₀ : Stage) (hX : CompactSpace s₀.X.obj.left)
    (hf : IsProperMap s₀.f.hom.left.base)
    (hclosed : ∀ n, IsClosed (nonflatImage (stage rule s₀ n).f))
    (hfg : ∀ (z : ∀ n, (stage rule s₀ n).X.obj.left) n,
      IsLocallyFinitelyGenerated (stage rule s₀ 0).Y.obj.left (fibreKernel rule s₀ z n))
    (hdec : ∀ n, ∀ x' ∈ nonflatImage (stage rule s₀ (n + 1)).f,
      StepFibreDecreasesAt rule (stage rule s₀ n) x') :
    ∃ (X' : SourceReducedComplexSpace) (σ : X' ⟶ s₀.X) (E : Set X'.obj.left),
      HironakaG10ChowTowerDomination.IsNativeBlowupTower s₀.X X' σ ∧ IsClosed E ∧
        interior E = ∅ ∧ HironakaG10ChowFlatteningReduction.IsOpenImmersionOn σ Eᶜ ∧
      ∃ (Y' : SourceReducedComplexSpace) (p : Y' ⟶ X') (q : Y' ⟶ s₀.Y),
        HironakaG10ChowFlatteningReduction.IsStrictTransform s₀.f σ E p q ∧
          HironakaG10ChowFlatBimeromorphicIso.IsFlatMorphism p :=
  exists_flattening_of_fibreDecreases' hX hf hclosed
    (fun n => stage_stepFibreSurjective rule (stage rule s₀ n)) hfg hdec

end Driver

end

end Hironaka.Analytic.Unibranch.HironakaG10ChowFibreSurjective
