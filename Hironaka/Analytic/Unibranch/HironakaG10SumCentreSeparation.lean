import Hironaka.Resolution.HironakaG10ChowArtinReesCentre

/-! # Separation of strict transforms by a sum centre -/

set_option autoImplicit false
open Set

namespace Hironaka.Analytic.Unibranch.HironakaG10SumCentreSeparation

open Hironaka.HironakaG10ChowArtinReesCentre

/-- The two algebraic strict transforms cannot meet when the pullback of
  their sum is generated by a regular element. -/
theorem strictIdeals_not_both_proper
    {A R : Type*} [CommRing A] [CommRing R] [IsLocalRing R]
    (φ : A →+* R) (I J : Ideal A) (G : R) (hG : IsRegular G)
    (hD : Ideal.map φ (I ⊔ J) = Ideal.span {G}) :
    ¬ (strictIdeal φ I (I ⊔ J) G ≤ IsLocalRing.maximalIdeal R ∧
       strictIdeal φ J (I ⊔ J) G ≤ IsLocalRing.maximalIdeal R) := by
  intro ⟨hI, hJ⟩
  have hsmall : ∀ (K : Ideal A), K ≤ I ⊔ J →
      strictIdeal φ K (I ⊔ J) G ≤ IsLocalRing.maximalIdeal R →
      Ideal.map φ K ≤ Ideal.span {G} * IsLocalRing.maximalIdeal R := by
    intro K hK hstrict
    apply map_le_span_mul_maximalIdeal φ K G (hD ▸ Ideal.map_mono hK)
    intro z hz u hu he
    have hu' : u ∈ strictIdeal φ K (I ⊔ J) G := by
      apply Ideal.subset_span
      exact ⟨1, z, ⟨hz, by simpa using hK hz⟩, by simpa using he⟩
    exact (IsLocalRing.mem_maximalIdeal u).mp (hstrict hu') hu
  have hmap : Ideal.map φ (I ⊔ J) ≤ Ideal.span {G} * IsLocalRing.maximalIdeal R := by
    rw [Ideal.map_sup]
    exact sup_le (hsmall I le_sup_left hI) (hsmall J le_sup_right hJ)
  have hmem : G ∈ Ideal.span {G} * IsLocalRing.maximalIdeal R :=
    hmap (hD.symm ▸ Ideal.subset_span (Set.mem_singleton G))
  obtain ⟨w, hw, he⟩ := Ideal.mem_span_singleton_mul.mp hmem
  have hw1 : w = 1 := hG.left (by simpa using he)
  rw [hw1] at hw
  exact (IsLocalRing.maximalIdeal.isMaximal R).ne_top ((Ideal.eq_top_iff_one _).mpr hw)

end Hironaka.Analytic.Unibranch.HironakaG10SumCentreSeparation
