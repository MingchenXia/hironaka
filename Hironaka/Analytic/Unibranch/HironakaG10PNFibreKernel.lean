import Hironaka.Analytic.Unibranch.HironakaG10ChowFibreChain
import Hironaka.Resolution.HironakaG10PNKernelFamily

/-!
# Coherence of the fibre kernels of the flattening chain (lane G10P, run 0080 r4)

G10C's termination step (4.3) (`HironakaG10ChowFibreChain.exists_flattening_of_fibreDecreases'`)
consumes `hfg : ∀ z n, IsLocallyFinitelyGenerated Y₀ (fibreKernel rule s₀ z n)`: the ideal of the image
in `Y_0` of the (non-reduced) fibre `f_n⁻¹(z_n)` along the composite strict transform
`chainQ n : Y_n → Y_0` is coherent.  This module proves

* `fibreKernel_eq_kerFamily` — `fibreKernel z n` is the kernel family (TN
  `HironakaG10PNKernelFamily.kerFamily`) of the fibre ideal family `𝔪_{z_n} 𝒪_{Y_n}` along `chainQ n`;
* `isLocallyFinitelyGenerated_fibreKernel_zero` — `hfg` for `n = 0` (no hypothesis: the ideal of a
  point is coherent, TN `HironakaG10PNPointIdeal`);
* **`isLocallyFinitelyGenerated_fibreKernel`** — `hfg` for every `n` from the surjectivity of the
  fibre algebras of the steps (G10C's `hsurj`, route step N6) and the ONE-STEP coherence
  `StepKernelCoherent` (the case `n = 1` at every stage: the ideal in `Y_n` of the fibre over a point
  `x'` of the next base, i.e. of the slice of the strict transform);
* `exists_flattening_of_fibreDecreases_of_stepKernel` — G10C's flattening assembly with `hfg`
  replaced by `StepKernelCoherent`.

Route: the composite `chainQ (n+1) = q_n ≫ chainQ n` gives `fibreKernel (n+1) = kerFamily (chainQ n)
(stepKernel n)` (`kerFamily_comp`); the step kernel contains `𝔪_{z_n}𝒪_{Y_n}`; `chainQ n` is proper
(composite of geometric blowups) and injective on the fibre `f_n⁻¹(z_n)` (pair-injectivity,
`chainQ_injective`), and the fibre algebras of the chain are quotients of those of `Y_0`
(`exists_sub_mem_chain`), so the closed-embedding transfer
`HironakaG10PNKernelFamily.isLocallyFinitelyGenerated_kerFamily` applies inductively.
-/

set_option autoImplicit false

open Set TopologicalSpace CategoryTheory AlgebraicGeometry

namespace Hironaka.Analytic.Unibranch.HironakaG10PNFibreKernel

open Hironaka HironakaG10PNIdealFamily HironakaG10PNPointIdeal
  HironakaG10PNKernelFamily HironakaG10ChowFibreChain HironakaG10ChowFlatteningDriver
  HironakaG10ChowOneStepStrictTransform HironakaNativePulledIdealSheaf
  HironakaNativePulledIdealFiniteType

noncomputable section

variable (rule : ∀ s : Stage, AdmissibleCentre s.f)

/-- The **one-step fibre kernel** on `Y` of a stage `s` at a point `x'` of the next base: the kernel of
`𝒪_{Y,y} → 𝒪_{Y',y'}/𝔪_{x'}𝒪_{Y',y'}` at the points `y'` over `y` in the fibre over `x'` (the unit
ideal if there is none), i.e. the ideal in `Y` of the fibre of the strict transform over `x'`. -/
def stepKernel (s : Stage) (x' : (Stage.next rule s).X.obj.left) :
    ∀ y : s.Y.obj.left, Ideal (s.Y.obj.left.presheaf.stalk y) :=
  kerFamily (Stage.q rule s).hom.left
    (pullFamily (Stage.next rule s).f.hom.left (pointFamily (Stage.next rule s).X.obj.left x'))

/-- **One-step coherence** of a stage: for every point `x'` of the next base, the ideal in `Y` of the
fibre of the strict transform over `x'` is locally finitely generated.  (True: it is the kernel of
`𝒪_Y → q_*(𝒪_{Y'}/𝔪_{x'}𝒪_{Y'})`, coherent by Grauert's direct image theorem for the proper map `q`;
in the chart `Y' ⊆ Y × ℂ^{N-1}` it is generated by `𝔪_x 𝒪_Y` and the equations of `Y'` restricted to
the slice of the ratio coordinates of `x'`.) -/
def StepKernelCoherent (s : Stage) : Prop :=
  ∀ x' : (Stage.next rule s).X.obj.left,
    IsLocallyFinitelyGenerated s.Y.obj.left (stepKernel rule s x')

/-- The strict-transform map of a step is proper (a geometric blowup projection). -/
theorem stepQ_isProperMap (s : Stage) : IsProperMap (Stage.q rule s).hom.left.base := by
  let c := rule s
  let _ := c.finiteType
  let _ : (nativePulledIdealModule s.f.hom.left c.B c.b).IsFiniteType :=
    nativePulledIdealModule_isFiniteType s.f.hom.left c.B c.b
  exact OriginalFiniteIdealGeometricBlowup.projection_isProperMap _ _

variable (s₀ : Stage)

/-- The composite strict-transform maps are proper. -/
theorem chainQ_isProperMap : ∀ n, IsProperMap (chainQ rule s₀ n).hom.left.base
  | 0 => isProperMap_id
  | n + 1 => (chainQ_isProperMap n).comp (stepQ_isProperMap rule (stage rule s₀ n))

variable {rule s₀}

/-- **The fibre kernel is a kernel family**: `fibreKernel z n` is the kernel family of the fibre ideal
family `𝔪_{z_n}𝒪_{Y_n}` along `chainQ n`. -/
theorem fibreKernel_eq_kerFamily (z : ∀ n, (stage rule s₀ n).X.obj.left) (n : ℕ) :
    fibreKernel rule s₀ z n = kerFamily (chainQ rule s₀ n).hom.left
      (pullFamily (stage rule s₀ n).f.hom.left (pointFamily (stage rule s₀ n).X.obj.left (z n))) := by
  funext y
  refine iInf_congr fun yn => iInf_congr fun h => ?_
  by_cases hf : (stage rule s₀ n).f.hom.left.base yn = z n
  · rw [iInf_pos hf]
    congr 1
    rw [← hf]
    exact (pullFamily_pointFamily_self _ yn).symm
  · rw [iInf_neg hf, pullFamily_pointFamily_of_ne _ hf, Ideal.comap_top]

theorem t1Space (X : SourceReducedComplexSpace) : T1Space X.obj.left := by
  have : T2Space X.obj.left := X.property.1
  infer_instance

/-- **`hfg` for `n = 0`**: the fibre ideal family `𝔪_{z_0}𝒪_{Y_0}` is coherent. -/
theorem isLocallyFinitelyGenerated_fibreKernel_zero (z : ∀ n, (stage rule s₀ n).X.obj.left) :
    IsLocallyFinitelyGenerated (stage rule s₀ 0).Y.obj.left (fibreKernel rule s₀ z 0) := by
  have := t1Space (stage rule s₀ 0).X
  rw [fibreKernel_eq_kerFamily]
  change IsLocallyFinitelyGenerated _ (kerFamily (𝟙 (stage rule s₀ 0).Y.obj.left) _)
  rw [kerFamily_id]
  exact isLocallyFinitelyGenerated_fibreFamily
    (HironakaG10PNSourceNoether.hasAnalyticModelCharts _) _ _

/-- The step kernel contains the fibre ideal family of the image point. -/
theorem pullFamily_le_stepKernel (s : Stage) (x' : (Stage.next rule s).X.obj.left)
    (y : s.Y.obj.left) :
    pullFamily s.f.hom.left (pointFamily s.X.obj.left ((Stage.σ rule s).hom.left.base x')) y ≤
      stepKernel rule s x' y := by
  intro g hg
  rw [stepKernel, mem_kerFamily_iff]
  intro y' hy'
  subst hy'
  simp only [eqToHom_refl, CommRingCat.hom_id, RingHom.id_apply]
  by_cases hf' : (Stage.next rule s).f.hom.left.base y' = x'
  · have hfx : s.f.hom.left.base ((Stage.q rule s).hom.left.base y') =
        (Stage.σ rule s).hom.left.base x' :=
      (step_comm_apply rule s y').symm.trans (congrArg (Stage.σ rule s).hom.left.base hf')
    rw [← hfx, pullFamily_pointFamily_self] at hg
    rw [← hf', pullFamily_pointFamily_self]
    exact map_fibreIdealAt_le rule s y' (Ideal.mem_map_of_mem _ hg)
  · rw [pullFamily_pointFamily_of_ne _ hf']
    exact Submodule.mem_top

/-- **`hfg` from one-step coherence**: if every step has surjective fibre algebras (N6) and is
one-step coherent, every fibre kernel of the chain is locally finitely generated — at every `n` and
for every sequence `z` (compatible or not). -/
theorem isLocallyFinitelyGenerated_kerFamily_chain
    (hsurj : ∀ n, StepFibreSurjective rule (stage rule s₀ n))
    (hstep : ∀ n, StepKernelCoherent rule (stage rule s₀ n)) :
    ∀ (n : ℕ) (x : (stage rule s₀ n).X.obj.left),
      IsLocallyFinitelyGenerated (stage rule s₀ 0).Y.obj.left
        (kerFamily (chainQ rule s₀ n).hom.left
          (pullFamily (stage rule s₀ n).f.hom.left (pointFamily _ x)))
  | 0, x => by
    have := t1Space (stage rule s₀ 0).X
    change IsLocallyFinitelyGenerated _ (kerFamily (𝟙 (stage rule s₀ 0).Y.obj.left) _)
    rw [kerFamily_id]
    exact isLocallyFinitelyGenerated_fibreFamily
      (HironakaG10PNSourceNoether.hasAnalyticModelCharts _) _ _
  | n + 1, x' => by
    have := t1Space (stage rule s₀ n).X
    let s := stage rule s₀ n
    let x : s.X.obj.left := (Stage.σ rule s).hom.left.base x'
    let F : Set s.Y.obj.left := s.f.hom.left.base ⁻¹' {x}
    have hF : IsClosed F := IsClosed.preimage s.f.hom.left.base.hom.continuous ((t1Space s.X).t1 x)
    have hinj : Set.InjOn (chainQ rule s₀ n).hom.left.base F := fun a ha c hc hac =>
      chainQ_injective n a c ((show s.f.hom.left.base a = x from ha).trans
        (show s.f.hom.left.base c = x from hc).symm) hac
    have hPF : ∀ y, y ∉ F → pullFamily s.f.hom.left (pointFamily _ x) y = ⊤ :=
      fun y hy => pullFamily_pointFamily_of_ne _ hy
    have hsurj' : ∀ y ∈ F, ∀ b : s.Y.obj.left.presheaf.stalk y,
        ∃ a : (stage rule s₀ 0).Y.obj.left.presheaf.stalk ((chainQ rule s₀ n).hom.left.base y),
          b - ((chainQ rule s₀ n).hom.left.stalkMap y).hom a ∈
            pullFamily s.f.hom.left (pointFamily _ x) y := by
      intro y hy b
      obtain ⟨a, ha⟩ := exists_sub_mem_chain hsurj n y b
      refine ⟨a, ?_⟩
      rw [show x = s.f.hom.left.base y from (show s.f.hom.left.base y = x from hy).symm,
        pullFamily_pointFamily_self]
      exact ha
    have hmain := isLocallyFinitelyGenerated_kerFamily (chainQ rule s₀ n).hom.left
      (chainQ_isProperMap rule s₀ n).isClosedMap F hF hinj
      (pullFamily s.f.hom.left (pointFamily _ x)) (stepKernel rule s x') hPF
      (pullFamily_le_stepKernel s x') hsurj'
      (isLocallyFinitelyGenerated_fibreFamily
        (HironakaG10PNSourceNoether.hasAnalyticModelCharts _) _ _)
      (hstep n x') (isLocallyFinitelyGenerated_kerFamily_chain hsurj hstep n x)
    change IsLocallyFinitelyGenerated _
      (kerFamily ((Stage.q rule s).hom.left ≫ (chainQ rule s₀ n).hom.left)
        (pullFamily (Stage.next rule s).f.hom.left
          (pointFamily (Stage.next rule s).X.obj.left x')))
    rw [kerFamily_comp]
    exact hmain

/-- **Coherence of the fibre kernels (`hfg`)** from N6 and one-step coherence. -/
theorem isLocallyFinitelyGenerated_fibreKernel
    (hsurj : ∀ n, StepFibreSurjective rule (stage rule s₀ n))
    (hstep : ∀ n, StepKernelCoherent rule (stage rule s₀ n)) :
    ∀ (z : ∀ n, (stage rule s₀ n).X.obj.left) n,
      IsLocallyFinitelyGenerated (stage rule s₀ 0).Y.obj.left (fibreKernel rule s₀ z n) := by
  intro z n
  rw [fibreKernel_eq_kerFamily]
  exact isLocallyFinitelyGenerated_kerFamily_chain hsurj hstep n (z n)

/-- **Flattening from strict fibre decrease, `hfg` reduced to one step**: G10C's
`exists_flattening_of_fibreDecreases'` with the coherence of the fibre kernels replaced by the
one-step coherence of every stage. -/
theorem exists_flattening_of_fibreDecreases_of_stepKernel (hX : CompactSpace s₀.X.obj.left)
    (hf : IsProperMap s₀.f.hom.left.base)
    (hclosed : ∀ n, IsClosed (HironakaG10ChowStrictFlatLocus.nonflatImage (stage rule s₀ n).f))
    (hsurj : ∀ n, StepFibreSurjective rule (stage rule s₀ n))
    (hstep : ∀ n, StepKernelCoherent rule (stage rule s₀ n))
    (hdec : ∀ n, ∀ x' ∈ HironakaG10ChowStrictFlatLocus.nonflatImage (stage rule s₀ (n + 1)).f,
      StepFibreDecreasesAt rule (stage rule s₀ n) x') :
    ∃ (X' : SourceReducedComplexSpace) (σ : X' ⟶ s₀.X) (E : Set X'.obj.left),
      HironakaG10ChowTowerDomination.IsNativeBlowupTower s₀.X X' σ ∧ IsClosed E ∧
        interior E = ∅ ∧ HironakaG10ChowFlatteningReduction.IsOpenImmersionOn σ Eᶜ ∧
      ∃ (Y' : SourceReducedComplexSpace) (p : Y' ⟶ X') (q : Y' ⟶ s₀.Y),
        HironakaG10ChowFlatteningReduction.IsStrictTransform s₀.f σ E p q ∧
          HironakaG10ChowFlatBimeromorphicIso.IsFlatMorphism p :=
  exists_flattening_of_fibreDecreases' hX hf hclosed hsurj
    (isLocallyFinitelyGenerated_fibreKernel hsurj hstep) hdec

end

end Hironaka.Analytic.Unibranch.HironakaG10PNFibreKernel
