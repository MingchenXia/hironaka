import Hironaka.Analytic.Unibranch.HironakaG10SbPulledChartFlat
import Hironaka.Resolution.HironakaChowRelativeGraphPresentation
import Hironaka.Resolution.HironakaG10ChowAnalyticSquare

/-!
# N3 + N4 algebra: graph elimination of the pulled chart family, and flattener base change from presentations

Lane G10N34, run 0081 (G10GL's split-off items N3+N4, `G10GL/STATUS.md`, "Splittable — N3+N4").

* `compAlgHom_sub_mem_span` — **Hadamard's lemma for germ maps**: for holomorphic germ maps `p q : (ℂ^M,0) → (ℂ^K,0)`
  and every germ `h`, `h ∘ p - h ∘ q` lies in the ideal of the coordinate differences `p_k - q_k`.
* `pulledIdeal_eq` — the pulled chart ideal of a relative graph chart `K = J(u) + (x - F₀(u))`, by generators.
* **N3 in normal form** (`pulledJointEquiv`): for a source germ map `G : (ℂ^m,0) → (ℂ^n,0)` and a germ
  `B : (ℂ^r,0) → (ℂ^r,0)` (the blowup monomial map), the four maps `Ψ = (G, id)`, `Π = (id, B)`, `φ = (id, B)`,
  `F₀ = (G, id)` (`φ ∘ Ψ = F₀ ∘ Π`), every source ideal `J` and target ideal `I'`: the pulled chart family
  `𝒪_{ℂ^{(n+r)+(m+r)}} ⧸ (K ∘ (φ × id) + I')` of the relative graph chart `K` of `F₀` is the joint quotient
  `𝒪_{ℂ^{m+r}} ⧸ (Π^* J + Ψ^* I')`, by the substitution `(a, b) = (Ψ z, Π z)`, compatibly with the base maps
  (`pulledJointEquiv_pulledChartMap`).  This is the elimination of the graph coordinates of the analytic fibre product
  (Hironaka 1975, p. 529; the source-chart computation of `G10H3/STATUS.md`).
* **N4 transport** (`isFlattenerIdeal_map_of_presentations`): if a ring map `A → B` (the old family at a point) is
  presented as a relative chart `𝒪_{ℂ^d} ⧸ J → 𝒪_{ℂ^{d+t}} ⧸ K`, a base change `σ : A → A'` as
  `φ^* : 𝒪_{ℂ^d} ⧸ J → 𝒪_{ℂ^e} ⧸ I'` and the base-changed family `ψ : A' → C` as the pulled chart family, then for
  every flattener `P` of `A → B`, `σ P` is the flattener of `ψ` (Hironaka Th. 2.5 through
  `HironakaG10SbPulledChartFlat.isFlattenerIdeal_pulledChart`); and flatness over `V(J)` base-changes
  (`flat_map_of_presentations`).

No named input.
-/

set_option autoImplicit false

open Set Filter
open scoped Topology

namespace Hironaka.Analytic.Unibranch.HironakaG10GlFlattenerTransfer

open Hironaka Hironaka
  HolGerm HironakaRelativeNormalIdeal HironakaHolomorphicJetChartInvariance HironakaHolomorphicJetMonomialSpan
  HironakaActualCentreJointJets HironakaActualJointBaseFibre HironakaActualAnalyticBaseChangeCoefficients
  HironakaActualHolomorphicGraphIdeal HironakaChowRelativeGraphPresentation HironakaG10ChowAnalyticSquare
  HironakaChowPresentationIndependentFlattener HironakaG10HirFlatQuotient HironakaG10HirChartFlattener
  Hironaka.Analytic.Unibranch.HironakaG10SingularNativeChartFlattener Hironaka.Analytic.Unibranch.HironakaG10SbPulledChartFlat

noncomputable section

/-! ### Hadamard's lemma for germ maps -/

section Hadamard

variable {M K : ℕ}

private theorem holo_normalProjection :
    ∀ᶠ z in 𝓝 (0 : ComplexModel (M+K)), DifferentiableAt ℂ (actualJointNormalProjection M K) z :=
  Eventually.of_forall fun _ => (actualJointNormalProjection M K).differentiableAt

private theorem holo_comp_tangentProjection (q : ComplexModel M → ComplexModel K)
    (hq : ∀ᶠ z in 𝓝 0, DifferentiableAt ℂ q z) :
    ∀ᶠ z in 𝓝 (0 : ComplexModel (M+K)), DifferentiableAt ℂ (q ∘ tangentProjection M K) z := by
  have hp : Tendsto (tangentProjection M K) (𝓝 (0 : ComplexModel (M+K))) (𝓝 0) := by
    simpa only [map_zero] using (tangentProjection M K).continuous.tendsto 0
  filter_upwards [hp.eventually hq] with z hz
  exact hz.comp z (tangentProjection M K).differentiableAt

/-- **Hadamard's lemma for germ maps.**  For holomorphic germ maps `p q : (ℂ^M,0) → (ℂ^K,0)` and every germ `h`,
`h ∘ p - h ∘ q` lies in the ideal generated by the coordinate differences `p_k - q_k`. -/
theorem compAlgHom_sub_mem_span (p q : ComplexModel M → ComplexModel K)
    (hp : ∀ᶠ z in 𝓝 0, DifferentiableAt ℂ p z) (hp0 : p 0 = 0)
    (hq : ∀ᶠ z in 𝓝 0, DifferentiableAt ℂ q z) (hq0 : q 0 = 0) (h : HolGerm (ComplexModel K)) :
    compAlgHom p hp hp0 h - compAlgHom q hq hq0 h ∈
      Ideal.span (Set.range fun k : Fin K =>
        compAlgHom p hp hp0 (coordinateGerm k) - compAlgHom q hq hq0 (coordinateGerm k)) := by
  induction h using HolGerm.induction_on with
  | h f hf =>
  -- `H(x, y) = h(y) - h(q x)` vanishes on the graph of `q`, hence lies in its graph relations.
  have hq0' : (q ∘ tangentProjection M K) 0 = 0 := by simp [hq0]
  set H : HolGerm (ComplexModel (M+K)) :=
    compAlgHom (actualJointNormalProjection M K) holo_normalProjection (map_zero _) (HolGerm.mk f hf) -
      compAlgHom (q ∘ tangentProjection M K) (holo_comp_tangentProjection q hq) hq0' (HolGerm.mk f hf)
    with hH
  have hker : H ∈ RingHom.ker (graphTrace q hq hq0).toRingHom := by
    change graphTrace q hq hq0 H = 0
    rw [hH, map_sub, sub_eq_zero]
    unfold graphTrace
    simp only [compAlgHom_mk]
    apply HolGerm.mk_eq_mk_iff.mpr
    exact Eventually.of_forall fun z => by simp
  rw [ker_graphTrace_eq_graphRelations] at hker
  -- substitute `y = p x`
  have hmap := Ideal.mem_map_of_mem (graphTrace p hp hp0).toRingHom hker
  rw [graphRelations, Ideal.map_span, ← Set.range_comp] at hmap
  have hval : (graphTrace p hp hp0).toRingHom H =
      compAlgHom p hp hp0 (HolGerm.mk f hf) - compAlgHom q hq hq0 (HolGerm.mk f hf) := by
    change graphTrace p hp hp0 H = _
    rw [hH, map_sub]
    unfold graphTrace
    simp only [compAlgHom_mk]
    rw [← HolGerm.mk_sub, ← HolGerm.mk_sub]
    apply HolGerm.mk_eq_mk_iff.mpr
    exact Eventually.of_forall fun z => by simp
  have hfun : (fun k : Fin K =>
      compAlgHom p hp hp0 (coordinateGerm k) - compAlgHom q hq hq0 (coordinateGerm k)) =
      (graphTrace p hp hp0).toRingHom ∘ graphRelation q hq := by
    funext k
    change _ = graphTrace p hp hp0 (graphRelation q hq k)
    unfold graphTrace graphRelation coordinateGerm
    simp only [compAlgHom_mk]
    rw [← HolGerm.mk_sub]
    apply HolGerm.mk_eq_mk_iff.mpr
    exact Eventually.of_forall fun z => by simp [graphSection, tangentProjection_tangentInclusion]
  rw [hfun, ← hval]
  exact hmap

end Hadamard

/-! ### The pulled chart ideal of a relative graph chart -/

section PulledIdeal

variable (d t e : ℕ) (F₀ : ComplexModel t → ComplexModel d)
  (hF₀ : ∀ᶠ z in 𝓝 (0 : ComplexModel t), DifferentiableAt ℂ F₀ z) (hF₀0 : F₀ 0 = 0)
  (J : Ideal (HolGerm (ComplexModel t)))
  (φ : ComplexModel e → ComplexModel d)
  (hφ : ∀ᶠ v in 𝓝 (0 : ComplexModel e), DifferentiableAt ℂ φ v) (hφ0 : φ 0 = 0)
  (I' : Ideal (HolGerm (ComplexModel e)))

/-- The pulled graph relation `φ(a)_i - F₀(b)_i` on `ℂ^{e+t}`. -/
def pulledRelation (i : Fin d) : HolGerm (ComplexModel (e+t)) :=
  tangentPullback e t (compAlgHom φ hφ hφ0 (coordinateGerm i)) -
    jointNormalPullback e t (compAlgHom F₀ hF₀ hF₀0 (coordinateGerm i))

theorem jointBasePullback_jointNormalPullback (g : HolGerm (ComplexModel t)) :
    jointBasePullback d e t φ hφ hφ0 (jointNormalPullback d t g) = jointNormalPullback e t g := by
  unfold jointBasePullback jointNormalPullback
  exact compAlgHom_compAlgHom _ _ _ _ _ _ _ _ _ (fun w => by simp [jointBaseMap]) g

theorem jointBasePullback_coordinate (i : Fin d) :
    jointBasePullback d e t φ hφ hφ0 (coordinateGerm (i.castAdd t)) =
      tangentPullback e t (compAlgHom φ hφ hφ0 (coordinateGerm i)) := by
  unfold jointBasePullback tangentPullback coordinateGerm
  rw [compAlgHom_mk, compAlgHom_mk, compAlgHom_mk]
  apply HolGerm.mk_eq_mk_iff.mpr
  exact Eventually.of_forall fun w => by simp [jointBaseMap]

/-- **The pulled chart ideal of a relative graph chart, by generators**: `J(b) + (φ(a) - F₀(b)) + I'(a)`. -/
theorem pulledIdeal_eq :
    pulledIdeal d t e (relativeGraphIdeal d t F₀ hF₀ J) φ hφ hφ0 I' =
      J.map (jointNormalPullback e t).toRingHom ⊔
        Ideal.span (Set.range (pulledRelation d t e F₀ hF₀ hF₀0 φ hφ hφ0)) ⊔
        I'.map (tangentPullback e t).toRingHom := by
  unfold pulledIdeal relativeGraphIdeal
  rw [relativeGraphEquations_eq_span d t F₀ hF₀ hF₀0, Ideal.map_sup, Ideal.map_map, Ideal.map_span,
    ← Set.range_comp]
  have h1 : (jointBasePullback d e t φ hφ hφ0).toRingHom.comp (relativeSourcePullback d t).toRingHom =
      (jointNormalPullback e t).toRingHom := by
    ext1 g
    change jointBasePullback d e t φ hφ hφ0 (relativeSourcePullback d t g) = _
    rw [relativeSourcePullback_eq_normalPullback, jointBasePullback_jointNormalPullback]
    rfl
  have h2 : ⇑(jointBasePullback d e t φ hφ hφ0).toRingHom ∘ (fun i : Fin d => coordinateGerm (i.castAdd t) -
      jointNormalPullback d t (compAlgHom F₀ hF₀ hF₀0 (coordinateGerm i))) =
        pulledRelation d t e F₀ hF₀ hF₀0 φ hφ hφ0 := by
    funext i
    change jointBasePullback d e t φ hφ hφ0 (coordinateGerm (i.castAdd t) -
      jointNormalPullback d t (compAlgHom F₀ hF₀ hF₀0 (coordinateGerm i))) = _
    rw [map_sub, jointBasePullback_coordinate, jointBasePullback_jointNormalPullback]
    rfl
  rw [h1, h2]

theorem pulledRelation_mem (i : Fin d) :
    pulledRelation d t e F₀ hF₀ hF₀0 φ hφ hφ0 i ∈
      pulledIdeal d t e (relativeGraphIdeal d t F₀ hF₀ J) φ hφ hφ0 I' := by
  rw [pulledIdeal_eq d t e F₀ hF₀ hF₀0 J φ hφ hφ0 I']
  exact Ideal.mem_sup_left (Ideal.mem_sup_right (Ideal.subset_span ⟨i, rfl⟩))

end PulledIdeal

/-! ### N3 in normal form: elimination of the graph coordinates -/

section Elimination

variable (n m r : ℕ)

/-- `z ↦ (G(z_tan), z_norm)`. -/
def srcMap (G : ComplexModel m → ComplexModel n) (z : ComplexModel (m+r)) : ComplexModel (n+r) :=
  tangentInclusion n r (G (tangentProjection m r z)) +
    actualJointNormalInclusion n r (actualJointNormalProjection m r z)

/-- `z ↦ (z_tan, B(z_norm))`. -/
def blowMap (B : ComplexModel r → ComplexModel r) (z : ComplexModel (n+r)) : ComplexModel (n+r) :=
  tangentInclusion n r (tangentProjection n r z) +
    actualJointNormalInclusion n r (B (actualJointNormalProjection n r z))

variable {n m r}

@[simp] theorem tangentProjection_srcMap (G : ComplexModel m → ComplexModel n) (z : ComplexModel (m+r)) :
    tangentProjection n r (srcMap n m r G z) = G (tangentProjection m r z) := by
  simp [srcMap, tangentProjection_tangentInclusion]

@[simp] theorem normalProjection_srcMap (G : ComplexModel m → ComplexModel n) (z : ComplexModel (m+r)) :
    actualJointNormalProjection n r (srcMap n m r G z) = actualJointNormalProjection m r z := by
  simp [srcMap]

@[simp] theorem tangentProjection_blowMap (B : ComplexModel r → ComplexModel r) (z : ComplexModel (n+r)) :
    tangentProjection n r (blowMap n r B z) = tangentProjection n r z := by
  simp [blowMap, tangentProjection_tangentInclusion]

@[simp] theorem normalProjection_blowMap (B : ComplexModel r → ComplexModel r) (z : ComplexModel (n+r)) :
    actualJointNormalProjection n r (blowMap n r B z) = B (actualJointNormalProjection n r z) := by
  simp [blowMap]

/-- Points of `ℂ^{a+b}` are determined by their two blocks. -/
theorem ext_blocks {a b : ℕ} {z w : ComplexModel (a+b)}
    (ht : tangentProjection a b z = tangentProjection a b w)
    (hn : actualJointNormalProjection a b z = actualJointNormalProjection a b w) : z = w := by
  ext k
  refine Fin.addCases (fun i => ?_) (fun i => ?_) k
  · exact congrArg (fun u : ComplexModel a => u i) ht
  · exact congrArg (fun u : ComplexModel b => u i) hn

theorem srcMap_differentiable (G : ComplexModel m → ComplexModel n)
    (hG : ∀ᶠ z in 𝓝 0, DifferentiableAt ℂ G z) :
    ∀ᶠ z in 𝓝 (0 : ComplexModel (m+r)), DifferentiableAt ℂ (srcMap n m r G) z := by
  have hp : Tendsto (tangentProjection m r) (𝓝 (0 : ComplexModel (m+r))) (𝓝 0) := by
    simpa only [map_zero] using (tangentProjection m r).continuous.tendsto 0
  filter_upwards [hp.eventually hG] with z hz
  exact ((tangentInclusion n r).differentiableAt.comp z
    (hz.comp z (tangentProjection m r).differentiableAt)).add
      ((actualJointNormalInclusion n r).differentiableAt.comp z
        (actualJointNormalProjection m r).differentiableAt)

theorem srcMap_zero (G : ComplexModel m → ComplexModel n) (hG0 : G 0 = 0) :
    srcMap n m r G 0 = 0 := by
  simp [srcMap, hG0]

theorem blowMap_differentiable (B : ComplexModel r → ComplexModel r)
    (hB : ∀ᶠ z in 𝓝 0, DifferentiableAt ℂ B z) :
    ∀ᶠ z in 𝓝 (0 : ComplexModel (n+r)), DifferentiableAt ℂ (blowMap n r B) z := by
  have hp : Tendsto (actualJointNormalProjection n r) (𝓝 (0 : ComplexModel (n+r))) (𝓝 0) := by
    simpa only [map_zero] using (actualJointNormalProjection n r).continuous.tendsto 0
  filter_upwards [hp.eventually hB] with z hz
  exact ((tangentInclusion n r).differentiableAt.comp z (tangentProjection n r).differentiableAt).add
    ((actualJointNormalInclusion n r).differentiableAt.comp z
      (hz.comp z (actualJointNormalProjection n r).differentiableAt))

theorem blowMap_zero (B : ComplexModel r → ComplexModel r) (hB0 : B 0 = 0) :
    blowMap n r B 0 = 0 := by
  simp [blowMap, hB0]

/-- The square of the four normal-form maps: `φ ∘ Ψ = F₀ ∘ Π`. -/
theorem blowMap_srcMap (G : ComplexModel m → ComplexModel n) (B : ComplexModel r → ComplexModel r)
    (z : ComplexModel (m+r)) :
    blowMap n r B (srcMap n m r G z) = srcMap n m r G (blowMap m r B z) :=
  ext_blocks (by simp) (by simp)

/-- The substitution `z ↦ (Ψ z, Π z)` into the pulled chart ambient. -/
def substMap (G : ComplexModel m → ComplexModel n) (B : ComplexModel r → ComplexModel r)
    (z : ComplexModel (m+r)) : ComplexModel ((n+r)+(m+r)) :=
  tangentInclusion (n+r) (m+r) (srcMap n m r G z) +
    actualJointNormalInclusion (n+r) (m+r) (blowMap m r B z)

/-- The retraction `(a, b) ↦ (b_tan, a_norm)`. -/
def retractMap (n m r : ℕ) (x : ComplexModel ((n+r)+(m+r))) : ComplexModel (m+r) :=
  tangentInclusion m r (tangentProjection m r (actualJointNormalProjection (n+r) (m+r) x)) +
    actualJointNormalInclusion m r (actualJointNormalProjection n r (tangentProjection (n+r) (m+r) x))

@[simp] theorem tangentProjection_substMap (G : ComplexModel m → ComplexModel n)
    (B : ComplexModel r → ComplexModel r) (z : ComplexModel (m+r)) :
    tangentProjection (n+r) (m+r) (substMap G B z) = srcMap n m r G z := by
  simp [substMap, tangentProjection_tangentInclusion]

@[simp] theorem normalProjection_substMap (G : ComplexModel m → ComplexModel n)
    (B : ComplexModel r → ComplexModel r) (z : ComplexModel (m+r)) :
    actualJointNormalProjection (n+r) (m+r) (substMap G B z) = blowMap m r B z := by
  simp [substMap]

@[simp] theorem tangentProjection_retractMap (x : ComplexModel ((n+r)+(m+r))) :
    tangentProjection m r (retractMap n m r x) =
      tangentProjection m r (actualJointNormalProjection (n+r) (m+r) x) := by
  simp [retractMap, tangentProjection_tangentInclusion]

@[simp] theorem normalProjection_retractMap (x : ComplexModel ((n+r)+(m+r))) :
    actualJointNormalProjection m r (retractMap n m r x) =
      actualJointNormalProjection n r (tangentProjection (n+r) (m+r) x) := by
  simp [retractMap]

theorem retractMap_substMap (G : ComplexModel m → ComplexModel n) (B : ComplexModel r → ComplexModel r)
    (z : ComplexModel (m+r)) : retractMap n m r (substMap G B z) = z :=
  ext_blocks (by simp) (by simp)

theorem substMap_differentiable (G : ComplexModel m → ComplexModel n)
    (hG : ∀ᶠ z in 𝓝 0, DifferentiableAt ℂ G z)
    (B : ComplexModel r → ComplexModel r) (hB : ∀ᶠ z in 𝓝 0, DifferentiableAt ℂ B z) :
    ∀ᶠ z in 𝓝 (0 : ComplexModel (m+r)), DifferentiableAt ℂ (substMap G B) z := by
  filter_upwards [srcMap_differentiable (r := r) G hG, blowMap_differentiable (n := m) B hB] with z h1 h2
  exact ((tangentInclusion (n+r) (m+r)).differentiableAt.comp z h1).add
    ((actualJointNormalInclusion (n+r) (m+r)).differentiableAt.comp z h2)

theorem substMap_zero (G : ComplexModel m → ComplexModel n) (hG0 : G 0 = 0)
    (B : ComplexModel r → ComplexModel r) (hB0 : B 0 = 0) : substMap G B 0 = 0 := by
  simp [substMap, srcMap_zero G hG0, blowMap_zero B hB0]

theorem retractMap_differentiable :
    ∀ᶠ x in 𝓝 (0 : ComplexModel ((n+r)+(m+r))), DifferentiableAt ℂ (retractMap n m r) x :=
  Eventually.of_forall fun _ =>
    (((tangentInclusion m r).comp ((tangentProjection m r).comp (actualJointNormalProjection (n+r) (m+r)))) +
      ((actualJointNormalInclusion m r).comp
        ((actualJointNormalProjection n r).comp (tangentProjection (n+r) (m+r))))).differentiableAt

theorem retractMap_zero : retractMap n m r 0 = 0 := by simp [retractMap]

variable (G : ComplexModel m → ComplexModel n) (hG : ∀ᶠ z in 𝓝 0, DifferentiableAt ℂ G z) (hG0 : G 0 = 0)
  (B : ComplexModel r → ComplexModel r) (hB : ∀ᶠ z in 𝓝 0, DifferentiableAt ℂ B z) (hB0 : B 0 = 0)
  (J : Ideal (HolGerm (ComplexModel (m+r)))) (I' : Ideal (HolGerm (ComplexModel (n+r))))

/-- The source map pullback `Ψ^*`. -/
abbrev srcPullback : HolGerm (ComplexModel (n+r)) →ₐ[ℂ] HolGerm (ComplexModel (m+r)) :=
  compAlgHom (srcMap n m r G) (srcMap_differentiable G hG) (srcMap_zero G hG0)

/-- The blowup pullback `Π^*` on the source ambient. -/
abbrev blowPullback : HolGerm (ComplexModel (m+r)) →ₐ[ℂ] HolGerm (ComplexModel (m+r)) :=
  compAlgHom (blowMap m r B) (blowMap_differentiable B hB) (blowMap_zero B hB0)

/-- The substitution pullback `g ↦ g(Ψ z, Π z)`. -/
abbrev substPullback : HolGerm (ComplexModel ((n+r)+(m+r))) →ₐ[ℂ] HolGerm (ComplexModel (m+r)) :=
  compAlgHom (substMap G B) (substMap_differentiable G hG B hB) (substMap_zero G hG0 B hB0)

/-- The ideal of the joint quotient in normal form: `Π^* J + Ψ^* I'`. -/
def jointGermIdeal : Ideal (HolGerm (ComplexModel (m+r))) :=
  J.map (blowPullback B hB hB0).toRingHom ⊔ I'.map (srcPullback G hG hG0).toRingHom

/-- The pulled ideal of the normal form: `K(φ(a), b) + I'(a)` for the relative graph chart `K` of `F₀ = (G, id)`. -/
abbrev normalPulledIdeal : Ideal (HolGerm (ComplexModel ((n+r)+(m+r)))) :=
  pulledIdeal (n+r) (m+r) (n+r)
    (relativeGraphIdeal (n+r) (m+r) (srcMap n m r G) (srcMap_differentiable G hG) J)
    (blowMap n r B) (blowMap_differentiable B hB) (blowMap_zero B hB0) I'

theorem substPullback_tangentPullback (a : HolGerm (ComplexModel (n+r))) :
    substPullback G hG hG0 B hB hB0 (tangentPullback (n+r) (m+r) a) = srcPullback G hG hG0 a := by
  unfold tangentPullback
  exact compAlgHom_compAlgHom _ _ _ _ _ _ _ _ _ (fun z => by simp) a

theorem substPullback_jointNormalPullback (g : HolGerm (ComplexModel (m+r))) :
    substPullback G hG hG0 B hB hB0 (jointNormalPullback (n+r) (m+r) g) = blowPullback B hB hB0 g := by
  unfold jointNormalPullback
  exact compAlgHom_compAlgHom _ _ _ _ _ _ _ _ _ (fun z => by simp) g

theorem substPullback_pulledRelation (i : Fin (n+r)) :
    substPullback G hG hG0 B hB hB0
      (pulledRelation (n+r) (m+r) (n+r) (srcMap n m r G) (srcMap_differentiable G hG) (srcMap_zero G hG0)
        (blowMap n r B) (blowMap_differentiable B hB) (blowMap_zero B hB0) i) = 0 := by
  unfold pulledRelation tangentPullback jointNormalPullback coordinateGerm
  simp only [compAlgHom_mk, map_sub]
  rw [sub_eq_zero]
  apply HolGerm.mk_eq_mk_iff.mpr
  exact Eventually.of_forall fun z => by simp [blowMap_srcMap]

/-- The substitution maps the pulled ideal onto the joint ideal. -/
theorem map_substPullback_normalPulledIdeal :
    (normalPulledIdeal G hG B hB hB0 J I').map (substPullback G hG hG0 B hB hB0).toRingHom =
      jointGermIdeal G hG hG0 B hB hB0 J I' := by
  rw [normalPulledIdeal, pulledIdeal_eq (n+r) (m+r) (n+r) (srcMap n m r G) (srcMap_differentiable G hG)
    (srcMap_zero G hG0) J (blowMap n r B) (blowMap_differentiable B hB) (blowMap_zero B hB0) I', Ideal.map_sup, Ideal.map_sup, Ideal.map_map, Ideal.map_map, Ideal.map_span,
    ← Set.range_comp]
  have h1 : (substPullback G hG hG0 B hB hB0).toRingHom.comp (jointNormalPullback (n+r) (m+r)).toRingHom =
      (blowPullback B hB hB0).toRingHom :=
    RingHom.ext fun g => substPullback_jointNormalPullback G hG hG0 B hB hB0 g
  have h2 : (substPullback G hG hG0 B hB hB0).toRingHom.comp (tangentPullback (n+r) (m+r)).toRingHom =
      (srcPullback G hG hG0).toRingHom :=
    RingHom.ext fun a => substPullback_tangentPullback G hG hG0 B hB hB0 a
  have h3 : Ideal.span (Set.range (⇑(substPullback G hG hG0 B hB hB0).toRingHom ∘
      pulledRelation (n+r) (m+r) (n+r) (srcMap n m r G) (srcMap_differentiable G hG) (srcMap_zero G hG0)
        (blowMap n r B) (blowMap_differentiable B hB) (blowMap_zero B hB0))) = ⊥ := by
    rw [Ideal.span_eq_bot]
    rintro _ ⟨i, rfl⟩
    exact substPullback_pulledRelation G hG hG0 B hB hB0 i
  rw [h1, h2, h3, sup_bot_eq]
  rfl

theorem compAlgHom_id_apply {k : ℕ} (hid : ∀ᶠ z in 𝓝 (0 : ComplexModel k), DifferentiableAt ℂ (id : ComplexModel k → ComplexModel k) z)
    (g : HolGerm (ComplexModel k)) : compAlgHom id hid rfl g = g := by
  induction g using HolGerm.induction_on with
  | h F hF => rfl

private theorem holo_id {k : ℕ} :
    ∀ᶠ z in 𝓝 (0 : ComplexModel k), DifferentiableAt ℂ (id : ComplexModel k → ComplexModel k) z :=
  Eventually.of_forall fun _ => differentiableAt_id

/-- The retraction pullback `ρ^*` is a section of `Φ^*`. -/
theorem substPullback_retract (g : HolGerm (ComplexModel (m+r))) :
    substPullback G hG hG0 B hB hB0
      (compAlgHom (retractMap n m r) retractMap_differentiable retractMap_zero g) = g := by
  rw [compAlgHom_compAlgHom _ _ _ _ _ _ id holo_id rfl (fun z => (retractMap_substMap G B z).symm),
    compAlgHom_id_apply]

theorem substPullback_surjective : Function.Surjective (substPullback G hG hG0 B hB hB0) :=
  fun g => ⟨_, substPullback_retract G hG hG0 B hB hB0 g⟩

include hG hB in
private theorem holo_substRetract :
    ∀ᶠ x in 𝓝 (0 : ComplexModel ((n+r)+(m+r))), DifferentiableAt ℂ (substMap G B ∘ retractMap n m r) x := by
  have hρ : Tendsto (retractMap n m r) (𝓝 (0 : ComplexModel ((n+r)+(m+r)))) (𝓝 0) := by
    have hc : Continuous (retractMap n m r) :=
      (((tangentInclusion m r).comp ((tangentProjection m r).comp (actualJointNormalProjection (n+r) (m+r)))) +
        ((actualJointNormalInclusion m r).comp
          ((actualJointNormalProjection n r).comp (tangentProjection (n+r) (m+r))))).continuous
    simpa only [retractMap_zero] using hc.tendsto 0
  filter_upwards [hρ.eventually (substMap_differentiable G hG B hB)] with x hx
  have hd : DifferentiableAt ℂ (retractMap n m r) x :=
    (((tangentInclusion m r).comp ((tangentProjection m r).comp (actualJointNormalProjection (n+r) (m+r)))) +
      ((actualJointNormalInclusion m r).comp
        ((actualJointNormalProjection n r).comp (tangentProjection (n+r) (m+r))))).differentiableAt
  exact hx.comp x hd

/-- Each coordinate difference `x_k - (Φ ρ x)_k` is a pulled graph relation, its negative, or zero. -/
theorem coordinate_sub_substRetract_mem (k : Fin ((n+r)+(m+r))) :
    compAlgHom id holo_id rfl (coordinateGerm k) -
      compAlgHom (substMap G B ∘ retractMap n m r) (holo_substRetract G hG B hB)
        (by simp [retractMap_zero, substMap_zero G hG0 B hB0]) (coordinateGerm k) ∈
      normalPulledIdeal G hG B hB hB0 J I' := by
  have hrel (i : Fin (n+r)) := pulledRelation_mem (n+r) (m+r) (n+r) (srcMap n m r G)
    (srcMap_differentiable G hG) (srcMap_zero G hG0) J (blowMap n r B) (blowMap_differentiable B hB)
    (blowMap_zero B hB0) I' i
  unfold pulledRelation tangentPullback jointNormalPullback coordinateGerm at hrel
  unfold coordinateGerm
  simp only [compAlgHom_mk] at hrel ⊢
  rw [← HolGerm.mk_sub]
  refine Fin.addCases (fun a => ?_) (fun b => ?_) k
  · refine Fin.addCases (fun i => ?_) (fun i => ?_) a
    · convert hrel (i.castAdd r) using 1
      rw [← HolGerm.mk_sub]
      apply HolGerm.mk_eq_mk_iff.mpr
      exact Eventually.of_forall fun x => by
        simp [srcMap, blowMap, retractMap, substMap, tangentProjection_tangentInclusion]
    · convert (normalPulledIdeal G hG B hB hB0 J I').zero_mem using 1
      rw [← HolGerm.mk_zero]
      apply HolGerm.mk_eq_mk_iff.mpr
      exact Eventually.of_forall fun x => by
        simp [srcMap, blowMap, retractMap, substMap, tangentProjection_tangentInclusion]
  · refine Fin.addCases (fun i => ?_) (fun i => ?_) b
    · convert (normalPulledIdeal G hG B hB hB0 J I').zero_mem using 1
      rw [← HolGerm.mk_zero]
      apply HolGerm.mk_eq_mk_iff.mpr
      exact Eventually.of_forall fun x => by
        simp [srcMap, blowMap, retractMap, substMap, tangentProjection_tangentInclusion]
    · convert (normalPulledIdeal G hG B hB hB0 J I').neg_mem (hrel (i.natAdd n)) using 1
      rw [← HolGerm.mk_sub, ← HolGerm.mk_neg]
      apply HolGerm.mk_eq_mk_iff.mpr
      exact Eventually.of_forall fun x => by
        simp [srcMap, blowMap, retractMap, substMap, tangentProjection_tangentInclusion]

/-- The kernel of the substitution lies in the pulled ideal (Hadamard). -/
theorem ker_substPullback_le :
    RingHom.ker (substPullback G hG hG0 B hB hB0).toRingHom ≤ normalPulledIdeal G hG B hB hB0 J I' := by
  intro x hx
  change substPullback G hG hG0 B hB hB0 x = 0 at hx
  have hzero : compAlgHom (substMap G B ∘ retractMap n m r) (holo_substRetract G hG B hB)
      (by simp [retractMap_zero, substMap_zero G hG0 B hB0]) x = 0 := by
    rw [← compAlgHom_compAlgHom (retractMap n m r) retractMap_differentiable retractMap_zero (substMap G B)
      (substMap_differentiable G hG B hB) (substMap_zero G hG0 B hB0) (substMap G B ∘ retractMap n m r)
      (holo_substRetract G hG B hB) (by simp [retractMap_zero, substMap_zero G hG0 B hB0]) (fun _ => rfl)]
    change compAlgHom (retractMap n m r) retractMap_differentiable retractMap_zero
      (substPullback G hG hG0 B hB hB0 x) = 0
    rw [hx, map_zero]
  have hH := compAlgHom_sub_mem_span id (substMap G B ∘ retractMap n m r) holo_id rfl
    (holo_substRetract G hG B hB) (by simp [retractMap_zero, substMap_zero G hG0 B hB0]) x
  rw [hzero, sub_zero, compAlgHom_id_apply] at hH
  refine (Ideal.span_le.mpr ?_) hH
  rintro _ ⟨k, rfl⟩
  exact coordinate_sub_substRetract_mem G hG hG0 B hB hB0 J I' k

/-- **N3 in normal form.**  The pulled chart family of the relative graph chart of `F₀ = (G, id)` along
`φ = (id, B)` is the joint quotient `𝒪_{ℂ^{m+r}} ⧸ (Π^* J + Ψ^* I')`, through the substitution `(Ψ, Π)`. -/
def pulledJointEquiv :
    (HolGerm (ComplexModel ((n+r)+(m+r))) ⧸ normalPulledIdeal G hG B hB hB0 J I') ≃+*
      HolGerm (ComplexModel (m+r)) ⧸ jointGermIdeal G hG hG0 B hB hB0 J I' :=
  let q := (Ideal.Quotient.mk (jointGermIdeal G hG hG0 B hB hB0 J I')).comp
    (substPullback G hG hG0 B hB hB0).toRingHom
  have hq : Function.Surjective q :=
    Ideal.Quotient.mk_surjective.comp (substPullback_surjective G hG hG0 B hB hB0)
  have hker : RingHom.ker q = normalPulledIdeal G hG B hB hB0 J I' := by
    have h : RingHom.ker q = Ideal.comap (substPullback G hG hG0 B hB hB0).toRingHom
        (jointGermIdeal G hG hG0 B hB hB0 J I') := by
      rw [← RingHom.comap_ker, Ideal.mk_ker]
    rw [h, ← map_substPullback_normalPulledIdeal G hG hG0 B hB hB0 J I',
      Ideal.comap_map_of_surjective (substPullback G hG hG0 B hB hB0).toRingHom
        (substPullback_surjective G hG hG0 B hB hB0)]
    exact sup_eq_left.mpr (ker_substPullback_le G hG hG0 B hB hB0 J I')
  (Ideal.quotEquivOfEq hker.symm).trans (RingHom.quotientKerEquivOfSurjective hq)

theorem pulledJointEquiv_mk (g : HolGerm (ComplexModel ((n+r)+(m+r)))) :
    pulledJointEquiv G hG hG0 B hB hB0 J I' (Ideal.Quotient.mk _ g) =
      Ideal.Quotient.mk _ (substPullback G hG hG0 B hB hB0 g) :=
  rfl

/-- The base maps correspond: `pulledChartMap` becomes `Ψ^*`. -/
theorem pulledJointEquiv_pulledChartMap (a : HolGerm (ComplexModel (n+r))) :
    pulledJointEquiv G hG hG0 B hB hB0 J I'
      (pulledChartMap (n+r) (m+r) (n+r)
        (relativeGraphIdeal (n+r) (m+r) (srcMap n m r G) (srcMap_differentiable G hG) J)
        (blowMap n r B) (blowMap_differentiable B hB) (blowMap_zero B hB0) I' (Ideal.Quotient.mk I' a)) =
      Ideal.Quotient.mk _ (srcPullback G hG hG0 a) := by
  rw [pulledChartMap_mk, pulledJointEquiv_mk, substPullback_tangentPullback]

end Elimination

/-! ### N4: the flattener of a base-changed family, from chart presentations -/

section Transport

variable {A Bx A' C : Type*} [CommRing A] [CommRing Bx] [CommRing A'] [CommRing C]
  (d t e : ℕ) (JY : Ideal (HolGerm (ComplexModel d))) (K : Ideal (HolGerm (ComplexModel (d+t))))
  (hJK : JY.map (tangentPullback d t).toRingHom ≤ K)
  (φ : ComplexModel e → ComplexModel d)
  (hφ : ∀ᶠ v in 𝓝 (0 : ComplexModel e), DifferentiableAt ℂ φ v) (hφ0 : φ 0 = 0)
  (I' : Ideal (HolGerm (ComplexModel e)))
  (hJI : JY ≤ I'.comap (compAlgHom φ hφ hφ0).toRingHom)
  (Fh : A →+* Bx) (σ : A →+* A') (ψ : A' →+* C)
  (eA : (HolGerm (ComplexModel d) ⧸ JY) ≃+* A) (eB : (HolGerm (ComplexModel (d+t)) ⧸ K) ≃+* Bx)
  (hB : Fh.comp eA.toRingHom = eB.toRingHom.comp (singularChartMap d t JY K hJK))
  (eA' : (HolGerm (ComplexModel e) ⧸ I') ≃+* A')
  (hA' : σ.comp eA.toRingHom = eA'.toRingHom.comp (Ideal.quotientMap I' (compAlgHom φ hφ hφ0).toRingHom hJI))
  (eC : (HolGerm (ComplexModel (e+t)) ⧸ pulledIdeal d t e K φ hφ hφ0 I') ≃+* C)
  (hC : ψ.comp eA'.toRingHom = eC.toRingHom.comp (pulledChartMap d t e K φ hφ hφ0 I'))

include hA' hC in
/-- **Hironaka Th. 2.5 through presentations.**  The image under the base change `σ` of the chart flattener of
`A → B` is the flattener of the base-changed family `ψ : A' → C`. -/
theorem isFlattenerIdeal_chart_map :
    IsFlattenerIdeal ψ ((((canonicalFlattenerIdeal d t K).map (Ideal.Quotient.mk JY)).map eA.toRingHom).map σ) := by
  have h2 : IsFlattenerIdeal ψ ((pulledFlattener d t e K φ hφ hφ0 I').map eA'.toRingHom) := by
    have h := ((isFlattenerIdeal_pulledChart d t e K φ hφ hφ0 I').ringEquiv_comp eC).comp_ringEquiv eA'.symm
    have hcomp : (eC.toRingHom.comp (pulledChartMap d t e K φ hφ hφ0 I')).comp eA'.symm.toRingHom = ψ := by
      rw [← hC]
      ext x
      simp
    have heq : (pulledFlattener d t e K φ hφ hφ0 I').map eA'.toRingHom =
        (pulledFlattener d t e K φ hφ hφ0 I').comap eA'.symm.toRingHom := Ideal.map_comap_of_equiv eA'
    rw [hcomp, ← heq] at h
    exact h
  have heq : (((canonicalFlattenerIdeal d t K).map (Ideal.Quotient.mk JY)).map eA.toRingHom).map σ =
      (pulledFlattener d t e K φ hφ hφ0 I').map eA'.toRingHom := by
    unfold pulledFlattener
    have hcomp : (σ.comp eA.toRingHom).comp (Ideal.Quotient.mk JY) =
        (eA'.toRingHom.comp (Ideal.Quotient.mk I')).comp (compAlgHom φ hφ hφ0).toRingHom := by
      rw [hA', RingHom.comp_assoc, Ideal.quotientMap_comp_mk, ← RingHom.comp_assoc]
    rw [Ideal.map_map, Ideal.map_map, Ideal.map_map, Ideal.map_map, hcomp]
  rw [heq]
  exact h2

include hB hA' hC in
/-- **Flattener base change** (N4): for every flattener `P` of `A → B`, `σ P` is the flattener of `ψ`. -/
theorem isFlattenerIdeal_map_of_presentations (P : Ideal A) (hP : IsFlattenerIdeal Fh P) :
    IsFlattenerIdeal ψ (P.map σ) := by
  have h1 := isFlattenerIdeal_of_chart_stalk_square d t JY K hJK Fh eA eB hB
  rw [hP.unique h1]
  exact isFlattenerIdeal_chart_map d t e JY K φ hφ hφ0 I' hJI σ ψ eA eA' hA' eC hC

include hB hA' hC in
/-- **Base change of flatness** (N4, flat form): if `A → B` is flat over `V(J)`, then `ψ` is flat over `V(σ J)`. -/
theorem flat_map_of_presentations (Jt : Ideal A) (hJt : (quotMap Fh Jt).Flat) :
    (quotMap ψ (Jt.map σ)).Flat := by
  have h1 := isFlattenerIdeal_of_chart_stalk_square d t JY K hJK Fh eA eB hB
  have h := isFlattenerIdeal_chart_map d t e JY K φ hφ hφ0 I' hJI σ ψ eA eA' hA' eC hC
  exact (h (Jt.map σ)).mpr (Ideal.map_mono ((h1 Jt).mp hJt))

end Transport


end

