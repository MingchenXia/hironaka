import Hironaka.Analytic.Unibranch.HironakaG10NfJointPivot
import Hironaka.Resolution.HironakaG10HirIdealGerms
import Hironaka.Analytic.Unibranch.HironakaG10NfTorsionSpread

/-!
# H3.4 (`spread`, generic): sections of an actual subspace are locally restrictions of ambient functions

Lane G10H3, run 0081 (field `spread` of `HironakaG10NfGeoFibreModel.GeoFibreModel`).

* `exists_ambient_rep` — a section `σ` of the actual subspace sheaf of `C ⊆ M` near `p₀` is, near `p₀`, the class of
  one ambient holomorphic function `k`: `germ_p σ = incl^♯ (germ k)` for all `p` near `p₀`;
* `isLocallyFinitelyGeneratedOn_map` — local finite generation transports along a morphism;
* `pulledFam_eq` — the image under `targetStalkToJoint ∘ φ^♯` of an ideal generated by germs of sections is the span
  of the classes of the germs of the represented chart functions;
* `eventually_pivotTorsion_le_fam`, `eventually_pivotTorsion_le_of_fg` — **spread**: a bound
  `pivotTorsion o ≤ (targetStalkToJoint ∘ φ^♯)(H)` at a point of the local domain holds at all nearby points, for any
  ideal family `H` locally finitely generated near `φ(f o)`.

No named input.
-/

set_option autoImplicit false

open Set Filter TopologicalSpace CategoryTheory Opposite AlgebraicGeometry
open scoped Topology Manifold ContDiff

namespace Hironaka.Analytic.Unibranch.HironakaG10NfSpreadGerm

noncomputable section

open Hironaka Hironaka.HolomorphicIdealSheaves
  Hironaka HironakaActualAnalyticSubspace HironakaActualAnalyticSubspaceMaps
  HironakaSmoothCentreRealDomainActualSheafStalk HironakaRealOpenGeometricStrictSaturation
  HironakaG10RealOpenStrictTorsionKernel HironakaG10JointStrictTorsion HironakaG10JointNativeScalar

variable {n : ℕ} {M : Type} [TopologicalSpace M] [ChartedSpace (ComplexModel n) M] [IsComplexManifold n M]

/-- **A section of the actual subspace sheaf is, near a point, the class of one ambient holomorphic function.** -/
theorem exists_ambient_rep (C : Set M) (O : Opens (actualSubspaceLocallyRingedSpace (n := n) C))
    (σ : (actualSubspaceLocallyRingedSpace (n := n) C).presheaf.obj (op O)) (p₀ : C) (hp₀ : p₀ ∈ O) :
    ∃ (k : M → ℂ) (U : Opens M) (_ : p₀.val ∈ U) (hk : ∀ z ∈ U, HolomorphicAt n k z),
      ∀ᶠ p in 𝓝 p₀, ∃ (hpO : p ∈ O) (hpU : p.val ∈ U),
        (actualSubspaceLocallyRingedSpace (n := n) C).presheaf.germ O p hpO σ =
          (actualSubspaceInclusion (n := n) C).stalkMap p (actualOriginalFunctionGerm p.val k (hk p.val hpU)) := by
  have hsurj : Function.Surjective ((actualSubspaceInclusion (n := n) C).stalkMap p₀).hom :=
    actualSubspaceInclusionRingedHom_stalk_surjective (n := n) C p₀
  obtain ⟨a, ha⟩ := hsurj ((actualSubspaceLocallyRingedSpace (n := n) C).presheaf.germ O p₀ hp₀ σ)
  obtain ⟨U, hU, s, hs⟩ := (actualComplexStructureSheaf (n := n) M).presheaf.exists_germ_eq a
  have hk : ∀ z ∈ U, HolomorphicAt n (sectionExtension U s) z := fun z hz => sectionExtension_holomorphicAt U s z hz
  refine ⟨sectionExtension U s, U, hU, hk, ?_⟩
  -- the pulled-back section
  set τ := (actualSubspaceInclusion (n := n) C).c.app (op U) s
  have hτ : ∀ (p : C) (hp : p.val ∈ U),
      (actualSubspaceLocallyRingedSpace (n := n) C).presheaf.germ
          ((Opens.map (actualSubspaceInclusion (n := n) C).base).obj U) p hp τ =
        (actualSubspaceInclusion (n := n) C).stalkMap p
          (actualOriginalFunctionGerm p.val (sectionExtension U s) (hk p.val hp)) := by
    intro p hp
    rw [actualOriginalFunctionGerm_eq_section U p.val hp s _ _ EventuallyEq.rfl]
    exact (PresheafedSpace.stalkMap_germ_apply (actualSubspaceInclusion (n := n) C).toHom U p hp s).symm
  have heq : (actualSubspaceLocallyRingedSpace (n := n) C).presheaf.germ O p₀ hp₀ σ =
      (actualSubspaceLocallyRingedSpace (n := n) C).presheaf.germ
        ((Opens.map (actualSubspaceInclusion (n := n) C).base).obj U) p₀ hU τ := by
    refine Eq.trans ?_ (hτ p₀ hU).symm
    refine ha.symm.trans (congrArg ((actualSubspaceInclusion (n := n) C).stalkMap p₀).hom ?_)
    exact hs.symm.trans (actualOriginalFunctionGerm_eq_section U p₀.val hU s _ _ EventuallyEq.rfl).symm
  obtain ⟨W, hW, iO, iU, hWe⟩ := (actualSubspaceLocallyRingedSpace (n := n) C).presheaf.germ_eq p₀ hp₀ hU σ τ heq
  filter_upwards [W.isOpen.mem_nhds hW] with p hp
  refine ⟨iO.le hp, iU.le hp, ?_⟩
  rw [← (actualSubspaceLocallyRingedSpace (n := n) C).presheaf.germ_res_apply iO p hp σ, hWe,
    (actualSubspaceLocallyRingedSpace (n := n) C).presheaf.germ_res_apply iU p hp τ]
  exact hτ p (iU.le hp)

/-- An eventual property near `⟨g o, _⟩` in a subspace pulls back to an eventual property near `o`. -/
theorem eventually_comp_subtype {Y₀ A : Type} [TopologicalSpace Y₀] [TopologicalSpace A] (V₀ : Set Y₀) (g : A → Y₀)
    (o : A) (hg : ContinuousAt g o) (hoV : g o ∈ V₀) {P : V₀ → Prop} (h : ∀ᶠ p in 𝓝 (⟨g o, hoV⟩ : V₀), P p) :
    ∀ᶠ y in 𝓝 o, ∀ hyV : g y ∈ V₀, P ⟨g y, hyV⟩ := by
  obtain ⟨u, hu, hsub⟩ := (mem_nhds_subtype V₀ _ _).mp h
  filter_upwards [hg hu] with y hy hyV
  exact hsub hy

/-- **Local finite generation transports along a morphism** (by the pulled-back sections). -/
theorem isLocallyFinitelyGeneratedOn_map {Xs Zs : LocallyRingedSpace.{0}} (g : Xs ⟶ Zs) (V₀ : Set Zs)
    (Hz : ∀ z : Zs, Ideal (Zs.presheaf.stalk z))
    (h : HironakaG10HirIdealGerms.IsLocallyFinitelyGeneratedOn Zs V₀ Hz) :
    HironakaG10HirIdealGerms.IsLocallyFinitelyGeneratedOn Xs (g.base ⁻¹' V₀)
      (fun Q => Ideal.map (g.stalkMap Q).hom (Hz (g.base Q))) := by
  intro x hx
  obtain ⟨W₀, hxW, r, sec, hs⟩ := h (g.base x) hx
  refine ⟨(Opens.map g.base).obj W₀, hxW, r, fun i => g.c.app (op W₀) (sec i), fun y hy hyV => ?_⟩
  show Ideal.map (g.stalkMap y).hom (Hz (g.base y)) = _
  rw [hs (g.base y) hy hyV, Ideal.map_span, ← Set.range_comp]
  refine congrArg (fun F : Fin r → Xs.presheaf.stalk y => Ideal.span (Set.range F)) (funext fun i => ?_)
  exact PresheafedSpace.stalkMap_germ_apply g.toHom W₀ y hy (sec i)

/-! ### The spread of a torsion bound by a locally finitely generated ideal family -/

section Spread

variable (d t : ℕ) (j : Fin t) (b : Fin (d+t) → ℂ) (U : Opens (ComplexModel (d+t))) (W : Set U)
variable {m : ℕ} {Y : Type} [TopologicalSpace Y] [ChartedSpace (ComplexModel m) Y] [IsComplexManifold m Y]
  (f : realOpenChartDomain d t j b U → Y) (V : Set Y)
  (h0 : (0 : ComplexModel (d+t)) ∈ U) (hW : IsComplexAnalyticSubset (n := d+t) W)
  (hf : ContMDiff 𝓘(ℂ,ComplexModel (d+t)) 𝓘(ℂ,ComplexModel m) ∞ f) (hV : IsComplexAnalyticSubset (n := m) V)
  (hland : realOpenStrictTransform d t j b U W ⊆ f ⁻¹' V)

/-- The pulled-back family read through `targetStalkToJoint ∘ φ^♯` at a chart point. -/
abbrev pulledFam {Xs : LocallyRingedSpace.{0}} (φ : actualSubspaceLocallyRingedSpace (n := m) V ⟶ Xs)
    (Hs : ∀ x : Xs, Ideal (Xs.presheaf.stalk x)) (y : realOpenChartDomain d t j b U) (hyV : f y ∈ V) :
    Ideal (JointQuotient (n := m) d t j b U W f V y) :=
  Ideal.map ((targetStalkToJoint (n := m) d t j b U W f V hf hV y hyV).comp (φ.stalkMap ⟨f y, hyV⟩).hom)
    (Hs (φ.base ⟨f y, hyV⟩))

omit [IsComplexManifold m Y] in
/-- The image of `jfam` in the joint quotient is spanned by the classes of the germs. -/
theorem map_mk_jfam {k : ℕ} (J : Fin k → realOpenChartDomain d t j b U → ℂ) (y : realOpenChartDomain d t j b U)
    (hJ : ∀ i, HolomorphicAt (d+t) (J i) y) :
    Ideal.map (Ideal.Quotient.mk (jointIdeal (n := m) d t j b U W f V y)) (HironakaG10NfTorsionSpread.jfam J y) =
      Ideal.span (Set.range fun i => Ideal.Quotient.mk (jointIdeal (n := m) d t j b U W f V y)
        (actualOriginalFunctionGerm y (J i) (hJ i))) := by
  unfold HironakaG10NfTorsionSpread.jfam
  rw [Ideal.map_span]
  congr 1
  ext g
  constructor
  · rintro ⟨_, ⟨l, hl, rfl⟩, rfl⟩
    exact ⟨l, rfl⟩
  · rintro ⟨l, rfl⟩
    exact ⟨_, ⟨l, hJ l, rfl⟩, rfl⟩

/-- The pulled family at a chart point where the generators are represented by ambient functions. -/
theorem pulledFam_eq {Xs : LocallyRingedSpace.{0}}
    (φ : actualSubspaceLocallyRingedSpace (n := m) V ⟶ Xs) (Hs : ∀ x : Xs, Ideal (Xs.presheaf.stalk x))
    (W' : Opens Xs) (V' : Set Xs) {rk : ℕ} (sec : Fin rk → Xs.presheaf.obj (op W'))
    (hgen : ∀ (x : Xs) (hx : x ∈ W'), x ∈ V' → Hs x = Ideal.span (Set.range fun i => Xs.presheaf.germ W' x hx (sec i)))
    (k : Fin rk → Y → ℂ) (y : realOpenChartDomain d t j b U) (hyV : f y ∈ V)
    (hyW : φ.base ⟨f y, hyV⟩ ∈ W') (hyV' : φ.base ⟨f y, hyV⟩ ∈ V')
    (hk : ∀ i, HolomorphicAt m (k i) (f y))
    (hrep : ∀ i, (actualSubspaceLocallyRingedSpace (n := m) V).presheaf.germ ((Opens.map φ.base).obj W') ⟨f y, hyV⟩ hyW
        (φ.c.app (op W') (sec i)) =
      (actualSubspaceInclusion (n := m) V).stalkMap ⟨f y, hyV⟩ (actualOriginalFunctionGerm (f y) (k i) (hk i))) :
    pulledFam d t j b U W f V hf hV φ Hs y hyV =
      Ideal.span (Set.range fun i => Ideal.Quotient.mk (jointIdeal (n := m) d t j b U W f V y)
        (actualOriginalFunctionGerm y (k i ∘ f)
          ((hk i).comp_contMDiff (Eventually.of_forall fun _ => hf.contMDiffAt)))) := by
  unfold pulledFam
  rw [hgen _ hyW hyV', Ideal.map_span]
  have hg : ∀ i, ((targetStalkToJoint (n := m) d t j b U W f V hf hV y hyV).comp (φ.stalkMap ⟨f y, hyV⟩).hom)
      (Xs.presheaf.germ W' (φ.base ⟨f y, hyV⟩) hyW (sec i)) =
      Ideal.Quotient.mk (jointIdeal (n := m) d t j b U W f V y)
        (actualOriginalFunctionGerm y (k i ∘ f) ((hk i).comp_contMDiff (Eventually.of_forall fun _ => hf.contMDiffAt))) := by
    intro i
    have e1 : (φ.stalkMap ⟨f y, hyV⟩).hom (Xs.presheaf.germ W' (φ.base ⟨f y, hyV⟩) hyW (sec i)) =
        (actualSubspaceLocallyRingedSpace (n := m) V).presheaf.germ ((Opens.map φ.base).obj W') ⟨f y, hyV⟩ hyW
          (φ.c.app (op W') (sec i)) :=
      PresheafedSpace.stalkMap_germ_apply φ.toHom W' ⟨f y, hyV⟩ hyW (sec i)
    rw [RingHom.comp_apply, e1, hrep i, HironakaG10NfJointPivot.targetStalkToJoint_germ]
  congr 1
  ext g
  constructor
  · rintro ⟨_, ⟨i, rfl⟩, rfl⟩
    exact ⟨i, (hg i).symm⟩
  · rintro ⟨i, rfl⟩
    exact ⟨_, ⟨i, rfl⟩, hg i⟩

include hland in
/-- **Spread of a torsion bound by a locally finitely generated ideal family.** -/
theorem eventually_pivotTorsion_le_fam {Xs : LocallyRingedSpace.{0}}
    (φ : actualSubspaceLocallyRingedSpace (n := m) V ⟶ Xs) (Hs : ∀ x : Xs, Ideal (Xs.presheaf.stalk x))
    (W' : Opens Xs) (V' : Set Xs) {rk : ℕ} (sec : Fin rk → Xs.presheaf.obj (op W'))
    (hgen : ∀ (x : Xs) (hx : x ∈ W'), x ∈ V' → Hs x = Ideal.span (Set.range fun i => Xs.presheaf.germ W' x hx (sec i)))
    (o : realOpenChartDomain d t j b U) (ho : o ∈ localDomain d t j b U W h0 hW) (hoV : f o ∈ V)
    (hoW : φ.base ⟨f o, hoV⟩ ∈ W')
    (hcont : ∀ᶠ y in 𝓝 o, ∀ hyV : f y ∈ V, φ.base ⟨f y, hyV⟩ ∈ W' ∧ φ.base ⟨f y, hyV⟩ ∈ V')
    (h : pivotTorsion (n := m) d t j b U W f V o ≤ pulledFam d t j b U W f V hf hV φ Hs o hoV) :
    ∀ᶠ y in 𝓝 o, y ∈ localDomain d t j b U W h0 hW → ∀ hyV : f y ∈ V,
      pivotTorsion (n := m) d t j b U W f V y ≤ pulledFam d t j b U W f V hf hV φ Hs y hyV := by
  have hrepEx := fun i => exists_ambient_rep (n := m) V ((Opens.map φ.base).obj W') (φ.c.app (op W') (sec i))
    ⟨f o, hoV⟩ hoW
  choose k Ui hUi hk hev using hrepEx
  have hUev : ∀ i, ∀ᶠ y in 𝓝 o, f y ∈ Ui i := fun i =>
    hf.continuous.continuousAt ((Ui i).isOpen.mem_nhds (hUi i))
  have hJ : ∀ l, ∀ᶠ y in 𝓝 o, HolomorphicAt (d+t) ((fun i => k i ∘ f) l) y := fun l => by
    filter_upwards [hUev l] with y hy
    exact (hk l (f y) hy).comp_contMDiff (Eventually.of_forall fun _ => hf.contMDiffAt)
  have hev' := fun i => eventually_comp_subtype V f o hf.continuous.continuousAt hoV (hev i)
  have hkey : ∀ᶠ y in 𝓝 o, ∀ hyV : f y ∈ V,
      pulledFam d t j b U W f V hf hV φ Hs y hyV =
        Ideal.map (Ideal.Quotient.mk (jointIdeal (n := m) d t j b U W f V y))
          (HironakaG10NfTorsionSpread.jfam (fun i => k i ∘ f) y) := by
    filter_upwards [Filter.eventually_all.2 hev', Filter.eventually_all.2 hUev, hcont] with y hy hyU hyc hyV
    refine (pulledFam_eq d t j b U W f V hf hV φ Hs W' V' sec hgen k y hyV (hyc hyV).1 (hyc hyV).2
      (fun i => hk i (f y) (hyU i)) (fun i => (hy i hyV).elim fun _ h => h.elim fun _ e => e)).trans ?_
    exact (map_mk_jfam d t j b U W f V (fun i => k i ∘ f) y
      (fun i => (hk i (f y) (hyU i)).comp_contMDiff (Eventually.of_forall fun _ => hf.contMDiffAt))).symm
  have h' := h.trans_eq (hkey.self_of_nhds hoV)
  filter_upwards [HironakaG10NfTorsionSpread.eventually_pivotTorsion_le d t j b U W f V h0 hW hf hV hland
    (fun i => k i ∘ f) o ho hJ h', hkey] with y h1 h2 hyL hyV
  exact (h1 hyL).trans_eq (h2 hyV).symm

include hland in
/-- **Spread of a torsion bound by an ideal family locally finitely generated on a neighbourhood.** -/
theorem eventually_pivotTorsion_le_of_fg {Xs : LocallyRingedSpace.{0}}
    (φ : actualSubspaceLocallyRingedSpace (n := m) V ⟶ Xs) (Hs : ∀ x : Xs, Ideal (Xs.presheaf.stalk x))
    (V'' : Set Xs) (hfg : HironakaG10HirIdealGerms.IsLocallyFinitelyGeneratedOn Xs V'' Hs)
    (o : realOpenChartDomain d t j b U) (ho : o ∈ localDomain d t j b U W h0 hW) (hoV : f o ∈ V)
    (hV'' : V'' ∈ 𝓝 (φ.base ⟨f o, hoV⟩))
    (h : pivotTorsion (n := m) d t j b U W f V o ≤ pulledFam d t j b U W f V hf hV φ Hs o hoV) :
    ∀ᶠ y in 𝓝 o, y ∈ localDomain d t j b U W h0 hW → ∀ hyV : f y ∈ V,
      pivotTorsion (n := m) d t j b U W f V y ≤ pulledFam d t j b U W f V hf hV φ Hs y hyV := by
  obtain ⟨W', hoW, rk, sec, hgen⟩ := hfg _ (mem_of_mem_nhds hV'')
  refine eventually_pivotTorsion_le_fam d t j b U W f V h0 hW hf hV hland φ Hs W' V'' sec hgen o ho hoV hoW ?_ h
  have hn : (W' : Set Xs) ∩ V'' ∈ 𝓝 (φ.base ⟨f o, hoV⟩) := Filter.inter_mem (W'.isOpen.mem_nhds hoW) hV''
  have h2 : ∀ᶠ p in 𝓝 (⟨f o, hoV⟩ : V), φ.base p ∈ (W' : Set Xs) ∩ V'' :=
    φ.base.hom.continuous.continuousAt hn
  exact eventually_comp_subtype V f o hf.continuous.continuousAt hoV h2

end Spread

end

end Hironaka.Analytic.Unibranch.HironakaG10NfSpreadGerm
