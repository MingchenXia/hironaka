import Hironaka.Analytic.Unibranch.HironakaG10GnGradedFree
import Hironaka.Analytic.Unibranch.HironakaG10GnCyclicStart
import Hironaka.Analytic.Unibranch.HironakaG10LfChartQuotient

/-!
# Chart flatness from flat cyclic quotients of the library model (route N, item N4)

Lane G10GN, run 0081 (`work/hironaka-run0081-20261117/G10GN/hGF-route.md`, item G10GN-N4). Notation:
`R = 𝒪_{ℂᵈ,0}`, `B = 𝒪_{ℂ^{d+t},0}` (library coordinates, `tangentPullback`), `B' = 𝒪_{ℂᵈ×ℂᵗ,0}` (chart coordinates,
`basePullback`), `ambientGermEquiv : B ≃+* B'`, `I ⊆ R`, `J' = I B'`.

* **`flat_chartCyclic_of_flat_library`**: if an ideal `L ⊇ I B` of `B` corresponds to `(f) + I B'` in `B'` and
  `B ⧸ L` is flat over `R ⧸ I`, then `(B' ⧸ J') ⧸ (f)` is flat over `R ⧸ I`.
* **`chartFlat_of_flat_cyclic`**: if, for every row `i` of a holomorphic matrix `A`, the `i`-th cyclic ideal of the
  image of `A` in `(B' ⧸ J')ᵃ` is generated by germs `fᵢ` and the corresponding library quotient `B ⧸ Lᵢ` is flat
  over `R ⧸ I`, then `ChartFlat d t A p I` (lane G10LF's ALG-2 `flat_quotient_of_flat_cyclicIdeal` and ALG-3
  `chartFlat_iff_flat_quotientCoker`).

No named input. BP: hironaka-g10gn-hgf.tex.
-/

set_option autoImplicit false

open Set Function

namespace Hironaka.Analytic.Unibranch.HironakaG10GnChartFlat

noncomputable section

open Hironaka Hironaka
open HolGerm OkaGermBridge HironakaRelativeNormalIdeal Hironaka.Analytic.Unibranch.HironakaG10SmoothBaseFlatOpen
  Hironaka.Analytic.Unibranch.HironakaG10LfCyclicFlat Hironaka.Analytic.Unibranch.HironakaG10GnGradedFree

local instance chartAlg (d t : ℕ) :
    Algebra (HolGerm (ComplexModel d)) (HolGerm (ComplexModel d × ComplexModel t)) :=
  (basePullback d t).toAlgebra

local instance chartQuotAlg (d t : ℕ) (I : Ideal (HolGerm (ComplexModel d))) :
    Algebra (HolGerm (ComplexModel d) ⧸ I) (HolGerm (ComplexModel d × ComplexModel t) ⧸
      I.map (algebraMap (HolGerm (ComplexModel d)) (HolGerm (ComplexModel d × ComplexModel t)))) :=
  Ideal.Quotient.algebraQuotientMapQuotient

variable (d t : ℕ)

/-- The chart ideal `I B'`. -/
abbrev chartBaseIdeal (I : Ideal (HolGerm (ComplexModel d))) :
    Ideal (HolGerm (ComplexModel d × ComplexModel t)) :=
  I.map (algebraMap (HolGerm (ComplexModel d)) (HolGerm (ComplexModel d × ComplexModel t)))

local instance chartQuotQuotAlg (I : Ideal (HolGerm (ComplexModel d)))
    (M : Ideal (HolGerm (ComplexModel d × ComplexModel t) ⧸ chartBaseIdeal d t I)) :
    Algebra (HolGerm (ComplexModel d) ⧸ I) ((HolGerm (ComplexModel d × ComplexModel t) ⧸ chartBaseIdeal d t I) ⧸ M) :=
  Ideal.Quotient.algebra _

/-- The ring map `B → (B' ⧸ I B') ⧸ (f)`. -/
def chartTheta (I : Ideal (HolGerm (ComplexModel d))) {c : ℕ}
    (f : Fin c → HolGerm (ComplexModel d × ComplexModel t)) :
    HolGerm (ComplexModel (d+t)) →+* (HolGerm (ComplexModel d × ComplexModel t) ⧸ chartBaseIdeal d t I) ⧸
      (Ideal.span (range f)).map (Ideal.Quotient.mk (chartBaseIdeal d t I)) :=
  (Ideal.Quotient.mk _).comp ((Ideal.Quotient.mk _).comp (ambientGermEquiv d t).toRingHom)

theorem chartTheta_surjective (I : Ideal (HolGerm (ComplexModel d))) {c : ℕ}
    (f : Fin c → HolGerm (ComplexModel d × ComplexModel t)) : Surjective (chartTheta d t I f) := by
  intro y
  obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective y
  obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective z
  refine ⟨(ambientGermEquiv d t).symm w, ?_⟩
  change Ideal.Quotient.mk _ (Ideal.Quotient.mk _ (ambientGermEquiv d t ((ambientGermEquiv d t).symm w))) = _
  rw [RingEquiv.apply_symm_apply]

theorem ker_chartTheta (I : Ideal (HolGerm (ComplexModel d))) (L : Ideal (HolGerm (ComplexModel (d+t))))
    {c : ℕ} (f : Fin c → HolGerm (ComplexModel d × ComplexModel t))
    (hL : L.map (ambientGermEquiv d t) = Ideal.span (range f) ⊔ chartBaseIdeal d t I) :
    RingHom.ker (chartTheta d t I f) = L := by
  ext b
  rw [RingHom.mem_ker]
  change Ideal.Quotient.mk _ (Ideal.Quotient.mk (chartBaseIdeal d t I) (ambientGermEquiv d t b)) = 0 ↔ b ∈ L
  rw [Ideal.Quotient.eq_zero_iff_mem, ← Ideal.mem_comap,
    Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective, ← RingHom.ker_eq_comap_bot,
    Ideal.mk_ker, ← hL]
  constructor
  · intro h
    exact (Ideal.comap_map_of_bijective (ambientGermEquiv d t) (ambientGermEquiv d t).bijective).le h
  · intro h
    exact Ideal.mem_map_of_mem _ h

/-- The ring isomorphism `B ⧸ L ≃ (B' ⧸ I B') ⧸ (f)`. -/
def chartQuotEquiv (I : Ideal (HolGerm (ComplexModel d))) (L : Ideal (HolGerm (ComplexModel (d+t))))
    {c : ℕ} (f : Fin c → HolGerm (ComplexModel d × ComplexModel t))
    (hL : L.map (ambientGermEquiv d t) = Ideal.span (range f) ⊔ chartBaseIdeal d t I) :
    (HolGerm (ComplexModel (d+t)) ⧸ L) ≃+* (HolGerm (ComplexModel d × ComplexModel t) ⧸ chartBaseIdeal d t I) ⧸
      (Ideal.span (range f)).map (Ideal.Quotient.mk (chartBaseIdeal d t I)) :=
  (Ideal.quotEquivOfEq (ker_chartTheta d t I L f hL).symm).trans
    (RingHom.quotientKerEquivOfSurjective (chartTheta_surjective d t I f))

theorem chartQuotEquiv_mk (I : Ideal (HolGerm (ComplexModel d))) (L : Ideal (HolGerm (ComplexModel (d+t))))
    {c : ℕ} (f : Fin c → HolGerm (ComplexModel d × ComplexModel t))
    (hL : L.map (ambientGermEquiv d t) = Ideal.span (range f) ⊔ chartBaseIdeal d t I)
    (b : HolGerm (ComplexModel (d+t))) :
    chartQuotEquiv d t I L f hL (Ideal.Quotient.mk L b) = chartTheta d t I f b := rfl

/-- **Transfer of flatness from the library quotient to the chart quotient.** -/
theorem flat_chartCyclic_of_flat_library (I : Ideal (HolGerm (ComplexModel d)))
    (L : Ideal (HolGerm (ComplexModel (d+t)))) [hKL : Fact (∀ k ∈ I, tangentPullback d t k ∈ L)]
    {c : ℕ} (f : Fin c → HolGerm (ComplexModel d × ComplexModel t))
    (hL : L.map (ambientGermEquiv d t) = Ideal.span (range f) ⊔ chartBaseIdeal d t I)
    (hflat : letI := quotAlgebra d t I L
      Module.Flat (HolGerm (ComplexModel d) ⧸ I) (HolGerm (ComplexModel (d+t)) ⧸ L)) :
    Module.Flat (HolGerm (ComplexModel d) ⧸ I)
      ((HolGerm (ComplexModel d × ComplexModel t) ⧸ chartBaseIdeal d t I) ⧸
        (Ideal.span (range f)).map (Ideal.Quotient.mk (chartBaseIdeal d t I))) := by
  let _ := quotAlgebra d t I L
  let e := chartQuotEquiv d t I L f hL
  have halg : ∀ r : HolGerm (ComplexModel d) ⧸ I,
      e (algebraMap (HolGerm (ComplexModel d) ⧸ I) (HolGerm (ComplexModel (d+t)) ⧸ L) r) =
        algebraMap (HolGerm (ComplexModel d) ⧸ I) ((HolGerm (ComplexModel d × ComplexModel t) ⧸
          chartBaseIdeal d t I) ⧸ (Ideal.span (range f)).map (Ideal.Quotient.mk (chartBaseIdeal d t I))) r := by
    intro r
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective r
    change Ideal.Quotient.mk _ (Ideal.Quotient.mk _ (ambientGermEquiv d t (tangentPullback d t r))) = _
    rw [ambientGermEquiv_tangentPullback]
    rfl
  let eA : (HolGerm (ComplexModel (d+t)) ⧸ L) ≃ₐ[HolGerm (ComplexModel d) ⧸ I]
      ((HolGerm (ComplexModel d × ComplexModel t) ⧸ chartBaseIdeal d t I) ⧸
        (Ideal.span (range f)).map (Ideal.Quotient.mk (chartBaseIdeal d t I))) :=
    AlgEquiv.ofRingEquiv (f := e) halg
  exact Module.Flat.of_linearEquiv eA.toLinearEquiv.symm

/-- **Chart flatness from flat cyclic quotients.** -/
theorem chartFlat_of_flat_cyclic {a b : ℕ} (A : Fin a → Fin b → ComplexModel d × ComplexModel t → ℂ)
    (p : ComplexModel d × ComplexModel t) (I : Ideal (HolGerm (ComplexModel d))) (c : Fin a → ℕ)
    (f : ∀ i, Fin (c i) → HolGerm (ComplexModel d × ComplexModel t))
    (hcyc : ∀ i, cyclicIdeal (LinearMap.range (Matrix.map (fun i j => germAt p (A i j) :
        Matrix (Fin a) (Fin b) (HolGerm (ComplexModel d × ComplexModel t)))
          (Ideal.Quotient.mk (chartBaseIdeal d t I))).mulVecLin) i =
        (Ideal.span (range (f i))).map (Ideal.Quotient.mk (chartBaseIdeal d t I)))
    (hflat : ∀ i, Module.Flat (HolGerm (ComplexModel d) ⧸ I)
      ((HolGerm (ComplexModel d × ComplexModel t) ⧸ chartBaseIdeal d t I) ⧸
        (Ideal.span (range (f i))).map (Ideal.Quotient.mk (chartBaseIdeal d t I)))) :
    HironakaG10MwWindowFamily.ChartFlat d t A p I := by
  rw [HironakaG10LfChartQuotient.chartFlat_iff_flat_quotientCoker]
  apply flat_quotient_of_flat_cyclicIdeal
  intro i
  rw [hcyc i]
  exact hflat i

/-- Flatness over `R ⧸ I` of the cyclic chart quotient `(B' ⧸ I B') ⧸ (f)` (a named predicate, so that consumers
need not synthesize the quotient module structures). -/
def CyclicFlat (I : Ideal (HolGerm (ComplexModel d))) {c : ℕ}
    (f : Fin c → HolGerm (ComplexModel d × ComplexModel t)) : Prop :=
  Module.Flat (HolGerm (ComplexModel d) ⧸ I)
    ((HolGerm (ComplexModel d × ComplexModel t) ⧸ chartBaseIdeal d t I) ⧸
      (Ideal.span (range f)).map (Ideal.Quotient.mk (chartBaseIdeal d t I)))

theorem cyclicFlat_of_flat_library (I : Ideal (HolGerm (ComplexModel d)))
    (L : Ideal (HolGerm (ComplexModel (d+t)))) [Fact (∀ k ∈ I, tangentPullback d t k ∈ L)]
    {c : ℕ} (f : Fin c → HolGerm (ComplexModel d × ComplexModel t))
    (hL : L.map (ambientGermEquiv d t) = Ideal.span (range f) ⊔ chartBaseIdeal d t I)
    (hflat : letI := quotAlgebra d t I L
      Module.Flat (HolGerm (ComplexModel d) ⧸ I) (HolGerm (ComplexModel (d+t)) ⧸ L)) :
    CyclicFlat d t I f :=
  flat_chartCyclic_of_flat_library d t I L f hL hflat

/-- The cyclic ideals of the chart cokernel modulo `I`, as a named predicate. -/
def CyclicGen {a b : ℕ} (A : Fin a → Fin b → ComplexModel d × ComplexModel t → ℂ)
    (p : ComplexModel d × ComplexModel t) (I : Ideal (HolGerm (ComplexModel d))) (i : Fin a) {c : ℕ}
    (f : Fin c → HolGerm (ComplexModel d × ComplexModel t)) : Prop :=
  cyclicIdeal (LinearMap.range (Matrix.map (fun i j => germAt p (A i j) :
      Matrix (Fin a) (Fin b) (HolGerm (ComplexModel d × ComplexModel t)))
        (Ideal.Quotient.mk (chartBaseIdeal d t I))).mulVecLin) i =
      (Ideal.span (range f)).map (Ideal.Quotient.mk (chartBaseIdeal d t I))

theorem chartFlat_of_cyclicFlat {a b : ℕ} (A : Fin a → Fin b → ComplexModel d × ComplexModel t → ℂ)
    (p : ComplexModel d × ComplexModel t) (I : Ideal (HolGerm (ComplexModel d))) (c : Fin a → ℕ)
    (f : ∀ i, Fin (c i) → HolGerm (ComplexModel d × ComplexModel t))
    (hcyc : ∀ i, CyclicGen d t A p I i (f i)) (hflat : ∀ i, CyclicFlat d t I (f i)) :
    HironakaG10MwWindowFamily.ChartFlat d t A p I :=
  chartFlat_of_flat_cyclic d t A p I c f hcyc hflat

/-- `CyclicGen` from an exact start modulo `I` of the rows below `i` (lane G10GN's `cyclicIdeal_range_eq`). -/
theorem cyclicGen_of_start {a b c : ℕ} (A : Fin a → Fin b → ComplexModel d × ComplexModel t → ℂ)
    (p : ComplexModel d × ComplexModel t) (I : Ideal (HolGerm (ComplexModel d))) (i : Fin a)
    (Gi : Matrix (Fin b) (Fin c) (HolGerm (ComplexModel d × ComplexModel t)))
    (hcomp : ∀ l, i < l → ∀ k, ∑ j, germAt p (A l j) * Gi j k ∈ chartBaseIdeal d t I)
    (hexact : ∀ v : Fin b → HolGerm (ComplexModel d × ComplexModel t),
      (∀ l, i < l → ∑ j, germAt p (A l j) * v j ∈ chartBaseIdeal d t I) →
      ∃ w : Fin c → HolGerm (ComplexModel d × ComplexModel t), ∀ j, v j - ∑ k, Gi j k * w k ∈ chartBaseIdeal d t I) :
    CyclicGen d t A p I i (fun k => ∑ j, germAt p (A i j) * Gi j k) :=
  Hironaka.Analytic.Unibranch.HironakaG10GnCyclicStart.cyclicIdeal_range_eq (chartBaseIdeal d t I)
    (fun i j => germAt p (A i j)) i Gi hcomp hexact

end

end Hironaka.Analytic.Unibranch.HironakaG10GnChartFlat
