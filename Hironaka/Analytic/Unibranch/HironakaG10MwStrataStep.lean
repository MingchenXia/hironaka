noncomputable section

/-! ### Vanishing ideals under open immersions and local isomorphisms -/

/-- **Vanishing ideals pull back along open immersions** (both directions). -/
theorem map_vanishingIdealAt_openImmersion {V Y : LocallyRingedSpace.{0}} (j : V ⟶ Y)
    [LocallyRingedSpace.IsOpenImmersion j] (C : Set Y) (v : V) :
    Ideal.map (j.stalkMap v).hom (vanishingIdealAt Y C (j.base v)) =
      vanishingIdealAt V (j.base ⁻¹' C) v := by
  rw [vanishingIdealAt_eq_intrinsicCentreStalkRange, vanishingIdealAt_eq_intrinsicCentreStalkRange]
  exact openImmersion_pulled_stalkIdeal_eq j C v

/-- Ideal maps along bijective ring maps reflect containment. -/
theorem map_le_map_iff_of_bijective {A B : Type*} [CommRing A] [CommRing B] (φ : A →+* B)
    (hφ : Function.Bijective φ) (I J : Ideal A) : I.map φ ≤ J.map φ ↔ I ≤ J := by
  rw [Ideal.map_le_iff_le_comap, Ideal.comap_map_of_bijective φ hφ]

theorem map_injective_of_bijective {A B : Type*} [CommRing A] [CommRing B] (φ : A →+* B)
    (hφ : Function.Bijective φ) {I J : Ideal A} (h : I.map φ = J.map φ) : I = J := by
  rw [← Ideal.comap_map_of_bijective φ hφ (I := I), h, Ideal.comap_map_of_bijective φ hφ]

variable (s : Stage) (c : AdmissibleCentre s.f)

/-- The point map of the step. -/
abbrev σb : (nextWith s c).X.obj.left → s.X.obj.left := (stepσ s c).hom.left.base

theorem isIsoOver_stepσ :
    SourceReducedComplexSpace.IsIsoOver (stepσ s c) (nonunitLocus c.B c.b)ᶜ := by
  let _ := c.finiteType
  exact stepProj_isIsoOver c.B c.b c.dense

theorem stalkMap_bijective (x' : (nextWith s c).X.obj.left)
    (hx : σb s c x' ∉ nonunitLocus c.B c.b) :
    Function.Bijective ((stepσ s c).hom.left.stalkMap x').hom := by
  have h : IsIso ((stepσ s c).hom.left.stalkMap x') :=
    isIso_stalkMap_of_isIsoOver (isIsoOver_stepσ s c) x' hx
  exact (ConcreteCategory.isIso_iff_bijective _).mp h

/-- The exceptional complement `σ⁻¹ (Dᶜ)` is open. -/
theorem isOpen_preimage_compl :
    IsOpen (σb s c ⁻¹' (nonunitLocus c.B c.b)ᶜ) := by
  obtain ⟨V, j, hj, hr, -, -⟩ := isIsoOver_stepσ s c
  rw [← hr]
  exact hj.base_open.isOpen_range

/-- **Over the unit locus the vanishing ideal of a preimage is the image of the vanishing ideal.** -/
theorem vanishingIdealAt_preimage_eq_map (A : Set s.X.obj.left) (x' : (nextWith s c).X.obj.left)
    (hx : σb s c x' ∉ nonunitLocus c.B c.b) :
    vanishingIdealAt (nextWith s c).X.obj.left (σb s c ⁻¹' A) x' =
      Ideal.map ((stepσ s c).hom.left.stalkMap x').hom
        (vanishingIdealAt s.X.obj.left A (σb s c x')) := by
  obtain ⟨V, j, hj, hr, hk, -⟩ := isIsoOver_stepσ s c
  let _ : LocallyRingedSpace.IsOpenImmersion j := hj
  let _ : LocallyRingedSpace.IsOpenImmersion (j ≫ (stepσ s c).hom.left) := hk
  have hx' : x' ∈ range j.base := by
    rw [hr]
    exact hx
  obtain ⟨v, rfl⟩ := hx'
  have hjbij : Function.Bijective (j.stalkMap v).hom :=
    (ConcreteCategory.isIso_iff_bijective (j.stalkMap v)).mp inferInstance
  apply map_injective_of_bijective (j.stalkMap v).hom hjbij
  rw [map_vanishingIdealAt_openImmersion j (σb s c ⁻¹' A) v, Ideal.map_map]
  have hk' := map_vanishingIdealAt_openImmersion (j ≫ (stepσ s c).hom.left) A v
  rw [LocallyRingedSpace.stalkMap_comp] at hk'
  exact hk'.symm

/-- **Over the unit locus, relative flatness over a preimage is relative flatness downstairs**, for
every set `A`. -/
theorem flatOverAt_next_preimage_iff (A : Set s.X.obj.left) (x' : (nextWith s c).X.obj.left)
    (hx : σb s c x' ∉ nonunitLocus c.B c.b) :
    FlatOverAt (nextWith s c).f x' (vanishingIdealAt _ (σb s c ⁻¹' A) x') ↔
      FlatOverAt s.f (σb s c x') (vanishingIdealAt _ A (σb s c x')) := by
  have h1 : FlatOverAt (nextWith s c).f x' (vanishingIdealAt _ (σb s c ⁻¹' A) x') ↔
      germFlattener (nextWith s c).f x' ≤ vanishingIdealAt _ (σb s c ⁻¹' A) x' :=
    isGermFlattenerAt_germFlattener (nextWith s c).f x' _
  have h2 : FlatOverAt s.f (σb s c x') (vanishingIdealAt _ A (σb s c x')) ↔
      germFlattener s.f (σb s c x') ≤ vanishingIdealAt _ A (σb s c x') :=
    isGermFlattenerAt_germFlattener s.f (σb s c x') _
  rw [h1, h2, germFlattener_next_eq s c x' hx, vanishingIdealAt_preimage_eq_map s c A x' hx]
  exact map_le_map_iff_of_bijective _ (stalkMap_bijective s c x' hx) _ _

/-! ### The strata -/

/-- **L5 (a): off the exceptional set the relative strata of the strict transform are the preimages of
the old strata.** -/
theorem mem_strata_next_iff {B : Set s.X.obj.left} (hB : IsClosed B) :
    ∀ (j : ℕ) (x' : (nextWith s c).X.obj.left), σb s c x' ∉ nonunitLocus c.B c.b →
      (x' ∈ strata (nextWith s c).f (strictSet s c B) j ↔ σb s c x' ∈ strata s.f B j)
  | 0, x', hx => by
    constructor
    · intro h
      exact strictSet_subset_preimage s c hB h
    · intro h
      exact subset_closure ⟨h, hx⟩
  | j + 1, x', hx => by
    have IH := mem_strata_next_iff hB j
    have hev : ∀ᶠ y in 𝓝 x', y ∈ strata (nextWith s c).f (strictSet s c B) j ↔
        y ∈ σb s c ⁻¹' strata s.f B j := by
      filter_upwards [(isOpen_preimage_compl s c).mem_nhds hx] with y hy
      exact IH y hy
    have hvan := vanishingIdealAt_eq_of_eventually _ _ x' hev
    change x' ∈ relNonflat _ _ ↔ σb s c x' ∈ relNonflat _ _
    unfold relNonflat
    simp only [Set.mem_ofPred_eq]
    rw [hvan, flatOverAt_next_preimage_iff s c _ x' hx, IH x' hx]

/-- Off the exceptional set the two strata correspond exactly. -/
theorem strata_next_diff_eq {B : Set s.X.obj.left} (hB : IsClosed B) (j : ℕ) :
    strata (nextWith s c).f (strictSet s c B) j \ σb s c ⁻¹' nonunitLocus c.B c.b =
      σb s c ⁻¹' (strata s.f B j \ nonunitLocus c.B c.b) := by
  ext x'
  constructor
  · rintro ⟨h, hx⟩
    exact ⟨(mem_strata_next_iff s c hB j x' hx).mp h, hx⟩
  · rintro ⟨h, hx⟩
    exact ⟨(mem_strata_next_iff s c hB j x' hx).mpr h, hx⟩

/-- **L5 (b), corrected form**: if the centre lies in the `j`-th stratum, the new `j`-th stratum lies over
the old one.  (`j = 1`: permissibility (2).) -/
theorem strata_next_subset_preimage {B : Set s.X.obj.left} (hB : IsClosed B) (j : ℕ)
    (hD : nonunitLocus c.B c.b ⊆ strata s.f B j) :
    strata (nextWith s c).f (strictSet s c B) j ⊆ σb s c ⁻¹' strata s.f B j := by
  intro x' hx'
  by_cases hx : σb s c x' ∈ nonunitLocus c.B c.b
  · exact hD hx
  · exact (mem_strata_next_iff s c hB j x' hx).mp hx'

/-- The zeroth stratum needs no hypothesis. -/
theorem strata_next_zero_subset_preimage {B : Set s.X.obj.left} (hB : IsClosed B) :
    strata (nextWith s c).f (strictSet s c B) 0 ⊆ σb s c ⁻¹' strata s.f B 0 :=
  strictSet_subset_preimage s c hB

/-- The strict transform of a stratum lies in the corresponding new stratum when the latter is closed. -/
theorem strictSet_strata_subset {B : Set s.X.obj.left} (hB : IsClosed B) (j : ℕ)
    (hclosed : IsClosed (strata (nextWith s c).f (strictSet s c B) j)) :
    strictSet s c (strata s.f B j) ⊆ strata (nextWith s c).f (strictSet s c B) j := by
  apply closure_minimal _ hclosed
  rintro x' ⟨h, hx⟩
  exact (mem_strata_next_iff s c hB j x' hx).mpr h

/-! ### Strict transforms of irreducible analytic sets and stratum components (L5 (c)) -/

/-- **Native proper image for one step** (an instance of Remmert's proper mapping theorem: `σ` is the
projection of a blow-up, hence proper): the image under `σ` of an analytic subset is analytic. -/
def StepProperImage : Prop :=
  ∀ P : Set (nextWith s c).X.obj.left, (nextWith s c).X.IsAnalyticSubset P →
    s.X.IsAnalyticSubset (σb s c '' P)

theorem continuous_σb : Continuous (σb s c) := (stepσ s c).hom.left.base.hom.continuous

theorem σb_injOn : InjOn (σb s c) (σb s c ⁻¹' (nonunitLocus c.B c.b)ᶜ) :=
  injOn_of_isIsoOver (isIsoOver_stepσ s c)

theorem compl_subset_range : (nonunitLocus c.B c.b)ᶜ ⊆ range (σb s c) :=
  subset_range_of_isIsoOver (isIsoOver_stepσ s c)

theorem preimage_image_diff (P : Set (nextWith s c).X.obj.left) :
    σb s c ⁻¹' (σb s c '' P \ nonunitLocus c.B c.b) = P \ σb s c ⁻¹' nonunitLocus c.B c.b := by
  ext y
  constructor
  · rintro ⟨⟨x, hxP, hxy⟩, hyD⟩
    have hxD : σb s c x ∉ nonunitLocus c.B c.b := by
      rw [hxy]
      exact hyD
    have hxy' : x = y := σb_injOn s c hxD hyD hxy
    subst hxy'
    exact ⟨hxP, hyD⟩
  · rintro ⟨hyP, hyD⟩
    exact ⟨⟨y, hyP, rfl⟩, hyD⟩

theorem image_preimage_diff (A : Set s.X.obj.left) :
    σb s c '' (σb s c ⁻¹' (A \ nonunitLocus c.B c.b)) = A \ nonunitLocus c.B c.b :=
  image_preimage_eq_of_subset (fun _ hx => compl_subset_range s c hx.2)

theorem strictSet_eq (A : Set s.X.obj.left) :
    strictSet s c A = closure (σb s c ⁻¹' (A \ nonunitLocus c.B c.b)) := rfl

theorem image_strictSet_subset {A : Set s.X.obj.left} (hA : IsClosed A) :
    σb s c '' strictSet s c A ⊆ A := by
  rw [strictSet_eq]
  refine (image_closure_subset_closure_image (continuous_σb s c)).trans ?_
  rw [image_preimage_diff]
  exact closure_minimal sdiff_subset hA

theorem isAnalyticSubset_exc (hDa : s.X.IsAnalyticSubset (nonunitLocus c.B c.b)) :
    (nextWith s c).X.IsAnalyticSubset (σb s c ⁻¹' nonunitLocus c.B c.b) :=
  hDa.preimage (stepσ s c)

theorem isAnalyticSubset_strictSet (hDa : s.X.IsAnalyticSubset (nonunitLocus c.B c.b))
    {A : Set s.X.obj.left} (hA : s.X.IsAnalyticSubset A) :
    (nextWith s c).X.IsAnalyticSubset (strictSet s c A) := by
  rw [strictSet_eq, preimage_sdiff]
  exact isAnalyticSubset_closure_diff (hA.preimage (stepσ s c)) (isAnalyticSubset_exc s c hDa)

/-- An irreducible analytic set not inside the exceptional set is the strict transform of its image. -/
theorem strictSet_image_eq (hDa : s.X.IsAnalyticSubset (nonunitLocus c.B c.b))
    {P : Set (nextWith s c).X.obj.left} (hP : (nextWith s c).X.IsIrreducibleAnalyticSubset P)
    (hPE : ¬ P ⊆ σb s c ⁻¹' nonunitLocus c.B c.b) :
    strictSet s c (σb s c '' P) = P := by
  rw [strictSet_eq, preimage_image_diff]
  exact Subset.antisymm (closure_minimal sdiff_subset hP.1.isClosed)
    (HironakaG10IrreducibleBoundary.subset_closure_diff_of_irreducible hP
      (isAnalyticSubset_exc s c hDa) hPE)

/-- An irreducible analytic set not inside the centre is the image of its strict transform. -/
theorem image_strictSet_eq (hDa : s.X.IsAnalyticSubset (nonunitLocus c.B c.b))
    (hPM : StepProperImage s c) {C : Set s.X.obj.left} (hC : s.X.IsIrreducibleAnalyticSubset C)
    (hCD : ¬ C ⊆ nonunitLocus c.B c.b) :
    σb s c '' strictSet s c C = C := by
  refine Subset.antisymm (image_strictSet_subset s c hC.1.isClosed) ?_
  have hcl : IsClosed (σb s c '' strictSet s c C) :=
    (hPM _ (isAnalyticSubset_strictSet s c hDa hC.1)).isClosed
  refine (HironakaG10IrreducibleBoundary.subset_closure_diff_of_irreducible hC hDa hCD).trans
    (closure_minimal ?_ hcl)
  rw [← image_preimage_diff s c C]
  exact image_mono subset_closure

/-- Images of irreducible analytic sets are irreducible (given that they are analytic). -/
theorem isIrreducible_image (hPM : StepProperImage s c) {P : Set (nextWith s c).X.obj.left}
    (hP : (nextWith s c).X.IsIrreducibleAnalyticSubset P) :
    s.X.IsIrreducibleAnalyticSubset (σb s c '' P) := by
  refine ⟨hPM P hP.1, hP.2.1.image _, ?_⟩
  intro A A' hA hA' hAP hA'P hAA'
  have hsplit : P = (P ∩ σb s c ⁻¹' A) ∪ (P ∩ σb s c ⁻¹' A') := by
    rw [← inter_union_distrib_left, ← preimage_union, ← hAA']
    exact (inter_eq_left.mpr (subset_preimage_image _ _)).symm
  rcases hP.2.2 _ _ (HironakaG10IrreducibleBoundary.isAnalyticSubset_inter hP.1 (hA.preimage (stepσ s c)))
      (HironakaG10IrreducibleBoundary.isAnalyticSubset_inter hP.1 (hA'.preimage (stepσ s c)))
      inter_subset_left inter_subset_left hsplit with h | h
  · exact Or.inl (Subset.antisymm (image_subset_iff.mpr fun x hx => (h.subset hx).2) hAP)
  · exact Or.inr (Subset.antisymm (image_subset_iff.mpr fun x hx => (h.subset hx).2) hA'P)

theorem nonempty_preimage_diff {C : Set s.X.obj.left} (hCD : ¬ C ⊆ nonunitLocus c.B c.b) :
    ∃ x', σb s c x' ∈ C ∧ σb s c x' ∉ nonunitLocus c.B c.b := by
  obtain ⟨x, hxC, hxD⟩ := not_subset.mp hCD
  obtain ⟨x', hx'⟩ := compl_subset_range s c hxD
  exact ⟨x', by rw [hx']; exact hxC, by rw [hx']; exact hxD⟩

/-- **The strict transform of an irreducible analytic set not inside the centre is irreducible.** -/
theorem isIrreducible_strictSet (hDa : s.X.IsAnalyticSubset (nonunitLocus c.B c.b))
    (hPM : StepProperImage s c) {C : Set s.X.obj.left} (hC : s.X.IsIrreducibleAnalyticSubset C)
    (hCD : ¬ C ⊆ nonunitLocus c.B c.b) :
    (nextWith s c).X.IsIrreducibleAnalyticSubset (strictSet s c C) := by
  obtain ⟨x', hx'C, hx'D⟩ := nonempty_preimage_diff s c hCD
  refine ⟨isAnalyticSubset_strictSet s c hDa hC.1, ⟨x', subset_closure ⟨hx'C, hx'D⟩⟩, ?_⟩
  intro P Q hP hQ hPS hQS hPQ
  have himS : σb s c '' strictSet s c C ⊆ C := image_strictSet_subset s c hC.1.isClosed
  have hcover : C ⊆ σb s c '' P ∪ σb s c '' Q := by
    refine (HironakaG10IrreducibleBoundary.subset_closure_diff_of_irreducible hC hDa hCD).trans
      (closure_minimal ?_ ((hPM P hP).isClosed.union (hPM Q hQ).isClosed))
    rw [← image_preimage_diff s c C, ← image_union, ← hPQ]
    exact image_mono subset_closure
  have hCeq : C = σb s c '' P ∪ σb s c '' Q :=
    Subset.antisymm hcover
      (union_subset ((image_mono hPS).trans himS) ((image_mono hQS).trans himS))
  have key : ∀ R : Set (nextWith s c).X.obj.left, (nextWith s c).X.IsAnalyticSubset R →
      R ⊆ strictSet s c C → C = σb s c '' R → strictSet s c C = R := by
    intro R hR hRS hCR
    refine Subset.antisymm ?_ hRS
    rw [strictSet_eq]
    refine closure_minimal ?_ hR.isClosed
    rw [hCR, preimage_image_diff]
    exact sdiff_subset
  rcases hC.2.2 _ _ (hPM P hP) (hPM Q hQ) ((image_mono hPS).trans himS)
      ((image_mono hQS).trans himS) hCeq with h | h
  · exact Or.inl (key P hP hPS h)
  · exact Or.inr (key Q hQ hQS h)

/-- An irreducible analytic subset of a new stratum not inside the exceptional set lies in the strict
transform of the old stratum. -/
theorem subset_strictSet_strata {B : Set s.X.obj.left} (hB : IsClosed B)
    (hDa : s.X.IsAnalyticSubset (nonunitLocus c.B c.b)) (j : ℕ)
    {K : Set (nextWith s c).X.obj.left} (hK : (nextWith s c).X.IsIrreducibleAnalyticSubset K)
    (hKE : ¬ K ⊆ σb s c ⁻¹' nonunitLocus c.B c.b)
    (hKS : K ⊆ strata (nextWith s c).f (strictSet s c B) j) :
    K ⊆ strictSet s c (strata s.f B j) := by
  rw [strictSet_eq]
  refine (HironakaG10IrreducibleBoundary.subset_closure_diff_of_irreducible hK
      (isAnalyticSubset_exc s c hDa) hKE).trans
    (closure_mono ?_)
  rintro x' ⟨hx', hxE⟩
  exact ⟨(mem_strata_next_iff s c hB j x' hxE).mp (hKS hx'), hxE⟩

/-- **L5 (c), forward**: a component of a new stratum not inside the exceptional set is the strict
transform of a component of the old stratum not inside the centre (namely of its image). -/
theorem isStratumComponent_image {B : Set s.X.obj.left} (hB : IsClosed B)
    (hDa : s.X.IsAnalyticSubset (nonunitLocus c.B c.b)) (hPM : StepProperImage s c) (j : ℕ)
    (hS : IsClosed (strata s.f B j))
    (hS' : IsClosed (strata (nextWith s c).f (strictSet s c B) j))
    {C' : Set (nextWith s c).X.obj.left}
    (hC' : IsStratumComponent (nextWith s c).f (strictSet s c B) j C')
    (hCE : ¬ C' ⊆ σb s c ⁻¹' nonunitLocus c.B c.b) :
    IsStratumComponent s.f B j (σb s c '' C') ∧ ¬ σb s c '' C' ⊆ nonunitLocus c.B c.b ∧
      C' = strictSet s c (σb s c '' C') := by
  have hCD : ¬ σb s c '' C' ⊆ nonunitLocus c.B c.b := fun h => hCE (image_subset_iff.mp h)
  have hsub : σb s c '' C' ⊆ strata s.f B j :=
    (image_mono (subset_strictSet_strata s c hB hDa j hC'.1 hCE hC'.2.1)).trans
      (image_strictSet_subset s c hS)
  have hC'eq : strictSet s c (σb s c '' C') = C' := strictSet_image_eq s c hDa hC'.1 hCE
  refine ⟨⟨isIrreducible_image s c hPM hC'.1, hsub, ?_⟩, hCD, hC'eq.symm⟩
  intro K hK hCK hKS
  have hKD : ¬ K ⊆ nonunitLocus c.B c.b := fun h => hCD (hCK.trans h)
  have h1 : strictSet s c K = C' := by
    refine hC'.2.2 _ (isIrreducible_strictSet s c hDa hPM hK hKD) ?_ ?_
    · exact hC'eq.symm.subset.trans (strictSet_mono s c hCK)
    · exact (strictSet_mono s c hKS).trans (strictSet_strata_subset s c hB j hS')
  calc K = σb s c '' strictSet s c K := (image_strictSet_eq s c hDa hPM hK hKD).symm
    _ = σb s c '' C' := by rw [h1]

/-- **L5 (c), converse**: the strict transform of a component of the old stratum not inside the centre is
a component of the new stratum not inside the exceptional set (and its image is the component). -/
theorem isStratumComponent_strictSet {B : Set s.X.obj.left} (hB : IsClosed B)
    (hDa : s.X.IsAnalyticSubset (nonunitLocus c.B c.b)) (hPM : StepProperImage s c) (j : ℕ)
    (hS : IsClosed (strata s.f B j))
    (hS' : IsClosed (strata (nextWith s c).f (strictSet s c B) j))
    {C : Set s.X.obj.left} (hC : IsStratumComponent s.f B j C)
    (hCD : ¬ C ⊆ nonunitLocus c.B c.b) :
    IsStratumComponent (nextWith s c).f (strictSet s c B) j (strictSet s c C) ∧
      ¬ strictSet s c C ⊆ σb s c ⁻¹' nonunitLocus c.B c.b ∧ C = σb s c '' strictSet s c C := by
  have hSE : ¬ strictSet s c C ⊆ σb s c ⁻¹' nonunitLocus c.B c.b := by
    intro h
    obtain ⟨x', hx'C, hx'D⟩ := nonempty_preimage_diff s c hCD
    exact hx'D (h (subset_closure ⟨hx'C, hx'D⟩))
  have hCeq : σb s c '' strictSet s c C = C := image_strictSet_eq s c hDa hPM hC.1 hCD
  refine ⟨⟨isIrreducible_strictSet s c hDa hPM hC.1 hCD,
    (strictSet_mono s c hC.2.1).trans (strictSet_strata_subset s c hB j hS'), ?_⟩, hSE, hCeq.symm⟩
  intro K hK hCK hKS
  have hKE : ¬ K ⊆ σb s c ⁻¹' nonunitLocus c.B c.b := fun h => hSE (hCK.trans h)
  have himg : σb s c '' K = C := by
    refine hC.2.2 _ (isIrreducible_image s c hPM hK) ?_ ?_
    · exact hCeq.symm.subset.trans (image_mono hCK)
    · exact (image_mono (subset_strictSet_strata s c hB hDa j hK hKE hKS)).trans
        (image_strictSet_subset s c hS)
  calc K = strictSet s c (σb s c '' K) := (strictSet_image_eq s c hDa hK hKE).symm
    _ = strictSet s c C := by rw [himg]

/-- **L5 (c)** in the requested `∃` form. -/
theorem exists_isStratumComponent_of_next {B : Set s.X.obj.left} (hB : IsClosed B)
    (hDa : s.X.IsAnalyticSubset (nonunitLocus c.B c.b)) (hPM : StepProperImage s c) (j : ℕ)
    (hS : IsClosed (strata s.f B j))
    (hS' : IsClosed (strata (nextWith s c).f (strictSet s c B) j))
    {C' : Set (nextWith s c).X.obj.left}
    (hC' : IsStratumComponent (nextWith s c).f (strictSet s c B) j C')
    (hCE : ¬ C' ⊆ σb s c ⁻¹' nonunitLocus c.B c.b) :
    ∃ C, IsStratumComponent s.f B j C ∧ ¬ C ⊆ nonunitLocus c.B c.b ∧ C' = strictSet s c C :=
  ⟨_, isStratumComponent_image s c hB hDa hPM j hS hS' hC' hCE⟩

/-! ### Closedness of the strata from properness -/

theorem isClosed_strata_of_proper {X Y : SourceReducedComplexSpace} (f : Y ⟶ X)
    (hf : IsProperMap f.hom.left.base) {B : Set X.obj.left} (hB : IsClosed B) :
    ∀ j : ℕ, IsClosed (strata f B j)
  | 0 => hB
  | j + 1 => HironakaG10MwPersistentConsequences.isClosed_relNonflat_of_proper f hf
      (isClosed_strata_of_proper f hf hB j)

theorem isProperMap_next (hf : IsProperMap s.f.hom.left.base) :
    IsProperMap (nextWith s c).f.hom.left.base := by
  let _ := c.finiteType
  exact strictP_isProperMap c.B c.b c.dense s.f hf

/-- **L5 (c)** for a proper family (closedness of both strata discharged). -/
theorem exists_isStratumComponent_of_next_of_proper (hf : IsProperMap s.f.hom.left.base)
    {B : Set s.X.obj.left} (hB : IsClosed B)
    (hDa : s.X.IsAnalyticSubset (nonunitLocus c.B c.b)) (hPM : StepProperImage s c) (j : ℕ)
    {C' : Set (nextWith s c).X.obj.left}
    (hC' : IsStratumComponent (nextWith s c).f (strictSet s c B) j C')
    (hCE : ¬ C' ⊆ σb s c ⁻¹' nonunitLocus c.B c.b) :
    ∃ C, IsStratumComponent s.f B j C ∧ ¬ C ⊆ nonunitLocus c.B c.b ∧ C' = strictSet s c C :=
  exists_isStratumComponent_of_next s c hB hDa hPM j (isClosed_strata_of_proper s.f hf hB j)
    (isClosed_strata_of_proper _ (isProperMap_next s c hf) isClosed_closure j) hC' hCE

/-- **L5 (c), converse** for a proper family. -/
theorem isStratumComponent_strictSet_of_proper (hf : IsProperMap s.f.hom.left.base)
    {B : Set s.X.obj.left} (hB : IsClosed B)
    (hDa : s.X.IsAnalyticSubset (nonunitLocus c.B c.b)) (hPM : StepProperImage s c) (j : ℕ)
    {C : Set s.X.obj.left} (hC : IsStratumComponent s.f B j C)
    (hCD : ¬ C ⊆ nonunitLocus c.B c.b) :
    IsStratumComponent (nextWith s c).f (strictSet s c B) j (strictSet s c C) ∧
      ¬ strictSet s c C ⊆ σb s c ⁻¹' nonunitLocus c.B c.b :=
  (isStratumComponent_strictSet s c hB hDa hPM j (isClosed_strata_of_proper s.f hf hB j)
    (isClosed_strata_of_proper _ (isProperMap_next s c hf) isClosed_closure j) hC hCD).imp_right
      And.left

end

end Hironaka.Analytic.Unibranch.HironakaG10MwStrataStep
