import Hironaka.Analytic.Unibranch.SmoothCentreModification
import Hironaka.Analytic.Unibranch.ContainedCentreModificationSequence
import Hironaka.Blowup.BlowupSequenceTotalTransform

/-!
# Modifications of compact complex spaces and their domination (`def:modif`)

Source: Appendix B (`appendix_unibranch.tex`), `def:modif`:

> A *modification* of a compact complex space `X` is a finite composition of blow-ups with smooth
> centers.  We say a modification `π' : Z → X` *dominates* another `π : Y → X` if there is a
> morphism `g : Z → Y` of complex spaces with `π ∘ g = π'`.

The complex spaces of the book are `Hironaka.Analytic.Unibranch.SourceReducedComplexSpace` (reduced, Hausdorff,
paracompact locally ringed spaces over the complex point, locally isomorphic to analytic models),
and morphisms of complex spaces are the morphisms of that category.  The finite compositions of
blow-ups with smooth centres are `Hironaka.Analytic.Unibranch.SmoothCentreModification.IsModification`
(generated by identities and precomposition by `IsSmoothCentreStep`, a blow-up of the
intrinsic reduced ideal of a smooth closed nowhere dense complex subspace, characterised by its
universal property among ALL complex spaces).  This file adds:

* `Dominates π' π` : the domination relation of the source, with reflexivity and transitivity;
* `Modification X` : the bundled modifications of `X`, preordered by domination;
* `isIdealBlowup_exists_unique_iso`, `isSmoothCentreBlowup_exists_unique_iso` : blow-ups are
  determined up to a unique isomorphism over `X` by their centre (well-definedness of "the
  blow-up with smooth centre" used in the definition);
* `isModification_of_isBlowupSequence` : for a complex manifold `X` (viewed as the complex space
  `(X, 𝒪_X)`), every finite composition of blow-ups of manifolds along smooth nowhere dense
  centres (`IsBlowupSequence`, the notion used for manifolds by
  `Hironaka.BDivisor.Modification.IsBlowupModel`) is a modification in the sense of this file.

The sentence after the definition ("the modifications of `X` form a directed set") is not part
of the environment; for singular `X` it needs Hironaka-type common modifications and is not
claimed here.

Blueprint: `claude-r-iso-a.tex`.
-/

set_option autoImplicit false

open Set TopologicalSpace CategoryTheory AlgebraicGeometry
open scoped Topology Manifold ContDiff

namespace Hironaka.Analytic.Unibranch.RIsoAModification

open Hironaka Hironaka.BlowupSequences
  Hironaka Hironaka.BlowupTowers
  Hironaka.HironakaActualAnalyticSubspace
  HironakaSingularModuleSheafStalk HironakaIntrinsicReducedCentreIdealSheaf
  HironakaNativePulledIdealSheaf HironakaSingularSubspaceBlowupCartierUniversalIdealSheaf
  SourceReducedComplexSpace SmoothCentreModification

noncomputable section

/-! ### Domination -/

/-- **Source `def:modif` (domination).** `π' : Z ⟶ X` dominates `π : Y ⟶ X` if there is a
morphism of complex spaces `g : Z ⟶ Y` making the triangle commute: `g ≫ π = π'`. -/
def Dominates {X Y Z : SourceReducedComplexSpace} (π' : Z ⟶ X) (π : Y ⟶ X) : Prop :=
  ∃ g : Z ⟶ Y, g ≫ π = π'

theorem dominates_refl {X Y : SourceReducedComplexSpace} (π : Y ⟶ X) : Dominates π π :=
  ⟨𝟙 Y, Category.id_comp π⟩

theorem Dominates.trans {X Y Z W : SourceReducedComplexSpace} {π : Y ⟶ X} {π' : Z ⟶ X}
    {π'' : W ⟶ X} (h₁ : Dominates π'' π') (h₂ : Dominates π' π) : Dominates π'' π := by
  obtain ⟨g₁, hg₁⟩ := h₁
  obtain ⟨g₂, hg₂⟩ := h₂
  exact ⟨g₁ ≫ g₂, by rw [Category.assoc, hg₂, hg₁]⟩

/-- Every modification `π : Y ⟶ X` dominates the identity modification of `X`. -/
theorem dominates_id {X Y : SourceReducedComplexSpace} (π : Y ⟶ X) : Dominates π (𝟙 X) :=
  ⟨π, Category.comp_id π⟩

/-- A composite `f ≫ π` dominates `π`. -/
theorem dominates_comp {X Y Z : SourceReducedComplexSpace} (f : Z ⟶ Y) (π : Y ⟶ X) :
    Dominates (f ≫ π) π :=
  ⟨f, rfl⟩

/-! ### Bundled modifications -/

/-- **Source `def:modif`.** A modification of the complex space `X`: a complex space `source`
with a morphism `map : source ⟶ X` which is a finite composition of blow-ups with smooth centres.
(The source defines modifications for compact `X`; the predicate makes sense for every `X`, and
then the source is compact as well, `Modification.compactSpace`.) -/
structure Modification (X : SourceReducedComplexSpace) where
  /-- The source of the modification. -/
  source : SourceReducedComplexSpace
  /-- The modification morphism. -/
  map : source ⟶ X
  /-- It is a finite composition of blow-ups with smooth centres. -/
  isModification : IsModification map

namespace Modification

variable {X : SourceReducedComplexSpace}

/-- The identity modification. -/
def id (X : SourceReducedComplexSpace) : Modification X :=
  ⟨X, 𝟙 X, .id X⟩

instance : Inhabited (Modification X) := ⟨id X⟩

/-- Modifications are preordered by domination: `π ≤ π'` iff `π'` dominates `π`. -/
instance instPreorder : Preorder (Modification X) where
  le π π' := Dominates π'.map π.map
  le_refl π := dominates_refl π.map
  le_trans _ _ _ h₁ h₂ := h₂.trans h₁

theorem le_iff_dominates (π π' : Modification X) : π ≤ π' ↔ Dominates π'.map π.map :=
  Iff.rfl

theorem id_le (π : Modification X) : id X ≤ π := dominates_id π.map

/-- The source of a modification of a compact complex space is compact. -/
theorem compactSpace (π : Modification X) [CompactSpace X.obj.left] :
    CompactSpace π.source.obj.left :=
  π.isModification.source_compact

theorem isProperMap (π : Modification X) : IsProperMap π.map.hom.left.base :=
  π.isModification.isProperMap

/-- Composition: a modification of the source of a modification gives a modification of `X`,
which dominates the first one. -/
def comp (π : Modification X) (ρ : Modification π.source) : Modification X :=
  ⟨ρ.source, ρ.map ≫ π.map, ρ.isModification.comp π.isModification⟩

theorem le_comp (π : Modification X) (ρ : Modification π.source) : π ≤ π.comp ρ :=
  dominates_comp ρ.map π.map

end Modification

/-! ### Blow-ups are unique up to unique isomorphism -/

/-- An ideal blow-up is determined by its ideal, up to a unique isomorphism over `X`. -/
theorem isIdealBlowup_exists_unique_iso {X Y Y' : SourceReducedComplexSpace} {p : Y ⟶ X}
    {p' : Y' ⟶ X} {B : SheafOfModules.{0} (forgetRing X.obj.left.toSheafedSpace.sheaf)}
    {b : B ⟶ SheafOfModules.unit (forgetRing X.obj.left.toSheafedSpace.sheaf)}
    (hp : IsIdealBlowup p B b) (hp' : IsIdealBlowup p' B b) :
    ∃ e : Y ≅ Y', e.hom ≫ p' = p ∧ ∀ f : Y ⟶ Y', f ≫ p' = p → f = e.hom := by
  obtain ⟨L, hL, hLu⟩ := hp'.2 Y p hp.1
  obtain ⟨L', hL', _⟩ := hp.2 Y' p' hp'.1
  obtain ⟨_, _, hu⟩ := hp.2 Y p hp.1
  obtain ⟨_, _, hu'⟩ := hp'.2 Y' p' hp'.1
  have h₁ : L ≫ L' = 𝟙 Y := by
    have ha : (L ≫ L') ≫ p = p := by rw [Category.assoc, hL', hL]
    have hb : (𝟙 Y) ≫ p = p := Category.id_comp p
    exact (hu _ ha).trans (hu _ hb).symm
  have h₂ : L' ≫ L = 𝟙 Y' := by
    have ha : (L' ≫ L) ≫ p' = p' := by rw [Category.assoc, hL, hL']
    have hb : (𝟙 Y') ≫ p' = p' := Category.id_comp p'
    exact (hu' _ ha).trans (hu' _ hb).symm
  exact ⟨⟨L, L', h₁, h₂⟩, hL, fun f hf => hLu f hf⟩

/-- Two blow-ups with smooth centres having the same image in `X` are isomorphic over `X`, by a
unique isomorphism. -/
theorem isSmoothCentreBlowup_exists_unique_iso {X Y Y' S S' : SourceReducedComplexSpace}
    {p : Y ⟶ X} {p' : Y' ⟶ X} {i : S ⟶ X} {i' : S' ⟶ X} (hp : IsSmoothCentreBlowup p i)
    (hp' : IsSmoothCentreBlowup p' i') (hrange : range i.hom.left.base = range i'.hom.left.base) :
    ∃ e : Y ≅ Y', e.hom ≫ p' = p ∧ ∀ f : Y ⟶ Y', f ≫ p' = p → f = e.hom := by
  have h := hp.2.2.2.2.2.1
  have h' := hp'.2.2.2.2.2.1
  rw [hrange] at h
  exact isIdealBlowup_exists_unique_iso h h'

/-! ### Blow-up sequences of manifolds are modifications -/

section Manifold

variable {n : ℕ}

private theorem strictTransform_univ_eq {X Y : CMfd.{0} n} (T : BlowupTower X Y) :
    strictTransform n T.proj (univ : Set X) = univ := by
  rw [strictTransform, preimage_univ, ← compl_eq_univ_sdiff]
  exact (interior_eq_empty_iff_dense_compl.mp
    (BlowupSequenceTotalTransform.interior_exceptionalLocus_eq_empty_of_isBlowupSequence
      T.isBlowupSequence)).closure_eq

private theorem centresContainedDense_univ {X Y : CMfd.{0} n} (T : BlowupTower X Y) :
    ContainedCentreModificationSequence.CentresContainedDense (univ : Set X) T := by
  induction T with
  | refl => trivial
  | step T C π hπ ih =>
    refine ⟨ih, ?_, ?_⟩
    · rw [strictTransform_univ_eq T]
      exact subset_univ C
    · rw [strictTransform_univ_eq T, ← compl_eq_univ_sdiff]
      rw [(interior_eq_empty_iff_dense_compl.mp hπ.2.1).closure_eq]

private theorem object_eq {M : Type} [TopologicalSpace M] [ChartedSpace (ComplexModel n) M]
    [IsComplexManifold n M] {A B : Set M} (hA : IsComplexAnalyticSubset (n := n) A)
    (hB : IsComplexAnalyticSubset (n := n) B) (hAB : A = B) :
    ofClosedAnalytic A hA = ofClosedAnalytic B hB := by
  cases hAB
  rfl

private theorem object_eqToHom_base {M : Type} [TopologicalSpace M]
    [ChartedSpace (ComplexModel n) M] [IsComplexManifold n M] {A B : Set M}
    (hA : IsComplexAnalyticSubset (n := n) A) (hB : IsComplexAnalyticSubset (n := n) B)
    (hAB : A = B) (a : A) :
    ((eqToHom (object_eq hA hB hAB)).hom.left.base a).val = a.val := by
  cases hAB
  rfl

private theorem isModification_eqToHom_comp {A B X : SourceReducedComplexSpace}
    (hAB : A = B) {p : B ⟶ X} (hp : IsModification p) : IsModification (eqToHom hAB ≫ p) := by
  cases hAB
  simpa only [eqToHom_refl, Category.id_comp] using hp

/-- **Manifold case of `def:modif`.** Let `σ : Y → X` be a finite composition of blow-ups of
complex manifolds along nowhere dense closed submanifolds (`IsBlowupSequence`).  Then the
morphism of complex spaces `(Y, 𝒪_Y) ⟶ (X, 𝒪_X)` induced by `σ` is a modification in the sense
of `IsModification` (a finite composition of blow-ups of complex spaces with smooth centres,
characterised by the universal property among all complex spaces). -/
theorem isModification_of_isBlowupSequence {X Y : Type} [TopologicalSpace X]
    [ChartedSpace (ComplexModel n) X] [IsComplexManifold n X] [TopologicalSpace Y]
    [ChartedSpace (ComplexModel n) Y] [IsComplexManifold n Y] {σ : Y → X}
    (hσ : IsBlowupSequence n X Y σ) :
    ∃ p : ofClosedAnalytic (univ : Set Y) (isComplexAnalyticSubset_univ (n := n)) ⟶
        ofClosedAnalytic (univ : Set X) (isComplexAnalyticSubset_univ (n := n)),
      IsModification p ∧ ∀ y, (p.hom.left.base y).val = σ y.val := by
  obtain ⟨T, hT⟩ := BlowupTower.exists_proj_eq_of_isBlowupSequence hσ
  have hU : IsComplexAnalyticSubset (n := n) (univ : Set X) := isComplexAnalyticSubset_univ
  have hS := HironakaAdmissibleCalculus.isComplexAnalyticSubset_strictTransform
    T.isBlowupSequence hU
  have hm := ContainedCentreModificationSequence.projectionMorphism_isModification hU T
    (centresContainedDense_univ T)
  have hobj := object_eq (isComplexAnalyticSubset_univ (n := n) (M := Y)) hS
    (strictTransform_univ_eq T).symm
  refine ⟨eqToHom hobj ≫ ContainedCentreModificationSequence.projectionMorphism hU T,
    isModification_eqToHom_comp hobj hm, ?_⟩
  intro y
  change T.proj ((eqToHom hobj).hom.left.base y).val = σ y.val
  rw [object_eqToHom_base _ hS (strictTransform_univ_eq T).symm y, hT]

end Manifold

end

end Hironaka.Analytic.Unibranch.RIsoAModification
