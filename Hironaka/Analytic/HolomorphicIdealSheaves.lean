set_option autoImplicit false

/-!
# Ideal sheaves of holomorphic functions, divisors and multiplier ideals

An ideal sheaf `𝔞 ⊆ 𝒪_M` is recorded by its stalks: `𝔞.mem x g` says that the function `g`, holomorphic near `x`,
has its germ at `x` in `𝔞_x`. All constructions below depend only on germs. The following are new definitions of
this first pass:

* `IsInSpanAt S x g`: the germ of `g` at `x` is a finite holomorphic combination
  of functions from `S`; `IsInSpanOnAt W S x g` is the same identity required only
  on the subset `W` (used for ideals of a closed submanifold, since every
  holomorphic germ on a submanifold is the restriction of an ambient germ).
* `GermIdeal.IsCoherent`: locally generated by finitely many holomorphic
  functions at every point of a neighbourhood.  By Oka's theorem this is
  coherence for ideal subsheaves of `𝒪_M`.
* `GermIdeal.mul`, `GermIdeal.pullback f` (the ideal `𝔞 𝒪_Y` generated by
  pullbacks), `vanishingIdeal A` (`𝓘_A`), `GermIdeal.zeroLocus`.
* `EffectiveDivisor`: an invertible ideal sheaf, i.e. locally generated by one
  holomorphic function that does not vanish identically on any nonempty open set.
  On a complex manifold this is `𝒪(-D)` for an effective divisor `D`; its
  support is the zero locus.
* Locally `ψ_E = ∑ aᵢ log |gᵢ|² + h` with `aᵢ ∈ ℚ≥0`, local equations `gᵢ`, `h` smooth, and `Θ_E = -ddᶜ h`; this is
  `ddᶜ ψ_E = [E] - Θ_E`. Such data are in bijection with pairs (effective `ℚ`-divisor, smooth metric). The support
  of `E` is the pole set of `ψ_E`.
-/

open Set Filter MeasureTheory
open scoped Topology Manifold ContDiff

namespace Hironaka.HolomorphicIdealSheaves

noncomputable section

variable {n m : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (ComplexModel n) M] [IsComplexManifold n M]
  {Y : Type*} [TopologicalSpace Y]
  [ChartedSpace (ComplexModel m) Y] [IsComplexManifold m Y]

variable (n) in
/-- A complex-valued function is holomorphic on a neighbourhood of `x`. -/
def HolomorphicAt (g : M → ℂ) (x : M) : Prop :=
  ∀ᶠ y in 𝓝 x, MDifferentiableAt 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ℂ) g y

/-- The germ of `g` at `x` is a finite combination `∑ aᵢ sᵢ` with `sᵢ ∈ S` and
`aᵢ` holomorphic near `x`. -/
def IsInSpanAt (S : (M → ℂ) → Prop) (x : M) (g : M → ℂ) : Prop :=
  HolomorphicAt n g x ∧
    ∃ (N : ℕ) (s a : Fin N → M → ℂ), (∀ i, S (s i)) ∧ (∀ i, HolomorphicAt n (a i) x) ∧
      g =ᶠ[𝓝 x] fun y => ∑ i, a i y * s i y

/-- The restriction of `g` to `W` has germ at `x` in the ideal of `𝒪_W`
generated by the restrictions of `S`. -/
def IsInSpanOnAt (W : Set M) (S : (M → ℂ) → Prop) (x : M) (g : M → ℂ) : Prop :=
  ∃ (N : ℕ) (s a : Fin N → M → ℂ), (∀ i, S (s i)) ∧ (∀ i, HolomorphicAt n (a i) x) ∧
    ∀ᶠ y in 𝓝 x, y ∈ W → g y = ∑ i, a i y * s i y

/-- An ideal sheaf of `𝒪_M`, recorded by membership of holomorphic germs in its
stalks.  The dimension is a parameter so that it is inferred from the type. -/
@[ext] structure GermIdeal (n : ℕ) (M : Type*) [TopologicalSpace M]
    [ChartedSpace (ComplexModel n) M] where
  mem : M → (M → ℂ) → Prop

namespace GermIdeal

/-- Stalkwise inclusion. -/
def Le (𝔞 𝔟 : GermIdeal n M) : Prop :=
  ∀ x g, 𝔞.mem x g → 𝔟.mem x g

/-- Locally finitely generated (coherent) ideal sheaf. -/
def IsCoherent (𝔞 : GermIdeal n M) : Prop :=
  ∀ x : M, ∃ U : Set M, IsOpen U ∧ x ∈ U ∧ ∃ (N : ℕ) (s : Fin N → M → ℂ),
    (∀ i, MDifferentiableOn 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ℂ) (s i) U) ∧
    ∀ y ∈ U, ∀ g, 𝔞.mem y g ↔ IsInSpanAt (n := n) (· ∈ range s) y g

/-- Locally generated by a single holomorphic function that vanishes identically
on no nonempty open set. -/
def IsInvertible (𝔞 : GermIdeal n M) : Prop :=
  ∀ x : M, ∃ U : Set M, IsOpen U ∧ x ∈ U ∧ ∃ h : M → ℂ,
    MDifferentiableOn 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ℂ) h U ∧
    (∀ W : Set M, IsOpen W → W ⊆ U → W.Nonempty → ∃ y ∈ W, h y ≠ 0) ∧
    ∀ y ∈ U, ∀ g, 𝔞.mem y g ↔ IsInSpanAt (n := n) (· = h) y g

/-- The product ideal `𝔞𝔟`. -/
def mul (𝔞 𝔟 : GermIdeal n M) : GermIdeal n M where
  mem x := IsInSpanAt (n := n) (fun s => ∃ a b, 𝔞.mem x a ∧ 𝔟.mem x b ∧ s = a * b) x

/-- The ideal `𝔞 𝒪_Y` generated by pullbacks along `f : Y → M`. -/
def pullback (f : Y → M) (𝔞 : GermIdeal n M) : GermIdeal m Y where
  mem y := IsInSpanAt (n := m) (fun s => ∃ a, 𝔞.mem (f y) a ∧ s = a ∘ f) y

/-- The zero locus of an ideal sheaf. -/
def zeroLocus (𝔞 : GermIdeal n M) : Set M :=
  {x | ∀ g, 𝔞.mem x g → g x = 0}

end GermIdeal

/-- The ideal sheaf `𝓘_A` of holomorphic germs vanishing on `A`. -/
def vanishingIdeal (A : Set M) : GermIdeal n M where
  mem x g := HolomorphicAt n g x ∧ ∀ᶠ y in 𝓝 x, y ∈ A → g y = 0

variable (n M) in
/-- An effective divisor `D`, recorded by its invertible ideal sheaf `𝒪(-D)`. -/
structure EffectiveDivisor where
  ideal : GermIdeal n M
  isInvertible : ideal.IsInvertible

/-- The support of an effective divisor. -/
def EffectiveDivisor.support (D : EffectiveDivisor n M) : Set M :=
  D.ideal.zeroLocus

end

end Hironaka.HolomorphicIdealSheaves
