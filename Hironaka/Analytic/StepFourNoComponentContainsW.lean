set_option autoImplicit false
set_option linter.unusedSectionVars false

/-!
# Copy-4 Step 4: no component of `D` contains `W`

Source: Copy-4, `prop:principalization`, Steps 1--4
(`references/transcendental-nakamaye-copy4-20260911/source/main-Nulllocus.tex:1776-1880`)
and `sec:positive-current` (`:1418-1426`).

Copy-4 Step 4 defines `D = (1/M) G̃_M + ((C-1)/M) P^mov + (C/M) P^F + τ E_rel`
(`eq:def-DLY`) and states that no component of `D` contains the strict transform `W` of `V`.
The reasons are spread over the source:

* `E_rel`, `P^mov`, `P^F` are exceptional (Step 1, Step 3), and `π` is an isomorphism over a
  nonempty relatively open subset of `V`;
* `G̃_M` is the divisor of `𝔅_M 𝒪_Y` (Step 1), and `𝔅_M` is the unit ideal near a point
  `x_* ∈ V` (`sec:positive-current`: Skoda's theorem at a point of `V` off `E_nn(α)`), so
  `V ⊄ Z(𝔅_M)`.

`StepFiveAssemblyOfEffectiveDivisors` carried the conclusion as the hypothesis `hnd`
("`ψ_D` is `-∞` on no nonempty open subset of `W`").  This module derives it from the facts
just listed and removes it from the Step-5 assembly.

## Main results

* `mem_zeroLocus_iff_of_generators`, `poleSet_eq_zeroLocus`: for a weight with analytic
  singularities of type `(c, 𝔞)`, `{φ = -∞} = Z(𝔞)`.
* `isComplexAnalyticSubset_zeroLocus`: the zero locus of a coherent ideal is analytic.
* `zeroLocus_pullback`: `Z(𝔞 𝒪_Y) = f⁻¹ Z(𝔞)` for a coherent `𝔞` and holomorphic `f`.
* `support_eq_of_isDivisorMetric`: a metric of an effective divisor has the same support.
* `exists_mem_notMem_exceptionalLocus_notMem_of_inter_strictTransform`: every open set meeting
  `W` contains a point of `π⁻¹ V` off `Exc π` lying over the complement of a given analytic
  `Z ⊉ V` (`π` is a closed map, fibres through non-exceptional points are points, the identity
  principle on the irreducible `V`, and the run-0100 density lemma; no Remmert).
* `copy4Divisor_noComponent`, `copy4Divisor_noComponent_of_effectiveDivisors`: `hnd`.
* `exists_polarBranch_stepFiveData_of_effectiveDivisors_of_exceptional`: the Step-5 assembly of
  `StepFiveAssemblyOfEffectiveDivisors` with `hnd` replaced by "`P^mov`, `P^F` exceptional" and
  "`V ⊄ Z(𝔅_M)`".
-/

open Set Filter
open scoped Topology Manifold ContDiff

universe u

namespace Hironaka.StepFourNoComponentContainsW

open Hironaka.PositiveClasses Hironaka.HolomorphicIdealSheaves
  Hironaka.GlobalAnalyticSingularities Hironaka.AnalyticGluingData
  Hironaka.NonKahlerLocus Hironaka.BlowupSequences Hironaka.NumericalRestrictedVolumeScaffold
  PrincipalizationCopy4StepFiveCoreReduction StepFiveAssemblyOfStepOneStepFour
  SubmanifoldChartedSpace MeteredDivisorRestriction ResidualNefReduction
  ManifoldTubePositivity TubePositivityOneFlattening DivisorMetric

noncomputable section

/-! ### Zero loci of ideals -/

section ZeroLocus

variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (ComplexModel n) M] [IsComplexManifold n M]

/-- Inside an open set where `𝔞` is generated by the finite family `g`, the zero locus of `𝔞`
is the common zero set of `g`. -/
theorem mem_zeroLocus_iff_of_generators {𝔞 : GermIdeal n M} {U : Set M} (hU : IsOpen U)
    {N : ℕ} {g : Fin N → M → ℂ}
    (hgd : ∀ i, MDifferentiableOn 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ℂ) (g i) U)
    (hgiff : ∀ y ∈ U, ∀ h, 𝔞.mem y h ↔ IsInSpanAt (n := n) (· ∈ range g) y h)
    {y : M} (hy : y ∈ U) : y ∈ 𝔞.zeroLocus ↔ ∀ i, g i y = 0 := by
  constructor
  · intro hyZ i
    exact hyZ (g i) ((hgiff y hy (g i)).mpr
      (InvertibleIdealQuotient.isInSpanAt_self ⟨i, rfl⟩
        (InvertibleIdealQuotient.holomorphicAt_of_mdifferentiableOn hU (hgd i) hy)))
  · intro h0 f hf
    obtain ⟨-, K, s, a, hs, -, hsum⟩ := (hgiff y hy f).mp hf
    rw [hsum.self_of_nhds]
    refine Finset.sum_eq_zero fun k _ => ?_
    obtain ⟨j, hj⟩ := hs k
    rw [← hj, h0 j, mul_zero]

/-- **The pole set of a weight with analytic singularities of type `(c, 𝔞)` is `Z(𝔞)`.** -/
theorem poleSet_eq_zeroLocus {φ : M → EReal} {c : ℚ} {𝔞 : GermIdeal n M}
    (hφ : HasAnalyticSingularitiesOfType (n := n) φ c 𝔞) : poleSet φ = 𝔞.zeroLocus := by
  obtain ⟨hc, -, hloc⟩ := hφ
  have hcR : (0 : ℝ) < (c : ℝ) := by exact_mod_cast hc
  ext y
  obtain ⟨U, hU, hyU, N, g, hgd, hgiff, R, C, -, hrep⟩ := hloc y
  rw [mem_poleSet, hrep y hyU, scaled_generatorLog_add_eq_bot_iff g y hcR (R y),
    mem_zeroLocus_iff_of_generators hU hgd hgiff hyU]

/-- **The zero locus of a coherent ideal is a complex analytic subset**: near every point it is
the common zero set of finitely many local generators. -/
theorem isComplexAnalyticSubset_zeroLocus {𝔞 : GermIdeal n M} (h𝔞 : 𝔞.IsCoherent) :
    IsComplexAnalyticSubset (n := n) 𝔞.zeroLocus := by
  intro x
  obtain ⟨U, hUopen, hxU, N, g, hgdiff, hgiff⟩ := h𝔞 x
  refine ⟨{
    generatorCount := N
    generator := fun i z => g i ((complexChartAt (n := n) x).val.symm z)
    coordinateNeighborhood := (complexChartAt (n := n) x).val.target ∩
      (complexChartAt (n := n) x).val.symm ⁻¹' U
    isOpen_coordinateNeighborhood :=
      (complexChartAt (n := n) x).val.isOpen_inter_preimage_symm hUopen
    center_mem_coordinateNeighborhood := ?_
    coordinateNeighborhood_subset_target := inter_subset_left
    generator_holomorphic := fun i => differentiableOn_comp_chartSymm x (hgdiff i)
    zeroLocus := ?_ }⟩
  · refine ⟨(complexChartAt (n := n) x).val.map_source (mem_complexChartAt_source x), ?_⟩
    simp only [mem_preimage,
      (complexChartAt (n := n) x).val.left_inv (mem_complexChartAt_source x)]
    exact hxU
  · intro y hysrc hymem
    have hyy : (complexChartAt (n := n) x).val.symm
        ((complexChartAt (n := n) x).val y) = y :=
      (complexChartAt (n := n) x).val.left_inv hysrc
    have hyU : y ∈ U := by
      have := hymem.2
      rwa [mem_preimage, hyy] at this
    simp only [hyy]
    exact mem_zeroLocus_iff_of_generators hUopen hgdiff hgiff hyU

/-- A germ in a coherent ideal is holomorphic. -/
theorem holomorphicAt_of_mem_of_isCoherent {𝔞 : GermIdeal n M} (h𝔞 : 𝔞.IsCoherent) {x : M}
    {g : M → ℂ} (hg : 𝔞.mem x g) : HolomorphicAt n g x := by
  obtain ⟨U, -, hxU, N, s, -, hiff⟩ := h𝔞 x
  exact ((hiff x hxU g).mp hg).1

/-- **`Z(𝔞 𝒪_Y) = f⁻¹ Z(𝔞)`** for a coherent ideal `𝔞` and a holomorphic map `f`. -/
theorem zeroLocus_pullback {m : ℕ} {Y : Type*} [TopologicalSpace Y]
    [ChartedSpace (ComplexModel m) Y] [IsComplexManifold m Y] {f : Y → M}
    (hf : ContMDiff 𝓘(ℂ, ComplexModel m) 𝓘(ℂ, ComplexModel n) ∞ f)
    {𝔞 : GermIdeal n M} (h𝔞 : 𝔞.IsCoherent) :
    (GermIdeal.pullback (m := m) f 𝔞).zeroLocus = f ⁻¹' 𝔞.zeroLocus := by
  ext y
  constructor
  · intro hy
    by_contra hfy
    obtain ⟨b, hb, hby⟩ : ∃ b, 𝔞.mem (f y) b ∧ b (f y) ≠ 0 := by
      by_contra hcon
      push Not at hcon
      exact hfy hcon
    have hcomp : HolomorphicAt m (b ∘ f) y :=
      (holomorphicAt_of_mem_of_isCoherent h𝔞 hb).comp_contMDiff
        (Eventually.of_forall fun y' => hf y')
    have hmem : (GermIdeal.pullback (m := m) f 𝔞).mem y (b ∘ f) :=
      InvertibleIdealQuotient.isInSpanAt_self
        (S := fun s => ∃ a, 𝔞.mem (f y) a ∧ s = a ∘ f) ⟨b, hb, rfl⟩ hcomp
    exact hby (hy (b ∘ f) hmem)
  · intro hy g hg
    obtain ⟨-, K, s, a, hs, -, hsum⟩ := hg
    rw [hsum.self_of_nhds]
    refine Finset.sum_eq_zero fun k _ => ?_
    obtain ⟨b, hb, hbk⟩ := hs k
    rw [hbk, Function.comp_apply, hy b hb, mul_zero]

/-- **A metric of an effective divisor has the divisor's support**: `{ψ_E = -∞} = Supp D`. -/
theorem support_eq_of_isDivisorMetric {D : EffectiveDivisor n M}
    {E : MeteredEffectiveQDivisor n M} (hE : IsDivisorMetric D E) : E.support = D.support :=
  poleSet_eq_zeroLocus (hasAnalyticSingularitiesOfType_of_isDivisorMetric hE)

end ZeroLocus

/-! ### Off the exceptional locus and off an analytic set, inside every open part of `W` -/

variable {n : ℕ} {X : Type u} [TopologicalSpace X]
  [ChartedSpace (ComplexModel n) X] [IsComplexManifold n X]
  {Y : Type u} [TopologicalSpace Y]
  [ChartedSpace (ComplexModel n) Y] [IsComplexManifold n Y]

/-- **Every open set meeting the strict transform `W` of `V` contains a point of `π⁻¹ V` off
`Exc π` whose image avoids a given analytic set `Z ⊉ V`.**  The points of `X` whose whole fibre
lies in the open set form an open set (`π` is closed), it contains the image of a point of
`π⁻¹ V \ Exc π` (whose fibre is that point), so it meets `V`; by the identity principle on the
irreducible `V` it meets `V \ Z`, and by the run-0100 density lemma it meets
`V \ (Z ∪ π(Exc π))`. -/
theorem exists_mem_notMem_exceptionalLocus_notMem_of_inter_strictTransform [CompactSpace X]
    {π : Y → X} (hπ : IsBlowupSequence n X Y π) (V : ClosedIrreducibleAnalyticSubvariety n X)
    {Z : Set X} (hZ : IsComplexAnalyticSubset (n := n) Z) (hVZ : ¬ V.carrier ⊆ Z)
    {O : Set Y} (hO : IsOpen O) (hOW : (O ∩ strictTransform n π V.carrier).Nonempty) :
    ∃ p ∈ O, π p ∈ V.carrier ∧ p ∉ exceptionalLocus n π ∧ π p ∉ Z := by
  obtain ⟨hcpt, hsurj⟩ := StrictTransformComposition.IsBlowupSequence.compactSpace_surjective hπ
  have := hcpt
  have hcont : Continuous π := hπ.contMDiff.continuous
  -- a point of `O` on `π⁻¹ V \ Exc π`
  obtain ⟨y₀, hy₀O, hy₀W⟩ := hOW
  obtain ⟨y₁, hy₁O, hy₁V, hy₁exc⟩ :
      (O ∩ (π ⁻¹' V.carrier \ exceptionalLocus n π)).Nonempty :=
    mem_closure_iff.mp hy₀W O hO hy₀O
  -- the points of `X` whose whole fibre lies in `O`
  set U : Set X := (π '' Oᶜ)ᶜ with hUdef
  have hUopen : IsOpen U :=
    ((hO.isClosed_compl.isCompact).image hcont).isClosed.isOpen_compl
  have hy₁U : π y₁ ∈ U := by
    rintro ⟨z, hz, hzy⟩
    have hzeq : z = y₁ :=
      BlowupSequenceIsomorphismOff.eq_of_apply_eq_of_not_mem_exceptionalLocus hπ hy₁exc hzy
    exact hz (by rw [hzeq]; exact hy₁O)
  -- the identity principle on `V`: `V ∩ U ⊄ Z`
  have hVU : ¬ V.carrier ∩ U ⊆ Z := fun h =>
    hVZ (StrictTransformLocus.subset_of_inter_isOpen_subset V hZ hUopen ⟨π y₁, hy₁V, hy₁U⟩ h)
  obtain ⟨x₁, ⟨hx₁V, hx₁U⟩, hx₁Z⟩ := not_subset.mp hVU
  -- off the exceptional image as well
  have hne : (strictTransform n π V.carrier).Nonempty := ⟨y₀, hy₀W⟩
  obtain ⟨x, ⟨hxV, hxU, hxZ⟩, hxE⟩ :=
    StepSixGenericPoint.exists_mem_inter_notMem_image_exceptionalLocus hπ V
      (StepSixGenericPoint.not_subset_image_exceptionalLocus_of_strictTransform_nonempty hπ hne)
      (hUopen.inter hZ.isClosed.isOpen_compl) ⟨x₁, hx₁V, hx₁U, hx₁Z⟩
  obtain ⟨p, rfl⟩ := hsurj x
  refine ⟨p, ?_, hxV, fun h => hxE ⟨p, h, rfl⟩, hxZ⟩
  by_contra hpO
  exact hxU ⟨p, hpO, rfl⟩

/-! ### No component of `D` contains `W` -/

/-- **No component of `D` contains `W`** (Copy-4 Step 4), from: `Supp G̃_M` lies over an
analytic set `Z ⊉ V`, and `P^mov`, `P^F`, `E_rel` are exceptional.  This is exactly the
hypothesis `hnd` of `MeteredDivisorRestriction.restrictAlong` for `D = eq:def-DLY` along the
strict transform. -/
theorem copy4Divisor_noComponent [CompactSpace X] {π : Y → X} (hπ : IsBlowupSequence n X Y π)
    (V : ClosedIrreducibleAnalyticSubvariety n X) {Z : Set X}
    (hZ : IsComplexAnalyticSubset (n := n) Z) (hVZ : ¬ V.carrier ⊆ Z)
    {levQ CQ τQ : ℚ} (hlev : 0 < levQ) (hC : 1 ≤ CQ) (hτ : 0 ≤ τQ)
    (EGM EPmov EPF E : MeteredEffectiveQDivisor n Y)
    (hGM : EGM.support ⊆ π ⁻¹' Z) (hPmov : EPmov.support ⊆ exceptionalLocus n π)
    (hPF : EPF.support ⊆ exceptionalLocus n π) (hE : E.support ⊆ exceptionalLocus n π) :
    ∀ O : Set (strictTransform n π V.carrier), IsOpen O → O.Nonempty →
      ∃ p ∈ O, (copy4Divisor hlev hC hτ EGM EPmov EPF E).weight (p : Y) ≠ ⊥ := by
  intro O hO hne
  obtain ⟨O', hO', rfl⟩ := isOpen_induced_iff.mp hO
  obtain ⟨q, hq⟩ := hne
  obtain ⟨p, hpO, hpV, hpexc, hpZ⟩ :=
    exists_mem_notMem_exceptionalLocus_notMem_of_inter_strictTransform hπ V hZ hVZ hO'
      ⟨q.1, hq, q.2⟩
  refine ⟨⟨p, subset_closure ⟨hpV, hpexc⟩⟩, hpO, fun hbot => ?_⟩
  have hp : p ∈ (copy4Divisor hlev hC hτ EGM EPmov EPF E).support := hbot
  rcases copy4Divisor_support_subset hlev hC hτ EGM EPmov EPF E hp with ((h | h) | h) | h
  · exact hpZ (hGM h)
  · exact hpexc (hPmov h)
  · exact hpexc (hPF h)
  · exact hpexc (hE h)

/-- **No component of `D` contains `W`, from Copy-4's Step-1 data**: `G̃_M` is the divisor of
`𝔅_M 𝒪_Y` with `𝔅_M` coherent and `V ⊄ Z(𝔅_M)`, `P^mov`, `P^F` and `E_rel` are exceptional,
and the metered divisors are metrics of the effective ones. -/
theorem copy4Divisor_noComponent_of_effectiveDivisors [CompactSpace X] {π : Y → X}
    (hπ : IsBlowupSequence n X Y π) (V : ClosedIrreducibleAnalyticSubvariety n X)
    {𝔅M : GermIdeal n X} (h𝔅M : 𝔅M.IsCoherent) (hVBM : ¬ V.carrier ⊆ 𝔅M.zeroLocus)
    {GM Pmov PF : EffectiveDivisor n Y}
    (hGMideal : GM.ideal = GermIdeal.pullback (m := n) π 𝔅M)
    (hPmovexc : Pmov.support ⊆ exceptionalLocus n π)
    (hPFexc : PF.support ⊆ exceptionalLocus n π)
    {levQ CQ τQ : ℚ} (hlev : 0 < levQ) (hC : 1 ≤ CQ) (hτ : 0 ≤ τQ)
    {EGM EPmov EPF E : MeteredEffectiveQDivisor n Y}
    (hGMmet : IsDivisorMetric GM EGM) (hPmovmet : IsDivisorMetric Pmov EPmov)
    (hPFmet : IsDivisorMetric PF EPF) (hEexc : E.support ⊆ exceptionalLocus n π) :
    ∀ O : Set (strictTransform n π V.carrier), IsOpen O → O.Nonempty →
      ∃ p ∈ O, (copy4Divisor hlev hC hτ EGM EPmov EPF E).weight (p : Y) ≠ ⊥ := by
  have hGM : EGM.support ⊆ π ⁻¹' 𝔅M.zeroLocus := by
    rw [support_eq_of_isDivisorMetric hGMmet, EffectiveDivisor.support, hGMideal,
      zeroLocus_pullback hπ.contMDiff h𝔅M]
  exact copy4Divisor_noComponent hπ V (isComplexAnalyticSubset_zeroLocus h𝔅M) hVBM hlev hC hτ
    EGM EPmov EPF E hGM ((support_eq_of_isDivisorMetric hPmovmet).trans_subset hPmovexc)
    ((support_eq_of_isDivisorMetric hPFmet).trans_subset hPFexc) hEexc

/-! ### The Step-5 assembly without `hnd` -/

/-- **Copy-4 Steps 3--6 from Step 1's effective divisors and the Step-4 current, with "no
component of `D` contains `W`" derived.**  The hypotheses of
`StepFiveAssemblyOfEffectiveDivisors.exists_polarBranch_stepFiveData_of_effectiveDivisors`,
with its hypothesis `hnd` replaced by the Copy-4 facts it follows from: `P^mov` and `P^F` are
exceptional (Step 1) and `V ⊄ Z(𝔅_M)` (`sec:positive-current`: `𝔅_M` is the unit ideal near a
point of `V`).  `φ'` has log singularities along `D|_W`, restricted with the `hnd` proved by
`copy4Divisor_noComponent_of_effectiveDivisors`. -/
theorem exists_polarBranch_stepFiveData_of_effectiveDivisors_of_exceptional
    [CompactSpace X] [CompactSpace Y] [ConnectedSpace Y]
    (omega : KahlerBackground n X) (θ : ClosedRealOneOneForm n X)
    {π : Y → X} (hπ : IsBlowupSequence n X Y π)
    (V : ClosedIrreducibleAnalyticSubvariety n X) {k : ℕ}
    (hW : IsClosedConnectedSubmanifold n (strictTransform n π V.carrier) k)
    -- Step 3: the exceptional metric
    (E : MeteredEffectiveQDivisor n Y) (hEexc : E.support ⊆ exceptionalLocus n π)
    (hEkahler :
      (ClosedRealOneOneForm.pullback hπ.contMDiff omega.form - E.curvature).val.IsKahler)
    -- `sec:fixed-data`: `R = θ + ddᶜΦ_R ≥ δ_R ω` and `eq:PhiR-lower`
    {PhiR : X → EReal} {δR : ℝ}
    (hPhiR : IsThetaPshPotential (θ - δR • omega.form).val PhiR)
    {psiIV psij : X → EReal} {idealIV 𝔧 : GermIdeal n X}
    (hIV : HasAnalyticSingularitiesOfType (n := n) psiIV 1 idealIV)
    (hj : HasAnalyticSingularitiesOfType (n := n) psij 1 𝔧)
    {A : ℝ} (hA : 0 ≤ A) (hPhiRsrc : AmbientPhiRLowerSource n X A PhiR psiIV psij)
    -- `eq:def-TM`: `lem:regularization` at the level `M`
    {c₀ : ℝ} (hc₀ : 0 ≤ c₀) {levQ : ℚ} {UM psiBM : X → EReal} {𝔅M : GermIdeal n X}
    (hpsiBM : HasAnalyticSingularitiesOfType (n := n) psiBM 1 𝔅M)
    (hUM : IsThetaPshPotential (θ + (c₀ / (levQ : ℝ)) • omega.form).val UM)
    (hUMlower : MoreSingularOn (fun x => ((1 / (levQ : ℝ) : ℝ) : EReal) * psiBM x) UM univ)
    -- `sec:positive-current`: `𝔅_M` is the unit ideal near a point of `V`
    (hVBM : ¬ V.carrier ⊆ 𝔅M.zeroLocus)
    -- `eq:def-Psi`: the ideal function of `𝔧 𝔅_m`
    {Ψ psib : X → EReal} {𝔟 : GermIdeal n X} {cΨ δ : ℝ}
    (hΨpsh : ThetaPlurisubharmonic (cΨ • omega.form).val Ψ)
    (hΨtype : HasAnalyticSingularitiesOfType (n := n) Ψ 1 (𝔧.mul 𝔟))
    (hb : HasAnalyticSingularitiesOfType (n := n) psib 1 𝔟)
    -- the constants
    (hlev : 0 < levQ) {L : ℝ} {CQ τQ : ℚ} (hL : 0 < L) (hLlev : L < (levQ : ℝ))
    (hconst : c₀ < L * δR)
    (hC : 1 < CQ) (hCA : L * A ≤ (CQ : ℝ) - 1)
    (hκδ : ((CQ : ℝ) - 1) / (levQ : ℝ) * cΨ ≤ δ)
    (hτ : 0 < τQ) (hτε : (τQ : ℝ) ≤ (L * δR - c₀) / (levQ : ℝ))
    -- Step 1: effective divisors, the ideal identities, `P^mov` and `P^F` exceptional
    (GM Hfix Pmov PF : EffectiveDivisor n Y)
    (hGMideal : GM.ideal = GermIdeal.pullback (m := n) π 𝔅M)
    (hBm : (GermIdeal.pullback (m := n) π 𝔟).Le Hfix.ideal)
    (hfact : GermIdeal.pullback (m := n) π idealIV =
      ((Hfix.ideal.mul Pmov.ideal).mul PF.ideal).mul
        (vanishingIdeal (n := n) (strictTransform n π V.carrier)))
    (hPmovexc : Pmov.support ⊆ exceptionalLocus n π)
    (hPFexc : PF.support ⊆ exceptionalLocus n π)
    -- smooth metrics on them
    (EGM EHfix EPmov EPF : MeteredEffectiveQDivisor n Y)
    (hGMmet : IsDivisorMetric GM EGM) (hHfixmet : IsDivisorMetric Hfix EHfix)
    (hPmovmet : IsDivisorMetric Pmov EPmov) (hPFmet : IsDivisorMetric PF EPF)
    -- a point of `V` near which `Ψ` is smooth (Copy-4 Step 5)
    {x₀ : X} (hx₀V : x₀ ∈ V.carrier) (hΨx₀ : IsSmoothNear (n := n) Ψ x₀)
    -- Step 4's current on `W`, with its complex structure from the flattenings
    : letI := chartedSpace (le_of_isClosedConnectedSubmanifold hW) hW.2.2
      haveI := isComplexManifold_chartedSpace (le_of_isClosedConnectedSubmanifold hW) hW.2.2
      ∀ {φ' : strictTransform n π V.carrier → EReal},
        IsKahlerCurrentPotential (ClosedRealOneOneForm.pullback
          (contMDiff_val (le_of_isClosedConnectedSubmanifold hW) hW.2.2)
          (ClosedRealOneOneForm.pullback hπ.contMDiff θ
            - δ • ClosedRealOneOneForm.pullback hπ.contMDiff omega.form)) φ' →
        HasLogSingularitiesAlong
          (restrictAlong k (contMDiff_val (le_of_isClosedConnectedSubmanifold hW) hW.2.2)
            (copy4Divisor hlev hC.le hτ.le EGM EPmov EPF E)
            (copy4Divisor_noComponent_of_effectiveDivisors hπ V hpsiBM.2.1 hVBM hGMideal
              hPmovexc hPFexc hlev hC.le hτ.le hGMmet hPmovmet hPFmet hEexc)) φ' →
        ∃ φG : Y → EReal,
          IsKahlerCurrentPotential (ClosedRealOneOneForm.pullback hπ.contMDiff θ) φG ∧
          Nonempty (Copy4StepFiveExceptionalWeightData
