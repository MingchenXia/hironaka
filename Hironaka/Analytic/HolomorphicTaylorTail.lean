import Hironaka.Analytic.LastVariableTaylorDivision
import Hironaka.Analytic.CoordinatePlaneDivision
import Hironaka.Analytic.ComplexAnalyticSubvarieties
import Hironaka.Manifold.ComplexManifold
import Hironaka.Manifold.HolomorphicContDiff
set_option autoImplicit false

/-!
# Taylor expansion with holomorphic remainder, along a line and in normal coordinates

* `exists_taylor_tail` (the convergent Taylor tail used in the analytic glueing lemma,
  Włodarczyk 2005 Lemma `homo0` in its analytic form): for `F` holomorphic near `q` and a
  direction `v`,
  `F (z + t • v) = ∑_{j < μ} (j!)⁻¹ (∂_v^j F)(z) t ^ j + t ^ μ G (z, t)` near `(q, 0)`, with
  `G` jointly holomorphic.  Built on the Taylor division `eq_lastQuot_mul_add` /
  `differentiableOn_lastQuot` of `LastVariableTaylorDivision`; the coefficients are identified
  with iterated directional derivatives by the Cauchy formula.
* `inNormalPow_of_iterDeriv_eq_zero` (Taylor expansion in normal coordinates, vanishing form):
  if every iterated directional derivative of order `< μ` of `F` vanishes at every point of the
  coordinate plane `ℂᵏ × 0` near `q`, then near `q` the function `F` lies in the `μ`-th power of
  the ideal generated by the normal coordinates `u i`, `k ≤ i` (`InNormalPow k q μ F`).  This is
  the analytic core of the Hadamard bridge `hir:hadamard-bridge` (an ideal of order `≥ μ` along a
  smooth centre lies in `𝓘_C^μ`): its hypothesis is what the forward half of `hir:order-taylor`
  gives.  Proof: induction on the number of normal coordinates, expanding in the first normal
  coordinate with `exists_taylor_tail`; the coefficients `(∂_{u_k}^j F)(pr u)` (`pr` kills the
  `k`-th coordinate) satisfy the hypothesis for the smaller plane with order `μ - j`
  (`iterDeriv_comp_clm`: derivatives commute with the linear projection `pr`).

`iterDeriv L F` is the iterated directional derivative `∂_{v₁} ⋯ ∂_{v_m} F` along the list
`L = [v₁, …, v_m]`, with `∂_v F = (z ↦ DF(z) v)`.
-/

open Set Filter Metric
open scoped Topology Nat Real

namespace Hironaka.HolomorphicTaylorTail

open Complex

noncomputable section

section General

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]

/-- The directional derivative `∂_v F = (z ↦ DF(z) v)`. -/
def dirDeriv (v : E) (F : E → ℂ) : E → ℂ := fun z => fderiv ℂ F z v

/-- The iterated directional derivative `∂_{v₁} ⋯ ∂_{v_m} F` along `[v₁, …, v_m]`. -/
def iterDeriv : List E → (E → ℂ) → E → ℂ
  | [], F => F
  | v :: L, F => dirDeriv v (iterDeriv L F)

@[simp] theorem iterDeriv_nil (F : E → ℂ) : iterDeriv [] F = F := rfl

@[simp] theorem iterDeriv_cons (v : E) (L : List E) (F : E → ℂ) :
    iterDeriv (v :: L) F = dirDeriv v (iterDeriv L F) := rfl

theorem iterDeriv_append (L L' : List E) (F : E → ℂ) :
    iterDeriv (L ++ L') F = iterDeriv L (iterDeriv L' F) := by
  induction L with
  | nil => rfl
  | cons v L ih => simp [ih]

/-- Iterated directional derivatives of a holomorphic function are holomorphic. -/
theorem differentiableOn_iterDeriv {F : E → ℂ} {U : Set E} (hF : DifferentiableOn ℂ F U)
    (hU : IsOpen U) : ∀ L : List E, DifferentiableOn ℂ (iterDeriv L F) U
  | [] => hF
  | v :: L => Hironaka.differentiableOn_fderiv_apply_of_isOpen
      (differentiableOn_iterDeriv hF hU L) hU v

/-- Along the complex line `s ↦ z + s • v`, iterated derivatives are iterated directional
derivatives in the direction `v`. -/
theorem iteratedDeriv_line {F : E → ℂ} {U : Set E} (hF : DifferentiableOn ℂ F U) (hU : IsOpen U)
    (z v : E) : ∀ (j : ℕ) (t : ℂ), z + t • v ∈ U →
      iteratedDeriv j (fun s : ℂ => F (z + s • v)) t =
        iterDeriv (List.replicate j v) F (z + t • v)
  | 0, t, _ => by simp
  | j + 1, t, ht => by
    rw [iteratedDeriv_succ]
    have hline : Continuous (fun s : ℂ => z + s • v) :=
      continuous_const.add (continuous_id.smul continuous_const)
    have hopen : IsOpen ((fun s : ℂ => z + s • v) ⁻¹' U) := hU.preimage hline
    have heq : iteratedDeriv j (fun s : ℂ => F (z + s • v)) =ᶠ[𝓝 t]
        fun s => iterDeriv (List.replicate j v) F (z + s • v) :=
      eventually_of_mem (hopen.mem_nhds ht) fun s hs => iteratedDeriv_line hF hU z v j s hs
    rw [heq.deriv_eq]
    have hd : HasFDerivAt (iterDeriv (List.replicate j v) F)
        (fderiv ℂ (iterDeriv (List.replicate j v) F) (z + t • v)) (z + t • v) :=
      ((differentiableOn_iterDeriv hF hU _).differentiableAt (hU.mem_nhds ht)).hasFDerivAt
    have hl : HasDerivAt (fun s : ℂ => z + s • v) v t := by
      simpa using ((hasDerivAt_id t).smul_const v).const_add z
    have h3 : HasDerivAt (fun s : ℂ => iterDeriv (List.replicate j v) F (z + s • v))
        (fderiv ℂ (iterDeriv (List.replicate j v) F) (z + t • v) v) t :=
      hd.comp_hasDerivAt t hl
    rw [h3.deriv]
    simp [List.replicate_succ, dirDeriv]

/-- Iterated directional derivatives commute with a continuous linear substitution. -/
theorem iterDeriv_comp_clm {F : E → ℂ} {U : Set E} (hF : DifferentiableOn ℂ F U) (hU : IsOpen U)
    (pr : E →L[ℂ] E) : ∀ (L : List E) (z : E), pr z ∈ U →
      iterDeriv L (fun u => F (pr u)) z = iterDeriv (L.map pr) F (pr z)
  | [], _, _ => rfl
  | v :: L, z, hz => by
    have hopen : IsOpen (pr ⁻¹' U) := hU.preimage pr.continuous
    have heq : iterDeriv L (fun u => F (pr u)) =ᶠ[𝓝 z]
        fun u => iterDeriv (L.map pr) F (pr u) :=
      eventually_of_mem (hopen.mem_nhds hz) fun u hu => iterDeriv_comp_clm hF hU pr L u hu
    have hd : DifferentiableAt ℂ (iterDeriv (L.map pr) F) (pr z) :=
      (differentiableOn_iterDeriv hF hU _).differentiableAt (hU.mem_nhds hz)
    have h2 : HasFDerivAt (fun u => iterDeriv (L.map pr) F (pr u))
        ((fderiv ℂ (iterDeriv (L.map pr) F) (pr z)).comp pr) z :=
      hd.hasFDerivAt.comp z pr.hasFDerivAt
    simp only [iterDeriv_cons, List.map_cons, dirDeriv]
    rw [heq.fderiv_eq, h2.fderiv]
    rfl

/-- The Cauchy coefficients `lastCoeff` are the Taylor coefficients in the last variable. -/
theorem lastCoeff_eq_iteratedDeriv {h : E × ℂ → ℂ} {δ ρ R : ℝ} (hρ : 0 < ρ) (hρR : ρ < R)
    (hh : DifferentiableOn ℂ h (ball (0 : E) δ ×ˢ ball (0 : ℂ) R)) (k : ℕ) {w : E}
    (hw : w ∈ ball (0 : E) δ) :
    lastCoeff h ρ k w = (k ! : ℂ)⁻¹ * iteratedDeriv k (fun s => h (w, s)) 0 := by
  have hf : DifferentiableOn ℂ (fun s => h (w, s)) (ball 0 R) :=
    hh.comp ((differentiableOn_const w).prodMk differentiableOn_id) fun s hs => ⟨hw, hs⟩
  have hcl : closedBall (0 : ℂ) ρ ⊆ ball 0 R := closedBall_subset_ball hρR
  have := Complex.circleIntegral_one_div_sub_center_pow_smul_of_differentiable_on_off_countable
    (c := 0) hρ k countable_empty (hf.mono hcl).continuousOn
    (fun z hz => hf.differentiableAt (isOpen_ball.mem_nhds (ball_subset_ball hρR.le hz.1)))
  simp only [sub_zero, smul_eq_mul] at this
  unfold lastCoeff
  have hint : (∮ ζ in C(0, ρ), h (w, ζ) / ζ ^ (k + 1)) =
      ∮ ζ in C(0, ρ), 1 / ζ ^ (k + 1) * h (w, ζ) := by
    congr 1; funext ζ; ring
  rw [hint, this]
  have : (k ! : ℂ) ≠ 0 := by exact_mod_cast k.factorial_ne_zero
  field_simp

/-- **Taylor expansion along a line with holomorphic remainder.**  For `F` holomorphic near `q`,
a direction `v` and `μ ∈ ℕ`, near `(q, 0)`:
`F (z + t • v) = ∑_{j < μ} (j!)⁻¹ (∂_v^j F)(z) t ^ j + t ^ μ G (z, t)` with `G` holomorphic. -/
theorem exists_taylor_tail {F : E → ℂ} {q : E} (hF : ∀ᶠ z in 𝓝 q, DifferentiableAt ℂ F z)
    (v : E) (μ : ℕ) :
    ∃ G : E × ℂ → ℂ, (∀ᶠ x in 𝓝 (q, (0 : ℂ)), DifferentiableAt ℂ G x) ∧
      ∀ᶠ x in 𝓝 (q, (0 : ℂ)), F (x.1 + x.2 • v) =
        ∑ j ∈ Finset.range μ, (j ! : ℂ)⁻¹ * iterDeriv (List.replicate j v) F x.1 * x.2 ^ j +
          x.2 ^ μ * G x := by
  obtain ⟨r, hr, hball⟩ := Metric.eventually_nhds_iff_ball.mp hF
  have hFU : DifferentiableOn ℂ F (ball q r) := fun z hz => (hball z hz).differentiableWithinAt
  set R : ℝ := r / (2 * (‖v‖ + 1)) with hRdef
  have hv1 : 0 < ‖v‖ + 1 := by positivity
  have hR : 0 < R := by positivity
  set δ : ℝ := r / 2 with hδdef
  have hδ : 0 < δ := by positivity
  set ρ : ℝ := R / 2 with hρdef
  have hρ : 0 < ρ := by positivity
  have hρR : ρ < R := by rw [hρdef]; linarith
  obtain ⟨h, hhdef⟩ : ∃ h : E × ℂ → ℂ, h = fun x => F (q + x.1 + x.2 • v) := ⟨_, rfl⟩
  have hmem : ∀ x ∈ ball (0 : E) δ ×ˢ ball (0 : ℂ) R, q + x.1 + x.2 • v ∈ ball q r := by
    rintro ⟨w, t⟩ ⟨hw, ht⟩
    rw [mem_ball_zero_iff] at hw ht
    rw [mem_ball, dist_eq_norm, add_assoc, add_sub_cancel_left]
    have h1 : ‖t‖ * ‖v‖ ≤ ‖t‖ * (‖v‖ + 1) := by nlinarith [norm_nonneg t]
    have h2 : ‖t‖ * (‖v‖ + 1) < R * (‖v‖ + 1) := mul_lt_mul_of_pos_right ht hv1
    have h3 : R * (‖v‖ + 1) = r / 2 := by rw [hRdef]; field_simp
    calc ‖w + t • v‖ ≤ ‖w‖ + ‖t‖ * ‖v‖ := (norm_add_le _ _).trans (by rw [norm_smul])
      _ < r := by rw [hδdef] at hw; linarith
  have hh : DifferentiableOn ℂ h (ball (0 : E) δ ×ˢ ball (0 : ℂ) R) := by
    rw [hhdef]
    have hin : Differentiable ℂ (fun x : E × ℂ => q + x.1 + x.2 • v) :=
      ((differentiable_const q).add differentiable_fst).add (differentiable_snd.smul_const v)
    exact hFU.comp hin.differentiableOn hmem
  have hU : IsOpen (ball (0 : E) δ ×ˢ ball (0 : ℂ) R) := isOpen_ball.prod isOpen_ball
  have hφc : Continuous (fun x : E × ℂ => (x.1 - q, x.2)) :=
    (continuous_fst.sub continuous_const).prodMk continuous_snd
  have hO : ∀ᶠ x in 𝓝 (q, (0 : ℂ)), (x.1 - q, x.2) ∈ ball (0 : E) δ ×ˢ ball (0 : ℂ) R := by
    have h0 : (fun x : E × ℂ => (x.1 - q, x.2)) (q, 0) ∈ ball (0 : E) δ ×ˢ ball (0 : ℂ) R := by
      simp [hδ, hR]
    exact hφc.continuousAt.preimage_mem_nhds (hU.mem_nhds h0)
  refine ⟨fun x => lastQuot h ρ μ (x.1 - q, x.2), ?_, ?_⟩
  · filter_upwards [hO] with x hx
    have hφd : DifferentiableAt ℂ (fun x : E × ℂ => (x.1 - q, x.2)) x :=
      (differentiableAt_fst.sub_const q).prodMk differentiableAt_snd
    exact ((differentiableOn_lastQuot hρ hρR hh μ).differentiableAt (hU.mem_nhds hx)).comp x hφd
  · filter_upwards [hO] with x hx
    have heq := eq_lastQuot_mul_add hρ hρR hh μ (x.1 - q, x.2) hx
    have hhx : h (x.1 - q, x.2) = F (x.1 + x.2 • v) := by
      rw [hhdef]; simp only [add_sub_cancel]
    have hx1 : x.1 ∈ ball q r := by
      have := hmem (x.1 - q, 0) ⟨hx.1, mem_ball_self hR⟩
      simpa using this
    rw [← hhx, heq, add_comm, mul_comm (x.2 ^ μ)]
    congr 1
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [lastCoeff_eq_iteratedDeriv hρ hρR hh k hx.1]
    have hfun : (fun s => h (x.1 - q, s)) = fun s => F (x.1 + s • v) := by
      funext s; rw [hhdef]; simp only [add_sub_cancel]
    rw [hfun, iteratedDeriv_line hFU isOpen_ball x.1 v k 0 (by simpa using hx1)]
    simp

end General

section Normal

variable {n : ℕ}

/-- `InNormalPow k q μ F`: near `q`, `F` lies in the `μ`-th power of the ideal generated by the
normal coordinates `u i`, `k ≤ i` (recursively: `F = ∑ᵢ u i * Hᵢ` near `q` with `Hᵢ = 0` for the
tangential `i < k` and each `Hᵢ` in the `(μ-1)`-th power; the `0`-th power is the holomorphic
germs). -/
def InNormalPow (k : ℕ) (q : ComplexModel n) : ℕ → (ComplexModel n → ℂ) → Prop
  | 0, F => ∀ᶠ u in 𝓝 q, DifferentiableAt ℂ F u
  | μ + 1, F => ∃ H : Fin n → ComplexModel n → ℂ, (∀ i : Fin n, i.1 < k → H i = 0) ∧
      (∀ i, InNormalPow k q μ (H i)) ∧ ∀ᶠ u in 𝓝 q, F u = ∑ i, u i * H i u

variable {k : ℕ} {q : ComplexModel n}

theorem InNormalPow.eventually_differentiableAt :
    ∀ {μ : ℕ} {F : ComplexModel n → ℂ}, InNormalPow k q μ F →
      ∀ᶠ u in 𝓝 q, DifferentiableAt ℂ F u
  | 0, _, hF => hF
  | μ + 1, F, ⟨H, _, hH, hFeq⟩ => by
    have hd : ∀ᶠ u in 𝓝 q, ∀ i, DifferentiableAt ℂ (H i) u :=
      eventually_all.mpr fun i => (hH i).eventually_differentiableAt
    filter_upwards [hd.eventually_nhds, hFeq.eventually_nhds] with u hu hFu
    have hsum : DifferentiableAt ℂ (fun u : ComplexModel n => ∑ i, u i * H i u) u := by
      refine DifferentiableAt.fun_sum fun i _ => ?_
      exact ((EuclideanSpace.proj i : ComplexModel n →L[ℂ] ℂ).differentiableAt).mul
        (hu.self_of_nhds i)
    exact hsum.congr_of_eventuallyEq hFu

theorem InNormalPow.congr : ∀ {μ : ℕ} {F F' : ComplexModel n → ℂ}, InNormalPow k q μ F →
    F' =ᶠ[𝓝 q] F → InNormalPow k q μ F'
  | 0, F, F', hF, hFF' => by
    filter_upwards [hF.eventually_nhds, hFF'.eventually_nhds] with u hu h'
    exact hu.self_of_nhds.congr_of_eventuallyEq h'
  | μ + 1, F, F', ⟨H, h0, hH, hFeq⟩, hFF' => ⟨H, h0, hH, hFF'.trans hFeq⟩

theorem inNormalPow_zero_fun : ∀ μ : ℕ, InNormalPow k q μ (0 : ComplexModel n → ℂ)
  | 0 => Eventually.of_forall fun _ => differentiableAt_const _
  | μ + 1 => ⟨fun _ => 0, fun _ _ => rfl, fun _ => inNormalPow_zero_fun μ,
      Eventually.of_forall fun u => by simp⟩

theorem InNormalPow.add : ∀ {μ : ℕ} {F G : ComplexModel n → ℂ}, InNormalPow k q μ F →
    InNormalPow k q μ G → InNormalPow k q μ (fun u => F u + G u)
  | 0, _, _, hF, hG => by
    filter_upwards [hF, hG] with u hu hv
    exact hu.add hv
  | μ + 1, _, _, ⟨H, h0, hH, hFeq⟩, ⟨K, k0, hK, hGeq⟩ => by
    refine ⟨fun i u => H i u + K i u, fun i hi => ?_, fun i => (hH i).add (hK i), ?_⟩
    · funext u; simp [h0 i hi, k0 i hi]
    · filter_upwards [hFeq, hGeq] with u h1 h2
      rw [h1, h2, ← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl fun i _ => by ring

theorem InNormalPow.const_mul_holo {c : ComplexModel n → ℂ}
    (hc : ∀ᶠ u in 𝓝 q, DifferentiableAt ℂ c u) :
    ∀ {μ : ℕ} {F : ComplexModel n → ℂ}, InNormalPow k q μ F →
      InNormalPow k q μ (fun u => c u * F u)
  | 0, _, hF => by
    filter_upwards [hc, hF] with u h1 h2
    exact h1.mul h2
  | μ + 1, _, ⟨H, h0, hH, hFeq⟩ => by
    refine ⟨fun i u => c u * H i u, fun i hi => ?_, fun i => (hH i).const_mul_holo hc, ?_⟩
    · funext u; simp [h0 i hi]
    · filter_upwards [hFeq] with u h1
      rw [h1, Finset.mul_sum]
      exact Finset.sum_congr rfl fun i _ => by ring

theorem InNormalPow.coord_mul {i : Fin n} (hi : k ≤ i.1) {μ : ℕ} {F : ComplexModel n → ℂ}
    (hF : InNormalPow k q μ F) : InNormalPow k q (μ + 1) (fun u => u i * F u) := by
  classical
  refine ⟨fun j u => if j = i then F u else 0, fun j hj => ?_, fun j => ?_, ?_⟩
  · have hji : j ≠ i := fun h => by subst h; omega
    funext u; simp [hji]
  · by_cases hji : j = i
    · exact hF.congr (Eventually.of_forall fun u => by simp [hji])
    · exact (inNormalPow_zero_fun (k := k) (q := q) μ).congr
        (Eventually.of_forall fun u => by simp [hji])
  · refine Eventually.of_forall fun u => ?_
    simp [mul_ite, mul_zero, Finset.sum_ite_eq']

theorem InNormalPow.coord_pow_mul {i : Fin n} (hi : k ≤ i.1) {m : ℕ} {F : ComplexModel n → ℂ}
    (hF : InNormalPow k q m F) : ∀ j : ℕ, InNormalPow k q (m + j) (fun u => u i ^ j * F u)
  | 0 => hF.congr (Eventually.of_forall fun u => by simp)
  | j + 1 => ((hF.coord_pow_mul hi j).coord_mul hi).congr
      (Eventually.of_forall fun u => by simp only; ring)

theorem InNormalPow.mono_k : ∀ {μ : ℕ} {F : ComplexModel n → ℂ}, InNormalPow (k + 1) q μ F →
    InNormalPow k q μ F
  | 0, _, hF => hF
  | μ + 1, _, ⟨H, h0, hH, hFeq⟩ =>
    ⟨H, fun i hi => h0 i (by omega), fun i => (hH i).mono_k, hFeq⟩

theorem inNormalPow_finset_sum {ι : Type*} (s : Finset ι) {μ : ℕ}
    {f : ι → ComplexModel n → ℂ} (hf : ∀ j ∈ s, InNormalPow k q μ (f j)) :
    InNormalPow k q μ (fun u => ∑ j ∈ s, f j u) := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    exact (inNormalPow_zero_fun (k := k) (q := q) μ).congr
      (Eventually.of_forall fun u => by simp)
  | insert a s ha ih =>
    have h1 := (hf a (Finset.mem_insert_self a s)).add
      (ih fun j hj => hf j (Finset.mem_insert_of_mem hj))
    exact h1.congr (Eventually.of_forall fun u => by simp [Finset.sum_insert ha])

/-- The projection killing the `i`-th coordinate: `u ↦ u - u i • eᵢ`. -/
def killCoord (i : Fin n) : ComplexModel n →L[ℂ] ComplexModel n :=
  ContinuousLinearMap.id ℂ (ComplexModel n) -
    (EuclideanSpace.proj i : ComplexModel n →L[ℂ] ℂ).smulRight (EuclideanSpace.single i (1 : ℂ))

theorem killCoord_apply_apply (i l : Fin n) (u : ComplexModel n) :
    killCoord i u l = if l = i then 0 else u l := by
  by_cases hl : l = i
  · subst hl; simp [killCoord]
  · simp [killCoord, hl]

theorem killCoord_add (i : Fin n) (u : ComplexModel n) :
    killCoord i u + u i • EuclideanSpace.single i (1 : ℂ) = u := by
  simp [killCoord]

theorem killCoord_of_apply_eq_zero {i : Fin n} {u : ComplexModel n} (hu : u i = 0) :
    killCoord i u = u := by
  ext l
  rw [killCoord_apply_apply]
  split_ifs with hl
  · subst hl; exact hu.symm
  · rfl

/-- Induction on the number of normal coordinates for `inNormalPow_of_iterDeriv_eq_zero`. -/
theorem inNormalPow_of_iterDeriv_eq_zero_aux (d : ℕ) :
    ∀ (k : ℕ), n - k = d → ∀ (μ : ℕ) {F : ComplexModel n → ℂ} {q : ComplexModel n},
      q ∈ complexCoordinatePlane n k → (∀ᶠ u in 𝓝 q, DifferentiableAt ℂ F u) →
      (∀ᶠ y in 𝓝 q, y ∈ complexCoordinatePlane n k →
        ∀ L : List (ComplexModel n), L.length < μ → iterDeriv L F y = 0) →
      InNormalPow k q μ F := by
  induction d with
  | zero =>
    intro k hk μ F q _ hF hvan
    rcases μ with _ | μ
    · exact hF
    · have hall : ∀ y : ComplexModel n, y ∈ complexCoordinatePlane n k :=
        fun y i hi => absurd i.2 (by omega)
      have hF0 : F =ᶠ[𝓝 q] (0 : ComplexModel n → ℂ) := by
        filter_upwards [hvan] with y hy
        exact hy (hall y) [] (by simp)
      exact (inNormalPow_zero_fun (μ + 1)).congr hF0
  | succ d ih =>
    intro k hk μ F q hq hF hvan
    have hkn : k < n := by omega
    set i : Fin n := ⟨k, hkn⟩ with hidef
    set e : ComplexModel n := EuclideanSpace.single i (1 : ℂ) with hedef
    set pr : ComplexModel n →L[ℂ] ComplexModel n := killCoord i with hprdef
    have hqi : q i = 0 := hq i le_rfl
    have hprq : pr q = q := killCoord_of_apply_eq_zero hqi
    -- a ball on which `F` is holomorphic
    obtain ⟨r, hr, hball⟩ := Metric.eventually_nhds_iff_ball.mp hF
    have hFU : DifferentiableOn ℂ F (ball q r) := fun z hz => (hball z hz).differentiableWithinAt
    have hprt : Tendsto pr (𝓝 q) (𝓝 q) := by
      simpa [hprq] using pr.continuous.tendsto q
    have hprU : ∀ᶠ u in 𝓝 q, pr u ∈ ball q r := hprt.eventually (isOpen_ball.mem_nhds (mem_ball_self hr))
    -- the Taylor tail in the `i`-th coordinate
    obtain ⟨G, hGd, hGeq⟩ := exists_taylor_tail hF e μ
    have hφt : Tendsto (fun u : ComplexModel n => (pr u, u i)) (𝓝 q) (𝓝 (q, (0 : ℂ))) := by
      have hc : Continuous (fun u : ComplexModel n => (pr u, u i)) :=
        pr.continuous.prodMk (EuclideanSpace.proj i : ComplexModel n →L[ℂ] ℂ).continuous
      simpa [hprq, hqi] using hc.tendsto q
    -- the coefficients
    set g : ℕ → ComplexModel n → ℂ := fun j u => iterDeriv (List.replicate j e) F (pr u) with hgdef
    have hg : ∀ j < μ, InNormalPow (k + 1) q (μ - j) (g j) := by
      intro j hj
      refine ih (k + 1) (by omega) (μ - j) (fun l hl => hq l (by omega)) ?_ ?_
      · filter_upwards [hprU] with u hu
        exact ((differentiableOn_iterDeriv hFU isOpen_ball _).differentiableAt
          (isOpen_ball.mem_nhds hu)).comp u pr.differentiableAt
      · filter_upwards [hprU, hprt.eventually hvan] with y hyU hyvan hy L hL
        have hcomp := iterDeriv_comp_clm (differentiableOn_iterDeriv hFU isOpen_ball
          (List.replicate j e)) isOpen_ball pr L y hyU
        simp only [hgdef]
        rw [hcomp, ← iterDeriv_append]
        refine hyvan (fun l hl => ?_) _ (by simp; omega)
        change killCoord i y l = 0
        rw [killCoord_apply_apply]
        split_ifs with hli
        · rfl
        · exact hy l (by
            have : l.1 ≠ k := fun h => hli (Fin.ext h)
            omega)
    have hik : k ≤ i.1 := le_rfl
    -- each term of the expansion
    have hterm : ∀ j ∈ Finset.range μ, InNormalPow k q μ
        (fun u => (j ! : ℂ)⁻¹ * (u i ^ j * g j u)) := by
      intro j hj
      have hjμ : j < μ := Finset.mem_range.mp hj
      have h1 := ((hg j hjμ).mono_k).coord_pow_mul hik j
      rw [Nat.sub_add_cancel hjμ.le] at h1
      exact h1.const_mul_holo (Eventually.of_forall fun _ => differentiableAt_const _)
    have hlast : InNormalPow k q μ (fun u => u i ^ μ * G (pr u, u i)) := by
      have h0 : InNormalPow k q 0 (fun u => G (pr u, u i)) := by
        filter_upwards [hφt.eventually hGd] with u hu
        exact hu.comp u (pr.differentiableAt.prodMk
          (EuclideanSpace.proj i : ComplexModel n →L[ℂ] ℂ).differentiableAt)
      simpa using h0.coord_pow_mul hik μ
    refine ((inNormalPow_finset_sum _ hterm).add hlast).congr ?_
    filter_upwards [hφt.eventually hGeq] with u hu
    have hu' : F u = ∑ j ∈ Finset.range μ,
        (j ! : ℂ)⁻¹ * iterDeriv (List.replicate j e) F (pr u) * u i ^ j + u i ^ μ * G (pr u, u i) := by
      have hsum : pr u + u i • e = u := killCoord_add i u
      simpa only [hsum] using hu
    rw [hu']
    congr 1
    refine Finset.sum_congr rfl fun j _ => ?_
    simp only [hgdef]
    ring

/-- **Taylor expansion in normal coordinates, vanishing form.**  If every iterated directional
derivative of order `< μ` of `F` vanishes at every point of the coordinate plane `ℂᵏ × 0`
near `q ∈ ℂᵏ × 0`, then near `q` the function `F` lies in the `μ`-th power of the ideal generated
by the normal coordinates `u i`, `k ≤ i`. -/
theorem inNormalPow_of_iterDeriv_eq_zero (μ : ℕ) {F : ComplexModel n → ℂ}
    (hq : q ∈ complexCoordinatePlane n k) (hF : ∀ᶠ u in 𝓝 q, DifferentiableAt ℂ F u)
    (hvan : ∀ᶠ y in 𝓝 q, y ∈ complexCoordinatePlane n k →
      ∀ L : List (ComplexModel n), L.length < μ → iterDeriv L F y = 0) :
    InNormalPow k q μ F :=
  inNormalPow_of_iterDeriv_eq_zero_aux (n - k) k rfl μ hq hF hvan

end Normal

