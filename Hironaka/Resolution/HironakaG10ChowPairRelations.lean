import Hironaka.Resolution.HironakaG10ChowGermIdealDictionary
import Hironaka.Resolution.HironakaSingularSubspaceBlowupCartierCentreIdeal
import Hironaka.Resolution.HironakaSingularSubspaceBlowupCartierRatios
import Hironaka.Resolution.HironakaG10ChowBlowupDirection

/-!
# From an equality of restricted pulled centre ideals to explicit generator relations

Route step N2 (pair-injectivity of the one-step strict transform), the passage from the native
ideal dictionary to the value-level hypotheses of
`HironakaG10ChowBlowupDirection.eq_of_pair_value_core`.

Let `G : O → M` and `ι : O → M'` be holomorphic, `S₀ ⊆ O` and `z₀ ∈ S₀`.  If the ideals pulled back
from the centres `C ⊆ M` (along `G`) and `C' ⊆ M'` (along `ι`) have the same image in the actual
stalk of `S₀` at `z₀`, then the normal flattening coordinates of `C'` composed with `ι` and those of
`C` composed with `G` are combinations of each other along `S₀` near `z₀`, with coefficients
holomorphic at `z₀` (`exists_relations_of_ideal_eq`).  The coefficient lemma
`exists_relation_of_mem_span` reads one ideal membership in the actual stalk of `S₀` as an identity
of functions on `S₀` near `z₀`.
-/

set_option autoImplicit false

open Set Filter TopologicalSpace CategoryTheory Opposite AlgebraicGeometry
open scoped Topology Manifold ContDiff

namespace Hironaka.HironakaG10ChowPairRelations

open Hironaka.HolomorphicIdealSheaves Hironaka.BlowupSequences
  HironakaSmoothCentreRealDomainActualSheafStalk HironakaActualAnalyticSubspace
  HironakaHolomorphicJetRankLoci HironakaSingularSubspaceBlowupCartierCentreIdeal
  HironakaSingularSubspaceBlowupCartierRatios HironakaG10ChowGermIdealDictionary
  BlowupFlatCoordinates

noncomputable section

section Germs

variable {m : ℕ} {O : Type} [TopologicalSpace O] [ChartedSpace (ComplexModel m) O]
  [IsComplexManifold m O]

/-- The germ of a finite sum of products, over any finite index type. -/
theorem originalGerm_fintype_sum_mul (x : O) {κ : Type} [Fintype κ] (a s : κ → O → ℂ)
    (ha : ∀ i, HolomorphicAt m (a i) x) (hs : ∀ i, HolomorphicAt m (s i) x)
    (h : HolomorphicAt m (fun z => ∑ i, a i z * s i z) x) :
    actualOriginalFunctionGerm x (fun z => ∑ i, a i z * s i z) h =
      ∑ i, actualOriginalFunctionGerm x (a i) (ha i) *
        actualOriginalFunctionGerm x (s i) (hs i) := by
  apply (actualStalkChartEquiv (n := m) x).injective
  rw [map_sum]
  simp only [map_mul, actualOriginalFunctionGerm_chart]
  refine HolGerm.mk_sum Finset.univ _ (fun i => ?_)
  exact eventually_differentiableAt_mul
    (translated_holomorphic _ (CartanLocalReduction.holAt_comp_chart_symm
      (mem_chart_source (ComplexModel m) x) (ha i)))
    (translated_holomorphic _ (CartanLocalReduction.holAt_comp_chart_symm
      (mem_chart_source (ComplexModel m) x) (hs i)))

/-- **An ideal membership in the actual stalk of a subset, as a relation of functions.**  If the
image of the germ of `f` lies in the ideal generated by the images of the germs of the `g i`, then
`f = ∑ aᵢ gᵢ` on the subset near the point, with `aᵢ` holomorphic at the point. -/
theorem exists_relation_of_mem_span (S : Set O) (x : S) {κ : Type} [Fintype κ]
    (f : O → ℂ) (hf : HolomorphicAt m f x.val)
    (g : κ → O → ℂ) (hg : ∀ i, HolomorphicAt m (g i) x.val)
    (hmem : ((actualSubspaceInclusion (n := m) S).stalkMap x)
        (actualOriginalFunctionGerm x.val f hf) ∈
      Ideal.span (Set.range fun i => ((actualSubspaceInclusion (n := m) S).stalkMap x)
        (actualOriginalFunctionGerm x.val (g i) (hg i)))) :
    ∃ a : κ → O → ℂ, (∀ i, HolomorphicAt m (a i) x.val) ∧
      ∀ᶠ z in 𝓝 x.val, z ∈ S → f z = ∑ i, a i z * g i z := by
  classical
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp hmem
  have hrep : ∀ i, ∃ (a : O → ℂ) (ha : HolomorphicAt m a x.val),
      ((actualSubspaceInclusion (n := m) S).stalkMap x)
        (actualOriginalFunctionGerm x.val a ha) = c i := by
    intro i
    obtain ⟨r, hr⟩ := actualSubspaceInclusionRingedHom_stalk_surjective (n := m) S x (c i)
    obtain ⟨a, ha, har⟩ := exists_originalGerm_eq x.val r
    exact ⟨a, ha, by rw [har]; exact hr⟩
  choose a ha hac using hrep
  refine ⟨a, ha, ?_⟩
  have hsum : HolomorphicAt m (fun z => ∑ i, a i z * g i z) x.val :=
    HolomorphicAt.sum _ fun i _ => (ha i).mul (hg i)
  apply (actual_quotient_germ_eq_iff S x f _ hf hsum).mp
  rw [originalGerm_fintype_sum_mul x.val a g ha hg hsum, map_sum]
  simp only [map_mul, hac]
  rw [← hc]
  simp only [smul_eq_mul]

end Germs

/-- A sum over the normal indices, as a sum over all indices with zero coefficients. -/
theorem sum_dite_normal {N : ℕ} (k : ℕ) (F : {s : Fin N // k ≤ s.1} → ℂ) (c : Fin N → ℂ) :
    ∑ s : Fin N, (if hs : k ≤ s.1 then F ⟨s, hs⟩ else 0) * c s =
      ∑ i : {s : Fin N // k ≤ s.1}, F i * c i.1 := by
  classical
  have h1 : ∀ i : {s : Fin N // k ≤ s.1},
      F i * c i.1 = (if hs : k ≤ i.1.1 then F ⟨i.1, hs⟩ else 0) * c i.1 := by
    intro i
    rw [dif_pos i.2]
  rw [Finset.sum_congr rfl (fun i _ => h1 i)]
  rw [← Finset.sum_subtype (Finset.univ.filter fun s : Fin N => k ≤ s.1) (by simp)
    (fun s => (if hs : k ≤ s.1 then F ⟨s, hs⟩ else 0) * c s), Finset.sum_filter]
  refine Finset.sum_congr rfl fun s _ => ?_
  by_cases hs : k ≤ s.1
  · rw [if_pos hs]
  · rw [if_neg hs, dif_neg hs, zero_mul]

section Relations

variable {n n' m : ℕ} {M M' O : Type} [TopologicalSpace M] [ChartedSpace (ComplexModel n) M]
  [IsComplexManifold n M] [TopologicalSpace M'] [ChartedSpace (ComplexModel n') M']
  [IsComplexManifold n' M'] [TopologicalSpace O] [ChartedSpace (ComplexModel m) O]
  [IsComplexManifold m O] {C : Set M} {C' : Set M'} {G : O → M} {ι : O → M'}

/-- **Generator relations from an equality of restricted pulled centre ideals.** -/
theorem exists_relations_of_ideal_eq (hC : IsClosedSubmanifold n C)
    (hC' : IsClosedSubmanifold n' C')
    (hG : ContMDiff 𝓘(ℂ, ComplexModel m) 𝓘(ℂ, ComplexModel n) ∞ G)
    (hι : ContMDiff 𝓘(ℂ, ComplexModel m) 𝓘(ℂ, ComplexModel n') ∞ ι)
    {y₀ : M} {Φ : LocalHolomorphicEquivAt (n := n) (chartAt (ComplexModel n) y₀ y₀)} {k : ℕ}
    (hΦsrc : Φ.source ⊆ (chartAt (ComplexModel n) y₀).target)
    (hflat : ∀ {y : M}, y ∈ (chartAt (ComplexModel n) y₀).source →
      chartAt (ComplexModel n) y₀ y ∈ Φ.source →
        (y ∈ C ↔ Φ.toFun (chartAt (ComplexModel n) y₀ y) ∈ complexCoordinatePlane n k))
    {w₀ : M'} {Φ' : LocalHolomorphicEquivAt (n := n') (chartAt (ComplexModel n') w₀ w₀)}
    {k' : ℕ} (hΦ'src : Φ'.source ⊆ (chartAt (ComplexModel n') w₀).target)
    (hflat' : ∀ {y : M'}, y ∈ (chartAt (ComplexModel n') w₀).source →
      chartAt (ComplexModel n') w₀ y ∈ Φ'.source →
        (y ∈ C' ↔ Φ'.toFun (chartAt (ComplexModel n') w₀ y) ∈ complexCoordinatePlane n' k'))
    (S : Set O) (x : S) (hGx : G x.val ∈ flatDomain Φ) (hιx : ι x.val ∈ flatDomain Φ')
    (heq : Ideal.map ((actualSubspaceInclusion (n := m) S).stalkMap x).hom
        (actualWholeSheafStalkIdeal
          (GermIdeal.pullback (m := m) G (vanishingIdeal (n := n) C)) x.val) =
      Ideal.map ((actualSubspaceInclusion (n := m) S).stalkMap x).hom
        (actualWholeSheafStalkIdeal
          (GermIdeal.pullback (m := m) ι (vanishingIdeal (n := n') C')) x.val)) :
    ∃ (A' : Fin n' → Fin n → O → ℂ) (A : Fin n → Fin n' → O → ℂ),
      (∀ t s, s.1 < k → A' t s = 0) ∧ (∀ s t, t.1 < k' → A s t = 0) ∧
      (∀ t s, HolomorphicAt m (A' t s) x.val) ∧ (∀ s t, HolomorphicAt m (A s t) x.val) ∧
      (∀ᶠ z in 𝓝 x.val, z ∈ S → ∀ t : Fin n', k' ≤ t.1 →
        flatCoord Φ' t (ι z) = ∑ s, A' t s z * flatCoord Φ s (G z)) ∧
      (∀ᶠ z in 𝓝 x.val, z ∈ S → ∀ s : Fin n, k ≤ s.1 →
        flatCoord Φ s (G z) = ∑ t, A s t z * flatCoord Φ' t (ι z)) := by
  classical
  rw [actualRestrictedPulledCentreIdeal_eq_span_normal_coordinates hC hG hΦsrc hflat S x hGx,
    actualRestrictedPulledCentreIdeal_eq_span_normal_coordinates hC' hι hΦ'src hflat' S x hιx]
    at heq
  have hGs : ∀ i : {s : Fin n // k ≤ s.val}, HolomorphicAt m (flatCoord Φ i.val ∘ G) x.val :=
    fun i => (holomorphicAt_flatCoord Φ i.val hGx).comp_contMDiff
      (Eventually.of_forall fun z => hG z)
  have hιt : ∀ i : {t : Fin n' // k' ≤ t.val}, HolomorphicAt m (flatCoord Φ' i.val ∘ ι) x.val :=
    fun i => (holomorphicAt_flatCoord Φ' i.val hιx).comp_contMDiff
      (Eventually.of_forall fun z => hι z)
  have h1 : ∀ t : {t : Fin n' // k' ≤ t.val}, ∃ a : {s : Fin n // k ≤ s.val} → O → ℂ,
      (∀ i, HolomorphicAt m (a i) x.val) ∧ ∀ᶠ z in 𝓝 x.val, z ∈ S →
        (flatCoord Φ' t.val ∘ ι) z = ∑ i, a i z * (flatCoord Φ i.val ∘ G) z := by
    intro t
    refine exists_relation_of_mem_span S x _ (hιt t) _ hGs ?_
    rw [heq]
    exact Ideal.subset_span ⟨t, rfl⟩
  have h2 : ∀ s : {s : Fin n // k ≤ s.val}, ∃ a : {t : Fin n' // k' ≤ t.val} → O → ℂ,
      (∀ i, HolomorphicAt m (a i) x.val) ∧ ∀ᶠ z in 𝓝 x.val, z ∈ S →
        (flatCoord Φ s.val ∘ G) z = ∑ i, a i z * (flatCoord Φ' i.val ∘ ι) z := by
    intro s
    refine exists_relation_of_mem_span S x _ (hGs s) _ hιt ?_
    rw [← heq]
    exact Ideal.subset_span ⟨s, rfl⟩
  choose a ha hrel1 using h1
  choose b hb hrel2 using h2
  refine ⟨fun t s => if ht : k' ≤ t.1 then (if hs : k ≤ s.1 then a ⟨t, ht⟩ ⟨s, hs⟩ else 0) else 0,
    fun s t => if hs : k ≤ s.1 then (if ht : k' ≤ t.1 then b ⟨s, hs⟩ ⟨t, ht⟩ else 0) else 0,
    ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro t s hs
    dsimp only
    split_ifs with h1 h2
    · omega
    · rfl
    · rfl
  · intro s t ht
    dsimp only
    split_ifs with h1 h2
    · omega
    · rfl
    · rfl
  · intro t s
    dsimp only
    split_ifs
    · exact ha _ _
    · exact holomorphicAt_const 0
    · exact holomorphicAt_const 0
  · intro s t
    dsimp only
    split_ifs
    · exact hb _ _
    · exact holomorphicAt_const 0
    · exact holomorphicAt_const 0
  · have hall : ∀ᶠ z in 𝓝 x.val, ∀ t : {t : Fin n' // k' ≤ t.val}, z ∈ S →
        (flatCoord Φ' t.val ∘ ι) z = ∑ i, a t i z * (flatCoord Φ i.val ∘ G) z :=
      eventually_all.2 fun t => hrel1 t
    filter_upwards [hall] with z hz hzS t ht
    have e := hz ⟨t, ht⟩ hzS
    simp only [Function.comp_apply] at e
    rw [e]
    have := sum_dite_normal k (fun i => a ⟨t, ht⟩ i z) (fun s => flatCoord Φ s (G z))
    rw [← this]
    refine Finset.sum_congr rfl fun s _ => ?_
    rw [dif_pos ht]
    split_ifs <;> simp
  · have hall : ∀ᶠ z in 𝓝 x.val, ∀ s : {s : Fin n // k ≤ s.val}, z ∈ S →
        (flatCoord Φ s.val ∘ G) z = ∑ i, b s i z * (flatCoord Φ' i.val ∘ ι) z :=
      eventually_all.2 fun s => hrel2 s
    filter_upwards [hall] with z hz hzS s hs
    have e := hz ⟨s, hs⟩ hzS
    simp only [Function.comp_apply] at e
    rw [e]
    have := sum_dite_normal k' (fun i => b ⟨s, hs⟩ i z) (fun t => flatCoord Φ' t (ι z))
    rw [← this]
    refine Finset.sum_congr rfl fun t _ => ?_
    rw [dif_pos hs]
    split_ifs <;> simp

end Relations


section Pair

open HironakaG10ChowBlowupDirection BlowupStrictSubmanifold

variable {n n' : ℕ} {M M' O Z Z' : Type} [TopologicalSpace M] [ChartedSpace (ComplexModel n) M]
  [IsComplexManifold n M] [TopologicalSpace M'] [ChartedSpace (ComplexModel n') M']
  [IsComplexManifold n' M'] [TopologicalSpace O] [ChartedSpace (ComplexModel n') O]
  [IsComplexManifold n' O] [TopologicalSpace Z] [ChartedSpace (ComplexModel n) Z]
  [IsComplexManifold n Z] [TopologicalSpace Z'] [ChartedSpace (ComplexModel n') Z']
  [IsComplexManifold n' Z']
  {C : Set M} {π : Z → M} {C' W' : Set M'} {π' : Z' → M'} {G : O → M} {ι : O → M'}

/-- **Pair-injectivity on charts, from the native ideal dictionary.**  Let `π' : Z' → M'` and
`π : Z → M` be blowups along `C'` and `C`, let `W' ⊆ M'` be closed, let `ι : O → M'` be a
holomorphic open embedding and `G : O → M` holomorphic, with `ι z₀ ∈ C'`, `G z₀ ∈ C`, and suppose
that the ideals of `C` and of `C'` pulled back along `G` and `ι` have the same image in the actual
stalk of `ι⁻¹ W'` at `z₀`.  Let `Q : closure (π'⁻¹ (W' ∖ C')) → Z` be continuous at `a` and `c`,
with `π (Q z) = G o` whenever `ι o = π' z` (for `z` near `a` and near `c`).  If
`π' a = π' c = ι z₀` and `Q a = Q c`, then `a = c`. -/
theorem eq_of_pair_of_ideal_eq (hπ : IsBlowupAlong n C π) (hπ' : IsBlowupAlong n' C' π')
    (hW' : IsClosed W')
    (hG : ContMDiff 𝓘(ℂ, ComplexModel n') 𝓘(ℂ, ComplexModel n) ∞ G)
    (hι : ContMDiff 𝓘(ℂ, ComplexModel n') 𝓘(ℂ, ComplexModel n') ∞ ι)
    (hιe : Topology.IsOpenEmbedding ι) (z₀ : ι ⁻¹' W') (hz₀C' : ι z₀.val ∈ C')
    (hz₀C : G z₀.val ∈ C)
    (heq : Ideal.map ((actualSubspaceInclusion (n := n') (ι ⁻¹' W')).stalkMap z₀).hom
        (actualWholeSheafStalkIdeal
          (GermIdeal.pullback (m := n') G (vanishingIdeal (n := n) C)) z₀.val) =
      Ideal.map ((actualSubspaceInclusion (n := n') (ι ⁻¹' W')).stalkMap z₀).hom
        (actualWholeSheafStalkIdeal
          (GermIdeal.pullback (m := n') ι (vanishingIdeal (n := n') C')) z₀.val))
    (Q : geoStrictTransform π' C' W' → Z) (a c : geoStrictTransform π' C' W')
    (ha : π' a.val = ι z₀.val) (hc : π' c.val = ι z₀.val) (hQ : Q a = Q c)
    (hQa : ContinuousAt Q a) (hQc : ContinuousAt Q c)
    (hGa : ∀ᶠ z in 𝓝 a, ∀ o : O, ι o = π' z.val → π (Q z) = G o)
    (hGc : ∀ᶠ z in 𝓝 c, ∀ o : O, ι o = π' z.val → π (Q z) = G o) :
    a = c := by
  classical
  obtain ⟨k, -, -, Φ, hΦsrc, -, hflat⟩ := hπ.1.2 (G z₀.val) hz₀C
  obtain ⟨k', -, -, Φ', hΦ'src, -, hflat'⟩ := hπ'.1.2 (ι z₀.val) hz₀C'
  obtain ⟨A', A, hA'0, hA0, hA'h, hAh, hrel', hrel⟩ :=
    exists_relations_of_ideal_eq hπ.1 hπ'.1 hG hι hΦsrc hflat hΦ'src hflat' (ι ⁻¹' W') z₀
      (mem_flatDomain_self Φ) (mem_flatDomain_self Φ') heq
  have : Nonempty O := ⟨z₀.val⟩
  set inv : M' → O := Function.invFun ι with hinv_def
  have hinvι : ∀ o, inv (ι o) = o := fun o => Function.leftInverse_invFun hιe.injective o
  have hcont : ∀ f : O → ℂ, ContinuousAt f z₀.val → ContinuousAt (f ∘ inv) (ι z₀.val) := by
    intro f hf
    rw [← hιe.continuousAt_iff]
    have : (f ∘ inv) ∘ ι = f := funext fun o => by simp [hinvι]
    rw [this]
    exact hf
  have hev : ∀ (P : M' → Prop), (∀ᶠ z in 𝓝 z₀.val, P (ι z)) → ∀ᶠ w in 𝓝 (ι z₀.val), P w := by
    intro P hP
    rw [← hιe.map_nhds_eq]
    exact hP
  have hrel'' : ∀ᶠ w in 𝓝 (ι z₀.val), w ∈ W' → ∀ t : Fin n', k' ≤ t.1 →
      flatCoord Φ' t w = ∑ s, (A' t s ∘ inv) w * flatCoord Φ s ((G ∘ inv) w) := by
    refine hev _ ?_
    filter_upwards [hrel'] with z hz hzW t ht
    simp only [Function.comp_apply, hinvι]
    exact hz hzW t ht
  have hrel2 : ∀ᶠ w in 𝓝 (ι z₀.val), w ∈ W' → ∀ s : Fin n, k ≤ s.1 →
      flatCoord Φ s ((G ∘ inv) w) = ∑ t, (A s t ∘ inv) w * flatCoord Φ' t w := by
    refine hev _ ?_
    filter_upwards [hrel] with z hz hzW s hs
    simp only [Function.comp_apply, hinvι]
    exact hz hzW s hs
  have hrange : ∀ b : geoStrictTransform π' C' W', π' b.val = ι z₀.val →
      ∀ᶠ z in 𝓝 b, π' z.val ∈ range ι := by
    intro b hb
    have hπval : Tendsto (fun z : geoStrictTransform π' C' W' => π' z.val) (𝓝 b) (𝓝 (ι z₀.val)) := by
      have := (hπ'.contMDiff.continuous.continuousAt (x := b.val)).tendsto.comp
        (continuous_subtype_val.continuousAt (x := b))
      rwa [hb] at this
    exact hπval.eventually (hιe.isOpen_range.mem_nhds (mem_range_self _))
  have hφ : ∀ b : geoStrictTransform π' C' W', π' b.val = ι z₀.val →
      (∀ᶠ z in 𝓝 b, ∀ o : O, ι o = π' z.val → π (Q z) = G o) →
      ∀ᶠ z in 𝓝 b, π (Q z) = (G ∘ inv) (π' z.val) := by
    intro b hb hGb
    filter_upwards [hGb, hrange b hb] with z hz hzr
    exact hz _ (Function.invFun_eq hzr)
  have hQflat : π (Q a) ∈ flatDomain Φ := by
    rw [hGa.self_of_nhds z₀.val ha.symm]
    exact mem_flatDomain_self Φ
  exact eq_of_pair_value_core hπ hπ' hW' hΦsrc hflat hΦ'src hflat' Q (G ∘ inv)
    (fun t s => A' t s ∘ inv) (fun s t => A s t ∘ inv)
    (fun t s hs => by rw [hA'0 t s hs]; rfl) (fun s t ht => by rw [hA0 s t ht]; rfl)
    (fun t s => hcont _ (hA'h t s).continuousAt) (fun s t => hcont _ (hAh s t).continuousAt)
    hrel'' hrel2 a c ha hc hQ hQflat hQa hQc (hφ a ha hGa) (hφ c hc hGc)

end Pair

end

end Hironaka.HironakaG10ChowPairRelations
