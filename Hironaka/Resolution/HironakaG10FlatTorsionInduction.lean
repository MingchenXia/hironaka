import Hironaka.Resolution.HironakaG10FlatTorsionFiltration

/-! # The dévissage of Douady's §7 Th. 1: torsion pieces, extensions and the flat quotient

Douady 1966, §7 n° 4, proof of Th. 1, as an abstract induction principle. Let `X` have Oka's property,
`φ` be holomorphic at `y`, and `G` be a property of matrices (presentations `coker C` near `y`) such that

* (torsion) `G C` whenever `coker C` is killed by `φ` (`φ·1 = C W` near `y`);
* (extension) `G A` whenever `G C'` and `G [A | T]`, where `C'` presents the subsheaf generated by `T`
  (`A Q = T C'`, `{v | T v ∈ im A} = im C'`: the data of `HironakaG10FlatExtensionStep.extension_step`).

Then **`powTorsion`**: `G C` whenever `coker C` is killed by a power `φ^n` (induction on `n`: the
kernel of `φ` is generated by `T₁` and killed by `φ`, the quotient `coker [C | T₁]` by `φ^{n-1}`).
If moreover the germs are Noetherian and (flat) `G A` whenever `φ` is regular on `coker A`, then
**`of_noetherian`**: `G A` for EVERY `A` holomorphic at `y` (`𝓕_tors` killed by `φ^{j₀}` and
`𝓕/𝓕_tors` with `φ` regular, `HironakaG10FlatTorsionFiltration`).

`IsKilledBy C f y`: `f·1 = C W` near `y` for some `W` holomorphic at `y` (`f` kills `coker C`).
BP: hironaka-g10-flat-torsion-induction.tex. -/
set_option autoImplicit false
open Set Filter
open scoped Topology
namespace Hironaka.HironakaG10FlatTorsionInduction
noncomputable section
open OkaRelationSheaf HironakaG10FlatResolutionStart HironakaG10FlatSliceResolution
  HironakaG10FlatExtensionStep HironakaG10FlatSubPresentation HironakaG10FlatTorsionFiltration

variable {X : Type*} [NormedAddCommGroup X] [NormedSpace ℂ X]

/-- `f` kills `coker C` near `y`: `f·1 = C W` near `y` with `W` holomorphic at `y`. -/
def IsKilledBy {p q : ℕ} (C : Fin p → Fin q → X → ℂ) (f : X → ℂ) (y : X) : Prop :=
  ∃ W : Fin q → Fin p → X → ℂ, (∀ i k, HolAt (W i k) y) ∧
    ∀ᶠ x in 𝓝 y, ∀ i k, ∑ l, C i l x * W l k x = if i = k then f x else 0

/-- If `f` kills `coker C`, so does `g f` for `g` holomorphic at `y`. -/
theorem IsKilledBy.mul {p q : ℕ} {C : Fin p → Fin q → X → ℂ} {f g : X → ℂ} {y : X}
    (h : IsKilledBy C f y) (hg : HolAt g y) : IsKilledBy C (fun x => g x * f x) y := by
  obtain ⟨W, hW, hCW⟩ := h
  refine ⟨fun l k x => g x * W l k x, fun l k => hg.mul (hW l k), ?_⟩
  filter_upwards [hCW] with x hx i k
  have : ∑ l, C i l x * (g x * W l k x) = g x * ∑ l, C i l x * W l k x := by
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl fun l _ => by ring
  rw [this, hx i k]
  split_ifs <;> simp

/-- The diagonal matrix `f·1`. -/
def diagMat (a : ℕ) (f : X → ℂ) : Fin a → Fin a → X → ℂ := fun i j x => if i = j then f x else 0

theorem holAt_diagMat {a : ℕ} {f : X → ℂ} {y : X} (hf : HolAt f y) (i j : Fin a) :
    HolAt (diagMat a f i j) y := by
  unfold diagMat
  rcases eq_or_ne i j with rfl | h
  · simpa using hf
  · simpa [h] using holAt_const (0 : ℂ) y

omit [NormedAddCommGroup X] [NormedSpace ℂ X] in
theorem diagMat_mul {a : ℕ} (f : X → ℂ) (v : Fin a → X → ℂ) (i : Fin a) (x : X) :
    ∑ l, diagMat a f i l x * v l x = f x * v i x := by
  simp [diagMat]

section Induction
variable (G : (a b : ℕ) → (Fin a → Fin b → X → ℂ) → Prop) {φ : X → ℂ} {y : X}

/-- The extension property of `G` (hypothesis shape of the induction). -/
def ExtensionClosed : Prop :=
  ∀ (a b t c : ℕ) (A : Fin a → Fin b → X → ℂ) (T : Fin a → Fin t → X → ℂ)
    (C' : Fin t → Fin c → X → ℂ) (Q : Fin b → Fin c → X → ℂ),
    (∀ i j, HolAt (A i j) y) → (∀ i j, HolAt (T i j) y) → (∀ i j, HolAt (C' i j) y) →
    (∀ i j, HolAt (Q i j) y) →
    (∀ᶠ x in 𝓝 y, ∀ i j, ∑ l, A i l x * Q l j x = ∑ l, T i l x * C' l j x) →
    (∀ v : Fin t → X → ℂ, (∀ j, HolAt (v j) y) →
      IsCombinationAt (columns A) y (fun i x => ∑ l, T i l x * v l x) →
      IsCombinationAt (columns C') y v) →
    G t c C' → G a (b + t) (catCols A T) → G a b A

/-- **Sheaves killed by a power of `φ`** (Douady §7 n° 4, dévissage of the torsion). -/
theorem powTorsion (hX : OkaProperty X) (hφ : HolAt φ y)
    (h1 : ∀ (a b : ℕ) (C : Fin a → Fin b → X → ℂ), (∀ i j, HolAt (C i j) y) → IsKilledBy C φ y →
      G a b C)
    (hext : ExtensionClosed G (y := y)) :
    ∀ (n a b : ℕ) (C : Fin a → Fin b → X → ℂ), (∀ i j, HolAt (C i j) y) →
      IsKilledBy C (fun x => φ x ^ n) y → G a b C := by
  -- the statement for exponents `n + 1`
  have key : ∀ (n a b : ℕ) (C : Fin a → Fin b → X → ℂ), (∀ i j, HolAt (C i j) y) →
      IsKilledBy C (fun x => φ x ^ (n + 1)) y → G a b C := by
    intro n
    induction n with
    | zero =>
      intro a b C hC hk
      refine h1 a b C hC ?_
      simpa using hk
    | succ n ih =>
      intro a b C hC hk
      -- `T₁`: generators of `ker (φ on coker C)`
      obtain ⟨c₁, T₁, Q₁, hT₁, hQ₁h, hQ₁, hgen₁⟩ :=
        exists_subPresentation hX (T := diagMat a φ) hC (holAt_diagMat hφ)
      -- `C'`: presentation of the subsheaf generated by `T₁`
      obtain ⟨c', C', Q', hC', hQ'h, hQ', hgen'⟩ := exists_subPresentation hX hC hT₁
      -- `coker C'` is killed by `φ`
      have hT₁k : ∀ k, IsCombinationAt (columns C) y (fun i x => φ x ^ 1 * T₁ i k x) := by
        intro k
        refine ⟨fun l => Q₁ l k, fun l => hQ₁h l k, fun i => ?_⟩
        filter_upwards [hQ₁] with x hx
        rw [pow_one, ← diagMat_mul φ (fun l x => T₁ l k x) i x, ← hx i k]
        exact Finset.sum_congr rfl fun l _ => mul_comm _ _
      have hk' : IsKilledBy C' φ y := by
        obtain ⟨W, hW, hCW⟩ := exists_pow_kill hφ hT₁k hgen'
        exact ⟨W, hW, by simpa using hCW⟩
      -- `coker [C | T₁]` is killed by `φ^(n+1)`
      obtain ⟨W, hW, hCW⟩ := hk
      have hcomb : ∀ k, IsCombinationAt (columns (catCols C T₁)) y
          (fun i x => if i = k then φ x ^ (n + 1) else 0) := by
        intro k
        refine isCombinationAt_catCols_right C (hgen₁ _ (fun j => ?_) ?_)
        · rcases eq_or_ne j k with rfl | h
          · simpa using holAt_pow hφ (n + 1)
          · simpa [h] using holAt_const (0 : ℂ) y
        · refine ⟨fun l => W l k, fun l => hW l k, fun i => ?_⟩
          filter_upwards [hCW] with x hx
          rw [diagMat_mul φ (fun l x => if l = k then φ x ^ (n + 1) else 0) i x]
          simp only [columns]
          rw [Finset.sum_congr rfl fun l _ => mul_comm (W l k x) (C i l x), hx i k]
          split_ifs <;> ring
      obtain ⟨W'', hW'', hCW''⟩ := exists_matrix_of_isCombinationAt hcomb
      have hG'' := ih a (b + c₁) (catCols C T₁) (holAt_catCols hC hT₁) ⟨W'', hW'', hCW''⟩
      exact hext a b c₁ c' C T₁ C' Q' hC hT₁ hC' hQ'h hQ' hgen' (h1 _ _ C' hC' hk') hG''
  intro n a b C hC hk
  rcases n with _ | n
  · refine key 0 a b C hC ?_
    simpa using hk.mul hφ
  · exact key n a b C hC hk

/-- **Every presentation** (Douady §7 n° 4): with Noetherian germs, `G` holds for every matrix
holomorphic at `y` as soon as it holds for torsion pieces (`φ` kills), for flat ones (`φ` regular) and
is closed under extensions. -/
theorem of_noetherian [IsNoetherianRing (HolGerm X)] (hX : OkaProperty X) (hφ : HolAt φ y)
    (h1 : ∀ (a b : ℕ) (C : Fin a → Fin b → X → ℂ), (∀ i j, HolAt (C i j) y) → IsKilledBy C φ y →
      G a b C)
    (hflat : ∀ (a b : ℕ) (A : Fin a → Fin b → X → ℂ), (∀ i j, HolAt (A i j) y) → RegularAt A φ y →
      G a b A)
    (hext : ExtensionClosed G (y := y)) (a b : ℕ) (A : Fin a → Fin b → X → ℂ)
    (hA : ∀ i j, HolAt (A i j) y) : G a b A := by
  obtain ⟨t, j₀, T, hT, hTk, hreg⟩ := exists_torsionFiltration hA hφ
  obtain ⟨c, C', Q, hC', hQh, hQ, hgen⟩ := exists_subPresentation hX hA hT
  obtain ⟨W, hW, hCW⟩ := exists_pow_kill hφ hTk hgen
  exact hext a b t c A T C' Q hA hT hC' hQh hQ hgen
    (powTorsion G hX hφ h1 hext j₀ t c C' hC' ⟨W, hW, hCW⟩)
    (hflat a (b + t) (catCols A T) (holAt_catCols hA hT) hreg)

end Induction

end
end Hironaka.HironakaG10FlatTorsionInduction
