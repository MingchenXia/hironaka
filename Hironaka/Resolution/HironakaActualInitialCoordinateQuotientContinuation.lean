/-!
# The entire homogeneous initial ideal after a regular coordinate

The ideal is generated by the genuine lowest forms of all original members.
Strict division controls those members after one coordinate is imposed.
-/

set_option autoImplicit false
open Set Classical

namespace Hironaka.HironakaActualInitialCoordinateQuotient

noncomputable section

open HironakaRelativeNormalMonomialBasis HironakaActualOriginalFormalHSTransfer
  HironakaActualHomogeneousInitialHS HironakaActualHomogeneousInitialTangentDerivatives
  HironakaStrictFilteredRegularElement HironakaActualCoordinateSymbolRegularity

variable {n : ℕ}

/-- Inclusion of entire original ideals preserves their actual homogeneous initial ideals. -/
theorem actualHomogeneousInitialIdeal_mono
    {K L : Ideal (MvPowerSeries (Fin n) ℂ)} (hKL : K ≤ L) :
    actualHomogeneousInitialIdeal K ≤ actualHomogeneousInitialIdeal L := by
  apply Ideal.span_le.mpr
  rintro _ ⟨F, rfl⟩
  exact Ideal.subset_span ⟨⟨F.val, hKL F.property.1, F.property.2⟩, rfl⟩

private theorem X_homogeneous (i : Fin n) :
    (MvPowerSeries.X i : MvPowerSeries (Fin n) ℂ).IsHomogeneous 1 := by
  apply MvPowerSeries.isHomogeneous_iff_eq_homogeneousComponent.mpr
  apply MvPowerSeries.ext
  intro a
  by_cases ha : a = Finsupp.single i 1
  · subst a
    simp [MvPowerSeries.coeff_homogeneousComponent, MvPowerSeries.coeff_X,
      Finsupp.degree_eq_weight_one, Finsupp.weight_single]
  · simp [MvPowerSeries.coeff_homogeneousComponent, MvPowerSeries.coeff_X, ha]

private theorem X_mem_initial {K : Ideal (MvPowerSeries (Fin n) ℂ)}
    (i : Fin n) (hi : (MvPowerSeries.X i : MvPowerSeries (Fin n) ℂ) ∈ K) :
    (MvPowerSeries.X i : MvPowerSeries (Fin n) ℂ) ∈ actualHomogeneousInitialIdeal K := by
  have hpow : (MvPowerSeries.X i : MvPowerSeries (Fin n) ℂ) ∈
      genuineFormalVariables n ^ 1 := by
    rw [pow_one]
    exact Ideal.subset_span ⟨i, rfl⟩
  have hc := homogeneousComponent_mem_actual_initial_of_mem_power K 1 _ hi hpow
  rwa [← MvPowerSeries.isHomogeneous_iff_eq_homogeneousComponent.mp (X_homogeneous i)] at hc

/-- A regular coordinate gives the exact entire initial ideal after imposing it. -/
theorem actualHomogeneousInitialIdeal_sup_coordinate
    (K : Ideal (MvPowerSeries (Fin n) ℂ)) (i : Fin n)
    (hreg : ∀ q : ℕ, ∀ B ∈ genuineFormalVariables n ^ q,
      MvPowerSeries.X i * B ∈ K ⊔ genuineFormalVariables n ^ (q + 2) →
      B ∈ K ⊔ genuineFormalVariables n ^ (q + 1)) :
    actualHomogeneousInitialIdeal (K ⊔ Ideal.span {MvPowerSeries.X i}) =
      actualHomogeneousInitialIdeal K ⊔ Ideal.span {MvPowerSeries.X i} := by
  have hX : (MvPowerSeries.X i : MvPowerSeries (Fin n) ℂ) ∈ genuineFormalVariables n :=
    Ideal.subset_span ⟨i, rfl⟩
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro _ ⟨G, rfl⟩
    obtain ⟨F, hFK, Z, hZ, he⟩ := Submodule.mem_sup.mp G.property.1
    obtain ⟨B, rfl⟩ := Ideal.mem_span_singleton.mp hZ
    have hGpow : G.val ∈ genuineFormalVariables n ^
        actualHomogeneousInitialDegree G.val G.property.2 := by
      apply (mem_genuineFormalVariables_pow_iff_coefficients_zero n _ _).mpr
      intro a ha
      apply MvPowerSeries.coeff_of_lt_order
      rw [← actualHomogeneousInitialDegree_eq_order G.val G.property.2]
      have hdegree : Finsupp.degree a < actualHomogeneousInitialDegree G.val G.property.2 := by
        simpa only [normalExponentDegree, ← Finsupp.degree_eq_sum] using ha
      exact_mod_cast hdegree
    change MvPowerSeries.homogeneousComponent
      (actualHomogeneousInitialDegree G.val G.property.2) G.val ∈ _
    cases hr : actualHomogeneousInitialDegree G.val G.property.2 with
    | zero =>
      have hc : MvPowerSeries.homogeneousComponent 0 (MvPowerSeries.X i * B) = 0 := by
        rw [mul_comm]
        exact homogeneousComponent_mul_homogeneous_of_lt 0 1 B _ (X_homogeneous i) (by omega)
      rw [← he, map_add, hc, add_zero]
      exact Ideal.mem_sup_left
        (homogeneousComponent_mem_actual_initial_of_mem_power K 0 F hFK (by simp))
    | succ q =>
      rw [hr] at hGpow
      have hXB : MvPowerSeries.X i * B ∈ K ⊔ genuineFormalVariables n ^ (q + 1) := by
        have hsub : MvPowerSeries.X i * B = G.val - F := by rw [← he]; abel
        rw [hsub]
        exact (K ⊔ genuineFormalVariables n ^ (q + 1)).sub_mem
          (Ideal.mem_sup_right hGpow) (Ideal.mem_sup_left hFK)
      obtain ⟨H, hHK, D, hD, hBD⟩ := Submodule.mem_sup.mp
        ((mem_successor_iff_mem_current_of_regular_symbol K (genuineFormalVariables n)
          (MvPowerSeries.X i) hX hreg q B).mp hXB)
      have hXD : MvPowerSeries.X i * D ∈ genuineFormalVariables n ^ (q + 1) := by
        rw [pow_succ']
        exact Ideal.mul_mem_mul hX hD
      have hrep : (F + MvPowerSeries.X i * H) + MvPowerSeries.X i * D = G.val := by
        rw [← he, ← hBD, mul_add, add_assoc]
      have hF'K : F + MvPowerSeries.X i * H ∈ K :=
        K.add_mem hFK (K.mul_mem_left _ hHK)
      have hF'pow : F + MvPowerSeries.X i * H ∈ genuineFormalVariables n ^ (q + 1) := by
        have hsub : F + MvPowerSeries.X i * H = G.val - MvPowerSeries.X i * D := by
          rw [← hrep]; abel
        rw [hsub]
        exact (genuineFormalVariables n ^ (q + 1)).sub_mem hGpow hXD
      have hcomp : MvPowerSeries.homogeneousComponent (q + 1) (MvPowerSeries.X i * D) =
          MvPowerSeries.X i * MvPowerSeries.homogeneousComponent q D := by
        rw [mul_comm, homogeneousComponent_mul_homogeneous_of_le (q + 1) 1 D _
          (X_homogeneous i) (by omega), Nat.add_sub_cancel, mul_comm]
      rw [← hrep, map_add, hcomp]
      exact (actualHomogeneousInitialIdeal K ⊔ Ideal.span {MvPowerSeries.X i}).add_mem
        (Ideal.mem_sup_left
          (homogeneousComponent_mem_actual_initial_of_mem_power K (q + 1) _ hF'K hF'pow))
        (Ideal.mem_sup_right (Ideal.mem_span_singleton.mpr ⟨_, rfl⟩))
  · apply sup_le
    · exact actualHomogeneousInitialIdeal_mono le_sup_left
    · apply Ideal.span_le.mpr
      intro Z hZ
      obtain rfl := Set.mem_singleton_iff.mp hZ
      exact X_mem_initial i (Ideal.mem_sup_right (Ideal.mem_span_singleton_self _))

/-- The exact initial-ideal equality is produced by differential stability. -/
theorem actualHomogeneousInitialIdeal_sup_coordinate_of_pderiv
    (K : Ideal (MvPowerSeries (Fin n) ℂ)) (i : Fin n)
    (hD : ∀ P : MvPolynomial (Fin n) ℂ,
      (P : MvPowerSeries (Fin n) ℂ) ∈ actualHomogeneousInitialIdeal K →
      (MvPolynomial.pderiv i P : MvPowerSeries (Fin n) ℂ) ∈ actualHomogeneousInitialIdeal K) :
    actualHomogeneousInitialIdeal (K ⊔ Ideal.span {MvPowerSeries.X i}) =
      actualHomogeneousInitialIdeal K ⊔ Ideal.span {MvPowerSeries.X i} :=
  actualHomogeneousInitialIdeal_sup_coordinate K i
    (formal_regular_symbol_of_initial_pderiv K i hD)

/-- Imposing other coordinates preserves an entire ideal's derivative stability. -/
theorem pderiv_stable_sup_coordinates (J : Ideal (MvPowerSeries (Fin n) ℂ))
    (i : Fin n) (T : Set (Fin n)) (hi : i ∉ T)
    (hJ : ∀ F ∈ J, MvPowerSeries.pderiv ℂ i F ∈ J) :
    ∀ F ∈ J ⊔ Ideal.span (MvPowerSeries.X '' T),
      MvPowerSeries.pderiv ℂ i F ∈ J ⊔ Ideal.span (MvPowerSeries.X '' T) := by
  intro F hF
  obtain ⟨A, hA, B, hB, he⟩ := Submodule.mem_sup.mp hF
  have hDB : MvPowerSeries.pderiv ℂ i B ∈ Ideal.span (MvPowerSeries.X '' T) := by
    clear he
    induction hB using Submodule.span_induction with
    | mem G hG =>
      obtain ⟨j, hj, rfl⟩ := hG
      have hji : j ≠ i := fun h => hi (h ▸ hj)
      rw [MvPowerSeries.pderiv_X_of_ne hji]
      exact Ideal.zero_mem _
    | zero => simpa only [map_zero] using (Ideal.span (MvPowerSeries.X '' T)).zero_mem
    | add G H _ _ hG hH => simpa only [map_add] using
        (Ideal.span (MvPowerSeries.X '' T)).add_mem hG hH
    | smul A G hG ih =>
      change MvPowerSeries.pderiv ℂ i (A * G) ∈ _
      rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul]
      exact (Ideal.span (MvPowerSeries.X '' T)).add_mem
        (Ideal.mul_mem_left _ _ ih) (Ideal.mul_mem_right _ _ hG)
  rw [← he, map_add]
  exact (J ⊔ Ideal.span (MvPowerSeries.X '' T)).add_mem
    (Ideal.mem_sup_left (hJ A hA)) (Ideal.mem_sup_right hDB)

/-- The whole initial-ideal equality persists after any finite set of stable coordinates. -/
theorem actualHomogeneousInitialIdeal_sup_coordinates
    (K : Ideal (MvPowerSeries (Fin n) ℂ)) (T : Finset (Fin n))
    (hD : ∀ i ∈ T, ∀ F ∈ actualHomogeneousInitialIdeal K,
      MvPowerSeries.pderiv ℂ i F ∈ actualHomogeneousInitialIdeal K) :
    actualHomogeneousInitialIdeal (K ⊔ Ideal.span (MvPowerSeries.X '' (T : Set (Fin n)))) =
      actualHomogeneousInitialIdeal K ⊔ Ideal.span (MvPowerSeries.X '' (T : Set (Fin n))) := by
  induction T using Finset.induction_on with
  | empty => simp
  | @insert i T hi ih =>
    have hDT : ∀ j ∈ T, ∀ F ∈ actualHomogeneousInitialIdeal K,
        MvPowerSeries.pderiv ℂ j F ∈ actualHomogeneousInitialIdeal K := by
      intro j hj F hF
      exact hD j (Finset.mem_insert_of_mem hj) F hF
    have hCut : actualHomogeneousInitialIdeal
        (K ⊔ Ideal.span (MvPowerSeries.X '' (T : Set (Fin n)))) =
        actualHomogeneousInitialIdeal K ⊔ Ideal.span (MvPowerSeries.X '' (T : Set (Fin n))) :=
      ih hDT
    have hStable : ∀ F ∈ actualHomogeneousInitialIdeal
        (K ⊔ Ideal.span (MvPowerSeries.X '' (T : Set (Fin n)))),
        MvPowerSeries.pderiv ℂ i F ∈ actualHomogeneousInitialIdeal
          (K ⊔ Ideal.span (MvPowerSeries.X '' (T : Set (Fin n)))) := by
      rw [hCut]
      exact pderiv_stable_sup_coordinates _ i (T : Set (Fin n)) hi
        (hD i (Finset.mem_insert_self i T))
    have hPoly : ∀ P : MvPolynomial (Fin n) ℂ,
        (P : MvPowerSeries (Fin n) ℂ) ∈ actualHomogeneousInitialIdeal
          (K ⊔ Ideal.span (MvPowerSeries.X '' (T : Set (Fin n)))) →
        (MvPolynomial.pderiv i P : MvPowerSeries (Fin n) ℂ) ∈ actualHomogeneousInitialIdeal
          (K ⊔ Ideal.span (MvPowerSeries.X '' (T : Set (Fin n)))) := by
      intro P hP
      simpa only [MvPowerSeries.pderiv_coe] using hStable P hP
    have hOne := actualHomogeneousInitialIdeal_sup_coordinate_of_pderiv
      (K ⊔ Ideal.span (MvPowerSeries.X '' (T : Set (Fin n)))) i hPoly
    rw [hCut] at hOne
    simpa only [Finset.coe_insert, Set.image_insert_eq, Ideal.span_insert,
      sup_assoc, sup_comm, sup_left_comm] using hOne

/-- Every un-imposed stable coordinate remains regular on the same finite quotients. -/
theorem formal_regular_symbol_after_coordinate_cuts
    (K : Ideal (MvPowerSeries (Fin n) ℂ)) (T : Finset (Fin n)) (i : Fin n) (hi : i ∉ T)
    (hD : ∀ j ∈ insert i T, ∀ F ∈ actualHomogeneousInitialIdeal K,
      MvPowerSeries.pderiv ℂ j F ∈ actualHomogeneousInitialIdeal K)
    (q : ℕ) (B : MvPowerSeries (Fin n) ℂ)
    (hB : B ∈ genuineFormalVariables n ^ q)
    (hXB : MvPowerSeries.X i * B ∈
      (K ⊔ Ideal.span (MvPowerSeries.X '' (T : Set (Fin n)))) ⊔
        genuineFormalVariables n ^ (q + 2)) :
    B ∈ (K ⊔ Ideal.span (MvPowerSeries.X '' (T : Set (Fin n)))) ⊔
      genuineFormalVariables n ^ (q + 1) := by
  have hCut := actualHomogeneousInitialIdeal_sup_coordinates K T
    (fun j hj => hD j (Finset.mem_insert_of_mem hj))
  apply formal_regular_symbol_of_initial_pderiv _ i ?_ q B hB hXB
  intro P hP
  rw [hCut] at hP ⊢
  have h := pderiv_stable_sup_coordinates (actualHomogeneousInitialIdeal K) i
    (T : Set (Fin n)) hi (hD i (Finset.mem_insert_self i T)) P hP
  simpa only [MvPowerSeries.pderiv_coe] using h

