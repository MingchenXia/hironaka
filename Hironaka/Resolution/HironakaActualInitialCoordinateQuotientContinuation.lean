/-- The entire original ideal with a finite set of original coordinate germs imposed. -/
def originalCoordinateCutIdeal (n : ℕ) (I : Ideal (HolGerm (ComplexModel n)))
    (T : Finset (Fin n)) : Ideal (HolGerm (ComplexModel n)) :=
  I ⊔ Ideal.span ((fun i : Fin n => coordinateGerm i) '' (T : Set (Fin n)))

/-- Actual Taylor extension preserves the same whole coordinate cuts. -/
theorem map_originalCoordinateCutIdeal (n : ℕ) (I : Ideal (HolGerm (ComplexModel n)))
    (T : Finset (Fin n)) :
    Ideal.map (actualUnshiftedTaylorAlgHom n).toRingHom (originalCoordinateCutIdeal n I T) =
      Ideal.map (actualUnshiftedTaylorAlgHom n).toRingHom I ⊔
        Ideal.span (MvPowerSeries.X '' (T : Set (Fin n))) := by
  rw [originalCoordinateCutIdeal, Ideal.map_sup, Ideal.map_span]
  have hImage : (actualUnshiftedTaylorAlgHom n).toRingHom ''
      ((fun i : Fin n => coordinateGerm i) '' (T : Set (Fin n))) =
      MvPowerSeries.X '' (T : Set (Fin n)) := by
    rw [Set.image_image]
    congr 1
    funext i
    exact actualUnshiftedTaylor_coordinate n i
  rw [hImage]

/-- Whole differential stability produces regular symbols after the same original cuts. -/
theorem original_regular_symbol_after_coordinate_cuts (n : ℕ)
    (I : Ideal (HolGerm (ComplexModel n))) (T : Finset (Fin n)) (i : Fin n) (hi : i ∉ T)
    (hD : ∀ j ∈ insert i T, ∀ F ∈ actualHomogeneousInitialIdeal
      (Ideal.map (actualUnshiftedTaylorAlgHom n).toRingHom I),
      MvPowerSeries.pderiv ℂ j F ∈ actualHomogeneousInitialIdeal
        (Ideal.map (actualUnshiftedTaylorAlgHom n).toRingHom I))
    (q : ℕ) (b : HolGerm (ComplexModel n))
    (hb : b ∈ IsLocalRing.maximalIdeal (HolGerm (ComplexModel n)) ^ q)
    (hvb : coordinateGerm i * b ∈ originalCoordinateCutIdeal n I T ⊔
      IsLocalRing.maximalIdeal (HolGerm (ComplexModel n)) ^ (q + 2)) :
    b ∈ originalCoordinateCutIdeal n I T ⊔
      IsLocalRing.maximalIdeal (HolGerm (ComplexModel n)) ^ (q + 1) := by
  apply original_regular_symbol_of_initial_pderiv n (originalCoordinateCutIdeal n I T)
    i ?_ q b hb hvb
  intro P hP
  rw [map_originalCoordinateCutIdeal] at hP ⊢
  have hCut := actualHomogeneousInitialIdeal_sup_coordinates
    (Ideal.map (actualUnshiftedTaylorAlgHom n).toRingHom I) T
    (fun j hj => hD j (Finset.mem_insert_of_mem hj))
  rw [hCut] at hP ⊢
  have h := pderiv_stable_sup_coordinates
    (actualHomogeneousInitialIdeal (Ideal.map (actualUnshiftedTaylorAlgHom n).toRingHom I))
    i (T : Set (Fin n)) hi (hD i (Finset.mem_insert_self i T)) P hP
  simpa only [MvPowerSeries.pderiv_coe] using h

section OriginalCentre

open scoped Topology Manifold ContDiff

variable {d t : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (ComplexModel (d + t)) M] [IsComplexManifold (d + t) M]

/-- Original centre geometry supplies successive tangent symbols in any coordinate order. -/
theorem exists_original_hs_constant_centre_successive_tangent_symbols
    (C : Set M) (x : M) (hreg : RegularAtDim (n := d + t) C x d)
    (A : GermIdeal (d + t) M) (hA : A.IsCoherent)
    (hhs : ∀ y ∈ C, ∀ ℓ : ℕ, hilbertSamuelAt A y ℓ = hilbertSamuelAt A x ℓ) :
    ∃ Φ : LocalHolomorphicEquivAt (chartAt (ComplexModel (d + t)) x x),
      Φ.source ⊆ (chartAt (ComplexModel (d + t)) x).target ∧
      Φ.toFun (chartAt (ComplexModel (d + t)) x x) = 0 ∧
      (∀ {y : M}, y ∈ (chartAt (ComplexModel (d + t)) x).source →
        chartAt (ComplexModel (d + t)) x y ∈ Φ.source →
        (y ∈ C ↔ Φ.toFun (chartAt (ComplexModel (d + t)) x y) ∈
          complexCoordinatePlane (d + t) d)) ∧
      let I0 := originalCoherentOriginIdeal (actualTranslatedOriginalSheaf
        (actualFlattenedOriginalSheaf A x Φ) 0)
      ∀ T : Finset (Fin (d + t)), (∀ j ∈ T, j.val < d) →
        ∀ i : Fin (d + t), i.val < d → i ∉ T →
        (∀ q : ℕ, ∀ b ∈ IsLocalRing.maximalIdeal (HolGerm (ComplexModel (d + t))) ^ q,
          coordinateGerm i * b ∈ originalCoordinateCutIdeal (d + t) I0 T ⊔
            IsLocalRing.maximalIdeal (HolGerm (ComplexModel (d + t))) ^ (q + 2) →
          b ∈ originalCoordinateCutIdeal (d + t) I0 T ⊔
            IsLocalRing.maximalIdeal (HolGerm (ComplexModel (d + t))) ^ (q + 1)) ∧
        (∀ q : ℕ,
          hilbertSamuelValue (originalCoordinateCutIdeal (d + t) I0 T ⊔
            Ideal.span {coordinateGerm i}) (q + 1) +
            hilbertSamuelValue (originalCoordinateCutIdeal (d + t) I0 T) q =
              hilbertSamuelValue (originalCoordinateCutIdeal (d + t) I0 T) (q + 1)) ∧
        (∀ q : ℕ, hilbertSamuelValue (originalCoordinateCutIdeal (d + t) I0 T) q =
          ∑ j ∈ Finset.range (q + 1),
            hilbertSamuelValue (originalCoordinateCutIdeal (d + t) I0 T ⊔
              Ideal.span {coordinateGerm i}) j) := by
  obtain ⟨Φ, hsrc, h0, hflat, O, hO, hxO, N, G, hG, hgen, U, hU, h0U, hUT,
    hMap, hH, hhol, hI, hFormal, _hPolynomial⟩ :=
    exists_original_hs_constant_centre_initial_tangent_pderiv C x hreg A hA hhs
  refine ⟨Φ, hsrc, h0, hflat, ?_⟩
  dsimp only
  let I0 := originalCoherentOriginIdeal (actualTranslatedOriginalSheaf
    (actualFlattenedOriginalSheaf A x Φ) 0)
  intro T hT i hit hi
  have hD : ∀ j ∈ insert i T, ∀ F ∈ actualHomogeneousInitialIdeal
      (Ideal.map (actualUnshiftedTaylorAlgHom (d + t)).toRingHom I0),
      MvPowerSeries.pderiv ℂ j F ∈ actualHomogeneousInitialIdeal
        (Ideal.map (actualUnshiftedTaylorAlgHom (d + t)).toRingHom I0) := by
    intro j hj F hF
    have hjt : j.val < d := by
      rcases Finset.mem_insert.mp hj with rfl | hj
      · exact hit
      · exact hT j hj
    let k : Fin d := ⟨j.val, hjt⟩
    have he : k.castAdd t = j := Fin.ext rfl
    simpa only [he] using hFormal k F hF
  have hRegular := original_regular_symbol_after_coordinate_cuts (d + t) I0 T i hi hD
  have hv : coordinateGerm i ∈
      IsLocalRing.maximalIdeal (HolGerm (ComplexModel (d + t))) :=
    (HolGerm.mem_maximalIdeal_iff _).mpr rfl
  refine ⟨hRegular, ?_, ?_⟩
  · intro q
    exact hilbertSamuelValue_parameter_recurrence _ _ hv hRegular q
  · intro q
    exact hilbertSamuelValue_eq_sum_parameter _ _ hv hRegular q

