import Hironaka.Resolution.HironakaG10FlatSliceResolution
import Hironaka.Coherence.OkaCoherence
import Mathlib.RingTheory.Nakayama

/-! # Lifting relations of the fibre, and generation by lifts (Nakayama)

Second half of the sheaf-level input of Douady 1966, §7 Prop. 6 and §8 Prop. 1 (construction of a
resolution of a flat sheaf restricting to a given resolution of the fibre), on `ℂ × P` with the
coordinate `w`:

* `exists_lift_relation`: if `w` is regular on `coker A` at `(0, z₀)`, every relation of the fibre
  `A(0,·)` at `z₀` is the restriction of a relation of `A` at `(0, z₀)` (`Tor₁(𝓕, O/w) = 0`).
* Germ-level translation (`OkaGermBridge.germAt`): `germVec`, `relSubmodule A y` (relations of `A` in
  `HolGerm^ι₁`), `germVec_mem_relSubmodule_iff`, `germVec_mem_span_iff`, `relSubmodule_fg` (Oka).
* **`isCombinationAt_of_slice_generates`** (Nakayama): if holomorphic relations `τ_k` of `A` at
  `(0, z₀)` restrict to generators of the relations of `A(0,·)` at `z₀`, they generate the relations of
  `A` at `(0, z₀)`. (A relation `r` restricts to `∑ λ_k τ_k(0,·)`, so `r − ∑ λ_k τ_k = w r'` with `r'` a
  relation: `R ⊆ span τ + w R`; Nakayama in the local ring `HolGerm`, `R` finitely generated by Oka.)
* `okaProperty_prod_euclidean`: Oka's property for `ℂ × ℂⁿ`.
BP: hironaka-g10-flat-relation-lift.tex. -/
set_option autoImplicit false
open Set Filter
open scoped Topology Pointwise
namespace Hironaka.HironakaG10FlatRelationLift
noncomputable section
open OkaRelationSheaf OkaGermBridge HolGerm HironakaG10FlatResolutionStart
  HironakaG10FlatSliceResolution

/-! ## Lifting relations of the fibre -/

section Lift
variable {P : Type*} [NormedAddCommGroup P] [NormedSpace ℂ P]
  {ι₁ ι₀ : Type*} [Fintype ι₁] [Fintype ι₀]

omit [Fintype ι₀] in
/-- **Every relation of the fibre lifts** when `w` is regular on `coker A`. -/
theorem exists_lift_relation {A : ι₀ → ι₁ → ℂ × P → ℂ} {z₀ : P}
    (hA : ∀ i j, HolAt (A i j) ((0 : ℂ), z₀)) (hreg : RegularAt A (fun x => x.1) ((0 : ℂ), z₀))
    (b : ι₁ → P → ℂ) (hb : IsRelationAt (sliceZero A) z₀ b) :
    ∃ a : ι₁ → ℂ × P → ℂ, IsRelationAt A ((0 : ℂ), z₀) a ∧ ∀ j z, a j ((0 : ℂ), z) = b j z := by
  set y : ℂ × P := ((0 : ℂ), z₀)
  set bt : ι₁ → ℂ × P → ℂ := fun j x => b j x.2 with hbt
  have hbt_hol : ∀ j, HolAt (bt j) y := fun j =>
    (hb.1 j).comp (f := b j) continuous_snd fun x => differentiableAt_snd
  have hdiv : ∀ i, ∃ c : ℂ × P → ℂ, HolAt c y ∧
      ∀ᶠ x in 𝓝 y, ∑ j, bt j x * A i j x = x.1 * c x := fun i =>
    exists_eq_fst_mul (HolAt.fintype_sum fun j => (hbt_hol j).mul (hA i j)) rfl (hb.2 i)
  choose c hc hcA using hdiv
  obtain ⟨e, he, hce⟩ := hreg c hc ⟨bt, hbt_hol, fun i => (hcA i).mono fun x hx => hx.symm⟩
  refine ⟨fun j x => bt j x - x.1 * e j x, ⟨fun j => (hbt_hol j).sub
    ((holAt_of_differentiableOn isOpen_univ differentiableOn_fst (mem_univ y)).mul (he j)),
    fun i => ?_⟩, fun j z => by simp [hbt]⟩
  filter_upwards [(hcA i).and (hce i)] with x ⟨h1, h2⟩
  simp only [sub_mul, Finset.sum_sub_distrib]
  rw [h1, h2, Finset.mul_sum, sub_eq_zero]
  exact Finset.sum_congr rfl fun j _ => by simp only [columns]; ring

end Lift

/-! ## Germ-level translation -/

section Germ
variable {X : Type*} [NormedAddCommGroup X] [NormedSpace ℂ X]
  {ι₁ ι₀ : Type*} [Fintype ι₁] [Fintype ι₀]

/-- The vector of germs at `y`. -/
def germVec {ι : Type*} (y : X) (a : ι → X → ℂ) : ι → HolGerm X := fun j => germAt y (a j)

/-- The relations of `A` at `y`, as a submodule of `HolGerm^ι₁`. -/
def relSubmodule (A : ι₀ → ι₁ → X → ℂ) (y : X) : Submodule (HolGerm X) (ι₁ → HolGerm X) where
  carrier := {v | ∀ i, ∑ j, v j * germAt y (A i j) = 0}
  add_mem' {v v'} hv hv' i := by
    simp only [Pi.add_apply, add_mul, Finset.sum_add_distrib]
    rw [hv i, hv' i, add_zero]
  zero_mem' i := by simp
  smul_mem' c v hv i := by
    simp only [Pi.smul_apply, smul_eq_mul, mul_assoc]
    rw [← Finset.mul_sum, hv i, mul_zero]

omit [Fintype ι₀] in
theorem germAt_matrix_sum {A : ι₀ → ι₁ → X → ℂ} {y : X} (hA : ∀ i j, HolAt (A i j) y)
    {a : ι₁ → X → ℂ} (ha : ∀ j, HolAt (a j) y) (i : ι₀) :
    ∑ j, germVec y a j * germAt y (A i j) = germAt y (fun x => ∑ j, a j x * A i j x) := by
  rw [germAt_sum _ fun j _ => (ha j).mul (hA i j)]
  exact Finset.sum_congr rfl fun j _ => (germAt_mul (ha j) (hA i j)).symm

omit [Fintype ι₀] in
theorem germVec_mem_relSubmodule_iff {A : ι₀ → ι₁ → X → ℂ} {y : X} (hA : ∀ i j, HolAt (A i j) y)
    {a : ι₁ → X → ℂ} (ha : ∀ j, HolAt (a j) y) :
    germVec y a ∈ relSubmodule A y ↔ IsRelationAt A y a := by
  refine ⟨fun h => ⟨ha, fun i => ?_⟩, fun h i => ?_⟩
  · have := h i
    rw [germAt_matrix_sum hA ha, germAt_eq_zero_iff (HolAt.fintype_sum fun j => (ha j).mul (hA i j))]
      at this
    exact this
  · rw [germAt_matrix_sum hA ha, germAt_eq_zero_iff (HolAt.fintype_sum fun j => (ha j).mul (hA i j))]
    exact h.2 i

omit [Fintype ι₁] in
theorem germVec_mem_span_iff {μ : Type*} [Fintype μ] {σ : μ → ι₁ → X → ℂ} {y : X}
    (hσ : ∀ k j, HolAt (σ k j) y) {a : ι₁ → X → ℂ} (ha : ∀ j, HolAt (a j) y) :
    germVec y a ∈ Submodule.span (HolGerm X) (Set.range fun k => germVec y (σ k)) ↔
      IsCombinationAt σ y a := by
  rw [Submodule.mem_span_range_iff_exists_fun]
  constructor
  · rintro ⟨c, hc⟩
    choose c' hc' hcc' using fun k => exists_germAt_eq (c k) y
    refine ⟨c', hc', fun j => ?_⟩
    have hj := congrFun hc j
    simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, germVec] at hj
    rw [← germAt_eq_germAt_iff (ha j) (HolAt.fintype_sum fun k => (hc' k).mul (hσ k j)),
      germAt_sum _ fun k _ => (hc' k).mul (hσ k j), ← hj]
    exact Finset.sum_congr rfl fun k _ => by rw [germAt_mul (hc' k) (hσ k j), hcc']
  · rintro ⟨c, hc, hca⟩
    refine ⟨fun k => germAt y (c k), funext fun j => ?_⟩
    simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, germVec]
    rw [(germAt_eq_germAt_iff (ha j) (HolAt.fintype_sum fun k => (hc k).mul (hσ k j))).2 (hca j),
      germAt_sum _ fun k _ => (hc k).mul (hσ k j)]
    exact Finset.sum_congr rfl fun k _ => (germAt_mul (hc k) (hσ k j)).symm

/-- **The relations are finitely generated** (Oka). -/
theorem relSubmodule_fg {ι₁ ι₀ : Type} [Fintype ι₁] [Fintype ι₀] (hX : OkaProperty X)
    {A : ι₀ → ι₁ → X → ℂ} {y : X} (hA : ∀ i j, HolAt (A i j) y) : (relSubmodule A y).FG := by
  obtain ⟨U, hU, hyU, μ, _, σ, hσ⟩ := hX ι₀ ι₁ A y hA
  have hσy : ∀ k j, HolAt (σ k j) y := fun k j => holAt_of_differentiableOn hU (hσ.1 k j) hyU
  have heq : relSubmodule A y = Submodule.span (HolGerm X) (Set.range fun k => germVec y (σ k)) := by
    apply le_antisymm
    · intro v hv
      choose a ha hav using fun j => exists_germAt_eq (v j) y
      have hv' : germVec y a = v := funext hav
      rw [← hv'] at hv ⊢
      rw [germVec_mem_span_iff hσy ha]
      exact hσ.2.2 y hyU a ((germVec_mem_relSubmodule_iff hA ha).1 hv)
    · rw [Submodule.span_le]
      rintro _ ⟨k, rfl⟩
      refine (germVec_mem_relSubmodule_iff hA (hσy k)).2 ⟨hσy k, fun i => ?_⟩
      filter_upwards [hU.mem_nhds hyU] with x hx
      exact hσ.2.1 k i x hx
  rw [heq]
  exact Submodule.fg_span (Set.finite_range _)

end Germ

/-! ## Generation by lifts (Nakayama) -/

section Nakayama
variable {P : Type*} [NormedAddCommGroup P] [NormedSpace ℂ P]

theorem eval_germAt {X : Type*} [NormedAddCommGroup X] [NormedSpace ℂ X] {f : X → ℂ} {y : X}
    (hf : HolAt f y) : eval (germAt y f) = f y := by
  rw [germAt_of_holAt hf, eval_mk, add_zero]

/-- **Lifts of generators of the fibre relations generate the relations** (Nakayama). -/
theorem isCombinationAt_of_slice_generates (hX : OkaProperty (ℂ × P)) {ι₁ ι₀ : Type} [Fintype ι₁]
    [Fintype ι₀] {μ : Type*} [Fintype μ] {A : ι₀ → ι₁ → ℂ × P → ℂ} {z₀ : P}
    (hA : ∀ i j, HolAt (A i j) ((0 : ℂ), z₀)) {τ : μ → ι₁ → ℂ × P → ℂ}
    (hτ : ∀ k, IsRelationAt A ((0 : ℂ), z₀) (τ k))
    (hgen : ∀ b, IsRelationAt (sliceZero A) z₀ b →
      IsCombinationAt (fun k j z => τ k j ((0 : ℂ), z)) z₀ b)
    (a : ι₁ → ℂ × P → ℂ) (ha : IsRelationAt A ((0 : ℂ), z₀) a) :
    IsCombinationAt τ ((0 : ℂ), z₀) a := by
  set y : ℂ × P := ((0 : ℂ), z₀) with hy
  have hτy : ∀ k j, HolAt (τ k j) y := fun k j => (hτ k).1 j
  set N : Submodule (HolGerm (ℂ × P)) (ι₁ → HolGerm (ℂ × P)) :=
    Submodule.span (HolGerm (ℂ × P)) (Set.range fun k => germVec y (τ k))
  set I : Ideal (HolGerm (ℂ × P)) := Ideal.span {germAt y (fun x : ℂ × P => x.1)}
  have hwy : HolAt (fun x : ℂ × P => x.1) y :=
    holAt_of_differentiableOn isOpen_univ differentiableOn_fst (mem_univ y)
  have hIJ : I ≤ Ideal.jacobson ⊥ := by
    rw [IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top, Ideal.span_le,
      Set.singleton_subset_iff, SetLike.mem_coe, mem_maximalIdeal_iff, eval_germAt hwy]
  -- every relation lies in `N + w · R`
  have hstep : relSubmodule A y ≤ N ⊔ I • relSubmodule A y := by
    intro v hv
    choose r hr hrv using fun j => exists_germAt_eq (v j) y
    have hv' : germVec y r = v := funext hrv
    rw [← hv'] at hv ⊢
    have hrel := (germVec_mem_relSubmodule_iff hA hr).1 hv
    -- restrict to `w = 0` and write it with the `τ_k(0,·)`
    have hb : IsRelationAt (sliceZero A) z₀ (fun j z => r j ((0 : ℂ), z)) := by
      refine ⟨fun j => HolAt.comp_zero_prod (hr j), fun i => ?_⟩
      exact (tendsto_zero_prod z₀).eventually (hrel.2 i)
    obtain ⟨lam, hlam, hlamτ⟩ := hgen _ hb
    set lt : μ → ℂ × P → ℂ := fun k x => lam k x.2 with hlt
    have hlt_hol : ∀ k, HolAt (lt k) y := fun k =>
      (hlam k).comp (f := lam k) continuous_snd fun x => differentiableAt_snd
    -- `r − ∑ λ_k τ_k` vanishes on `w = 0`, so it is `w · s`
    have hdiv : ∀ j, ∃ s : ℂ × P → ℂ, HolAt s y ∧
        ∀ᶠ x in 𝓝 y, r j x - ∑ k, lt k x * τ k j x = x.1 * s x := by
      intro j
      refine exists_eq_fst_mul ((hr j).sub (HolAt.fintype_sum fun k => (hlt_hol k).mul (hτy k j)))
        rfl ?_
      filter_upwards [hlamτ j] with z hz
      rw [hz, sub_self]
    choose s hs hrs using hdiv
    -- `s` is a relation of `A`
    have hsrel : IsRelationAt A y s := by
      refine ⟨hs, fun i => ?_⟩
      refine nonZeroDivisorAt_fst y _ (HolAt.fintype_sum fun j => (hs j).mul (hA i j)) ?_
      have hev : ∀ᶠ x in 𝓝 y, (∀ j, r j x - ∑ k, lt k x * τ k j x = x.1 * s j x) ∧
          (∑ j, r j x * A i j x = 0) ∧ ∀ k, ∑ j, τ k j x * A i j x = 0 :=
        (eventually_all.2 hrs).and ((hrel.2 i).and (eventually_all.2 fun k => (hτ k).2 i))
      filter_upwards [hev] with x ⟨h1, h2, h3⟩
      calc x.1 * ∑ j, s j x * A i j x = ∑ j, (x.1 * s j x) * A i j x := by
            rw [Finset.mul_sum]; exact Finset.sum_congr rfl fun j _ => by ring
        _ = ∑ j, (r j x - ∑ k, lt k x * τ k j x) * A i j x :=
            Finset.sum_congr rfl fun j _ => by rw [h1 j]
        _ = ∑ j, r j x * A i j x - ∑ k, lt k x * ∑ j, τ k j x * A i j x := by
            simp only [sub_mul, Finset.sum_sub_distrib, Finset.sum_mul, Finset.mul_sum]
            rw [Finset.sum_comm (f := fun j k => lt k x * τ k j x * A i j x)]
            congr 1
            exact Finset.sum_congr rfl fun k _ => Finset.sum_congr rfl fun j _ => by ring
        _ = 0 := by rw [h2]; simp [h3]
    -- the germ identity `r = ∑ λ_k τ_k + w s`
    have hgerm : germVec y r = ∑ k, germAt y (lt k) • germVec y (τ k) +
        germAt y (fun x : ℂ × P => x.1) • germVec y s := by
      funext j
      simp only [germVec, Pi.add_apply, Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
      have heq : r j =ᶠ[𝓝 y] fun x => ∑ k, lt k x * τ k j x + x.1 * s j x :=
        (hrs j).mono fun x hx => by
          show r j x = ∑ k, lt k x * τ k j x + x.1 * s j x
          rw [← hx]
          ring
      rw [(germAt_eq_germAt_iff (hr j) ((HolAt.fintype_sum fun k => (hlt_hol k).mul (hτy k j)).add
        (hwy.mul (hs j)))).2 heq, germAt_add (HolAt.fintype_sum fun k => (hlt_hol k).mul (hτy k j))
        (hwy.mul (hs j)), germAt_sum _ fun k _ => (hlt_hol k).mul (hτy k j),
        germAt_mul hwy (hs j)]
      congr 1
      exact Finset.sum_congr rfl fun k _ => germAt_mul (hlt_hol k) (hτy k j)
    rw [hgerm]
    refine Submodule.add_mem_sup (Submodule.sum_mem _ fun k _ => Submodule.smul_mem _ _
      (Submodule.subset_span ⟨k, rfl⟩)) ?_
    exact Submodule.smul_mem_smul (Ideal.mem_span_singleton_self _)
      ((germVec_mem_relSubmodule_iff hA hs).2 hsrel)
  have hle := Submodule.le_of_le_smul_of_le_jacobson_bot (relSubmodule_fg hX hA) hIJ hstep
  exact (germVec_mem_span_iff hτy ha.1).1 (hle ((germVec_mem_relSubmodule_iff hA ha.1).2 ha))

/-- Oka's property for `ℂ × ℂⁿ`. -/
theorem okaProperty_prod_euclidean (n : ℕ) : OkaProperty (ℂ × EuclideanSpace ℂ (Fin n)) := by
  let e : (ℂ × EuclideanSpace ℂ (Fin n)) ≃L[ℂ] EuclideanSpace ℂ (Fin (n + 1)) :=
    (ContinuousLinearEquiv.prodComm ℂ ℂ (EuclideanSpace ℂ (Fin n))).trans (euclideanSnocCLE n).symm
  exact OkaProperty.of_homeomorph e.toHomeomorph (fun x => e.differentiableAt)
    (fun x => e.symm.differentiableAt) (OkaCoherence.okaProperty_euclidean (n + 1))

end Nakayama

end
end Hironaka.HironakaG10FlatRelationLift
