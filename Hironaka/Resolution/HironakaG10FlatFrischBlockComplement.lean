import Mathlib.LinearAlgebra.Matrix.ToLin
import Mathlib.RingTheory.Ideal.Maps

/-! # Frisch's block-complement lemma (Frisch 1968, Lemme 1) and its universal form

Write a linear map `f : M₁ × N₁ → M₀ × N₀` as a block matrix
`f (m, n) = (α m + γ n, β m + δ n)`. Then `N₁` is a complement of `ker f` and `N₀`
is a complement of `range f` if and only if `γ` is invertible and the Schur
complement vanishes: `β = δ γ⁻¹ α`. This is the purely algebraic Lemme 1 of
Frisch, *Aplatissement en géométrie analytique* (1968), both directions, for
arbitrary modules over an arbitrary ring (no Banach structure is used).

Universal (finite-matrix) form, the algebraic shape of Frisch's Lemme 2: for a
block matrix over a commutative ring `S` with `γ` invertible, ONE ideal `J ⊆ S`
(generated by the entries of `β - δ γ⁻¹ α`), chosen before all base changes,
satisfies: for EVERY ring map `ψ : S → R`, the base-changed block map over `R` has
kernel complemented by `R^{κ₁}` and image complemented by `R^{κ₀}` exactly when
`ψ(J) = 0`.

The analytic content of Frisch's Lemmes 2–5 (Banach spaces `B(K)` of bounded
holomorphic functions on privileged polydiscs, Douady's privileged-neighbourhood
theorem and "platitude et privilège") is NOT formalized here.
BP FIRST: hironaka-g10-flat-frisch-block-complement.tex. -/
set_option autoImplicit false

namespace Hironaka.HironakaG10FlatFrischBlockComplement

section Modules
variable {R : Type*} [Ring R] {M₁ N₁ M₀ N₀ : Type*}
  [AddCommGroup M₁] [AddCommGroup N₁] [AddCommGroup M₀] [AddCommGroup N₀]
  [Module R M₁] [Module R N₁] [Module R M₀] [Module R N₀]

/-- The block map `(m, n) ↦ (α m + γ n, β m + δ n)`. -/
def blockMap (α : M₁ →ₗ[R] M₀) (β : M₁ →ₗ[R] N₀) (γ : N₁ →ₗ[R] M₀) (δ : N₁ →ₗ[R] N₀) :
    M₁ × N₁ →ₗ[R] M₀ × N₀ :=
  LinearMap.prod (α.coprod γ) (β.coprod δ)

@[simp] theorem blockMap_apply (α : M₁ →ₗ[R] M₀) (β : M₁ →ₗ[R] N₀) (γ : N₁ →ₗ[R] M₀)
    (δ : N₁ →ₗ[R] N₀) (x : M₁ × N₁) :
    blockMap α β γ δ x = (α x.1 + γ x.2, β x.1 + δ x.2) := rfl

variable (α : M₁ →ₗ[R] M₀) (β : M₁ →ₗ[R] N₀) (γ : N₁ →ₗ[R] M₀) (δ : N₁ →ₗ[R] N₀)

private theorem mem_range_inr_iff {A B : Type*} [AddCommGroup A] [AddCommGroup B]
    [Module R A] [Module R B] (x : A × B) :
    x ∈ LinearMap.range (LinearMap.inr R A B) ↔ x.1 = 0 := by
  constructor
  · rintro ⟨n,rfl⟩
    rfl
  · intro h
    exact ⟨x.2, Prod.ext h.symm rfl⟩

/-- Frisch's Lemme 1, sufficiency: an invertible `γ` with vanishing Schur complement
makes `N₁` a complement of the kernel and `N₀` a complement of the image. -/
theorem isCompl_of_schur (e : N₁ ≃ₗ[R] M₀) (he : (e : N₁ →ₗ[R] M₀) = γ)
    (hs : β = δ ∘ₗ (e.symm : M₀ →ₗ[R] N₁) ∘ₗ α) :
    IsCompl (LinearMap.ker (blockMap α β γ δ)) (LinearMap.range (LinearMap.inr R M₁ N₁)) ∧
      IsCompl (LinearMap.range (blockMap α β γ δ)) (LinearMap.range (LinearMap.inr R M₀ N₀)) := by
  subst he
  have hβ (m : M₁) : β m = δ (e.symm (α m)) := by rw [hs]; rfl
  refine ⟨⟨?_,?_⟩,⟨?_,?_⟩⟩
  · rw [Submodule.disjoint_def]
    intro x hx hx'
    rw [mem_range_inr_iff] at hx'
    rw [LinearMap.mem_ker, blockMap_apply, hx'] at hx
    have h1 : e x.2 = 0 := by simpa using congrArg Prod.fst hx
    exact Prod.ext hx' (by simpa using h1)
  · rw [codisjoint_iff, eq_top_iff]
    intro x _
    rw [Submodule.mem_sup]
    refine ⟨(x.1, -e.symm (α x.1)), ?_, (0, x.2 + e.symm (α x.1)), ⟨_,rfl⟩, ?_⟩
    · rw [LinearMap.mem_ker, blockMap_apply]
      simp [hβ]
    · ext <;> simp
  · rw [Submodule.disjoint_def]
    rintro y ⟨x,rfl⟩ hy
    rw [mem_range_inr_iff, blockMap_apply] at hy
    have hn : x.2 = -e.symm (α x.1) := by
      apply e.injective
      simp only [map_neg, LinearEquiv.apply_symm_apply]
      exact eq_neg_of_add_eq_zero_right hy
    rw [blockMap_apply]
    ext
    · exact hy
    · change β x.1 + δ x.2 = 0
      rw [hn, hβ, map_neg, add_neg_cancel]
  · rw [codisjoint_iff, eq_top_iff]
    intro y _
    rw [Submodule.mem_sup]
    refine ⟨blockMap α β (e : N₁ →ₗ[R] M₀) δ (0, e.symm y.1), ⟨_,rfl⟩,
      (0, y.2 - δ (e.symm y.1)), ⟨_,rfl⟩, ?_⟩
    ext <;> simp

/-- Frisch's Lemme 1, necessity: if `N₁` complements the kernel and `N₀` the image,
then `γ` is invertible and the Schur complement vanishes. -/
theorem schur_of_isCompl
    (hk : IsCompl (LinearMap.ker (blockMap α β γ δ)) (LinearMap.range (LinearMap.inr R M₁ N₁)))
    (hr : IsCompl (LinearMap.range (blockMap α β γ δ)) (LinearMap.range (LinearMap.inr R M₀ N₀))) :
    ∃ e : N₁ ≃ₗ[R] M₀, (e : N₁ →ₗ[R] M₀) = γ ∧
      β = δ ∘ₗ (e.symm : M₀ →ₗ[R] N₁) ∘ₗ α := by
  have hinj : Function.Injective γ := by
    rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
    intro n hn
    rw [LinearMap.mem_ker] at hn
    have hδ : (0, δ n) = (0 : M₀ × N₀) := by
      apply (Submodule.disjoint_def.mp hr.disjoint)
      · refine ⟨(0, n), ?_⟩
        rw [blockMap_apply]
        simp [hn]
      · exact (mem_range_inr_iff _).mpr rfl
    have hδ' : δ n = 0 := congrArg Prod.snd hδ
    have h0 : ((0 : M₁), n) = 0 := by
      apply (Submodule.disjoint_def.mp hk.disjoint)
      · rw [LinearMap.mem_ker, blockMap_apply]
        simp [hn, hδ']
      · exact (mem_range_inr_iff _).mpr rfl
    exact congrArg Prod.snd h0
  have hsurj : Function.Surjective γ := by
    intro a
    have ha : ((a, (0 : N₀)) : M₀ × N₀) ∈
        LinearMap.range (blockMap α β γ δ) ⊔ LinearMap.range (LinearMap.inr R M₀ N₀) := by
      rw [hr.sup_eq_top]; trivial
    obtain ⟨r, ⟨x, rfl⟩, z, hz, hrz⟩ := Submodule.mem_sup.mp ha
    have hx : x ∈ LinearMap.ker (blockMap α β γ δ) ⊔ LinearMap.range (LinearMap.inr R M₁ N₁) := by
      rw [hk.sup_eq_top]; trivial
    obtain ⟨k, hkk, w, hw, hkw⟩ := Submodule.mem_sup.mp hx
    rw [mem_range_inr_iff] at hz hw
    refine ⟨w.2, ?_⟩
    have h1 := congrArg Prod.fst hrz
    rw [← hkw, map_add, LinearMap.mem_ker.mp hkk, zero_add, blockMap_apply, hw] at h1
    simpa [hz] using h1
  let e := LinearEquiv.ofBijective γ ⟨hinj, hsurj⟩
  refine ⟨e, rfl, ?_⟩
  apply LinearMap.ext
  intro m
  have hx : ((m, (0 : N₁)) : M₁ × N₁) ∈
      LinearMap.ker (blockMap α β γ δ) ⊔ LinearMap.range (LinearMap.inr R M₁ N₁) := by
    rw [hk.sup_eq_top]; trivial
  obtain ⟨k, hkk, w, hw, hkw⟩ := Submodule.mem_sup.mp hx
  rw [mem_range_inr_iff] at hw
  rw [LinearMap.mem_ker, blockMap_apply] at hkk
  have hk1 : k.1 = m := by simpa [hw] using congrArg Prod.fst hkw
  have hk2 : k.2 = -w.2 := by
    have := congrArg Prod.snd hkw
    simp only [Prod.snd_add] at this
    exact eq_neg_of_add_eq_zero_left this
  have hA : γ k.2 = -α m := by
    have := congrArg Prod.fst hkk
    simp only [Prod.fst_zero] at this
    rw [hk1] at this
    exact eq_neg_of_add_eq_zero_right this
  have hB : β m = -δ k.2 := by
    have := congrArg Prod.snd hkk
    simp only [Prod.snd_zero] at this
    rw [hk1] at this
    exact eq_neg_of_add_eq_zero_left this
  have hsymm : e.symm (α m) = -k.2 := by
    apply e.injective
    rw [LinearEquiv.apply_symm_apply, map_neg]
    change α m = -γ k.2
    rw [hA, neg_neg]
  change β m = δ (e.symm (α m))
  rw [hsymm, map_neg, hB]

/-- Frisch's Lemme 1: complements of kernel and image along the fixed axes
exist EXACTLY when `γ` is invertible and the Schur complement vanishes. -/
theorem isCompl_iff_schur :
    (IsCompl (LinearMap.ker (blockMap α β γ δ)) (LinearMap.range (LinearMap.inr R M₁ N₁)) ∧
      IsCompl (LinearMap.range (blockMap α β γ δ)) (LinearMap.range (LinearMap.inr R M₀ N₀))) ↔
    ∃ e : N₁ ≃ₗ[R] M₀, (e : N₁ →ₗ[R] M₀) = γ ∧
      β = δ ∘ₗ (e.symm : M₀ →ₗ[R] N₁) ∘ₗ α :=
  ⟨fun h => schur_of_isCompl α β γ δ h.1 h.2,
    fun ⟨e,he,hs⟩ => isCompl_of_schur α β γ δ e he hs⟩

/-- With a GIVEN inverse of `γ`, the criterion is the literal Schur equation. -/
theorem isCompl_iff_schur_of_inverse (e : N₁ ≃ₗ[R] M₀) (he : (e : N₁ →ₗ[R] M₀) = γ) :
    (IsCompl (LinearMap.ker (blockMap α β γ δ)) (LinearMap.range (LinearMap.inr R M₁ N₁)) ∧
      IsCompl (LinearMap.range (blockMap α β γ δ)) (LinearMap.range (LinearMap.inr R M₀ N₀))) ↔
    β = δ ∘ₗ (e.symm : M₀ →ₗ[R] N₁) ∘ₗ α := by
  rw [isCompl_iff_schur]
  constructor
  · rintro ⟨e', he', hs⟩
    have hee : e' = e := LinearEquiv.toLinearMap_injective (he'.trans he.symm)
    rw [hs, hee]
  · intro hs
    exact ⟨e, he, hs⟩

end Modules

section Matrices
variable {S R : Type*} [CommRing S] [CommRing R]
  {ι₁ κ₁ ι₀ κ₀ : Type*} [Fintype ι₁] [Fintype κ₁] [Fintype ι₀] [Fintype κ₀]
  [DecidableEq ι₁] [DecidableEq κ₁] [DecidableEq ι₀] [DecidableEq κ₀]

/-- The block map of a block matrix over `S`, base changed along `ψ : S → R`. -/
def matrixBlockMap (ψ : S →+* R) (α : Matrix ι₀ ι₁ S) (β : Matrix κ₀ ι₁ S)
    (γ : Matrix ι₀ κ₁ S) (δ : Matrix κ₀ κ₁ S) :
    (ι₁ → R) × (κ₁ → R) →ₗ[R] (ι₀ → R) × (κ₀ → R) :=
  blockMap (Matrix.toLin' (α.map ψ)) (Matrix.toLin' (β.map ψ))
    (Matrix.toLin' (γ.map ψ)) (Matrix.toLin' (δ.map ψ))

/-- Frisch's flattening ideal of a block matrix with a chosen inverse of `γ`: the
ideal generated by the entries of the Schur complement `β - δ γ⁻¹ α`. -/
def schurIdeal (α : Matrix ι₀ ι₁ S) (β : Matrix κ₀ ι₁ S) (δ : Matrix κ₀ κ₁ S)
    (γinv : Matrix κ₁ ι₀ S) : Ideal S :=
  Ideal.span (Set.range fun p : κ₀ × ι₁ => (β - δ * γinv * α) p.1 p.2)

/-- The base-changed inverse of `γ` as an actual linear equivalence over `R`. -/
def baseChangedGammaEquiv (ψ : S →+* R) (γ : Matrix ι₀ κ₁ S) (γinv : Matrix κ₁ ι₀ S)
    (h₁ : γ * γinv = 1) (h₂ : γinv * γ = 1) : (κ₁ → R) ≃ₗ[R] (ι₀ → R) :=
  LinearEquiv.ofLinearMap (Matrix.toLin' (γ.map ψ)) (Matrix.toLin' (γinv.map ψ))
    (by rw [← Matrix.toLin'_mul, ← Matrix.map_mul, h₁, Matrix.map_one ψ ψ.map_zero ψ.map_one,
      Matrix.toLin'_one])
    (by rw [← Matrix.toLin'_mul, ← Matrix.map_mul, h₂, Matrix.map_one ψ ψ.map_zero ψ.map_one,
      Matrix.toLin'_one])

omit [Fintype κ₀] [DecidableEq κ₀] in
/-- Universal form of Frisch's Lemmes 1–2 for block matrices: ONE ideal of `S`,
chosen before all base changes, such that for EVERY ring map `ψ : S → R` the
base-changed block map has kernel complemented by `R^{κ₁}` and image complemented
by `R^{κ₀}` exactly when `ψ` kills that ideal. -/
theorem matrix_isCompl_iff_map_schurIdeal_eq_bot (α : Matrix ι₀ ι₁ S) (β : Matrix κ₀ ι₁ S)
    (γ : Matrix ι₀ κ₁ S) (δ : Matrix κ₀ κ₁ S) (γinv : Matrix κ₁ ι₀ S)
    (h₁ : γ * γinv = 1) (h₂ : γinv * γ = 1) (ψ : S →+* R) :
    (IsCompl (LinearMap.ker (matrixBlockMap ψ α β γ δ))
        (LinearMap.range (LinearMap.inr R (ι₁ → R) (κ₁ → R))) ∧
      IsCompl (LinearMap.range (matrixBlockMap ψ α β γ δ))
        (LinearMap.range (LinearMap.inr R (ι₀ → R) (κ₀ → R)))) ↔
    Ideal.map ψ (schurIdeal α β δ γinv) = ⊥ := by
  rw [matrixBlockMap, isCompl_iff_schur_of_inverse (Matrix.toLin' (α.map ψ))
    (Matrix.toLin' (β.map ψ)) (Matrix.toLin' (γ.map ψ)) (Matrix.toLin' (δ.map ψ))
    (baseChangedGammaEquiv ψ γ γinv h₁ h₂) rfl]
  change Matrix.toLin' (β.map ψ) =
      Matrix.toLin' (δ.map ψ) ∘ₗ Matrix.toLin' (γinv.map ψ) ∘ₗ Matrix.toLin' (α.map ψ) ↔ _
  rw [← Matrix.toLin'_mul, ← Matrix.toLin'_mul, Matrix.toLin'.injective.eq_iff,
    ← Matrix.map_mul, ← Matrix.map_mul, schurIdeal, Matrix.mul_assoc, Ideal.map_span,
    Ideal.span_eq_bot]
  constructor
  · rintro h _ ⟨_, ⟨p, rfl⟩, rfl⟩
    have hp := congrFun (congrFun h p.1) p.2
    simp only [Matrix.map_apply] at hp
    simp only [Matrix.sub_apply, map_sub, hp, sub_self]
  · intro h
    ext k i
    have hki := h _ ⟨_, ⟨(k, i), rfl⟩, rfl⟩
    simp only [Matrix.sub_apply, map_sub] at hki
    simpa only [Matrix.map_apply] using sub_eq_zero.mp hki

end Matrices

end Hironaka.HironakaG10FlatFrischBlockComplement
