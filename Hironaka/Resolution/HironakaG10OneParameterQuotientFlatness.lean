import Hironaka.Resolution.HironakaG10OneParameterCokernelFlatness
import Mathlib.RingTheory.RingHom.Flat
import Mathlib.RingTheory.Ideal.Operations
import Mathlib.LinearAlgebra.Pi
import Mathlib.LinearAlgebra.Quotient.Basic

/-! The actual one-row germ presentation cokernel is the quotient by the
whole ideal of its entry germs, with the literal first-projection base
structure map. No quotient dictionary or flatness certificate is an input.
Blueprint: `hironaka-g10-one-parameter-quotient-flatness.tex`. -/
set_option autoImplicit false
open Set Filter
open scoped Topology Matrix
namespace Hironaka.HironakaG10OneParameterQuotientFlatness
noncomputable section
open OkaRelationSheaf OkaGermBridge HironakaG10FlatGermChain
  HironakaG10OneParameterCokernelFlatness HironakaG10LocFibreOpen
  HironakaG10FlatSliceResolution

section OneRow
variable {R : Type*} [CommRing R] {b : ℕ}

/-- Evaluation at the unique output identifies the entire image of a
one-row matrix with the ideal generated by all its entries. -/
theorem one_row_image_eq_ideal (M : Matrix (Fin 1) (Fin b) R) :
    (LinearMap.range M.mulVecLin).map
      (LinearEquiv.funUnique (Fin 1) R R).toLinearMap =
        Ideal.span (Set.range fun j => M 0 j) := by
  ext x
  constructor
  · rintro ⟨v, ⟨c, rfl⟩, rfl⟩
    apply Ideal.mem_span_range_iff_exists_fun.mpr
    refine ⟨c, ?_⟩
    change ∑ j, c j * M 0 j = ∑ j, M 0 j * c j
    exact Finset.sum_congr rfl fun j _ => mul_comm _ _
  · intro hx
    obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hx
    refine ⟨M *ᵥ c, ⟨c, rfl⟩, ?_⟩
    change ∑ j, M 0 j * c j = x
    calc
      _ = ∑ j, c j * M 0 j := Finset.sum_congr rfl fun j _ => mul_comm _ _
      _ = x := hc

end OneRow

variable {P : Type*} [NormedAddCommGroup P] [NormedSpace ℂ P] {b : ℕ}

/-- The whole ideal of the actual one-row presentation, without radical or
support replacement. -/
def entryIdeal (F : Fin 1 → Fin b → ℂ × P → ℂ) (z₀ : P) : Ideal (HolGerm (ℂ × P)) :=
  Ideal.span (Set.range fun j => germAt ((0 : ℂ), z₀) (F 0 j))

/-- The actual whole germ-matrix image is the entire original entry ideal
under evaluation at the unique output coordinate. -/
theorem germImage_eval_eq_entryIdeal (F : Fin 1 → Fin b → ℂ × P → ℂ) (z₀ : P) :
    (germImage F z₀).map
      (LinearEquiv.funUnique (Fin 1) (HolGerm (ℂ × P)) (HolGerm (ℂ × P))).toLinearMap =
        entryIdeal F z₀ :=
  one_row_image_eq_ideal (germMat ((0 : ℂ), z₀) F)

/-- The exact ring structure map on the quotient of the original germs. -/
def quotientStructureMap (F : Fin 1 → Fin b → ℂ × P → ℂ) (z₀ : P) :
    HolGerm ℂ →+* HolGerm (ℂ × P) ⧸ entryIdeal F z₀ :=
  (Ideal.Quotient.mk (entryIdeal F z₀)).comp (basePullback P)

/-- The canonical quotient dictionary is constructed from the actual matrix
image and the unique-coordinate evaluation. -/
def cokernelQuotientEquiv (F : Fin 1 → Fin b → ℂ × P → ℂ) (z₀ : P) :
    germCokernel F z₀ ≃ₗ[HolGerm (ℂ × P)] HolGerm (ℂ × P) ⧸ entryIdeal F z₀ :=
  Submodule.Quotient.equiv (germImage F z₀) (entryIdeal F z₀)
    (LinearEquiv.funUnique (Fin 1) (HolGerm (ℂ × P)) (HolGerm (ℂ × P)))
    (germImage_eval_eq_entryIdeal F z₀)

private theorem quotient_smul_eq_mul (J : Ideal (HolGerm (ℂ × P)))
    (r : HolGerm (ℂ × P)) (q : HolGerm (ℂ × P) ⧸ J) :
    r • q = (Ideal.Quotient.mk J r) * q := by
  refine Submodule.Quotient.induction_on J q ?_
  intro x
  rfl

/-- The same dictionary respects the actual first-projection action on the
cokernel and the literal quotient structure map action on the quotient. -/
def parameterCokernelQuotientEquiv (F : Fin 1 → Fin b → ℂ × P → ℂ) (z₀ : P) :
    letI : Module (HolGerm ℂ) (germCokernel F z₀) := parameterModule F z₀
    letI : Module (HolGerm ℂ) (HolGerm (ℂ × P) ⧸ entryIdeal F z₀) :=
      Module.compHom _ (quotientStructureMap F z₀)
    germCokernel F z₀ ≃ₗ[HolGerm ℂ] HolGerm (ℂ × P) ⧸ entryIdeal F z₀ := by
  letI : Module (HolGerm ℂ) (germCokernel F z₀) := parameterModule F z₀
  letI : Module (HolGerm ℂ) (HolGerm (ℂ × P) ⧸ entryIdeal F z₀) :=
    Module.compHom _ (quotientStructureMap F z₀)
  refine { (cokernelQuotientEquiv F z₀).toAddEquiv with map_smul' := ?_ }
  intro a x
  change cokernelQuotientEquiv F z₀ ((basePullback P a) • x) =
    (Ideal.Quotient.mk (entryIdeal F z₀) (basePullback P a)) * cokernelQuotientEquiv F z₀ x
  rw [(cokernelQuotientEquiv F z₀).map_smul]
  exact quotient_smul_eq_mul _ _ _

/-- The actual quotient ring is flat through its literal first-projection
structure map when the original presentation has the exact-fibre property. -/
theorem quotientStructureMap_flat_of_fibreFlatAt
    (F : Fin 1 → Fin b → ℂ × P → ℂ) (z₀ : P)
    (h : FibreFlatAt F ((0 : ℂ), z₀)) : (quotientStructureMap F z₀).Flat := by
  let : Module (HolGerm ℂ) (germCokernel F z₀) := parameterModule F z₀
  let : Module.Flat (HolGerm ℂ) (germCokernel F z₀) :=
    flat_germCokernel_of_fibreFlatAt F z₀ h
  let : Algebra (HolGerm ℂ) (HolGerm (ℂ × P) ⧸ entryIdeal F z₀) :=
    (quotientStructureMap F z₀).toAlgebra
  change Module.Flat (HolGerm ℂ) (HolGerm (ℂ × P) ⧸ entryIdeal F z₀)
  exact Module.Flat.of_linearEquiv (parameterCokernelQuotientEquiv F z₀).symm

/-- Coordinate regularity gives the same whole quotient-ring flatness, with
no assumed equality of module actions or supplied quotient equivalence. -/
theorem quotientStructureMap_flat_of_regularAt
    (F : Fin 1 → Fin b → ℂ × P → ℂ) (z₀ : P)
    (hF : ∀ i j, HolAt (F i j) ((0 : ℂ), z₀))
    (hreg : RegularAt F (fun x => x.1) ((0 : ℂ), z₀)) :
    (quotientStructureMap F z₀).Flat := by
  let : Module (HolGerm ℂ) (germCokernel F z₀) := parameterModule F z₀
  let : Module.Flat (HolGerm ℂ) (germCokernel F z₀) :=
    flat_germCokernel_of_regularAt F z₀ hF hreg
  let : Algebra (HolGerm ℂ) (HolGerm (ℂ × P) ⧸ entryIdeal F z₀) :=
    (quotientStructureMap F z₀).toAlgebra
  change Module.Flat (HolGerm ℂ) (HolGerm (ℂ × P) ⧸ entryIdeal F z₀)
  exact Module.Flat.of_linearEquiv (parameterCokernelQuotientEquiv F z₀).symm

end
end Hironaka.HironakaG10OneParameterQuotientFlatness
