import Hironaka.Resolution.HironakaG10PNPointIdeal

/-! Kernel families along morphisms and their coherence along closed embeddings of fibres (lane
G10P, run 0080 r4).  Blueprint: `hironaka-g10-pn-point-ideal.tex`.

For `Q : Y ⟶ X` and an ideal family `K` of `𝒪_Y`, `kerFamily Q K x` is the kernel of
`𝒪_{X,x} → ∏_{Q y = x} 𝒪_{Y,y}/K_y` (the unit ideal if no point lies over `x`): the ideal of the image
of the subspace `V(K)`.  This file proves

* `kerFamily_id`, `kerFamily_comp` (functoriality), `kerFamily_mono`;
* **`isLocallyFinitelyGenerated_kerFamily`** — the coherence transfer along a closed embedding of a
  "fibre": if `Q` is a closed map, `P ≤ K` are coherent families of `𝒪_Y` which are the unit ideal off
  a closed set `F` on which `Q` is injective, every germ at a point of `F` is congruent modulo `P` to a
  germ pulled back from `X` (surjective fibre algebras) and the kernel family of `P` is coherent, then
  the kernel family of `K` is coherent.  Near the image of `y₀ ∈ F` it is generated by the generators
  of `kerFamily Q P` and by lifts of the generators of `K` (no direct-image theorem is used: properness
  only keeps the other points of `F` away, and the surjectivity of the fibre algebras does the rest). -/

set_option autoImplicit false
open Set TopologicalSpace CategoryTheory Opposite AlgebraicGeometry

namespace Hironaka.HironakaG10PNKernelFamily

open HironakaG10PNIdealFamily HironakaG10PNPointIdeal

noncomputable section

universe u

variable {X Y : LocallyRingedSpace.{u}}

/-- The **kernel family** of `K` along `Q`: `g ∈ 𝒪_{X,x}` with `Q^♯ g ∈ K_y` at every `y` over `x`. -/
def kerFamily (Q : Y ⟶ X) (K : ∀ y : Y, Ideal (Y.presheaf.stalk y)) (x : X) :
    Ideal (X.presheaf.stalk x) :=
  ⨅ (y : Y) (h : Q.base y = x),
    Ideal.comap ((Q.stalkMap y).hom.comp (eqToHom (congrArg X.presheaf.stalk h.symm)).hom) (K y)

theorem mem_kerFamily_iff (Q : Y ⟶ X) (K : ∀ y : Y, Ideal (Y.presheaf.stalk y)) (x : X)
    (g : X.presheaf.stalk x) :
    g ∈ kerFamily Q K x ↔ ∀ (y : Y) (h : Q.base y = x),
      (Q.stalkMap y).hom ((eqToHom (congrArg X.presheaf.stalk h.symm)).hom g) ∈ K y := by
  simp only [kerFamily, Ideal.mem_iInf, Ideal.mem_comap, RingHom.comp_apply]

theorem mem_kerFamily_at {Q : Y ⟶ X} {K : ∀ y : Y, Ideal (Y.presheaf.stalk y)} {y : Y}
    {g : X.presheaf.stalk (Q.base y)} (hg : g ∈ kerFamily Q K (Q.base y)) :
    (Q.stalkMap y).hom g ∈ K y := by
  have h := (mem_kerFamily_iff Q K _ g).mp hg y rfl
  simpa using h

/-- At the image of a point `y₀` which is the only point over it where `K` is not the unit ideal,
membership is tested at `y₀` alone. -/
theorem mem_kerFamily_of_unique {Q : Y ⟶ X} {K : ∀ y : Y, Ideal (Y.presheaf.stalk y)} {y₀ : Y}
    (huniq : ∀ y : Y, Q.base y = Q.base y₀ → K y ≠ ⊤ → y = y₀)
    (g : X.presheaf.stalk (Q.base y₀)) :
    g ∈ kerFamily Q K (Q.base y₀) ↔ (Q.stalkMap y₀).hom g ∈ K y₀ := by
  refine ⟨mem_kerFamily_at, fun hg => (mem_kerFamily_iff Q K _ g).mpr fun y h => ?_⟩
  by_cases hK : K y = ⊤
  · rw [hK]
    exact Submodule.mem_top
  · obtain rfl := huniq y h hK
    simpa using hg

theorem kerFamily_eq_top {Q : Y ⟶ X} {K : ∀ y : Y, Ideal (Y.presheaf.stalk y)} {x : X}
    (h : ∀ y : Y, Q.base y = x → K y = ⊤) : kerFamily Q K x = ⊤ := by
  rw [eq_top_iff]
  intro g _
  rw [mem_kerFamily_iff]
  intro y hy
  rw [h y hy]
  exact Submodule.mem_top

theorem kerFamily_mono (Q : Y ⟶ X) {K K' : ∀ y : Y, Ideal (Y.presheaf.stalk y)}
    (h : ∀ y, K y ≤ K' y) (x : X) : kerFamily Q K x ≤ kerFamily Q K' x := by
  intro g hg
  rw [mem_kerFamily_iff] at hg ⊢
  exact fun y hy => h y (hg y hy)

/-- The kernel family along the identity is the family itself. -/
theorem kerFamily_id (K : ∀ x : X, Ideal (X.presheaf.stalk x)) : kerFamily (𝟙 X) K = K := by
  funext x
  ext g
  rw [mem_kerFamily_iff]
  constructor
  · intro h
    have h1 := h x rfl
    simp only [LocallyRingedSpace.stalkMap_id] at h1
    exact h1
  · intro hg y hy
    subst hy
    simp only [LocallyRingedSpace.stalkMap_id]
    exact hg

/-- **Functoriality**: the kernel family along a composite is the iterated kernel family. -/
theorem kerFamily_comp {Z : LocallyRingedSpace.{u}} (q : Z ⟶ Y) (Q : Y ⟶ X)
    (K : ∀ z : Z, Ideal (Z.presheaf.stalk z)) :
    kerFamily (q ≫ Q) K = kerFamily Q (kerFamily q K) := by
  funext x
  ext g
  rw [mem_kerFamily_iff, mem_kerFamily_iff]
  constructor
  · intro h y hy
    subst hy
    rw [mem_kerFamily_iff]
    intro z hz
    subst hz
    have h1 := h z rfl
    have e : ((q ≫ Q).stalkMap z).hom g = (q.stalkMap z).hom ((Q.stalkMap (q.base z)).hom g) :=
      congrArg (fun φ => CommRingCat.Hom.hom φ g) (LocallyRingedSpace.stalkMap_comp q Q z)
    simp only [eqToHom_refl, CommRingCat.hom_id, RingHom.id_apply]
    rw [← e]
    exact h1
  · intro h z hz
    subst hz
    have h1 := h (q.base z) rfl
    rw [mem_kerFamily_iff] at h1
    have h2 := h1 z rfl
    have e : ((q ≫ Q).stalkMap z).hom g = (q.stalkMap z).hom ((Q.stalkMap (q.base z)).hom g) :=
      congrArg (fun φ => CommRingCat.Hom.hom φ g) (LocallyRingedSpace.stalkMap_comp q Q z)
    simp only [eqToHom_refl, CommRingCat.hom_id, RingHom.id_apply] at h2
    change (q ≫ Q).stalkMap z g ∈ K z
    rw [e]
    exact h2

/-- **Coherence of kernel families along a closed embedding of a fibre.**  Let `Q : Y ⟶ X` be a
closed map, `F ⊆ Y` closed with `Q` injective on `F`, and `P ≤ K` locally finitely generated families
of `𝒪_Y` with `P = 𝒪` off `F`; assume every germ at a point of `F` is congruent modulo `P` to a germ
pulled back along `Q`.  If the kernel family of `P` is locally finitely generated, so is the kernel
family of `K`. -/
theorem isLocallyFinitelyGenerated_kerFamily (Q : Y ⟶ X) (hQ : IsClosedMap Q.base) (F : Set Y)
    (hF : IsClosed F) (hinj : Set.InjOn Q.base F) (P K : ∀ y : Y, Ideal (Y.presheaf.stalk y))
    (hPF : ∀ y, y ∉ F → P y = ⊤) (hPK : ∀ y, P y ≤ K y)
    (hsurj : ∀ y ∈ F, ∀ b : Y.presheaf.stalk y, ∃ a : X.presheaf.stalk (Q.base y),
      b - (Q.stalkMap y).hom a ∈ P y)
    (hP : IsLocallyFinitelyGenerated Y P) (hK : IsLocallyFinitelyGenerated Y K)
    (hJ : IsLocallyFinitelyGenerated X (kerFamily Q P)) :
    IsLocallyFinitelyGenerated X (kerFamily Q K) := by
  classical
  have hKF : ∀ y, y ∉ F → K y = ⊤ := fun y hy => top_le_iff.mp ((hPF y hy).symm.le.trans (hPK y))
  -- uniqueness of the point of `F` over the image of a point of `F`
  have huniq : ∀ (R : ∀ y : Y, Ideal (Y.presheaf.stalk y)), (∀ y, y ∉ F → R y = ⊤) →
      ∀ y₀ ∈ F, ∀ y : Y, Q.base y = Q.base y₀ → R y ≠ ⊤ → y = y₀ := by
    intro R hR y₀ hy₀ y hy hRy
    by_contra hne
    by_cases hyF : y ∈ F
    · exact hne (hinj hyF hy₀ hy)
    · exact hRy (hR y hyF)
  intro x
  by_cases hx : ∃ y ∈ F, Q.base y = x
  · obtain ⟨y₀, hy₀F, rfl⟩ := hx
    obtain ⟨W₁, hW₁, r₁, g, hg⟩ := hJ (Q.base y₀)
    obtain ⟨W₂, hW₂, r₂, k, hk⟩ := hK y₀
    choose a ha using fun j => hsurj y₀ hy₀F (Y.presheaf.germ W₂ y₀ hW₂ (k j))
    obtain ⟨V₃, hV₃, A, hA⟩ := exists_common_sections (Q.base y₀) a
    let T : Opens Y := W₂ ⊓ (Opens.map Q.base).obj V₃
    have hy₀T : y₀ ∈ T := ⟨hW₂, hV₃⟩
    let iT₂ : T ⟶ W₂ := homOfLE inf_le_left
    let iT₃ : T ⟶ (Opens.map Q.base).obj V₃ := homOfLE inf_le_right
    let t : Fin r₂ → Y.presheaf.obj (op T) := fun j =>
      Y.presheaf.map iT₂.op (k j) - Y.presheaf.map iT₃.op (Q.c.app (op V₃) (A j))
    have ht : ∀ (y : Y) (hy : y ∈ T) (j : Fin r₂), Y.presheaf.germ T y hy (t j) =
        Y.presheaf.germ W₂ y (iT₂.le hy) (k j) -
          (Q.stalkMap y).hom (X.presheaf.germ V₃ (Q.base y) (iT₃.le hy) (A j)) := by
      intro y hy j
      simp only [t, map_sub, TopCat.Presheaf.germ_res_apply]
      exact congrArg (fun w => Y.presheaf.germ W₂ y (iT₂.le hy) (k j) - w)
        (LocallyRingedSpace.stalkMap_germ_apply Q V₃ y (iT₃.le hy) (A j)).symm
    have ht₀ : ∀ j, Y.presheaf.germ T y₀ hy₀T (t j) ∈ P y₀ := by
      intro j
      rw [ht, hA]
      exact ha j
    choose O hO hOT hOP using fun j =>
      exists_nhds_mem_of_isLocallyFinitelyGenerated hP (t j) y₀ hy₀T (ht₀ j)
    let W₅ : Opens Y := T ⊓ Finset.univ.inf O
    have hy₀W₅ : y₀ ∈ W₅ := ⟨hy₀T, (mem_finsetInf_opens O _ y₀).mpr fun j _ => hO j⟩
    let Z : Set X := Q.base '' (F ∩ (W₅ : Set Y)ᶜ)
    have hZ : IsClosed Z := hQ _ (hF.inter W₅.isOpen.isClosed_compl)
    have hy₀Z : Q.base y₀ ∉ Z := by
      rintro ⟨y, ⟨hyF, hyW⟩, hy⟩
      exact hyW ((hinj hyF hy₀F hy) ▸ hy₀W₅)
    let W : Opens X := W₁ ⊓ V₃ ⊓ ⟨Zᶜ, hZ.isOpen_compl⟩
    have hxW : Q.base y₀ ∈ W := ⟨⟨hW₁, hV₃⟩, hy₀Z⟩
    let i₁ : W ⟶ W₁ := homOfLE (inf_le_left.trans inf_le_left)
    let i₃ : W ⟶ V₃ := homOfLE (inf_le_left.trans inf_le_right)
    refine ⟨W, hxW, r₁ + r₂, Fin.append (fun i => X.presheaf.map i₁.op (g i))
      (fun j => X.presheaf.map i₃.op (A j)), fun x hx => ?_⟩
    rw [show (range fun i => X.presheaf.germ W x hx (Fin.append (fun i => X.presheaf.map i₁.op (g i))
        (fun j => X.presheaf.map i₃.op (A j)) i)) =
        range (fun i => X.presheaf.germ W₁ x (i₁.le hx) (g i)) ∪
          range (fun j => X.presheaf.germ V₃ x (i₃.le hx) (A j)) by
      rw [← HironakaG10PNIdealNoetherModel.range_fin_append]
      congr 1
      funext i
      refine Fin.addCases (fun i => ?_) (fun j => ?_) i
      · simp only [Fin.append_left, TopCat.Presheaf.germ_res_apply]
      · simp only [Fin.append_right, TopCat.Presheaf.germ_res_apply], Ideal.span_union,
      ← hg x (i₁.le hx)]
    by_cases hxF : ∃ y ∈ F, Q.base y = x
    · obtain ⟨y, hyF, rfl⟩ := hxF
      have hyW₅ : y ∈ W₅ := by
        by_contra hyW
        exact hx.2 ⟨y, ⟨hyF, hyW⟩, rfl⟩
      have hyT : y ∈ T := hyW₅.1
      have hyO : ∀ j, y ∈ O j := fun j => (mem_finsetInf_opens O _ y).mp hyW₅.2 j (Finset.mem_univ j)
      have hKm := mem_kerFamily_of_unique (huniq K hKF y hyF)
      have hPm := mem_kerFamily_of_unique (huniq P hPF y hyF)
      have hky := hk y hyT.1
      apply le_antisymm
      · intro h hh
        rw [hKm, hky] at hh
        obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hh
        choose d hd using fun j => hsurj y hyF (c j)
        have hsplit : h = (h - ∑ j, d j * X.presheaf.germ V₃ (Q.base y) (iT₃.le hyT) (A j)) +
            ∑ j, d j * X.presheaf.germ V₃ (Q.base y) (iT₃.le hyT) (A j) := by ring
        rw [hsplit]
        refine Ideal.add_mem _ (Ideal.mem_sup_left ?_) (Ideal.mem_sup_right ?_)
        · rw [hPm, map_sub, map_sum]
          have hkey : (Q.stalkMap y).hom h -
              ∑ j, (Q.stalkMap y).hom (d j * X.presheaf.germ V₃ (Q.base y) (iT₃.le hyT) (A j)) =
              ∑ j, (c j - (Q.stalkMap y).hom (d j)) * Y.presheaf.germ W₂ y hyT.1 (k j) +
              ∑ j, (Q.stalkMap y).hom (d j) * Y.presheaf.germ T y hyT (t j) := by
            simp only [ht, map_mul, ← hc]
            rw [← Finset.sum_add_distrib, ← Finset.sum_sub_distrib]
            exact Finset.sum_congr rfl fun j _ => by ring
          rw [hkey]
          refine Ideal.add_mem _ (Ideal.sum_mem _ fun j _ => Ideal.mul_mem_right _ _ (hd j))
            (Ideal.sum_mem _ fun j _ => Ideal.mul_mem_left _ _ (hOP j y (hyO j)))
        · exact Ideal.sum_mem _ fun j _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨j, rfl⟩)
      · refine sup_le (kerFamily_mono Q hPK _) ?_
        rw [Ideal.span_le]
        rintro _ ⟨j, rfl⟩
        change _ ∈ kerFamily Q K (Q.base y)
        rw [hKm]
        have e : (Q.stalkMap y).hom (X.presheaf.germ V₃ (Q.base y) (i₃.le hx) (A j)) =
            Y.presheaf.germ W₂ y hyT.1 (k j) - Y.presheaf.germ T y hyT (t j) := by
          rw [ht]
          ring
        rw [e]
        refine Ideal.sub_mem _ ?_ (hPK y (hOP j y (hyO j)))
        rw [hky]
        exact Ideal.subset_span ⟨j, rfl⟩
    · push Not at hxF
      have hK' : kerFamily Q K x = ⊤ := kerFamily_eq_top fun y hy => hKF y fun hyF => hxF y hyF hy
      have hP' : kerFamily Q P x = ⊤ := kerFamily_eq_top fun y hy => hPF y fun hyF => hxF y hyF hy
      rw [hK', hP', top_sup_eq]
  · push Not at hx
    have hZ : IsClosed (Q.base '' F) := hQ F hF
    have hxZ : x ∉ Q.base '' F := by
      rintro ⟨y, hyF, hy⟩
      exact hx y hyF hy
    refine ⟨⟨(Q.base '' F)ᶜ, hZ.isOpen_compl⟩, hxZ, 1, fun _ => 1, fun x' hx' => ?_⟩
    rw [kerFamily_eq_top fun y hy => hKF y fun hyF => hx' ⟨y, hyF, hy⟩]
    symm
    rw [Ideal.eq_top_iff_one]
    exact Ideal.subset_span ⟨0, map_one _⟩

end

end Hironaka.HironakaG10PNKernelFamily
