/-!
# Native finite-type ideals on a manifold and `GermIdeal`s

The dictionary between the native pulled ideal of a finite-type ideal `(B, b)` along a
morphism of locally ringed spaces out of a complex manifold and the FirstPass `GermIdeal`
of holomorphic germs (blueprint `hironaka-g10-chowside-germ-ideal-dictionary.tex`).

For a morphism `F : W ⟶ Y` from the native locally ringed space of a complex manifold `W`
and a native ideal `b : B ⟶ 𝒪_Y`, `germIdeal B b F` is the ideal sheaf of holomorphic germs
whose germ lies in the pulled ideal `J_x = F^{-1}(b B) · 𝒪_{W,x}`.

Main declarations:

* `germIdeal`, `actualWholeSheafStalkIdeal_germIdeal` — the germ ideal and its stalks: the
  whole stalk ideal generated by its members is exactly the native pulled ideal.
* `isCoherent_germIdeal` — if `B` is of finite type the germ ideal is coherent.
* `zeroLocus_germIdeal` — its zero locus is the preimage of the nonunit locus of `(B, b)`.
* `modelGermIdeal` and `map_wholeIdeal_modelGermIdeal` — the same dictionary for the whole
  model `(univ, 𝒪_W)` used by the native category.
* `map_wholeIdeal_pullback_modelGermIdeal` — pullback of germ ideals along a holomorphic map
  corresponds to the native pulled ideal along the composite.
* `exists_locallyFreeData_of_isInvertible`,
  `exists_locallyFreeData_of_pullback_isInvertible` — invertibility of the germ ideal gives
  rank-one locally free data for the native pulled ideal (the hypothesis of the native universal
  property of the blowup).
-/

set_option autoImplicit false

open Set Filter TopologicalSpace CategoryTheory Opposite AlgebraicGeometry
open scoped Topology Manifold ContDiff

namespace Hironaka.HironakaG10ChowGermIdealDictionary

open Hironaka.HolomorphicIdealSheaves
  HironakaSmoothCentreRealDomainActualSheafStalk HironakaActualAnalyticSubspace
  HironakaActualAnalyticSubspaceMaps HironakaActualAnalyticSubspaceManifoldCharts
  HironakaHolomorphicJetRankLoci
  HironakaSingularModuleSheafStalk HironakaNativePulledIdealSheaf HironakaNativePulledIdealStalk
  HironakaNativePulledIdealFiniteType HironakaSingularRankOneLocalGenerators
  HironakaSingularSubspaceBlowupCartier RestrictedIdealQuotient

noncomputable section

/-! ### Germs of holomorphic functions in the actual structure sheaf -/

section Germs

variable {n : ℕ} {M : Type} [TopologicalSpace M]
  [ChartedSpace (ComplexModel n) M] [IsComplexManifold n M]

/-- The germ depends only on the function near the point. -/
theorem originalGerm_congr (x : M) {f g : M → ℂ}
    (hf : HolomorphicAt n f x) (hg : HolomorphicAt n g x) (heq : f =ᶠ[𝓝 x] g) :
    actualOriginalFunctionGerm x f hf = actualOriginalFunctionGerm x g hg := by
  apply (actualStalkChartEquiv (n := n) x).injective
  rw [actualOriginalFunctionGerm_chart, actualOriginalFunctionGerm_chart]
  exact chartTranslatedGerm_congr_original x f g hf hg heq

/-- Equal germs come from functions which agree near the point. -/
theorem eventuallyEq_of_originalGerm_eq (x : M) {f g : M → ℂ}
    (hf : HolomorphicAt n f x) (hg : HolomorphicAt n g x)
    (h : actualOriginalFunctionGerm x f hf = actualOriginalFunctionGerm x g hg) :
    f =ᶠ[𝓝 x] g := by
  let F := (actualComplexStructureSheaf (n := n) M).presheaf
  obtain ⟨U, hxU, s, hs⟩ := exists_actual_section_of_original_holomorphicAt x f hf
  obtain ⟨V, hxV, t, ht⟩ := exists_actual_section_of_original_holomorphicAt x g hg
  rw [actualOriginalFunctionGerm_eq_section U x hxU s f hf hs,
    actualOriginalFunctionGerm_eq_section V x hxV t g hg ht] at h
  obtain ⟨Z, hxZ, iU, iV, heq⟩ := F.germ_eq x hxU hxV s t h
  filter_upwards [Z.isOpen.mem_nhds hxZ, hs, ht] with z hz hsf htg
  have hzU : z ∈ U := leOfHom iU hz
  have hzV : z ∈ V := leOfHom iV hz
  calc
    f z = sectionExtension U s z := hsf.symm
    _ = s ⟨z, hzU⟩ := sectionExtension_apply U s z hzU
    _ = (F.map iU.op s) ⟨z, hz⟩ := rfl
    _ = (F.map iV.op t) ⟨z, hz⟩ := congrArg (fun a => a ⟨z, hz⟩) heq
    _ = t ⟨z, hzV⟩ := rfl
    _ = sectionExtension V t z := (sectionExtension_apply V t z hzV).symm
    _ = g z := htg

/-- Every element of the actual stalk is the germ of a holomorphic function. -/
theorem exists_originalGerm_eq (x : M) (r : actualComplexStructureStalk (n := n) x) :
    ∃ (f : M → ℂ) (hf : HolomorphicAt n f x), actualOriginalFunctionGerm x f hf = r := by
  obtain ⟨U, hxU, s, hr⟩ := (actualComplexStructureSheaf (n := n) M).presheaf.exists_germ_eq r
  exact ⟨sectionExtension U s, sectionExtension_holomorphicAt U s x hxU,
    (actualOriginalFunctionGerm_eq_section U x hxU s (sectionExtension U s)
      (sectionExtension_holomorphicAt U s x hxU) Filter.EventuallyEq.rfl).trans hr⟩

theorem originalGerm_mul (x : M) (f g : M → ℂ)
    (hf : HolomorphicAt n f x) (hg : HolomorphicAt n g x) :
    actualOriginalFunctionGerm x (fun z => f z * g z) (hf.mul hg) =
      actualOriginalFunctionGerm x f hf * actualOriginalFunctionGerm x g hg := by
  apply (actualStalkChartEquiv (n := n) x).injective
  rw [map_mul, actualOriginalFunctionGerm_chart, actualOriginalFunctionGerm_chart,
    actualOriginalFunctionGerm_chart]
  rfl

theorem originalGerm_one (x : M) :
    actualOriginalFunctionGerm x (fun _ => (1 : ℂ)) (holomorphicAt_const (n := n) (x := x) 1) =
      1 := by
  apply (actualStalkChartEquiv (n := n) x).injective
  rw [map_one, actualOriginalFunctionGerm_chart]
  rfl

/-- The germ of a finite sum of products is the sum of the products of the germs. -/
theorem originalGerm_sum_mul (x : M) {N : ℕ} (a s : Fin N → M → ℂ)
    (ha : ∀ i, HolomorphicAt n (a i) x) (hs : ∀ i, HolomorphicAt n (s i) x)
    (h : HolomorphicAt n (fun z => ∑ i, a i z * s i z) x) :
    actualOriginalFunctionGerm x (fun z => ∑ i, a i z * s i z) h =
      ∑ i, actualOriginalFunctionGerm x (a i) (ha i) *
        actualOriginalFunctionGerm x (s i) (hs i) := by
  apply (actualStalkChartEquiv (n := n) x).injective
  rw [map_sum]
  simp only [map_mul, actualOriginalFunctionGerm_chart]
  refine HolGerm.mk_sum Finset.univ _ (fun i => ?_)
  exact eventually_differentiableAt_mul
    (translated_holomorphic _ (CartanLocalReduction.holAt_comp_chart_symm
      (mem_chart_source (ComplexModel n) x) (ha i)))
    (translated_holomorphic _ (CartanLocalReduction.holAt_comp_chart_symm
      (mem_chart_source (ComplexModel n) x) (hs i)))

/-- A germ which does not vanish at the point is a unit. -/
theorem isUnit_originalGerm (x : M) {f : M → ℂ} (hf : HolomorphicAt n f x) (hx : f x ≠ 0) :
    IsUnit (actualOriginalFunctionGerm x f hf) := by
  rw [← isUnit_map_iff (actualStalkChartEquiv (n := n) x), actualOriginalFunctionGerm_chart,
    HolGerm.isUnit_iff_eval_ne_zero]
  change f ((chartAt (ComplexModel n) x).symm (0 + chartAt (ComplexModel n) x x)) ≠ 0
  rw [zero_add, (chartAt (ComplexModel n) x).left_inv (mem_chart_source (ComplexModel n) x)]
  exact hx

end Germs

/-! ### The germ ideal of a native pulled ideal -/

section Dictionary

variable {m : ℕ} {W : Type} [TopologicalSpace W]
  [ChartedSpace (ComplexModel m) W] [IsComplexManifold m W]
  {Y : LocallyRingedSpace.{0}}
  (B : SheafOfModules.{0} (forgetRing Y.toSheafedSpace.sheaf))
  (b : B ⟶ SheafOfModules.unit (forgetRing Y.toSheafedSpace.sheaf))

/-- The germ ideal of the native pulled ideal of `(B, b)` along a morphism out of the native
locally ringed space of a complex manifold: a holomorphic germ belongs to it at `x` when its
germ lies in `J_x = F^{-1}(b B) · 𝒪_{W,x}`. -/
def germIdeal (F : ChartedSpace.locallyRingedSpace 𝓘(ℂ, ComplexModel m) W ⟶ Y) :
    GermIdeal m W where
  mem x g := ∃ hg : HolomorphicAt m g x,
    actualOriginalFunctionGerm x g hg ∈ nativePulledIdealStalkIdeal F B b x

/-- **The stalks of the germ ideal are the native pulled ideals.** -/
theorem actualWholeSheafStalkIdeal_germIdeal
    (F : ChartedSpace.locallyRingedSpace 𝓘(ℂ, ComplexModel m) W ⟶ Y) (x : W) :
    actualWholeSheafStalkIdeal (germIdeal B b F) x = nativePulledIdealStalkIdeal F B b x := by
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro _ ⟨g, hg, ⟨hg', hmem⟩, rfl⟩
    exact hmem
  · intro r hr
    obtain ⟨g, hg, rfl⟩ := exists_originalGerm_eq x r
    exact Ideal.subset_span ⟨g, hg, ⟨hg, hr⟩, rfl⟩

/-- **Coherence.**  The germ ideal of the native pulled ideal of a finite-type ideal is
coherent: near every point it is generated by the pull-backs of finitely many local
generators. -/
theorem isCoherent_germIdeal [B.IsFiniteType]
    (F : ChartedSpace.locallyRingedSpace 𝓘(ℂ, ComplexModel m) W ⟶ Y) :
    (germIdeal B b F).IsCoherent := by
  intro x
  obtain ⟨V, hxV, r, s, -, hspan⟩ := exists_local_finite_pulled_generators F B b x
  let U : Opens W := (Opens.map F.base).obj V
  let u : Fin r → actualComplexSection (n := m) U := fun i =>
    (nativePulledIdealSection F B b V (s i)).val
  have hJ : ∀ (y : W) (hy : y ∈ U), nativePulledIdealStalkIdeal F B b y =
      Ideal.span (range fun i => actualOriginalFunctionGerm y (sectionExtension U (u i))
        (sectionExtension_holomorphicAt U (u i) y hy)) := by
    intro y hy
    rw [← nativePulledIdealStalkInclusion_range]
    refine (hspan y hy).trans ?_
    congr 2
    funext i
    exact (actualOriginalFunctionGerm_eq_section U y hy (u i) _ _
      Filter.EventuallyEq.rfl).symm
  refine ⟨U, U.isOpen, hxV, r, fun i => sectionExtension U (u i), ?_, ?_⟩
  · intro i z hz
    exact ((sectionExtension_contMDiffAt U (u i) z hz).mdifferentiableAt
      (by simp)).mdifferentiableWithinAt
  · intro y hy g
    have hsu : ∀ i, HolomorphicAt m (sectionExtension U (u i)) y := fun i =>
      sectionExtension_holomorphicAt U (u i) y hy
    constructor
    · rintro ⟨hg, hmem⟩
      rw [hJ y hy] at hmem
      obtain ⟨c, hc⟩ := (Ideal.mem_span_range_iff_exists_fun).mp hmem
      choose a ha hac using fun i => exists_originalGerm_eq y (c i)
      have hsum : HolomorphicAt m (fun z => ∑ i, a i z * sectionExtension U (u i) z) y :=
        HolomorphicAt.sum _ fun i _ => (ha i).mul (hsu i)
      refine ⟨hg, r, fun i => sectionExtension U (u i), a, fun i => ⟨i, rfl⟩, ha, ?_⟩
      apply eventuallyEq_of_originalGerm_eq y hg hsum
      rw [originalGerm_sum_mul y a _ ha hsu hsum, ← hc]
      simp only [hac]
    · rintro ⟨hg, N, t, a, ht, ha, hsum⟩
      refine ⟨hg, ?_⟩
      rw [hJ y hy]
      choose k hk using ht
      have hk' : ∀ j, sectionExtension U (u (k j)) = t j := hk
      have htu : ∀ j, HolomorphicAt m (t j) y := fun j => (hk' j) ▸ hsu (k j)
      have hsum' : HolomorphicAt m (fun z => ∑ j, a j z * t j z) y :=
        HolomorphicAt.sum _ fun j _ => (ha j).mul (htu j)
      rw [originalGerm_congr y hg hsum' hsum, originalGerm_sum_mul y a t ha htu hsum']
      refine Ideal.sum_mem _ fun j _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨k j, ?_⟩)
      exact originalGerm_congr y (hsu (k j)) (htu j) (by rw [hk' j])

/-- **Zero locus.**  The zero locus of the germ ideal is the preimage of the nonunit locus of
`(B, b)`. -/
theorem zeroLocus_germIdeal
    (F : ChartedSpace.locallyRingedSpace 𝓘(ℂ, ComplexModel m) W ⟶ Y) :
    (germIdeal B b F).zeroLocus = F.base ⁻¹' {y | LinearMap.range
      (stalkInclusionLinearMap Y.toSheafedSpace.sheaf B b y) ≠ ⊤} := by
  ext x
  simp only [GermIdeal.zeroLocus, mem_ofPred_eq, mem_preimage]
  constructor
  · intro hx htop
    have hJ : nativePulledIdealStalkIdeal F B b x = ⊤ := by
      change Ideal.map (F.stalkMap x).hom _ = ⊤
      rw [htop]
      exact Ideal.map_top _
    have h1 := hx (fun _ => 1) ⟨holomorphicAt_const 1, by rw [hJ]; trivial⟩
    exact one_ne_zero h1
  · intro hne g ⟨hg, hmem⟩
    by_contra hgx
    have hunit := isUnit_originalGerm x hg hgx
    have hle : nativePulledIdealStalkIdeal F B b x ≤
        IsLocalRing.maximalIdeal ((ChartedSpace.locallyRingedSpace 𝓘(ℂ, ComplexModel m) W).presheaf.stalk x) := by
      apply Ideal.map_le_iff_le_comap.mpr
      intro a ha
      have : IsLocalRing ↑(TopCat.Presheaf.stalk Y.toSheafedSpace.sheaf.obj (F.base x)) :=
        Y.isLocalRing (F.base x)
      exact map_nonunit (F.stalkMap x).hom a
        (IsLocalRing.le_maximalIdeal hne ha)
    exact (IsLocalRing.mem_maximalIdeal _).mp (hle hmem) hunit

/-! ### The whole model `(univ, 𝒪_W)` -/

/-- The point of the whole model over `x`. -/
abbrev modelPoint (x : W) : (univ : Set W) := ⟨x, mem_univ x⟩

/-- The germ ideal of the native pulled ideal along a morphism out of the whole model
`(univ, 𝒪_W)` of the manifold (the locally ringed space underlying the native whole model). -/
def modelGermIdeal (F : actualSubspaceLocallyRingedSpace (n := m) (univ : Set W) ⟶ Y) :
    GermIdeal m W :=
  germIdeal B b ((actualSubspaceUnivIso (n := m) (M := W)).inv ≫ F)

theorem isCoherent_modelGermIdeal [B.IsFiniteType]
    (F : actualSubspaceLocallyRingedSpace (n := m) (univ : Set W) ⟶ Y) :
    (modelGermIdeal B b F).IsCoherent :=
  isCoherent_germIdeal B b _

private theorem univIso_inv_base (x : W) :
    (actualSubspaceUnivIso (n := m) (M := W)).inv.base x = modelPoint x := by
  have h := congrArg (fun H => H.base x)
    (actualSubspaceUnivIso (n := m) (M := W)).inv_hom_id
  apply Subtype.ext
  exact h

/-- Zero locus of the model germ ideal. -/
theorem zeroLocus_modelGermIdeal
    (F : actualSubspaceLocallyRingedSpace (n := m) (univ : Set W) ⟶ Y) :
    (modelGermIdeal B b F).zeroLocus = {x | LinearMap.range
      (stalkInclusionLinearMap Y.toSheafedSpace.sheaf B b (F.base (modelPoint x))) ≠ ⊤} := by
  unfold modelGermIdeal
  rw [zeroLocus_germIdeal]
  ext x
  simp only [mem_preimage, LocallyRingedSpace.comp_base, TopCat.comp_app, univIso_inv_base]
  exact Iff.rfl

/-- Native pulled ideals compose through the stalk maps. -/
theorem nativePulledIdealStalkIdeal_comp {A A' : LocallyRingedSpace.{0}}
    (q : A ⟶ A') (F : A' ⟶ Y) (x : A) :
    nativePulledIdealStalkIdeal (q ≫ F) B b x =
      Ideal.map (q.stalkMap x).hom (nativePulledIdealStalkIdeal F B b (q.base x)) := by
  let A := LinearMap.range (stalkInclusionLinearMap Y.toSheafedSpace.sheaf B b (F.base (q.base x)))
  have hMap := Ideal.map_map (I := A) (F.stalkMap (q.base x)).hom (q.stalkMap x).hom
  have hComp : ((q ≫ F).stalkMap x).hom = (q.stalkMap x).hom.comp (F.stalkMap (q.base x)).hom :=
    congrArg CommRingCat.Hom.hom (LocallyRingedSpace.stalkMap_comp (f := q) (g := F) x)
  calc
    nativePulledIdealStalkIdeal (q ≫ F) B b x =
        Ideal.map ((q.stalkMap x).hom.comp (F.stalkMap (q.base x)).hom) A :=
      congrArg (fun f => Ideal.map f A) hComp
    _ = _ := hMap.symm

/-- **The stalks of the model germ ideal are the native pulled ideals.** -/
theorem map_wholeIdeal_modelGermIdeal
    (F : actualSubspaceLocallyRingedSpace (n := m) (univ : Set W) ⟶ Y) (x : (univ : Set W)) :
    Ideal.map ((actualSubspaceInclusion (n := m) (univ : Set W)).stalkMap x).hom
      (actualWholeSheafStalkIdeal (modelGermIdeal B b F) x.val) =
        nativePulledIdealStalkIdeal F B b x := by
  have hF : actualSubspaceInclusion (n := m) (univ : Set W) ≫
      ((actualSubspaceUnivIso (n := m) (M := W)).inv ≫ F) = F :=
    (actualSubspaceUnivIso (n := m) (M := W)).hom_inv_id_assoc F
  conv_rhs => rw [← hF]
  rw [nativePulledIdealStalkIdeal_comp]
  unfold modelGermIdeal
  rw [actualWholeSheafStalkIdeal_germIdeal]
  rfl

/-- **Pullback.**  For a holomorphic map `σ : W' → W`, the germ ideal of the pull-back of the
model germ ideal corresponds to the native pulled ideal along the composite. -/
theorem map_wholeIdeal_pullback_modelGermIdeal [B.IsFiniteType]
    (F : actualSubspaceLocallyRingedSpace (n := m) (univ : Set W) ⟶ Y)
    {m' : ℕ} {W' : Type} [TopologicalSpace W'] [ChartedSpace (ComplexModel m') W']
    [IsComplexManifold m' W'] {σ : W' → W}
    (hσ : ContMDiff 𝓘(ℂ, ComplexModel m') 𝓘(ℂ, ComplexModel m) ∞ σ) (x : (univ : Set W')) :
    Ideal.map ((actualSubspaceInclusion (n := m') (univ : Set W')).stalkMap x).hom
      (actualWholeSheafStalkIdeal (GermIdeal.pullback (m := m') σ (modelGermIdeal B b F))
        x.val) =
      nativePulledIdealStalkIdeal
        (actualSubspaceMap hσ (fun y (_ : y ∈ (univ : Set W')) => mem_univ (σ y)) ≫ F) B b x := by
  rw [nativePulledIdealStalkIdeal_comp,
    ← map_wholeIdeal_modelGermIdeal B b F]
  exact (map_actualSubspace_stalk_ideal_pullback hσ
    (fun y (_ : y ∈ (univ : Set W')) => mem_univ (σ y))
    (modelGermIdeal B b F) (isCoherent_modelGermIdeal B b F) x).symm

/-- **Invertibility gives rank-one locally free data.**  If an invertible germ ideal on `W` has
the native pulled ideal of `(B, b)` along `G` as its stalks, the native pulled ideal module has
rank-one locally free local generators. -/
theorem exists_locallyFreeData_of_isInvertible
    (G : actualSubspaceLocallyRingedSpace (n := m) (univ : Set W) ⟶ Y)
    (𝔠 : GermIdeal m W) (h𝔠 : 𝔠.IsInvertible)
    (hmap : ∀ x : (univ : Set W),
      Ideal.map ((actualSubspaceInclusion (n := m) (univ : Set W)).stalkMap x).hom
        (actualWholeSheafStalkIdeal 𝔠 x.val) = nativePulledIdealStalkIdeal G B b x) :
    ∃ q : (nativePulledIdealModule G B b).LocalGeneratorsData.{0},
      q.IsLocallyFreeData ∧ ∀ i, Nonempty (Unique (q.generators i).I) := by
  classical
  let L := actualSubspaceLocallyRingedSpace (n := m) (univ : Set W)
  let ι := actualSubspaceInclusion (n := m) (univ : Set W)
  have hA : IsInvertibleAlong m (univ : Set W) 𝔠 := by
    intro x _
    obtain ⟨U, hU, hxU, h, hh, hnon, hgen⟩ := h𝔠 x
    refine ⟨U, hU, hxU, h, hh, ?_, hgen⟩
    intro V hV hVU hne
    obtain ⟨y, hyV, hy⟩ := hnon V hV hVU (by simpa only [inter_univ] using hne)
    exact ⟨y, ⟨hyV, mem_univ y⟩, hy⟩
  have hgen : ∀ x : L, ∃ (U : Opens L.toTopCat) (_ : x ∈ U)
      (s : nativePulledIdealSectionIdeal G B b U),
      ∀ (y : L) (hy : y ∈ U),
        nativePulledIdealStalkIdeal G B b y = Ideal.span {L.presheaf.germ U y hy s.val} ∧
          IsRegular (L.presheaf.germ U y hy s.val) := by
    intro x
    obtain ⟨V, hxV, a, ha⟩ := exists_local_actual_cartier_generator hA x
    let U : Opens L.toTopCat := (Opens.map ι.base).obj V
    let s₀ : (L.presheaf.obj (op U)).carrier := ι.c.app (op V) a
    have hg : ∀ (y : L) (hy : y ∈ U),
        nativePulledIdealStalkIdeal G B b y = Ideal.span {L.presheaf.germ U y hy s₀} ∧
          IsRegular (L.presheaf.germ U y hy s₀) := by
      intro y hy
      have hgerm : L.presheaf.germ U y hy s₀ =
          ι.stalkMap y ((actualComplexStructureSheaf (n := m) W).presheaf.germ V y.val hy a) :=
        (LocallyRingedSpace.stalkMap_germ_apply ι V y hy a).symm
      rw [hgerm, ← hmap y]
      exact ha y hy
    have hs₀ : s₀ ∈ nativePulledIdealSectionIdeal G B b U := by
      intro y hy
      rw [(hg y hy).1]
      exact Ideal.subset_span (Set.mem_singleton _)
    exact ⟨U, hxV, ⟨s₀, hs₀⟩, hg⟩
  choose U hxU s hs using hgen
  exact exists_locallyFreeData_of_regular_sections L.toSheafedSpace.sheaf
    (nativePulledIdealInclusion G B b) (fun _ => Subtype.val_injective)
    U (fun x => ⟨x, hxU x⟩) s (fun i y hy => (hs i y hy).2)
    (fun i y hy => (nativePulledIdealStalkInclusion_range G B b y).trans (hs i y hy).1)

/-- **The dictionary for the native universal property.**  If the pull-back along a
holomorphic map `σ : W' → W` of the model germ ideal of `(B, b)` along `F` is invertible, the
native pulled ideal of `(B, b)` along the composite has rank-one locally free data. -/
theorem exists_locallyFreeData_of_pullback_isInvertible [B.IsFiniteType]
    (F : actualSubspaceLocallyRingedSpace (n := m) (univ : Set W) ⟶ Y)
    {m' : ℕ} {W' : Type} [TopologicalSpace W'] [ChartedSpace (ComplexModel m') W']
    [IsComplexManifold m' W'] {σ : W' → W}
    (hσ : ContMDiff 𝓘(ℂ, ComplexModel m') 𝓘(ℂ, ComplexModel m) ∞ σ)
    (hinv : (GermIdeal.pullback (m := m') σ (modelGermIdeal B b F)).IsInvertible) :
    ∃ q : (nativePulledIdealModule
        (actualSubspaceMap hσ (fun y (_ : y ∈ (univ : Set W')) => mem_univ (σ y)) ≫ F)
        B b).LocalGeneratorsData.{0},
      q.IsLocallyFreeData ∧ ∀ i, Nonempty (Unique (q.generators i).I) :=
  exists_locallyFreeData_of_isInvertible B b _ _ hinv
    (map_wholeIdeal_pullback_modelGermIdeal B b F hσ)

end Dictionary

end

end Hironaka.HironakaG10ChowGermIdealDictionary
