import Hironaka.Resolution.HironakaG10LinearCurveFlatness
import Hironaka.Resolution.HironakaG10LinearCurveMatrixPullback
import Hironaka.Resolution.HironakaG10FibreRegularCriterion

/-!
# Actual structure-algebra flatness from an exact special fibre

A one-row holomorphic matrix and a finite holomorphic matrix of relations
whose special fibre is exact define a quotient algebra flat over the actual
smooth-base germ ring. The total complex need not be exact. The conclusion
uses the entire ideal generated by the original row, without radicalization.
-/

set_option autoImplicit false

open Set Filter
open scoped Topology

namespace Hironaka.HironakaG10SmoothBaseMatrixFlatness

noncomputable section

open HironakaRelativeNormalIdeal HironakaActualCentreJointJets
  HironakaG10FlatResolutionStart
  OkaRelationSheaf HironakaG10FlatSliceResolution HironakaG10FibreRegularCriterion
  HironakaG10HirChartFlattener HironakaG10CurveChartQuotient
  HironakaG10LinearCurveFlatness HironakaG10LinearCurveMatrixPullback

/-- Exactness on the actual special fibre of a holomorphic complex ending in
one row forces actual structure-algebra flatness over every smooth base. -/
theorem chartMap_entryIdeal_flat_of_specialFibreExact {b c : ℕ} (d t : ℕ)
    (F : Fin 1 → Fin b → ComplexModel (d + t) → ℂ)
    (G : Fin b → Fin c → ComplexModel (d + t) → ℂ)
    (hF : ∀ i j, HolAt (F i j) 0)
    (hG : ∀ j k, HolAt (G j k) 0)
    (hcomp : ∀ i k, ∀ᶠ x in 𝓝 (0 : ComplexModel (d + t)),
      ∑ j, F i j x * G j k x = 0)
    (hfib : ∀ a : Fin b → ComplexModel t → ℂ,
      IsRelationAt (fun i j z => F i j (actualJointNormalInclusion d t z)) 0 a →
        IsCombinationAt
          (columns (fun j k z => G j k (actualJointNormalInclusion d t z))) 0 a) :
    (chartMap d t (HironakaG10LinearCurveMatrixPullback.entryIdeal d t F)).Flat := by
  apply (chartMap_flat_iff_forall_linear_curve d t _).mpr
  intro L
  rw [map_entryIdeal_eq_native d t L F hF]
  apply chartMap_nativeEntryIdeal_flat_of_regularAt t (curveFamily d t L F)
    (holAt_curveFamily d t L F hF)
  apply regularAt_of_slice_exact
    (holAt_productFamily t _ (holAt_curveFamily d t L F hF))
    (holAt_productFamily t _ (holAt_curveFamily d t L G hG))
    (zero_comp_curveProductFamily d t L F G hcomp)
  exact fibre_exact_curveProductFamily d t L F G hfib

end

end Hironaka.HironakaG10SmoothBaseMatrixFlatness
