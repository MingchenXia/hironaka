import Hironaka.Resolution.HironakaActualTaylorFaithfullyFlat

/-! Whole original ideal intersections under the genuine Taylor embedding. -/
set_option autoImplicit false
open Set Classical
namespace Hironaka.HironakaActualFormalIdealIntersections
noncomputable section
open HolGerm HironakaActualOriginalFormalTaylor HironakaActualTaylorFaithfullyFlat

private theorem actual_extension_finite_expression (n : ℕ)
    (I : Ideal (HolGerm (ComplexModel (0+n)))) (F : MvPowerSeries (Fin n) ℂ)
    (hF : F ∈ Ideal.map (originalTaylorAlgHom n).toRingHom I) :
    ∃ (r : ℕ) (G : Fin r → HolGerm (ComplexModel (0+n)))
      (A : Fin r → MvPowerSeries (Fin n) ℂ),
      (∀ i,G i ∈ I) ∧ F=∑ i,originalTaylorAlgHom n (G i)*A i := by
  let := isNoetherianRing_holGerm_euclidean (0+n)
  obtain ⟨r,G,hG⟩ := Submodule.fg_iff_exists_fin_generating_family.mp (IsNoetherian.noetherian I)
  have hspan : Ideal.span (range G)=I := hG
  have hmap : Ideal.map (originalTaylorAlgHom n).toRingHom I=
      Ideal.span (range fun i => originalTaylorAlgHom n (G i)) := by
    rw [← hspan,Ideal.map_span,← Set.range_comp]
    rfl
  rw [hmap] at hF
  obtain ⟨A,hA⟩ := Ideal.mem_span_range_iff_exists_fun.mp hF
  refine ⟨r,G,A,?_,?_⟩
  · intro i
    rw [← hspan]
    exact Ideal.mem_span_range_self (x := i)
  · simpa only [mul_comm] using hA.symm

/-- EVERY common formal member is generated by actual original intersection elements. -/
theorem map_inf_originalTaylorAlgHom (n : ℕ)
    (I J : Ideal (HolGerm (ComplexModel (0+n)))) :
    Ideal.map (originalTaylorAlgHom n).toRingHom (I⊓J)=
      Ideal.map (originalTaylorAlgHom n).toRingHom I ⊓
        Ideal.map (originalTaylorAlgHom n).toRingHom J := by
  apply le_antisymm
  · exact le_inf (Ideal.map_mono inf_le_left) (Ideal.map_mono inf_le_right)
  · intro F hF
    obtain ⟨r,G,A,hGI,hA⟩ := actual_extension_finite_expression n I F hF.1
    obtain ⟨s,H,D,hHJ,hD⟩ := actual_extension_finite_expression n J F hF.2
    let L := Fin.append G H
    let V := Fin.append A (fun l => -D l)
    have hrel : (∑ i,originalTaylorAlgHom n (L i)*V i)=0 := by
      simp only [L,V,Fin.sum_univ_add,Fin.append_left,Fin.append_right,mul_neg,
        Finset.sum_neg_distrib,← hA,← hD,add_neg_cancel]
    obtain ⟨k,c,B,hc,hL⟩ :=
      (actual_formal_relation_iff_original_syzygies n (r+s) L V).mp hrel
    let K := fun j : Fin k => ∑ i : Fin r,G i*c (i.castAdd s) j
    have hKI : ∀ j,K j ∈ I := by
      intro j
      exact Ideal.sum_mem _ fun i _ => Ideal.mul_mem_right _ _ (hGI i)
    have hKJ : ∀ j,K j ∈ J := by
      intro j
      have he : K j + ∑ l : Fin s,H l*c (l.natAdd r) j=0 := by
        simpa only [K,L,Fin.sum_univ_add,Fin.append_left,Fin.append_right] using hL j
      rw [eq_neg_of_add_eq_zero_left he]
      exact J.neg_mem (Ideal.sum_mem _ fun l _ => Ideal.mul_mem_right _ _ (hHJ l))
    have hcoeff : ∀ i : Fin r,A i=∑ j,originalTaylorAlgHom n (c (i.castAdd s) j)*B j := by
      intro i
      simpa only [V,Fin.append_left] using hc (i.castAdd s)
    have he : F=∑ j,originalTaylorAlgHom n (K j)*B j := by
      rw [hA]
      simp_rw [hcoeff,Finset.mul_sum]
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro j _
      simp only [K,map_sum,map_mul,Finset.sum_mul,mul_assoc]
    rw [he]
    exact Ideal.sum_mem _ fun j _ =>
      Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ ⟨hKI j,hKJ j⟩)

end
end Hironaka.HironakaActualFormalIdealIntersections
