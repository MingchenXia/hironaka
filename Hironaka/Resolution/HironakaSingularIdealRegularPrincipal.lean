import Mathlib.RingTheory.PicardGroup
import Mathlib.Algebra.Regular.Defs

/-! An actual ideal generated by a regular element is a native invertible
module. The multiplication equivalence uses the SAME supplied generator;
commutative rings with zero divisors and the zero ring are included. -/
set_option autoImplicit false

namespace Hironaka.HironakaSingularIdealRegularPrincipal
noncomputable section

variable {R : Type*} [CommRing R]

/-- Multiplication by the SAME regular principal generator identifies the
actual ideal module with its base ring, without any domain hypothesis. -/
def regularPrincipalEquiv (I : Ideal R) {alpha : R}
    (hspan : I=Ideal.span {alpha}) (hreg : IsRegular alpha) : R ≃ₗ[R] I := by
  let m : R →ₗ[R] I:=
    { toFun:=fun r=>⟨r*alpha,by
        rw [hspan]
        exact Ideal.mul_mem_left _ r (Ideal.mem_span_singleton_self alpha)⟩
      map_add':=by
        intro r s
        apply Subtype.ext
        exact add_mul r s alpha
      map_smul':=by
        intro r s
        apply Subtype.ext
        exact mul_assoc r s alpha }
  apply LinearEquiv.ofBijective m
  constructor
  · intro r s h
    apply hreg.right
    exact congrArg Subtype.val h
  · intro x
    have hx : (x : R)∈Ideal.span {alpha}:=hspan ▸ x.property
    obtain ⟨r,hr⟩:=Ideal.mem_span_singleton'.mp hx
    exact ⟨r,Subtype.ext hr⟩

/-- The native Mathlib invertible-module structure of the SAME actual ideal,
derived from its regular principal generator through the real linear map. -/
theorem moduleInvertible_of_span_eq (I : Ideal R) {alpha : R}
    (hspan : I=Ideal.span {alpha}) (hreg : IsRegular alpha) : Module.Invertible R I :=
  Module.Invertible.congr (regularPrincipalEquiv I hspan hreg)

end
end Hironaka.HironakaSingularIdealRegularPrincipal
