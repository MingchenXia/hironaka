import Mathlib.RingTheory.LocalRing.RingHom.Basic
import Mathlib.RingTheory.Ideal.Maps
import Mathlib.Geometry.RingedSpace.LocallyRingedSpace
import Mathlib.Algebra.BigOperators.Ring.Finset
import Mathlib.Tactic.LinearCombination
import Mathlib.Tactic.Ring

/-!
# Fibre algebras of a strict transform: the algebraic core of the strict fibre decrease

Route steps N6 and (4.3) of the global half of Hironaka's flattening theorem
(`work/hironaka-resume-20261111/G10C/GLOBAL-FLATTENING-ROUTE.md` §3.3a, §4).  For a family
`f : Y → X` and a point `y` over `x`, the *fibre ideal* `m_x 𝒪_{Y,y}` is the ideal generated by the
image of the maximal ideal of the base; `𝒪_{Y,y}/m_x 𝒪_{Y,y}` is the local ring of the (possibly
non-reduced) fibre `f⁻¹(x)` at `y`.

Commutative square of local rings (`D = 𝒪_{X,x}`, `A = 𝒪_{Y,y}`, `C = 𝒪_{X',x'}`,
`B = 𝒪_{Y',y'}` for the strict transform `Y' → X'` of `f` under a blowup `X' → X`):

* `exists_sub_mem_fibreIdeal_of_ratio` (**N6, algebraic core**): if the generators `g_l` of the centre
  pull back to `X'` as `τ_l · ε`, the generators `g'_i` of the pulled ideal on `Y` are combinations of
  the `f^♯ g_l`, their pull-backs to `Y'` are `t_i · e` with `e` a nonzerodivisor (one of them, the
  pivot, equal to `e`), `p^♯ ε` is a multiple of `e`, the residue fields of `X` and `X'` agree, and the
  local ring of `Y'` is *analytically generated* over that of `Y` by the direction ratios `t_i`
  (every element is congruent to a pull-back modulo the ideal of the `t_i - q^♯ a_i`, for any
  `a_i` with the same values), then the fibre algebra of `Y'` at `y'` is a quotient of the fibre algebra
  of `Y` at `y`: `𝒪_{Y,y} → 𝒪_{Y',y'}/m_{x'} 𝒪_{Y',y'}` is surjective.  The direction ratios are
  congruent to pull-backs modulo `m_{x'}` because their `X'`-side counterparts `τ_l` are constant
  modulo `m_{x'}` (the Hironaka–Rydh computation behind the closed embedding of fibres of
  `Y' → Y ×_X X'`).
* `map_mem_fibreIdeal_of_torsion` (**Rydh Lemma 1.18, transport**): a torsion element `h` of the
  base-changed family (`κ(a) · h = 0`) restricting to `h₀` on the closed fibre is killed in the fibre
  algebra of the strict transform as soon as `p^♯ a` is a nonzerodivisor there.
* Chains (`chainMap`, `chainKernel`): along a sequence of such steps the kernels of
  `A₀ → A_n / I_n` increase (`chainKernel_mono`); if every step is surjective modulo the fibre ideals,
  so is every composite (`exists_sub_mem_chain`), and a non-injective step makes the kernel grow
  strictly (`chainKernel_lt`).
* Locally ringed spaces: `lrsFibreIdeal` and its behaviour under composition (`lrsFibreIdeal_comp`,
  `lrsFibreIdeal_comp_le`, `map_lrsFibreIdeal_le_of_comm`).
-/

set_option autoImplicit false

open IsLocalRing CategoryTheory

namespace Hironaka.HironakaG10ChowFibreAlgebra

noncomputable section

section Square

variable {D A C B : Type*} [CommRing D] [CommRing A] [CommRing C] [CommRing B]

/-- The **fibre ideal** of `f : D → A`: the ideal generated by the image of the maximal ideal of the
base (the ideal of the closed fibre). -/
def fibreIdeal [IsLocalRing D] (f : D →+* A) : Ideal A :=
  Ideal.map f (maximalIdeal D)

theorem fibreIdeal_le_maximalIdeal [IsLocalRing D] [IsLocalRing A] (f : D →+* A) [IsLocalHom f] :
    fibreIdeal f ≤ maximalIdeal A :=
  Ideal.map_le_iff_le_comap.mpr fun x hx => map_nonunit f x hx

theorem fibreIdeal_ne_top [IsLocalRing D] [IsLocalRing A] (f : D →+* A) [IsLocalHom f] :
    fibreIdeal f ≠ ⊤ :=
  fun h => (maximalIdeal.isMaximal A).ne_top (top_le_iff.mp (h ▸ fibreIdeal_le_maximalIdeal f))

/-- In a local ring, an element congruent to a unit modulo the maximal ideal is a unit. -/
theorem isUnit_of_sub_mem_maximalIdeal [IsLocalRing B] {s r : B} (hs : IsUnit s)
    (h : s - r ∈ maximalIdeal B) : IsUnit r := by
  have hs' : IsUnit (r + (s - r)) := by simpa using hs
  rcases IsLocalRing.isUnit_or_isUnit_of_isUnit_add hs' with h1 | h1
  · exact h1
  · exact absurd h1 ((IsLocalRing.mem_maximalIdeal _).mp h)

/-- The fibre ideal of a composite is the image of the fibre ideal of the second map. -/
theorem fibreIdeal_comp [IsLocalRing D] (f : D →+* A) (q : A →+* B) :
    fibreIdeal (q.comp f) = Ideal.map q (fibreIdeal f) := by
  rw [fibreIdeal, fibreIdeal, Ideal.map_map]

/-- **Fibre ideals map into fibre ideals along a commutative square** `q ∘ f = p ∘ σ` with `σ`
local. -/
theorem map_fibreIdeal_le [IsLocalRing D] [IsLocalRing C] (f : D →+* A) (σ : D →+* C)
    (q : A →+* B) (p : C →+* B) [IsLocalHom σ] (hsq : ∀ d, q (f d) = p (σ d)) :
    Ideal.map q (fibreIdeal f) ≤ fibreIdeal p := by
  rw [← fibreIdeal_comp, fibreIdeal, Ideal.map_le_iff_le_comap]
  intro d hd
  rw [Ideal.mem_comap, RingHom.comp_apply, hsq]
  exact Ideal.mem_map_of_mem p (map_nonunit σ d hd)

/-- **Fibre-algebra surjectivity from ratio generation** (route step N6, algebraic core). -/
theorem exists_sub_mem_fibreIdeal_of_ratio [IsLocalRing A] [IsLocalRing C] [IsLocalRing B]
    (f : D →+* A) (σ : D →+* C) (q : A →+* B) (p : C →+* B) [IsLocalHom q] [IsLocalHom p]
    (hsq : ∀ d, q (f d) = p (σ d))
    {ι κ : Type*} [Fintype ι] (g : ι → D) (τ : ι → C) (ε : C) (hσg : ∀ l, σ (g l) = τ l * ε)
    (g' : κ → A) (M : κ → ι → A) (hg' : ∀ i, g' i = ∑ l, M i l * f (g l))
    (e : B) (he : IsRegular e) (t : κ → B) (ht : ∀ i, q (g' i) = t i * e) (j : κ)
    (hj : q (g' j) = e) (lam : B) (hlam : p ε = lam * e)
    (hres : ∀ c : C, ∃ d : D, c - σ d ∈ maximalIdeal C)
    (hgen : ∀ (b : B) (a : κ → A), (∀ i, t i - q (a i) ∈ maximalIdeal B) →
      ∃ a₀ : A, b - q a₀ ∈ Ideal.span (Set.range fun i => t i - q (a i)))
    (b : B) : ∃ a₀ : A, b - q a₀ ∈ fibreIdeal p := by
  classical
  -- the ratios on the `Y'` side in terms of the `X'` side
  set s : κ → B := fun i => ∑ l, q (M i l) * p (τ l) with hs
  have hts : ∀ i, t i = lam * s i := by
    intro i
    apply he.right
    change t i * e = (lam * s i) * e
    rw [← ht i, hg' i, map_sum]
    simp only [map_mul, hsq, hσg, hlam, hs, Finset.mul_sum, Finset.sum_mul]
    refine Finset.sum_congr rfl fun l _ => ?_
    ring
  -- the `X'`-side ratios are constant modulo the maximal ideal
  choose d hd using fun l => hres (τ l)
  set u : κ → A := fun i => ∑ l : ι, M i l * f (d l) with hu
  have hsu : ∀ i, s i - q (u i) ∈ fibreIdeal p := by
    intro i
    have h1 : s i - q (u i) = ∑ l, q (M i l) * p (τ l - σ (d l)) := by
      simp only [hs, hu, map_sum, map_mul, hsq, map_sub, mul_sub, Finset.sum_sub_distrib]
    rw [h1]
    exact Submodule.sum_mem _ fun l _ => Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem p (hd l))
  -- the pivot
  have htj : t j = 1 := he.right (show t j * e = 1 * e by rw [← ht j, hj, one_mul])
  have hls : lam * s j = 1 := (hts j).symm.trans htj
  have hsj : IsUnit (s j) := IsUnit.of_mul_eq_one lam (by rw [mul_comm]; exact hls)
  have hquj : IsUnit (q (u j)) :=
    isUnit_of_sub_mem_maximalIdeal hsj (fibreIdeal_le_maximalIdeal p (hsu j))
  have huj : IsUnit (u j) := isUnit_of_map_unit q (u j) hquj
  obtain ⟨w, hw⟩ := huj.exists_right_inv
  have hqw : q (u j) * q w = 1 := by rw [← map_mul, hw, map_one]
  set a : κ → A := fun i => u i * w with ha
  have hta : ∀ i, t i - q (a i) ∈ fibreIdeal p := by
    intro i
    have h1 : t i - q (a i) =
        lam * q w * (s j * (s i - q (u i)) - s i * (s j - q (u j))) := by
      rw [ha, map_mul, hts i]
      linear_combination (-(lam * s i)) * hqw + (q (u i) * q w) * hls
    rw [h1]
    exact Ideal.mul_mem_left _ _ (Ideal.sub_mem _ (Ideal.mul_mem_left _ _ (hsu i))
      (Ideal.mul_mem_left _ _ (hsu j)))
  obtain ⟨a₀, ha₀⟩ := hgen b a fun i => fibreIdeal_le_maximalIdeal p (hta i)
  refine ⟨a₀, ?_⟩
  refine (Ideal.span_le.mpr ?_) ha₀
  rintro _ ⟨i, rfl⟩
  exact hta i

/-- The fibre-algebra map `A → B / m_{x'} B` of `exists_sub_mem_fibreIdeal_of_ratio` is
surjective. -/
theorem surjective_fibre_of_sub_mem [IsLocalRing C] (q : A →+* B) (p : C →+* B)
    (h : ∀ b : B, ∃ a₀ : A, b - q a₀ ∈ fibreIdeal p) :
    Function.Surjective ((Ideal.Quotient.mk (fibreIdeal p)).comp q) := by
  intro b'
  obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective b'
  obtain ⟨a₀, ha₀⟩ := h b
  refine ⟨a₀, ?_⟩
  rw [RingHom.comp_apply, Ideal.Quotient.eq, ← neg_sub]
  exact (fibreIdeal p).neg_mem ha₀

/-- **Strict decrease of the fibre (Rydh, Lemma 1.18), algebraic transport.**  Let `R` be the local
ring of the base-changed family `Y ×_X X'`, with `χ : A → R` (original family), `κ : C → R` (new
base) and `ψ : R → B` (the strict transform as a quotient of the base change) compatible with
`q : A → B` and `p : C → B`.  If `h ∈ R` is `κ a`-torsion, restricts on the closed fibre to
`h₀ ∈ A` (`h - χ h₀ ∈ m_{x'} R`), and `p a` is a nonzerodivisor of `B`, then `q h₀` lies in the fibre
ideal of `B`. -/
theorem map_mem_fibreIdeal_of_torsion [IsLocalRing C] {R : Type*} [CommRing R]
    (q : A →+* B) (p : C →+* B) (χ : A →+* R) (κ : C →+* R) (ψ : R →+* B)
    (hχ : ∀ x, ψ (χ x) = q x) (hκ : ∀ c, ψ (κ c) = p c)
    (a : C) (ha : IsRegular (p a)) (h : R) (hh : κ a * h = 0) (h₀ : A)
    (hh₀ : h - χ h₀ ∈ fibreIdeal κ) : q h₀ ∈ fibreIdeal p := by
  have hψh : ψ h = 0 := by
    apply ha.left
    change p a * ψ h = p a * 0
    rw [← hκ, ← map_mul, hh, map_zero, mul_zero]
  have hcomp : ψ.comp κ = p := RingHom.ext hκ
  have hmem : ψ (h - χ h₀) ∈ fibreIdeal p := by
    rw [← hcomp, fibreIdeal_comp]
    exact Ideal.mem_map_of_mem ψ hh₀
  rw [map_sub, hψh, hχ, zero_sub] at hmem
  simpa using (fibreIdeal p).neg_mem hmem

end Square

/-! ### Chains of fibre algebras -/

section Chain

variable {A : ℕ → Type*} [∀ n, CommRing (A n)] (q : ∀ n, A n →+* A (n + 1))

/-- The composite `A 0 → A n`. -/
def chainMap : ∀ n, A 0 →+* A n
  | 0 => RingHom.id _
  | n + 1 => (q n).comp (chainMap n)

@[simp] theorem chainMap_zero : chainMap q 0 = RingHom.id (A 0) := rfl

theorem chainMap_succ (n : ℕ) : chainMap q (n + 1) = (q n).comp (chainMap q n) := rfl

variable (I : ∀ n, Ideal (A n))

/-- The kernel of `A 0 → A n / I n`. -/
def chainKernel (n : ℕ) : Ideal (A 0) :=
  Ideal.comap (chainMap q n) (I n)

variable {q I}

theorem chainKernel_mono (hI : ∀ n, Ideal.map (q n) (I n) ≤ I (n + 1)) (n : ℕ) :
    chainKernel q I n ≤ chainKernel q I (n + 1) := by
  intro x hx
  exact hI n (Ideal.mem_map_of_mem (q n) hx)

/-- If every step is surjective modulo the fibre ideals, so is every composite. -/
theorem exists_sub_mem_chain (hI : ∀ n, Ideal.map (q n) (I n) ≤ I (n + 1))
    (hs : ∀ n (b : A (n + 1)), ∃ a : A n, b - q n a ∈ I (n + 1)) :
    ∀ n (b : A n), ∃ a₀ : A 0, b - chainMap q n a₀ ∈ I n
  | 0, b => ⟨b, by simp⟩
  | n + 1, b => by
    obtain ⟨a, ha⟩ := hs n b
    obtain ⟨a₀, ha₀⟩ := exists_sub_mem_chain hI hs n a
    refine ⟨a₀, ?_⟩
    have h1 : b - chainMap q (n + 1) a₀ = (b - q n a) + q n (a - chainMap q n a₀) := by
      rw [chainMap_succ, RingHom.comp_apply, map_sub]
      ring
    rw [h1]
    exact Ideal.add_mem _ ha (hI n (Ideal.mem_map_of_mem (q n) ha₀))

/-- **A non-injective step makes the kernel grow strictly.** -/
theorem chainKernel_lt (hI : ∀ n, Ideal.map (q n) (I n) ≤ I (n + 1))
    (hs : ∀ n (b : A (n + 1)), ∃ a : A n, b - q n a ∈ I (n + 1)) (n : ℕ) (h : A n)
    (hh : h ∉ I n) (hq : q n h ∈ I (n + 1)) :
    chainKernel q I n < chainKernel q I (n + 1) := by
  refine lt_of_le_of_ne (chainKernel_mono hI n) fun heq => ?_
  obtain ⟨a₀, ha₀⟩ := exists_sub_mem_chain hI hs n h
  have hin : a₀ ∈ chainKernel q I (n + 1) := by
    change chainMap q (n + 1) a₀ ∈ I (n + 1)
    have h1 : chainMap q (n + 1) a₀ = q n h - q n (h - chainMap q n a₀) := by
      rw [chainMap_succ, RingHom.comp_apply, map_sub]
      ring
    rw [h1]
    exact Ideal.sub_mem _ hq (hI n (Ideal.mem_map_of_mem (q n) ha₀))
  rw [← heq] at hin
  apply hh
  have h1 : h = (h - chainMap q n a₀) + chainMap q n a₀ := by ring
  rw [h1]
  exact Ideal.add_mem _ ha₀ hin

end Chain

/-! ### Fibre ideals of morphisms of locally ringed spaces -/

section LRS

variable {X Y Z : AlgebraicGeometry.LocallyRingedSpace}

/-- The fibre ideal `m_{F y} 𝒪_{Y,y}` of a morphism of locally ringed spaces at `y`. -/
def lrsFibreIdeal (F : Y ⟶ X) (y : Y) : Ideal (Y.presheaf.stalk y) :=
  fibreIdeal (F.stalkMap y).hom

theorem lrsFibreIdeal_le_maximalIdeal (F : Y ⟶ X) (y : Y) :
    lrsFibreIdeal F y ≤ maximalIdeal (Y.presheaf.stalk y) :=
  fibreIdeal_le_maximalIdeal _

theorem lrsFibreIdeal_ne_top (F : Y ⟶ X) (y : Y) : lrsFibreIdeal F y ≠ ⊤ :=
  fibreIdeal_ne_top _

/-- The fibre ideal of a composite is the image of the fibre ideal of the second morphism. -/
theorem lrsFibreIdeal_comp (F : Y ⟶ X) (G : X ⟶ Z) (y : Y) :
    lrsFibreIdeal (F ≫ G) y = Ideal.map (F.stalkMap y).hom (lrsFibreIdeal G (F.base y)) := by
  show fibreIdeal ((F ≫ G).stalkMap y).hom =
    Ideal.map (F.stalkMap y).hom (fibreIdeal (G.stalkMap (F.base y)).hom)
  rw [← fibreIdeal_comp]
  exact congrArg (fun φ => fibreIdeal (CommRingCat.Hom.hom φ))
    (AlgebraicGeometry.LocallyRingedSpace.stalkMap_comp F G y)

/-- The fibre ideal of a composite lies in the fibre ideal of the first morphism. -/
theorem lrsFibreIdeal_comp_le (F : Y ⟶ X) (G : X ⟶ Z) (y : Y) :
    lrsFibreIdeal (F ≫ G) y ≤ lrsFibreIdeal F y := by
  rw [lrsFibreIdeal_comp, lrsFibreIdeal, lrsFibreIdeal, fibreIdeal, fibreIdeal]
  exact Ideal.map_mono (fibreIdeal_le_maximalIdeal _)

/-- **Fibre ideals map into fibre ideals along a commutative square** `Q ≫ F = P ≫ S` of locally
ringed spaces. -/
theorem map_lrsFibreIdeal_le_of_comm {X' Y' : AlgebraicGeometry.LocallyRingedSpace}
    (F : Y ⟶ X) (S : X' ⟶ X) (Q : Y' ⟶ Y) (P : Y' ⟶ X') (hsq : Q ≫ F = P ≫ S) (y' : Y') :
    Ideal.map (Q.stalkMap y').hom (lrsFibreIdeal F (Q.base y')) ≤ lrsFibreIdeal P y' := by
  rw [← lrsFibreIdeal_comp, hsq]
  exact lrsFibreIdeal_comp_le P S y'

end LRS

end

