/-- The actual entire origin ideal, generated by true original stalk members. -/
def originalCoherentOriginIdeal {n : ℕ} (I : GermIdeal n (ComplexModel n)) :
    Ideal (HolGerm (ComplexModel n)) :=
  Ideal.span {g | ∃ (f : ComplexModel n → ℂ) (hf : HolAt f 0), I.mem 0 f ∧ g = HolGerm.mk f hf}

/-- Coherence internally identifies every genuine representative with its entire origin ideal. -/
theorem mk_mem_originalCoherentOriginIdeal_iff {n : ℕ}
    (I : GermIdeal n (ComplexModel n)) (hI : I.IsCoherent)
    {f : ComplexModel n → ℂ} (hf : HolAt f 0) :
    HolGerm.mk f hf ∈ originalCoherentOriginIdeal I ↔ I.mem 0 f := by
  classical
  obtain ⟨U,hU,h0U,μ,hμ,s,hs,hsI⟩ := germIdeal_actual_finitely_generated I hI
  let := hμ
  have hs0 : ∀ i, HolAt (s i) 0 := fun i => holAt_of_differentiableOn hU (hs i) h0U
  let K := Ideal.span (range fun i => HolGerm.mk (s i) (hs0 i))
  have hdict : ∀ (g : ComplexModel n → ℂ) (hg : HolAt g 0),
      I.mem 0 g ↔ HolGerm.mk g hg ∈ K := fun g hg =>
    (hsI 0 h0U g).trans (inSpanAt_zero_iff_mem_origin_span s hs0 hg)
  have he : originalCoherentOriginIdeal I = K := by
    apply le_antisymm
    · apply Ideal.span_le.mpr
      rintro g ⟨a,ha,hIa,rfl⟩
      exact (hdict a ha).mp hIa
    · apply Ideal.span_le.mpr
      rintro g ⟨i,rfl⟩
      apply Ideal.subset_span
      exact ⟨s i,hs0 i,(hsI 0 h0U _).mpr (inSpanAt_self hs0 i),rfl⟩
  rw [he]
  exact (hdict f hf).symm

/-- Literal functional colons retain the exact entire original origin ideal. -/
theorem actualColonChain_origin_ideal_dictionary {n : ℕ}
    (I : GermIdeal n (ComplexModel n)) (hI : I.IsCoherent)
    {h : ComplexModel n → ℂ} (hh : HolAt h 0) (q : ℕ)
    {f : ComplexModel n → ℂ} (hf : HolAt f 0) :
    actualColonChain I.mem h q 0 f ↔ HolGerm.mk f hf ∈
      actualOriginColonChain (originalCoherentOriginIdeal I) (HolGerm.mk h hh) q := by
  induction q generalizing f with
  | zero => exact (mk_mem_originalCoherentOriginIdeal_iff I hI hf).symm
  | succ q ih =>
    change (HolAt f 0 ∧ actualColonChain I.mem h q 0 (fun x => f x*h x)) ↔ _
    rw [and_iff_right hf,ih (hf.mul hh)]
    simp only [actualOriginColonChain,Submodule.mem_colon_singleton,smul_eq_mul]
    rfl

/-- The actual polynomial scaling (x,y,u,v) maps to (x,u*v). -/
def deformationScaling (d t : ℕ) (z : ComplexModel (deformationDimension d t)) :
    ComplexModel (d+t) :=
  (PiLp.continuousLinearEquiv 2 ℂ (fun _ : Fin (d+t) => ℂ)).symm
    (fun i => if hi : i.val < d then z (i.castAdd (1+t)) else
      deformationParameter d t z * deformationFiberCoordinate d t ⟨i.val-d,by omega⟩ z)

theorem deformationScaling_tangent (d t : ℕ)
    (z : ComplexModel (deformationDimension d t)) (i : Fin d) :
    deformationScaling d t z (i.castAdd t) = z ((i.castAdd t).castAdd (1+t)) := by
  change (if hi : i.val < d then _ else _) = _
  rw [dif_pos i.isLt]

theorem deformationScaling_normal (d t : ℕ)
    (z : ComplexModel (deformationDimension d t)) (i : Fin t) :
    deformationScaling d t z (i.natAdd d) =
      deformationParameter d t z * deformationFiberCoordinate d t i z := by
  change (if hi : d+i.val < d then _ else _) = _
  rw [dif_neg (by omega)]
  have he : (⟨d+i.val-d,by omega⟩ : Fin t) = i := Fin.ext (by change d+i.val-d = i.val; omega)
  exact congrArg (fun j : Fin t => deformationParameter d t z * deformationFiberCoordinate d t j z) he

theorem deformationScaling_holomorphic (d t : ℕ) : Differentiable ℂ (deformationScaling d t) := by
  apply (differentiable_piLp 2).mpr
  intro i
  change Differentiable ℂ (fun z => if hi : i.val < d then z (i.castAdd (1+t)) else
    deformationParameter d t z * deformationFiberCoordinate d t ⟨i.val-d,by omega⟩ z)
  by_cases hi : i.val < d
  · simp only [dif_pos hi]
    exact (EuclideanSpace.proj (i.castAdd (1+t)) :
      ComplexModel (deformationDimension d t) →L[ℂ] ℂ).differentiable
  · simp only [dif_neg hi]
    exact (deformationParameter d t).differentiable.mul
      (deformationFiberCoordinate d t ⟨i.val-d,by omega⟩).differentiable

theorem deformationScaling_zero (d t : ℕ) : deformationScaling d t 0 = 0 := by
  ext i
  change (if hi : i.val < d then (0 : ComplexModel (deformationDimension d t)) _ else _) = 0
  split
  · rfl
  · simp only [map_zero,mul_zero]

def deformationScalingPullback (d t : ℕ) :
    HolGerm (ComplexModel (d+t)) →ₐ[ℂ] HolGerm (ComplexModel (deformationDimension d t)) :=
  compAlgHom (deformationScaling d t)
    (Eventually.of_forall fun _ => (deformationScaling_holomorphic d t).differentiableAt)
    (deformationScaling_zero d t)

/-- The actual second coordinate inclusion in the doubled whole ambient model. -/
def secondInclusion (n : ℕ) : ComplexModel n →L[ℂ] ComplexModel (n+n) :=
  ∑ i : Fin n, (EuclideanSpace.proj i).smulRight
    (EuclideanSpace.single (i.natAdd n) (1 : ℂ))

@[simp] theorem secondInclusion_tangent (n : ℕ) (z : ComplexModel n) (i : Fin n) :
    secondInclusion n z (i.castAdd n) = 0 := by
  have hne : ∀ j : Fin n, i.castAdd n ≠ j.natAdd n := by
    intro j h
    have hv := congrArg Fin.val h
    simp only [Fin.val_natAdd,Fin.val_castAdd] at hv
    omega
  rw [secondInclusion,sum_apply]
  change (EuclideanSpace.proj (i.castAdd n) : ComplexModel (n+n) →L[ℂ] ℂ) _ = 0
  rw [map_sum]
  apply Finset.sum_eq_zero
  intro j _
  simp only [ContinuousLinearMap.smulRight_apply,map_smul]
  change z j * (Pi.single (j.natAdd n) (1 : ℂ) : Fin (n+n) → ℂ) (i.castAdd n) = 0
  simp only [Pi.single_apply,if_neg (hne j),mul_zero]

@[simp] theorem secondInclusion_normal (n : ℕ) (z : ComplexModel n) (i : Fin n) :
    secondInclusion n z (i.natAdd n) = z i := by
  simp [secondInclusion,sum_apply,ContinuousLinearMap.smulRight_apply,Pi.single_apply]

def secondProjection (n : ℕ) : ComplexModel (n+n) →L[ℂ] ComplexModel n :=
  (PiLp.continuousLinearEquiv 2 ℂ (fun _ : Fin n => ℂ)).symm.toContinuousLinearMap.comp
    (ContinuousLinearMap.pi fun i : Fin n => EuclideanSpace.proj (i.natAdd n))

@[simp] theorem secondProjection_apply (n : ℕ) (z : ComplexModel (n+n)) (i : Fin n) :
    secondProjection n z i = z (i.natAdd n) := rfl

def doubledSumProjection (n : ℕ) : ComplexModel (n+n) →L[ℂ] ComplexModel n :=
  tangentProjection n n + secondProjection n

@[simp] theorem doubledSumProjection_apply (n : ℕ) (z : ComplexModel (n+n)) (i : Fin n) :
    doubledSumProjection n z i = z (i.castAdd n) + z (i.natAdd n) := rfl

theorem doubledSumProjection_tangentInclusion (n : ℕ) (z : ComplexModel n) :
    doubledSumProjection n (tangentInclusion n n z) = z := by
  ext i
  simp

def doubledGraph (d t : ℕ) (z : ComplexModel (deformationDimension d t)) :
    ComplexModel ((d+t)+(d+t)) :=
  tangentInclusion (d+t) (d+t) (deformationProjection d t z) +
    secondInclusion (d+t) (deformationScaling d t z - deformationProjection d t z)

@[simp] theorem doubledGraph_tangent (d t : ℕ)
    (z : ComplexModel (deformationDimension d t)) (i : Fin (d+t)) :
    doubledGraph d t z (i.castAdd (d+t)) = deformationProjection d t z i := by
  simp [doubledGraph]

@[simp] theorem doubledGraph_normal (d t : ℕ)
    (z : ComplexModel (deformationDimension d t)) (i : Fin (d+t)) :
    doubledGraph d t z (i.natAdd (d+t)) =
      deformationScaling d t z i - deformationProjection d t z i := by
  change tangentInclusion (d+t) (d+t) (deformationProjection d t z) (i.natAdd (d+t)) +
    secondInclusion (d+t) (deformationScaling d t z - deformationProjection d t z) (i.natAdd (d+t)) = _
  rw [tangentInclusion_normal,secondInclusion_normal,zero_add]
  rfl

theorem doubledGraph_holomorphic (d t : ℕ) : Differentiable ℂ (doubledGraph d t) :=
  ((tangentInclusion (d+t) (d+t)).differentiable.comp
    (deformationProjection d t).differentiable).add
      ((secondInclusion (d+t)).differentiable.comp
        ((deformationScaling_holomorphic d t).sub (deformationProjection d t).differentiable))

theorem doubledGraph_zero (d t : ℕ) : doubledGraph d t 0 = 0 := by
  simp [doubledGraph,deformationScaling_zero]

theorem doubledSumProjection_doubledGraph (d t : ℕ)
    (z : ComplexModel (deformationDimension d t)) :
    doubledSumProjection (d+t) (doubledGraph d t z) = deformationScaling d t z := by
  ext i
  simp only [doubledSumProjection_apply,doubledGraph_tangent,doubledGraph_normal]
  ring

def doubledGraphPullback (d t : ℕ) :
    HolGerm (ComplexModel ((d+t)+(d+t))) →ₐ[ℂ] HolGerm (ComplexModel (deformationDimension d t)) :=
  compAlgHom (doubledGraph d t)
    (Eventually.of_forall fun _ => (doubledGraph_holomorphic d t).differentiableAt)
    (doubledGraph_zero d t)

def doubledSumPullback (n : ℕ) :
    HolGerm (ComplexModel n) →ₐ[ℂ] HolGerm (ComplexModel (n+n)) :=
  compAlgHom (doubledSumProjection n)
    (Eventually.of_forall fun _ => (doubledSumProjection n).differentiableAt) (map_zero _)

theorem planeTrace_doubledSumPullback (n : ℕ) (g : HolGerm (ComplexModel n)) :
    planeTrace n n (doubledSumPullback n g) = g := by
  induction g using HolGerm.induction_on with
  | h f hf =>
    unfold planeTrace doubledSumPullback
    rw [compAlgHom_mk,compAlgHom_mk]
    exact HolGerm.mk_eq_mk_iff.mpr (Eventually.of_forall fun z =>
      congrArg f (doubledSumProjection_tangentInclusion n z))

theorem doubledGraphPullback_doubledSumPullback (d t : ℕ)
    (g : HolGerm (ComplexModel (d+t))) :
    doubledGraphPullback d t (doubledSumPullback (d+t) g) = deformationScalingPullback d t g := by
  induction g using HolGerm.induction_on with
  | h f hf =>
    unfold doubledGraphPullback doubledSumPullback deformationScalingPullback
    rw [compAlgHom_mk,compAlgHom_mk,compAlgHom_mk]
    exact HolGerm.mk_eq_mk_iff.mpr (Eventually.of_forall fun z =>
      congrArg f (doubledSumProjection_doubledGraph d t z))

theorem doubledGraphPullback_tangentPullback (d t : ℕ)
    (g : HolGerm (ComplexModel (d+t))) :
    doubledGraphPullback d t (tangentPullback (d+t) (d+t) g) = tangentPullback (d+t) (1+t) g := by
  induction g using HolGerm.induction_on with
  | h f hf =>
    unfold doubledGraphPullback tangentPullback
    rw [compAlgHom_mk,compAlgHom_mk,compAlgHom_mk]
    apply HolGerm.mk_eq_mk_iff.mpr
    apply Eventually.of_forall
    intro z
    apply congrArg f
    ext i
    exact doubledGraph_tangent d t z i

def deformationEquationGerm (d t : ℕ) (i : Fin t) : HolGerm (ComplexModel (deformationDimension d t)) :=
  HolGerm.mk (deformationEquation d t i)
    (Eventually.of_forall fun _ => (deformationEquation_holomorphic d t i).differentiableAt)

theorem doubledGraphPullback_normal_tangent (d t : ℕ) (i : Fin d) :
    doubledGraphPullback d t (normalCoordinate (d+t) (d+t) (i.castAdd t)) = 0 := by
  unfold doubledGraphPullback normalCoordinate coordinateGerm
  rw [compAlgHom_mk,← HolGerm.mk_zero,HolGerm.mk_eq_mk_iff]
  apply Eventually.of_forall
  intro z
  change doubledGraph d t z ((i.castAdd t).natAdd (d+t)) = 0
  rw [doubledGraph_normal,deformationScaling_tangent]
  change z ((i.castAdd t).castAdd (1+t)) - z ((i.castAdd t).castAdd (1+t)) = 0
  exact sub_self _

theorem doubledGraphPullback_normal_normal (d t : ℕ) (i : Fin t) :
    doubledGraphPullback d t (normalCoordinate (d+t) (d+t) (i.natAdd d)) =
      deformationEquationGerm d t i := by
  unfold doubledGraphPullback normalCoordinate coordinateGerm deformationEquationGerm
  rw [compAlgHom_mk,HolGerm.mk_eq_mk_iff]
  apply Eventually.of_forall
  intro z
  change doubledGraph d t z ((i.natAdd d).natAdd (d+t)) = deformationEquation d t i z
  rw [doubledGraph_normal,deformationScaling_normal]
  rfl

theorem deformationEquationGerm_mem_originIdeal (d t : ℕ) (i : Fin t) :
    deformationEquationGerm d t i ∈ originalCoherentOriginIdeal (deformationEquationIdeal d t) := by
  apply (mk_mem_originalCoherentOriginIdeal_iff (deformationEquationIdeal d t)
    (deformationEquationIdeal_isCoherent d t) _).mpr
  exact CoherentIdealColon.isInSpanAt_range_self
    (fun j => Eventually.of_forall fun z =>
      ((deformationEquation_holomorphic d t j).differentiableAt).mdifferentiableAt) i

/-- Whole Hadamard coefficients prove the actual graph difference is in the equation ideal. -/
theorem deformationScalingPullback_sub_projection_mem (d t : ℕ)
    (g : HolGerm (ComplexModel (d+t))) :
    deformationScalingPullback d t g - tangentPullback (d+t) (1+t) g ∈
      originalCoherentOriginIdeal (deformationEquationIdeal d t) := by
  let F := doubledSumPullback (d+t) g - tangentPullback (d+t) (d+t) g
  have htrace : planeTrace (d+t) (d+t) F = 0 := by
    rw [map_sub,planeTrace_doubledSumPullback,planeTrace_tangentPullback,sub_self]
  obtain ⟨h,he⟩ := exists_relative_decomposition (d+t) (d+t) F
  rw [htrace,map_zero,zero_add] at he
  have hpull := congrArg (doubledGraphPullback d t) he
  change doubledGraphPullback d t
    (doubledSumPullback (d+t) g - tangentPullback (d+t) (d+t) g) = _ at hpull
  rw [map_sub,doubledGraphPullback_doubledSumPullback,doubledGraphPullback_tangentPullback] at hpull
  simp only [map_sum,map_mul] at hpull
  rw [Fin.sum_univ_add] at hpull
  simp only [doubledGraphPullback_normal_tangent,zero_mul,Finset.sum_const_zero,zero_add,
    doubledGraphPullback_normal_normal] at hpull
  rw [hpull]
  exact Ideal.sum_mem _ fun i _ => Ideal.mul_mem_right _ _ (deformationEquationGerm_mem_originIdeal d t i)

def deformationParameterGerm (d t : ℕ) : HolGerm (ComplexModel (deformationDimension d t)) :=
  HolGerm.mk (deformationParameter d t)
    (Eventually.of_forall fun _ => (deformationParameter d t).differentiableAt)

def deformationFiberGerm (d t : ℕ) (i : Fin t) : HolGerm (ComplexModel (deformationDimension d t)) :=
  HolGerm.mk (deformationFiberCoordinate d t i)
    (Eventually.of_forall fun _ => (deformationFiberCoordinate d t i).differentiableAt)

theorem deformationParameterGerm_ne_zero (d t : ℕ) : deformationParameterGerm d t ≠ 0 :=
  HolomorphicGermReducednessBridge.coordinate_germ_ne_zero ⟨d+t,by dsimp [deformationDimension]; omega⟩

theorem deformationScalingPullback_normalCoordinate (d t : ℕ) (i : Fin t) :
    deformationScalingPullback d t (normalCoordinate d t i) =
      deformationParameterGerm d t * deformationFiberGerm d t i := by
  unfold deformationScalingPullback normalCoordinate coordinateGerm
  rw [compAlgHom_mk]
  change HolGerm.mk (fun z => deformationScaling d t z (i.natAdd d)) _ = _
  unfold deformationParameterGerm deformationFiberGerm
  rw [← HolGerm.mk_mul]
  apply HolGerm.mk_eq_mk_iff.mpr
  exact Eventually.of_forall fun z => deformationScaling_normal d t z i

def deformationBasePullback (d t : ℕ) :
    HolGerm (ComplexModel d) →ₐ[ℂ] HolGerm (ComplexModel (deformationDimension d t)) :=
  compAlgHom ((tangentProjection d t).comp (deformationProjection d t))
    (Eventually.of_forall fun _ => ((tangentProjection d t).comp
      (deformationProjection d t)).differentiableAt) (map_zero _)

theorem deformationScalingPullback_tangentPullback (d t : ℕ) (a : HolGerm (ComplexModel d)) :
    deformationScalingPullback d t (tangentPullback d t a) = deformationBasePullback d t a := by
  induction a using HolGerm.induction_on with
  | h f hf =>
    unfold deformationScalingPullback tangentPullback deformationBasePullback
    rw [compAlgHom_mk,compAlgHom_mk,compAlgHom_mk]
    apply HolGerm.mk_eq_mk_iff.mpr
    apply Eventually.of_forall
    intro z
    apply congrArg f
    ext i
    exact deformationScaling_tangent d t z i

def deformationFiberPolynomialEval (d t : ℕ) :
    MvPolynomial (Fin t) (HolGerm (ComplexModel d)) →+*
      HolGerm (ComplexModel (deformationDimension d t)) :=
  MvPolynomial.eval₂Hom (deformationBasePullback d t).toRingHom (deformationFiberGerm d t)

theorem deformationFiberPolynomialEval_monomial (d t : ℕ) (α : Fin t →₀ ℕ)
    (a : HolGerm (ComplexModel d)) :
    deformationFiberPolynomialEval d t (MvPolynomial.monomial α a) =
      deformationBasePullback d t a * ∏ i, deformationFiberGerm d t i ^ α i := by
  unfold deformationFiberPolynomialEval
  change MvPolynomial.eval₂ _ _ _ = _
  rw [MvPolynomial.eval₂_monomial]
  exact congrArg (fun p => deformationBasePullback d t a*p)
    (α.prod_fintype (fun i k => deformationFiberGerm d t i ^ k) (fun _ => pow_zero _))

theorem deformationScalingPullback_monomial (d t : ℕ) (α : Fin t →₀ ℕ)
    (a : HolGerm (ComplexModel d)) :
    deformationScalingPullback d t (normalPolynomialEval d t (MvPolynomial.monomial α a)) =
      deformationParameterGerm d t ^ normalExponentDegree α *
        deformationFiberPolynomialEval d t (MvPolynomial.monomial α a) := by
  rw [normalPolynomialEval_monomial,map_mul,deformationScalingPullback_tangentPullback]
  simp only [normalExponentMonomial,map_prod,map_pow,deformationScalingPullback_normalCoordinate,
    mul_pow,Finset.prod_mul_distrib,Finset.prod_pow_eq_pow_sum,deformationFiberPolynomialEval_monomial]
  change deformationBasePullback d t a *
    (deformationParameterGerm d t ^ (∑ i, α i) * ∏ i, deformationFiberGerm d t i ^ α i) = _
  unfold normalExponentDegree
  ring

theorem deformationScalingPullback_homogeneous (d t q : ℕ)
    (P : MvPolynomial (Fin t) (HolGerm (ComplexModel d))) (hP : P.IsHomogeneous q) :
    deformationScalingPullback d t (normalPolynomialEval d t P) =
      deformationParameterGerm d t ^ q * deformationFiberPolynomialEval d t P := by
  classical
  rw [P.as_sum,map_sum,map_sum,map_sum,Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro α hα
  have hd : normalExponentDegree α = q := by
    rw [normalExponentDegree_eq_degree]
    simpa only [Finsupp.degree_apply] using (hP.degree_eq_sum_deg_support hα).symm
  rw [deformationScalingPullback_monomial,hd]

theorem deformationScalingPullback_normalIdeal_le (d t : ℕ) :
    Ideal.map (deformationScalingPullback d t).toRingHom (normalIdeal d t) ≤
      Ideal.span {deformationParameterGerm d t} := by
  apply Ideal.map_le_iff_le_comap.mpr
  apply Ideal.span_le.mpr
  rintro g ⟨i,rfl⟩
  change deformationScalingPullback d t (normalCoordinate d t i) ∈
    Ideal.span {deformationParameterGerm d t}
  rw [deformationScalingPullback_normalCoordinate]
  exact Ideal.mul_mem_right _ _ (Ideal.subset_span (by simp))

theorem exists_deformationScalingPullback_divided (d t q : ℕ)
    (g : HolGerm (ComplexModel (d+t))) (hg : g ∈ normalIdeal d t ^ q) :
    ∃ F : HolGerm (ComplexModel (deformationDimension d t)),
      deformationScalingPullback d t g = deformationParameterGerm d t ^ q * F := by
  have hm := Ideal.mem_map_of_mem (deformationScalingPullback d t).toRingHom hg
  rw [Ideal.map_pow] at hm
  have hle := pow_le_pow_left' (deformationScalingPullback_normalIdeal_le d t) q
  have hp := hle hm
  rw [Ideal.span_singleton_pow,Ideal.mem_span_singleton'] at hp
  obtain ⟨F,hF⟩ := hp
  exact ⟨F,hF.symm.trans (mul_comm _ _)⟩

def deformationCentralPullback (d t : ℕ) :
    HolGerm (ComplexModel (deformationDimension d t)) →ₐ[ℂ] HolGerm (ComplexModel (d+t)) :=
  compAlgHom (deformationCentralInclusion d t)
    (Eventually.of_forall fun _ => (deformationCentralInclusion d t).differentiableAt) (map_zero _)

theorem deformationCentralPullback_parameter (d t : ℕ) :
    deformationCentralPullback d t (deformationParameterGerm d t) = 0 := by
  unfold deformationCentralPullback deformationParameterGerm
  rw [compAlgHom_mk,← HolGerm.mk_zero,HolGerm.mk_eq_mk_iff]
  exact Eventually.of_forall fun z => deformationCentralInclusion_parameter d t z

theorem deformationCentralPullback_fiber (d t : ℕ) (i : Fin t) :
    deformationCentralPullback d t (deformationFiberGerm d t i) = normalCoordinate d t i := by
  unfold deformationCentralPullback deformationFiberGerm normalCoordinate coordinateGerm
  rw [compAlgHom_mk,HolGerm.mk_eq_mk_iff]
  exact Eventually.of_forall fun z => deformationCentralInclusion_fiber d t z i

theorem deformationCentralPullback_base (d t : ℕ) (a : HolGerm (ComplexModel d)) :
    deformationCentralPullback d t (deformationBasePullback d t a) = tangentPullback d t a := by
  induction a using HolGerm.induction_on with
  | h f hf =>
    unfold deformationCentralPullback deformationBasePullback tangentPullback
    rw [compAlgHom_mk,compAlgHom_mk,compAlgHom_mk]
    apply HolGerm.mk_eq_mk_iff.mpr
    apply Eventually.of_forall
    intro z
    apply congrArg f
    ext i
    exact deformationCentralInclusion_tangent d t z i

theorem deformationCentralPullback_fiberPolynomialEval (d t : ℕ)
    (P : MvPolynomial (Fin t) (HolGerm (ComplexModel d))) :
    deformationCentralPullback d t (deformationFiberPolynomialEval d t P) = normalPolynomialEval d t P := by
  classical
  rw [P.as_sum,map_sum,map_sum,map_sum]
  apply Finset.sum_congr rfl
  intro α _
  rw [deformationFiberPolynomialEval_monomial,normalPolynomialEval_monomial,map_mul,
    deformationCentralPullback_base]
  simp only [map_prod,map_pow,deformationCentralPullback_fiber,normalExponentMonomial]

attribute [local instance 2000] SubsemiringClass.toAddSubmonoidClass in
attribute [local instance 2000] HolGerm.instIsReduced in
/-- Whole parameter cancellation gives the precise actual central initial symbol. -/
theorem exists_divided_scaling_initial_symbol (d t q : ℕ)
    (g : HolGerm (ComplexModel (d+t))) (hg : g ∈ normalIdeal d t ^ q) :
    ∃ F : HolGerm (ComplexModel (deformationDimension d t)),
      deformationScalingPullback d t g = deformationParameterGerm d t ^ q * F ∧
      deformationCentralPullback d t F =
        normalPolynomialEval d t (originalNormalInitialSymbol d t q g hg) := by
  let P := originalNormalInitialSymbol d t q g hg
  have hP := originalNormalInitialSymbol_homogeneous d t q g hg
  have hr := originalNormalInitialSymbol_remainder d t q g hg
  obtain ⟨F,hF⟩ := exists_deformationScalingPullback_divided d t q g hg
  obtain ⟨G,hG⟩ := exists_deformationScalingPullback_divided d t (q+1)
    (g-normalPolynomialEval d t P) hr
  have hscaled := deformationScalingPullback_homogeneous d t q P hP
  rw [map_sub,hF,hscaled,pow_succ] at hG
  have hcancel : F = deformationFiberPolynomialEval d t P + deformationParameterGerm d t*G := by
    apply mul_left_cancel₀ (pow_ne_zero q (deformationParameterGerm_ne_zero d t))
    calc
      deformationParameterGerm d t ^ q*F =
          deformationParameterGerm d t ^ q*deformationParameterGerm d t*G +
            deformationParameterGerm d t ^ q*deformationFiberPolynomialEval d t P :=
        sub_eq_iff_eq_add.mp hG
      _ = _ := by ring
  refine ⟨F,hF,?_⟩
  rw [hcancel,map_add,map_mul,deformationCentralPullback_parameter,zero_mul,add_zero,
    deformationCentralPullback_fiberPolynomialEval]

theorem originalCoherentOriginIdeal_le_of_le {n : ℕ}
    (I J : GermIdeal n (ComplexModel n)) (hJ : J.IsCoherent) (hIJ : I.Le J) :
    originalCoherentOriginIdeal I ≤ originalCoherentOriginIdeal J := by
  apply Ideal.span_le.mpr
  rintro g ⟨f,hf,hIf,rfl⟩
  exact (mk_mem_originalCoherentOriginIdeal_iff J hJ hf).mpr (hIJ 0 f hIf)

/-- Actual linear pullback carries the entire original origin ideal into the true sheaf pullback. -/
theorem map_compAlgHom_originIdeal_le {m n : ℕ}
    (η : ComplexModel m →L[ℂ] ComplexModel n)
    (I : GermIdeal n (ComplexModel n)) (hI : I.IsCoherent) :
    Ideal.map (compAlgHom η (Eventually.of_forall fun _ => η.differentiableAt) (map_zero _)).toRingHom
      (originalCoherentOriginIdeal I) ≤
        originalCoherentOriginIdeal (GermIdeal.pullback (m := m) η I) := by
  apply Ideal.map_le_iff_le_comap.mpr
  apply Ideal.span_le.mpr
  rintro g ⟨f,hf,hIf,rfl⟩
  change compAlgHom η _ _ (HolGerm.mk f hf) ∈
    originalCoherentOriginIdeal (GermIdeal.pullback (m := m) η I)
  rw [compAlgHom_mk]
  have hc := holomorphic_comp η (Eventually.of_forall fun _ => η.differentiableAt) (map_zero _) hf
  apply (mk_mem_originalCoherentOriginIdeal_iff (GermIdeal.pullback (m := m) η I)
    (GermIdealPullbackCalculus.isCoherent_pullback η.contMDiff hI) hc).mpr
  refine ⟨hc.mono (fun _ h => h.mdifferentiableAt),1,fun _ => f ∘ η,fun _ => 1,?_,?_,?_⟩
  · intro i
    exact ⟨f,by simpa only [map_zero] using hIf,rfl⟩
  · exact fun _ => Eventually.of_forall fun _ => mdifferentiableAt_const
  · exact Eventually.of_forall fun _ => by simp

/-- Genuine original membership and the actual graph identity put the entire scaled germ in K. -/
theorem deformationScalingPullback_mem_originalIdeal (d t : ℕ)
    (I : GermIdeal (d+t) (ComplexModel (d+t))) (hI : I.IsCoherent)
    (g : HolGerm (ComplexModel (d+t))) (hg : g ∈ originalCoherentOriginIdeal I) :
    deformationScalingPullback d t g ∈ originalCoherentOriginIdeal (originalDeformationIdeal d t I) := by
  have hK := originalDeformationIdeal_isCoherent d t I hI
  have hpull := GermIdealPullbackCalculus.isCoherent_pullback (deformationProjection d t).contMDiff hI
  have hleft := originalCoherentOriginIdeal_le_of_le _ _ hK
    (RestrictedIdealExtension.le_sumIdeal_left hpull)
  have hright := originalCoherentOriginIdeal_le_of_le _ _ hK
    (RestrictedIdealExtension.le_sumIdeal_right (deformationEquationIdeal_isCoherent d t))
  have hproj := map_compAlgHom_originIdeal_le (deformationProjection d t) I hI
    (Ideal.mem_map_of_mem _ hg)
  have hp : tangentPullback (d+t) (1+t) g ∈
      originalCoherentOriginIdeal (originalDeformationIdeal d t I) := hleft hproj
  have hdiff := hright (deformationScalingPullback_sub_projection_mem d t g)
  have he : deformationScalingPullback d t g =
      (deformationScalingPullback d t g-tangentPullback (d+t) (1+t) g) +
        tangentPullback (d+t) (1+t) g := by ring
  rw [he]
  exact Ideal.add_mem _ hdiff hp

theorem mem_actualOriginColonChain_iff {R : Type*} [CommRing R]
    (I : Ideal R) (a g : R) (q : ℕ) :
    g ∈ actualOriginColonChain I a q ↔ g*a^q ∈ I := by
  induction q generalizing g with
  | zero => simp [actualOriginColonChain]
  | succ q ih =>
    change g ∈ (actualOriginColonChain I a q).colon {a} ↔ _
    rw [Submodule.mem_colon_singleton]
    change g*a ∈ actualOriginColonChain I a q ↔ _
    rw [ih]
    have he : g*a*a^q = g*a^(q+1) := by rw [pow_succ]; ring
    rw [he]

theorem originalOriginIdeal_actualColon {n : ℕ}
    (I : GermIdeal n (ComplexModel n)) (hI : I.IsCoherent)
    (h : ComplexModel n → ℂ) (hh : ∀ x, HolAt h x) (q : ℕ) :
    originalCoherentOriginIdeal (actualColonGermIdeal I h q) =
      actualOriginColonChain (originalCoherentOriginIdeal I) (HolGerm.mk h (hh 0)) q := by
  ext g
  induction g using HolGerm.induction_on with
  | h f hf =>
    exact (mk_mem_originalCoherentOriginIdeal_iff (actualColonGermIdeal I h q)
      (actualColonGermIdeal_isCoherent I hI h hh q) hf).trans
        (actualColonChain_origin_ideal_dictionary I hI (hh 0) q hf)

private theorem initialSymbol_mem_selected_central (d t : ℕ)
    (I : GermIdeal (d+t) (ComplexModel (d+t))) (hI : I.IsCoherent) (N : ℕ)
    (hN : ∀ f, (∃ q : ℕ, (originalDeformationColonIdeal d t I q).mem 0 f) ↔
      (originalDeformationColonIdeal d t I N).mem 0 f)
    (q : ℕ) (g : HolGerm (ComplexModel (d+t)))
    (hIg : g ∈ originalCoherentOriginIdeal I) (hg : g ∈ normalIdeal d t ^ q) :
    normalPolynomialEval d t (originalNormalInitialSymbol d t q g hg) ∈
      originalCoherentOriginIdeal (originalDeformationCentralIdeal d t I N) := by
  obtain ⟨F,hF,hcentral⟩ := exists_divided_scaling_initial_symbol d t q g hg
  have hscaled := deformationScalingPullback_mem_originalIdeal d t I hI g hIg
  have hmul : F*deformationParameterGerm d t^q ∈
      originalCoherentOriginIdeal (originalDeformationIdeal d t I) := by
    rw [mul_comm,← hF]
    exact hscaled
  have hcolon := (mem_actualOriginColonChain_iff
    (originalCoherentOriginIdeal (originalDeformationIdeal d t I)) (deformationParameterGerm d t) F q).mpr hmul
  obtain ⟨f,hf,rfl⟩ := HolGerm.exists_eq_mk F
  have hfunctional := (actualColonChain_origin_ideal_dictionary
    (originalDeformationIdeal d t I) (originalDeformationIdeal_isCoherent d t I hI)
      (Eventually.of_forall fun _ => (deformationParameter d t).differentiableAt) q hf).mpr hcolon
  have hchosen := (hN f).mp ⟨q,hfunctional⟩
  have horigin := (mk_mem_originalCoherentOriginIdeal_iff (originalDeformationColonIdeal d t I N)
    (originalDeformationColonIdeal_isCoherent d t I hI N) hf).mpr hchosen
  have hj := map_compAlgHom_originIdeal_le (deformationCentralInclusion d t)
    (originalDeformationColonIdeal d t I N) (originalDeformationColonIdeal_isCoherent d t I hI N)
      (Ideal.mem_map_of_mem _ horigin)
  change deformationCentralPullback d t (HolGerm.mk f hf) ∈
    originalCoherentOriginIdeal (originalDeformationCentralIdeal d t I N) at hj
  rwa [hcentral] at hj

private theorem entireInitialIdeal_map_le_selected_central (d t : ℕ)
    (I : GermIdeal (d+t) (ComplexModel (d+t))) (hI : I.IsCoherent) (N : ℕ)
    (hN : ∀ f, (∃ q : ℕ, (originalDeformationColonIdeal d t I q).mem 0 f) ↔
      (originalDeformationColonIdeal d t I N).mem 0 f) :
    let := tangentAlgebra d t
    Ideal.map (normalPolynomialEval d t).toRingHom
      (originalNormalInitialIdeal d t (originalCoherentOriginIdeal I)) ≤
        originalCoherentOriginIdeal (originalDeformationCentralIdeal d t I N) := by
  let := tangentAlgebra d t
  apply Ideal.map_le_iff_le_comap.mpr
  rw [originalNormalInitialIdeal_eq_span_original_relations]
  apply Ideal.span_le.mpr
  rintro P ⟨a,rfl⟩
  exact initialSymbol_mem_selected_central d t I hI N hN a.1 a.2.val a.2.property.1 a.2.property.2

/-- ONLY the original coherent ideal supplies SAME actual saturation and the whole initial-ideal inclusion. -/
theorem exists_original_deformation_initial_ideal_inclusion (d t : ℕ)
    (I : GermIdeal (d+t) (ComplexModel (d+t))) (hI : I.IsCoherent) :
    let := tangentAlgebra d t
    ∃ N : ℕ, ∃ U : Set (ComplexModel (deformationDimension d t)), IsOpen U ∧ 0 ∈ U ∧
      (originalDeformationColonIdeal d t I N).IsCoherent ∧
      (originalDeformationCentralIdeal d t I N).IsCoherent ∧
      (∀ y ∈ U, ∀ q : ℕ, ∀ g,
        (originalDeformationColonIdeal d t I (N+q)).mem y g ↔
          (originalDeformationColonIdeal d t I N).mem y g) ∧
      (∀ y ∈ U, ∀ q : ℕ, N ≤ q → ∀ g, HolAt g y →
        ((originalDeformationIdeal d t I).mem y (fun z => g z*deformationParameter d t z^q) ↔
          (originalDeformationIdeal d t I).mem y (fun z => g z*deformationParameter d t z^N))) ∧
      (∀ y ∈ U, ∀ g, (∃ q : ℕ, (originalDeformationColonIdeal d t I q).mem y g) ↔
        (originalDeformationColonIdeal d t I N).mem y g) ∧
      Ideal.map (normalPolynomialEval d t).toRingHom
        (originalNormalInitialIdeal d t (originalCoherentOriginIdeal I)) ≤
          originalCoherentOriginIdeal (originalDeformationCentralIdeal d t I N) := by
  let := tangentAlgebra d t
  obtain ⟨N,U,hU,h0U,hcol,hcent,he,hpow,hsat⟩ := exists_original_deformation_saturated_model d t I hI
  exact ⟨N,U,hU,h0U,hcol,hcent,he,hpow,hsat,
    entireInitialIdeal_map_le_selected_central d t I hI N (hsat 0 h0U)⟩

theorem exists_original_deformation_initial_symbol_memberships (d t : ℕ)
    (I : GermIdeal (d+t) (ComplexModel (d+t))) (hI : I.IsCoherent) :
    ∃ N : ℕ, (originalDeformationColonIdeal d t I N).IsCoherent ∧
      (originalDeformationCentralIdeal d t I N).IsCoherent ∧
      ∀ (q : ℕ) (g : HolGerm (ComplexModel (d+t)))
        (_hIg : g ∈ originalCoherentOriginIdeal I) (hg : g ∈ normalIdeal d t ^ q),
        normalPolynomialEval d t (originalNormalInitialSymbol d t q g hg) ∈
          originalCoherentOriginIdeal (originalDeformationCentralIdeal d t I N) := by
  obtain ⟨N,U,_,h0U,hcol,hcent,_,_,hsat⟩ := exists_original_deformation_saturated_model d t I hI
  refine ⟨N,hcol,hcent,?_⟩
  intro q g hIg hg
  exact initialSymbol_mem_selected_central d t I hI N (hsat 0 h0U) q g hIg hg

theorem exists_original_deformation_coherent_initial_ideal_inclusion (d t : ℕ)
    (I : GermIdeal (d+t) (ComplexModel (d+t))) (hI : I.IsCoherent) :
    let := tangentAlgebra d t
    ∃ N : ℕ, (originalDeformationColonIdeal d t I N).IsCoherent ∧
      (originalDeformationCentralIdeal d t I N).IsCoherent ∧
      Ideal.map (normalPolynomialEval d t).toRingHom
        (originalNormalInitialIdeal d t (originalCoherentOriginIdeal I)) ≤
          originalCoherentOriginIdeal (originalDeformationCentralIdeal d t I N) := by
  let := tangentAlgebra d t
  obtain ⟨N,_,_,_,hcol,hcent,_,_,_,hmap⟩ := exists_original_deformation_initial_ideal_inclusion d t I hI
  exact ⟨N,hcol,hcent,hmap⟩

