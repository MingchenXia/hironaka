import Hironaka.Resolution.HironakaG11BennettGraded
import Hironaka.Resolution.HironakaHolomorphicJetMonomialSpan

/-!
# Bennett's stabilization: Hilbert–Samuel functions of holomorphic germ quotients

The whole Hilbert–Samuel function `ℓ ↦ dim_ℂ O_n/(I + m^(ℓ+1))` of ANY ideal `I` of the ring of
holomorphic germs at `0 ∈ ℂ^n` (`HironakaHolomorphicPointJets.hilbertSamuelValue`) is the counting
function of a diagram (upper set) in `ℕ^E`, for every `E ≥ n`
(`hilbertSamuelValue_mem_diagramFunctions`): `O_n = ℂ + m` (evaluation at `0`) and `m` is generated by
the `n` coordinate germs (Hadamard), padded by zeros to `E` generators; then
`HironakaG11BennettGraded.exists_upperSet_finrank_eq_hsCount` applies.
Blueprint: `hironaka-g11-resume-bennett-stabilization.tex`.
-/

set_option autoImplicit false

namespace Hironaka.HironakaG11BennettHolGerm

open HolGerm HironakaHolomorphicPointJets HironakaHolomorphicJetMonomialSpan
  HironakaG11BennettDiagram HironakaG11BennettGraded

noncomputable section

/-- The maximal ideal of the germ ring is generated by the coordinate germs. -/
theorem maximalIdeal_eq_span_coordinateGerm (n : ℕ) :
    IsLocalRing.maximalIdeal (HolGerm (ComplexModel n)) =
      Ideal.span (Set.range (coordinateGerm : Fin n → HolGerm (ComplexModel n))) := by
  apply le_antisymm
  · intro g hg
    obtain ⟨h, he⟩ := exists_coordinate_decomposition g
    have hz := (HolGerm.mem_maximalIdeal_iff _).mp hg
    rw [hz, map_zero, zero_add] at he
    rw [he]
    exact Ideal.sum_mem _ fun i _ => Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨i, rfl⟩)
  · apply Ideal.span_le.mpr
    rintro _ ⟨i, rfl⟩
    exact (HolGerm.mem_maximalIdeal_iff _).mpr rfl

/-- The coordinate germs padded by zeros to `E ≥ n` generators. -/
def paddedCoordinates (n E : ℕ) : Fin E → HolGerm (ComplexModel n) :=
  fun j => if h : j.val < n then coordinateGerm ⟨j.val, h⟩ else 0

theorem span_paddedCoordinates {n E : ℕ} (hnE : n ≤ E) :
    Ideal.span (Set.range (paddedCoordinates n E)) =
      Ideal.span (Set.range (coordinateGerm : Fin n → HolGerm (ComplexModel n))) := by
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro _ ⟨j, rfl⟩
    simp only [paddedCoordinates]
    split_ifs with h
    · exact Ideal.subset_span ⟨_, rfl⟩
    · exact Ideal.zero_mem _
  · apply Ideal.span_le.mpr
    rintro _ ⟨i, rfl⟩
    refine Ideal.subset_span ⟨⟨i.val, lt_of_lt_of_le i.isLt hnE⟩, ?_⟩
    simp [paddedCoordinates]

/-- Every germ is a constant modulo the maximal ideal. -/
theorem exists_sub_algebraMap_mem (n : ℕ) (r : HolGerm (ComplexModel n)) :
    ∃ c : ℂ, r - algebraMap ℂ (HolGerm (ComplexModel n)) c ∈
      IsLocalRing.maximalIdeal (HolGerm (ComplexModel n)) := by
  refine ⟨HolGerm.eval r, (HolGerm.mem_maximalIdeal_iff _).mpr ?_⟩
  have hc : algebraMap ℂ (HolGerm (ComplexModel n)) (HolGerm.eval r) =
      HolGerm.constHom (HolGerm.eval r) := rfl
  rw [map_sub, hc, HolGerm.eval_constHom, sub_self]

/-- **The Hilbert–Samuel function of any germ quotient is a diagram counting function** in `ℕ^E`
for every `E ≥ n`. -/
theorem hilbertSamuelValue_mem_diagramFunctions {n E : ℕ} (hnE : n ≤ E)
    (I : Ideal (HolGerm (ComplexModel n))) :
    hilbertSamuelValue I ∈ diagramFunctions E := by
  obtain ⟨N, hN, hEq⟩ := exists_upperSet_finrank_eq_hsCount (k := ℂ)
    (IsLocalRing.maximalIdeal (HolGerm (ComplexModel n))) I (paddedCoordinates n E)
    (by rw [span_paddedCoordinates hnE, maximalIdeal_eq_span_coordinateGerm])
    (exists_sub_algebraMap_mem n)
  exact ⟨N, hN, funext fun ℓ => hEq ℓ⟩

end

end Hironaka.HironakaG11BennettHolGerm
