import Hironaka.Resolution.HironakaG10ChowRatioAlgebra
import Hironaka.Resolution.HironakaG10ChowSubstitutionHadamard
import Hironaka.Blowup.BlowupStrictSubmanifold
import Hironaka.Resolution.HironakaActualAnalyticSubspaceMaps
import Hironaka.Resolution.HironakaG10ChowGermIdealDictionary
import Hironaka.Resolution.HironakaActualAnalyticSubspaceOpenRestriction
import Hironaka.Resolution.HironakaActualWholeStalkHolomorphicPullback

/-!
# The local ring of a strict transform is generated by the direction ratios (route step N6)

Route step N6 of the global half of Hironaka's flattening theorem
(`work/hironaka-resume-20261111/G10C/GLOBAL-FLATTENING-ROUTE.md` §5, item 1(e)).  Let `π : Z → M` be
the blowup of a complex manifold along a closed submanifold `C` (`IsBlowupAlong`), `W ⊆ M` closed,
`S = geoStrictTransform π C W` the geometric strict transform, and `p₀ : S → W` the projection of
actual reduced subspaces.  At a point `z ∈ S` over `C`:

* `hasRatioGeneration_geoStrictTransform`: the stalk map `p₀^♯ : 𝒪_{W,π z} → 𝒪_{S,z}` is generated by
  ratios (`HironakaG10ChowRatioAlgebra.HasRatioGeneration`) over the ideal `𝓘_C 𝒪_{W,π z}`: the
  normal flattening coordinates `x_i` (`i ≥ k`) of `C` generate it, `p₀^♯ x_i = t_i · p₀^♯ x_j` with
  `t_i` the coordinates `α_i/α_j` of the `j`-th monomial chart of the blowup, and every germ on `S` at
  `z` is congruent to a pull-back modulo the ideal of the `t_i - p₀^♯ a_i`, for ANY `a_i` with the
  right values.  Proof: in the monomial chart (`BlowupLocalSurjectivity.exists_monomialLocalInverse`)
  apply Hadamard's lemma with substitution
  (`HironakaG10ChowSubstitutionHadamard.exists_sub_comp_eq_sum`) to the chart expression `G` of the
  germ, substituting `a_i` for the ratio coordinates; the substituted germ is `K ∘ π` with `K`
  holomorphic on `M`.

Germ calculus used: `stalkMap_originalGerm` (stalk maps of manifold maps on function germs),
`actualSubspaceMap_stalkMap_germ` (the same for maps of actual subspaces).
-/

set_option autoImplicit false

open Set Filter TopologicalSpace CategoryTheory AlgebraicGeometry IsLocalRing
open scoped Topology Manifold ContDiff

namespace Hironaka.HironakaG10ChowRatioGeneration

open Hironaka.HolomorphicIdealSheaves Hironaka.BlowupSequences
  HironakaSmoothCentreRealDomainActualSheafStalk HironakaActualAnalyticSubspace
  HironakaActualAnalyticSubspaceMaps HironakaG10ChowGermIdealDictionary
  BlowupFlatCoordinates BlowupMonomialCharts BlowupLocalSurjectivity BlowupStrictSubmanifold
  HironakaG10ChowSubstitutionHadamard HironakaG10ChowRatioAlgebra

noncomputable section

/-! ### Germ calculus -/

section Germs

variable {n m : ℕ} {M N : Type} [TopologicalSpace M] [ChartedSpace (ComplexModel n) M]
  [IsComplexManifold n M] [TopologicalSpace N] [ChartedSpace (ComplexModel m) N]
  [IsComplexManifold m N]

omit [IsComplexManifold n M] in
theorem holomorphicAt_sub {f g : M → ℂ} {x : M} (hf : HolomorphicAt n f x)
    (hg : HolomorphicAt n g x) : HolomorphicAt n (fun y => f y - g y) x :=
  (hf.and hg).mono fun _ h => h.1.sub h.2

theorem originalGerm_sub (x : M) (f g : M → ℂ) (hf : HolomorphicAt n f x)
    (hg : HolomorphicAt n g x) :
    actualOriginalFunctionGerm x (fun z => f z - g z) (holomorphicAt_sub hf hg) =
      actualOriginalFunctionGerm x f hf - actualOriginalFunctionGerm x g hg := by
  apply (actualStalkChartEquiv (n := n) x).injective
  rw [map_sub, actualOriginalFunctionGerm_chart, actualOriginalFunctionGerm_chart,
    actualOriginalFunctionGerm_chart]
  rfl

theorem originalGerm_zero (x : M) :
    actualOriginalFunctionGerm x (fun _ => (0 : ℂ)) (holomorphicAt_const (n := n) (x := x) 0) =
      0 := by
  apply (actualStalkChartEquiv (n := n) x).injective
  rw [map_zero, actualOriginalFunctionGerm_chart]
  rfl

/-- Stalk maps of manifold maps pull function germs back. -/
theorem stalkMap_originalGerm {f : M → N}
    (hf : ContMDiff 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel m) ∞ f)
    (x : M) (g : N → ℂ) (hg : HolomorphicAt m g (f x)) :
    (ChartedSpace.locallyRingedSpaceMap f hf).stalkMap x (actualOriginalFunctionGerm (f x) g hg) =
      actualOriginalFunctionGerm x (g ∘ f)
        (hg.comp_contMDiff (Eventually.of_forall fun _ => hf.contMDiffAt)) := by
  apply (actualStalkChartEquiv (n := n) x).injective
  rw [HironakaActualAnalyticSubspaceOpenRestriction.actualNativeStalk_chart_pullback,
    actualOriginalFunctionGerm_chart,
    HironakaActualWholeStalkHolomorphicPullback.actualHolomorphicGermPullback_original_function,
    actualOriginalFunctionGerm_chart]

/-- Stalk maps of maps of actual subspaces pull (restricted) function germs back. -/
theorem actualSubspaceMap_stalkMap_germ {f : M → N}
    (hf : ContMDiff 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel m) ∞ f)
    {C : Set M} {D : Set N} (hCD : ∀ x ∈ C, f x ∈ D) (x : C) (g : N → ℂ)
    (hg : HolomorphicAt m g (f x.val)) :
    (actualSubspaceMap hf hCD).stalkMap x
        ((actualSubspaceInclusion (n := m) D).stalkMap (actualSubspaceMapTop hf hCD x)
          (actualOriginalFunctionGerm (f x.val) g hg)) =
      (actualSubspaceInclusion (n := n) C).stalkMap x
        (actualOriginalFunctionGerm x.val (g ∘ f)
          (hg.comp_contMDiff (Eventually.of_forall fun _ => hf.contMDiffAt))) := by
  have h := ConcreteCategory.congr_hom (actualSubspaceRingedMap_stalk_square hf hCD x)
    (actualOriginalFunctionGerm (f x.val) g hg)
  simp only [ConcreteCategory.comp_apply] at h
  exact h.trans ((ConcreteCategory.comp_apply _ _ _).trans
    (congrArg _ (stalkMap_originalGerm hf x.val g hg)))

end Germs

/-! ### Ratio generation on the geometric strict transform -/

section Chart

variable {n : ℕ} {M Z : Type} [TopologicalSpace M] [ChartedSpace (ComplexModel n) M]
  [IsComplexManifold n M] [TopologicalSpace Z] [ChartedSpace (ComplexModel n) Z]
  [IsComplexManifold n Z] {C W : Set M} {π : Z → M}

/-- The projection `S → W` of actual subspaces induced by the blowup (the same term as
`EmbeddedGeometricBlowup.geometricProjection`). -/
abbrev geoProj (hπ : IsBlowupAlong n C π) (hW : IsClosed W) :
    actualSubspaceLocallyRingedSpace (n := n) (geoStrictTransform π C W) ⟶
      actualSubspaceLocallyRingedSpace (n := n) W :=
  actualSubspaceMap hπ.contMDiff (fun _ hy =>
    geoStrictTransform_subset_preimage hπ.contMDiff.continuous hW hy)

/-- **The local ring of the geometric strict transform is generated by the direction ratios.** -/
theorem hasRatioGeneration_geoStrictTransform (hπ : IsBlowupAlong n C π) (hW : IsClosed W)
    (z : geoStrictTransform π C W) (hz : π z.val ∈ C) :
    HasRatioGeneration ((geoProj hπ hW).stalkMap z).hom
      (Ideal.map ((actualSubspaceInclusion (n := n) W).stalkMap ((geoProj hπ hW).base z)).hom
        (actualWholeSheafStalkIdeal (vanishingIdeal (n := n) C) (π z.val))) := by
  classical
  set y₀ : M := π z.val with hy₀def
  -- flattening coordinates of `C` at `y₀` and the monomial chart through `z`
  obtain ⟨k, -, -, Φ, hΦsrc, -, hflat⟩ := hπ.1.2 y₀ hz
  have hy₀F : y₀ ∈ flatDomain Φ := mem_flatDomain_self Φ
  obtain ⟨j, hj, O, hO, hzO, Wc, hWcs, hWc, hℓW, -⟩ :=
    exists_monomialLocalInverse hπ hΦsrc hflat (z := z.val) hy₀F
  obtain ⟨ℓ, ⟨hℓs, hℓπ⟩, -⟩ := existsUnique_monomialLift hπ hΦsrc hflat hj
  -- notation
  let iS := ((actualSubspaceInclusion (n := n) (geoStrictTransform π C W)).stalkMap z).hom
  let iW := ((actualSubspaceInclusion (n := n) W).stalkMap ((geoProj hπ hW).base z)).hom
  let q₀ := ((geoProj hπ hW).stalkMap z).hom
  have push : ∀ (F : M → ℂ) (hF : HolomorphicAt n F y₀),
      q₀ (iW (actualOriginalFunctionGerm y₀ F hF)) =
        iS (actualOriginalFunctionGerm z.val (F ∘ π)
          (hF.comp_contMDiff (Eventually.of_forall fun _ => hπ.contMDiff.contMDiffAt))) :=
    fun F hF => actualSubspaceMap_stalkMap_germ hπ.contMDiff _ z F hF
  have hWl : ∀ l, HolomorphicAt n (fun z' => Wc z' l) z.val := fun l => by
    filter_upwards [hO.mem_nhds hzO] with z' hz'
    have h1 : ContMDiffAt 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ℂ) ∞ (fun y => Wc y l) z' :=
      ((EuclideanSpace.proj l : ComplexModel n →L[ℂ] ℂ).contDiff.contMDiff.contMDiffAt).comp z'
        (hWcs z' hz')
    exact h1.mdifferentiableAt (by simp)
  -- the data
  let j₀ : {i : Fin n // k ≤ i.1} := ⟨j, hj⟩
  let g : {i : Fin n // k ≤ i.1} → _ := fun i =>
    iW (actualOriginalFunctionGerm y₀ (flatCoord Φ i.1) (holomorphicAt_flatCoord Φ i.1 hy₀F))
  let t : {i : Fin n // k ≤ i.1} → _ := fun i => if i = j₀ then 1 else
    iS (actualOriginalFunctionGerm z.val (fun z' => Wc z' i.1) (hWl i.1))
  refine ⟨{i : Fin n // k ≤ i.1}, inferInstance, g, t, j₀, ?_, ?_, ?_⟩
  · -- the normal flattening coordinates generate the ideal of `C`
    have hI : actualWholeSheafStalkIdeal (vanishingIdeal (n := n) C) y₀ =
        Ideal.span (Set.range fun i : {i : Fin n // k ≤ i.1} =>
          actualOriginalFunctionGerm y₀ (flatCoord Φ i.1) (holomorphicAt_flatCoord Φ i.1 hy₀F)) := by
      apply le_antisymm
      · refine Ideal.span_le.mpr ?_
        rintro _ ⟨f, hf, hmem, rfl⟩
        obtain ⟨b, hb0, hbh, hbeq⟩ := exists_eq_sum_flatCoord Φ hΦsrc hflat hy₀F hmem
        have hsum : HolomorphicAt n (fun y => ∑ i, b i y * flatCoord Φ i y) y₀ :=
          HolomorphicAt.sum _ fun i _ => (hbh i).mul (holomorphicAt_flatCoord Φ i hy₀F)
        rw [originalGerm_congr y₀ hf hsum hbeq,
          originalGerm_sum_mul y₀ b (flatCoord Φ) hbh (fun i => holomorphicAt_flatCoord Φ i hy₀F)]
        refine Ideal.sum_mem _ fun i _ => ?_
        by_cases hi : k ≤ i.1
        · exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨⟨i, hi⟩, rfl⟩)
        · have h0 : actualOriginalFunctionGerm y₀ (b i) (hbh i) = 0 := by
            rw [← originalGerm_zero (n := n) y₀]
            exact originalGerm_congr y₀ _ _ (by rw [hb0 i (not_le.mp hi)]; rfl)
          rw [h0, zero_mul]
          exact Ideal.zero_mem _
      · refine Ideal.span_le.mpr ?_
        rintro _ ⟨i, rfl⟩
        exact Ideal.subset_span ⟨flatCoord Φ i.1, holomorphicAt_flatCoord Φ i.1 hy₀F,
          flatCoord_mem_vanishingIdeal Φ hflat i.2 hy₀F, rfl⟩
    rw [hI, Ideal.map_span, ← Set.range_comp]
    rfl
  · -- `p₀^♯ x_i = t_i · p₀^♯ x_j`
    intro i
    by_cases hi : i = j₀
    · subst hi
      simp only [t, if_pos rfl, one_mul]
    · simp only [t, if_neg hi, g]
      rw [push, push, ← map_mul, ← originalGerm_mul]
      congr 1
      apply originalGerm_congr
      filter_upwards [hO.mem_nhds hzO] with z' hz'
      obtain ⟨-, hmz'⟩ := hWc z' hz'
      have hij : i.1 ≠ j := fun h => hi (Subtype.ext h)
      have h1 := congrArg (fun u : ComplexModel n => u i.1) hmz'
      have h2 := congrArg (fun u : ComplexModel n => u j) hmz'
      simp only [monomial_apply, if_pos (And.intro i.2 hij), ne_eq, not_true_eq_false,
        and_false, if_false] at h1 h2
      simp only [Function.comp_apply, flatCoord]
      rw [← h1, ← h2]
  · -- the analytic generation
    intro β a ha
    obtain ⟨r, hr⟩ := actualSubspaceInclusionRingedHom_stalk_surjective (n := n)
      (geoStrictTransform π C W) z β
    obtain ⟨H, hH, rfl⟩ := exists_originalGerm_eq z.val r
    subst hr
    have hlift : ∀ x, ∃ (F : M → ℂ) (hF : HolomorphicAt n F y₀),
        iW (actualOriginalFunctionGerm y₀ F hF) = x := by
      intro x
      obtain ⟨r, hr⟩ := actualSubspaceInclusionRingedHom_stalk_surjective (n := n) W
        ((geoProj hπ hW).base z) x
      obtain ⟨F, hF, rfl⟩ := exists_originalGerm_eq y₀ r
      exact ⟨F, hF, hr⟩
    choose A hA hAeq using fun i => hlift (a i)
    have hAπ : ∀ i, HolomorphicAt n (fun z' => A i (π z')) z.val := fun i =>
      (hA i).comp_contMDiff (Eventually.of_forall fun _ => hπ.contMDiff.contMDiffAt)
    -- the values of the ratios
    have hval : ∀ i : {i : Fin n // k ≤ i.1}, i ≠ j₀ → Wc z.val i.1 = A i y₀ := by
      intro i hi
      by_contra hne
      have hu := isUnit_originalGerm z.val (holomorphicAt_sub (hWl i.1) (hAπ i))
        (sub_ne_zero.mpr hne)
      have heq : t i - q₀ (a i) =
          iS (actualOriginalFunctionGerm z.val (fun z' => Wc z' i.1 - A i (π z'))
            (holomorphicAt_sub (hWl i.1) (hAπ i))) := by
        simp only [t, if_neg hi]
        rw [← hAeq i, push, originalGerm_sub, map_sub]
        rfl
      exact ha i (heq ▸ hu.map iS)
    -- the substituted coefficients, indexed by `Fin n`
    have hexA : ∃ A' : Fin n → M → ℂ, (∀ l (h : k ≤ l.1), A' l = A ⟨l, h⟩) ∧
        ∀ l, HolomorphicAt n (A' l) y₀ := by
      refine ⟨fun l => if h : k ≤ l.1 then A ⟨l, h⟩ else fun _ => 0, fun l h => dif_pos h,
        fun l => ?_⟩
      by_cases h : k ≤ l.1
      · simp only [dif_pos h]
        exact hA _
      · simp only [dif_neg h]
        exact holomorphicAt_const 0
    obtain ⟨A', hA'eq, hA'h⟩ := hexA
    -- the substitution map in flattening coordinates
    have hexΨ : ∃ Ψ : ComplexModel n → ComplexModel n, ∀ u l, Ψ u l =
        if k ≤ l.1 ∧ l ≠ j then A' l ((chartAt (ComplexModel n) y₀).symm (Φ.invFun u)) else u l :=
      ⟨fun u => WithLp.toLp 2 fun l =>
        if k ≤ l.1 ∧ l ≠ j then A' l ((chartAt (ComplexModel n) y₀).symm (Φ.invFun u)) else u l,
        fun _ _ => rfl⟩
    obtain ⟨Ψ, hΨ⟩ := hexΨ
    set u₀ := Φ.toFun (chartAt (ComplexModel n) y₀ y₀) with hu₀def
    set w₀ := Wc z.val with hw₀def
    have hmono0 : monomial k j w₀ = u₀ := (hWc z.val hzO).2
    have hw₀D : w₀ ∈ monomialDomain Φ k j := by
      show monomial k j w₀ ∈ Φ.target
      rw [hmono0]
      exact Φ.mapsTo_toFun hy₀F.2
    have hΨd : ∀ᶠ u in 𝓝 u₀, DifferentiableAt ℂ Ψ u := by
      filter_upwards [Φ.isOpen_target.mem_nhds (Φ.mapsTo_toFun hy₀F.2),
        (tendsto_flatInverse Φ hy₀F).eventually
          (eventually_all.2 fun l => (hA'h l).eventually)] with u hu hau
      rw [differentiableAt_euclidean]
      intro l
      have hfun : (fun x => Ψ x l) = fun x =>
          if k ≤ l.1 ∧ l ≠ j then A' l ((chartAt (ComplexModel n) y₀).symm (Φ.invFun x))
          else x l := funext fun x => hΨ x l
      rw [hfun]
      split_ifs
      · have hinvT := hΦsrc (Φ.mapsTo_invFun hu)
        have h1 := (hau l).mdifferentiableAt.comp (Φ.invFun u) (mdifferentiableAt_chart_symm hinvT)
        exact (mdifferentiableAt_iff_differentiableAt.mp h1).comp u
          (Φ.invFun_holomorphic.differentiableAt (Φ.isOpen_target.mem_nhds hu))
      · exact (EuclideanSpace.proj l : ComplexModel n →L[ℂ] ℂ).differentiableAt
    have hΨw₀ : Ψ u₀ = w₀ := by
      ext l
      rw [hΨ]
      split_ifs with hl
      · rw [hu₀def, flatInverse_flat Φ hy₀F, hA'eq l hl.1]
        exact (hval ⟨l, hl.1⟩ fun h => hl.2 (congrArg Subtype.val h)).symm
      · rw [← hmono0, monomial_apply, if_neg hl]
    -- the chart expression of the germ
    have hexG : ∃ G : ComplexModel n → ℂ, ∀ w (h : w ∈ monomialDomain Φ k j),
        G w = H (ℓ (LiftedOpen.mk _ w h)) :=
      ⟨fun w => if h : w ∈ monomialDomain Φ k j then H (ℓ (LiftedOpen.mk _ w h)) else 0,
        fun w h => dif_pos h⟩
    obtain ⟨G, hG⟩ := hexG
    have hℓ₀ : ℓ (LiftedOpen.mk _ w₀ hw₀D) = z.val := hℓW ℓ hℓs hℓπ z.val hzO hw₀D
    have hGd : ∀ᶠ w in 𝓝 w₀, DifferentiableAt ℂ G w := by
      have h1 : ℓ ⁻¹' {z' | MDifferentiableAt 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ℂ) H z'} ∈
          𝓝 (LiftedOpen.mk _ w₀ hw₀D) :=
        hℓs.continuous.continuousAt.preimage_mem_nhds (by rw [hℓ₀]; exact hH)
      have h2 := (LiftedOpen.isOpenEmbedding_toModel (monomialDomain Φ k j)).isOpenMap.image_mem_nhds h1
      rw [LiftedOpen.toModel_mk] at h2
      filter_upwards [h2] with w hw
      obtain ⟨p, hp, rfl⟩ := hw
      have hpD : LiftedOpen.toModel _ p ∈ monomialDomain Φ k j := LiftedOpen.toModel_mem _ p
      have hm : MDifferentiableAt 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ℂ) (H ∘ ℓ) p :=
        (show MDifferentiableAt 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ℂ) H (ℓ p) from hp).comp p
          ((hℓs p).mdifferentiableAt (by simp))
      have h := hm.differentiableWithinAt_writtenInExtChartAt
      simp only [modelWithCornersSelf_coe, range_id, differentiableWithinAt_univ,
        LiftedOpen.extChartAt_eq] at h
      apply h.congr_of_eventuallyEq
      filter_upwards [(monomialDomain Φ k j).isOpen.mem_nhds hpD] with w hw
      rw [hG w hw]
      simp only [writtenInExtChartAt, extChartAt_model_space_eq_id, PartialEquiv.refl_coe,
        Function.comp_apply, id,
        BlowupFibreDirection.liftedOpen_extChartAt_symm _ p hw]
    -- the substitution `v = Ψ ∘ σ_j` and Hadamard's lemma
    have hexv : ∃ v : ComplexModel n → ComplexModel n, ∀ w, v w = Ψ (monomial k j w) :=
      ⟨fun w => Ψ (monomial k j w), fun _ => rfl⟩
    obtain ⟨v, hv⟩ := hexv
    have hvd : ∀ᶠ w in 𝓝 w₀, DifferentiableAt ℂ v w := by
      have h1 : ∀ᶠ w in 𝓝 w₀, DifferentiableAt ℂ Ψ (monomial k j w) :=
        (contDiff_monomial k j).continuous.continuousAt.eventually (by rw [hmono0]; exact hΨd)
      filter_upwards [h1] with w hw
      have hfun : v = fun w => Ψ (monomial k j w) := funext hv
      rw [hfun]
      exact hw.comp w ((contDiff_monomial k j).contDiffAt.differentiableAt (by simp))
    have hv₀ : v w₀ = w₀ := by rw [hv, hmono0, hΨw₀]
    obtain ⟨Hl, hHl, hHeq⟩ := exists_sub_comp_eq_sum hGd hvd hv₀
    -- the substituted germ on `M`
    have hexK : ∃ K : M → ℂ, ∀ y, K y = G (Ψ (Φ.toFun (chartAt (ComplexModel n) y₀ y))) :=
      ⟨fun y => G (Ψ (Φ.toFun (chartAt (ComplexModel n) y₀ y))), fun _ => rfl⟩
    obtain ⟨K, hK⟩ := hexK
    have hKh : HolomorphicAt n K y₀ := by
      have hΨc : ContinuousAt Ψ u₀ := hΨd.self_of_nhds.continuousAt
      have hGΨ : ∀ᶠ u in 𝓝 u₀, DifferentiableAt ℂ (fun u => G (Ψ u)) u := by
        filter_upwards [hΨd, hΨc.eventually (by rw [hΨw₀]; exact hGd)] with u hu hGu
        exact hGu.comp u hu
      have h := holomorphicAt_comp_flat Φ hy₀F hGΨ
      have hfun : K = fun y => G (Ψ (Φ.toFun (chartAt (ComplexModel n) y₀ y))) := funext hK
      rw [hfun]
      exact h
    -- the coefficients on `Z`
    let c : Fin n → Z → ℂ := fun l z' => Hl l (Wc z')
    let s : Fin n → Z → ℂ := fun l =>
      if k ≤ l.1 ∧ l ≠ j then fun z' => Wc z' l - A' l (π z') else fun _ => 0
    have hc : ∀ l, HolomorphicAt n (c l) z.val := by
      intro l
      filter_upwards [hO.mem_nhds hzO, (hWcs z.val hzO).continuousAt.eventually (hHl l)]
        with z' hz' hd
      exact hd.mdifferentiableAt.comp z' ((hWcs z' hz').mdifferentiableAt (by simp))
    have hs : ∀ l, HolomorphicAt n (s l) z.val := by
      intro l
      by_cases hl : k ≤ l.1 ∧ l ≠ j
      · simp only [s, if_pos hl]
        exact holomorphicAt_sub (hWl l)
          ((hA'h l).comp_contMDiff (Eventually.of_forall fun _ => hπ.contMDiff.contMDiffAt))
      · simp only [s, if_neg hl]
        exact holomorphicAt_const 0
    have hKπ : HolomorphicAt n (K ∘ π) z.val :=
      hKh.comp_contMDiff (Eventually.of_forall fun _ => hπ.contMDiff.contMDiffAt)
    -- the pointwise identity near `z`
    have hpt : (fun z' => H z' - (K ∘ π) z') =ᶠ[𝓝 z.val] fun z' => ∑ l, c l z' * s l z' := by
      filter_upwards [hO.mem_nhds hzO, (hWcs z.val hzO).continuousAt.eventually hHeq]
        with z' hz' hH'
      obtain ⟨hπz', hmz'⟩ := hWc z' hz'
      have hD' : Wc z' ∈ monomialDomain Φ k j := by
        show monomial k j (Wc z') ∈ Φ.target
        rw [hmz']
        exact Φ.mapsTo_toFun hπz'.2
      have hG1 : G (Wc z') = H z' := by rw [hG _ hD', hℓW ℓ hℓs hℓπ z' hz' hD']
      have hG2 : (K ∘ π) z' = G (v (Wc z')) := by
        rw [Function.comp_apply, hK, hv, hmz']
      show H z' - (K ∘ π) z' = _
      rw [← hG1, hG2, hH']
      refine Finset.sum_congr rfl fun l _ => ?_
      rw [mul_comm]
      congr 1
      rw [hv, hmz', hΨ]
      by_cases hl : k ≤ l.1 ∧ l ≠ j
      · simp only [s, if_pos hl]
        rw [flatInverse_flat Φ hπz']
      · simp only [s, if_neg hl]
        rw [← hmz', monomial_apply, if_neg hl, sub_self]
    -- conclusion
    refine ⟨iW (actualOriginalFunctionGerm y₀ K hKh), ?_⟩
    have hgerm : actualOriginalFunctionGerm z.val H hH -
        actualOriginalFunctionGerm z.val (K ∘ π) hKπ =
          ∑ l, actualOriginalFunctionGerm z.val (c l) (hc l) *
            actualOriginalFunctionGerm z.val (s l) (hs l) :=
      (originalGerm_sub z.val H (K ∘ π) hH hKπ).symm.trans
        ((originalGerm_congr z.val _ (HolomorphicAt.sum _ fun l _ => (hc l).mul (hs l)) hpt).trans
          (originalGerm_sum_mul z.val c s hc hs _))
    have hstep : iS (actualOriginalFunctionGerm z.val H hH) - q₀ (iW (actualOriginalFunctionGerm y₀ K hKh)) =
        ∑ l, iS (actualOriginalFunctionGerm z.val (c l) (hc l)) *
          iS (actualOriginalFunctionGerm z.val (s l) (hs l)) := by
      rw [push, ← map_sub, hgerm, map_sum]
      simp only [map_mul]
    change iS (actualOriginalFunctionGerm z.val H hH) - q₀ (iW (actualOriginalFunctionGerm y₀ K hKh)) ∈ _
    rw [hstep]
    refine Ideal.sum_mem _ fun l _ => Ideal.mul_mem_left _ _ ?_
    by_cases hl : k ≤ l.1 ∧ l ≠ j
    · have hi : (⟨l, hl.1⟩ : {i : Fin n // k ≤ i.1}) ≠ j₀ := fun h => hl.2 (congrArg Subtype.val h)
      have heq : iS (actualOriginalFunctionGerm z.val (s l) (hs l)) =
          t ⟨l, hl.1⟩ - q₀ (a ⟨l, hl.1⟩) := by
        have h1 : actualOriginalFunctionGerm z.val (s l) (hs l) =
            actualOriginalFunctionGerm z.val (fun z' => Wc z' l - A ⟨l, hl.1⟩ (π z'))
              (holomorphicAt_sub (hWl l) (hAπ ⟨l, hl.1⟩)) := by
          apply originalGerm_congr
          refine Eventually.of_forall fun z' => ?_
          simp only [s, if_pos hl, hA'eq l hl.1]
        simp only [t, if_neg hi]
        rw [h1, originalGerm_sub, map_sub, ← hAeq ⟨l, hl.1⟩, push]
        rfl
      rw [heq]
      exact Ideal.subset_span ⟨⟨l, hl.1⟩, rfl⟩
    · have h1 : actualOriginalFunctionGerm z.val (s l) (hs l) = 0 := by
        rw [← originalGerm_zero (n := n) z.val]
        apply originalGerm_congr
        refine Eventually.of_forall fun z' => ?_
        simp only [s, if_neg hl]
      rw [h1, map_zero]
      exact Ideal.zero_mem _

end Chart

