/-- The actual holomorphic cusp polynomial on its two-dimensional model. -/
def cuspFunction (p : ℕ) (z : ComplexModel 2) : ℂ := z.ofLp 1 ^ 2 - z.ofLp 0 ^ p

/-- The coherent analytic ideal generated by the actual cusp function. -/
def cuspIdeal (p : ℕ) : GermIdeal 2 (ComplexModel 2) :=
  actualPrincipalCoefficientIdeal 2 (cuspFunction p)

private theorem holomorphic_cusp (p : ℕ) : Differentiable ℂ (cuspFunction p) :=
  ((EuclideanSpace.proj (𝕜 := ℂ) (1 : Fin 2)).differentiable.pow 2).sub
    ((EuclideanSpace.proj (𝕜 := ℂ) (0 : Fin 2)).differentiable.pow p)

/-- Coherence on the entire initial analytic model. -/
theorem cuspIdeal_coherent (p : ℕ) : (cuspIdeal p).IsCoherent := by
  have hh := coherentOn_actualPrincipalCoefficientIdeal 2 (cuspFunction p) univ isOpen_univ
    (holomorphic_cusp p).mdifferentiable.mdifferentiableOn
  intro z
  obtain ⟨U,hU,hz,_,hgen⟩ := hh z (mem_univ z)
  exact ⟨U,hU,hz,hgen⟩

private theorem cusp_fderiv (p : ℕ) (z v : ComplexModel 2) :
    fderiv ℂ (cuspFunction p) z v =
      2 * z.ofLp 1 * v.ofLp 1 - (p : ℂ) * z.ofLp 0 ^ (p-1) * v.ofLp 0 := by
  have h := (((EuclideanSpace.proj (𝕜 := ℂ) (1 : Fin 2)).hasFDerivAt (x := z)).pow 2).sub
    (((EuclideanSpace.proj (𝕜 := ℂ) (0 : Fin 2)).hasFDerivAt (x := z)).pow p)
  have he := congrArg (fun f : ComplexModel 2 →L[ℂ] ℂ => f v) h.fderiv
  change fderiv ℂ ((fun x : ComplexModel 2 => x.ofLp 1 ^ 2) -
    (fun x : ComplexModel 2 => x.ofLp 0 ^ p)) z v = _
  simpa [two_nsmul, add_mul, nsmul_eq_mul] using he

private theorem cusp_coord_hol (i : Fin 2) :
    HolomorphicAt 2 (fun z : ComplexModel 2 => z.ofLp i) 0 :=
  Eventually.of_forall (fun _ => (EuclideanSpace.proj (𝕜 := ℂ) i).differentiableAt.mdifferentiableAt)

private theorem cusp_order_trace_generator (p : ℕ) :
    VanishesToOrderOn 2 {z : ComplexModel 2 | z.ofLp 1 = 0} 0 p (cuspFunction p) := by
  have hx := mem_pointIdeal_of_apply_eq_zero (cusp_coord_hol 0) (by simp)
  have hxp := pow_mem_idealPow hx (cusp_coord_hol 0) p
  have hneg := mul_mem_idealPow (holomorphicAt_const (-1 : ℂ)) hxp
  refine ⟨_,hneg,Eventually.of_forall ?_⟩
  intro z hz
  change z.ofLp 1 = 0 at hz
  simp [cuspFunction,hz]


/-- Every germ in the actual first derivative ideal vanishes to order at
least p-1 along the cusp's coordinate tangent line. -/
theorem cusp_derivative_trace_bound (p : ℕ) :
    OrderGE 2 {z : ComplexModel 2 | z.ofLp 1 = 0} (derivIdeal (cuspIdeal p)) 0 (p-1) := by
  let e := complexChartAt (n := 2) (0 : ComplexModel 2)
  let s : Fin 1 → ComplexModel 2 → ℂ := fun _ => cuspFunction p
  have he : e.val = OpenPartialHomeomorph.refl (ComplexModel 2) := chartAt_self_eq
  have hGen (z : ComplexModel 2) (_ : z ∈ (univ : Set (ComplexModel 2))) (g : ComplexModel 2 → ℂ) :
      (cuspIdeal p).mem z g ↔ IsInSpanAt (n := 2) (· ∈ range s) z g := by
    change IsInSpanAt (n := 2) (· = cuspFunction p) z g ↔ _
    have h : range s = {cuspFunction p} := by ext f; simp [s]
    rw [h]
    rfl
  intro g hg
  have hSpan := (derivIdeal_mem_iff_of_generators (𝔞 := cuspIdeal p) isOpen_univ
    (fun _ => (holomorphic_cusp p).mdifferentiable.mdifferentiableOn) hGen
    e (by rw [he]; exact subset_rfl) (mem_univ (0 : ComplexModel 2)) g).mp hg
  apply IdealOrderArithmetic.IsInSpanAt.vanishesToOrderOn hSpan
  rintro f ⟨i,rfl⟩
  cases i with
  | inl i => exact VanishesToOrderOn.mono (Nat.sub_le p 1) (cusp_order_trace_generator p)
  | inr ij =>
    let v : ComplexModel 2 := EuclideanSpace.single ij.2 1
    have hx := mem_pointIdeal_of_apply_eq_zero (cusp_coord_hol 0) (by simp)
    have hxp := pow_mem_idealPow hx (cusp_coord_hol 0) (p-1)
    have hconst := mul_mem_idealPow (holomorphicAt_const (-(p : ℂ) * v.ofLp 0)) hxp
    refine ⟨_,hconst,Eventually.of_forall ?_⟩
    intro z hz
    change z.ofLp 1 = 0 at hz
    change chartDeriv e v (cuspFunction p) z = _
    have hDeriv : chartDeriv e v (cuspFunction p) z = fderiv ℂ (cuspFunction p) z v := by
      unfold chartDeriv
      rw [he]
      rfl
    rw [hDeriv,cusp_fderiv,hz]
    ring


/-- Exact order of the whole analytic cusp ideal on its tangent line. -/
theorem cusp_ideal_trace_order (p : ℕ) :
    order 2 {z : ComplexModel 2 | z.ofLp 1 = 0} (cuspIdeal p) 0 = (p : ℕ∞) := by
  let S : Set (ComplexModel 2) := {z | z.ofLp 1 = 0}
  have hC := cuspIdeal_coherent p
  have hHol := fun g hg => GermIdeal.IsCoherent.holomorphicAt_mem hC
    (x := (0 : ComplexModel 2)) (g := g) hg
  have hLower : OrderGE 2 S (cuspIdeal p) 0 p := by
    intro g hg
    change IsInSpanAt (n := 2) (· = cuspFunction p) 0 g at hg
    exact IdealOrderArithmetic.IsInSpanAt.vanishesToOrderOn hg
      (fun s hs => hs.symm ▸ cusp_order_trace_generator p)
  apply le_antisymm _ ((le_order_iff hHol).mpr hLower)
  apply iSup₂_le
  intro q hq
  have hgen : (cuspIdeal p).mem 0 (cuspFunction p) :=
    mem_actualPrincipalCoefficientIdeal 2 (cuspFunction p) univ isOpen_univ
      (holomorphic_cusp p).mdifferentiable.mdifferentiableOn 0 (mem_univ 0)
  by_contra! hBad
  have hpq : p+1 ≤ q := by exact_mod_cast hBad
  obtain ⟨g,hg,hEqual⟩ := (hq (cuspFunction p) hgen).mono hpq
  let ι := tangentInclusion 1 1
  have hι0 : ι (0 : ComplexModel 1) = 0 := map_zero ι
  have hι : ∀ᶠ z in 𝓝 (0 : ComplexModel 1),
      MDifferentiableAt 𝓘(ℂ,ComplexModel 1) 𝓘(ℂ,ComplexModel 2) ι z :=
    Eventually.of_forall (fun _ => ι.differentiableAt.mdifferentiableAt)
  have hComp := comp_mem_idealPow_pointIdeal hι (p+1) (by simpa only [hι0] using hg)
  have hEq : cuspFunction p ∘ ι =ᶠ[𝓝 (0 : ComplexModel 1)] g ∘ ι := by
    have hh : Tendsto ι (𝓝 (0 : ComplexModel 1)) (𝓝 (ι 0)) := ι.continuous.continuousAt.tendsto
    rw [hι0] at hh
    filter_upwards [hh.eventually hEqual] with z hz
    exact hz (show (ι z).ofLp 1 = 0 from tangentInclusion_normal 1 1 z 0)
  have hPow := mem_idealPow_congr hComp hEq.symm
  have hAnal : ∀ᶠ z in 𝓝 (0 : ComplexModel 1), DifferentiableAt ℂ (cuspFunction p ∘ ι) z :=
    Eventually.of_forall fun z => (holomorphic_cusp p (ι z)).comp z ι.differentiableAt
  have hGerm := (mem_maximalIdeal_pow_iff_point_power hAnal (p+1)).mpr hPow
  have hId : HolGerm.mk (cuspFunction p ∘ ι) hAnal = planeTrace 1 1 (cuspGerm p) := by
    rw [cusp_tangent_trace]
    let f := fun z : ComplexModel 1 => z.ofLp 0
    have hf : ∀ᶠ z in 𝓝 (0 : ComplexModel 1), DifferentiableAt ℂ f z :=
      Eventually.of_forall fun _ => (EuclideanSpace.proj (𝕜 := ℂ) (0 : Fin 1)).differentiableAt
    have hT : normalCoordinate 0 1 0 = HolGerm.mk f hf := rfl
    change HolGerm.mk (cuspFunction p ∘ ι) hAnal = -(normalCoordinate 0 1 0 ^ p)
    rw [hT, ← HolGerm.mk_pow f hf p, ← HolGerm.mk_neg]
    apply HolGerm.mk_eq_mk_iff.mpr
    refine Eventually.of_forall fun z => ?_
    have hzero : (ι z).ofLp 1 = 0 := tangentInclusion_normal 1 1 z 0
    have hcoord : (ι z).ofLp 0 = z.ofLp 0 := tangentInclusion_tangent 1 1 z 0
    simp [cuspFunction,hzero,hcoord,f]
  exact (cusp_tangent_trace_order p).2 (hId ▸ hGerm)

/-- Full actual double-coefficient order on the cusp line, with all
summands included. -/
theorem cusp_double_coefficient_trace_order (p : ℕ) (hp : 2 ≤ p) :
    let M : MarkedIdeal 2 (ComplexModel 2) := ⟨univ, [], cuspIdeal p, 2⟩
    order 2 {z : ComplexModel 2 | z.ofLp 1 = 0}
      (coeffMarkedAlong (coeffMarkedAlong (homMarkedAlong M))).ideal 0 = (p : ℕ∞) := by
  intro M
  exact mark_two_double_coefficient_trace_order M (cuspIdeal_coherent p) rfl rfl _ 0
    (by simp) p (p-1) (cusp_ideal_trace_order p) (cusp_derivative_trace_bound p) (by omega)


private theorem cusp_chart_derivatives (p : ℕ) (z : ComplexModel 2) (i : Fin 2) :
    chartDeriv (complexChartAt (n := 2) (0 : ComplexModel 2))
      (EuclideanSpace.single i 1) (cuspFunction p) z =
    2 * z.ofLp 1 * (EuclideanSpace.single i (1 : ℂ)).ofLp 1 -
      (p : ℂ) * z.ofLp 0 ^ (p-1) * (EuclideanSpace.single i (1 : ℂ)).ofLp 0 := by
  have he : (complexChartAt (n := 2) (0 : ComplexModel 2)).val =
    OpenPartialHomeomorph.refl (ComplexModel 2) := chartAt_self_eq
  unfold chartDeriv
  rw [he]
  exact cusp_fderiv p z _

private theorem cusp_generator_mem (p : ℕ) (z : ComplexModel 2) :
    (cuspIdeal p).mem z (cuspFunction p) :=
  mem_actualPrincipalCoefficientIdeal 2 (cuspFunction p) univ isOpen_univ
    (holomorphic_cusp p).mdifferentiable.mdifferentiableOn z (mem_univ z)

private theorem cusp_y_mem_deriv (p : ℕ) (z : ComplexModel 2) :
    (derivIdeal (cuspIdeal p)).mem z (fun x => x.ofLp 1) := by
  let e := complexChartAt (n := 2) (0 : ComplexModel 2)
  have he : e.val = OpenPartialHomeomorph.refl (ComplexModel 2) := chartAt_self_eq
  have hz : z ∈ e.val.source := by rw [he]; exact mem_univ z
  have hHol := fun x g hg => GermIdeal.IsCoherent.holomorphicAt_mem (cuspIdeal_coherent p)
    (x := x) (g := g) hg
  have hDeriv := chartDeriv_mem_derivIdeal hHol (e := e)
    (v := EuclideanSpace.single (1 : Fin 2) 1) hz (cusp_generator_mem p z)
  have hD := isCoherent_iterDerivIdeal (cuspIdeal_coherent p) 1
  have hScale := IsInSpanAt.mul_left (holomorphicAt_const (1 / 2 : ℂ))
    (isInSpanAt_self hDeriv (holomorphicAt_chartDeriv hz (hHol z _ (cusp_generator_mem p z))))
  apply HomogenizedIdeal.mem_of_isInSpanAt hD
  apply DerivativeIdeal.isInSpanAt_congr hScale
  refine Eventually.of_forall fun a => ?_
  change (1 / 2 : ℂ) * chartDeriv e (EuclideanSpace.single 1 1) (cuspFunction p) a = a.ofLp 1
  rw [cusp_chart_derivatives]
  norm_num [PiLp.single_apply]
  ring

/-- The actual coordinate y is a valid global tangent direction to the
coherent mark-two cusp input. -/
theorem cusp_actual_tangent (p : ℕ) :
    IsTangentDirectionAlong (univ : Set (ComplexModel 2)) (cuspIdeal p) 2 univ (fun x => x.ofLp 1) := by
  refine ⟨isOpen_univ, ?_, ?_⟩
  · intro z _
    rw [iterDerivIdealAlong_univ (fun x g hg => GermIdeal.IsCoherent.holomorphicAt_mem
      (cuspIdeal_coherent p) (x := x) (g := g) hg)]
    exact cusp_y_mem_deriv p z
  · intro z _ _
    let e := complexChartAt (n := 2) (0 : ComplexModel 2)
    let ξ : Fin 2 → ComplexModel 2 → ℂ := fun j _ => if j = 1 then 1 else 0
    have he : e.val = OpenPartialHomeomorph.refl (ComplexModel 2) := chartAt_self_eq
    have hz : z ∈ e.val.source := by rw [he]; exact mem_univ z
    refine ⟨e, ξ, isTangentField_univ hz (fun j => holomorphicAt_const _), ?_⟩
    have hF (j : Fin 2) : chartDeriv e (EuclideanSpace.single j 1)
        (fun x : ComplexModel 2 => x.ofLp 1) z = if (1 : Fin 2) = j then 1 else 0 := by
      unfold chartDeriv
      rw [he]
      change fderiv ℂ (EuclideanSpace.proj (𝕜 := ℂ) (1 : Fin 2)) z
        (EuclideanSpace.single j 1) = _
      rw [(EuclideanSpace.proj (𝕜 := ℂ) (1 : Fin 2)).fderiv]
      exact PiLp.single_apply 2 ℂ j 1 1
    simp [fieldDeriv, ξ, hF]


/-- The singular maximal-order cusp cosupport is the actual origin. -/
theorem cusp_cosupport_two (p : ℕ) (hp : 2 ≤ p) :
    cosupport 2 univ (cuspIdeal p) 2 = {(0 : ComplexModel 2)} := by
  ext z
  constructor
  · intro hz
    have hHol := fun x g hg => GermIdeal.IsCoherent.holomorphicAt_mem (cuspIdeal_coherent p)
      (x := x) (g := g) hg
    have hy : z.ofLp 1 = 0 :=
      (cusp_actual_tangent p).cosupport_inter_subset hHol (by decide) ⟨hz,mem_univ z⟩
    let e := complexChartAt (n := 2) (0 : ComplexModel 2)
    have he : e.val = OpenPartialHomeomorph.refl (ComplexModel 2) := chartAt_self_eq
    have hzE : z ∈ e.val.source := by rw [he]; exact mem_univ z
    let δ := chartDeriv e (EuclideanSpace.single (0 : Fin 2) 1) (cuspFunction p)
    have hDeriv : (derivIdeal (cuspIdeal p)).mem z δ :=
      chartDeriv_mem_derivIdeal hHol hzE (cusp_generator_mem p z)
    have hδ := (vanishesToOrderOn_one_iff (mem_univ z)
      (holomorphicAt_of_mem_derivIdeal hDeriv)).mp ((cosupport_succ_subset_cosupport_derivIdeal 1 hz).2 δ hDeriv)
    change chartDeriv e (EuclideanSpace.single (0 : Fin 2) 1) (cuspFunction p) z = 0 at hδ
    rw [cusp_chart_derivatives] at hδ
    have hd : -( (p : ℂ) * z.ofLp 0 ^ (p-1)) = 0 := by
      simpa [PiLp.single_apply] using hδ
    have hpc : (p : ℂ) ≠ 0 := by exact_mod_cast (show p ≠ 0 by omega)
    have hx : z.ofLp 0 = 0 := by
      have hh := (mul_eq_zero.mp (neg_eq_zero.mp hd)).resolve_left hpc
      exact (pow_eq_zero_iff (by omega : p-1 ≠ 0)).mp hh
    apply mem_singleton_iff.mpr
    ext j
    fin_cases j <;> assumption
  · rintro (rfl : z = 0)
    refine ⟨mem_univ _,fun g hg => ?_⟩
    change IsInSpanAt (n := 2) (· = cuspFunction p) 0 g at hg
    apply IdealOrderArithmetic.IsInSpanAt.vanishesToOrderOn hg
    rintro a (rfl : a = cuspFunction p)
    have hx := mem_pointIdeal_of_apply_eq_zero (cusp_coord_hol 0) (by simp)
    have hy := mem_pointIdeal_of_apply_eq_zero (cusp_coord_hol 1) (by simp)
    have hxP := idealPow_le_of_le (fun _ _ hg => holomorphicAt_of_mem_pointIdeal hg) hp _ _
      (pow_mem_idealPow hx (cusp_coord_hol 0) p)
    have hyP := pow_mem_idealPow hy (cusp_coord_hol 1) 2
    have hNeg := mul_mem_idealPow (holomorphicAt_const (-1 : ℂ)) hxP
    refine ⟨_,mem_idealPow_add hyP hNeg,Eventually.of_forall fun z _ => ?_⟩
    change z.ofLp 1 ^ 2 - z.ofLp 0 ^ p = z.ofLp 1 ^ 2 + -1 * z.ofLp 0 ^ p
    ring


private noncomputable abbrev cuspModel : CMfd.{0} 2 := CMfd.of (n := 2) (ComplexModel 2)
private noncomputable abbrev cuspMarked (p : ℕ) : MarkedIdeal 2 cuspModel := ⟨univ, [], cuspIdeal p, 2⟩

private theorem cusp_domain (p : ℕ) : IsInvDomain 2 (cuspMarked p) := by
  refine ⟨⟨HomogenizedGlueingTower.isClosedSubmanifold_univ,cuspIdeal_coherent p,
    NormalCrossings.isSNCDivisor_nil,
    NormalCrossings.isTransverse_nil_of_isClosedSubmanifold HomogenizedGlueingTower.isClosedSubmanifold_univ⟩,
    fun x _ => ⟨2,le_rfl,regularAtDim_univ x⟩,by change 1 ≤ 2; decide,?_⟩
  intro x _
  refine ⟨cuspFunction p,cusp_generator_mem p x,?_⟩
  apply Frequently.mono (p := fun z => cuspFunction p z ≠ 0) _ (fun z hz => ⟨mem_univ z,hz⟩)
  by_contra h
  have hEq : cuspFunction p =ᶠ[𝓝 x] (fun _ => (0 : ℂ)) := by
    change ∀ᶠ z in 𝓝 x, cuspFunction p z = 0
    simpa using h
  have hAnal : AnalyticOnNhd ℂ (cuspFunction p) univ := by
    intro z _
    exact (((EuclideanSpace.proj (𝕜 := ℂ) (1 : Fin 2)).analyticAt z |>.pow 2).sub
      ((EuclideanSpace.proj (𝕜 := ℂ) (0 : Fin 2)).analyticAt z |>.pow p))
  have hAll := hAnal.eq_of_eventuallyEq analyticOnNhd_const hEq
  have hP := congrFun hAll (EuclideanSpace.single (1 : Fin 2) (1 : ℂ))
  have hPositive : cuspFunction p (EuclideanSpace.single (1 : Fin 2) (1 : ℂ)) ≠ 0 := by
    -- Only the positive exponents are needed below. For zero the value at the origin is nonzero.
    by_cases hp : p = 0
    · subst p
      have h₀ := congrFun hAll (0 : ComplexModel 2)
      norm_num [cuspFunction] at h₀
    · simp [cuspFunction,zero_pow hp]
  exact hPositive hP

private theorem cusp_no_codimOne (p : ℕ) (hp : 2 ≤ p) :
    codimOnePartAlong (barMarked (X := cuspModel) (cuspMarked p)).N
      (barMarked (X := cuspModel) (cuspMarked p)).ideal (barMarked (X := cuspModel) (cuspMarked p)).d = ∅ := by
  apply eq_empty_iff_forall_notMem.mpr
  intro x hx
  have hCos := cosupp_barMarked (𝔍 := cuspMarked p) (cusp_domain p).isWellFormed (by change 1 ≤ 2; decide)
  change (barMarked (X := cuspModel) (cuspMarked p)).cosupp = cosupport 2 univ (cuspIdeal p) 2 at hCos
  rw [cusp_cosupport_two p hp] at hCos
  obtain ⟨k,hFull,hPart⟩ := hx
  change RegularAtDim (n := 2) (univ : Set (ComplexModel 2)) x (k+1) at hFull
  change RegularAtDim (n := 2) (barMarked (X := cuspModel) (cuspMarked p)).cosupp x k at hPart
  rw [hCos] at hPart
  have hx0 : x = 0 := mem_singleton_iff.mp hPart.2.1
  subst x
  have h₁ := eq_of_regularAtDim hFull (regularAtDim_univ (n := 2) (0 : ComplexModel 2))
  have h₂ := eq_of_regularAtDim hPart (regularAtDim_zero (d := 2))
  omega

private theorem cusp_maximal (p : ℕ) (hp : 2 ≤ p) :
    IsMaximalOrderAlong (cuspMarked p).N (cuspMarked p).ideal (cuspMarked p).d := by
  intro x hx
  have hx2 := cosupport_anti (by decide : 2 ≤ 3) hx
  change x ∈ cosupport 2 univ (cuspIdeal p) 2 at hx2
  rw [cusp_cosupport_two p hp] at hx2
  have hx0 := mem_singleton_iff.mp hx2
  subst x
  let e := complexChartAt (n := 2) (0 : ComplexModel 2)
  have he : e.val = OpenPartialHomeomorph.refl (ComplexModel 2) := chartAt_self_eq
  have hzE : (0 : ComplexModel 2) ∈ e.val.source := by rw [he]; exact mem_univ _
  have hHol := fun x g hg => GermIdeal.IsCoherent.holomorphicAt_mem (cuspIdeal_coherent p)
    (x := x) (g := g) hg
  have hDeriv := chartDeriv_mem_derivIdeal hHol hzE (cusp_generator_mem p 0)
    (v := EuclideanSpace.single (1 : Fin 2) 1)
  have hDD := cosupport_succ_subset_cosupport_derivIdeal 2 hx
  have hDD' := cosupport_succ_subset_cosupport_derivIdeal 1 hDD
  have hYY := chartDeriv_mem_derivIdeal (fun _ _ hm => holomorphicAt_of_mem_derivIdeal hm)
    (e := e) (v := EuclideanSpace.single (1 : Fin 2) 1) hzE hDeriv
  have hZero := (vanishesToOrderOn_one_iff (mem_univ (0 : ComplexModel 2))
    (holomorphicAt_of_mem_derivIdeal hYY)).mp (hDD'.2 _ hYY)
  have hFirst : chartDeriv e (EuclideanSpace.single 1 1) (cuspFunction p) =
      (fun z : ComplexModel 2 => 2 * z.ofLp 1) := by
    funext z
    rw [cusp_chart_derivatives]
    norm_num [PiLp.single_apply]
  rw [hFirst] at hZero
  unfold chartDeriv at hZero
  rw [he] at hZero
  have hDiff := ((EuclideanSpace.proj (𝕜 := ℂ) (1 : Fin 2)).hasFDerivAt (x := (0 : ComplexModel 2))).const_mul (2 : ℂ)
  change fderiv ℂ (fun z : ComplexModel 2 => 2 * (EuclideanSpace.proj (𝕜 := ℂ) (1 : Fin 2)) z) 0
    (EuclideanSpace.single (1 : Fin 2) 1) = 0 at hZero
  rw [hDiff.fderiv] at hZero
  norm_num [PiLp.single_apply] at hZero


private noncomputable abbrev cuspContact (p : ℕ) :
    MarkedIdeal 2 (⊤ : Opens (ComplexModel 2)) :=
  contactMarkedKept (cuspMarked p) (fun z => z.ofLp 1) (.refl : BlowupTower cuspModel cuspModel) ⊤

private theorem cusp_contact_domain (p : ℕ) (hp : 2 ≤ p) : IsInvDomain 1 (cuspContact p) := by
  have hM := cusp_domain p
  exact isInvDomain_stage_coeffHomAlong_of_le (k := 2) (cuspMarked p) hM.isWellFormed hM.one_le_d
    hM.dimLE ⊤ (cusp_actual_tangent p) (.refl : BlowupTower cuspModel cuspModel) trivial ⊤
    (subset_univ _) (by
      intro z _ _ h
      change z ∈ codimOnePartAlong (barMarked (X := cuspModel) (cuspMarked p)).N
        (barMarked (X := cuspModel) (cuspMarked p)).ideal (barMarked (X := cuspModel) (cuspMarked p)).d at h
      rw [cusp_no_codimOne p hp] at h
      exact notMem_empty z h)
    (by intro H h; change H ∈ ([] : List (Set (ComplexModel 2))) at h; cases h)

private theorem cusp_contact_nmOrd (p : ℕ) (hp : 2 ≤ p) :
    nmOrd (M := CMfd.of (n := 2) (⊤ : Opens (ComplexModel 2))) (cuspContact p) ⟨0,mem_univ _⟩ = p := by
  let L := cuspContact p
  let S : Set (ComplexModel 2) := {z | z.ofLp 1 = 0}
  let J := (coeffMarkedAlong (coeffMarkedAlong (homMarkedAlong (cuspMarked p)))).ideal
  let O : Opens (ComplexModel 2) := ⊤
  let z : O := ⟨0,mem_univ _⟩
  have hD := cusp_contact_domain p hp
  have hJ : J.IsCoherent := by
    apply isCoherent_coeffMarkedAlong
    · exact isCoherent_coeffMarkedAlong
        (isCoherent_homMarkedAlong (cuspIdeal_coherent p) (cusp_domain p).isWellFormed.isClosedSubmanifold_N)
        (cusp_domain p).isWellFormed.isClosedSubmanifold_N
    · exact (cusp_domain p).isWellFormed.isClosedSubmanifold_N
  have hN : L.N = (Subtype.val : O → ComplexModel 2) ⁻¹' S := by
    change (Subtype.val : O → ComplexModel 2) ⁻¹' (univ ∩ S) = _
    rw [univ_inter]
  have hIdeal : L.ideal = GermIdeal.pullback (m := 2) (Subtype.val : O → ComplexModel 2) J := rfl
  have hBound (q : ℕ) : q ≤ nmOrd (M := CMfd.of (n := 2) O) L z ↔ q ≤ p := by
    have hIn : z ∈ L.N := by rw [hN]; exact (by simp [S] : (0 : ComplexModel 2) ∈ S)
    have hThreshold : z ∈ cosupport 2 L.N L.ideal q ↔ q ≤ nmOrd (M := CMfd.of (n := 2) O) L z :=
      ordinaryTraceOrder_cosupport_iff (X := CMfd.of (n := 2) O) hD.isWellFormed.isClosedSubmanifold_N
        hD.isWellFormed.isCoherent hD.isNonzeroAlongAt hIn q
    have hPull : z ∈ cosupport 2 L.N L.ideal q ↔ (0 : ComplexModel 2) ∈ cosupport 2 S J q := by
      rw [hN,hIdeal]
      change z ∈ (MarkedIdeal.pullback (Subtype.val : O → ComplexModel 2)
        (⟨S,[],J,q⟩ : MarkedIdeal 2 (ComplexModel 2))).cosupp ↔ _
      rw [MarkedIdealRestrictOpen.cosupp_pullback_val
        (⟨S, [], J, q⟩ : MarkedIdeal 2 (ComplexModel 2))
        (fun y g hg => GermIdeal.IsCoherent.holomorphicAt_mem hJ (x := y) (g := g) hg) O]
      rfl
    have hOrder : order 2 S J (0 : ComplexModel 2) = (p : ℕ∞) :=
      cusp_double_coefficient_trace_order p hp
    rw [← hThreshold,hPull]
    have hxS : (0 : ComplexModel 2) ∈ S := by simp [S]
    have hReg := le_order_iff (N := S) (𝔞 := J) (x := (0 : ComplexModel 2))
      (fun _ h => GermIdeal.IsCoherent.holomorphicAt_mem hJ h) (q := q)
    constructor
    · intro h
      have hq := hReg.mpr h.2
      rw [hOrder] at hq
      exact_mod_cast hq
    · intro h
      refine ⟨hxS,hReg.mp ?_⟩
      rw [hOrder]
      exact_mod_cast h
  exact le_antisymm ((hBound _).mp le_rfl) ((hBound _).mpr le_rfl)

private theorem cusp_initial_formula (p : ℕ) (hp : 2 ≤ p) :
    (canonicalInvariant 2).inv (cuspMarked p) (.refl : BlowupTower cuspModel cuspModel) 0 =
      initialContactValue 1 2 ((invFamily (by decide : 0 < 2) 1).inv (cuspContact p)
        (.refl : BlowupTower (CMfd.of (n := 2) (⊤ : Opens (ComplexModel 2))) _) ⟨0,mem_univ _⟩) := by
  have hx : (0 : ComplexModel 2) ∈ (cuspMarked p).cosupp := by
    change (0 : ComplexModel 2) ∈ cosupport 2 univ (cuspIdeal p) 2
    rw [cusp_cosupport_two p hp]
    exact mem_singleton _
  have hNS : ¬ IsSpecial (cuspMarked p) (.refl : BlowupTower cuspModel cuspModel) 0 := by
    rintro (⟨_,h⟩ | ⟨h,_⟩)
    · change (0 : ComplexModel 2) ∈ codimOnePartAlong (barMarked (X := cuspModel) (cuspMarked p)).N
        (barMarked (X := cuspModel) (cuspMarked p)).ideal (barMarked (X := cuspModel) (cuspMarked p)).d at h
      rw [cusp_no_codimOne p hp] at h
      exact notMem_empty _ h
    · change (1 : ℕ) ≤ 0 at h
      omega
  exact original_initial_value_of_fixed_contact (cuspMarked p) (cusp_domain p) rfl
    (cusp_maximal p hp) 0 hx hNS _ univ ⊤ (cusp_actual_tangent p)
    (subset_univ _) (mem_univ _) (cusp_contact_domain p hp)

/-- Actual ambient original initial values separate cusps with increasing
exponents even though their complete Hilbert–Samuel profiles coincide. -/
theorem cusp_original_initial_value_lt (p q : ℕ) (hp : 2 ≤ p) (hpq : p < q) :
    (canonicalInvariant 2).inv (cuspMarked p) (.refl : BlowupTower cuspModel cuspModel) 0 <
      (canonicalInvariant 2).inv (cuspMarked q) (.refl : BlowupTower cuspModel cuspModel) 0 := by
  have hq : 2 ≤ q := hp.trans hpq.le
  rw [cusp_initial_formula p hp, cusp_initial_formula q hq]
  apply initialContactValue_strictMono
  apply initial_lower_value_lt_of_nmOrd_lt (k := 0)
  rw [cusp_contact_nmOrd p hp,cusp_contact_nmOrd q hq]
  exact hpq


/-- The literal boundary-free mark-one analytic cusp record. -/
noncomputable def cuspMarkedOne (p : ℕ) : MarkedIdeal 2 cuspModel := ⟨univ, [], cuspIdeal p, 1⟩

private theorem cusp_mark_one_two_value (p : ℕ) (hp : 2 ≤ p) :
    (canonicalInvariant 2).inv (cuspMarkedOne p) (.refl : BlowupTower cuspModel cuspModel) 0 =
      (canonicalInvariant 2).inv (cuspMarked p) (.refl : BlowupTower cuspModel cuspModel) 0 := by
  have hM := cusp_domain p
  have hThreshold (q : ℕ) : 0 ∈ cosupport 2 univ (cuspIdeal p) q ↔
      q ≤ nmOrd (M := cuspModel) (cuspMarkedOne p) 0 :=
    ordinaryTraceOrder_cosupport_iff (X := cuspModel) hM.isWellFormed.isClosedSubmanifold_N
      hM.isWellFormed.isCoherent hM.isNonzeroAlongAt (mem_univ 0) q
  have hOrder : nmOrd (M := cuspModel) (cuspMarkedOne p) 0 = 2 := by
    have hLow := (hThreshold 2).mp (by rw [cusp_cosupport_two p hp]; exact mem_singleton _)
    have hHigh : ¬ 3 ≤ nmOrd (M := cuspModel) (cuspMarkedOne p) 0 :=
      fun h => cusp_maximal p hp 0 ((hThreshold 3).mpr h)
    omega
  exact initial_value_eq_of_common_ideal (X := cuspModel) (cuspIdeal p)
    (d := 1) (e := 2) (o := 2) (by decide) (by decide) (by decide) hOrder

/-- The exact original invariant distinguishes the literal mark-one cusp
records; in particular p=3 and q=5 give a strict difference. -/
theorem cusp_mark_one_initial_value_lt (p q : ℕ) (hp : 2 ≤ p) (hpq : p < q) :
    (canonicalInvariant 2).inv (cuspMarkedOne p) (.refl : BlowupTower cuspModel cuspModel) 0 <
      (canonicalInvariant 2).inv (cuspMarkedOne q) (.refl : BlowupTower cuspModel cuspModel) 0 := by
  rw [cusp_mark_one_two_value p hp, cusp_mark_one_two_value q (hp.trans hpq.le)]
  exact cusp_original_initial_value_lt p q hp hpq


/-- The exact whole original point HS function of this coherent cusp input
depends only on its ambient order two. -/
theorem cusp_ideal_hilbertSamuel_origin (p : ℕ) (hp : 2 ≤ p) (l : ℕ) :
    hilbertSamuelAt (cuspIdeal p) 0 l =
      Nat.choose (2+l) 2 - (if 2 ≤ l then Nat.choose (2+(l-2)) 2 else 0) := by
  let A := cuspIdeal p
  let G : Fin 1 → ComplexModel 2 → ℂ := fun _ => cuspFunction p
  have hG : ∀ i, HolomorphicAt 2 (G i) 0 :=
    fun _ => Eventually.of_forall fun z => (holomorphic_cusp p z).mdifferentiableAt
  let f := chartTranslatedGerm (0 : ComplexModel 2) 0
    (mem_chart_source (ComplexModel 2) 0) (G 0) (hG 0)
  have hGen (g : ComplexModel 2 → ℂ) : A.mem 0 g ↔ IsInSpanAt (n := 2) (· ∈ range G) 0 g := by
    change IsInSpanAt (n := 2) (· = cuspFunction p) 0 g ↔ _
    have hh : range G = {cuspFunction p} := by ext x; simp [G]
    rw [hh]
    rfl
  have hSpan := wholeChartStalkIdeal_eq_actual_generator_span A (0 : ComplexModel 2) G hG hGen
  have hRange : (range fun i : Fin 1 =>
      chartTranslatedGerm (0 : ComplexModel 2) 0
        (mem_chart_source (ComplexModel 2) 0) (G i) (hG i)) = {f} := by
    ext g
    constructor
    · rintro ⟨i,rfl⟩
      have hi : i = 0 := Subsingleton.elim _ _
      subst i
      exact mem_singleton _
    · intro hg
      exact ⟨0,mem_singleton_iff.mp hg |>.symm⟩
  rw [hRange] at hSpan
  let m := IsLocalRing.maximalIdeal (HolGerm (ComplexModel 2))
  have hBound (q : ℕ) : Ideal.span {f} ≤ m ^ q ↔ OrderGE 2 univ A 0 q := by
    rw [← hSpan]
    exact wholeChartStalkIdeal_le_maximal_pow_iff A 0
      (fun g hg => GermIdeal.IsCoherent.holomorphicAt_mem (cuspIdeal_coherent p) hg) q
  have h₂ : f ∈ m ^ 2 :=
    ((hBound 2).mpr (show (0 : ComplexModel 2) ∈ cosupport 2 univ A 2 from by
      change (0 : ComplexModel 2) ∈ cosupport 2 univ (cuspIdeal p) 2
      rw [cusp_cosupport_two p hp]
      exact mem_singleton _).2) (Ideal.subset_span (mem_singleton _))
  have h₃ : f ∉ m ^ 3 := by
    intro hf
    have hLe : Ideal.span {f} ≤ m ^ 3 := Ideal.span_le.mpr fun g hg => (mem_singleton_iff.mp hg).symm ▸ hf
    exact cusp_maximal p hp 0 ⟨mem_univ _, (hBound 3).mp hLe⟩
  unfold hilbertSamuelAt
  change hilbertSamuelValue (wholeChartStalkIdeal A 0 0 (mem_chart_source (ComplexModel 2) 0)) l = _
  rw [hSpan]
  exact hilbertSamuelValue_actual_principal f 2 h₂ h₃ l

/-- Equal entire actual Hilbert–Samuel profiles need not give the same
initial original invariant, even for literal analytic mark-one records. -/
theorem cusp_three_five_same_HS_original_tie_fails :
    hilbertSamuelAt (cuspIdeal 3) 0 = hilbertSamuelAt (cuspIdeal 5) 0 ∧
    (canonicalInvariant 2).inv (cuspMarkedOne 3) (.refl : BlowupTower cuspModel cuspModel) 0 <
      (canonicalInvariant 2).inv (cuspMarkedOne 5) (.refl : BlowupTower cuspModel cuspModel) 0 := by
  refine ⟨funext fun l => ?_, cusp_mark_one_initial_value_lt 3 5 (by decide) (by decide)⟩
  rw [cusp_ideal_hilbertSamuel_origin 3 (by decide), cusp_ideal_hilbertSamuel_origin 5 (by decide)]


