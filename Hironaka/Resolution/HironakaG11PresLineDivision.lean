import Hironaka.Resolution.HironakaG11PresLinePrefix

/-!
# Adding a variable to the native five-law data: supported division (goal G11, step (3a-lines), part L1, law 4)

Law 4 of the native point presentation (`HironakaActualHistoricalFormalSupportedDivision.HistoricalWholeSupportedDivision`):
every member of the ideal generated by the family is a combination of the family whose `j`-th multiplier is supported off the
cones of the earlier words. Under a new variable `s` (the renamed family, no exponent in `s`), expand a member `F` in powers of
`s`: its `s^m`-coefficient series `sliceSeries m F` lies in the ideal of the old family (slicing commutes with multiplication by
renamed series), divide each slice in `n` variables, and reassemble the multipliers coefficientwise. The cone conditions do not
involve the new variable.

* `sliceSeries m F` (the `s^m`-coefficient series), `assembleSeries Q` (the series with slices `Q m`), `ext_sliceSeries`;
* **`sliceSeries_mul_rename`**: `sliceSeries m (c * rename g) = sliceSeries m c * g`;
* `avoidsCones_liftWord`;
* **`historicalWholeSupportedDivision_lift`**: law 4 passes to the lifted words and the renamed family.

Nothing here proves or assumes G11. Blueprint: `hironaka-g11-pres-line-state.tex`.
-/

set_option autoImplicit false

open Set Classical

namespace Hironaka.HironakaG11PresLineDivision

noncomputable section

open HironakaActualHistoricalWholeJetFrames HironakaActualCauchyMonomialDivision HironakaActualCauchyDiagramPartition
  HironakaActualHistoricalFormalSupportedDivision HironakaG11PresLineFormal HironakaG11PresLineJet

variable {n k : ℕ}

/-! ### Slices along the new variable -/

/-- The coefficient series of `s^m` of a series in `n + 1` variables (`s` the last variable). -/
def sliceSeries (m : ℕ) (F : MvPowerSeries (Fin (n + 1)) ℂ) : MvPowerSeries (Fin n) ℂ :=
  fun α => MvPowerSeries.coeff (liftExp α + Finsupp.single (Fin.last n) m) F

theorem coeff_sliceSeries (m : ℕ) (F : MvPowerSeries (Fin (n + 1)) ℂ) (α : Fin n →₀ ℕ) :
    MvPowerSeries.coeff α (sliceSeries m F) = MvPowerSeries.coeff (liftExp α + Finsupp.single (Fin.last n) m) F :=
  rfl

theorem sliceSeries_sum {ι : Type*} (s : Finset ι) (m : ℕ) (F : ι → MvPowerSeries (Fin (n + 1)) ℂ) :
    sliceSeries m (∑ i ∈ s, F i) = ∑ i ∈ s, sliceSeries m (F i) := by
  ext α
  rw [coeff_sliceSeries, map_sum, map_sum]
  rfl

/-- The series in `n + 1` variables whose `s^m`-slice is `Q m`. -/
def assembleSeries (Q : ℕ → MvPowerSeries (Fin n) ℂ) : MvPowerSeries (Fin (n + 1)) ℂ :=
  fun β => MvPowerSeries.coeff (oldExp β) (Q (β (Fin.last n)))

theorem coeff_assembleSeries (Q : ℕ → MvPowerSeries (Fin n) ℂ) (β : Fin (n + 1) →₀ ℕ) :
    MvPowerSeries.coeff β (assembleSeries Q) = MvPowerSeries.coeff (oldExp β) (Q (β (Fin.last n))) :=
  rfl

theorem oldExp_split (α : Fin n →₀ ℕ) (m : ℕ) : oldExp (liftExp α + Finsupp.single (Fin.last n) m) = α := by
  ext i
  rw [oldExp_apply, split_apply_castSucc]

theorem sliceSeries_assembleSeries (Q : ℕ → MvPowerSeries (Fin n) ℂ) (m : ℕ) :
    sliceSeries m (assembleSeries Q) = Q m := by
  ext α
  rw [coeff_sliceSeries, coeff_assembleSeries, split_apply_last, oldExp_split]

theorem ext_sliceSeries {F G : MvPowerSeries (Fin (n + 1)) ℂ} (h : ∀ m, sliceSeries m F = sliceSeries m G) :
    F = G := by
  ext β
  have h1 := congrArg (MvPowerSeries.coeff (oldExp β)) (h (β (Fin.last n)))
  rw [coeff_sliceSeries, coeff_sliceSeries, liftExp_oldExp_add] at h1
  exact h1

/-- **Slicing commutes with multiplication by a renamed series.** -/
theorem sliceSeries_mul_rename (m : ℕ) (c : MvPowerSeries (Fin (n + 1)) ℂ) (g : MvPowerSeries (Fin n) ℂ) :
    sliceSeries m (c * MvPowerSeries.rename (Fin.castAdd 1) g) = sliceSeries m c * g := by
  ext α
  rw [coeff_sliceSeries, MvPowerSeries.coeff_mul, MvPowerSeries.coeff_mul]
  symm
  refine Finset.sum_bij_ne_zero (fun p _ _ => (liftExp p.1 + Finsupp.single (Fin.last n) m, liftExp p.2)) ?_ ?_ ?_ ?_
  · intro p hp _
    rw [Finset.mem_antidiagonal] at hp ⊢
    rw [← hp, liftExp_add, add_right_comm]
  · intro p _ _ q _ _ h
    simp only [Prod.mk.injEq] at h
    exact Prod.ext (split_injective h.1).1 (liftExp_injective h.2)
  · intro P hP hne
    by_cases hex : ∃ q, liftExp q = P.2
    · obtain ⟨q, hq⟩ := hex
      rw [Finset.mem_antidiagonal] at hP
      have hlast : P.1 (Fin.last n) = m := by
        have := congrArg (fun γ : Fin (n + 1) →₀ ℕ => γ (Fin.last n)) hP
        simpa only [Finsupp.add_apply, ← hq, liftExp_apply_last, add_zero, Finsupp.single_eq_same, zero_add]
          using this
      have hP1 : liftExp (oldExp P.1) + Finsupp.single (Fin.last n) m = P.1 := by
        rw [← hlast]
        exact liftExp_oldExp_add P.1
      refine ⟨(oldExp P.1, q), ?_, ?_, ?_⟩
      · rw [Finset.mem_antidiagonal]
        apply liftExp_injective
        apply add_left_injective (Finsupp.single (Fin.last n) m)
        show liftExp (oldExp P.1 + q) + Finsupp.single (Fin.last n) m = liftExp α + Finsupp.single (Fin.last n) m
        rw [liftExp_add, add_right_comm, hP1, hq]
        exact hP
      · change MvPowerSeries.coeff _ (sliceSeries m c) * MvPowerSeries.coeff q g ≠ 0
        rw [coeff_sliceSeries, hP1, ← coeff_rename_liftExp g q, hq]
        exact hne
      · exact Prod.ext hP1 hq
    · exfalso
      apply hne
      rw [coeff_rename_of_notMem g (fun q hq => hex ⟨q, hq⟩), mul_zero]
  · intro p _ _
    rw [coeff_sliceSeries, coeff_rename_liftExp]

/-! ### Cones of lifted words -/

theorem avoidsCones_liftWord (L : List (CoordinateWord n)) (γ : Fin n →₀ ℕ) (m : ℕ) :
    AvoidsCones (L.map liftWord) (liftExp γ + Finsupp.single (Fin.last n) m) ↔ AvoidsCones L γ := by
  simp only [AvoidsCones, List.mem_map, forall_exists_index, and_imp, forall_apply_eq_imp_iff₂, liftWord_le_split]

theorem take_ofFn_liftWord (w : Fin k → CoordinateWord n) (j : ℕ) :
    (List.ofFn fun i => liftWord (w i)).take j = ((List.ofFn w).take j).map liftWord := by
  rw [List.map_take, List.map_ofFn]
  rfl

/-- **Law 4 (whole supported division) under a new variable.** -/
theorem historicalWholeSupportedDivision_lift (w : Fin k → CoordinateWord n) (g : Fin k → MvPowerSeries (Fin n) ℂ)
    (h : HistoricalWholeSupportedDivision w g) :
    HistoricalWholeSupportedDivision (fun i => liftWord (w i))
      (fun i => MvPowerSeries.rename (Fin.castAdd 1) (g i)) := by
  intro F hF
  obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hF
  have hslice : ∀ m, sliceSeries m F ∈ Ideal.span (range g) := by
    intro m
    rw [← hc, sliceSeries_sum]
    refine Ideal.sum_mem _ fun j _ => ?_
    rw [sliceSeries_mul_rename]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨j, rfl⟩)
  choose Q hQ hsupp using fun m => h (sliceSeries m F) (hslice m)
  refine ⟨fun j => assembleSeries (fun m => Q m j), ?_, ?_⟩
  · apply ext_sliceSeries
    intro m
    rw [sliceSeries_sum, hQ m]
    apply Finset.sum_congr rfl
    intro j _
    rw [sliceSeries_mul_rename, sliceSeries_assembleSeries]
  · intro j β' hβ'
    rw [coeff_assembleSeries]
    apply hsupp (β' (Fin.last n)) j (oldExp β')
    intro hav
    apply hβ'
    have hsplit : β' + wordExponent (liftWord (w j)) =
        liftExp (oldExp β' + wordExponent (w j)) + Finsupp.single (Fin.last n) (β' (Fin.last n)) := by
      conv_lhs => rw [← liftExp_oldExp_add β']
      rw [wordExponent_liftWord, liftExp_add, add_right_comm]
    rw [hsplit, take_ofFn_liftWord, avoidsCones_liftWord]
    exact hav

end

end Hironaka.HironakaG11PresLineDivision
