import Hironaka.Analytic.CoordinatePlaneDivision
import Mathlib.Analysis.InnerProductSpace.Calculus

/-!
# Hadamard's lemma with substitution

Analytic core of route step N6 of the global flattening algorithm
(`work/hironaka-resume-20261111/G10C/GLOBAL-FLATTENING-ROUTE.md` §3.3a, §5): in a monomial chart of a
blowup, every holomorphic germ is congruent to a germ pulled back from the base modulo the ideal
generated by `t_i - Ψ_i`, for ANY holomorphic `Ψ_i` with the right values (the input `hgen` of
`HironakaG10ChowFibreAlgebra.exists_sub_mem_fibreIdeal_of_ratio`).  The analytic statement behind it:

* `exists_sub_comp_eq_sum` — for `G` holomorphic near `w₀ ∈ ℂᴺ` and a holomorphic `v` with
  `v w₀ = w₀`, there are holomorphic `H_l` near `w₀` with
  `G w - G (v w) = ∑ₗ (w_l - (v w)_l) · H_l w` near `w₀`.

Proof: `F(x, d) = G(x) - G(x - d)` on `ℂᴺ × ℂᴺ = ℂ^{N+N}` vanishes on the coordinate plane `d = 0`,
so `F = ∑ d_l K_l` (`CoordinatePlaneDivision.exists_eq_sum_coord_mul`); substitute `d = w - v w`.
-/

set_option autoImplicit false

open Set Filter
open scoped Topology

namespace Hironaka.HironakaG10ChowSubstitutionHadamard

open CoordinatePlaneDivision

noncomputable section

variable {N : ℕ}

/-- The first `N` coordinates of a point of `ℂ^{N+N}`. -/
def firstHalf (x : ComplexModel (N + N)) : ComplexModel N :=
  WithLp.toLp 2 fun i => x (Fin.castAdd N i)

/-- The last `N` coordinates of a point of `ℂ^{N+N}`. -/
def secondHalf (x : ComplexModel (N + N)) : ComplexModel N :=
  WithLp.toLp 2 fun i => x (Fin.natAdd N i)

/-- The point of `ℂ^{N+N}` with halves `w` and `d`. -/
def joinHalves (w d : ComplexModel N) : ComplexModel (N + N) :=
  WithLp.toLp 2 (Fin.append (fun i => w i) (fun i => d i))

@[simp] theorem firstHalf_joinHalves (w d : ComplexModel N) : firstHalf (joinHalves w d) = w := by
  ext i
  simp [firstHalf, joinHalves]

@[simp] theorem secondHalf_joinHalves (w d : ComplexModel N) : secondHalf (joinHalves w d) = d := by
  ext i
  simp only [secondHalf, joinHalves, PiLp.toLp_apply, Fin.append_right]

theorem differentiable_firstHalf : Differentiable ℂ (firstHalf (N := N)) :=
  differentiable_euclidean.mpr fun i =>
    (EuclideanSpace.proj (Fin.castAdd N i) : ComplexModel (N + N) →L[ℂ] ℂ).differentiable

theorem differentiable_secondHalf : Differentiable ℂ (secondHalf (N := N)) :=
  differentiable_euclidean.mpr fun i =>
    (EuclideanSpace.proj (Fin.natAdd N i) : ComplexModel (N + N) →L[ℂ] ℂ).differentiable

theorem differentiableAt_joinHalves {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    {w d : E → ComplexModel N} {y : E} (hw : DifferentiableAt ℂ w y)
    (hd : DifferentiableAt ℂ d y) : DifferentiableAt ℂ (fun z => joinHalves (w z) (d z)) y := by
  refine differentiableAt_euclidean.mpr fun i => ?_
  refine Fin.addCases (fun j => ?_) (fun j => ?_) i
  · simp only [joinHalves, PiLp.toLp_apply, Fin.append_left]
    exact (EuclideanSpace.proj j : ComplexModel N →L[ℂ] ℂ).differentiableAt.comp y hw
  · simp only [joinHalves, PiLp.toLp_apply, Fin.append_right]
    exact (EuclideanSpace.proj j : ComplexModel N →L[ℂ] ℂ).differentiableAt.comp y hd

theorem joinHalves_mem_plane (w : ComplexModel N) :
    joinHalves w 0 ∈ complexCoordinatePlane (N + N) N := by
  intro i hi
  obtain ⟨j, rfl⟩ : ∃ j : Fin N, i = Fin.natAdd N j :=
    ⟨⟨i.1 - N, by omega⟩, Fin.ext (by simp only [Fin.natAdd]; omega)⟩
  simp only [joinHalves, PiLp.toLp_apply, Fin.append_right]
  rfl

theorem secondHalf_eq_zero_of_mem {x : ComplexModel (N + N)}
    (hx : x ∈ complexCoordinatePlane (N + N) N) : secondHalf x = 0 := by
  ext i
  simp only [secondHalf, PiLp.toLp_apply]
  exact hx _ (by simp)

/-- **Hadamard's lemma with substitution.** -/
theorem exists_sub_comp_eq_sum {G : ComplexModel N → ℂ} {v : ComplexModel N → ComplexModel N}
    {w₀ : ComplexModel N} (hG : ∀ᶠ w in 𝓝 w₀, DifferentiableAt ℂ G w)
    (hv : ∀ᶠ w in 𝓝 w₀, DifferentiableAt ℂ v w) (hv₀ : v w₀ = w₀) :
    ∃ H : Fin N → ComplexModel N → ℂ, (∀ l, ∀ᶠ w in 𝓝 w₀, DifferentiableAt ℂ (H l) w) ∧
      ∀ᶠ w in 𝓝 w₀, G w - G (v w) = ∑ l, (w l - v w l) * H l w := by
  classical
  -- the function on `ℂ^{N+N}`
  set F : ComplexModel (N + N) → ℂ := fun x => G (firstHalf x) - G (firstHalf x - secondHalf x)
    with hF
  set q : ComplexModel (N + N) := joinHalves w₀ 0 with hq
  have hcont1 : Continuous (fun x : ComplexModel (N + N) => firstHalf x) :=
    differentiable_firstHalf.continuous
  have hcont2 : Continuous (fun x : ComplexModel (N + N) => firstHalf x - secondHalf x) :=
    differentiable_firstHalf.continuous.sub differentiable_secondHalf.continuous
  have hq1 : firstHalf q = w₀ := by simp [hq]
  have hq2 : firstHalf q - secondHalf q = w₀ := by simp [hq]
  have hFd : ∀ᶠ x in 𝓝 q, DifferentiableAt ℂ F x := by
    have h1 : ∀ᶠ x in 𝓝 q, DifferentiableAt ℂ G (firstHalf x) :=
      hcont1.continuousAt.eventually
        (by rw [show (fun x : ComplexModel (N + N) => firstHalf x) q = w₀ from hq1]; exact hG)
    have h2 : ∀ᶠ x in 𝓝 q, DifferentiableAt ℂ G (firstHalf x - secondHalf x) :=
      hcont2.continuousAt.eventually
        (by rw [show (fun x : ComplexModel (N + N) => firstHalf x - secondHalf x) q = w₀ from hq2]
            exact hG)
    filter_upwards [h1, h2] with x hx1 hx2
    exact (hx1.comp x (differentiable_firstHalf x)).sub
      (hx2.comp x ((differentiable_firstHalf x).sub (differentiable_secondHalf x)))
  have hFvan : ∀ᶠ x in 𝓝 q, x ∈ complexCoordinatePlane (N + N) N → F x = 0 := by
    refine Eventually.of_forall fun x hx => ?_
    simp [hF, secondHalf_eq_zero_of_mem hx]
  obtain ⟨K, hK0, hKd, hKeq⟩ :=
    exists_eq_sum_coord_mul N N (by omega) (joinHalves_mem_plane w₀) hFd hFvan
  -- substitute `d = w - v w`
  set P : ComplexModel N → ComplexModel (N + N) := fun w => joinHalves w (w - v w) with hP
  have hPw₀ : P w₀ = q := by simp [hP, hq, hv₀]
  have hPd : ∀ᶠ w in 𝓝 w₀, DifferentiableAt ℂ P w := by
    filter_upwards [hv] with w hw
    exact differentiableAt_joinHalves differentiableAt_id (differentiableAt_id.sub hw)
  have hPc : ContinuousAt P w₀ := by
    exact (hPd.self_of_nhds).continuousAt
  have hPt : Tendsto P (𝓝 w₀) (𝓝 q) := hPw₀ ▸ hPc.tendsto
  refine ⟨fun l w => K (Fin.natAdd N l) (P w), fun l => ?_, ?_⟩
  · have h1 : ∀ᶠ w in 𝓝 w₀, DifferentiableAt ℂ (K (Fin.natAdd N l)) (P w) :=
      hPt.eventually (hKd (Fin.natAdd N l))
    filter_upwards [h1, hPd] with w hw1 hw2
    exact hw1.comp w hw2
  · filter_upwards [hPt.eventually hKeq] with w hw
    have h1 : F (P w) = G w - G (v w) := by simp [hF, hP]
    rw [← h1, hw, Fin.sum_univ_add]
    have h2 : ∑ i : Fin N, (P w) (Fin.castAdd N i) * K (Fin.castAdd N i) (P w) = 0 := by
      refine Finset.sum_eq_zero fun i _ => ?_
      rw [hK0 (Fin.castAdd N i) (by simp)]
      simp
    rw [h2, zero_add]
    refine Finset.sum_congr rfl fun l _ => ?_
    congr 1
    show (joinHalves w (w - v w)) (Fin.natAdd N l) = w l - v w l
    simp only [joinHalves, PiLp.toLp_apply, Fin.append_right, PiLp.sub_apply]

end

end Hironaka.HironakaG10ChowSubstitutionHadamard
