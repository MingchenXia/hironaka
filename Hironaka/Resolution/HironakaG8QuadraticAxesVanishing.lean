import Hironaka.Resolution.HironakaG8QuadraticAxesInitialHS
import Hironaka.Resolution.HironakaActualReducedFormalStandardBasis
import Hironaka.Resolution.HironakaActualFormalIdealContraction
import Hironaka.Analytic.RueckertNullstellensatz

/-! The three literal coordinate axes have the entire reduced monomial
vanishing stalk generated by the three pairwise products. -/
set_option autoImplicit false
open Set Filter
open scoped Topology MonomialOrder
namespace Hironaka.HironakaG8QuadraticAxesVanishing
noncomputable section
open Hironaka.HolomorphicIdealSheaves Hironaka.BlowupSequences
  HolGerm OkaRelationSheaf HironakaHolomorphicJetMonomialSpan
  HironakaG8QuadraticAxesRecoding HironakaG8QuadraticAxesInitialHS
  HironakaActualPointGeometricBennett HironakaRelativeNormalDeformationInitialRelations
  HironakaActualFormalInitialDiagram HironakaActualReducedFormalStandardBasis
  HironakaActualFormalIdealContraction HironakaActualCoefficientPresentationCentrePower

abbrev K : Ideal R := Ideal.span (range axisGerm)
abbrev J : Ideal F := Ideal.map τ.toRingHom K
abbrev exponent (i : Fin 3) : Fin 3 →₀ ℕ :=
  Finsupp.single (axesI i) 1 + Finsupp.single (axesJ i) 1

private theorem axisTaylor (i : Fin 3) :
    τ (axisGerm i) = MvPowerSeries.monomial (exponent i) 1 := by
  rw [axisGerm,map_mul,actualUnshiftedTaylor_coordinate,actualUnshiftedTaylor_coordinate]
  change MvPowerSeries.monomial (Finsupp.single (axesI i) 1) (1 : ℂ) *
    MvPowerSeries.monomial (Finsupp.single (axesJ i) 1) 1 = _
  rw [MvPowerSeries.monomial_mul_monomial,one_mul]

private def axisEmbedding (j : Fin 3) : Fin 1 ↪ Fin 3 :=
  ⟨fun _ => j, by intro a b _; exact Subsingleton.elim a b⟩

private theorem axisEmbedding_range (j : Fin 3) : range (axisEmbedding j) = {j} := by
  ext i
  change (∃ _ : Fin 1, j = i) ↔ i = j
  simp [eq_comm]

private def projection (j : Fin 3) : F →ₐ[ℂ] MvPowerSeries (Fin 1) ℂ :=
  MvPowerSeries.killCompl (axisEmbedding j)

private def L : Ideal F := ⨅ j : Fin 3, RingHom.ker (projection j).toRingHom

private theorem exponents_have_pair_or_axis (a : Fin 3 →₀ ℕ) :
    (∃ i, exponent i ≤ a) ∨ ∃ j : Fin 3, ↑a.support ⊆ ({j} : Set (Fin 3)) := by
  have hp (i : Fin 3) (hI : 0 < a (axesI i)) (hJ : 0 < a (axesJ i)) : exponent i ≤ a := by
    have hne : axesI i ≠ axesJ i := by fin_cases i <;> decide
    intro j
    by_cases h : j = axesI i
    · subst j
      simpa [Finsupp.add_apply,Finsupp.single_eq_of_ne hne] using (Nat.succ_le_iff.mpr hI)
    by_cases h' : j = axesJ i
    · subst j
      simpa [Finsupp.add_apply,Finsupp.single_eq_of_ne hne.symm] using (Nat.succ_le_iff.mpr hJ)
    · simp [Finsupp.add_apply,Finsupp.single_eq_of_ne h,Finsupp.single_eq_of_ne h']
  by_cases h0 : a 0 = 0
  · by_cases h1 : a 1 = 0
    · right
      refine ⟨2, fun j hj => ?_⟩
      have h := Finsupp.mem_support_iff.mp hj
      fin_cases j <;> simp_all
    · by_cases h2 : a 2 = 0
      · right
        refine ⟨1, fun j hj => ?_⟩
        have h := Finsupp.mem_support_iff.mp hj
        fin_cases j <;> simp_all
      · exact Or.inl ⟨2,hp 2 (Nat.pos_of_ne_zero h1) (Nat.pos_of_ne_zero h2)⟩
  · by_cases h1 : a 1 = 0
    · by_cases h2 : a 2 = 0
      · right
        refine ⟨0, fun j hj => ?_⟩
        have h := Finsupp.mem_support_iff.mp hj
        fin_cases j <;> simp_all
      · exact Or.inl ⟨1,hp 1 (Nat.pos_of_ne_zero h0) (Nat.pos_of_ne_zero h2)⟩
    · exact Or.inl ⟨0,hp 0 (Nat.pos_of_ne_zero h0) (Nat.pos_of_ne_zero h1)⟩

private theorem J_le_L : J ≤ L := by
  rw [show J = Ideal.map τ.toRingHom K from rfl,Ideal.map_span]
  apply Ideal.span_le.mpr
  rintro _ ⟨_,⟨i,rfl⟩,rfl⟩
  change τ (axisGerm i) ∈ L
  rw [axisTaylor]
  apply Ideal.mem_iInf.mpr
  intro j
  change projection j (MvPowerSeries.monomial (exponent i) 1) = 0
  apply MvPowerSeries.killCompl_monomial_eq_zero
  rw [Finsupp.mem_range_embDomain_iff,axisEmbedding_range]
  intro h
  have hne : axesI i ≠ axesJ i := by fin_cases i <;> decide
  have hi : axesI i ∈ (exponent i).support := by
    rw [Finsupp.mem_support_iff]
    simp [Finsupp.add_apply]
  have hj : axesJ i ∈ (exponent i).support := by
    rw [Finsupp.mem_support_iff]
    simp [Finsupp.add_apply]
  exact hne ((h hi).trans (h hj).symm)

private theorem axes_formal_eq : J = L := by
  apply (ideal_eq_of_le_of_diagram_le MonomialOrder.degLex L J J_le_L ?_).symm
  rintro a ⟨G,hG,hG0,rfl⟩
  let e := actualInitialExponent MonomialOrder.degLex G hG0
  have he : MvPowerSeries.coeff e G ≠ 0 := (actualInitialExponent_spec _ _ _).1
  rcases exponents_have_pair_or_axis e with ⟨i,hi⟩ | ⟨j,hj⟩
  · apply actualInitialDiagram_upper _ _ _ _ _ hi
    have hM := Ideal.mem_map_of_mem τ.toRingHom (Ideal.subset_span (show axisGerm i ∈ range axisGerm from ⟨i,rfl⟩))
    change τ (axisGerm i) ∈ J at hM
    rw [axisTaylor] at hM
    exact ⟨_,hM,actualMonomial_ne_zero _,actualInitialExponent_monomial _ _⟩
  · exfalso
    have hRange : e ∈ range (Finsupp.embDomain (axisEmbedding j)) := by
      rw [Finsupp.mem_range_embDomain_iff,axisEmbedding_range]
      exact hj
    obtain ⟨b,hb⟩ := hRange
    have hProj : projection j G = 0 := Ideal.mem_iInf.mp hG j
    have hC := congrArg (MvPowerSeries.coeff b) hProj
    rw [projection,MvPowerSeries.coeff_killCompl,hb,map_zero] at hC
    exact he hC

/-- The actual original analytic axis ideal is radical. -/
theorem axes_origin_isRadical : K.IsRadical := by
  apply (Ideal.isRadical_iff_pow_one_lt 2 (by decide)).mpr
  intro g hg
  have hG := Ideal.mem_map_of_mem τ.toRingHom hg
  change τ (g^2) ∈ J at hG
  rw [map_pow, axes_formal_eq] at hG
  have hBase : τ g ∈ L := by
    apply Ideal.mem_iInf.mpr
    intro j
    change projection j (τ g) = 0
    have hP : projection j (τ g ^ 2) = 0 := Ideal.mem_iInf.mp hG j
    rw [map_pow] at hP
    by_contra hn
    exact pow_ne_zero 2 hn hP
  rw [← axes_formal_eq] at hBase
  exact (mem_original_ideal_iff_formal_extension 3 K g).mpr hBase

def axesSet : Set (ComplexModel 3) := {x | ∀ i, axesFunction i x = 0}

/-- The literal geometric axes vanish in exactly the same whole stalk as
the three displayed polynomial generators. -/
theorem axes_geometric_origin :
    originalCoherentOriginIdeal (vanishingIdeal (n := 3) axesSet) =
      originalCoherentOriginIdeal axesIdeal := by
  have hGeo : originalCoherentOriginIdeal (vanishingIdeal (n := 3) axesSet) =
      AnalyticGermDecomposition.vanishingIdeal axesSet := by
    ext g
    obtain ⟨f,hf,rfl⟩ := HolGerm.exists_eq_mk g
    rw [mk_mem_original_vanishing_origin_ideal_iff,AnalyticGermDecomposition.mem_vanishingIdeal_mk]
  rw [hGeo,axes_origin]
  have hD (i : Fin 3) : ∀ᶠ z in 𝓝 (0 : ComplexModel 3), DifferentiableAt ℂ (axesFunction i) z :=
    Eventually.of_forall fun _ =>
      (EuclideanSpace.proj (𝕜 := ℂ) (axesI i)).differentiableAt.mul
        (EuclideanSpace.proj (𝕜 := ℂ) (axesJ i)).differentiableAt
  have hEq (i : Fin 3) : HolGerm.mk (axesFunction i) (hD i) = axisGerm i :=
    HolGerm.mk_mul _ _ _ _
  apply le_antisymm
  · apply (RueckertNullstellensatz.vanishingIdeal_le_radical K axesFunction
      (fun i => ⟨hD i,by rw [hEq]; exact Ideal.subset_span ⟨i,rfl⟩⟩)).trans
    exact axes_origin_isRadical.radical_le_iff.mpr le_rfl
  · apply Ideal.span_le.mpr
    rintro _ ⟨i,rfl⟩
    rw [← hEq i]
    exact AnalyticGermDecomposition.mem_vanishingIdeal_mk.mpr
      (Eventually.of_forall fun _ hz => hz i)

end
end Hironaka.HironakaG8QuadraticAxesVanishing
