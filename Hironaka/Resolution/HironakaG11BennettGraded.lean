import Mathlib.RingTheory.MvPolynomial.MonomialOrder
import Mathlib.RingTheory.MvPolynomial.Homogeneous
import Mathlib.Data.Finsupp.MonomialOrder
import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas
import Mathlib.RingTheory.Finiteness.Finsupp
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Hironaka.Resolution.HironakaG11BennettDiagram

/-!
# Bennett's stabilization, algebraic part: Hilbert–Samuel functions are diagram counting functions

Let `k` be a field, `R` a `k`-algebra, `M ⊆ R` an ideal with `R = k + M` (every element is a scalar
modulo `M`) generated by `y : Fin e → R`, and `J ⊆ R` any ideal. Then there is an UPPER set
`N ⊆ ℕ^e` (the diagram of leading exponents of the graded pieces) with

  `dim_k R/(J + M^(ℓ+1)) = hsCount N ℓ = #{α ∈ ℕ^e : |α| ≤ ℓ, α ∉ N}` for all `ℓ`

(`exists_upperSet_finrank_eq_hsCount`). Proof: the homogeneous polynomials `P_i` of degree `i` map onto
the kernel of `R/(J + M^(i+1)) ↠ R/(J + M^i)` by `f ↦ f(y)`; the kernel `K_i` of this map has dimension
the number of its leading exponents for the lexicographic monomial order (`finrank_eq_card_leadSet`), and
the leading exponents of all `K_i` form an upper set (multiplication by monomials). No Noetherianity,
completeness or division algorithm is used.
Blueprint: `hironaka-g11-resume-bennett-stabilization.tex`.
-/

set_option autoImplicit false

namespace Hironaka.HironakaG11BennettGraded

open MvPolynomial
open Hironaka.HironakaG11BennettDiagram

noncomputable section

section Lead

variable {k : Type*} [Field k] {σ : Type*} (m : MonomialOrder σ)

/-- The leading exponents (for the monomial order `m`) of the nonzero elements of `V`. -/
def leadSet (V : Submodule k (MvPolynomial σ k)) : Set (σ →₀ ℕ) :=
  {d | ∃ f ∈ V, f ≠ 0 ∧ m.degree f = d}

open Classical in
/-- **Dimension = number of leading exponents.** For a subspace `V` of polynomials whose leading
exponents lie in a finite set `T`, `dim V` is the number of leading exponents. -/
theorem finrank_eq_card_leadSet (V : Submodule k (MvPolynomial σ k)) (T : Finset (σ →₀ ℕ))
    (hT : leadSet m V ⊆ T) :
    Module.finrank k V = (T.filter (· ∈ leadSet m V)).card := by
  set L := T.filter (· ∈ leadSet m V) with hL
  let ρ : V →ₗ[k] (L → k) :=
    { toFun := fun f d => (f : MvPolynomial σ k).coeff d.val
      map_add' := fun f g => by ext d; simp
      map_smul' := fun c f => by ext d; simp }
  have hρ : Function.Injective ρ := by
    rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    intro f hf
    by_contra hne
    have hne' : (f : MvPolynomial σ k) ≠ 0 := fun h => hne (Subtype.ext h)
    have hlead : m.degree (f : MvPolynomial σ k) ∈ leadSet m V := ⟨f, f.2, hne', rfl⟩
    have hd : m.degree (f : MvPolynomial σ k) ∈ L := Finset.mem_filter.mpr ⟨hT hlead, hlead⟩
    have h0 := congrFun hf ⟨_, hd⟩
    exact (m.coeff_degree_ne_zero_iff.mpr hne') h0
  have : Module.Finite k V := Module.Finite.of_injective ρ hρ
  apply le_antisymm
  · calc Module.finrank k V ≤ Module.finrank k (L → k) :=
          LinearMap.finrank_le_finrank_of_injective hρ
      _ = L.card := by simp
  · have hw : ∀ d : L, ∃ f : V, (f : MvPolynomial σ k) ≠ 0 ∧
        m.degree (f : MvPolynomial σ k) = d.val := by
      intro d
      obtain ⟨f, hfV, hf0, hfd⟩ := (Finset.mem_filter.mp d.2).2
      exact ⟨⟨f, hfV⟩, hf0, hfd⟩
    choose w hw0 hwd using hw
    have hli : LinearIndependent k w := by
      apply LinearIndependent.of_comp V.subtype
      rw [linearIndependent_iff']
      intro s g hsum i hi
      by_contra hgi
      obtain ⟨i0, hi0, hmax⟩ := (s.filter (fun j => g j ≠ 0)).exists_max_image
        (fun j => m.toSyn j.val) ⟨i, Finset.mem_filter.mpr ⟨hi, hgi⟩⟩
      rw [Finset.mem_filter] at hi0
      have hc := congrArg (fun p => MvPolynomial.coeff i0.val p) hsum
      simp only [Function.comp_apply, Submodule.coe_subtype, coeff_sum, coeff_smul, smul_eq_mul,
        coeff_zero] at hc
      rw [Finset.sum_eq_single i0] at hc
      · have hne := m.coeff_degree_ne_zero_iff.mpr (hw0 i0)
        rw [hwd i0] at hne
        exact mul_ne_zero hi0.2 hne hc
      · intro j hj hji
        by_cases hgj : g j = 0
        · simp [hgj]
        · have hle := hmax j (Finset.mem_filter.mpr ⟨hj, hgj⟩)
          have hlt : m.toSyn j.val < m.toSyn i0.val :=
            lt_of_le_of_ne hle (fun h => hji (Subtype.ext (m.toSyn.injective h)))
          rw [m.coeff_eq_zero_of_lt (by rw [hwd j]; exact hlt), mul_zero]
      · intro h
        exact absurd hi0.1 h
    calc L.card = Fintype.card L := (Fintype.card_coe L).symm
      _ ≤ Module.finrank k V := hli.fintype_card_le_finrank

end Lead

section Graded

variable {k : Type*} [Field k] {R : Type*} [CommRing R] [Algebra k R] {e : ℕ}

theorem degree_eq_of_mem_support {S : Type*} [CommSemiring S] {q : MvPolynomial (Fin e) S} {n : ℕ}
    (hq : q.IsHomogeneous n) {d : Fin e →₀ ℕ} (hd : d ∈ q.support) : d.degree = n := by
  by_contra h
  exact (mem_support_iff.mp hd) (hq.coeff_eq_zero h)

/-- Homogeneous polynomials of degree `n` evaluate into the `n`-th power of the ideal generated by the
evaluation point. -/
theorem aeval_mem_span_pow (y : Fin e → R) {p : MvPolynomial (Fin e) k} {n : ℕ}
    (hp : p.IsHomogeneous n) : aeval y p ∈ Ideal.span (Set.range y) ^ n := by
  rw [Ideal.mem_span_pow_iff_exists_isHomogeneous]
  exact ⟨MvPolynomial.map (algebraMap k R) p, hp.map _, by rw [eval_map, ← aeval_def]⟩

/-- Every element of `M^n` is the value of a homogeneous polynomial of degree `n` with coefficients in
`k`, modulo `M^(n+1)`. -/
theorem exists_isHomogeneous_sub_mem (M : Ideal R) (y : Fin e → R)
    (hM : M = Ideal.span (Set.range y)) (hres : ∀ r : R, ∃ c : k, r - algebraMap k R c ∈ M)
    {n : ℕ} {r : R} (hr : r ∈ M ^ n) :
    ∃ p : MvPolynomial (Fin e) k, p.IsHomogeneous n ∧ r - aeval y p ∈ M ^ (n + 1) := by
  classical
  choose c hc using hres
  subst hM
  obtain ⟨q, hq, rfl⟩ := (Ideal.mem_span_pow_iff_exists_isHomogeneous y r).mp hr
  refine ⟨∑ d ∈ q.support, monomial d (c (q.coeff d)), ?_, ?_⟩
  · apply IsHomogeneous.sum
    intro d hd
    exact isHomogeneous_monomial _ (degree_eq_of_mem_support hq hd)
  · have hq' : eval y q = ∑ d ∈ q.support, eval y (monomial d (q.coeff d)) := by
      conv_lhs => rw [q.as_sum]
      rw [map_sum]
    rw [hq', map_sum, ← Finset.sum_sub_distrib]
    apply Ideal.sum_mem
    intro d hd
    rw [eval_monomial, aeval_monomial, ← sub_mul, pow_succ']
    apply Ideal.mul_mem_mul (hc _)
    have h1 := aeval_mem_span_pow (k := k) y
      (isHomogeneous_monomial (1 : k) (degree_eq_of_mem_support hq hd))
    rwa [aeval_monomial, map_one, one_mul] at h1

theorem mul_mem_sup_pow (M J : Ideal R) {a b : R} {s t : ℕ} (ha : a ∈ M ^ s) (hb : b ∈ J ⊔ M ^ t) :
    a * b ∈ J ⊔ M ^ (s + t) := by
  obtain ⟨j, hj, x, hx, rfl⟩ := Submodule.mem_sup.mp hb
  rw [mul_add]
  refine Submodule.add_mem_sup (J.mul_mem_left a hj) ?_
  rw [pow_add]
  exact Ideal.mul_mem_mul ha hx

variable (k) in
/-- The `i`-th kernel piece: homogeneous polynomials of degree `i` whose value at `y` lies in
`J + M^(i+1)`. -/
def kerPiece (M J : Ideal R) (y : Fin e → R) (i : ℕ) : Submodule k (MvPolynomial (Fin e) k) :=
  homogeneousSubmodule (Fin e) k i ⊓
    ((J ⊔ M ^ (i + 1)).restrictScalars k).comap (aeval y : MvPolynomial (Fin e) k →ₐ[k] R).toLinearMap

/-- The lexicographic monomial order used for leading exponents. -/
abbrev lexOrder (e : ℕ) : MonomialOrder (Fin e) := MonomialOrder.lex

variable (k) in
/-- The diagram: exponents which are leading exponents of the kernel piece of their own degree. -/
def diagram (M J : Ideal R) (y : Fin e → R) : Set (Fin e →₀ ℕ) :=
  {d | d ∈ leadSet (lexOrder e) (kerPiece k M J y d.degree)}

theorem leadSet_kerPiece_subset (M J : Ideal R) (y : Fin e → R) (i : ℕ) :
    leadSet (lexOrder e) (kerPiece k M J y i) ⊆ degSet e i := by
  rintro d ⟨f, hf, hf0, rfl⟩
  rw [Finset.mem_coe, mem_degSet]
  exact degree_eq_of_mem_support hf.1 ((lexOrder e).degree_mem_support hf0)

theorem mem_diagram_iff (M J : Ideal R) (y : Fin e → R) {d : Fin e →₀ ℕ} :
    d ∈ diagram k M J y ↔ d ∈ leadSet (lexOrder e) (kerPiece k M J y d.degree) := by
  rw [diagram, Set.mem_ofPred_eq]

theorem mem_leadSet_kerPiece_iff (M J : Ideal R) (y : Fin e → R) {i : ℕ} {d : Fin e →₀ ℕ}
    (hd : d.degree = i) : d ∈ leadSet (lexOrder e) (kerPiece k M J y i) ↔ d ∈ diagram k M J y := by
  rw [mem_diagram_iff, hd]

/-- The diagram is an upper set. -/
theorem isUpperSet_diagram (M J : Ideal R) (y : Fin e → R) (hM : M = Ideal.span (Set.range y)) :
    IsUpperSet (diagram k M J y) := by
  intro d d' hdd' hd
  obtain ⟨f, hf, hf0, hfd⟩ := hd
  set γ := d' - d with hγ
  have hd' : d' = γ + d := (tsub_add_cancel_of_le hdd').symm
  have hmon0 : (monomial γ (1 : k)) ≠ 0 := by
    rw [Ne, monomial_eq_zero]
    exact one_ne_zero
  refine ⟨monomial γ (1 : k) * f, ⟨?_, ?_⟩, mul_ne_zero hmon0 hf0, ?_⟩
  · have hh := (isHomogeneous_monomial (1 : k) (rfl : γ.degree = γ.degree)).mul hf.1
    rw [hd', map_add]
    exact hh
  · change aeval y (monomial γ (1 : k) * f) ∈ J ⊔ M ^ (d'.degree + 1)
    rw [map_mul, hd', map_add, add_assoc]
    apply mul_mem_sup_pow M J
    · rw [hM]
      exact aeval_mem_span_pow y (isHomogeneous_monomial (1 : k) rfl)
    · exact hf.2
  · classical
    rw [(lexOrder e).degree_mul hmon0 hf0, (lexOrder e).degree_monomial, if_neg one_ne_zero, hfd, hd']

end Graded

section Dimension

variable {k : Type*} [Field k] {R : Type*} [CommRing R] [Algebra k R] {e : ℕ}
variable (M J : Ideal R) (y : Fin e → R)

theorem sup_pow_succ_le (i : ℕ) : J ⊔ M ^ (i + 1) ≤ J ⊔ M ^ i :=
  sup_le_sup_left (Ideal.pow_le_pow_right (Nat.le_succ i)) J

variable (k) in
/-- `R/(J + M^(i+1)) ↠ R/(J + M^i)`. -/
def stepMap (i : ℕ) : (R ⧸ (J ⊔ M ^ (i + 1))) →ₗ[k] (R ⧸ (J ⊔ M ^ i)) :=
  (Ideal.Quotient.factorₐ k (sup_pow_succ_le M J i)).toLinearMap

variable (k) in
/-- `P_i → R/(J + M^(i+1))`, `f ↦ f(y)`. -/
def pieceMap (i : ℕ) : homogeneousSubmodule (Fin e) k i →ₗ[k] (R ⧸ (J ⊔ M ^ (i + 1))) :=
  ((Ideal.Quotient.mkₐ k (J ⊔ M ^ (i + 1))).toLinearMap ∘ₗ
    (aeval y : MvPolynomial (Fin e) k →ₐ[k] R).toLinearMap).domRestrict _

theorem stepMap_surjective (i : ℕ) : Function.Surjective (stepMap k M J i) :=
  Ideal.Quotient.factor_surjective (sup_pow_succ_le M J i)

/-- The homogeneous polynomials of degree `i` map ONTO the kernel of `R/(J + M^(i+1)) ↠ R/(J + M^i)`. -/
theorem range_pieceMap (hM : M = Ideal.span (Set.range y))
    (hres : ∀ r : R, ∃ c : k, r - algebraMap k R c ∈ M) (i : ℕ) :
    LinearMap.range (pieceMap k M J y i) = LinearMap.ker (stepMap k M J i) := by
  ext x
  obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective x
  constructor
  · rintro ⟨⟨p, hp⟩, hpx⟩
    rw [LinearMap.mem_ker, ← hpx]
    change Ideal.Quotient.factor (sup_pow_succ_le M J i)
      (Ideal.Quotient.mk (J ⊔ M ^ (i + 1)) (aeval y p)) = 0
    rw [Ideal.Quotient.factor_mk, Ideal.Quotient.eq_zero_iff_mem]
    apply Ideal.mem_sup_right
    rw [hM]
    exact aeval_mem_span_pow y hp
  · intro hx
    rw [LinearMap.mem_ker] at hx
    change Ideal.Quotient.factor (sup_pow_succ_le M J i)
      (Ideal.Quotient.mk (J ⊔ M ^ (i + 1)) r) = 0 at hx
    rw [Ideal.Quotient.factor_mk, Ideal.Quotient.eq_zero_iff_mem] at hx
    obtain ⟨j, hj, s, hs, rfl⟩ := Submodule.mem_sup.mp hx
    obtain ⟨p, hp, hps⟩ := exists_isHomogeneous_sub_mem M y hM hres hs
    refine ⟨⟨p, hp⟩, ?_⟩
    change Ideal.Quotient.mk _ (aeval y p) = Ideal.Quotient.mk _ (j + s)
    rw [Ideal.Quotient.eq]
    have h1 : aeval y p - (j + s) = -j + -(s - aeval y p) := by ring
    rw [h1]
    exact Submodule.add_mem_sup (J.neg_mem hj) ((M ^ (i + 1)).neg_mem hps)

theorem map_ker_pieceMap (i : ℕ) :
    (LinearMap.ker (pieceMap k M J y i)).map (homogeneousSubmodule (Fin e) k i).subtype =
      kerPiece k M J y i := by
  ext p
  constructor
  · rintro ⟨⟨q, hq⟩, hq0, rfl⟩
    refine Submodule.mem_inf.mpr ⟨hq, ?_⟩
    rw [SetLike.mem_coe, LinearMap.mem_ker] at hq0
    have h0 : Ideal.Quotient.mk (J ⊔ M ^ (i + 1)) (aeval y q) = 0 := hq0
    exact Ideal.Quotient.eq_zero_iff_mem.mp h0
  · intro hp
    obtain ⟨hp1, hp2⟩ := Submodule.mem_inf.mp hp
    refine ⟨⟨p, hp1⟩, ?_, rfl⟩
    rw [SetLike.mem_coe, LinearMap.mem_ker]
    change Ideal.Quotient.mk (J ⊔ M ^ (i + 1)) (aeval y p) = 0
    exact Ideal.Quotient.eq_zero_iff_mem.mpr hp2

theorem finrank_homogeneousSubmodule (i : ℕ) :
    Module.finrank k (homogeneousSubmodule (Fin e) k i) = (degSet e i).card := by
  classical
  have hsub : leadSet (lexOrder e) (homogeneousSubmodule (Fin e) k i) ⊆ degSet e i := by
    rintro d ⟨f, hf, hf0, rfl⟩
    rw [Finset.mem_coe, mem_degSet]
    exact degree_eq_of_mem_support hf ((lexOrder e).degree_mem_support hf0)
  rw [finrank_eq_card_leadSet (lexOrder e) _ (degSet e i) hsub]
  congr 1
  apply Finset.filter_true_of_mem
  intro d hd
  refine ⟨monomial d 1, isHomogeneous_monomial _ (mem_degSet.mp hd), ?_, ?_⟩
  · rw [Ne, monomial_eq_zero]
    exact one_ne_zero
  · rw [(lexOrder e).degree_monomial, if_neg one_ne_zero]

open Classical in
theorem finrank_kerPiece (i : ℕ) :
    Module.finrank k (kerPiece k M J y i) = ((degSet e i).filter (· ∈ diagram k M J y)).card := by
  rw [finrank_eq_card_leadSet (lexOrder e) _ (degSet e i) (leadSet_kerPiece_subset M J y i)]
  congr 1
  apply Finset.filter_congr
  intro d hd
  exact mem_leadSet_kerPiece_iff M J y (mem_degSet.mp hd)

open Classical in
/-- **Dimensions of the quotients.** `R/(J + M^ℓ)` is finite dimensional of dimension the number of
exponents of degree `< ℓ` outside the diagram. -/
theorem finrank_quotient_eq_sum (hM : M = Ideal.span (Set.range y))
    (hres : ∀ r : R, ∃ c : k, r - algebraMap k R c ∈ M) :
    ∀ ℓ : ℕ, FiniteDimensional k (R ⧸ (J ⊔ M ^ ℓ)) ∧
      Module.finrank k (R ⧸ (J ⊔ M ^ ℓ)) =
        ∑ i ∈ Finset.range ℓ, ((degSet e i).filter (· ∉ diagram k M J y)).card
  | 0 => by
    have h : J ⊔ M ^ 0 = ⊤ := by rw [pow_zero, Ideal.one_eq_top, sup_top_eq]
    have : Subsingleton (R ⧸ (J ⊔ M ^ 0)) := Ideal.Quotient.subsingleton_iff.mpr h
    exact ⟨inferInstance, by rw [Module.finrank_zero_of_subsingleton, Finset.sum_range_zero]⟩
  | ℓ + 1 => by
    obtain ⟨hfd, hrank⟩ := finrank_quotient_eq_sum hM hres ℓ
    have hrange := range_pieceMap M J y hM hres ℓ
    have hPfin : Module.Finite k (homogeneousSubmodule (Fin e) k ℓ) :=
      Module.Finite.iff_fg.mpr (homogeneousSubmodule_fg (Fin e) k ℓ)
    have hfd' : FiniteDimensional k (R ⧸ (J ⊔ M ^ (ℓ + 1))) := by
      refine ⟨?_⟩
      apply Submodule.fg_of_fg_map_of_fg_inf_ker (stepMap k M J ℓ)
      · exact IsNoetherian.noetherian _
      · rw [top_inf_eq, ← hrange, LinearMap.range_eq_map]
        exact Module.Finite.fg_top.map _
    refine ⟨hfd', ?_⟩
    have h1 := LinearMap.finrank_range_add_finrank_ker (stepMap k M J ℓ)
    rw [LinearMap.range_eq_top.mpr (stepMap_surjective M J ℓ), finrank_top, ← hrange] at h1
    have h2 := LinearMap.finrank_range_add_finrank_ker (pieceMap k M J y ℓ)
    rw [← Submodule.finrank_map_subtype_eq, map_ker_pieceMap, finrank_kerPiece,
      finrank_homogeneousSubmodule] at h2
    have h3 := Finset.card_filter_add_card_filter_not (s := degSet e ℓ)
      (fun d => d ∈ diagram k M J y)
    rw [Finset.sum_range_succ, ← hrank]
    omega

end Dimension

open Classical in
/-- **Hilbert–Samuel functions are diagram counting functions.** For a `k`-algebra `R`, an ideal
`M = (y_1, …, y_e)` with `R = k + M`, and any ideal `J`, there is an upper set `N ⊆ ℕ^e` with
`dim_k R/(J + M^(ℓ+1)) = hsCount N ℓ` for all `ℓ`. -/
theorem exists_upperSet_finrank_eq_hsCount {k : Type*} [Field k] {R : Type*} [CommRing R]
    [Algebra k R] {e : ℕ} (M J : Ideal R) (y : Fin e → R) (hM : M = Ideal.span (Set.range y))
    (hres : ∀ r : R, ∃ c : k, r - algebraMap k R c ∈ M) :
    ∃ N : Set (Fin e →₀ ℕ), IsUpperSet N ∧
      ∀ ℓ, Module.finrank k (R ⧸ (J ⊔ M ^ (ℓ + 1))) = hsCount N ℓ := by
  refine ⟨diagram k M J y, isUpperSet_diagram M J y hM, fun ℓ => ?_⟩
  rw [(finrank_quotient_eq_sum M J y hM hres (ℓ + 1)).2, hsCount]

end

end Hironaka.HironakaG11BennettGraded
