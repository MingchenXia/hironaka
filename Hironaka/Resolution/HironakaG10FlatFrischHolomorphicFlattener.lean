import Hironaka.Resolution.HironakaG10FlatFrischFiniteFlattener
import Hironaka.Analytic.HolomorphicGermRing

/-! # Persistent analytic flattener for a holomorphic block presentation (relative dimension 0)

ORDINARY input: an open set `U` of a complex normed space and holomorphic block
matrices `α, β, γ, δ` on `U` with `det γ` nonvanishing on `U` (Frisch's open set
`Ω`). The inverse of `γ` is constructed internally (adjugate over the holomorphic
determinant), and with it ONE finite family of holomorphic obstruction functions
on `U`: the entries `σ_{ki}` of the Schur complement `β - δ γ⁻¹ α`, generating the
ideal `J_U`. Let `T = {p ∈ U | σ(p) = 0}`. At EVERY point `p ∈ T` and for EVERY local
ring `R` with a local map `ψ` from the germ ring at `p` (e.g. any analytic map
germ into `(U, p)` followed by any proper quotient), the cokernel of the germ of
the presentation at `p`, base changed along `ψ`, is flat over `R` EXACTLY when
`ψ` kills the germ of `J_U`. This is Frisch's persistent flattener (Lemme 5) in
relative dimension zero, with the uniform obstruction equations and the
factorization at all nearby points produced internally. No inverse, complement or
flatness packet is supplied. Positive relative dimension (privileged polydiscs) is
NOT covered.
BP FIRST: hironaka-g10-flat-frisch-holomorphic-flattener.tex. -/
set_option autoImplicit false
open Filter Topology

namespace Hironaka.HironakaG10FlatFrischHolomorphicFlattener

open Hironaka
open HironakaG10FlatFrischBlockComplement HironakaG10FlatFrischFiniteFlattener

noncomputable section

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]

/-- Functions holomorphic on `U`, as a subring of all functions. -/
def holOn (U : Set E) : Subring (E → ℂ) where
  carrier := {f | DifferentiableOn ℂ f U}
  mul_mem' := fun hf hg => hf.mul hg
  one_mem' := differentiableOn_const 1
  add_mem' := fun hf hg => hf.add hg
  zero_mem' := differentiableOn_const 0
  neg_mem' := fun hf => hf.neg

theorem eventually_differentiableAt_translate {U : Set E} (hU : IsOpen U) {p : E} (hp : p ∈ U)
    {f : E → ℂ} (hf : DifferentiableOn ℂ f U) :
    ∀ᶠ z in 𝓝 (0 : E), DifferentiableAt ℂ (fun z => f (z + p)) z := by
  have ht : Tendsto (fun z : E => z + p) (𝓝 0) (𝓝 p) := by
    have h : Tendsto (fun z : E => z + p) (𝓝 0) (𝓝 (0 + p)) := (continuous_add_const p).tendsto 0
    rwa [zero_add] at h
  filter_upwards [ht.eventually (hU.mem_nhds hp)] with z hz
  exact (hf.differentiableAt (hU.mem_nhds hz)).comp z
    (differentiableAt_id.add (differentiableAt_const p))

/-- The germ at `p ∈ U`, translated to the origin: a ring map to `𝒪_{E,0}`. -/
def germAt {U : Set E} (hU : IsOpen U) (p : E) (hp : p ∈ U) : holOn U →+* HolGerm E where
  toFun f := HolGerm.mk (fun z => f.1 (z + p)) (eventually_differentiableAt_translate hU hp f.2)
  map_one' := rfl
  map_mul' _ _ := rfl
  map_zero' := rfl
  map_add' _ _ := rfl

theorem eval_germAt {U : Set E} (hU : IsOpen U) (p : E) (hp : p ∈ U) (f : holOn U) :
    HolGerm.eval (germAt hU p hp f) = f.1 p := by
  show HolGerm.eval (HolGerm.mk (fun z => f.1 (z + p))
    (eventually_differentiableAt_translate hU hp f.2)) = f.1 p
  rw [HolGerm.eval_mk]
  simp

section Presentation
variable {U : Set E} (hU : IsOpen U)
  {ι ι₁ κ₀ : Type*} [Fintype ι] [Fintype ι₁] [Fintype κ₀]
  [DecidableEq ι] [DecidableEq ι₁] [DecidableEq κ₀]
  (α : Matrix ι ι₁ (holOn U)) (β : Matrix κ₀ ι₁ (holOn U))
  (γ : Matrix ι ι (holOn U)) (δ : Matrix κ₀ ι (holOn U))
  (hdet : ∀ q ∈ U, (γ.det).1 q ≠ 0)

/-- The holomorphic inverse of the nonvanishing determinant. -/
def detInv : holOn U :=
  ⟨fun q => ((γ.det).1 q)⁻¹, (γ.det).2.inv hdet⟩

/-- The internally constructed holomorphic inverse of `γ` on `U`. -/
def gammaInv : Matrix ι ι (holOn U) := detInv γ hdet • γ.adjugate

/-- The Schur ideal on `U`: generated by the finitely many holomorphic obstruction
functions, the entries of `β - δ γ⁻¹ α`. -/
def obstructionIdeal : Ideal (holOn U) := schurIdeal α β δ (gammaInv γ hdet)

theorem germAt_det_mul_detInv (p : E) (hp : p ∈ U) :
    germAt hU p hp (detInv γ hdet * γ.det) = 1 := by
  show HolGerm.mk (fun z => (detInv γ hdet * γ.det).1 (z + p))
      (eventually_differentiableAt_translate hU hp (detInv γ hdet * γ.det).2) =
    HolGerm.mk (1 : E → ℂ) eventually_differentiableAt_one
  apply HolGerm.mk_eq_mk_iff.mpr
  have ht : Tendsto (fun z : E => z + p) (𝓝 0) (𝓝 p) := by
    have h : Tendsto (fun z : E => z + p) (𝓝 0) (𝓝 (0 + p)) := (continuous_add_const p).tendsto 0
    rwa [zero_add] at h
  filter_upwards [ht.eventually (hU.mem_nhds hp)] with z hz
  change ((γ.det).1 (z + p))⁻¹ * (γ.det).1 (z + p) = 1
  exact inv_mul_cancel₀ (hdet _ hz)

theorem germ_gamma_mul_gammaInv (p : E) (hp : p ∈ U) :
    γ.map (germAt hU p hp) * (gammaInv γ hdet).map (germAt hU p hp) = 1 := by
  rw [← Matrix.map_mul, gammaInv, Matrix.mul_smul, Matrix.mul_adjugate, smul_smul]
  ext i j
  rw [Matrix.map_apply, Matrix.smul_apply, smul_eq_mul, map_mul,
    germAt_det_mul_detInv hU γ hdet p hp, one_mul, Matrix.one_apply, Matrix.one_apply]
  split_ifs <;> simp

theorem germ_gammaInv_mul_gamma (p : E) (hp : p ∈ U) :
    (gammaInv γ hdet).map (germAt hU p hp) * γ.map (germAt hU p hp) = 1 := by
  rw [← Matrix.map_mul, gammaInv, Matrix.smul_mul, Matrix.adjugate_mul, smul_smul]
  ext i j
  rw [Matrix.map_apply, Matrix.smul_apply, smul_eq_mul, map_mul,
    germAt_det_mul_detInv hU γ hdet p hp, one_mul, Matrix.one_apply, Matrix.one_apply]
  split_ifs <;> simp

omit [Fintype ι₁] [Fintype κ₀] [DecidableEq ι₁] [DecidableEq κ₀] in
/-- The germ of the obstruction ideal is the Schur ideal of the germ presentation. -/
theorem schurIdeal_germ (p : E) (hp : p ∈ U) :
    schurIdeal (α.map (germAt hU p hp)) (β.map (germAt hU p hp)) (δ.map (germAt hU p hp))
        ((gammaInv γ hdet).map (germAt hU p hp)) =
      Ideal.map (germAt hU p hp) (obstructionIdeal α β γ δ hdet) := by
  have hM : β.map (germAt hU p hp) - δ.map (germAt hU p hp) *
      (gammaInv γ hdet).map (germAt hU p hp) * α.map (germAt hU p hp) =
      (β - δ * gammaInv γ hdet * α).map (germAt hU p hp) := by
    rw [Matrix.map_sub (germAt hU p hp) (map_sub _), Matrix.map_mul, Matrix.map_mul]
  rw [obstructionIdeal, schurIdeal, schurIdeal, hM, Ideal.map_span]
  exact congrArg Ideal.span (Set.range_comp (germAt hU p hp)
    (fun q : κ₀ × ι₁ => (β - δ * gammaInv γ hdet * α) q.1 q.2))

/-- PERSISTENT analytic flattener in relative dimension zero: at EVERY point `p` of
`T = V(σ) ⊂ U` and for EVERY local base change `ψ` of the germ ring at `p`, the
base-changed cokernel of the germ presentation is flat EXACTLY when `ψ` kills the
germ of the ONE obstruction ideal `J_U`. -/
theorem flat_germ_cokernel_iff (p : E) (hp : p ∈ U)
    (hT : ∀ k i, ((β - δ * gammaInv γ hdet * α) k i).1 p = 0)
    {R : Type*} [CommRing R] [IsLocalRing R] (ψ : HolGerm E →+* R) [IsLocalHom ψ] :
    Module.Flat R (((ι → R) × (κ₀ → R)) ⧸
        LinearMap.range (matrixBlockMap (ψ.comp (germAt hU p hp)) α β γ δ)) ↔
      Ideal.map (ψ.comp (germAt hU p hp)) (obstructionIdeal α β γ δ hdet) = ⊥ := by
  have hblock : matrixBlockMap (ψ.comp (germAt hU p hp)) α β γ δ =
      matrixBlockMap ψ (α.map (germAt hU p hp)) (β.map (germAt hU p hp))
        (γ.map (germAt hU p hp)) (δ.map (germAt hU p hp)) := by
    simp only [matrixBlockMap, Matrix.map_map, RingHom.coe_comp]
  have hJ := schurIdeal_germ hU α β γ δ hdet p hp
  have hmax : Ideal.map ψ (schurIdeal (α.map (germAt hU p hp)) (β.map (germAt hU p hp))
      (δ.map (germAt hU p hp)) ((gammaInv γ hdet).map (germAt hU p hp))) ≤
      IsLocalRing.maximalIdeal R := by
    rw [hJ, obstructionIdeal, schurIdeal, Ideal.map_span, Ideal.map_span, Ideal.span_le]
    rintro _ ⟨_, ⟨_, ⟨q, rfl⟩, rfl⟩, rfl⟩
    have hq : germAt hU p hp ((β - δ * gammaInv γ hdet * α) q.1 q.2) ∈
        IsLocalRing.maximalIdeal (HolGerm E) := by
      rw [HolGerm.mem_maximalIdeal_iff, eval_germAt]
      exact hT q.1 q.2
    exact map_nonunit ψ _ hq
  rw [hblock, flat_matrixCokernel_iff _ _ _ _ _ (germ_gamma_mul_gammaInv hU γ hdet p hp)
    (germ_gammaInv_mul_gamma hU γ hdet p hp) ψ hmax, hJ, Ideal.map_map]

end Presentation

end

end Hironaka.HironakaG10FlatFrischHolomorphicFlattener
