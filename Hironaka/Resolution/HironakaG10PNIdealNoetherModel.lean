import Hironaka.Resolution.HironakaG10PNIdealNoetherOpen
import Hironaka.Resolution.HironakaReducedComplexAnalyticSpaces
import Hironaka.Coherence.CartanIrreducible
import Hironaka.Resolution.HironakaNativePulledIdealFiniteType
import Hironaka.Analytic.AnalyticSubsetTopology

/-! The Noether property of coherent ideal sheaves on complex spaces with analytic model charts,
possibly with nilpotents (lane G10P, run 0080; the quotient-model adapter `G10.FIBMOD.01` and the
compact statement `G10.COMPACT.01`).  Blueprint: `hironaka-g10-pn-ideal-noether.tex`.

* **Closed models.**  For a closed analytic subset `C` of a complex manifold `M` with its quotient
  structure sheaf `𝒪_M/𝓘_C`, an ideal family `J` on `C` is pushed to `M` as the preimage of `J` under
  the (surjective) stalk maps on `C` and the unit ideal off `C`.  It stays locally finitely generated:
  near a point of `C` it is generated by Cartan's finitely many generators of `𝓘_C` (Cartan's
  coherence theorem, proved in TN) together with local lifts of the generators of `J`; off `C` the
  vanishing ideal is the unit ideal.  The pull of the push is `J` again, so the local Noether property
  of `M` gives that of `C` (`hasLocalNoetherProperty_subspace`).
* **Spaces with analytic model charts** (every point in the image of an open immersion from an
  embedded model `(C, 𝒪_U/𝓘_C)`, `C ⊆ U ⊆ ℂⁿ` analytic): the local Noether property holds, hence ONE tail
  and ONE neighbourhood of every compact set (`exists_stationary_nhds_of_charts`); no ideal is assumed
  reduced or radical, so closed complex subspaces with nilpotents (e.g. fibres `𝔪_z 𝒪_Y`) are covered.
* `nativePulledIdealStalkIdeal F B b` is locally finitely generated when `B` is of finite type. -/

set_option autoImplicit false
open Set TopologicalSpace CategoryTheory Opposite AlgebraicGeometry
open scoped Manifold Topology

namespace Hironaka.HironakaG10PNIdealNoetherModel

open Hironaka.HolomorphicIdealSheaves HironakaActualAnalyticSubspace
  HironakaSmoothCentreRealDomainActualSheafStalk HironakaLegacyCoherentIdealSheaf
  HironakaLegacyCoherentIdealFiniteType HironakaG10PNIdealFamily
  HironakaReducedComplexAnalyticSpaces HironakaSingularModuleSheafStalk HironakaG10PNLayerStep
  HironakaG10PNIdealNoetherOpen

noncomputable section

/-- The range of an appended pair of tuples. -/
theorem range_fin_append {α : Type*} {k l : ℕ} (a : Fin k → α) (b : Fin l → α) :
    Set.range (Fin.append a b) = Set.range a ∪ Set.range b := by
  ext z
  constructor
  · rintro ⟨i, rfl⟩
    refine Fin.addCases (motive := fun i => Fin.append a b i ∈ range a ∪ range b)
      (fun j => ?_) (fun j => ?_) i
    · exact Or.inl ⟨j, (Fin.append_left a b j).symm⟩
    · exact Or.inr ⟨j, (Fin.append_right a b j).symm⟩
  · rintro (⟨j, rfl⟩ | ⟨j, rfl⟩)
    · exact ⟨Fin.castAdd l j, Fin.append_left a b j⟩
    · exact ⟨Fin.natAdd k j, Fin.append_right a b j⟩

section Model

variable {n : ℕ} {M : Type} [TopologicalSpace M] [ChartedSpace (ComplexModel n) M]
  [IsComplexManifold n M]

/-- Off a closed set the whole vanishing ideal is the unit ideal. -/
theorem wholeVanishing_eq_top {C : Set M} (hC : IsClosed C) {y : M} (hy : y ∉ C) :
    actualWholeSheafStalkIdeal (vanishingIdeal (n := n) C) y = ⊤ := by
  have hhol : HolomorphicAt n (fun _ : M => (1 : ℂ)) y :=
    Filter.Eventually.of_forall fun _ => mdifferentiableAt_const
  have hmem : (vanishingIdeal (n := n) C).mem y (fun _ => 1) := by
    refine ⟨hhol, ?_⟩
    filter_upwards [hC.isOpen_compl.mem_nhds hy] with z hz hzC
    exact absurd hzC hz
  have h1 : actualOriginalFunctionGerm y (fun _ : M => (1 : ℂ)) hhol = 1 := by
    rw [actualOriginalFunctionGerm_eq_section ⊤ y trivial 1 (fun _ => 1) hhol]
    · exact map_one _
    · filter_upwards with z
      rw [sectionExtension_apply ⊤ 1 z trivial]
      rfl
  rw [Ideal.eq_top_iff_one, ← h1]
  exact Ideal.subset_span ⟨fun _ => 1, hhol, hmem, rfl⟩

/-- **Cartan generators.**  Near every point the whole vanishing ideal of an analytic subset is
spanned, at every nearby point, by the germs of finitely many sections. -/
theorem exists_vanishing_generators {C : Set M} (hC : IsComplexAnalyticSubset (n := n) C)
    (x : M) :
    ∃ (W : Opens M) (_ : x ∈ W) (r : ℕ)
      (h : Fin r → (actualComplexStructureSheaf (n := n) M).presheaf.obj (op W)),
      ∀ (y : M) (hy : y ∈ W), actualWholeSheafStalkIdeal (vanishingIdeal (n := n) C) y =
        Ideal.span (range fun i => (actualComplexStructureSheaf (n := n) M).presheaf.germ W y hy
          (h i)) := by
  have hcoh : (vanishingIdeal (n := n) C).IsCoherent :=
    CartanIrreducible.cartanCoherence (n := n) (X := M) C hC
  obtain ⟨W, hxW, r, t, -, hspan⟩ := exists_local_finite_generators (vanishingIdeal (n := n) C) hcoh x
  refine ⟨W, hxW, r, fun i => (actualIdealModuleInclusion _).val.app (op W) (t i), fun y hy => ?_⟩
  rw [← actualIdealModule_stalkRange _ hcoh y, hspan y hy]

/-- **Local lifts of sections of the model.**  A section `s` of `𝒪_M/𝓘_C` near a point `c` of `C` is,
near `c`, the image of an ambient section `u`: at every point `c'` of `C` near `c` its germ is the stalk
image of the germ of `u`. -/
theorem exists_local_lift {C : Set M} (c : C) (Wc : Opens (actualSubspaceLocallyRingedSpace (n := n) C))
    (hc : c ∈ Wc) (s : (actualSubspaceLocallyRingedSpace (n := n) C).presheaf.obj (op Wc)) :
    ∃ (T : Opens M) (_ : c.val ∈ T)
      (u : (ChartedSpace.locallyRingedSpace 𝓘(ℂ, ComplexModel n) M).presheaf.obj (op T)),
      ∀ (c' : C) (hc' : c'.val ∈ T), ∃ hW : c' ∈ Wc,
        (actualSubspaceLocallyRingedSpace (n := n) C).presheaf.germ Wc c' hW s =
          (actualSubspaceInclusion (n := n) C).stalkMap c'
            ((ChartedSpace.locallyRingedSpace 𝓘(ℂ, ComplexModel n) M).presheaf.germ T c'.val hc'
              u) := by
  let ι := actualSubspaceInclusion (n := n) C
  obtain ⟨b, hb⟩ := actualSubspaceInclusionRingedHom_stalk_surjective (n := n) C c
    ((actualSubspaceLocallyRingedSpace (n := n) C).presheaf.germ Wc c hc s)
  obtain ⟨T₀, hcT₀, u₀, rfl⟩ :=
    TopCat.Presheaf.exists_germ_eq (ChartedSpace.locallyRingedSpace 𝓘(ℂ, ComplexModel n) M).presheaf b
  have hgerm := LocallyRingedSpace.stalkMap_germ_apply ι T₀ c hcT₀ u₀
  obtain ⟨O, hcO, iU, iV, hO⟩ := TopCat.Presheaf.germ_eq
    (actualSubspaceLocallyRingedSpace (n := n) C).presheaf c hcT₀ hc (ι.c.app (op T₀) u₀) s
    (hgerm.symm.trans hb)
  obtain ⟨T₁, hT₁, hT₁O⟩ := isOpen_induced_iff.mp O.isOpen
  let T : Opens M := T₀ ⊓ ⟨T₁, hT₁⟩
  have hcT : c.val ∈ T := ⟨hcT₀, show c ∈ (Subtype.val ⁻¹' T₁ : Set C) from hT₁O ▸ hcO⟩
  refine ⟨T, hcT, (ChartedSpace.locallyRingedSpace 𝓘(ℂ, ComplexModel n) M).presheaf.map
    (homOfLE (inf_le_left : T ≤ T₀)).op u₀, fun c' hc' => ?_⟩
  have hc'O : c' ∈ O := by
    have : c' ∈ (Subtype.val ⁻¹' T₁ : Set C) := hc'.2
    rw [hT₁O] at this
    exact this
  refine ⟨iV.le hc'O, ?_⟩
  have h1 := TopCat.Presheaf.germ_res_apply (actualSubspaceLocallyRingedSpace (n := n) C).presheaf
    iV c' hc'O s
  have h2 := TopCat.Presheaf.germ_res_apply (actualSubspaceLocallyRingedSpace (n := n) C).presheaf
    iU c' hc'O (ι.c.app (op T₀) u₀)
  have h3 := LocallyRingedSpace.stalkMap_germ_apply ι T₀ c' (iU.le hc'O) u₀
  have h4 := TopCat.Presheaf.germ_res_apply
    (ChartedSpace.locallyRingedSpace 𝓘(ℂ, ComplexModel n) M).presheaf
    (homOfLE (inf_le_left : T ≤ T₀)) c'.val hc' u₀
  exact h1.symm.trans ((congrArg (fun z => (actualSubspaceLocallyRingedSpace (n := n) C).presheaf.germ
    O c' hc'O z) hO.symm).trans (h2.trans (h3.symm.trans
      (congrArg (fun z => ι.stalkMap c' z) h4.symm))))

/-- **Push of an ideal family on the model** to the ambient manifold: the preimage under the stalk
map at points of `C`, the unit ideal off `C`. -/
def pushFamily (C : Set M)
    (J : ∀ c : actualSubspaceLocallyRingedSpace (n := n) C,
      Ideal ((actualSubspaceLocallyRingedSpace (n := n) C).presheaf.stalk c))
    (x : ChartedSpace.locallyRingedSpace 𝓘(ℂ, ComplexModel n) M) :
    Ideal ((ChartedSpace.locallyRingedSpace 𝓘(ℂ, ComplexModel n) M).presheaf.stalk x) := by
  classical
  exact if h : x ∈ C then
    Ideal.comap ((actualSubspaceInclusion (n := n) C).stalkMap ⟨x, h⟩).hom (J ⟨x, h⟩) else ⊤

theorem pushFamily_of_mem (C : Set M)
    (J : ∀ c : actualSubspaceLocallyRingedSpace (n := n) C,
      Ideal ((actualSubspaceLocallyRingedSpace (n := n) C).presheaf.stalk c))
    (c : C) :
    pushFamily C J c.val =
      Ideal.comap ((actualSubspaceInclusion (n := n) C).stalkMap c).hom (J c) := by
  classical
  exact dif_pos c.property

theorem pushFamily_of_not_mem (C : Set M)
    (J : ∀ c : actualSubspaceLocallyRingedSpace (n := n) C,
      Ideal ((actualSubspaceLocallyRingedSpace (n := n) C).presheaf.stalk c))
    (x : M) (hx : x ∉ C) : pushFamily C J x = ⊤ := by
  classical
  exact dif_neg hx

theorem pushFamily_mono (C : Set M)
    (J J' : ∀ c : actualSubspaceLocallyRingedSpace (n := n) C,
      Ideal ((actualSubspaceLocallyRingedSpace (n := n) C).presheaf.stalk c))
    (h : ∀ c, J c ≤ J' c) (x : M) : pushFamily C J x ≤ pushFamily C J' x := by
  by_cases hx : x ∈ C
  · rw [pushFamily_of_mem C J ⟨x, hx⟩, pushFamily_of_mem C J' ⟨x, hx⟩]
    exact Ideal.comap_mono (h _)
  · rw [pushFamily_of_not_mem C J x hx, pushFamily_of_not_mem C J' x hx]

/-- The pull of the push returns the family (the stalk maps of the model are surjective). -/
theorem pull_pushFamily (C : Set M)
    (J : ∀ c : actualSubspaceLocallyRingedSpace (n := n) C,
      Ideal ((actualSubspaceLocallyRingedSpace (n := n) C).presheaf.stalk c))
    (c : actualSubspaceLocallyRingedSpace (n := n) C) :
    J c = pullFamily (actualSubspaceInclusion (n := n) C) (pushFamily C J) c := by
  have hsurj := actualSubspaceInclusionRingedHom_stalk_surjective (n := n) C c
  change J c = Ideal.map ((actualSubspaceInclusion (n := n) C).stalkMap c).hom
    (pushFamily C J (c : C).val)
  rw [pushFamily_of_mem C J c]
  exact (Ideal.map_comap_of_surjective _ hsurj (J c)).symm

/-- **The push stays locally finitely generated** (Cartan generators of `𝓘_C` and local lifts of the
generators of `J`). -/
theorem pushFamily_isLocallyFinitelyGenerated {C : Set M}
    (hC : IsComplexAnalyticSubset (n := n) C)
    (J : ∀ c : actualSubspaceLocallyRingedSpace (n := n) C,
      Ideal ((actualSubspaceLocallyRingedSpace (n := n) C).presheaf.stalk c))
    (hJ : IsLocallyFinitelyGenerated (actualSubspaceLocallyRingedSpace (n := n) C) J) :
    IsLocallyFinitelyGenerated (ChartedSpace.locallyRingedSpace 𝓘(ℂ, ComplexModel n) M)
      (pushFamily C J) := by
  classical
  have hCc : IsClosed C := hC.isClosed
  intro x
  by_cases hx : x ∈ C
  · let c : C := ⟨x, hx⟩
    obtain ⟨Wc, hcW, r, s, hs⟩ := hJ c
    obtain ⟨Tc, hTc, hTcW⟩ := isOpen_induced_iff.mp Wc.isOpen
    obtain ⟨W₁, hxW₁, r₁, h, hh⟩ := exists_vanishing_generators hC x
    choose T hT u hu using fun i : Fin r => exists_local_lift c Wc hcW (s i)
    let W : Opens M := (W₁ ⊓ ⟨Tc, hTc⟩) ⊓ (Finset.univ : Finset (Fin r)).inf T
    have hWT (i : Fin r) : W ≤ T i := fun y hy =>
      (mem_finset_open_inf T Finset.univ y).mp hy.2 i (Finset.mem_univ i)
    have hWW₁ : W ≤ W₁ := fun y hy => hy.1.1
    have hxTc : x ∈ Tc := by
      have : c ∈ (Subtype.val ⁻¹' Tc : Set C) := hTcW ▸ hcW
      exact this
    have hxW : x ∈ W :=
      ⟨⟨hxW₁, hxTc⟩, (mem_finset_open_inf T Finset.univ x).mpr fun i _ => hT i⟩
    let P := (ChartedSpace.locallyRingedSpace 𝓘(ℂ, ComplexModel n) M).presheaf
    let gh : Fin r₁ → P.obj (op W) := fun j => P.map (homOfLE hWW₁).op (h j)
    let gu : Fin r → P.obj (op W) := fun i => P.map (homOfLE (hWT i)).op (u i)
    refine ⟨W, hxW, r₁ + r, Fin.append gh gu, fun y hy => ?_⟩
    have hgh : Ideal.span (range fun j => P.germ W y hy (gh j)) =
        actualWholeSheafStalkIdeal (vanishingIdeal (n := n) C) y := by
      rw [hh y (hWW₁ hy)]
      exact congrArg Ideal.span (congrArg Set.range (funext fun j =>
        TopCat.Presheaf.germ_res_apply P (homOfLE hWW₁) y hy (h j)))
    have hgu : Ideal.span (range fun i => P.germ W y hy (gu i)) =
        Ideal.span (range fun i => P.germ (T i) y (hWT i hy) (u i)) :=
      congrArg Ideal.span (congrArg Set.range (funext fun i =>
        TopCat.Presheaf.germ_res_apply P (homOfLE (hWT i)) y hy (u i)))
    have hsplit : Ideal.span (range fun k => P.germ W y hy (Fin.append gh gu k)) =
        actualWholeSheafStalkIdeal (vanishingIdeal (n := n) C) y ⊔
          Ideal.span (range fun i => P.germ (T i) y (hWT i hy) (u i)) := by
      have hr : (range fun k => P.germ W y hy (Fin.append gh gu k)) =
          range (fun j => P.germ W y hy (gh j)) ∪ range (fun i => P.germ W y hy (gu i)) := by
        rw [← range_fin_append]
        congr 1
        funext k
        refine Fin.addCases (motive := fun k =>
          P.germ W y hy (Fin.append gh gu k) = Fin.append (fun j => P.germ W y hy (gh j))
            (fun i => P.germ W y hy (gu i)) k) (fun j => ?_) (fun i => ?_) k
        · rw [Fin.append_left, Fin.append_left]
        · rw [Fin.append_right, Fin.append_right]
      rw [hr, Ideal.span_union, hgh, hgu]
      rfl
    rw [hsplit]
    by_cases hyC : y ∈ C
    · let c' : C := ⟨y, hyC⟩
      have hc'W : c' ∈ Wc := by
        have : c' ∈ (Subtype.val ⁻¹' Tc : Set C) := hy.1.2
        rw [hTcW] at this
        exact this
      have hJc : J c' = Ideal.map ((actualSubspaceInclusion (n := n) C).stalkMap c').hom
          (Ideal.span (range fun i => P.germ (T i) y (hWT i hy) (u i))) := by
        rw [hs c' hc'W, Ideal.map_span, ← Set.range_comp]
        exact congrArg Ideal.span (congrArg Set.range
          (funext fun i => (hu i c' (hWT i hy)).2))
      have hker := actualSubspaceInclusion_stalk_kernel (n := n) C c'
      have hsurj : Function.Surjective ((actualSubspaceInclusion (n := n) C).stalkMap c').hom :=
        actualSubspaceInclusionRingedHom_stalk_surjective (n := n) C c'
      show pushFamily C J c'.val = _
      rw [pushFamily_of_mem C J c', hJc, Ideal.comap_map_of_surjective _ hsurj,
        ← RingHom.ker_eq_comap_bot, hker, sup_comm]
      rfl
    · rw [pushFamily_of_not_mem C J y hyC, wholeVanishing_eq_top hCc hyC, top_sup_eq]
  · refine ⟨⟨Cᶜ, hCc.isOpen_compl⟩, hx, 1, fun _ => 1, fun y hy => ?_⟩
    rw [pushFamily_of_not_mem C J y hy]
    symm
    rw [Ideal.eq_top_iff_one]
    exact Ideal.subset_span ⟨0, map_one _⟩

/-- **The local Noether property passes from a complex manifold to its closed analytic subsets**
with the quotient structure sheaf `𝒪_M/𝓘_C`. -/
theorem hasLocalNoetherProperty_subspace
    (hM : HasLocalNoetherProperty (ChartedSpace.locallyRingedSpace 𝓘(ℂ, ComplexModel n) M))
    {C : Set M} (hC : IsComplexAnalyticSubset (n := n) C) :
    HasLocalNoetherProperty (actualSubspaceLocallyRingedSpace (n := n) C) :=
  hasLocalNoetherProperty_of_push (actualSubspaceInclusion (n := n) C) hM (pushFamily C)
    (fun J J' h x => pushFamily_mono C J J' h x)
    (fun J hJ => pushFamily_isLocallyFinitelyGenerated hC J hJ) (pull_pushFamily C)

end Model

/-- **The local Noether property of every embedded analytic model** `(C, 𝒪_U/𝓘_C)`. -/
theorem hasLocalNoetherProperty_model {n : ℕ} (U : Opens (ComplexModel n)) (C : Set U)
    (hC : IsComplexAnalyticSubset (n := n) C) :
    HasLocalNoetherProperty (modelOver U C).left :=
  hasLocalNoetherProperty_subspace (hasLocalNoetherProperty_manifoldOpen U) hC

/-- Every point lies in the image of an open immersion from an embedded analytic model (the chart
condition of `hasAnalyticCharts` and of Hironaka's `sourceReducedComplexSpaceProperty`, without the
separation axioms and the structure map). -/
def HasAnalyticModelCharts (X : LocallyRingedSpace.{0}) : Prop :=
  ∀ x : X, ∃ (n : ℕ) (U : Opens (ComplexModel n)) (C : Set U),
    IsComplexAnalyticSubset (n := n) C ∧
      ∃ i : (modelOver U C).left ⟶ X, LocallyRingedSpace.IsOpenImmersion i ∧ x ∈ Set.range i.base

/-- **The local Noether property of a complex space with analytic model charts.** -/
theorem hasLocalNoetherProperty_of_charts {X : LocallyRingedSpace.{0}}
    (hX : HasAnalyticModelCharts X) : HasLocalNoetherProperty X :=
  hasLocalNoetherProperty_of_openImmersions fun x => by
    obtain ⟨n, U, C, hC, i, hi, hx⟩ := hX x
    exact ⟨_, i, hi, hasLocalNoetherProperty_model U C hC, hx⟩

/-- **The Noether property over a compact set (`G10.COMPACT.01`, analytic-space form).**  On a complex
space with analytic model charts, an ascending chain of locally finitely generated (coherent) ideal
families is stationary near every compact `K`: ONE tail `N` and ONE open `W ⊇ K` with `J m = J N` on
`W` for every `m ≥ N`.  Nilpotents are allowed: no ideal is assumed reduced or radical. -/
theorem exists_stationary_nhds_of_charts {X : LocallyRingedSpace.{0}}
    (hX : HasAnalyticModelCharts X) {J : ℕ → ∀ x : X, Ideal (X.presheaf.stalk x)}
    (hJ : IsAscending X J) (hfg : ∀ m, IsLocallyFinitelyGenerated X (J m)) (K : Set X)
    (hK : IsCompact K) :
    ∃ (N : ℕ) (W : Opens X), K ⊆ (W : Set X) ∧
      ∀ m, N ≤ m → ∀ x : X, x ∈ W → J m x = J N x :=
  (hasLocalNoetherProperty_of_charts hX).exists_stationary_nhds hJ hfg K hK

/-- **Termination form.**  On a complex space with analytic model charts, an ascending chain of
locally finitely generated ideal families cannot grow strictly at some point of a fixed compact `K`
at every step (e.g. no infinite strictly decreasing chain of closed complex subspaces, with
nilpotents, of a compact fibre). -/
theorem not_forall_exists_strict_of_charts {X : LocallyRingedSpace.{0}}
    (hX : HasAnalyticModelCharts X) {J : ℕ → ∀ x : X, Ideal (X.presheaf.stalk x)}
    (hJ : IsAscending X J) (hfg : ∀ m, IsLocallyFinitelyGenerated X (J m)) (K : Set X)
    (hK : IsCompact K) : ¬ ∀ m : ℕ, ∃ x ∈ K, J m x < J (m + 1) x :=
  not_forall_exists_strict hJ K hK fun p _ => hasLocalNoetherProperty_of_charts hX J hJ hfg p

/-- Objects of `hasAnalyticCharts` have analytic model charts. -/
theorem hasAnalyticModelCharts_of_hasAnalyticCharts {A : Over complexPoint}
    (hA : hasAnalyticCharts A) : HasAnalyticModelCharts A.left := fun x => by
  obtain ⟨n, U, C, hC, i, hi, -, hx⟩ := hA.2.2 x
  exact ⟨n, U, C, hC, i, hi, hx⟩

/-- **Pulled ideals are coherent.**  The pulled ideal `J(f y) 𝒪_{X,x}` of a finite-type target ideal
module is locally finitely generated (e.g. the fibre ideal `𝔪_z 𝒪_Y` when the ideal sheaf of the
point is of finite type). -/
theorem isLocallyFinitelyGenerated_nativePulledIdeal {X Y : LocallyRingedSpace.{0}} (F : X ⟶ Y)
    (B : SheafOfModules.{0} (forgetRing Y.toSheafedSpace.sheaf))
    (b : B ⟶ SheafOfModules.unit (forgetRing Y.toSheafedSpace.sheaf)) [B.IsFiniteType] :
    IsLocallyFinitelyGenerated X
      (HironakaNativePulledIdealSheaf.nativePulledIdealStalkIdeal F B b) := by
  intro x
  obtain ⟨V, hxV, r, s, -, hspan⟩ :=
    HironakaNativePulledIdealFiniteType.exists_local_finite_pulled_generators F B b x
  refine ⟨(Opens.map F.base).obj V, hxV, r,
    fun i => (HironakaNativePulledIdealSheaf.nativePulledIdealSection F B b V (s i)).val,
    fun y hy => ?_⟩
  rw [← HironakaNativePulledIdealStalk.nativePulledIdealStalkInclusion_range F B b y]
  exact hspan y hy

end

end Hironaka.HironakaG10PNIdealNoetherModel
