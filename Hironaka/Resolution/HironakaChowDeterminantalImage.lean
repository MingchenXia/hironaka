import Hironaka.Resolution.HironakaSingularIdealInvertibleModule
import Hironaka.Resolution.HironakaActualAnalyticSubspaceResidue
import Mathlib.LinearAlgebra.Matrix.Adjugate
import Mathlib.LinearAlgebra.Matrix.ToLin
import Mathlib.LinearAlgebra.Basis.Basic

/-!
# Actual matrix images after principalizing their full determinantal ideals

The ideal is generated by ALL original square minors. Native invertibility of
that same ideal module supplies a regular generating minor internally. The
local flattening conclusion will concern the original Matrix.toLin' image,
with explicit original column coefficients and no supplied free/basis pivot.

Blueprint: `hironaka-g10-determinantal-image.tex`.
-/

set_option autoImplicit false

open Set Matrix Module
open scoped BigOperators

namespace Hironaka.HironakaChowDeterminantalImage

noncomputable section

open HironakaSingularIdealInvertibleModule

variable {R : Type*} [CommRing R] {p q r : ℕ}

/-- The standard FULL determinantal ideal; repeated-index minors are zero. -/
def minorIdeal (A : Matrix (Fin p) (Fin q) R) (r : ℕ) : Ideal R :=
  Ideal.span (range fun ij : (Fin r → Fin p) × (Fin r → Fin q) =>
    (A.submatrix ij.1 ij.2).det)

/-- Standard local invertibility of ALL original minors internally chooses an
actual regular minor generating that SAME ideal. -/
theorem exists_regular_generating_minor [IsLocalRing R]
    (A : Matrix (Fin p) (Fin q) R) (r : ℕ)
    (hInv : Module.Invertible R (minorIdeal A r)) :
    ∃ (rows : Fin r → Fin p) (cols : Fin r → Fin q),
      minorIdeal A r = Ideal.span {(A.submatrix rows cols).det} ∧
      IsRegular (A.submatrix rows cols).det := by
  classical
  obtain ⟨alpha, ha, hspan, hreg⟩ := exists_regular_generator (minorIdeal A r) hInv
  let L := (Fin r → Fin p) × (Fin r → Fin q)
  let d : L → R := fun ij => (A.submatrix ij.1 ij.2).det
  have hdiv : ∀ i : L, alpha ∣ d i := by
    intro i
    apply Ideal.mem_span_singleton.mp
    rw [← hspan]
    exact Ideal.subset_span ⟨i, rfl⟩
  choose Q hQ using hdiv
  have hmem : alpha ∈ Ideal.span (range d) := ha
  obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hmem
  have hsum : ∑ i : L, c i * Q i = 1 := by
    apply hreg.left
    calc
      alpha * ∑ i : L, c i * Q i = ∑ i : L, alpha * (c i * Q i) := Finset.mul_sum _ _ _
      _ = ∑ i : L, c i * d i := by
        apply Finset.sum_congr rfl
        intro i _
        rw [hQ i]
        ring
      _ = alpha := hc
      _ = alpha * 1 := (mul_one _).symm
  obtain ⟨i, _hi, hunit⟩ := IsLocalRing.exists_of_isUnit_sum
    (s := Finset.univ) (f := fun i : L => c i * Q i) (hsum.symm ▸ isUnit_one)
  have hQunit : IsUnit (Q i) := (IsUnit.mul_iff.mp hunit).2
  have hdspan : minorIdeal A r = Ideal.span {d i} := by
    rw [hQ i, Ideal.span_singleton_mul_right_unit hQunit, hspan]
  exact ⟨i.1, i.2, hdspan, isRegular_of_span_eq (minorIdeal A r) hInv hdspan⟩

private theorem mulVec_injective_of_regular_det (P : Matrix (Fin r) (Fin r) R)
    (hP : IsRegular P.det) : Function.Injective (P *ᵥ ·) := by
  intro x y hxy
  have h := congrArg (fun v => P.adjugate *ᵥ v) hxy
  simp only [mulVec_mulVec, adjugate_mul, smul_mulVec, one_mulVec] at h
  ext i
  apply hP.left
  exact congrFun h i

private theorem augmented_minor_zero (A : Matrix (Fin p) (Fin q) R)
    (hHigher : ∀ (rows : Fin (r+1) → Fin p) (cols : Fin (r+1) → Fin q),
      (A.submatrix rows cols).det = 0)
    (rows : Fin r → Fin p) (cols : Fin r → Fin q) (i : Fin p) (j : Fin q) :
    (A.submatrix (Sum.elim rows (fun _ : Fin 1 => i))
      (Sum.elim cols (fun _ : Fin 1 => j))).det = 0 := by
  let E : Fin r ⊕ Fin 1 ≃ Fin (r+1) := finSumFinEquiv
  have h := hHigher
    ((Sum.elim rows (fun _ : Fin 1 => i)) ∘ E.symm)
    ((Sum.elim cols (fun _ : Fin 1 => j)) ∘ E.symm)
  change ((A.submatrix (Sum.elim rows (fun _ : Fin 1 => i))
    (Sum.elim cols (fun _ : Fin 1 => j))).submatrix E.symm E.symm).det = 0 at h
  simpa only [det_submatrix_equiv_self] using h

private theorem column_coefficients_of_regular_minor
    (A : Matrix (Fin p) (Fin q) R) (rows : Fin r → Fin p) (cols : Fin r → Fin q)
    (hReg : IsRegular (A.submatrix rows cols).det)
    (hSpan : minorIdeal A r = Ideal.span {(A.submatrix rows cols).det})
    (hHigher : ∀ (rows : Fin (r+1) → Fin p) (cols : Fin (r+1) → Fin q),
      (A.submatrix rows cols).det = 0) (j : Fin q) :
    ∃ v : Fin r → R, A.col j = (A.submatrix id cols) *ᵥ v := by
  classical
  let P := A.submatrix rows cols
  let C := A.submatrix id cols
  let v₀ : Fin r → R := fun l => A (rows l) j
  have hdiv (l : Fin r) : P.det ∣ P.cramer v₀ l := by
    apply Ideal.mem_span_singleton.mp
    rw [← hSpan]
    have heq : P.updateCol l v₀ = A.submatrix rows (Function.update cols l j) := by
      ext a b
      by_cases hb : b = l <;> simp [P, v₀, hb]
    rw [cramer_apply, heq]
    exact Ideal.subset_span ⟨(rows, Function.update cols l j), rfl⟩
  choose v hv using hdiv
  have hCramer : P.cramer v₀ = P.det • v := funext hv
  have hsmall : P *ᵥ v = v₀ := by
    have h := mulVec_cramer P v₀
    rw [hCramer, mulVec_smul] at h
    ext l
    apply hReg.left
    exact congrFun h l
  let u : Fin p → R := A.col j - C *ᵥ v
  have huRows (l : Fin r) : u (rows l) = 0 := by
    change v₀ l - (P *ᵥ v) l = 0
    rw [hsmall]
    exact sub_self _
  have hu (i : Fin p) : u i = 0 := by
    let ri := Sum.elim rows (fun _ : Fin 1 => i)
    let cj := Sum.elim cols (fun _ : Fin 1 => j)
    let M := A.submatrix ri cj
    let last : Fin r ⊕ Fin 1 := Sum.inr 0
    let vAug : Fin r ⊕ Fin 1 → R := fun a => A (ri a) j
    let uAug : Fin r ⊕ Fin 1 → R := fun a => u (ri a)
    have hMzero : M.det = 0 := augmented_minor_zero A hHigher rows cols i j
    have huAug : uAug = vAug - ∑ l : Fin r, v l • M.col (Sum.inl l) := by
      ext a
      simp [uAug, vAug, u, C, M, ri, cj, mulVec, dotProduct, mul_comm]
    have hcramerCols (l : Fin r) : M.cramer (M.col (Sum.inl l)) last = 0 := by
      have h := cramer_row_self M (M.col (Sum.inl l)) (Sum.inl l) (fun _ => rfl)
      simpa [last] using congrFun h last
    have hcramerV : M.cramer vAug last = 0 := by
      have h := cramer_row_self M vAug last (fun _ => rfl)
      simpa [hMzero] using congrFun h last
    have hdetU : (M.updateCol last uAug).det = 0 := by
      change M.cramer uAug last = 0
      rw [huAug, map_sub, map_sum]
      simp only [map_smul, Pi.sub_apply, Finset.sum_apply, Pi.smul_apply, smul_eq_mul,
        hcramerCols, mul_zero, Finset.sum_const_zero, sub_zero]
      exact hcramerV
    let B : Matrix (Fin 1) (Fin r) R := fun _ l => A i (cols l)
    let D : Matrix (Fin 1) (Fin 1) R := fun _ _ => u i
    have hblock : M.updateCol last uAug = Matrix.fromBlocks P 0 B D := by
      ext a b
      rcases a with a | a <;> rcases b with b | b
      · simp [M, ri, cj, P, last, Matrix.fromBlocks]
      · have hb : b = 0 := Subsingleton.elim _ _
        subst b
        simp [M, ri, cj, P, last, uAug, huRows, Matrix.fromBlocks]
      · simp [M, ri, cj, P, last, B, Matrix.fromBlocks]
      · have hb : b = 0 := Subsingleton.elim _ _
        subst b
        simp [M, ri, cj, P, last, uAug, D, Matrix.fromBlocks]
    have hmulzero : P.det * u i = 0 := by
      calc
        P.det * u i = P.det * D.det := by rw [det_unique D]
        _ = (Matrix.fromBlocks P 0 B D).det := (det_fromBlocks_zero₁₂ P B D).symm
        _ = 0 := by rw [← hblock]; exact hdetU
    apply hReg.left
    simpa only [mul_zero] using hmulzero
  refine ⟨v, ?_⟩
  ext i
  exact sub_eq_zero.mp (hu i)

/-- ALL minors and the standard invertible ideal internally produce a basis
from actual original columns of the SAME native matrix image. -/
theorem exists_column_equiv [IsLocalRing R]
    (A : Matrix (Fin p) (Fin q) R) (r : ℕ)
    (hInv : Module.Invertible R (minorIdeal A r))
    (hHigher : ∀ (rows : Fin (r+1) → Fin p) (cols : Fin (r+1) → Fin q),
      (A.submatrix rows cols).det = 0) :
    ∃ (cols : Fin r → Fin q)
      (E : (Fin r → R) ≃ₗ[R] (Matrix.toLin' A).range),
      (∀ v, (E v).val = (A.submatrix id cols) *ᵥ v) ∧
      ∃ b : Basis (Fin r) R (Matrix.toLin' A).range,
        ∀ i, (b i).val = A.col (cols i) := by
  classical
  obtain ⟨rows, cols, hSpan, hReg⟩ := exists_regular_generating_minor A r hInv
  let C := A.submatrix id cols
  have hCoeffs := column_coefficients_of_regular_minor A rows cols hReg hSpan hHigher
  have hRange : (Matrix.toLin' C).range = (Matrix.toLin' A).range := by
    rw [Matrix.range_toLin', Matrix.range_toLin']
    apply le_antisymm
    · apply Submodule.span_le.mpr
      rintro _ ⟨i, rfl⟩
      exact Submodule.subset_span ⟨cols i, rfl⟩
    · apply Submodule.span_le.mpr
      rintro _ ⟨j, rfl⟩
      rw [← Matrix.range_toLin' C]
      obtain ⟨v, hv⟩ := hCoeffs j
      exact ⟨v, hv.symm⟩
  have hCinj : Function.Injective (Matrix.toLin' C) := by
    intro x y hxy
    apply mulVec_injective_of_regular_det (A.submatrix rows cols) hReg
    funext i
    exact congrFun hxy (rows i)
  let L : (Fin r → R) →ₗ[R] (Matrix.toLin' A).range :=
    (Matrix.toLin' C).codRestrict _ (fun v => by rw [← hRange]; exact ⟨v, rfl⟩)
  have hLinj : Function.Injective L := by
    intro x y hxy
    exact hCinj (congrArg Subtype.val hxy)
  have hLsurj : Function.Surjective L := by
    intro y
    have hy : y.val ∈ (Matrix.toLin' C).range := by rw [hRange]; exact y.property
    obtain ⟨v, hv⟩ := hy
    exact ⟨v, Subtype.ext hv⟩
  let E := LinearEquiv.ofBijective L ⟨hLinj, hLsurj⟩
  have hE (v : Fin r → R) : (E v).val = C *ᵥ v := rfl
  let b := (Pi.basisFun R (Fin r)).map E
  refine ⟨cols, E, hE, b, ?_⟩
  intro i
  change (E ((Pi.basisFun R (Fin r)) i)).val = A.col (cols i)
  rw [hE, Pi.basisFun_apply, Matrix.mulVec_single_one]
  rfl

open HironakaActualAnalyticSubspace

/-- The actual ORIGINAL singular quotient-stalk matrix and its SAME full
minor ideal produce their native image basis, with zero divisors allowed. -/
theorem actual_stalk_exists_column_equiv
    {n : ℕ} {M : Type} [TopologicalSpace M]
    [ChartedSpace (ComplexModel n) M] [IsComplexManifold n M]
    (S : Set M) (x : S)
    (A : Matrix (Fin p) (Fin q)
      ((actualSubspaceSheaf (n := n) S).presheaf.stalk x).carrier) (r : ℕ)
    (hInv : Module.Invertible ((actualSubspaceSheaf (n := n) S).presheaf.stalk x).carrier
      (minorIdeal A r))
    (hHigher : ∀ (rows : Fin (r+1) → Fin p) (cols : Fin (r+1) → Fin q),
      (A.submatrix rows cols).det = 0) :
    ∃ (cols : Fin r → Fin q)
      (E : (Fin r → ((actualSubspaceSheaf (n := n) S).presheaf.stalk x).carrier)
        ≃ₗ[((actualSubspaceSheaf (n := n) S).presheaf.stalk x).carrier]
          (Matrix.toLin' A).range),
      (∀ v, (E v).val = (A.submatrix id cols) *ᵥ v) ∧
      ∃ b : Basis (Fin r) ((actualSubspaceSheaf (n := n) S).presheaf.stalk x).carrier
          (Matrix.toLin' A).range,
        ∀ i, (b i).val = A.col (cols i) := by
  let : IsLocalRing ((actualSubspaceSheaf (n := n) S).presheaf.stalk x).carrier :=
    actualSubspaceStalk_isLocalRing (n := n) S x
  exact exists_column_equiv A r hInv hHigher

end

end Hironaka.HironakaChowDeterminantalImage
