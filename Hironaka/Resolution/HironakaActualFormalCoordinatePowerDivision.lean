import Hironaka.Resolution.HironakaActualFormalWeightedDivision

/-! Genuine selected-coordinate power kernels before actual whole centre-order division memberships. -/
set_option autoImplicit false
open Set Classical
namespace Hironaka.HironakaActualFormalCoordinatePowerDivision
noncomputable section
open HironakaActualFormalInitialDiagram HironakaActualFormalVertexDivision
  HironakaActualFormalWeightedDivision
variable {n : ℕ}

/-- Actual coefficient weight vanishing is a genuine ideal under TRUE formal convolution. -/
def actualFormalWeightVanishing (w : Fin n → ℕ) (q : ℕ) : Ideal (MvPowerSeries (Fin n) ℂ) where
  carrier := {F | ∀ a : Fin n →₀ ℕ, Finsupp.weight w a < q → MvPowerSeries.coeff a F=0}
  zero_mem' := by intro a _; exact map_zero _
  add_mem' := by
    intro F G hF hG a ha
    rw [map_add,hF a ha,hG a ha,add_zero]
  smul_mem' := by
    intro G F hF a ha
    rw [smul_eq_mul,MvPowerSeries.coeff_mul]
    apply Finset.sum_eq_zero
    intro p hp
    have he := congrArg (Finsupp.weight w) (Finset.mem_antidiagonal.mp hp)
    rw [map_add] at he
    have hsmall : Finsupp.weight w p.2 < q := by omega
    rw [hF p.2 hsmall,mul_zero]

/-- Actual finite-antidiagonal multiplication adds the GENUINE coefficient weight filtrations. -/
theorem actualFormalWeightVanishing_mul_mem (w : Fin n → ℕ) (p q : ℕ)
    (F G : MvPowerSeries (Fin n) ℂ)
    (hF : F ∈ actualFormalWeightVanishing w p) (hG : G ∈ actualFormalWeightVanishing w q) :
    F*G ∈ actualFormalWeightVanishing w (p+q) := by
  intro a ha
  rw [MvPowerSeries.coeff_mul]
  apply Finset.sum_eq_zero
  intro b hb
  have he := congrArg (Finsupp.weight w) (Finset.mem_antidiagonal.mp hb)
  rw [map_add] at he
  by_cases hf : Finsupp.weight w b.1 < p
  · rw [hF b.1 hf,zero_mul]
  · have hg : Finsupp.weight w b.2 < q := by omega
    rw [hG b.2 hg,mul_zero]

/-- The indicator weights of the SAME actual selected coordinate subset. -/
def actualCoordinateWeight (A : Set (Fin n)) (i : Fin n) : ℕ := if i ∈ A then 1 else 0

/-- The ACTUAL ideal generated by the SAME original selected formal variables. -/
def actualFormalCoordinateIdeal (n : ℕ) (A : Set (Fin n)) : Ideal (MvPowerSeries (Fin n) ℂ) :=
  Ideal.span ((MvPowerSeries.X : Fin n → MvPowerSeries (Fin n) ℂ) '' A)

/-- Every genuine selected variable has actual coordinate weight one. -/
theorem actualFormalCoordinateIdeal_le_weightVanishing (A : Set (Fin n)) :
    actualFormalCoordinateIdeal n A ≤ actualFormalWeightVanishing (actualCoordinateWeight A) 1 := by
  apply Ideal.span_le.mpr
  rintro F ⟨i,hi,rfl⟩
  intro a ha
  have hw : Finsupp.weight (actualCoordinateWeight A) (Finsupp.single i 1)=1 := by
    simp [Finsupp.weight_single,actualCoordinateWeight,hi]
  by_cases he : a=Finsupp.single i 1
  · subst a
    rw [hw] at ha
    omega
  · simp [MvPowerSeries.coeff_X,he]

/-- Genuine ideal power induction supplies the ENTIRE actual coordinate power coefficient vanishing. -/
theorem actualFormalCoordinateIdeal_pow_le_weightVanishing (A : Set (Fin n)) (q : ℕ) :
    actualFormalCoordinateIdeal n A ^ q ≤ actualFormalWeightVanishing (actualCoordinateWeight A) q := by
  induction q with
  | zero => intro F _ a ha; omega
  | succ q ih =>
      rw [pow_succ]
      exact Ideal.mul_le.mpr (fun F hF G hG =>
        actualFormalWeightVanishing_mul_mem _ q 1 F G (ih hF)
          (actualFormalCoordinateIdeal_le_weightVanishing A hG))

/-- Each actual monomial belongs to its TRUE selected-coordinate weight power. -/
theorem actual_monomial_mem_coordinate_weight_power (A : Set (Fin n)) (a : Fin n →₀ ℕ) :
    MvPowerSeries.monomial a (1 : ℂ) ∈
      actualFormalCoordinateIdeal n A ^ Finsupp.weight (actualCoordinateWeight A) a := by
  classical
  have hw : Finsupp.weight (actualCoordinateWeight A) a=
      ∑ i ∈ a.support, if i ∈ A then a i else 0 := by
    rw [Finsupp.weight_apply]
    apply Finset.sum_congr rfl
    intro i _
    by_cases hi : i ∈ A <;> simp [actualCoordinateWeight,hi]
  rw [MvPowerSeries.monomial_one_eq]
  change (∏ i ∈ a.support, (MvPowerSeries.X i : MvPowerSeries (Fin n) ℂ) ^ a i) ∈ _
  rw [hw,← Finset.prod_pow_eq_pow_sum]
  apply Ideal.prod_mem_prod
  intro i _
  by_cases hi : i ∈ A
  · rw [if_pos hi]
    apply Ideal.pow_mem_pow
    exact Ideal.subset_span ⟨i,hi,rfl⟩
  · simp only [if_neg hi,pow_zero,Ideal.one_eq_top,Submodule.mem_top]

/-- The GENUINE coordinate power has its literal actual weight diagram for ANY monomial order. -/
theorem mem_actualInitialDiagram_coordinate_power_iff (m : MonomialOrder (Fin n))
    (A : Set (Fin n)) (q : ℕ) (a : Fin n →₀ ℕ) :
    a ∈ actualInitialDiagram m (actualFormalCoordinateIdeal n A ^ q) ↔
      q ≤ Finsupp.weight (actualCoordinateWeight A) a := by
  constructor
  · rintro ⟨F,hF,hne,he⟩
    have hv := actualFormalCoordinateIdeal_pow_le_weightVanishing A q hF
    have hc : MvPowerSeries.coeff a F ≠ 0 := he ▸ (actualInitialExponent_spec m F hne).1
    by_contra h
    exact hc (hv a (lt_of_not_ge h))
  · intro ha
    refine ⟨MvPowerSeries.monomial a 1,?_,actualMonomial_ne_zero a,actualInitialExponent_monomial m a⟩
    exact (Ideal.pow_le_pow_right ha) (actual_monomial_mem_coordinate_weight_power A a)

/-- BOTH genuine coordinate-power kernel directions are constructed INTERNALLY from actual division. -/
theorem mem_actualFormalCoordinateIdeal_pow_iff (A : Set (Fin n)) (q : ℕ)
    (F : MvPowerSeries (Fin n) ℂ) :
    F ∈ actualFormalCoordinateIdeal n A ^ q ↔
      ∀ a : Fin n →₀ ℕ, Finsupp.weight (actualCoordinateWeight A) a < q → MvPowerSeries.coeff a F=0 := by
  constructor
  · intro hF
    exact actualFormalCoordinateIdeal_pow_le_weightVanishing A q hF
  · intro hF
    let K := actualFormalCoordinateIdeal n A ^ q
    let R := actualFormalRemainder MonomialOrder.degLex K F
    have hs : (∑ a : actualInitialVertices MonomialOrder.degLex K,
        actualFormalQuotient MonomialOrder.degLex K F a*actualVertexSeries MonomialOrder.degLex K a) ∈ K :=
      K.sum_mem (fun a _ => K.mul_mem_left _ (actualVertexSeries_spec MonomialOrder.degLex K a).1)
    have he : R=F-∑ a : actualInitialVertices MonomialOrder.degLex K,
        actualFormalQuotient MonomialOrder.degLex K F a*actualVertexSeries MonomialOrder.degLex K a := by
      apply eq_sub_iff_add_eq.mpr
      simpa only [add_comm] using (actual_formal_vertex_division MonomialOrder.degLex K F).symm
    have hr : R ∈ actualFormalWeightVanishing (actualCoordinateWeight A) q := by
      rw [he]
      exact (actualFormalWeightVanishing _ _).sub_mem hF
        (actualFormalCoordinateIdeal_pow_le_weightVanishing A q hs)
    have hz : R=0 := by
      apply MvPowerSeries.ext
      intro a
      rw [map_zero]
      by_cases ha : Finsupp.weight (actualCoordinateWeight A) a < q
      · exact hr a ha
      · exact actualFormalRemainder_coefficient_diagram MonomialOrder.degLex K F a
          ((mem_actualInitialDiagram_coordinate_power_iff MonomialOrder.degLex A q a).mpr (le_of_not_gt ha))
    have hdiv := actual_formal_vertex_division MonomialOrder.degLex K F
    change F=(∑ a : actualInitialVertices MonomialOrder.degLex K,
      actualFormalQuotient MonomialOrder.degLex K F a*actualVertexSeries MonomialOrder.degLex K a)+R at hdiv
    rw [hz,add_zero] at hdiv
    rw [hdiv]
    exact hs

/-- The genuine whole coordinate power equals its internally constructed ACTUAL coefficient ideal. -/
theorem actualFormalCoordinateIdeal_pow_eq_weightVanishing (A : Set (Fin n)) (q : ℕ) :
    actualFormalCoordinateIdeal n A ^ q=actualFormalWeightVanishing (actualCoordinateWeight A) q := by
  ext F
  exact mem_actualFormalCoordinateIdeal_pow_iff A q F

/-- SAME actual WHOLE division quotients have TRUE centre-power memberships under explicit actual vertex power compatibility. -/
theorem actual_formal_centre_power_whole_division (m : MonomialOrder (Fin n))
    (I : Ideal (MvPowerSeries (Fin n) ℂ)) (A : Set (Fin n)) (d : ℕ)
    (F : MvPowerSeries (Fin n) ℂ) (hI : F ∈ I) (hF : F ∈ actualFormalCoordinateIdeal n A ^ d)
    (hvertex : ∀ a : actualInitialVertices m I, actualVertexSeries m I a ∈
      actualFormalCoordinateIdeal n A ^ Finsupp.weight (actualCoordinateWeight A) (a : Fin n →₀ ℕ)) :
    F=∑ a : actualInitialVertices m I, actualFormalQuotient m I F a*actualVertexSeries m I a ∧
      ∀ a : actualInitialVertices m I, actualFormalQuotient m I F a ∈
        actualFormalCoordinateIdeal n A ^ (d-Finsupp.weight (actualCoordinateWeight A) (a : Fin n →₀ ℕ)) := by
  have hc := actual_formal_ideal_member_weighted_division m I (actualCoordinateWeight A) d F hI
    (fun a => (mem_actualFormalCoordinateIdeal_pow_iff A _ _).mp (hvertex a))
    ((mem_actualFormalCoordinateIdeal_pow_iff A d F).mp hF)
  refine ⟨hc.1,fun a => ?_⟩
  apply (mem_actualFormalCoordinateIdeal_pow_iff A _ _).mpr
  intro b hb
  by_contra hne
  exact (not_le_of_gt hb) (hc.2 a b hne)

end
end Hironaka.HironakaActualFormalCoordinatePowerDivision
