/-!
# Successive original tangent parameters on one fixed centre domain

Entire coordinate cuts retain equal original Hilbert–Samuel profiles under
successive regular symbols. Original constant-value centre geometry supplies
these symbols at every point of one chosen flattening and domain. The same
producer retains whole initial tangent stability, every coordinate-cut profile
and the existing original fibre profile on that domain. It does not assert
normal flatness.
-/

set_option autoImplicit false
open Set Filter Classical
open scoped Topology Manifold ContDiff

namespace Hironaka.HironakaActualNearbyTangentParameters

noncomputable section

open Hironaka.HolomorphicIdealSheaves HolGerm
  HironakaHolomorphicPointJets HironakaHolomorphicJetMonomialSpan
  HironakaHolomorphicJetChartInvariance
  HironakaActualHomogeneousInitialHS HironakaActualCoefficientPresentationCentrePower
  HironakaActualInitialCoordinateQuotient HironakaActualNearbyTangentClosure
  HironakaHolomorphicParameterValueConstancy HironakaHolomorphicRegularSymbolHilbertSamuel
  HironakaRelativeNormalIdeal HironakaRelativeNormalFibreHilbertSamuel
  HironakaRelativeNormalDeformationInitialRelations HironakaRelativeNormalCoherentTranslatedJets
  HironakaSmoothCentreCoherentDomain
  HironakaSmoothCentreNearbyStalks HironakaSmoothCentreNearbyIdeal
  HironakaSmoothCentreRealDomainActualAmbientHS

/-- Imposing no original coordinate leaves the entire ideal unchanged. -/
@[simp] theorem originalCoordinateCutIdeal_empty (n : ℕ)
    (I : Ideal (HolGerm (ComplexModel n))) :
    originalCoordinateCutIdeal n I ∅ = I := by
  simp [originalCoordinateCutIdeal]

/-- Inserting an original coordinate gives exactly the same entire ideal sum. -/
theorem originalCoordinateCutIdeal_insert (n : ℕ)
    (I : Ideal (HolGerm (ComplexModel n))) (T : Finset (Fin n)) (i : Fin n) :
    originalCoordinateCutIdeal n I (insert i T) =
      originalCoordinateCutIdeal n I T ⊔ Ideal.span {coordinateGerm i} := by
  simp only [originalCoordinateCutIdeal, Finset.coe_insert, Set.image_insert_eq,
    Ideal.span_insert]
  ac_rfl

/-- The entire original maximal ideal is generated by the original coordinate germs. -/
theorem maximalIdeal_eq_span_coordinateGerm (n : ℕ) :
    IsLocalRing.maximalIdeal (HolGerm (ComplexModel n)) =
      Ideal.span (Set.range (coordinateGerm : Fin n → HolGerm (ComplexModel n))) := by
  apply le_antisymm
  · intro g hg
    obtain ⟨h, he⟩ := exists_coordinate_decomposition g
    have hz := (HolGerm.mem_maximalIdeal_iff _).mp hg
    rw [hz, map_zero, zero_add] at he
    rw [he]
    exact Ideal.sum_mem _ fun i _ =>
      Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨i, rfl⟩)
  · apply Ideal.span_le.mpr
    rintro _ ⟨i, rfl⟩
    exact (HolGerm.mem_maximalIdeal_iff _).mpr rfl

/-- Actual tangent pullback sends a base coordinate to the identical ambient tangent coordinate. -/
theorem tangentPullback_coordinateGerm (d t : ℕ) (i : Fin d) :
    tangentPullback d t (coordinateGerm i) = coordinateGerm (i.castAdd t) := by
  unfold tangentPullback coordinateGerm
  rw [compAlgHom_mk]
  apply HolGerm.mk_eq_mk_iff.mpr
  exact Eventually.of_forall fun _ => rfl

/-- The whole original base-fibre ideal is generated by all original tangent coordinates. -/
theorem originalBaseMaximalIdeal_eq_span_tangent_coordinates (d t : ℕ) :
    originalBaseMaximalIdeal d t =
      Ideal.span (Set.range (fun i : Fin d => coordinateGerm (i.castAdd t))) := by
  rw [originalBaseMaximalIdeal, maximalIdeal_eq_span_coordinateGerm, Ideal.map_span,
    ← Set.range_comp]
  apply congrArg Ideal.span
  apply congrArg Set.range
  funext i
  exact tangentPullback_coordinateGerm d t i

/-- The full original tangent-coordinate cut is precisely addition of the whole base-fibre ideal. -/
theorem originalCoordinateCutIdeal_all_tangent (d t : ℕ)
    (I : Ideal (HolGerm (ComplexModel (d + t)))) :
    originalCoordinateCutIdeal (d + t) I
        (Finset.univ.filter (fun j : Fin (d + t) => j.val < d)) =
      I ⊔ originalBaseMaximalIdeal d t := by
  have hSet : (fun j : Fin (d + t) => coordinateGerm j) ''
      ((Finset.univ.filter (fun j : Fin (d + t) => j.val < d)) : Set (Fin (d + t))) =
      Set.range (fun i : Fin d => coordinateGerm (i.castAdd t)) := by
    ext g
    constructor
    · rintro ⟨j, hj, rfl⟩
      have hjd : j.val < d := (Finset.mem_filter.mp hj).2
      refine ⟨⟨j.val, hjd⟩, ?_⟩
      exact congrArg coordinateGerm (Fin.ext rfl)
    · rintro ⟨i, rfl⟩
      refine ⟨i.castAdd t, Finset.mem_filter.mpr ⟨Finset.mem_univ _, ?_⟩, rfl⟩
      simpa only [Fin.val_castAdd] using i.isLt
  rw [originalCoordinateCutIdeal, hSet,
    ← originalBaseMaximalIdeal_eq_span_tangent_coordinates]

/-- Entire original profiles remain equal after any finite set of stable coordinate cuts. -/
theorem hilbertSamuelValue_coordinate_cuts_eq_of_eq (n : ℕ)
    (I J : Ideal (HolGerm (ComplexModel n))) (T : Finset (Fin n))
    (hDI : ∀ i ∈ T, ∀ F ∈ actualHomogeneousInitialIdeal
      (Ideal.map (actualUnshiftedTaylorAlgHom n).toRingHom I),
      MvPowerSeries.pderiv ℂ i F ∈ actualHomogeneousInitialIdeal
        (Ideal.map (actualUnshiftedTaylorAlgHom n).toRingHom I))
    (hDJ : ∀ i ∈ T, ∀ F ∈ actualHomogeneousInitialIdeal
      (Ideal.map (actualUnshiftedTaylorAlgHom n).toRingHom J),
      MvPowerSeries.pderiv ℂ i F ∈ actualHomogeneousInitialIdeal
        (Ideal.map (actualUnshiftedTaylorAlgHom n).toRingHom J))
    (hvalue : ∀ q : ℕ, hilbertSamuelValue I q = hilbertSamuelValue J q)
    (q : ℕ) :
    hilbertSamuelValue (originalCoordinateCutIdeal n I T) q =
      hilbertSamuelValue (originalCoordinateCutIdeal n J T) q := by
  induction T using Finset.induction_on generalizing q with
  | empty => simpa only [originalCoordinateCutIdeal_empty] using hvalue q
  | @insert i T hi ih =>
    have hDIT : ∀ j ∈ T, ∀ F ∈ actualHomogeneousInitialIdeal
        (Ideal.map (actualUnshiftedTaylorAlgHom n).toRingHom I),
        MvPowerSeries.pderiv ℂ j F ∈ actualHomogeneousInitialIdeal
          (Ideal.map (actualUnshiftedTaylorAlgHom n).toRingHom I) :=
      fun j hj => hDI j (Finset.mem_insert_of_mem hj)
    have hDJT : ∀ j ∈ T, ∀ F ∈ actualHomogeneousInitialIdeal
        (Ideal.map (actualUnshiftedTaylorAlgHom n).toRingHom J),
        MvPowerSeries.pderiv ℂ j F ∈ actualHomogeneousInitialIdeal
          (Ideal.map (actualUnshiftedTaylorAlgHom n).toRingHom J) :=
      fun j hj => hDJ j (Finset.mem_insert_of_mem hj)
    have hEq : ∀ r : ℕ,
        hilbertSamuelValue (originalCoordinateCutIdeal n I T) r =
          hilbertSamuelValue (originalCoordinateCutIdeal n J T) r :=
      fun r => ih hDIT hDJT r
    have hv : coordinateGerm i ∈
        IsLocalRing.maximalIdeal (HolGerm (ComplexModel n)) :=
      (HolGerm.mem_maximalIdeal_iff _).mpr rfl
    have hI := original_regular_symbol_after_coordinate_cuts n I T i hi hDI
    have hJ := original_regular_symbol_after_coordinate_cuts n J T i hi hDJ
    simpa only [originalCoordinateCutIdeal_insert] using
      hilbertSamuelValue_parameter_eq_of_eq
        (originalCoordinateCutIdeal n I T) (originalCoordinateCutIdeal n J T)
        (coordinateGerm i) (coordinateGerm i) hv hv hI hJ hEq q

section OriginalCentre

variable {d t : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (ComplexModel (d + t)) M] [IsComplexManifold (d + t) M]

/-- Any fixed original flattening retains the original constant ambient values at actual plane points. -/
theorem hilbertSamuelValue_original_translated_plane_eq
    (C : Set M) (x : M) (A : GermIdeal (d + t) M) (hA : A.IsCoherent)
    (hhs : ∀ y ∈ C, ∀ ℓ : ℕ, hilbertSamuelAt A y ℓ = hilbertSamuelAt A x ℓ)
    (Φ : LocalHolomorphicEquivAt (chartAt (ComplexModel (d + t)) x x))
    (hsrc : Φ.source ⊆ (chartAt (ComplexModel (d + t)) x).target)
    (hflat : ∀ {y : M}, y ∈ (chartAt (ComplexModel (d + t)) x).source →
      chartAt (ComplexModel (d + t)) x y ∈ Φ.source →
      (y ∈ C ↔ Φ.toFun (chartAt (ComplexModel (d + t)) x y) ∈
        complexCoordinatePlane (d + t) d))
    (p : ComplexModel (d + t)) (hp : p ∈ Φ.target)
    (hPlane : p ∈ complexCoordinatePlane (d + t) d) (q : ℕ) :
    hilbertSamuelValue (originalCoherentOriginIdeal (actualTranslatedOriginalSheaf
      (actualFlattenedOriginalSheaf A x Φ) p)) q = hilbertSamuelAt A x q := by
  have hdom := actualNearbyPoint_mem_flatDomain x Φ hsrc p hp
  have hyC : actualFlatteningInverseMap x Φ p ∈ C := by
    apply (hflat hdom.1 hdom.2).mpr
    rw [actualNearbyPoint_chart_value x Φ hsrc p hp, Φ.right_inv p hp]
    exact hPlane
  have hValue : hilbertSamuelValue (originalCoherentOriginIdeal (actualTranslatedOriginalSheaf
      (actualFlattenedOriginalSheaf A x Φ) p)) q =
      hilbertSamuelAt A (actualFlatteningInverseMap x Φ p) q := by
    symm
    rw [hilbertSamuelAt_eq_fixedChart A x _
      (actualNearbyPoint_mem_chart_source x Φ hsrc p hp),
      fixed_real_original_whole_stalk_ambient_hs_dictionary A hA x Φ hsrc p hp q]
  exact hValue.trans (hhs _ hyC q)

/-- One original flattening retains whole initial stability, successive symbols and all cut/fibre profiles. -/
theorem exists_original_hs_constant_centre_nearby_parameter_profiles
    (C : Set M) (x : M) (hreg : RegularAtDim (n := d + t) C x d)
    (A : GermIdeal (d + t) M) (hA : A.IsCoherent)
    (hhs : ∀ y ∈ C, ∀ ℓ : ℕ, hilbertSamuelAt A y ℓ = hilbertSamuelAt A x ℓ) :
    ∃ Φ : LocalHolomorphicEquivAt (chartAt (ComplexModel (d + t)) x x),
      Φ.source ⊆ (chartAt (ComplexModel (d + t)) x).target ∧
      Φ.toFun (chartAt (ComplexModel (d + t)) x x) = 0 ∧
      (∀ {y : M}, y ∈ (chartAt (ComplexModel (d + t)) x).source →
        chartAt (ComplexModel (d + t)) x y ∈ Φ.source →
        (y ∈ C ↔ Φ.toFun (chartAt (ComplexModel (d + t)) x y) ∈
          complexCoordinatePlane (d + t) d)) ∧
      ∃ U : Set (ComplexModel (d + t)), IsOpen U ∧ 0 ∈ U ∧ U ⊆ Φ.target ∧
        let I0 := originalCoherentOriginIdeal (actualTranslatedOriginalSheaf
          (actualFlattenedOriginalSheaf A x Φ) 0)
        ∀ c : ComplexModel d, tangentInclusion d t c ∈ U →
          let Ic := originalCoherentOriginIdeal (actualTranslatedOriginalSheaf
            (actualFlattenedOriginalSheaf A x Φ) (tangentInclusion d t c))
          let Kc := Ideal.map (actualUnshiftedTaylorAlgHom (d + t)).toRingHom Ic
          (∀ (i : Fin d) (F : MvPowerSeries (Fin (d + t)) ℂ),
            F ∈ actualHomogeneousInitialIdeal Kc →
            MvPowerSeries.pderiv ℂ (i.castAdd t) F ∈ actualHomogeneousInitialIdeal Kc) ∧
          (∀ T : Finset (Fin (d + t)), (∀ j ∈ T, j.val < d) →
            (∀ q : ℕ, hilbertSamuelValue (originalCoordinateCutIdeal (d + t) Ic T) q =
              hilbertSamuelValue (originalCoordinateCutIdeal (d + t) I0 T) q) ∧
            ∀ i : Fin (d + t), i.val < d → i ∉ T →
              (∀ q : ℕ, ∀ b ∈ IsLocalRing.maximalIdeal (HolGerm (ComplexModel (d + t))) ^ q,
                coordinateGerm i * b ∈ originalCoordinateCutIdeal (d + t) Ic T ⊔
                  IsLocalRing.maximalIdeal (HolGerm (ComplexModel (d + t))) ^ (q + 2) →
                b ∈ originalCoordinateCutIdeal (d + t) Ic T ⊔
                  IsLocalRing.maximalIdeal (HolGerm (ComplexModel (d + t))) ^ (q + 1)) ∧
              (∀ q : ℕ, hilbertSamuelValue (originalCoordinateCutIdeal (d + t) Ic T ⊔
                  Ideal.span {coordinateGerm i}) (q + 1) +
                hilbertSamuelValue (originalCoordinateCutIdeal (d + t) Ic T) q =
                  hilbertSamuelValue (originalCoordinateCutIdeal (d + t) Ic T) (q + 1)) ∧
              (∀ q : ℕ, hilbertSamuelValue (originalCoordinateCutIdeal (d + t) Ic T) q =
                ∑ j ∈ Finset.range (q + 1),
                  hilbertSamuelValue (originalCoordinateCutIdeal (d + t) Ic T ⊔
                    Ideal.span {coordinateGerm i}) j)) ∧
          (∀ q : ℕ, hilbertSamuelValue (Ic ⊔ originalBaseMaximalIdeal d t) q =
            hilbertSamuelValue (I0 ⊔ originalBaseMaximalIdeal d t) q) := by
  obtain ⟨Φ, hsrc, h0, hflat, U, hU, h0U, hUT, hInitial⟩ :=
    exists_original_hs_constant_centre_nearby_initial_tangent_pderiv C x hreg A hA hhs
  refine ⟨Φ, hsrc, h0, hflat, U, hU, h0U, hUT, ?_⟩
  let I0 := originalCoherentOriginIdeal (actualTranslatedOriginalSheaf
    (actualFlattenedOriginalSheaf A x Φ) 0)
  dsimp only
  intro c hc
  let Ic := originalCoherentOriginIdeal (actualTranslatedOriginalSheaf
    (actualFlattenedOriginalSheaf A x Φ) (tangentInclusion d t c))
  have hc0 : tangentInclusion d t (0 : ComplexModel d) ∈ U := by
    simpa only [map_zero] using h0U
  have hDc (j : Fin (d + t)) (hj : j.val < d) :
      ∀ F ∈ actualHomogeneousInitialIdeal
        (Ideal.map (actualUnshiftedTaylorAlgHom (d + t)).toRingHom Ic),
        MvPowerSeries.pderiv ℂ j F ∈ actualHomogeneousInitialIdeal
          (Ideal.map (actualUnshiftedTaylorAlgHom (d + t)).toRingHom Ic) := by
    let k : Fin d := ⟨j.val, hj⟩
    have he : k.castAdd t = j := Fin.ext rfl
    intro F hF
    simpa only [he] using hInitial c hc k F hF
  have hD0 (j : Fin (d + t)) (hj : j.val < d) :
      ∀ F ∈ actualHomogeneousInitialIdeal
        (Ideal.map (actualUnshiftedTaylorAlgHom (d + t)).toRingHom I0),
        MvPowerSeries.pderiv ℂ j F ∈ actualHomogeneousInitialIdeal
          (Ideal.map (actualUnshiftedTaylorAlgHom (d + t)).toRingHom I0) := by
    let k : Fin d := ⟨j.val, hj⟩
    have he : k.castAdd t = j := Fin.ext rfl
    intro F hF
    have hInit0 := hInitial (0 : ComplexModel d) hc0 k
    simp only [map_zero] at hInit0
    simpa only [he] using hInit0 F hF
  have hvalue : ∀ q : ℕ, hilbertSamuelValue Ic q = hilbertSamuelValue I0 q := by
    intro q
    have hPlane0 : (0 : ComplexModel (d + t)) ∈ complexCoordinatePlane (d + t) d := by
      simpa only [map_zero] using tangentInclusion_mem_plane d t (0 : ComplexModel d)
    exact (hilbertSamuelValue_original_translated_plane_eq C x A hA hhs Φ hsrc hflat
      (tangentInclusion d t c) (hUT hc) (tangentInclusion_mem_plane d t c) q).trans
        (hilbertSamuelValue_original_translated_plane_eq C x A hA hhs Φ hsrc hflat
          0 (hUT h0U) hPlane0 q).symm
  refine ⟨hInitial c hc, ?_, ?_⟩
  · intro T hT
    refine ⟨fun q => hilbertSamuelValue_coordinate_cuts_eq_of_eq (d + t) Ic I0 T
      (fun j hj => hDc j (hT j hj)) (fun j hj => hD0 j (hT j hj)) hvalue q, ?_⟩
    intro i hit hi
    have hD : ∀ j ∈ insert i T, ∀ F ∈ actualHomogeneousInitialIdeal
        (Ideal.map (actualUnshiftedTaylorAlgHom (d + t)).toRingHom Ic),
        MvPowerSeries.pderiv ℂ j F ∈ actualHomogeneousInitialIdeal
          (Ideal.map (actualUnshiftedTaylorAlgHom (d + t)).toRingHom Ic) := by
      intro j hj
      rcases Finset.mem_insert.mp hj with hji | hj
      · subst j
        exact hDc i hit
      · exact hDc j (hT j hj)
    have hRegular := original_regular_symbol_after_coordinate_cuts (d + t) Ic T i hi hD
    have hv : coordinateGerm i ∈
        IsLocalRing.maximalIdeal (HolGerm (ComplexModel (d + t))) :=
      (HolGerm.mem_maximalIdeal_iff _).mpr rfl
    refine ⟨hRegular, ?_, ?_⟩
    · intro q
      exact hilbertSamuelValue_parameter_recurrence _ _ hv hRegular q
    · intro q
      exact hilbertSamuelValue_eq_sum_parameter _ _ hv hRegular q
  · intro q
    have hEq := hilbertSamuelValue_coordinate_cuts_eq_of_eq (d + t) Ic I0
      (Finset.univ.filter (fun j : Fin (d + t) => j.val < d))
      (fun j hj => hDc j (Finset.mem_filter.mp hj).2)
      (fun j hj => hD0 j (Finset.mem_filter.mp hj).2) hvalue q
    simpa only [originalCoordinateCutIdeal_all_tangent] using hEq

/-- Whole initial tangent stability and original fibre constancy hold jointly on the same domain. -/
theorem exists_original_hs_constant_centre_nearby_fibre_profiles
    (C : Set M) (x : M) (hreg : RegularAtDim (n := d + t) C x d)
    (A : GermIdeal (d + t) M) (hA : A.IsCoherent)
    (hhs : ∀ y ∈ C, ∀ ℓ : ℕ, hilbertSamuelAt A y ℓ = hilbertSamuelAt A x ℓ) :
    ∃ Φ : LocalHolomorphicEquivAt (chartAt (ComplexModel (d + t)) x x),
      Φ.source ⊆ (chartAt (ComplexModel (d + t)) x).target ∧
      Φ.toFun (chartAt (ComplexModel (d + t)) x x) = 0 ∧
      (∀ {y : M}, y ∈ (chartAt (ComplexModel (d + t)) x).source →
        chartAt (ComplexModel (d + t)) x y ∈ Φ.source →
        (y ∈ C ↔ Φ.toFun (chartAt (ComplexModel (d + t)) x y) ∈
          complexCoordinatePlane (d + t) d)) ∧
      ∃ U : Set (ComplexModel (d + t)), IsOpen U ∧ 0 ∈ U ∧ U ⊆ Φ.target ∧
        let I0 := originalCoherentOriginIdeal (actualTranslatedOriginalSheaf
          (actualFlattenedOriginalSheaf A x Φ) 0)
        ∀ c : ComplexModel d, tangentInclusion d t c ∈ U →
          let Ic := originalCoherentOriginIdeal (actualTranslatedOriginalSheaf
            (actualFlattenedOriginalSheaf A x Φ) (tangentInclusion d t c))
          let Kc := Ideal.map (actualUnshiftedTaylorAlgHom (d + t)).toRingHom Ic
          (∀ (i : Fin d) (F : MvPowerSeries (Fin (d + t)) ℂ),
            F ∈ actualHomogeneousInitialIdeal Kc →
            MvPowerSeries.pderiv ℂ (i.castAdd t) F ∈ actualHomogeneousInitialIdeal Kc) ∧
          (∀ q : ℕ, hilbertSamuelValue (Ic ⊔ originalBaseMaximalIdeal d t) q =
            hilbertSamuelValue (I0 ⊔ originalBaseMaximalIdeal d t) q) := by
  obtain ⟨Φ, hsrc, h0, hflat, U, hU, h0U, hUT, hParams⟩ :=
    exists_original_hs_constant_centre_nearby_parameter_profiles C x hreg A hA hhs
  refine ⟨Φ, hsrc, h0, hflat, U, hU, h0U, hUT, ?_⟩
  dsimp only
  intro c hc
  exact ⟨(hParams c hc).1, (hParams c hc).2.2⟩

end OriginalCentre

end

end Hironaka.HironakaActualNearbyTangentParameters
