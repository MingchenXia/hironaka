import Hironaka.Invariant.CompanionOpen
import Hironaka.MarkedIdeal.GeoTransformWellFormed

set_option autoImplicit false
set_option linter.unusedSectionVars false

/-!
# The companion ideal under one admissible blowup: the monomial part transforms exactly (G8C lane, run 0080; (B') P5, E4c)

Blueprint: `hironaka-g8-e4c-monomial-step.tex`.  Plan: `work/hironaka-resume-20261111/G11B/BPRIME-PLAN.md` §2 (P5, E4c);
lane G8 `REPORT-r4.md` (section "P5 E4c": the missing ideal-level identity).  Sources: Bierstone--Milman 2008 §5 (the
monomial part `𝓜(𝓘)`, the nonmonomial part `𝓝(𝓘)`, the companion ideal, Step II.B and its transforms); Włodarczyk 2005,
Step 2a of `pr:resol`.

Let `𝔪 = (X, N, E, 𝔞, d)` be well formed with `𝔞` nonzero along `N` (`n > 0`), `o ≥ 1`, and `ord(𝓝_N(𝔞)|_N) ≤ o` on
`cosupp 𝔪`.  The companion ideal is `𝓞(𝔪, o) = (N, E, 𝓝, o) + (N, E, 𝓜, d - o)` (`o < d`), resp. `(N, E, 𝓝, o)`
(`o ≥ d`).  The library knows that along a test tower of `𝓞(𝔪, o)` the nonmonomial part transforms exactly
(`NonmonomialTransformAlong.nonmonomialPart_geoTransformAlong_along`) and the cosupports of the companion; it did not
state the identity of the monomial parts.  Here, for ONE admissible blowup `π` along a centre `C` of `𝓞(𝔪, o)`, with
`𝔪' = 𝔪.geoTransform C π`:

* `companion_step_facts`: `C` is admissible for `𝔪`, for `(N, E, 𝓝, o)`, for `(N, E, 𝓝𝓜, d)` and for `(N, E, 𝓜, d - o)`;
* **`restrictEquiv_monomial_geoTransform`** (the monomial part transforms exactly, `o < d`):
  `(N, E, 𝓜_N(𝔞), d - o)' ≃ (N', E', 𝓜_{N'}(𝔞'), d - o)` (restricted equivalence on `N'`).  On `N` the monomial part is
  generated by `∏ u_i^{e_i}`; its pullback is `u_D^{Σ_{C ⊆ E_i} e_i} ∏ (u_i')^{e_i}` and its transform with mark `d - o`
  has exceptional exponent `Σ_{C ⊆ E_i} e_i - (d - o) = ord_C 𝔞 - d` (as `ord_C 𝓝 = o` on the centre), which is the
  exponent of `𝔞'` along the exceptional divisor; the proof is the uniqueness of the monomial factor along `N'`
  (`NonmonomialStepAlong.step_along`: `Res_{N'} 𝔞' = Res_{N'} (𝓝' · 𝓜'')` with `𝓜''` principal monomial and `𝓝'` in no
  member ideal; `NonmonomialTransformAlong.monomialPartAlong_eq_of_factor`; `𝓜''` is monomial along `N'`);
* `restrictEquiv_nonmonomial_geoTransform`: `(N, E, 𝓝_N(𝔞), o)' ≃ (N', E', 𝓝_{N'}(𝔞'), o)`;
* `RestrictEquiv.add`: restricted equivalence is a congruence for the sum of marked ideals;
* **`restrictEquiv_companionOf_geoTransform`**: `𝓞(𝔪, o)' ≃ 𝓞(𝔪', o)` — the companion ideal commutes with one admissible
  blowup up to restricted equivalence;
* `bound_geoTransform`: `ord(𝓝_{N'}(𝔞')|_{N'}) ≤ o` on `cosupp 𝔪'`.

Sorry-free.  Universe-polymorphic.  Import discipline (Hironaka phase): no import of `Hironaka.RelativePrincipalization`
or `Hironaka.EmbeddedResolution`.
-/

open Set Filter
open scoped Topology Manifold ContDiff

universe u

namespace Hironaka.HironakaG8E4cMonomialStep

open Hironaka.HolomorphicIdealSheaves Hironaka.BlowupSequences
open Hironaka.BlowupTowers Hironaka.MarkedIdeals
  Hironaka.MarkedIdeals.MarkedIdeal Hironaka.GermIdealOrder
  Hironaka.IdealWeightPowers Hironaka.DivisorExponentAlong
  Hironaka.MonomialPartAlong Hironaka.CompanionReductionAlong
  Hironaka.MarkedIdealOperationsAlong.MarkedIdeal
  Hironaka.RelativePrincipalizationSpan Hironaka.RestrictedIdealWeight
  Hironaka.RestrictedIdealExtension
open Hironaka.CompanionRebase (companionOf)
open Hironaka.MarkedIdealOperationsTransform.MarkedIdeal (add)

noncomputable section

variable {n : ℕ}

/-! ### Restricted equivalence and sums -/

section Add

variable {M : Type u} [TopologicalSpace M] [ChartedSpace (ComplexModel n) M] [IsComplexManifold n M]

/-- Restricted equivalence is transitive. -/
theorem RestrictEquiv.trans' {𝔪 𝔫 𝔬 : MarkedIdeal n M} (h₁ : RestrictEquiv 𝔪 𝔫) (h₂ : RestrictEquiv 𝔫 𝔬) :
    RestrictEquiv 𝔪 𝔬 where
  N_eq := h₁.N_eq.trans h₂.N_eq
  E_eq := h₁.E_eq.trans h₂.E_eq
  d_eq := h₁.d_eq.trans h₂.d_eq
  le := RestrictLeCalculus.RestrictLe.trans h₁.le (by rw [h₁.N_eq]; exact h₂.le)
  ge := RestrictLeCalculus.RestrictLe.trans (by rw [h₁.N_eq]; exact h₂.ge) h₁.ge

/-- Restricted equivalence is symmetric. -/
theorem RestrictEquiv.symm' {𝔪 𝔫 : MarkedIdeal n M} (h : RestrictEquiv 𝔪 𝔫) : RestrictEquiv 𝔫 𝔪 where
  N_eq := h.N_eq.symm
  E_eq := h.E_eq.symm
  d_eq := h.d_eq.symm
  le := by rw [← h.N_eq]; exact h.ge
  ge := by rw [← h.N_eq]; exact h.le

/-- **Restricted equivalence is a congruence for the sum of marked ideals** (summands on the same `N`, the targets
coherent). -/
theorem RestrictEquiv.add {𝔪₁ 𝔪₂ 𝔫₁ 𝔫₂ : MarkedIdeal n M} (h₁ : RestrictEquiv 𝔪₁ 𝔫₁) (h₂ : RestrictEquiv 𝔪₂ 𝔫₂)
    (hN : 𝔪₂.N = 𝔪₁.N) (h𝔫₁ : 𝔫₁.ideal.IsCoherent) (h𝔫₂ : 𝔫₂.ideal.IsCoherent)
    (h𝔪₁ : 𝔪₁.ideal.IsCoherent) (h𝔪₂ : 𝔪₂.ideal.IsCoherent) :
    RestrictEquiv (add 𝔪₁ 𝔪₂) (add 𝔫₁ 𝔫₂) := by
  have hol : ∀ {𝔠 : GermIdeal n M}, 𝔠.IsCoherent → ∀ x g, 𝔠.mem x g → HolomorphicAt n g x :=
    fun h _ _ hg => GermIdeal.IsCoherent.holomorphicAt_mem h hg
  have hle₂ : RestrictLe 𝔪₁.N 𝔪₂.ideal 𝔫₂.ideal := hN ▸ h₂.le
  have hge₂ : RestrictLe 𝔪₁.N 𝔫₂.ideal 𝔪₂.ideal := hN ▸ h₂.ge
  refine ⟨h₁.N_eq, h₁.E_eq, ?_, ?_, ?_⟩
  · show 𝔪₁.d * 𝔪₂.d = 𝔫₁.d * 𝔫₂.d
    rw [h₁.d_eq, h₂.d_eq]
  · show RestrictLe 𝔪₁.N (sumIdeal (idealPow 𝔪₁.ideal 𝔪₂.d) (idealPow 𝔪₂.ideal 𝔪₁.d))
      (sumIdeal (idealPow 𝔫₁.ideal 𝔫₂.d) (idealPow 𝔫₂.ideal 𝔫₁.d))
    rw [← h₁.d_eq, ← h₂.d_eq]
    exact MarkedIdealOperationsAlong.restrictLe_sumIdeal (fun _ _ hg => holomorphicAt_of_mem_idealPow hg)
      (fun _ _ hg => holomorphicAt_of_mem_idealPow hg)
      (MarkedIdealOperationsAlong.restrictLe_idealPow (hol h𝔫₁) h₁.le _)
      (MarkedIdealOperationsAlong.restrictLe_idealPow (hol h𝔫₂) hle₂ _)
  · show RestrictLe 𝔪₁.N (sumIdeal (idealPow 𝔫₁.ideal 𝔫₂.d) (idealPow 𝔫₂.ideal 𝔫₁.d))
      (sumIdeal (idealPow 𝔪₁.ideal 𝔪₂.d) (idealPow 𝔪₂.ideal 𝔪₁.d))
    rw [← h₁.d_eq, ← h₂.d_eq]
    exact MarkedIdealOperationsAlong.restrictLe_sumIdeal (fun _ _ hg => holomorphicAt_of_mem_idealPow hg)
      (fun _ _ hg => holomorphicAt_of_mem_idealPow hg)
      (MarkedIdealOperationsAlong.restrictLe_idealPow (hol h𝔪₁) h₁.ge _)
      (MarkedIdealOperationsAlong.restrictLe_idealPow (hol h𝔪₂) hge₂ _)

end Add

/-! ### One admissible blowup of the companion ideal -/

section Step

variable {X Y : CMfd.{u} n} {C : Set X} {π : Y → X}

/-- **The admissibility facts of one test blowup of the companion ideal**: the centre is admissible for `𝔪`, for
`(N, E, 𝓝, o)`, for `(N, E, 𝓝𝓜, d)` and for `(N, E, 𝓜, d - o)`, and `ord(𝓝|_N) ≤ o` on it. -/
theorem companion_step_facts (hn : 0 < n) {𝔪 : MarkedIdeal n X} (h𝔪 : 𝔪.IsWellFormed)
    (hne : ∀ y ∈ 𝔪.N, IsNonzeroAlongAt 𝔪.N 𝔪.ideal y) {o : ℕ} (ho : 1 ≤ o)
    (hbound : ∀ x ∈ 𝔪.cosupp, x ∉ cosupport n 𝔪.N (nonmonomialPartAlong n 𝔪.N 𝔪.ideal 𝔪.E) (o + 1))
    (hπ : IsBlowupAlong n C π) (hC : (companionOf n 𝔪 o).IsAdmissibleCentre C) :
    𝔪.IsAdmissibleCentre C ∧
      (⟨𝔪.N, 𝔪.E, nonmonomialPartAlong n 𝔪.N 𝔪.ideal 𝔪.E, o⟩ : MarkedIdeal n X).IsAdmissibleCentre C ∧
      (⟨𝔪.N, 𝔪.E, (nonmonomialPartAlong n 𝔪.N 𝔪.ideal 𝔪.E).mul (monomialPartAlong n 𝔪.N 𝔪.ideal 𝔪.E), 𝔪.d⟩ :
        MarkedIdeal n X).IsAdmissibleCentre C ∧
      (⟨𝔪.N, 𝔪.E, monomialPartAlong n 𝔪.N 𝔪.ideal 𝔪.E, 𝔪.d - o⟩ : MarkedIdeal n X).IsAdmissibleCentre C ∧
      ∀ x ∈ C, x ∉ cosupport n 𝔪.N (nonmonomialPartAlong n 𝔪.N 𝔪.ideal 𝔪.E) (o + 1) := by
  have hN := h𝔪.isClosedSubmanifold_N
  have h𝓝 := isCoherent_nonmonomialPartAlong hn hN h𝔪.isSNCDivisor h𝔪.isTransverse h𝔪.isCoherent hne
  have h𝓜 := isCoherent_monomialPartAlong hn hN h𝔪.isSNCDivisor h𝔪.isTransverse h𝔪.isCoherent hne
  have hT : IsGeoTestTower (companionOf n 𝔪 o) (.step .refl C π hπ) :=
    (isGeoTestTower_step_iff _ _ C π hπ).mpr ⟨trivial, hC⟩
  obtain ⟨hT𝔪, hT𝔫, -, -⟩ := CompanionOpen.companionOf_reduction hn h𝔪 hne ho hbound _ hT
  obtain ⟨-, hC𝔪⟩ := (isGeoTestTower_step_iff _ _ C π hπ).mp hT𝔪
  obtain ⟨-, hC𝔫⟩ := (isGeoTestTower_step_iff _ _ C π hπ).mp hT𝔫
  have hC𝔪' : 𝔪.IsAdmissibleCentre C := hC𝔪
  have hC𝔫' : (⟨𝔪.N, 𝔪.E, nonmonomialPartAlong n 𝔪.N 𝔪.ideal 𝔪.E, o⟩ : MarkedIdeal n X).IsAdmissibleCentre C := hC𝔫
  have hbd : ∀ x ∈ C, x ∉ cosupport n 𝔪.N (nonmonomialPartAlong n 𝔪.N 𝔪.ideal 𝔪.E) (o + 1) :=
    fun x hx => hbound x (hC𝔪'.2.1 hx)
  have hCa : C ⊆ cosupport n 𝔪.N
      ((nonmonomialPartAlong n 𝔪.N 𝔪.ideal 𝔪.E).mul (monomialPartAlong n 𝔪.N 𝔪.ideal 𝔪.E)) 𝔪.d := by
    rw [CompanionOpen.cosupport_mul_parts hn h𝔪 hne]
    exact hC𝔪'.2.1
  have hCM : C ⊆ cosupport n 𝔪.N (monomialPartAlong n 𝔪.N 𝔪.ideal 𝔪.E) (𝔪.d - o) := by
    intro x hx
    by_cases hod : o ≤ 𝔪.d
    · exact CompanionReductionAlong.mem_cosupport_of_mem_cosupport_mul_along hN.2
        (fun _ _ hg => GermIdeal.IsCoherent.holomorphicAt_mem h𝓝 hg)
        (fun _ _ hg => GermIdeal.IsCoherent.holomorphicAt_mem h𝓜 hg) hod (hCa hx) (hbd x hx)
    · rw [show 𝔪.d - o = 0 by omega,
        cosupport_zero (fun _ _ hg => GermIdeal.IsCoherent.holomorphicAt_mem h𝓜 hg)]
      exact hC𝔪'.subset_N hx
  exact ⟨hC𝔪', hC𝔫', ⟨hπ.1, hCa, hC𝔪'.2.2⟩, ⟨hπ.1, hCM, hC𝔪'.2.2⟩, hbd⟩

/-- **The monomial part of the companion transforms exactly** (`o < d`): for one test blowup of `𝓞(𝔪, o)`,
`(N, E, 𝓜_N(𝔞), d - o)' ≃ (N', E', 𝓜_{N'}(𝔞'), d - o)`.  The exceptional exponent of `𝓜_{N'}(𝔞')` is
`Σ_{C ⊆ E_i} e_i - (d - o) = ord_C 𝔞 - d`. -/
theorem restrictEquiv_monomial_geoTransform (hn : 0 < n) {𝔪 : MarkedIdeal n X} (h𝔪 : 𝔪.IsWellFormed)
    (hne : ∀ y ∈ 𝔪.N, IsNonzeroAlongAt 𝔪.N 𝔪.ideal y) {o : ℕ} (ho : 1 ≤ o) (hod : o < 𝔪.d)
    (hbound : ∀ x ∈ 𝔪.cosupp, x ∉ cosupport n 𝔪.N (nonmonomialPartAlong n 𝔪.N 𝔪.ideal 𝔪.E) (o + 1))
    (hπ : IsBlowupAlong n C π) (hC : (companionOf n 𝔪 o).IsAdmissibleCentre C) :
    RestrictEquiv ((⟨𝔪.N, 𝔪.E, monomialPartAlong n 𝔪.N 𝔪.ideal 𝔪.E, 𝔪.d - o⟩ : MarkedIdeal n X).geoTransform C π)
      ⟨(𝔪.geoTransform C π).N, (𝔪.geoTransform C π).E,
        monomialPartAlong n (𝔪.geoTransform C π).N (𝔪.geoTransform C π).ideal (𝔪.geoTransform C π).E, 𝔪.d - o⟩ := by
  have hN := h𝔪.isClosedSubmanifold_N
  obtain ⟨h𝓝, h𝓜, hne𝓜, hmono, hnd, hnz, hREq⟩ := NonmonomialTransformAlong.parts_hypotheses hn 𝔪 h𝔪 hne
  obtain ⟨hC𝔪, hC𝔫, hCa, hCM, hbd⟩ := companion_step_facts hn h𝔪 hne ho hbound hπ hC
  obtain ⟨h𝓜', f1, f2, hprinc, hnd', -⟩ := NonmonomialStepAlong.step_along hn hπ hN h𝔪.isSNCDivisor
    h𝔪.isTransverse h𝓝 h𝓜 hne𝓜 hmono hnd hnz hC𝔪.2.2 hC𝔫.2.1 hCa.2.1 hbd
  have heq : 𝔪.geoTransform C π = (⟨𝔪.N, 𝔪.E, (nonmonomialPartAlong n 𝔪.N 𝔪.ideal 𝔪.E).mul
      (monomialPartAlong n 𝔪.N 𝔪.ideal 𝔪.E), 𝔪.d⟩ : MarkedIdeal n X).geoTransform C π :=
    hREq.geoTransform_eq hN.1 h𝔪.isCoherent (isCoherent_mul h𝓝 h𝓜) hπ.contMDiff
  have hwf' := GeoTransformWellFormed.isWellFormed_geoTransform_of_isAdmissibleCentre h𝔪 hC𝔪 hπ
  have h𝔟' := HadamardBridgeAlong.isCoherent_geoTransform_ideal_of_isAdmissibleCentre
    (𝔪 := ⟨𝔪.N, 𝔪.E, nonmonomialPartAlong n 𝔪.N 𝔪.ideal 𝔪.E, o⟩) hN h𝓝 hC𝔫 hπ
  have h𝓜'' := HadamardBridgeAlong.isCoherent_geoTransform_ideal_of_isAdmissibleCentre
    (𝔪 := ⟨𝔪.N, 𝔪.E, monomialPartAlong n 𝔪.N 𝔪.ideal 𝔪.E, 𝔪.d - o⟩) hN h𝓜 hCM hπ
  -- the monomial factor is the transform of `(N, E, 𝓜, d - o)` (`o - d = 0`)
  have hfac : NonmonomialStepAlong.monomialFactor n π C 𝔪.N 𝔪.E (monomialPartAlong n 𝔪.N 𝔪.ideal 𝔪.E) o 𝔪.d =
      ((⟨𝔪.N, 𝔪.E, monomialPartAlong n 𝔪.N 𝔪.ideal 𝔪.E, 𝔪.d - o⟩ : MarkedIdeal n X).geoTransform C π).ideal := by
    unfold NonmonomialStepAlong.monomialFactor
    rw [show o - 𝔪.d = 0 by omega, idealPow_zero, BlowupControlledTransform.unitIdeal_mul h𝓜'']
  rw [hfac] at h𝓜' f1 f2 hprinc
  rw [← heq] at f1 f2
  obtain ⟨-, hmono'⟩ := MonomialCaseAlong.isNonzeroAlongAt_and_isMonomialAlong_of_principal hn
    hwf'.isClosedSubmanifold_N hwf'.isSNCDivisor hwf'.isTransverse h𝓜'
    fun x hx => (hprinc x hx).choose_spec.isPrincipalMonomialAlongAt
  have heqM := NonmonomialTransformAlong.monomialPartAlong_eq_of_factor hn hwf'.isClosedSubmanifold_N
    hwf'.isSNCDivisor hwf'.isTransverse h𝔟' h𝓜' hnd' f1 f2
  refine ⟨rfl, rfl, rfl, ?_, ?_⟩
  · show RestrictLe (𝔪.geoTransform C π).N
      ((⟨𝔪.N, 𝔪.E, monomialPartAlong n 𝔪.N 𝔪.ideal 𝔪.E, 𝔪.d - o⟩ : MarkedIdeal n X).geoTransform C π).ideal
      (monomialPartAlong n (𝔪.geoTransform C π).N (𝔪.geoTransform C π).ideal (𝔪.geoTransform C π).E)
    rw [heqM]
    have hle := le_monomialPartAlong hn hwf'.isSNCDivisor hwf'.isTransverse h𝓜'
    exact fun z _ f hf => IsInSpanAt.restrict (InvertibleIdealQuotient.isInSpanAt_self (hle z f hf)
      (GermIdeal.IsCoherent.holomorphicAt_mem h𝓜'' hf))
  · show RestrictLe (𝔪.geoTransform C π).N
      (monomialPartAlong n (𝔪.geoTransform C π).N (𝔪.geoTransform C π).ideal (𝔪.geoTransform C π).E)
      ((⟨𝔪.N, 𝔪.E, monomialPartAlong n 𝔪.N 𝔪.ideal 𝔪.E, 𝔪.d - o⟩ : MarkedIdeal n X).geoTransform C π).ideal
    rw [heqM]
    exact hmono'

/-- **The nonmonomial part of the companion transforms exactly**: for one test blowup of `𝓞(𝔪, o)`,
`(N, E, 𝓝_N(𝔞), o)' ≃ (N', E', 𝓝_{N'}(𝔞'), o)`, and `ord(𝓝_{N'}(𝔞')|_{N'}) ≤ o` on `cosupp 𝔪'`
(`NonmonomialTransformAlong.nonmonomialPart_geoTransformAlong_along` for the one-step tower). -/
theorem restrictEquiv_nonmonomial_geoTransform (hn : 0 < n) {𝔪 : MarkedIdeal n X} (h𝔪 : 𝔪.IsWellFormed)
    (hne : ∀ y ∈ 𝔪.N, IsNonzeroAlongAt 𝔪.N 𝔪.ideal y) {o : ℕ} (ho : 1 ≤ o)
    (hbound : ∀ x ∈ 𝔪.cosupp, x ∉ cosupport n 𝔪.N (nonmonomialPartAlong n 𝔪.N 𝔪.ideal 𝔪.E) (o + 1))
    (hπ : IsBlowupAlong n C π) (hC : (companionOf n 𝔪 o).IsAdmissibleCentre C) :
    RestrictEquiv ((⟨𝔪.N, 𝔪.E, nonmonomialPartAlong n 𝔪.N 𝔪.ideal 𝔪.E, o⟩ : MarkedIdeal n X).geoTransform C π)
        ⟨(𝔪.geoTransform C π).N, (𝔪.geoTransform C π).E,
          nonmonomialPartAlong n (𝔪.geoTransform C π).N (𝔪.geoTransform C π).ideal (𝔪.geoTransform C π).E, o⟩ ∧
      ∀ z ∈ (𝔪.geoTransform C π).cosupp, z ∉ cosupport n (𝔪.geoTransform C π).N
        (nonmonomialPartAlong n (𝔪.geoTransform C π).N (𝔪.geoTransform C π).ideal (𝔪.geoTransform C π).E) (o + 1) := by
  have hT : IsGeoTestTower (companionOf n 𝔪 o) (.step .refl C π hπ) :=
    (isGeoTestTower_step_iff _ _ C π hπ).mpr ⟨trivial, hC⟩
  obtain ⟨-, -, -, hcoh, hle, hR, -, hb⟩ :=
    NonmonomialTransformAlong.nonmonomialPart_geoTransformAlong_along hn 𝔪 h𝔪 hne ho hbound _ hT
  refine ⟨⟨rfl, rfl, rfl, ?_, hR⟩, hb⟩
  exact fun z _ f hf => IsInSpanAt.restrict (InvertibleIdealQuotient.isInSpanAt_self (hle z f hf)
    (GermIdeal.IsCoherent.holomorphicAt_mem hcoh hf))

/-- **The companion ideal commutes with one admissible blowup** up to restricted equivalence:
`𝓞(𝔪, o)' ≃ 𝓞(𝔪', o)` for a test blowup of `𝓞(𝔪, o)` (`ord(𝓝|_N) ≤ o` on `cosupp 𝔪`, `o ≥ 1`). -/
theorem restrictEquiv_companionOf_geoTransform (hn : 0 < n) {𝔪 : MarkedIdeal n X} (h𝔪 : 𝔪.IsWellFormed)
    (hne : ∀ y ∈ 𝔪.N, IsNonzeroAlongAt 𝔪.N 𝔪.ideal y) {o : ℕ} (ho : 1 ≤ o)
    (hbound : ∀ x ∈ 𝔪.cosupp, x ∉ cosupport n 𝔪.N (nonmonomialPartAlong n 𝔪.N 𝔪.ideal 𝔪.E) (o + 1))
    (hπ : IsBlowupAlong n C π) (hC : (companionOf n 𝔪 o).IsAdmissibleCentre C) :
    RestrictEquiv ((companionOf n 𝔪 o).geoTransform C π) (companionOf n (𝔪.geoTransform C π) o) := by
  have hN := h𝔪.isClosedSubmanifold_N
  obtain ⟨h𝓝, h𝓜, -, -, -, -, -⟩ := NonmonomialTransformAlong.parts_hypotheses hn 𝔪 h𝔪 hne
  have hwf' := GeoTransformWellFormed.isWellFormed_geoTransform_of_isAdmissibleCentre h𝔪
    (companion_step_facts hn h𝔪 hne ho hbound hπ hC).1 hπ
  obtain ⟨hNN, -⟩ := restrictEquiv_nonmonomial_geoTransform hn h𝔪 hne ho hbound hπ hC
  obtain ⟨-, hC𝔫, -, hCM, -⟩ := companion_step_facts hn h𝔪 hne ho hbound hπ hC
  have hne' : ∀ y ∈ (𝔪.geoTransform C π).N,
      IsNonzeroAlongAt (𝔪.geoTransform C π).N (𝔪.geoTransform C π).ideal y := by
    exact InvDomainTowerAlong.isNonzeroAlongAt_geoTransform_of_isAdmissibleCentre hπ 𝔪 hN h𝔪.isCoherent
      (companion_step_facts hn h𝔪 hne ho hbound hπ hC).1 hne
  have h𝓝' := isCoherent_nonmonomialPartAlong hn hwf'.isClosedSubmanifold_N hwf'.isSNCDivisor
    hwf'.isTransverse hwf'.isCoherent hne'
  have h𝓜' := isCoherent_monomialPartAlong hn hwf'.isClosedSubmanifold_N hwf'.isSNCDivisor
    hwf'.isTransverse hwf'.isCoherent hne'
  have h𝔟' := HadamardBridgeAlong.isCoherent_geoTransform_ideal_of_isAdmissibleCentre
    (𝔪 := ⟨𝔪.N, 𝔪.E, nonmonomialPartAlong n 𝔪.N 𝔪.ideal 𝔪.E, o⟩) hN h𝓝 hC𝔫 hπ
  by_cases hod : o < 𝔪.d
  · have hc : companionOf n 𝔪 o = add ⟨𝔪.N, 𝔪.E, nonmonomialPartAlong n 𝔪.N 𝔪.ideal 𝔪.E, o⟩
        ⟨𝔪.N, 𝔪.E, monomialPartAlong n 𝔪.N 𝔪.ideal 𝔪.E, 𝔪.d - o⟩ := if_pos hod
    have hc' : companionOf n (𝔪.geoTransform C π) o =
        add ⟨(𝔪.geoTransform C π).N, (𝔪.geoTransform C π).E,
          nonmonomialPartAlong n (𝔪.geoTransform C π).N (𝔪.geoTransform C π).ideal (𝔪.geoTransform C π).E, o⟩
        ⟨(𝔪.geoTransform C π).N, (𝔪.geoTransform C π).E,
          monomialPartAlong n (𝔪.geoTransform C π).N (𝔪.geoTransform C π).ideal (𝔪.geoTransform C π).E, 𝔪.d - o⟩ :=
      if_pos hod
    have hM := restrictEquiv_monomial_geoTransform hn h𝔪 hne ho hod hbound hπ hC
    have h𝓜'' := HadamardBridgeAlong.isCoherent_geoTransform_ideal_of_isAdmissibleCentre
      (𝔪 := ⟨𝔪.N, 𝔪.E, monomialPartAlong n 𝔪.N 𝔪.ideal 𝔪.E, 𝔪.d - o⟩) hN h𝓜 hCM hπ
    have hpair : MarkedIdealOperationsAlong.MarkedIdeal.IsSubmanifoldPair
        (⟨𝔪.N, 𝔪.E, nonmonomialPartAlong n 𝔪.N 𝔪.ideal 𝔪.E, o⟩ : MarkedIdeal n X)
        ⟨𝔪.N, 𝔪.E, monomialPartAlong n 𝔪.N 𝔪.ideal 𝔪.E, 𝔪.d - o⟩ := ⟨rfl, rfl, hN, h𝓝, h𝓜⟩
    rw [hc, hc']
    exact RestrictEquiv.trans'
      (MarkedIdealOperationsAlong.MarkedIdeal.geoTransform_add_restrictEquiv hpair hπ hC𝔫 hCM)
      (RestrictEquiv.add hNN hM rfl h𝓝' h𝓜' h𝔟' h𝓜'')
  · have hc : companionOf n 𝔪 o = ⟨𝔪.N, 𝔪.E, nonmonomialPartAlong n 𝔪.N 𝔪.ideal 𝔪.E, o⟩ := if_neg hod
    have hc' : companionOf n (𝔪.geoTransform C π) o = ⟨(𝔪.geoTransform C π).N, (𝔪.geoTransform C π).E,
        nonmonomialPartAlong n (𝔪.geoTransform C π).N (𝔪.geoTransform C π).ideal (𝔪.geoTransform C π).E, o⟩ :=
      if_neg hod
    rw [hc, hc']
    exact hNN

end Step

end

