import Hironaka.Resolution.HironakaLegacyCoherentIdealFiniteType
import Hironaka.Resolution.HironakaChowNativeModuleStalkExact
import Hironaka.Resolution.HironakaChowNativeFiniteFreeStalk
import Mathlib.Algebra.Category.ModuleCat.Presheaf.Submodule

/-! Ideal module sheaves of stalk-ideal families and cyclic quotients `𝒪/(a₁,…,a_r)` on an arbitrary
ringed site `(X, R)` (lane G10P, run 0080; module part of `G10.FIBMOD.01`).  Blueprint:
`hironaka-g10-pn-ideal-noether.tex`.

For a family `J x ⊆ R_x` the sections of `R` all of whose germs lie in `J` form a native sub-sheaf
of modules of the unit (the same construction as the pulled ideal module, for an arbitrary family);
when `J` is locally generated by finitely many sections its stalk image is exactly `J x` and it is of
finite type.  For finitely many global sections `a` the relation map `δ : R^r ⟶ R` has stalk image the
span of the germs of `a`, its cokernel is finitely presented, and a germ is killed in the cokernel
stalk exactly when it lies in that span.  The cyclic-relation lemmas re-prove, publicly and verbatim
in substance, private lemmas of `HironakaChowNativePrimeSupportContinuation` and
`HironakaNativePrimeTargetRestriction`. -/

set_option autoImplicit false
open Set TopologicalSpace CategoryTheory CategoryTheory.Limits Opposite

namespace Hironaka.HironakaG10PNIdealModule

open HironakaSingularModuleSheafStalk HironakaChowNativeFinitePresentationSpreading
  HironakaLegacyCoherentIdealFiniteType HironakaChowNativeModuleStalkExact
  HironakaChowNativeFiniteFreeStalk

noncomputable section

variable {X : TopCat.{0}} (R : X.Sheaf CommRingCat.{0})

/-- A stalk-ideal family is locally finitely generated (for the ring sheaf `R`). -/
def IsLocallyFinitelyGeneratedIn (J : ∀ x : X, Ideal ↑(TopCat.Presheaf.stalk R.obj x)) : Prop :=
  ∀ x : X, ∃ (W : Opens X) (_hxW : x ∈ W) (r : ℕ) (s : Fin r → R.obj.obj (op W)),
    ∀ (y : X) (hy : y ∈ W), J y = Ideal.span (Set.range fun i => R.presheaf.germ W y hy (s i))

/-! ### The ideal module sheaf of a family -/

section IdealModule

variable (J : ∀ x : X, Ideal ↑(TopCat.Presheaf.stalk R.obj x))

/-- Sections all of whose germs lie in the family. -/
def familySectionIdeal (U : Opens X) : Ideal (R.obj.obj (op U)) where
  carrier := {s | ∀ (x : X) (hx : x ∈ U), R.presheaf.germ U x hx s ∈ J x}
  zero_mem' := by
    intro x hx
    rw [map_zero]
    exact Ideal.zero_mem _
  add_mem' := by
    intro s t hs ht x hx
    rw [map_add]
    exact Ideal.add_mem _ (hs x hx) (ht x hx)
  smul_mem' := by
    intro c s hs x hx
    change R.presheaf.germ U x hx (c * s) ∈ _
    rw [map_mul]
    exact Ideal.mul_mem_left _ _ (hs x hx)

theorem familySectionIdeal_restrict (U V : Opens X) (hUV : U ≤ V)
    (s : R.obj.obj (op V)) (hs : s ∈ familySectionIdeal R J V) :
    R.obj.map (homOfLE hUV).op s ∈ familySectionIdeal R J U := by
  intro x hx
  rw [TopCat.Presheaf.germ_res_apply R.presheaf (homOfLE hUV) x hx s]
  exact hs x (hUV hx)

/-- The family as a sub-presheaf of the unit module. -/
def familySubmodule :
    (PresheafOfModules.unit (R.obj ⋙ forget₂ CommRingCat RingCat)).Submodule where
  obj U := familySectionIdeal R J (unop U)
  map f := by
    intro s hs
    exact familySectionIdeal_restrict R J _ _ (leOfHom f.unop) s hs

/-- The family's module presheaf. -/
def familyModulePresheaf : PresheafOfModules (R.obj ⋙ forget₂ CommRingCat RingCat) :=
  (familySubmodule R J).toPresheafOfModules

theorem familyModulePresheaf_isSheaf :
    TopCat.Presheaf.IsSheaf (X := X) (familyModulePresheaf R J).presheaf := by
  apply (TopCat.Presheaf.isSheaf_iff_isSheafUniqueGluing (X := X) _).mpr
  intro ι U sf hcpt
  have hcompat : TopCat.Presheaf.IsCompatible R.obj U (fun i => (sf i).val) := by
    intro i j
    exact congrArg Subtype.val (hcpt i j)
  obtain ⟨s, hglue, huniq⟩ := TopCat.Presheaf.IsSheaf.isSheafUniqueGluing (F := R.obj) R.property
    U (fun i => (sf i).val) hcompat
  have hs : s ∈ familySectionIdeal R J (iSup U) := by
    intro x hx
    obtain ⟨i, hxi⟩ := Opens.mem_iSup.mp hx
    have hg := congrArg (R.presheaf.germ (U i) x hxi) (hglue i)
    rw [TopCat.Presheaf.germ_res_apply] at hg
    rw [hg]
    exact (sf i).property x hxi
  refine ⟨⟨s, hs⟩, ?_, ?_⟩
  · intro i
    apply Subtype.ext
    exact hglue i
  · intro t ht
    apply Subtype.ext
    apply huniq t.val
    intro i
    exact congrArg Subtype.val (ht i)

/-- **The ideal module sheaf of the family.** -/
def familyModule : SheafOfModules.{0} (forgetRing R) where
  val := familyModulePresheaf R J
  isSheaf := familyModulePresheaf_isSheaf R J

/-- Its literal inclusion into the unit. -/
def familyInclusion : familyModule R J ⟶ SheafOfModules.unit (forgetRing R) :=
  ⟨(familySubmodule R J).ι⟩

theorem familyInclusion_app (U : Opens X) (s : familySectionIdeal R J U) :
    (familyInclusion R J).val.app (op U) s = s.val := rfl

theorem familyInclusion_app_injective (U : Opens X) :
    Function.Injective ((familyInclusion R J).val.app (op U)) :=
  fun _ _ h => Subtype.val_injective h

/-- Every stalk element of the ideal module lands in the family. -/
theorem familyInclusion_stalk_mem (y : X)
    (m : ↑(TopCat.Presheaf.stalk (familyModule R J).val.presheaf y)) :
    stalkInclusionLinearMap R (familyModule R J) (familyInclusion R J) y m ∈ J y := by
  obtain ⟨U, hyU, s, rfl⟩ := TopCat.Presheaf.exists_germ_eq (familyModule R J).val.presheaf m
  have h := stalkInclusionLinearMap_germ R (familyModule R J) (familyInclusion R J) y U hyU s
  exact (congrArg (· ∈ J y) h).mpr (s.property y hyU)

/-- For a locally finitely generated family the stalk image of the ideal module is the family. -/
theorem familyInclusion_stalk_range (hJ : IsLocallyFinitelyGeneratedIn R J) (y : X) :
    LinearMap.range (stalkInclusionLinearMap R (familyModule R J) (familyInclusion R J) y) =
      J y := by
  apply le_antisymm
  · rintro a ⟨m, rfl⟩
    exact familyInclusion_stalk_mem R J y m
  · obtain ⟨W, hyW, r, s, hs⟩ := hJ y
    have hmem (i : Fin r) : s i ∈ familySectionIdeal R J W := by
      intro z hz
      rw [hs z hz]
      exact Ideal.subset_span ⟨i, rfl⟩
    rw [hs y hyW]
    apply Ideal.span_le.mpr
    rintro a ⟨i, rfl⟩
    exact ⟨TopCat.Presheaf.germ (familyModule R J).val.presheaf W y hyW ⟨s i, hmem i⟩,
      stalkInclusionLinearMap_germ R (familyModule R J) (familyInclusion R J) y W hyW ⟨s i, hmem i⟩⟩

/-- **Finite type.**  The ideal module of a locally finitely generated family is of finite type. -/
theorem familyModule_isFiniteType (hJ : IsLocallyFinitelyGeneratedIn R J) :
    (familyModule R J).IsFiniteType := by
  classical
  let B := familyModule R J
  have hJ' := hJ
  choose W hx r s hs using hJ'
  have hmem (x : X) (i : Fin (r x)) : s x i ∈ familySectionIdeal R J (W x) := by
    intro z hz
    rw [hs x z hz]
    exact Ideal.subset_span ⟨i, rfl⟩
  let t (x : X) (i : Fin (r x)) : B.val.obj (op (W x)) := ⟨s x i, hmem x i⟩
  have hp (x : X) : Epi (freeOverMap R (W x) (t x)) := by
    refine finite_free_epi_of_whole_image_span R (familyInclusion R J)
      (familyInclusion_app_injective R J) (W x) (t x) ?_
    intro y hy
    rw [familyInclusion_stalk_range R J hJ y, hs x y hy]
    rfl
  let gs (x : X) : (B.over (W x)).GeneratingSections := by
    letI : Epi (freeOverMap R (W x) (t x)) := hp x
    exact (SheafOfModules.free.generatingSections (Fin (r x))).ofEpi
      ((freeOverIso R (W x) (Fin (r x))).hom ≫ freeOverMap R (W x) (t x))
  have hgs (x : X) : (gs x).IsFiniteType := ⟨inferInstanceAs (Finite (Fin (r x)))⟩
  let q : B.LocalGeneratorsData.{0} :=
    { I := X
      X := W
      coversTop := by
        intro V
        apply (Opens.mem_grothendieckTopology X).mpr
        intro x hxV
        refine ⟨V ⊓ W x, homOfLE inf_le_left, ?_, ⟨hxV, hx x⟩⟩
        exact (Sieve.mem_ofObjects_iff W _).mpr ⟨x, ⟨homOfLE inf_le_right⟩⟩
      generators := gs }
  exact ⟨⟨q, ⟨hgs⟩⟩⟩

end IdealModule

/-! ### The cyclic relation map of finitely many global sections -/

section Cyclic

/-- A global section as a section of the unit module. -/
def scalarFamily (a : R.obj.obj (op ⊤)) : (SheafOfModules.unit (forgetRing R)).sections :=
  PresheafOfModules.sectionsMk
    (fun V => R.obj.map (homOfLE (show V.unop ≤ ⊤ from le_top)).op a) (by
      intro V T f
      change R.obj.map f (R.obj.map (homOfLE (show V.unop ≤ ⊤ from le_top)).op a) =
        R.obj.map (homOfLE (show T.unop ≤ ⊤ from le_top)).op a
      rw [← Functor.map_comp_apply]
      exact congrArg (fun k => R.obj.map k a) (Subsingleton.elim _ _))

/-- The relation map `R^r ⟶ R`, `eᵢ ↦ aᵢ`. -/
def cyclicRelationMap {r : ℕ} (a : Fin r → R.obj.obj (op ⊤)) :
    SheafOfModules.free (R := forgetRing R) (Fin r) ⟶ SheafOfModules.unit (forgetRing R) :=
  (SheafOfModules.unit (forgetRing R)).freeHomEquiv.symm (fun i => scalarFamily R (a i))

theorem scalarFamily_top (a : R.obj.obj (op ⊤)) : (scalarFamily R a).val (op ⊤) = a := by
  change R.obj.map (homOfLE (show (⊤ : Opens X) ≤ ⊤ from le_top)).op a = a
  rw [show (homOfLE (show (⊤ : Opens X) ≤ ⊤ from le_top)).op = 𝟙 (op ⊤) from
    Subsingleton.elim _ _]
  exact ConcreteCategory.congr_hom (R.obj.map_id (op ⊤)) a

theorem cyclicRelationMap_top_freeSection {r : ℕ} (a : Fin r → R.obj.obj (op ⊤)) (i : Fin r) :
    (cyclicRelationMap R a).val.app (op ⊤)
      ((SheafOfModules.freeSection (R := forgetRing R) i).val (op ⊤)) = a i := by
  have h := SheafOfModules.sectionsMap_freeHomEquiv_symm_freeSection
    (M := SheafOfModules.unit (forgetRing R)) (fun j => scalarFamily R (a j)) i
  have hh := congrArg (fun s => s.val (op ⊤)) h
  exact hh.trans (scalarFamily_top R (a i))

/-- The coefficients of a relation map `R^r ⟶ R` (images of the basis sections over `⊤`). -/
def relationCoeff {r : ℕ}
    (δ : SheafOfModules.free (R := forgetRing R) (Fin r) ⟶ SheafOfModules.unit (forgetRing R))
    (i : Fin r) : R.obj.obj (op ⊤) :=
  δ.val.app (op ⊤) ((SheafOfModules.freeSection (R := forgetRing R) i).val (op ⊤))

theorem relationCoeff_cyclicRelationMap {r : ℕ} (a : Fin r → R.obj.obj (op ⊤)) (i : Fin r) :
    relationCoeff R (cyclicRelationMap R a) i = a i :=
  cyclicRelationMap_top_freeSection R a i

theorem relation_stalk_basis {r : ℕ}
    (δ : SheafOfModules.free (R := forgetRing R) (Fin r) ⟶ SheafOfModules.unit (forgetRing R))
    (y : X) (i : Fin r) :
    stalkInclusionLinearMap R (SheafOfModules.free (R := forgetRing R) (Fin r)) δ y
        ((finiteFreeStalkLinearEquiv R (Fin r) y).symm (Pi.single i 1)) =
      R.presheaf.germ ⊤ y (by trivial) (relationCoeff R δ i) := by
  have hm := (finiteFreeStalkLinearEquiv R (Fin r) y).symm_apply_eq.mpr
    (finiteFreeStalkLinearEquiv_freeSection_germ R (Fin r) y ⊤ (by trivial) i).symm
  exact (congrArg (stalkInclusionLinearMap R
    (SheafOfModules.free (R := forgetRing R) (Fin r)) δ y) hm).trans
      (stalkInclusionLinearMap_germ R
        (SheafOfModules.free (R := forgetRing R) (Fin r)) δ y ⊤
          (by trivial) ((SheafOfModules.freeSection (R := forgetRing R) i).val (op ⊤)))

/-- The stalk image of a relation map is the span of the germs of its coefficients. -/
theorem relation_stalk_range {r : ℕ}
    (δ : SheafOfModules.free (R := forgetRing R) (Fin r) ⟶ SheafOfModules.unit (forgetRing R))
    (y : X) :
    LinearMap.range (stalkInclusionLinearMap R
      (SheafOfModules.free (R := forgetRing R) (Fin r)) δ y) =
      Ideal.span (range fun i => R.presheaf.germ ⊤ y (by trivial) (relationCoeff R δ i)) := by
  classical
  let e := finiteFreeStalkLinearEquiv R (Fin r) y
  let L := stalkInclusionLinearMap R (SheafOfModules.free (R := forgetRing R) (Fin r)) δ y
  apply le_antisymm
  · rintro z ⟨v, rfl⟩
    have hv : v = ∑ i : Fin r, (e v i) • e.symm (Pi.single i 1) := by
      apply e.injective
      simp only [map_sum, map_smul, LinearEquiv.apply_symm_apply]
      simpa only [Pi.basisFun_repr, Pi.basisFun_apply] using
        ((Pi.basisFun ↑(TopCat.Presheaf.stalk R.obj y) (Fin r)).sum_repr (e v)).symm
    change L v ∈ _
    rw [hv, map_sum]
    apply Submodule.sum_mem
    intro i _
    rw [map_smul]
    apply Submodule.smul_mem
    exact (relation_stalk_basis R δ y i) ▸ Ideal.subset_span (mem_range_self i)
  · apply Ideal.span_le.mpr
    rintro z ⟨i, rfl⟩
    exact ⟨e.symm (Pi.single i 1), relation_stalk_basis R δ y i⟩

private def freeOneUnitIso :
    SheafOfModules.free (R := forgetRing R) PUnit ≅ SheafOfModules.unit (forgetRing R) where
  hom := Sigma.desc (fun _ : PUnit => 𝟙 (SheafOfModules.unit (forgetRing R)))
  inv := SheafOfModules.ιFree PUnit.unit
  hom_inv_id := by
    apply Sigma.hom_ext
    intro i
    cases i
    exact (Category.assoc _ _ _).symm.trans
      ((congrArg (fun f => f ≫ SheafOfModules.ιFree (R := forgetRing R) PUnit.unit)
        (Sigma.ι_desc (fun _ : PUnit => 𝟙 (SheafOfModules.unit (forgetRing R))) PUnit.unit)).trans
          ((Category.id_comp _).trans (Category.comp_id _).symm))
  inv_hom_id := Sigma.ι_desc (fun _ : PUnit => 𝟙 (SheafOfModules.unit (forgetRing R))) PUnit.unit

/-- The cokernel of a finite relation map into the unit is finitely presented. -/
theorem cokernel_to_unit_isFinitePresentation {r : ℕ}
    (δ : SheafOfModules.free (R := forgetRing R) (Fin r) ⟶ SheafOfModules.unit (forgetRing R)) :
    (cokernel δ).IsFinitePresentation := by
  let e := freeOneUnitIso R
  let f := δ ≫ e.inv
  let g := e.hom ≫ cokernel.π δ
  have hfg : f ≫ g = 0 := by
    simp only [f, g, Category.assoc, Iso.inv_hom_id_assoc, cokernel.condition]
  have hc : IsColimit (CokernelCofork.ofπ g hfg) := by
    refine IsCokernel.ofIso δ (cokernelIsCokernel δ) _ (Iso.refl _) e.symm (Iso.refl _) ?_ ?_
    · simp only [f, Iso.refl_hom, Category.id_comp, Iso.symm_hom]
    · simp only [g, Iso.symm_hom, CokernelCofork.π_ofπ, Iso.inv_hom_id_assoc,
        Iso.refl_hom, Category.comp_id, Cofork.π_ofπ]
  let P := SheafOfModules.presentationOfIsCokernelFree f g hfg hc
  let q := P.quasicoherentData
  have hq : q.IsFinitePresentation := by
    constructor
    intro V
    exact
      { isFiniteType_generators := ⟨inferInstanceAs (Finite PUnit)⟩
        isFiniteType_relations := ⟨inferInstanceAs (Finite (Fin r))⟩ }
  exact ⟨q, hq⟩

/-- The map of a unit-domain morphism on ring stalks. -/
def unitDomainStalkMap {T : SheafOfModules.{0} (forgetRing R)}
    (f : SheafOfModules.unit (forgetRing R) ⟶ T) (y : X) :
    ↑(TopCat.Presheaf.stalk R.obj y) →ₗ[↑(TopCat.Presheaf.stalk R.obj y)]
      ↑(TopCat.Presheaf.stalk T.val.presheaf y) :=
  (stalkLinearMap f.val y).comp (unitStalkLinearEquiv R y).symm.toLinearMap

private theorem cokernel_stalk_lift {r : ℕ}
    (δ : SheafOfModules.free (R := forgetRing R) (Fin r) ⟶ SheafOfModules.unit (forgetRing R))
    (u : X)
    (w : ↑(TopCat.Presheaf.stalk (SheafOfModules.unit (forgetRing R)).val.presheaf u))
    (hw : stalkLinearMap (cokernel.π δ).val u w = 0) :
    ∃ v, stalkLinearMap δ.val u v = w := by
  let F := nativeStalkFunctor R u
  let S := ShortComplex.cokernelSequence δ
  have hepi : Epi S.g := by
    change Epi (cokernel.π δ)
    infer_instance
  have hfin : PreservesFiniteColimits F := nativeStalkFunctor_preservesFiniteColimits R u
  have hshape : PreservesColimitsOfShape WalkingParallelPair F :=
    hfin.preservesFiniteColimits WalkingParallelPair
  have hpres : PreservesColimit (parallelPair δ 0) F := hshape.preservesColimit
  have hex : (S.map F).Exact :=
    (ShortComplex.cokernelSequence_exact δ).map_of_epi_of_preservesCokernel F hepi hpres
  exact ((S.map F).moduleCat_exact_iff.mp hex) w hw

private theorem cokernel_stalk_comp_zero {r : ℕ}
    (δ : SheafOfModules.free (R := forgetRing R) (Fin r) ⟶ SheafOfModules.unit (forgetRing R))
    (u : X)
    (v : ↑(TopCat.Presheaf.stalk (SheafOfModules.free (R := forgetRing R) (Fin r)).val.presheaf u)) :
    stalkLinearMap (cokernel.π δ).val u (stalkLinearMap δ.val u v) = 0 := by
  let F := nativeStalkFunctor R u
  let S := ShortComplex.cokernelSequence δ
  exact (S.map F).moduleCat_zero_apply v

/-- **The stalk kernel of a cyclic quotient** `R ⟶ coker δ` is the span of the germs of the
coefficients of `δ`. -/
theorem relation_stalk_zero_iff {r : ℕ}
    (δ : SheafOfModules.free (R := forgetRing R) (Fin r) ⟶ SheafOfModules.unit (forgetRing R))
    (u : X) (s : ↑(TopCat.Presheaf.stalk R.obj u)) :
    unitDomainStalkMap R (cokernel.π δ) u s = 0 ↔
      s ∈ Ideal.span (range fun i => R.presheaf.germ ⊤ u (by trivial) (relationCoeff R δ i)) := by
  have hspan := relation_stalk_range R δ u
  constructor
  · intro hs
    obtain ⟨v, hv⟩ := cokernel_stalk_lift R δ u ((unitStalkLinearEquiv R u).symm s) hs
    have hm : s ∈ LinearMap.range (stalkInclusionLinearMap R
        (SheafOfModules.free (R := forgetRing R) (Fin r)) δ u) :=
      ⟨v, (congrArg (unitStalkLinearEquiv R u) hv).trans
        ((unitStalkLinearEquiv R u).apply_symm_apply s)⟩
    exact Eq.mp (congrArg (fun T : Submodule _ _ => s ∈ T) hspan) hm
  · intro hs
    have hm : s ∈ LinearMap.range (stalkInclusionLinearMap R
        (SheafOfModules.free (R := forgetRing R) (Fin r)) δ u) :=
      Eq.mpr (congrArg (fun T : Submodule _ _ => s ∈ T) hspan) hs
    obtain ⟨v, rfl⟩ := hm
    have hunit := (unitStalkLinearEquiv R u).symm_apply_apply (stalkLinearMap δ.val u v)
    exact (congrArg (stalkLinearMap (cokernel.π δ).val u) hunit).trans
      (cokernel_stalk_comp_zero R δ u v)

end Cyclic

/-- The native stalk functor preserves zero morphisms. -/
instance nativeStalkFunctor_preservesZeroMorphisms (x : X) :
    (nativeStalkFunctor R x).PreservesZeroMorphisms where
  map_zero _M _N := ModuleCat.hom_ext (stalkLinearMap_zero (R₀ := R.obj) x)

/-! ### Containment from zero-stalk rigidity of the fixed cyclic quotient -/

/-- **Containment from rigidity.**  Let `δ : R^r ⟶ R` have coefficients `a` and let `J` be a locally
finitely generated family with `J p ⊆ (a)_p`.  If every map from a finite-type module to the cyclic
quotient `coker δ = R/(a)` with zero stalk at `p` is zero, then `J y ⊆ (a)_y` at EVERY point `y`.
(Apply the rigidity to the ideal module of `J` composed with the quotient map.) -/
theorem le_span_of_rigid {r : ℕ}
    (δ : SheafOfModules.free (R := forgetRing R) (Fin r) ⟶ SheafOfModules.unit (forgetRing R))
    (J : ∀ x : X, Ideal ↑(TopCat.Presheaf.stalk R.obj x)) (hJ : IsLocallyFinitelyGeneratedIn R J)
    (p : X)
    (hp : J p ≤ Ideal.span (range fun i => R.presheaf.germ ⊤ p (by trivial) (relationCoeff R δ i)))
    (hrig : ∀ (G : SheafOfModules.{0} (forgetRing R)), G.IsFiniteType →
      ∀ f : G ⟶ cokernel δ, (nativeStalkFunctor R p).map f = 0 → f = 0)
    (y : X) :
    J y ≤ Ideal.span (range fun i => R.presheaf.germ ⊤ y (by trivial) (relationCoeff R δ i)) := by
  let ι := familyInclusion R J
  let π := cokernel.π δ
  have hstalk (z : X)
      (m : ↑(TopCat.Presheaf.stalk (familyModule R J).val.presheaf z)) :
      ((nativeStalkFunctor R z).map (ι ≫ π)) m =
        unitDomainStalkMap R π z (stalkInclusionLinearMap R (familyModule R J) ι z m) := by
    rw [Functor.map_comp]
    exact congrArg (stalkLinearMap π.val z)
      ((unitStalkLinearEquiv R z).symm_apply_apply (stalkLinearMap ι.val z m)).symm
  have hzero : ι ≫ π = 0 := by
    refine hrig (familyModule R J) (familyModule_isFiniteType R J hJ) (ι ≫ π) ?_
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro m
    change ((nativeStalkFunctor R p).map (ι ≫ π)) m = 0
    exact (hstalk p m).trans
      ((relation_stalk_zero_iff R δ p _).mpr (hp (familyInclusion_stalk_mem R J p m)))
  intro s hs
  rw [← familyInclusion_stalk_range R J hJ y] at hs
  obtain ⟨m, rfl⟩ := hs
  apply (relation_stalk_zero_iff R δ y _).mp
  have h0 : ((nativeStalkFunctor R y).map (ι ≫ π)) m = 0 := by
    rw [hzero, Functor.map_zero]
    rfl
  exact (hstalk y m).symm.trans h0

end

end Hironaka.HironakaG10PNIdealModule
