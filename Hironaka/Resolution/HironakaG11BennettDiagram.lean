import Mathlib.Data.Finsupp.Weight
import Mathlib.Data.Finsupp.PWO
import Mathlib.Data.Finsupp.Encodable
import Mathlib.Topology.Sequences
import Mathlib.Topology.Compactness.Compact
import Mathlib.Topology.Order

/-!
# Bennett's stabilization, combinatorial part: antitone sequences of diagram counting functions

For an upper set `N ⊆ ℕ^e` (a "diagram", e.g. the diagram of initial exponents of an ideal) let
`hsCount N ℓ` be the number of exponents of total degree `≤ ℓ` outside `N`. A bigger diagram has a
smaller counting function (`hsCount_le_of_subset`), and the counting function in degrees `≤ ℓ` depends
only on the diagram in degrees `≤ ℓ` (`hsCount_congr`).

Main result: `eventually_const_of_antitone_hsCount` — every pointwise non-increasing sequence of
counting functions of diagrams in a fixed `ℕ^e` is eventually constant. Proof: a subsequence of the
diagrams converges pointwise (compactness of `ℕ^e → Bool`); the limit is an upper set, finitely
generated by Dickson's lemma, hence contained in the diagrams of the subsequence from some index on;
the counting function of the limit is the pointwise limit of the sequence.

This is the combinatorial half of Bennett's theorem (Ann. Math. 91 (1970); Bierstone–Milman 2008, §1,
property (4)) on the stabilization of decreasing sequences of Hilbert–Samuel functions.
Blueprint: `hironaka-g11-resume-bennett-stabilization.tex`.
-/

set_option autoImplicit false

namespace Hironaka.HironakaG11BennettDiagram

open Filter Topology

noncomputable section

variable {e : ℕ}

/-- The finite set of exponents in `ℕ^e` of total degree `i`. -/
def degSet (e i : ℕ) : Finset (Fin e →₀ ℕ) :=
  (Finsupp.finite_of_degree_eq i).toFinset

@[simp]
theorem mem_degSet {i : ℕ} {d : Fin e →₀ ℕ} : d ∈ degSet e i ↔ d.degree = i := by
  simp [degSet]

open Classical in
/-- The counting function of a diagram `N ⊆ ℕ^e`: the number of exponents of total degree `≤ ℓ`
outside `N`, as the sum over the degrees `i ≤ ℓ`. -/
def hsCount (N : Set (Fin e →₀ ℕ)) (ℓ : ℕ) : ℕ :=
  ∑ i ∈ Finset.range (ℓ + 1), ((degSet e i).filter (fun d => d ∉ N)).card

/-- A bigger diagram has a smaller counting function. -/
theorem hsCount_le_of_subset {N N' : Set (Fin e →₀ ℕ)} (h : N ⊆ N') :
    hsCount N' ≤ hsCount N := by
  intro ℓ
  unfold hsCount
  apply Finset.sum_le_sum
  intro i _
  apply Finset.card_le_card
  intro d hd
  simp only [Finset.mem_filter] at hd ⊢
  exact ⟨hd.1, fun h' => hd.2 (h h')⟩

/-- The counting function in degree `ℓ` only depends on the diagram in degrees `≤ ℓ`. -/
theorem hsCount_congr {N N' : Set (Fin e →₀ ℕ)} {ℓ : ℕ}
    (h : ∀ d : Fin e →₀ ℕ, d.degree ≤ ℓ → (d ∈ N ↔ d ∈ N')) :
    hsCount N ℓ = hsCount N' ℓ := by
  unfold hsCount
  apply Finset.sum_congr rfl
  intro i hi
  rw [Finset.mem_range] at hi
  congr 1
  ext d
  simp only [Finset.mem_filter, mem_degSet]
  constructor
  · rintro ⟨hd, hN⟩
    exact ⟨hd, fun h' => hN ((h d (by omega)).mpr h')⟩
  · rintro ⟨hd, hN⟩
    exact ⟨hd, fun h' => hN ((h d (by omega)).mp h')⟩

/-- **Stabilization of antitone sequences of diagram counting functions.** If `f k = hsCount (N k)`
for upper sets `N k ⊆ ℕ^e` (fixed `e`) and `f` is pointwise non-increasing, then `f` is eventually
constant. -/
theorem eventually_const_of_antitone_hsCount (f : ℕ → ℕ → ℕ) (hf : Antitone f)
    (N : ℕ → Set (Fin e →₀ ℕ)) (hN : ∀ k, IsUpperSet (N k)) (hfN : ∀ k, f k = hsCount (N k)) :
    ∃ K, ∀ k, K ≤ k → f k = f K := by
  classical
  let χ : ℕ → (Fin e →₀ ℕ) → Bool := fun k d => decide (d ∈ N k)
  obtain ⟨a, φ, hφ, hlim⟩ := CompactSpace.tendsto_subseq χ
  have hpt : ∀ d, ∀ᶠ n in atTop, χ (φ n) d = a d := by
    intro d
    have h1 := (tendsto_pi_nhds.mp hlim) d
    rw [nhds_discrete, tendsto_pure] at h1
    exact h1
  let Ninf : Set (Fin e →₀ ℕ) := {d | a d = true}
  have hmem : ∀ d, ∀ᶠ n in atTop, (d ∈ N (φ n) ↔ d ∈ Ninf) := by
    intro d
    filter_upwards [hpt d] with n hn
    simp only [χ] at hn
    simp only [Ninf, Set.mem_ofPred_eq, ← hn, decide_eq_true_eq]
  have hpwo := Set.isPWO_of_wellQuasiOrderedLE Ninf
  have hFfin : {d | Minimal (· ∈ Ninf) d}.Finite :=
    (setOfPred_minimal_antichain _).finite_of_partiallyWellOrderedOn
      (hpwo.mono (setOfPred_minimal_subset _))
  obtain ⟨n₀, hn₀⟩ : ∃ n₀, ∀ n, n₀ ≤ n → Ninf ⊆ N (φ n) := by
    have hev : ∀ᶠ n in atTop, ∀ g ∈ {d | Minimal (· ∈ Ninf) d}, g ∈ N (φ n) := by
      rw [eventually_all_finite hFfin]
      intro g hg
      filter_upwards [hmem g] with n hn
      exact hn.mpr (setOfPred_minimal_subset _ hg)
    obtain ⟨n₀, hn₀⟩ := eventually_atTop.mp hev
    refine ⟨n₀, fun n hn d hd => ?_⟩
    obtain ⟨g, hgd, hgmin⟩ := hpwo.exists_le_minimal hd
    exact hN (φ n) hgd (hn₀ n hn g hgmin)
  have hlow : ∀ k ℓ, hsCount Ninf ℓ ≤ f k ℓ := by
    intro k ℓ
    have hev : ∀ᶠ n in atTop, hsCount (N (φ n)) ℓ = hsCount Ninf ℓ := by
      have hfin : {d : Fin e →₀ ℕ | d.degree ≤ ℓ}.Finite := Finsupp.finite_of_degree_le ℓ
      have h2 := (eventually_all_finite hfin).mpr (fun d _ => hmem d)
      filter_upwards [h2] with n hn
      exact hsCount_congr (fun d hd => hn d hd)
    obtain ⟨n, hn, hkn⟩ := (hev.and (eventually_ge_atTop k)).exists
    rw [← hn, ← hfN (φ n)]
    exact hf (le_trans hkn (hφ.id_le n)) ℓ
  have hK : f (φ n₀) = hsCount Ninf := by
    funext ℓ
    apply le_antisymm
    · rw [hfN]
      exact hsCount_le_of_subset (hn₀ n₀ le_rfl) ℓ
    · exact hlow _ ℓ
  refine ⟨φ n₀, fun k hk => ?_⟩
  funext ℓ
  apply le_antisymm
  · exact hf hk ℓ
  · rw [hK]
    exact hlow k ℓ

/-- The set of counting functions of diagrams in `ℕ^e`. -/
def diagramFunctions (e : ℕ) : Set (ℕ → ℕ) :=
  {f | ∃ N : Set (Fin e →₀ ℕ), IsUpperSet N ∧ f = hsCount N}

/-- No strictly decreasing sequence of counting functions of diagrams in a fixed `ℕ^e`. -/
theorem not_strictAnti_of_mem_diagramFunctions (f : ℕ → ℕ → ℕ) (hmem : ∀ k, f k ∈ diagramFunctions e) :
    ¬ StrictAnti f := by
  intro hs
  choose N hN hfN using hmem
  obtain ⟨K, hK⟩ := eventually_const_of_antitone_hsCount f hs.antitone N hN hfN
  exact (hs (Nat.lt_succ_self K)).ne (hK (K + 1) (Nat.le_succ K))

end

end Hironaka.HironakaG11BennettDiagram
