import Hironaka.Resolution.HironakaActualDifferentHistoryRecords
import Hironaka.Resolution.HironakaActualCurrentMaskedReferenceValues

/-! Paired DIFFERENT actual histories generated by actual centre traces and
arbitrary current-open shrinking. Post-record identities are proved by
induction; they are not fields or successor premises. -/
set_option autoImplicit false
open Set Filter TopologicalSpace
open scoped Topology Manifold ContDiff
universe u
namespace Hironaka.HironakaActualGeneratedCurrentHistories
open Hironaka.HolomorphicIdealSheaves Hironaka.BlowupSequences
open BlowupTowers BlowupTowerTransforms MarkedIdeals MarkedIdeals.MarkedIdeal
open MarkedIdealBiholomorphism MarkedIdealRestrictOpen RelativePrincipalizationSpan
open HironakaActualRawRecordPullbacks HironakaActualDifferentHistoryRecords
noncomputable section
variable {n : ℕ}

section Restrict
variable {Y Y' : CMfd.{u} n} {U : Opens Y} {U' : Opens Y'}
 (η : CMfd.of (n := n) U ≃ₘ⟮𝓘(ℂ,ComplexModel n),𝓘(ℂ,ComplexModel n)⟯ CMfd.of (n := n) U')
 (V : Opens Y) (V' : Opens Y') (hV : (V : Set Y) ⊆ U) (hV' : (V' : Set Y') ⊆ U')
 (htr : η ⁻¹' ((Subtype.val : U' → Y') ⁻¹' (V' : Set Y')) =
   (Subtype.val : U → Y) ⁻¹' (V : Set Y))

/-- Restrict the preceding actual comparison to smaller current opens.
The opens need not descend from any original base open. -/
def restrictComparison : CMfd.of (n := n) V
 ≃ₘ⟮𝓘(ℂ,ComplexModel n),𝓘(ℂ,ComplexModel n)⟯ CMfd.of (n := n) V' := by
 let i : V → U := fun p => ⟨p.val,hV p.property⟩
 let i' : V' → U' := fun p => ⟨p.val,hV' p.property⟩
 have hfmem : ∀p : V,(η (i p)).val∈V' :=
   fun p => (Set.ext_iff.mp htr (i p)).mpr p.property
 have hgmem : ∀p : V',(η.symm (i' p)).val∈V := by
   intro p
   apply (Set.ext_iff.mp htr (η.symm (i' p))).mp
   change (η (η.symm (i' p))).val∈(V' : Set Y')
   rw [η.apply_symm_apply]
   exact p.property
 let f : V → V' := fun p => ⟨(η (i p)).val,hfmem p⟩
 let g : V' → V := fun p => ⟨(η.symm (i' p)).val,hgmem p⟩
 have hi : ContMDiff 𝓘(ℂ,ComplexModel n) 𝓘(ℂ,ComplexModel n) ∞ i :=
   BlowupRestrictOpen.contMDiff_opens_mk contMDiff_subtype_val (fun p => hV p.property)
 have hi' : ContMDiff 𝓘(ℂ,ComplexModel n) 𝓘(ℂ,ComplexModel n) ∞ i' :=
   BlowupRestrictOpen.contMDiff_opens_mk contMDiff_subtype_val (fun p => hV' p.property)
 refine ⟨⟨f,g,?_,?_⟩,?_,?_⟩
 · intro p
   apply Subtype.ext
   exact congrArg (fun q : U => q.val) (η.symm_apply_apply (i p))
 · intro p
   apply Subtype.ext
   exact congrArg (fun q : U' => q.val) (η.apply_symm_apply (i' p))
 · exact BlowupRestrictOpen.contMDiff_opens_mk
     (contMDiff_subtype_val.comp (η.contMDiff.comp hi)) hfmem
 · exact BlowupRestrictOpen.contMDiff_opens_mk
     (contMDiff_subtype_val.comp (η.symm.contMDiff.comp hi')) hgmem

theorem restrictComparison_val (p : V) :
 (restrictComparison η V V' hV hV' htr p).val=(η ⟨p.val,hV p.property⟩).val := rfl

theorem whole_records_restrict
 (A : MarkedIdeal n Y) (B : MarkedIdeal n Y')
 (hA : ∀x g,A.ideal.mem x g → HolomorphicAt n g x)
 (hB : ∀x g,B.ideal.mem x g → HolomorphicAt n g x)
 (hrec : MarkedIdeal.pullback (Subtype.val : U → Y) A =
   MarkedIdeal.pullback η (MarkedIdeal.pullback (Subtype.val : U' → Y') B)) :
 MarkedIdeal.pullback (Subtype.val : V → Y) A =
   MarkedIdeal.pullback (restrictComparison η V V' hV hV' htr)
     (MarkedIdeal.pullback (Subtype.val : V' → Y') B) := by
 let i : V → U := fun p => ⟨p.val,hV p.property⟩
 let χ := restrictComparison η V V' hV hV' htr
 have hi : ContMDiff 𝓘(ℂ,ComplexModel n) 𝓘(ℂ,ComplexModel n) ∞ i :=
   BlowupRestrictOpen.contMDiff_opens_mk contMDiff_subtype_val (fun p => hV p.property)
 have hs := marked_pullback_comp_hhol hA (a := (Subtype.val : U → Y))
   (b := i) (d := (Subtype.val : V → Y)) contMDiff_subtype_val hi (fun _ => rfl)
 have hm := congrArg (MarkedIdeal.pullback i) hrec
 have hm' := marked_pullback_comp_hhol
   (J := MarkedIdeal.pullback (Subtype.val : U' → Y') B) (fun _ _ hg => hg.1)
   (a := η) (b := i) (d := fun p => η (i p)) η.contMDiff hi (fun _ => rfl)
 have ht₁ := marked_pullback_comp_hhol hB (a := (Subtype.val : U' → Y'))
   (b := fun p : V => η (i p)) (d := fun p : V => (χ p).val)
   contMDiff_subtype_val (η.contMDiff.comp hi) (fun _ => rfl)
 have ht₂ := marked_pullback_comp_hhol hB (a := (Subtype.val : V' → Y'))
   (b := χ) (d := fun p : V => (χ p).val) contMDiff_subtype_val χ.contMDiff (fun _ => rfl)
 exact hs.symm.trans (hm.trans (hm'.trans (ht₁.trans ht₂.symm)))
end Restrict

section Histories
variable {X X' : CMfd.{u} n}

/-- The actual successor map is chosen from blowup uniqueness, independently
of marked records or invariant values. -/
def nextComparison {Y Y' Z Z' : CMfd.{u} n}
 {C : Set Y} {C' : Set Y'} {π : Z → Y} {π' : Z' → Y'}
 (hπ : IsBlowupAlong n C π) (hπ' : IsBlowupAlong n C' π')
 (U : Opens Y) (U' : Opens Y')
 (η : CMfd.of (n := n) U ≃ₘ⟮𝓘(ℂ,ComplexModel n),𝓘(ℂ,ComplexModel n)⟯ CMfd.of (n := n) U')
 (hC : η ⁻¹' ((Subtype.val : U' → Y') ⁻¹' C') = (Subtype.val : U → Y) ⁻¹' C) :=
 Classical.choose (existsUnique_next_comparison hπ hπ' U U' η hC)

theorem nextComparison_square {Y Y' Z Z' : CMfd.{u} n}
 {C : Set Y} {C' : Set Y'} {π : Z → Y} {π' : Z' → Y'}
 (hπ : IsBlowupAlong n C π) (hπ' : IsBlowupAlong n C' π')
 (U : Opens Y) (U' : Opens Y')
 (η : CMfd.of (n := n) U ≃ₘ⟮𝓘(ℂ,ComplexModel n),𝓘(ℂ,ComplexModel n)⟯ CMfd.of (n := n) U')
 (hC : η ⁻¹' ((Subtype.val : U' → Y') ⁻¹' C') = (Subtype.val : U → Y) ⁻¹' C) :
 ∀p,π' (nextComparison hπ hπ' U U' η hC p).val = (η ⟨π p.val,p.property⟩).val :=
 (Classical.choose_spec (existsUnique_next_comparison hπ hπ' U U' η hC)).1

/-- Only initial local record data and actual geometric successor data are
stored. Every successor comparison is internally generated by uniqueness.
Arbitrary intermediate shrinking is allowed on the CURRENT stage. -/
inductive Generated (A : MarkedIdeal n X) (B : MarkedIdeal n X') :
 {Y Y' : CMfd.{u} n} → BlowupTower X Y → BlowupTower X' Y' →
 (U : Opens Y) → (U' : Opens Y') →
 (CMfd.of (n := n) U ≃ₘ⟮𝓘(ℂ,ComplexModel n),𝓘(ℂ,ComplexModel n)⟯ CMfd.of (n := n) U') → Prop
 | initial (U : Opens X) (U' : Opens X')
   (η : CMfd.of (n := n) U ≃ₘ⟮𝓘(ℂ,ComplexModel n),𝓘(ℂ,ComplexModel n)⟯ CMfd.of (n := n) U')
   (hrec : MarkedIdeal.pullback (Subtype.val : U → X) A =
     MarkedIdeal.pullback η (MarkedIdeal.pullback (Subtype.val : U' → X') B)) :
   Generated A B .refl .refl U U' η
 | shrink {Y Y' : CMfd.{u} n} {S : BlowupTower X Y} {T : BlowupTower X' Y'}
   {U : Opens Y} {U' : Opens Y'} {η} (H : Generated A B S T U U' η)
   (V : Opens Y) (V' : Opens Y') (hV : (V : Set Y) ⊆ U) (hV' : (V' : Set Y') ⊆ U')
   (htr : η ⁻¹' ((Subtype.val : U' → Y') ⁻¹' (V' : Set Y')) =
     (Subtype.val : U → Y) ⁻¹' (V : Set Y)) :
   Generated A B S T V V' (restrictComparison η V V' hV hV' htr)
 | step {Y Y' Z Z' : CMfd.{u} n} {S : BlowupTower X Y} {T : BlowupTower X' Y'}
   {U : Opens Y} {U' : Opens Y'} {η} (H : Generated A B S T U U' η)
   {C : Set Y} {C' : Set Y'} (hAdm' : (geoTransformAlong B T).IsAdmissibleCentre C')
   {π : Z → Y} {π' : Z' → Y'} (hπ : IsBlowupAlong n C π) (hπ' : IsBlowupAlong n C' π')
   (hC : η ⁻¹' ((Subtype.val : U' → Y') ⁻¹' C') = (Subtype.val : U → Y) ⁻¹' C) :
   Generated A B (.step S C π hπ) (.step T C' π' hπ')
     (BlowupBiholomorphismLift.preOpen hπ U) (BlowupBiholomorphismLift.preOpen hπ' U')
     (nextComparison hπ hπ' U U' η hC)

theorem Generated.target_test {A : MarkedIdeal n X} {B : MarkedIdeal n X'}
 {Y Y' : CMfd.{u} n} {S : BlowupTower X Y} {T : BlowupTower X' Y'}
 {U : Opens Y} {U' : Opens Y'} {η} (H : Generated A B S T U U' η) : IsGeoTestTower B T := by
 induction H with
 | initial => trivial
 | shrink _ _ _ _ _ _ ih => exact ih
 | step _ hAdm' _ _ _ ih => exact ⟨ih,hAdm'⟩

/-- Every generated finite paired history has the entire original current
record identity. Source global coherence and global source testness are
absent. The proof is an actual base/shrink/successor induction. -/
theorem Generated.whole_records {A : MarkedIdeal n X} {B : MarkedIdeal n X'}
 (hA : ∀x g,A.ideal.mem x g → HolomorphicAt n g x) (hB : B.IsWellFormed)
 {Y Y' : CMfd.{u} n} {S : BlowupTower X Y} {T : BlowupTower X' Y'}
 {U : Opens Y} {U' : Opens Y'} {η} (H : Generated A B S T U U' η) :
 MarkedIdeal.pullback (Subtype.val : U → Y) (geoTransformAlong A S) =
   MarkedIdeal.pullback η (MarkedIdeal.pullback (Subtype.val : U' → Y') (geoTransformAlong B T)) := by
 induction H with
 | initial _ _ _ hrec => exact hrec
 | @shrink Y Y' S T U U' η H V V' hV hV' htr ih =>
   exact whole_records_restrict η V V' hV hV' htr (geoTransformAlong A S) (geoTransformAlong B T)
     (holomorphic_geoTransformAlong A hA S)
     (holomorphic_geoTransformAlong B
       (fun _ _ hg => RelativePrincipalizationSpan.GermIdeal.IsCoherent.holomorphicAt_mem hB.isCoherent hg) T) ih
 | @step Y Y' Z Z' S T U U' η H C C' hAdm' π π' hπ hπ' hC ih =>
   have hBT := MarkedIdealOpenBiholomorphism.isWellFormed_geoTransformAlong hB T H.target_test
   obtain ⟨χ,hχ,hrec⟩ := exists_next_whole_records (geoTransformAlong A S) (geoTransformAlong B T)
     (holomorphic_geoTransformAlong A hA S) hBT hAdm' hπ hπ' U U' η ih hC
   have hEq : χ=nextComparison hπ hπ' U U' η hC :=
     (Classical.choose_spec (existsUnique_next_comparison hπ hπ' U U' η hC)).2 χ hχ
   exact hEq ▸ hrec

end Histories
end
end Hironaka.HironakaActualGeneratedCurrentHistories
