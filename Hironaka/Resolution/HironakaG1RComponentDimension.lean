import Hironaka.Resolution.HironakaG1RDimensionBaseChange
import Mathlib.RingTheory.Localization.BaseChange
import Mathlib.LinearAlgebra.TensorProduct.RightExactness

/-!
# Dimensions of irreducible components under field extension (ALG14 input D2, second part)

**Main result** (`ringKrullDim_quotient_of_mem_minimalPrimes`): let `A` be a finite type algebra
over a field `k` and `L / k` any field extension.  For every minimal prime `Q` of `A ⊗[k] L`, with
contraction `P` to `A` (a minimal prime of `A`),

  `dim ((A ⊗[k] L) ⧸ Q) = dim (A ⧸ P)`,

i.e. every irreducible component of `X_L` has the dimension of the component of `X` below it.
Together with `HironakaG1RDimensionBaseChange` (minimal primes contract ONTO minimal primes) this
gives `dimensionSet_tensorProduct`: the set of dimensions of the irreducible components is invariant
under field extension (`dimensionIndex X_L = dimensionIndex X` in the ALG14 note, layers F1/F2).

Proof.  `A' = A ⧸ P` is a domain; Noether normalization gives an injective integral
`R = k[X₁..X_s] → A'`, `s = dim A'`, which we lift to `g : R → A`.  The composite
`R ⊗[k] L → A ⊗[k] L → (A ⊗[k] L) ⧸ Q` is integral (generated by the classes of `a ⊗ 1`, integral
because `a mod P` is) and injective; hence the dimension is `dim (R ⊗[k] L) = dim L[X₁..X_s] = s`.
Injectivity is the torsion-freeness of `A' ⊗[k] L` over `R ⊗[k] L`
(`map_mul_eq_zero_of_injective`): with `F = Frac R`, `K' = Frac A'`, the ring `K' ⊗[R] D`
(`D = R ⊗[k] L`) is a FREE module over the domain `F ⊗[R] D` (a localization of `D`), and
`A' ⊗[R] D ↪ K' ⊗[R] D` by flatness of `D` over `R` (`mul_includeRight_eq_zero`).  An element of
`Q` kills some element outside `ker (A ⊗ L → A' ⊗ L) ⊆ Q` (`Q` is minimal over that kernel).

Only Mathlib and `HironakaG1RDimensionBaseChange` are imported; no named input.
Blueprint: `hironaka-g1-r-dimension-base-change.tex` (nodes `g1r:torsion-free-base-change`,
`g1r:component-dimension`).
-/

set_option autoImplicit false

open scoped TensorProduct

namespace Hironaka.HironakaG1RComponentDimension

open HironakaG1RDimensionBaseChange

/-! ### Torsion-freeness -/

section TorsionFree

variable {R A' D : Type*} [CommRing R] [IsDomain R] [CommRing A'] [IsDomain A'] [Algebra R A']
  [FaithfulSMul R A'] [CommRing D] [IsDomain D] [Algebra R D] [Module.Flat R D] [FaithfulSMul R D]

/-- **Torsion-freeness of a flat base change of a domain.**  Let `R ⊆ A'` be domains and `D` a
flat `R`-algebra which is a domain containing `R`.  Then every nonzero `x ∈ D` acts injectively on
`A' ⊗[R] D`. -/
theorem mul_includeRight_eq_zero {x : D} (hx : x ≠ 0) {w : A' ⊗[R] D}
    (h : (Algebra.TensorProduct.includeRight : D →ₐ[R] A' ⊗[R] D) x * w = 0) : w = 0 := by
  let K' := FractionRing A'
  let F := FractionRing R
  have hRK : Function.Injective (algebraMap R K') := by
    rw [IsScalarTower.algebraMap_eq R A' K']
    exact (IsFractionRing.injective A' K').comp (FaithfulSMul.algebraMap_injective R A')
  have : FaithfulSMul R K' := (faithfulSMul_iff_algebraMap_injective R K').mpr hRK
  let _ : Algebra F K' := FractionRing.liftAlgebra R K'
  -- `K' ⊗[R] D` is the base change of `K'` along `F → F ⊗[R] D`, hence free over `F ⊗[R] D`
  let _ : Algebra (F ⊗[R] D) (K' ⊗[R] D) :=
    (Algebra.TensorProduct.map (IsScalarTower.toAlgHom R F K') (AlgHom.id R D)).toRingHom.toAlgebra
  have hsc : IsScalarTower F (F ⊗[R] D) (K' ⊗[R] D) :=
    IsScalarTower.of_algebraMap_eq (R := F) (S := F ⊗[R] D) (A := K' ⊗[R] D) fun _ ↦ rfl
  have hpush : Algebra.IsPushout F K' (F ⊗[R] D) (K' ⊗[R] D) :=
    Algebra.IsPushout.tensorProduct_tensorProduct R D F K' (by
      ext d
      simp [RingHom.algebraMap_toAlgebra])
  have : Module.Free (F ⊗[R] D) (K' ⊗[R] D) := .of_equiv hpush.symm.out.equiv
  -- `F ⊗[R] D` is a localization of the domain `D`, hence a domain containing `D`
  let _ : Algebra D (F ⊗[R] D) := Algebra.TensorProduct.rightAlgebra
  have hM : Algebra.algebraMapSubmonoid D (nonZeroDivisors R) ≤ nonZeroDivisors D := by
    rintro _ ⟨r, hr, rfl⟩
    refine mem_nonZeroDivisors_of_ne_zero ?_
    rw [← map_zero (algebraMap R D)]
    exact fun h0 ↦ nonZeroDivisors.ne_zero hr (FaithfulSMul.algebraMap_injective R D h0)
  have : IsLocalization (Algebra.algebraMapSubmonoid D (nonZeroDivisors R)) (F ⊗[R] D) :=
    IsLocalization.tensorRight F (nonZeroDivisors R)
  have : IsDomain (F ⊗[R] D) := IsLocalization.isDomain_of_le_nonZeroDivisors (F ⊗[R] D) hM
  have hθ : algebraMap D (F ⊗[R] D) x ≠ 0 := by
    rw [← map_zero (algebraMap D (F ⊗[R] D))]
    exact fun h0 ↦ hx (IsLocalization.injective (F ⊗[R] D) hM h0)
  -- `A' ⊗[R] D ↪ K' ⊗[R] D`
  let ι := Algebra.TensorProduct.map (IsScalarTower.toAlgHom R A' K') (AlgHom.id R D)
  have hι : Function.Injective ι :=
    Module.Flat.rTensor_preserves_injective_linearMap (M := D)
      (IsScalarTower.toAlgHom R A' K').toLinearMap (IsFractionRing.injective A' K')
  have key : algebraMap D (F ⊗[R] D) x • ι w = 0 := by
    have h1 : ι ((Algebra.TensorProduct.includeRight : D →ₐ[R] A' ⊗[R] D) x * w) = 0 := by
      rw [h, map_zero]
    rw [map_mul] at h1
    rw [Algebra.smul_def]
    convert h1 using 2
    simp [RingHom.algebraMap_toAlgebra, ι]
  rcases (smul_eq_zero (R := F ⊗[R] D) (M := K' ⊗[R] D)).mp key with h0 | h0
  · exact absurd h0 hθ
  · exact hι (h0.trans (map_zero ι).symm)

end TorsionFree

/-! ### Base change of an injective map of domains -/

section Field

variable (k L : Type*) [Field k] [Field L] [Algebra k L]

/-- **`A' ⊗[k] L` is torsion-free over `R ⊗[k] L`** (`R ⊆ A'` domains over `k`, `R ⊗[k] L` a
domain): the base change `map g id` of an injective `g : R → A'` sends nonzero elements to
nonzerodivisors. -/
theorem map_mul_eq_zero_of_injective {R A' : Type*} [CommRing R] [IsDomain R] [Algebra k R]
    [IsDomain (R ⊗[k] L)] [CommRing A'] [IsDomain A'] [Algebra k A'] (g : R →ₐ[k] A')
    (hg : Function.Injective g) {x : R ⊗[k] L} (hx : x ≠ 0) {w : A' ⊗[k] L}
    (h : Algebra.TensorProduct.map g (AlgHom.id k L) x * w = 0) : w = 0 := by
  let _ : Algebra R A' := g.toRingHom.toAlgebra
  have : IsScalarTower k R A' := .of_algebraMap_eq fun c ↦ (g.commutes c).symm
  have : FaithfulSMul R A' := (faithfulSMul_iff_algebraMap_injective R A').mpr hg
  have : FaithfulSMul R (R ⊗[k] L) := (faithfulSMul_iff_algebraMap_injective R _).mpr
    (Algebra.TensorProduct.includeLeft_injective (S := R) (algebraMap k L).injective)
  let e := Algebra.TensorProduct.cancelBaseChange k R A' A' L
  have he' : ∀ y : R ⊗[k] L,
      e ((Algebra.TensorProduct.includeRight : R ⊗[k] L →ₐ[R] A' ⊗[R] (R ⊗[k] L)) y) =
        Algebra.TensorProduct.map g (AlgHom.id k L) y := by
    intro y
    induction y with
    | zero => simp
    | add y z hy hz => simp only [map_add, hy, hz]
    | tmul r l =>
      simp [e, Algebra.smul_def, RingHom.algebraMap_toAlgebra]
  have he := he' x
  have h' : (Algebra.TensorProduct.includeRight : R ⊗[k] L →ₐ[R] A' ⊗[R] (R ⊗[k] L)) x *
      e.symm w = 0 := by
    apply e.injective
    rw [map_mul, he, AlgEquiv.apply_symm_apply, h, map_zero]
  have := mul_includeRight_eq_zero (R := R) hx h'
  simpa using congrArg e this

/-- `k[X₁..X_s] ⊗[k] L` is a domain (it is `L[X₁..X_s]`). -/
theorem isDomain_mvPolynomial_tensorProduct (s : ℕ) :
    IsDomain (MvPolynomial (Fin s) k ⊗[k] L) :=
  Function.Injective.isDomain
    ((Algebra.TensorProduct.comm k (MvPolynomial (Fin s) k) L).trans
      ((MvPolynomial.algebraTensorAlgEquiv k L).restrictScalars k)).toRingEquiv.toRingHom
    (AlgEquiv.injective _)

/-- `dim (k[X₁..X_s] ⊗[k] L) = s`. -/
theorem ringKrullDim_mvPolynomial_tensorProduct (s : ℕ) :
    ringKrullDim (MvPolynomial (Fin s) k ⊗[k] L) = s := by
  rw [ringKrullDim_eq_of_ringEquiv ((Algebra.TensorProduct.comm k (MvPolynomial (Fin s) k) L).trans
      ((MvPolynomial.algebraTensorAlgEquiv k L).restrictScalars k)).toRingEquiv,
    ringKrullDim_mvPolynomial_fin]

/-! ### The dimension of a component -/

variable {k L} {A : Type*} [CommRing A] [Algebra k A]

/-- **Dimension of the components of a base change.**  For a finite type algebra `A` over a field
`k`, a field extension `L / k` and a minimal prime `Q` of `A ⊗[k] L`, the component `V(Q)` has the
dimension of the component `V(Q ∩ A)` of `Spec A` below it. -/
theorem ringKrullDim_quotient_of_mem_minimalPrimes [Algebra.FiniteType k A]
    {Q : Ideal (A ⊗[k] L)} (hQ : Q ∈ minimalPrimes (A ⊗[k] L)) :
    ringKrullDim ((A ⊗[k] L) ⧸ Q) = ringKrullDim (A ⧸ Q.comap (algebraMap A (A ⊗[k] L))) := by
  set P := Q.comap (algebraMap A (A ⊗[k] L)) with hPdef
  have hQp : Q.IsPrime := hQ.1.1
  have hPp : P.IsPrime := Ideal.IsPrime.comap _
  -- Noether normalization of `A ⧸ P`, lifted to `A`
  obtain ⟨s, g', hinj, hint⟩ := exists_integral_inj_algHom_of_fg k (A ⧸ P)
  have hdimA : ringKrullDim (A ⧸ P) = s := by
    rw [ringKrullDim_eq_of_ringHom_isIntegral g'.toRingHom hint hinj, ringKrullDim_mvPolynomial_fin]
  let g : MvPolynomial (Fin s) k →ₐ[k] A :=
    MvPolynomial.aeval fun i ↦ (Ideal.Quotient.mk_surjective (g' (MvPolynomial.X i))).choose
  have hg : (Ideal.Quotient.mkₐ k P).comp g = g' := by
    refine MvPolynomial.algHom_ext fun i ↦ ?_
    simp only [AlgHom.comp_apply, g, MvPolynomial.aeval_X, Ideal.Quotient.mkₐ_eq_mk]
    exact (Ideal.Quotient.mk_surjective (g' (MvPolynomial.X i))).choose_spec
  have := isDomain_mvPolynomial_tensorProduct k L s
  let h := Algebra.TensorProduct.map g (AlgHom.id k L)
  let φ : MvPolynomial (Fin s) k ⊗[k] L →+* (A ⊗[k] L) ⧸ Q :=
    (Ideal.Quotient.mk Q).comp h.toRingHom
  -- `φ` is injective
  have hPQ : P.map (Algebra.TensorProduct.includeLeft : A →ₐ[k] A ⊗[k] L) ≤ Q :=
    Ideal.map_le_iff_le_comap.mpr le_rfl
  let π := Algebra.TensorProduct.map (Ideal.Quotient.mkₐ k P) (AlgHom.id k L)
  have hker : RingHom.ker π ≤ Q := by
    rw [Algebra.TensorProduct.rTensor_ker _ (Ideal.Quotient.mkₐ_surjective k P)]
    refine le_trans (Ideal.map_mono fun a ha ↦ ?_) hPQ
    simpa [Ideal.Quotient.eq_zero_iff_mem] using ha
  have hπh : π.comp h = Algebra.TensorProduct.map g' (AlgHom.id k L) := by
    rw [← hg]
    exact (Algebra.TensorProduct.map_comp _ _ _ _).symm
  have hφinj : Function.Injective φ := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    by_contra hx0
    have hxQ : h x ∈ Q := Ideal.Quotient.eq_zero_iff_mem.mp hx
    have hmin : Q ∈ (RingHom.ker π).minimalPrimes :=
      ⟨⟨hQp, hker⟩, fun q hq hqQ ↦ hQ.2 ⟨hq.1, bot_le⟩ hqQ⟩
    obtain ⟨y, hy, hxy⟩ := Ideal.exists_mul_mem_of_mem_minimalPrimes hmin hxQ
    rw [RingHom.mem_ker, map_mul] at hxy
    have hπ : π (h x) = Algebra.TensorProduct.map g' (AlgHom.id k L) x := by
      rw [← hπh]; rfl
    rw [hπ] at hxy
    exact hy (map_mul_eq_zero_of_injective k L g' hinj hx0 hxy)
  -- `φ` is integral
  let ψ : A ⧸ P →+* (A ⊗[k] L) ⧸ Q :=
    Ideal.Quotient.lift P ((Ideal.Quotient.mk Q).comp
      (Algebra.TensorProduct.includeLeft : A →ₐ[k] A ⊗[k] L).toRingHom)
      (fun a ha ↦ Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_comap.mp ha))
  have hφint : φ.IsIntegral := by
    let _ := φ.toAlgebra
    let _ := g'.toRingHom.toAlgebra
    have hcomp : (algebraMap (MvPolynomial (Fin s) k ⊗[k] L) ((A ⊗[k] L) ⧸ Q)).comp
        (Algebra.TensorProduct.includeLeft : MvPolynomial (Fin s) k →ₐ[k] _).toRingHom =
        ψ.comp (algebraMap (MvPolynomial (Fin s) k) (A ⧸ P)) := by
      refine MvPolynomial.ringHom_ext (fun c ↦ ?_) (fun i ↦ ?_)
      · simp [RingHom.algebraMap_toAlgebra, φ, ψ, h]
        rfl
      · have := congrArg (fun f ↦ f (MvPolynomial.X i)) hg
        simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk] at this
        simp [RingHom.algebraMap_toAlgebra, φ, ψ, h, ← this]
    have hA : ∀ a : A, IsIntegral (MvPolynomial (Fin s) k ⊗[k] L)
        (Ideal.Quotient.mk Q ((a : A) ⊗ₜ[k] (1 : L))) := by
      intro a
      have := IsIntegral.map_of_comp_eq _ ψ hcomp (hint (Ideal.Quotient.mk P a))
      simpa [ψ] using this
    intro z
    change IsIntegral (MvPolynomial (Fin s) k ⊗[k] L) z
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective z
    induction y with
    | zero => simpa using isIntegral_zero
    | tmul a l =>
      have : Ideal.Quotient.mk Q (a ⊗ₜ[k] l) = Ideal.Quotient.mk Q (a ⊗ₜ[k] (1 : L)) *
          algebraMap (MvPolynomial (Fin s) k ⊗[k] L) ((A ⊗[k] L) ⧸ Q) ((1 : MvPolynomial _ k) ⊗ₜ l) := by
        simp [RingHom.algebraMap_toAlgebra, φ, h, ← map_mul]
      rw [this]
      exact (hA a).mul isIntegral_algebraMap
    | add y₁ y₂ h₁ h₂ => simpa using h₁.add h₂
  rw [hdimA, ringKrullDim_eq_of_ringHom_isIntegral φ hφint hφinj,
    ringKrullDim_mvPolynomial_tensorProduct]

/-- **The dimensions of the irreducible components are invariant under field extension**: for a
finite type algebra `A` over a field `k` and a field extension `L / k`, the set of dimensions of the
irreducible components of `Spec (A ⊗[k] L)` equals that of `Spec A` (affine form of
`dimensionIndex X_L = dimensionIndex X`). -/
theorem dimensionSet_tensorProduct [Algebra.FiniteType k A] :
    (fun Q ↦ ringKrullDim ((A ⊗[k] L) ⧸ Q)) '' minimalPrimes (A ⊗[k] L) =
      (fun P ↦ ringKrullDim (A ⧸ P)) '' minimalPrimes A := by
  ext d
  constructor
  · rintro ⟨Q, hQ, rfl⟩
    exact ⟨_, comap_mem_minimalPrimes_of_flat hQ,
      (ringKrullDim_quotient_of_mem_minimalPrimes hQ).symm⟩
  · rintro ⟨P, hP, rfl⟩
    obtain ⟨Q, hQ, hQP⟩ := exists_mem_minimalPrimes_comap_eq (S := A ⊗[k] L) hP
    refine ⟨Q, hQ, ?_⟩
    simp only
    rw [ringKrullDim_quotient_of_mem_minimalPrimes hQ, hQP]

end Field

end Hironaka.HironakaG1RComponentDimension
