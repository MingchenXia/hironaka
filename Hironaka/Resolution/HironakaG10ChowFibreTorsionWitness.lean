import Hironaka.Resolution.HironakaChowQuotientBaseFlattenerTorsion
import Hironaka.Resolution.HironakaActualJointBaseFibre
import Hironaka.Resolution.HironakaRelativeNormalFibreHilbertSamuel

/-!
# Strict decrease of the fibre at germ level, with the original-fibre element (Rydh, Lemma 1.18)

Route step "Lemma 1.18 natively" of the global flattening algorithm
(`work/hironaka-resume-20261111/G10C/GLOBAL-FLATTENING-ROUTE.md` §3.3a, §5 item 3).  Germ setting:
a family `V(I) ⊆ ℂ^{d+t} → ℂ^d` (base coordinates first) at `0`, a base change `φ : (ℂ^b,0) → (ℂ^d,0)`
restricted to an arbitrary quotient `V(q)`, the base-changed family `V(I_B + q) ⊆ ℂ^{b+t}` with
`I_B = (φ × id)^* I`.  The fibre over the origin of the base change is the fibre of the original
family:

* `jointBasePullback_jointNormalPullback`, `sub_jointBasePullback_mem`: every germ `g` on
  `ℂ^{b+t}` is congruent modulo `m_b` to the pull-back of a germ on `ℂ^{d+t}` (namely
  `g(0, w)`);
* `map_originalBaseMaximalIdeal_le`: `(φ × id)^*` maps `m_d` into `m_b`.

With the torsion witness of Hironaka–Lejeune-Jalabert–Teissier
(`HironakaChowQuotientBaseFlattenerTorsion.exists_analytic_quotient_base_fibre_torsion`):

* `exists_quotient_base_original_fibre_torsion`: if the canonical flattener of `V(I)` at `0` pulls
  back to `V(q)` as a principal ideal `(a)` with `a` regular, there are `h` on the base change and
  `h₀` on the original family with `a·h ∈ I_B + q`, `h ≡ (φ × id)^* h₀` modulo `m_b`, and
  `h₀ ∉ I + m_d` (nonzero in the original closed fibre);
* `exists_fibre_decrease_germ` (**Lemma 1.18 at germ level**): for every ring map `ψ` out of the
  germs of `ℂ^{b+t}` killing `I_B + q` and making `ψ(a)` a nonzerodivisor (the strict transform,
  on which the exceptional torsion dies), `ψ((φ × id)^* h₀)` lies in the ideal generated by
  `ψ(m_b)` (the fibre ideal of the strict transform over the new base point), although
  `h₀ ∉ I + m_d`: the fibre algebra of the strict transform is a STRICT quotient of the original one.
-/

set_option autoImplicit false

open Set Filter
open scoped Topology

namespace Hironaka.HironakaG10ChowFibreTorsionWitness

open HolGerm HironakaRelativeNormalIdeal HironakaHolomorphicJetChartInvariance
  HironakaActualAnalyticBaseChangeCoefficients HironakaActualJointBaseFibre
  HironakaActualCentreJointJets HironakaRelativeNormalFibreHilbertSamuel
  HironakaChowPresentationIndependentFlattener HironakaChowQuotientBaseFlattenerTorsion

noncomputable section

variable (d e t : ℕ) (φ : ComplexModel e → ComplexModel d)
  (hφ : ∀ᶠ v in 𝓝 (0 : ComplexModel e), DifferentiableAt ℂ φ v) (hφ0 : φ 0 = 0)

/-- Composition preserves the value at `0`. -/
theorem eval_compAlgHom' {m n : ℕ} (G : ComplexModel m → ComplexModel n)
    (hG : ∀ᶠ z in 𝓝 0, DifferentiableAt ℂ G z) (hG0 : G 0 = 0) (g : HolGerm (ComplexModel n)) :
    HolGerm.eval (compAlgHom G hG hG0 g) = HolGerm.eval g := by
  obtain ⟨F, hF, rfl⟩ := HolGerm.exists_eq_mk g
  rw [compAlgHom_mk, HolGerm.eval_mk, HolGerm.eval_mk, Function.comp_apply, hG0]

/-- The base change does not touch the normal coordinates. -/
theorem jointBasePullback_jointNormalPullback (g : HolGerm (ComplexModel t)) :
    jointBasePullback d e t φ hφ hφ0 (jointNormalPullback d t g) = jointNormalPullback e t g := by
  induction g using HolGerm.induction_on with
  | h F hF =>
    unfold jointBasePullback jointNormalPullback
    rw [compAlgHom_mk, compAlgHom_mk, compAlgHom_mk]
    apply HolGerm.mk_eq_mk_iff.mpr
    refine Eventually.of_forall fun w => congrArg F ?_
    ext i
    simp only [actualJointNormalProjection_apply, jointBaseMap,
      PiLp.add_apply, tangentInclusion_normal, actualJointNormalInclusion_normal, zero_add]

/-- **The closed fibre of the base change is the original closed fibre**: every germ on
`ℂ^{e+t}` is congruent modulo `m_e` to a pull-back from `ℂ^{d+t}`. -/
theorem sub_jointBasePullback_mem (g : HolGerm (ComplexModel (e+t))) :
    g - jointBasePullback d e t φ hφ hφ0 (jointNormalPullback d t (jointBaseZeroTrace e t g)) ∈
      originalBaseMaximalIdeal e t := by
  rw [jointBasePullback_jointNormalPullback, baseMaximalIdeal_eq_ker_jointBaseZeroTrace,
    RingHom.mem_ker]
  change jointBaseZeroTrace e t (g - jointNormalPullback e t (jointBaseZeroTrace e t g)) = 0
  rw [map_sub, jointBaseZeroTrace_normalPullback, sub_self]

/-- The base change maps the base maximal ideal into the base maximal ideal. -/
theorem map_originalBaseMaximalIdeal_le :
    Ideal.map (jointBasePullback d e t φ hφ hφ0).toRingHom (originalBaseMaximalIdeal d t) ≤
      originalBaseMaximalIdeal e t := by
  unfold originalBaseMaximalIdeal
  rw [Ideal.map_map, Ideal.map_le_iff_le_comap]
  intro a ha
  rw [Ideal.mem_comap, RingHom.comp_apply]
  change jointBasePullback d e t φ hφ hφ0 (tangentPullback d t a) ∈ _
  rw [jointBasePullback_tangentPullback]
  apply Ideal.mem_map_of_mem
  rw [HolGerm.mem_maximalIdeal_iff] at ha ⊢
  rw [eval_compAlgHom', ha]

/-- **The torsion witness with its original-fibre element.** -/
theorem exists_quotient_base_original_fibre_torsion (b : ℕ)
    (I : Ideal (HolGerm (ComplexModel (d+t))))
    (φ : ComplexModel b → ComplexModel d)
    (hφ : ∀ᶠ v in 𝓝 (0 : ComplexModel b), DifferentiableAt ℂ φ v) (hφ0 : φ 0 = 0)
    (q : Ideal (HolGerm (ComplexModel b))) (a : HolGerm (ComplexModel b))
    (ha : Ideal.Quotient.mk q a ≠ 0) (hreg : IsRegular (Ideal.Quotient.mk q a))
    (hp : Ideal.map (Ideal.Quotient.mk q)
      (Ideal.map (compAlgHom φ hφ hφ0).toRingHom (canonicalFlattenerIdeal d t I)) =
        Ideal.span {Ideal.Quotient.mk q a}) :
    ∃ (h : HolGerm (ComplexModel (b+t))) (h₀ : HolGerm (ComplexModel (d+t))),
      tangentPullback b t a * h ∈ Ideal.map (jointBasePullback d b t φ hφ hφ0).toRingHom I ⊔
          Ideal.map (tangentPullback b t).toRingHom q ∧
        h - jointBasePullback d b t φ hφ hφ0 h₀ ∈ originalBaseMaximalIdeal b t ∧
        h₀ ∉ I ⊔ originalBaseMaximalIdeal d t := by
  obtain ⟨h, h1, h2⟩ := exists_analytic_quotient_base_fibre_torsion d t b I φ hφ hφ0 q a ha hreg hp
  set h₀ := jointNormalPullback d t (jointBaseZeroTrace b t h) with hh₀
  refine ⟨h, h₀, Ideal.Quotient.eq_zero_iff_mem.mp h1, sub_jointBasePullback_mem d b t φ hφ hφ0 h, ?_⟩
  intro hmem
  apply h2
  rw [Ideal.Quotient.eq_zero_iff_mem]
  have hmap : jointBasePullback d b t φ hφ hφ0 h₀ ∈
      Ideal.map (jointBasePullback d b t φ hφ hφ0).toRingHom I ⊔ originalBaseMaximalIdeal b t := by
    have h3 := Ideal.mem_map_of_mem (jointBasePullback d b t φ hφ hφ0).toRingHom hmem
    rw [Ideal.map_sup] at h3
    exact (sup_le_sup_left (map_originalBaseMaximalIdeal_le d b t φ hφ hφ0) _) h3
  have hsplit : h = (h - jointBasePullback d b t φ hφ hφ0 h₀) +
      jointBasePullback d b t φ hφ hφ0 h₀ := by ring
  rw [hsplit]
  exact Ideal.add_mem _ (Ideal.mem_sup_right (sub_jointBasePullback_mem d b t φ hφ hφ0 h)) hmap

/-- The exceptional torsion dies on any quotient on which the exceptional generator is regular. -/
theorem map_mem_of_torsion {b : ℕ} {B : Type*} [CommRing B]
    (ψ : HolGerm (ComplexModel (b+t)) →+* B) (K : Ideal (HolGerm (ComplexModel (b+t))))
    (hψ : ∀ r ∈ K, ψ r = 0) (a : HolGerm (ComplexModel b))
    (hreg : IsRegular (ψ (tangentPullback b t a))) (h g₀ : HolGerm (ComplexModel (b+t)))
    (hh : tangentPullback b t a * h ∈ K) (hg : h - g₀ ∈ originalBaseMaximalIdeal b t) :
    ψ g₀ ∈ Ideal.map ψ (originalBaseMaximalIdeal b t) := by
  have hψh : ψ h = 0 := by
    apply hreg.left
    change ψ (tangentPullback b t a) * ψ h = ψ (tangentPullback b t a) * 0
    rw [← map_mul, hψ _ hh, mul_zero]
  have hsplit : ψ g₀ = -ψ (h - g₀) := by rw [map_sub, hψh]; ring
  rw [hsplit]
  exact (Ideal.map ψ (originalBaseMaximalIdeal b t)).neg_mem (Ideal.mem_map_of_mem ψ hg)

/-- **Lemma 1.18 at germ level (Rydh; HLT Th. 2).**  If the canonical flattener of `V(I)` at `0`
pulls back to `V(q)` as `(a)` with `a` regular, then for every ring map `ψ` out of the germs of
`ℂ^{b+t}` that kills the base change `I_B + q` and on which `a` is a nonzerodivisor, some germ
`h₀` of the original family, nonzero in the original closed fibre, is mapped by `ψ ∘ (φ × id)^*`
into the ideal generated by `ψ(m_b)`. -/
theorem exists_fibre_decrease_germ (b : ℕ)
    (I : Ideal (HolGerm (ComplexModel (d+t))))
    (φ : ComplexModel b → ComplexModel d)
    (hφ : ∀ᶠ v in 𝓝 (0 : ComplexModel b), DifferentiableAt ℂ φ v) (hφ0 : φ 0 = 0)
    (q : Ideal (HolGerm (ComplexModel b))) (a : HolGerm (ComplexModel b))
    (ha : Ideal.Quotient.mk q a ≠ 0) (hreg : IsRegular (Ideal.Quotient.mk q a))
    (hp : Ideal.map (Ideal.Quotient.mk q)
      (Ideal.map (compAlgHom φ hφ hφ0).toRingHom (canonicalFlattenerIdeal d t I)) =
        Ideal.span {Ideal.Quotient.mk q a})
    {B : Type*} [CommRing B] (ψ : HolGerm (ComplexModel (b+t)) →+* B)
    (hψ : ∀ r ∈ Ideal.map (jointBasePullback d b t φ hφ hφ0).toRingHom I ⊔
      Ideal.map (tangentPullback b t).toRingHom q, ψ r = 0)
    (hψreg : IsRegular (ψ (tangentPullback b t a))) :
    ∃ h₀ : HolGerm (ComplexModel (d+t)), h₀ ∉ I ⊔ originalBaseMaximalIdeal d t ∧
      ψ (jointBasePullback d b t φ hφ hφ0 h₀) ∈ Ideal.map ψ (originalBaseMaximalIdeal b t) := by
  obtain ⟨h, h₀, hh, hg, hh₀⟩ :=
    exists_quotient_base_original_fibre_torsion d t b I φ hφ hφ0 q a ha hreg hp
  exact ⟨h₀, hh₀, map_mem_of_torsion t ψ _ hψ a hψreg h _ hh hg⟩

/-- **Lemma 1.18 through a presentation.**  The interface for the native embedding: the source
local ring `A` is presented as `HolGerm(ℂ^{d+t})/I` (`eA`, base action through the first `d`
coordinates), the strict transform's local ring `B` receives `ψ : HolGerm(ℂ^{b+t}) → B` which kills
the base change `I_B + q`, restricts to `q' ∘ eA` on pull-backs from `ℂ^{d+t}`, sends `m_b` into the
fibre ideal `𝔣` and makes `a` a nonzerodivisor.  Then some `h ∈ A` outside the fibre ideal
`m_d A` of the original family is sent by `q'` into `𝔣`. -/
theorem exists_fibre_decrease_of_presentation (b : ℕ)
    (I : Ideal (HolGerm (ComplexModel (d+t))))
    (φ : ComplexModel b → ComplexModel d)
    (hφ : ∀ᶠ v in 𝓝 (0 : ComplexModel b), DifferentiableAt ℂ φ v) (hφ0 : φ 0 = 0)
    (q : Ideal (HolGerm (ComplexModel b))) (a : HolGerm (ComplexModel b))
    (ha : Ideal.Quotient.mk q a ≠ 0) (hreg : IsRegular (Ideal.Quotient.mk q a))
    (hp : Ideal.map (Ideal.Quotient.mk q)
      (Ideal.map (compAlgHom φ hφ hφ0).toRingHom (canonicalFlattenerIdeal d t I)) =
        Ideal.span {Ideal.Quotient.mk q a})
    {A B : Type*} [CommRing A] [CommRing B] (eA : (HolGerm (ComplexModel (d+t)) ⧸ I) ≃+* A)
    (q' : A →+* B) (𝔣 : Ideal B) (ψ : HolGerm (ComplexModel (b+t)) →+* B)
    (hψ : ∀ r ∈ Ideal.map (jointBasePullback d b t φ hφ hφ0).toRingHom I ⊔
      Ideal.map (tangentPullback b t).toRingHom q, ψ r = 0)
    (hψreg : IsRegular (ψ (tangentPullback b t a)))
    (hψsrc : ∀ g, ψ (jointBasePullback d b t φ hφ hφ0 g) = q' (eA (Ideal.Quotient.mk I g)))
    (hψbase : ∀ c ∈ IsLocalRing.maximalIdeal (HolGerm (ComplexModel b)),
      ψ (tangentPullback b t c) ∈ 𝔣) :
    ∃ h : A, h ∉ Ideal.map (eA.toRingHom.comp ((Ideal.Quotient.mk I).comp
        (tangentPullback d t).toRingHom)) (IsLocalRing.maximalIdeal (HolGerm (ComplexModel d))) ∧
      q' h ∈ 𝔣 := by
  obtain ⟨h₀, hh₀, hψh₀⟩ :=
    exists_fibre_decrease_germ d t b I φ hφ hφ0 q a ha hreg hp ψ hψ hψreg
  refine ⟨eA (Ideal.Quotient.mk I h₀), ?_, ?_⟩
  · intro hmem
    apply hh₀
    have h1 := Ideal.mem_map_of_mem eA.symm.toRingHom hmem
    rw [Ideal.map_map] at h1
    have h2 : eA.symm.toRingHom.comp (eA.toRingHom.comp ((Ideal.Quotient.mk I).comp
        (tangentPullback d t).toRingHom)) = (Ideal.Quotient.mk I).comp (tangentPullback d t).toRingHom := by
      ext c
      simp
    rw [h2, ← Ideal.map_map] at h1
    have h3 : eA.symm.toRingHom (eA (Ideal.Quotient.mk I h₀)) = Ideal.Quotient.mk I h₀ := by simp
    rw [h3] at h1
    have h4 := Ideal.mem_comap.mpr h1
    rw [Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective, ← RingHom.ker_eq_comap_bot,
      Ideal.mk_ker] at h4
    rw [sup_comm]
    exact h4
  · rw [← hψsrc]
    refine (Ideal.map_le_iff_le_comap.mpr ?_) hψh₀
    unfold originalBaseMaximalIdeal
    rw [Ideal.map_le_iff_le_comap]
    intro c hc
    exact hψbase c hc

/-! ### Point selection (Rydh, proof of Lemma 1.18) -/

/-- **Point selection.**  If a family of ideals (the pointed flatteners at the points of a fibre)
pulls back along a homomorphism into a local ring so that its supremum becomes principal with a
regular generator `a`, then one member alone already pulls back to `(a)`. -/
theorem exists_map_eq_span_of_iSup {R S : Type*} [CommRing R] [CommRing S] [IsLocalRing S]
    (φ' : R →+* S) {ι : Type*} (J : ι → Ideal R) (a : S) (ha : IsRegular a)
    (h : Ideal.map φ' (⨆ k, J k) = Ideal.span {a}) : ∃ k, Ideal.map φ' (J k) = Ideal.span {a} := by
  by_contra hne
  push Not at hne
  rw [Ideal.map_iSup] at h
  have hsub : ∀ k, Ideal.map φ' (J k) ≤ Ideal.span {a} := fun k =>
    h ▸ le_iSup (fun i => Ideal.map φ' (J i)) k
  have hle : ∀ k, Ideal.map φ' (J k) ≤ IsLocalRing.maximalIdeal S * Ideal.span {a} := by
    intro k x hx
    obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp (hsub k hx)
    by_cases hr : IsUnit r
    · exfalso
      apply hne k
      refine le_antisymm (hsub k) ?_
      rw [Ideal.span_singleton_le_iff_mem]
      obtain ⟨u, hu⟩ := hr.exists_left_inv
      have hau : a = u * (r * a) := by rw [← mul_assoc, hu, one_mul]
      rw [hau]
      exact Ideal.mul_mem_left _ _ hx
    · exact Ideal.mul_mem_mul ((IsLocalRing.mem_maximalIdeal _).mpr hr)
        (Ideal.mem_span_singleton_self a)
  have ha' : a ∈ IsLocalRing.maximalIdeal S * Ideal.span {a} :=
    (iSup_le hle) (h ▸ Ideal.mem_span_singleton_self a)
  obtain ⟨r, hr, hra⟩ := Ideal.mem_mul_span_singleton.mp ha'
  have hr1 : r = 1 := ha.right (show r * a = 1 * a by rw [hra, one_mul])
  exact (IsLocalRing.mem_maximalIdeal _).mp hr (hr1 ▸ isUnit_one)

end

end Hironaka.HironakaG10ChowFibreTorsionWitness
