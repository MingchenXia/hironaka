import Mathlib.RingTheory.Ideal.Operations
import Mathlib.RingTheory.Filtration
import Mathlib.RingTheory.LocalRing.MaximalIdeal.Basic

/-!
# The algebraic core of Hironaka's Lemma 3.2 (centres `I_S^β + I_Z`, Artin–Rees)

Module M4 of lane G10H's plan (`work/hironaka-resume-20261111/G10H/HIRONAKA75-GLOBAL-STEP.md` §4;
drafted and proved by lane G10H in `G10H/drafts/G10HStatementCheckTN.lean`, landed by G10C).
Hironaka 1975, Lemma 3.2 (printed p. 531, used on p. 542): for the centre `I_S^β + I_Z` with `β` at
least an Artin–Rees number of `(I_Z, I_S)`, at a point of the blowup with pulled centre `(G)`, `G`
regular, either `I_Z` pulls back to `(G)` (Case 1: the pulled flattener equals the pulled centre), or
the point lies on the algebraic strict transform of `V(I_Z)` (Case 2: `strictIdeal` is proper).

* `strictIdeal` — Hironaka's algebraic strict transform ideal (p. 532);
* `pow_succ_sup_le`, `exists_artinRees` (pointwise Artin–Rees number, mathlib),
  `map_le_span_mul_maximalIdeal`, `map_mem_of_case2`;
* `sum_centre_dichotomy`, `strictIdeal_eq_top_iff`.
-/

set_option autoImplicit false

namespace Hironaka.HironakaG10ChowArtinReesCentre

section ArtinRees

variable {A R : Type*} [CommRing A] [CommRing R]

/-- Hironaka's algebraic strict transform ideal at a point of the blowup (p.532): generated by the
`G^{-k} h` with `h ∈ I_Z ∩ I_D^k`, where `G` generates the pulled centre `I_D`. -/
def strictIdeal (φ : A →+* R) (IZ ID : Ideal A) (G : R) : Ideal R :=
  Ideal.span {h' | ∃ k : ℕ, ∃ h ∈ IZ ⊓ ID ^ k, φ h = G ^ k * h'}

/-- `(a ⊔ b)^(k+1) ≤ a^(k+1) ⊔ b (a ⊔ b)^k`. -/
theorem pow_succ_sup_le (a b : Ideal A) : ∀ k : ℕ, (a ⊔ b) ^ (k + 1) ≤ a ^ (k + 1) ⊔ b * (a ⊔ b) ^ k
  | 0 => by simp
  | k + 1 => by
    calc (a ⊔ b) ^ (k + 1 + 1) = (a ⊔ b) ^ (k + 1) * (a ⊔ b) := pow_succ _ _
      _ ≤ (a ^ (k + 1) ⊔ b * (a ⊔ b) ^ k) * (a ⊔ b) := Ideal.mul_mono_left (pow_succ_sup_le a b k)
      _ = a ^ (k + 1) * a ⊔ a ^ (k + 1) * b ⊔ b * (a ⊔ b) ^ k * (a ⊔ b) := by
          rw [Ideal.sup_mul, Ideal.mul_sup]
      _ ≤ a ^ (k + 1 + 1) ⊔ b * (a ⊔ b) ^ (k + 1) := by
          refine sup_le (sup_le ?_ ?_) ?_
          · rw [← pow_succ]; exact le_sup_left
          · refine le_trans ?_ le_sup_right
            rw [mul_comm]
            exact Ideal.mul_mono_right (Ideal.pow_right_mono le_sup_left _)
          · rw [mul_assoc, ← pow_succ]; exact le_sup_right

/-- **Pointwise Artin–Rees number** (mathlib `Ideal.exists_pow_inf_eq_pow_smul`): the hypothesis
`hAR` of `sum_centre_dichotomy` holds for some `α` in every Noetherian ring.  (Hironaka needs ONE `α`
for all points of a relatively compact `Q`, p.531: finite generation of `in_S(Y,Z)` over `Q`.) -/
theorem exists_artinRees [IsNoetherianRing A] (IZ IS : Ideal A) :
    ∃ α : ℕ, ∀ m, α ≤ m → IZ ⊓ IS ^ m ≤ IS ^ (m - α) * (IZ ⊓ IS ^ α) := by
  obtain ⟨k, hk⟩ := Ideal.exists_pow_inf_eq_pow_smul IS (M := A) IZ
  refine ⟨k, fun m hm => ?_⟩
  have h := hk m hm
  simp only [Ideal.smul_eq_mul, Ideal.mul_top] at h
  rw [inf_comm, h, inf_comm]

variable [IsLocalRing R]

/-- If no element of `I_Z` maps to `G` times a unit, the pulled `I_Z` lies in `G m`. -/
theorem map_le_span_mul_maximalIdeal (φ : A →+* R) (IZ : Ideal A) (G : R)
    (hZle : Ideal.map φ IZ ≤ Ideal.span {G})
    (h1 : ∀ z ∈ IZ, ∀ u : R, IsUnit u → φ z ≠ G * u) :
    Ideal.map φ IZ ≤ Ideal.span {G} * IsLocalRing.maximalIdeal R := by
  rw [Ideal.map_le_iff_le_comap]
  intro z hz
  obtain ⟨w, hw⟩ := Ideal.mem_span_singleton'.mp (hZle (Ideal.mem_map_of_mem φ hz))
  rw [Ideal.mem_comap, Ideal.mem_span_singleton_mul]
  refine ⟨w, ?_, by rw [mul_comm]; exact hw⟩
  by_contra hw'
  have hu : IsUnit w := by
    by_contra hnu
    exact hw' ((IsLocalRing.mem_maximalIdeal w).mpr hnu)
  exact h1 z hz w hu (by rw [← hw, mul_comm])

/-- The bound on the image of `h ∈ I_Z ∩ (I_S^β + I_Z)^(k+1)` in Case 2. -/
theorem map_mem_of_case2 (φ : A →+* R) (IZ IS : Ideal A) (α β : ℕ)
    (hαβ : α ≤ β) (hAR : ∀ m, α ≤ m → IZ ⊓ IS ^ m ≤ IS ^ (m - α) * (IZ ⊓ IS ^ α))
    (G : R) (hD : Ideal.map φ (IS ^ β ⊔ IZ) = Ideal.span {G})
    (hZm : Ideal.map φ IZ ≤ Ideal.span {G} * IsLocalRing.maximalIdeal R)
    (k : ℕ) (h : A) (hhZ : h ∈ IZ) (hhD : h ∈ (IS ^ β ⊔ IZ) ^ (k + 1)) :
    φ h ∈ Ideal.span {G ^ (k + 1)} * IsLocalRing.maximalIdeal R := by
  have hSle : Ideal.map φ (IS ^ β) ≤ Ideal.span {G} := hD ▸ Ideal.map_mono le_sup_left
  have hgk : Ideal.span {G ^ k} * (Ideal.span {G} * IsLocalRing.maximalIdeal R) =
      Ideal.span {G ^ (k + 1)} * IsLocalRing.maximalIdeal R := by
    rw [← mul_assoc, Ideal.span_singleton_mul_span_singleton, pow_succ]
  have hsplit : h ∈ (IS ^ β) ^ (k + 1) ⊔ IZ * (IS ^ β ⊔ IZ) ^ k :=
    pow_succ_sup_le (IS ^ β) IZ k hhD
  obtain ⟨h₁, hh₁, h₂, hh₂, hsum⟩ := Submodule.mem_sup.mp hsplit
  have h₂Z : h₂ ∈ IZ := Ideal.mul_le_left (I := IZ) (J := (IS ^ β ⊔ IZ) ^ k) hh₂
  have h₁Z : h₁ ∈ IZ := by
    have h' : h - h₂ ∈ IZ := IZ.sub_mem hhZ h₂Z
    rwa [← hsum, add_sub_cancel_right] at h'
  have hm : α ≤ β * (k + 1) := le_trans hαβ (Nat.le_mul_of_pos_right _ (Nat.succ_pos k))
  have hh₁' : h₁ ∈ IS ^ (β * (k + 1)) := by rwa [pow_mul]
  have h₁AR : h₁ ∈ IS ^ (β * (k + 1) - α) * (IZ ⊓ IS ^ α) := hAR (β * (k + 1)) hm ⟨h₁Z, hh₁'⟩
  have hpow : IS ^ (β * (k + 1) - α) ≤ (IS ^ β) ^ k := by
    rw [← pow_mul]
    exact Ideal.pow_le_pow_right (by rw [Nat.mul_succ]; omega)
  have hb1 : Ideal.map φ (IS ^ (β * (k + 1) - α) * (IZ ⊓ IS ^ α)) ≤
      Ideal.span {G ^ (k + 1)} * IsLocalRing.maximalIdeal R := by
    rw [Ideal.map_mul, ← hgk]
    refine Ideal.mul_mono ?_ (le_trans (Ideal.map_mono inf_le_left) hZm)
    refine le_trans (Ideal.map_mono hpow) ?_
    rw [Ideal.map_pow, ← Ideal.span_singleton_pow]
    exact Ideal.pow_right_mono hSle k
  have hb2 : Ideal.map φ (IZ * (IS ^ β ⊔ IZ) ^ k) ≤
      Ideal.span {G ^ (k + 1)} * IsLocalRing.maximalIdeal R := by
    rw [Ideal.map_mul, Ideal.map_pow, hD, Ideal.span_singleton_pow, ← hgk, mul_comm]
    exact Ideal.mul_mono_right hZm
  rw [← hsum, map_add]
  exact Ideal.add_mem _ (hb1 (Ideal.mem_map_of_mem φ h₁AR)) (hb2 (Ideal.mem_map_of_mem φ hh₂))

/-- **Lemma 3.2, Cases 1/2** (Hironaka 1975, p.531–532). -/
theorem sum_centre_dichotomy (φ : A →+* R) (IZ IS : Ideal A) (α β : ℕ)
    (hαβ : α ≤ β) (hAR : ∀ m, α ≤ m → IZ ⊓ IS ^ m ≤ IS ^ (m - α) * (IZ ⊓ IS ^ α))
    (G : R) (hG : IsRegular G) (hD : Ideal.map φ (IS ^ β ⊔ IZ) = Ideal.span {G}) :
    Ideal.map φ IZ = Ideal.span {G} ∨
      strictIdeal φ IZ (IS ^ β ⊔ IZ) G ≤ IsLocalRing.maximalIdeal R := by
  have hZle : Ideal.map φ IZ ≤ Ideal.span {G} := hD ▸ Ideal.map_mono le_sup_right
  by_cases h1 : ∃ z ∈ IZ, ∃ u : R, IsUnit u ∧ φ z = G * u
  · left
    obtain ⟨z, hz, u, hu, hzu⟩ := h1
    refine le_antisymm hZle ?_
    rw [Ideal.span_le, Set.singleton_subset_iff]
    have hG' : G = φ z * ↑hu.unit⁻¹ := by
      rw [hzu, mul_assoc, IsUnit.mul_val_inv, mul_one]
    rw [hG']
    exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem φ hz)
  · right
    have h1' : ∀ z ∈ IZ, ∀ u : R, IsUnit u → φ z ≠ G * u := fun z hz u hu he =>
      h1 ⟨z, hz, u, hu, he⟩
    have hZm := map_le_span_mul_maximalIdeal φ IZ G hZle h1'
    refine Ideal.span_le.mpr ?_
    intro h' hh'
    obtain ⟨k, h, hh, hφ⟩ := hh'
    have hhZ : h ∈ IZ := hh.1
    have hhD : h ∈ (IS ^ β ⊔ IZ) ^ k := hh.2
    show h' ∈ IsLocalRing.maximalIdeal R
    cases k with
    | zero =>
      rw [pow_zero, one_mul] at hφ
      rw [← hφ]
      obtain ⟨w, hw, hwh⟩ := (Ideal.mem_span_singleton_mul).mp (hZm (Ideal.mem_map_of_mem φ hhZ))
      rw [← hwh]
      exact Ideal.mul_mem_left _ _ hw
    | succ k =>
      obtain ⟨w, hw, hwh⟩ := (Ideal.mem_span_singleton_mul).mp
        (map_mem_of_case2 φ IZ IS α β hαβ hAR G hD hZm k h hhZ hhD)
      have hw' : h' = w := (hG.pow (k + 1)).left
        (show G ^ (k + 1) * h' = G ^ (k + 1) * w by rw [hwh, hφ])
      rw [hw']
      exact hw

/-- Case 1 is exactly "off the strict transform". -/
theorem strictIdeal_eq_top_iff (φ : A →+* R) (IZ IS : Ideal A) (α β : ℕ)
    (hαβ : α ≤ β) (hAR : ∀ m, α ≤ m → IZ ⊓ IS ^ m ≤ IS ^ (m - α) * (IZ ⊓ IS ^ α))
    (G : R) (hG : IsRegular G) (hD : Ideal.map φ (IS ^ β ⊔ IZ) = Ideal.span {G}) :
    strictIdeal φ IZ (IS ^ β ⊔ IZ) G = ⊤ ↔ Ideal.map φ IZ = Ideal.span {G} := by
  constructor
  · intro htop
    rcases sum_centre_dichotomy φ IZ IS α β hαβ hAR G hG hD with h | h
    · exact h
    · exact absurd (htop ▸ h) (fun h' => IsLocalRing.maximalIdeal.isMaximal R |>.ne_top
        (top_le_iff.mp h'))
  · intro hmap
    have hZle : Ideal.map φ IZ ≤ Ideal.span {G} := hmap.le
    by_cases h1 : ∃ z ∈ IZ, ∃ u : R, IsUnit u ∧ φ z = G * u
    · obtain ⟨z, hz, u, hu, hzu⟩ := h1
      rw [Ideal.eq_top_iff_one]
      have hu_mem : u ∈ strictIdeal φ IZ (IS ^ β ⊔ IZ) G :=
        Ideal.subset_span ⟨1, z, ⟨hz, by rw [pow_one]; exact (le_sup_right : IZ ≤ IS ^ β ⊔ IZ) hz⟩,
          by rw [pow_one, hzu]⟩
      have := Ideal.mul_mem_left _ (↑hu.unit⁻¹ : R) hu_mem
      rwa [IsUnit.val_inv_mul] at this
    · exfalso
      have h1' : ∀ z ∈ IZ, ∀ u : R, IsUnit u → φ z ≠ G * u := fun z hz u hu he =>
        h1 ⟨z, hz, u, hu, he⟩
      have hZm := map_le_span_mul_maximalIdeal φ IZ G hZle h1'
      have hGm : G ∈ Ideal.span {G} * IsLocalRing.maximalIdeal R :=
        hZm (hmap ▸ Ideal.subset_span rfl)
      obtain ⟨w, hw, hGw⟩ := (Ideal.mem_span_singleton_mul).mp hGm
      have h1w : (1 : R) = w := hG.left (show G * 1 = G * w by rw [mul_one, hGw])
      exact (IsLocalRing.maximalIdeal.isMaximal R).ne_top
        ((Ideal.eq_top_iff_one _).mpr (h1w ▸ hw))

end ArtinRees

end Hironaka.HironakaG10ChowArtinReesCentre
