import Hironaka.Resolution.HironakaG10PNFixedTargetContinuation
import Hironaka.Resolution.HironakaG10PNIdealModule
import Hironaka.Resolution.HironakaG10PNIdealFamily

/-! The local Noether property of coherent ideal sheaves on original opens of `ℂⁿ` (lane G10P,
run 0080; the ideal form of the Noether property, input of `G10.COMPACT.01`).  Blueprint:
`hironaka-g10-pn-ideal-noether.tex`.

Let `J 0 ≤ J 1 ≤ ⋯` be locally finitely generated ideal families on an original open `U` and
`p ∈ U`.  The stalk ring at `p` is Noetherian, so the stalks stabilize from some `N`.  Shrink `U` to an
original open on which the FIXED ideal `J N` is generated by finitely many global sections `g`; the
uniform continuation `PN.10` of the finitely presented cyclic quotient `𝒪/(g)` gives ONE open
`p ∈ V`, chosen before every `m`, on which every map from a finite-type module to `𝒪/(g)` with zero
stalk at `p` is zero.  Applied to the ideal module of `J m` (`m ≥ N`), this gives `J m ⊆ J N` on `V`.
The restriction of `𝒪/(g)` to `V` is identified with the cyclic quotient of the literally restricted
relation (accepted cokernel comparison), whose coefficients are the restricted generators. -/

set_option autoImplicit false
open Set TopologicalSpace CategoryTheory CategoryTheory.Limits Opposite AlgebraicGeometry
open scoped Manifold

namespace Hironaka.HironakaG10PNIdealNoetherOpen

open HironakaChowNativePrimeSupportContinuation HironakaNativeCyclicCokernelRestriction
  HironakaNativeCanonicalSupportRestriction HironakaNativeOriginalRestrictionComparison
  HironakaG10PNRestrictionExact HironakaG10PNLayerStep HironakaG10PNFixedTargetContinuation
  HironakaG10PNIdealModule HironakaChowNativeModuleStalkExact HironakaSingularModuleSheafStalk
  HironakaChowNativeFreePartContinuation HironakaSmoothCentreRealDomainActualSheafStalk

noncomputable section

variable {n : ℕ}

/-- Stalk-ideal families on an original open. -/
abbrev OStalkFamily (U : Opens (ComplexModel n)) := ∀ x : U, Ideal (OriginalRingStalk U x)

/-! ### Stalk ACC -/

theorem isNoetherianRing_originalStalk (U : Opens (ComplexModel n)) (p : U) :
    IsNoetherianRing (OriginalRingStalk U p) := by
  have : IsNoetherianRing (HolGerm (ComplexModel n)) := isNoetherianRing_holGerm_euclidean n
  exact isNoetherianRing_of_ringEquiv _
    ((actualStalkChartEquiv (n := n) p.val).symm.trans (originalRestrictionStalkEquiv U p))

/-- An ascending chain of stalk ideals at one point stabilizes. -/
theorem exists_stalk_stationary (U : Opens (ComplexModel n)) (p : U) (J : ℕ → OStalkFamily U)
    (hJ : ∀ m x, J m x ≤ J (m + 1) x) : ∃ N : ℕ, ∀ m, N ≤ m → J m p ≤ J N p := by
  have := isNoetherianRing_originalStalk U p
  obtain ⟨N, hN⟩ := (monotone_stabilizes_iff_noetherian (R := OriginalRingStalk U p)
    (M := OriginalRingStalk U p)).mpr inferInstance
    ⟨fun m => J m p, monotone_nat_of_le_succ fun m => hJ m p⟩
  exact ⟨N, fun m hm => (hN m hm).ge⟩

/-! ### Families on an image open -/

/-- The preimage of an open of `U` in the image open of `D`. -/
def imagePre (U : Opens (ComplexModel n)) (D : Opens U) (W : Opens U) :
    Opens (originalImageOpen U D) :=
  (Opens.map (cyclicImageTopMap U D)).obj W

theorem image_imagePre_le (U : Opens (ComplexModel n)) (D : Opens U) (W : Opens U) :
    (cyclicImageFunctor U D).obj (imagePre U D W) ≤ W := by
  rintro x ⟨b, hb, rfl⟩
  exact hb

/-- A section over `W` transported to the image open. -/
def imageSection (U : Opens (ComplexModel n)) (D : Opens U) (W : Opens U)
    (s : (originalOpenStructureSheaf U).presheaf.obj (op W)) :
    (originalOpenStructureSheaf (originalImageOpen U D)).presheaf.obj (op (imagePre U D W)) :=
  originalImageScalarEquiv U D (imagePre U D W)
    ((originalOpenStructureSheaf U).presheaf.map (homOfLE (image_imagePre_le U D W)).op s)

theorem imageSection_germ (U : Opens (ComplexModel n)) (D : Opens U) (W : Opens U)
    (s : (originalOpenStructureSheaf U).presheaf.obj (op W)) (b : originalImageOpen U D)
    (hb : b ∈ imagePre U D W) :
    originalImageStalkRingEquiv U D b
        ((originalOpenStructureSheaf U).presheaf.germ W (originalImageInclusion U D b) hb s) =
      (originalOpenStructureSheaf (originalImageOpen U D)).presheaf.germ (imagePre U D W) b hb
        (imageSection U D W s) := by
  have hres := (originalOpenStructureSheaf U).presheaf.germ_res_apply
    (homOfLE (image_imagePre_le U D W)) (originalImageInclusion U D b) ⟨b, hb, rfl⟩ s
  exact (congrArg (originalImageStalkRingEquiv U D b) hres.symm).trans
    (originalImageStalkRingEquiv_germ U D b (imagePre U D W) hb
      ((originalOpenStructureSheaf U).presheaf.map (homOfLE (image_imagePre_le U D W)).op s))

/-- The family carried to the image open by the accepted stalk equivalences. -/
def imageFamily (U : Opens (ComplexModel n)) (D : Opens U) (J : OStalkFamily U) :
    OStalkFamily (originalImageOpen U D) := fun b =>
  Ideal.map (originalImageStalkRingEquiv U D b).toRingHom (J (originalImageInclusion U D b))

theorem imageFamily_span (U : Opens (ComplexModel n)) (D : Opens U) (J : OStalkFamily U)
    (W : Opens U) {r : ℕ} (s : Fin r → (originalOpenStructureSheaf U).presheaf.obj (op W))
    (hs : ∀ (y : U) (hy : y ∈ W),
      J y = Ideal.span (range fun i => (originalOpenStructureSheaf U).presheaf.germ W y hy (s i)))
    (b : originalImageOpen U D) (hb : b ∈ imagePre U D W) :
    imageFamily U D J b = Ideal.span (range fun i =>
      (originalOpenStructureSheaf (originalImageOpen U D)).presheaf.germ (imagePre U D W) b hb
        (imageSection U D W (s i))) := by
  rw [imageFamily, hs (originalImageInclusion U D b) hb, Ideal.map_span, ← Set.range_comp]
  exact congrArg Ideal.span (congrArg Set.range
    (funext fun i => imageSection_germ U D W (s i) b hb))

theorem imageFamily_isLocallyFinitelyGeneratedIn (U : Opens (ComplexModel n)) (D : Opens U)
    (J : OStalkFamily U) (hJ : IsLocallyFinitelyGeneratedIn (originalOpenStructureSheaf U) J) :
    IsLocallyFinitelyGeneratedIn (originalOpenStructureSheaf (originalImageOpen U D))
      (imageFamily U D J) := by
  intro b
  obtain ⟨W, hbW, r, s, hs⟩ := hJ (originalImageInclusion U D b)
  exact ⟨imagePre U D W, hbW, r, fun i => imageSection U D W (s i),
    fun b' hb' => imageFamily_span U D J W s hs b' hb'⟩

theorem le_of_imageFamily_le (U : Opens (ComplexModel n)) (D : Opens U) (J J' : OStalkFamily U)
    (b : originalImageOpen U D) (h : imageFamily U D J b ≤ imageFamily U D J' b) :
    J (originalImageInclusion U D b) ≤ J' (originalImageInclusion U D b) := by
  have hbij : Function.Bijective (originalImageStalkRingEquiv U D b).toRingHom :=
    (originalImageStalkRingEquiv U D b).bijective
  calc J (originalImageInclusion U D b)
      = Ideal.comap (originalImageStalkRingEquiv U D b).toRingHom
          (imageFamily U D J b) := (Ideal.comap_map_of_bijective _ hbij).symm
    _ ≤ Ideal.comap (originalImageStalkRingEquiv U D b).toRingHom (imageFamily U D J' b) :=
        Ideal.comap_mono h
    _ = J' (originalImageInclusion U D b) := Ideal.comap_map_of_bijective _ hbij

/-- The restricted coefficient has the restricted germ (public form of a private lemma of
`HironakaNativePrimeTargetRestriction`). -/
theorem coefficient_stalk_restrict (U : Opens (ComplexModel n)) (D : Opens U)
    (a : (originalOpenStructureSheaf U).presheaf.obj (op ⊤)) (b : originalImageOpen U D) :
    originalImageStalkRingEquiv U D b
      ((originalOpenStructureSheaf U).presheaf.germ ⊤ (originalImageInclusion U D b)
        (by trivial) a) =
    (originalOpenStructureSheaf (originalImageOpen U D)).presheaf.germ ⊤ b (by trivial)
      (restrictOriginalCoefficient U D a) := by
  have hres := (originalOpenStructureSheaf U).presheaf.germ_res_apply
    (homOfLE (show (cyclicImageFunctor U D).obj ⊤ ≤ ⊤ from le_top))
    (originalImageInclusion U D b) ⟨b, by trivial, rfl⟩ a
  exact (congrArg (originalImageStalkRingEquiv U D b) hres.symm).trans
    (originalImageStalkRingEquiv_germ U D b ⊤ (by trivial)
      ((originalOpenStructureSheaf U).presheaf.map
        (homOfLE (show (cyclicImageFunctor U D).obj ⊤ ≤ ⊤ from le_top)).op a))

/-! ### Zero-stalk rigidity on the final open -/

/-- Zero-stalk rigidity of a target at `p` for natively finite-type sources. -/
def IsRigidAt (V : Opens (ComplexModel n)) (p : V) (T : OriginalModules V) : Prop :=
  ∀ G : OriginalModules V, G.IsFiniteType → ∀ f : G ⟶ T,
    (nativeStalkFunctor (originalOpenStructureSheaf V) p).map f = 0 → f = 0

theorem IsRigidAt.of_iso {V : Opens (ComplexModel n)} {p : V} {T T' : OriginalModules V}
    (e : T ≅ T') (h : IsRigidAt V p T) : IsRigidAt V p T' := by
  intro G hG f hf
  have h0 : f ≫ e.inv = 0 := h G hG (f ≫ e.inv) (by rw [Functor.map_comp, hf, zero_comp])
  calc f = (f ≫ e.inv) ≫ e.hom := by simp
    _ = 0 := by rw [h0, zero_comp]

theorem IsRigidAt.of_transport {E Z : Opens (ComplexModel n)} (e : E = Z) (M : OriginalModules E)
    (x : E) (z : Z) (hxz : x.val = z.val)
    (h : IsRigidAt Z z ((originalModuleCategoryTransport e).obj M)) : IsRigidAt E x M := by
  subst e
  have hx : x = z := Subtype.ext hxz
  subst hx
  exact h

/-- **Rigidity of the restricted cyclic quotient.**  For a relation `δ` on `U` and `p ∈ U` there is
an open `p ∈ D ⊆ U` such that the cyclic quotient of the literally restricted relation on the image
open of `D` is zero-stalk rigid at `p` (uniform continuation PN.10 for `coker δ`, the accepted
restriction comparisons). -/
theorem exists_rigid_restricted_cokernel (U : Opens (ComplexModel n)) (p : U) {r : ℕ}
    (δ : SheafOfModules.free (R := forgetRing (originalOpenStructureSheaf U)) (Fin r) ⟶
      SheafOfModules.unit (forgetRing (originalOpenStructureSheaf U))) :
    ∃ (D : Opens U) (hpD : p ∈ D), IsRigidAt (originalImageOpen U D) ⟨p.val, ⟨p, hpD, rfl⟩⟩
      (cokernel (originalRestrictedCyclicRelation U D δ)) := by
  have hFP : (cokernel δ).IsFinitePresentation :=
    cokernel_to_unit_isFinitePresentation (originalOpenStructureSheaf U) δ
  obtain ⟨V₀, hpV₀, hV₀U, hcont⟩ := @exists_original_uniform_continuation n U (cokernel δ) hFP p
  have hpD : p ∈ inverseImageOpen U V₀ := hpV₀
  refine ⟨inverseImageOpen U V₀, hpD, ?_⟩
  have h1 : IsRigidAt V₀ ⟨p.val, hpV₀⟩ ((restrictTo U V₀ hV₀U).obj (cokernel δ)) := hcont
  have h2 : IsRigidAt (originalImageOpen U (inverseImageOpen U V₀)) ⟨p.val, ⟨p, hpD, rfl⟩⟩
      ((localOriginalRestrictionFunctor U (inverseImageOpen U V₀)).obj (cokernel δ)) :=
    IsRigidAt.of_transport (original_image_inverseImage U V₀ hV₀U) _ _ _ rfl h1
  exact h2.of_iso (((localOriginalRestrictionIso U (inverseImageOpen U V₀)).app (cokernel δ)) ≪≫
    (originalCyclicCokernelRestrictionIso U (inverseImageOpen U V₀) δ).symm)

/-! ### The core: a fixed ideal generated by global sections -/

/-- **Core.**  On an original open `U`, let `J` be locally finitely generated families, `N` a stalk
tail at `p` (`J m p ⊆ J N p` for `m ≥ N`), and let `J N` be generated at every point by the germs of
finitely many GLOBAL sections `g`.  Then ONE open `p ∈ V` satisfies `J m ⊆ J N` on `V` for every
`m ≥ N`. -/
theorem exists_stationary_of_global_generators (U : Opens (ComplexModel n))
    (J : ℕ → OStalkFamily U)
    (hJ : ∀ m, IsLocallyFinitelyGeneratedIn (originalOpenStructureSheaf U) (J m)) (p : U) (N : ℕ)
    (hN : ∀ m, N ≤ m → J m p ≤ J N p) {r : ℕ}
    (g : Fin r → (originalOpenStructureSheaf U).presheaf.obj (op ⊤))
    (hg : ∀ x : U, J N x = Ideal.span
      (range fun i => (originalOpenStructureSheaf U).presheaf.germ ⊤ x (by trivial) (g i))) :
    ∃ V : Opens U, p ∈ V ∧ ∀ m, N ≤ m → ∀ x : U, x ∈ V → J m x ≤ J N x := by
  let δ := cyclicRelationMap (originalOpenStructureSheaf U) g
  obtain ⟨D, hpD, hrig⟩ := exists_rigid_restricted_cokernel U p δ
  have hcoef (b : originalImageOpen U D) : imageFamily U D (J N) b = Ideal.span (range fun i =>
      (originalOpenStructureSheaf (originalImageOpen U D)).presheaf.germ ⊤ b (by trivial)
        (relationCoeff (originalOpenStructureSheaf (originalImageOpen U D))
          (originalRestrictedCyclicRelation U D δ) i)) := by
    rw [imageFamily, hg (originalImageInclusion U D b), Ideal.map_span, ← Set.range_comp]
    refine congrArg Ideal.span (congrArg Set.range (funext fun i => ?_))
    have h1 : relationCoeff (originalOpenStructureSheaf (originalImageOpen U D))
        (originalRestrictedCyclicRelation U D δ) i = restrictOriginalCoefficient U D (g i) :=
      (originalRestrictedCyclicRelation_coefficient U D δ i).trans
        (congrArg (restrictOriginalCoefficient U D)
          (relationCoeff_cyclicRelationMap (originalOpenStructureSheaf U) g i))
    exact (coefficient_stalk_restrict U D (g i) b).trans
      (congrArg ((originalOpenStructureSheaf (originalImageOpen U D)).presheaf.germ ⊤ b
        (by trivial)) h1.symm)
  refine ⟨D, hpD, fun m hm x hx => ?_⟩
  have hp' : imageFamily U D (J m) ⟨p.val, ⟨p, hpD, rfl⟩⟩ ≤ Ideal.span (range fun i =>
      (originalOpenStructureSheaf (originalImageOpen U D)).presheaf.germ ⊤
        ⟨p.val, ⟨p, hpD, rfl⟩⟩ (by trivial)
        (relationCoeff (originalOpenStructureSheaf (originalImageOpen U D))
          (originalRestrictedCyclicRelation U D δ) i)) :=
    (Ideal.map_mono (hN m hm)).trans (hcoef ⟨p.val, ⟨p, hpD, rfl⟩⟩).le
  have hfam := le_span_of_rigid (originalOpenStructureSheaf (originalImageOpen U D))
    (originalRestrictedCyclicRelation U D δ) (imageFamily U D (J m))
    (imageFamily_isLocallyFinitelyGeneratedIn U D (J m) (hJ m)) ⟨p.val, ⟨p, hpD, rfl⟩⟩ hp' hrig
    ⟨x.val, ⟨x, hx, rfl⟩⟩
  exact le_of_imageFamily_le U D (J m) (J N) ⟨x.val, ⟨x, hx, rfl⟩⟩
    (hfam.trans (hcoef ⟨x.val, ⟨x, hx, rfl⟩⟩).ge)

/-! ### The local Noether property on an original open -/

/-- **Local Noether property of coherent ideals on an original open (one neighbourhood and one
tail per point).**  For an ascending chain of locally finitely generated ideal families on an
original open `U` and `p ∈ U` there are `N` and ONE open `p ∈ V ⊆ U` with `J m ⊆ J N` on `V` for every
`m ≥ N`. -/
theorem exists_local_stationary (U : Opens (ComplexModel n)) (J : ℕ → OStalkFamily U)
    (hasc : ∀ m x, J m x ≤ J (m + 1) x)
    (hJ : ∀ m, IsLocallyFinitelyGeneratedIn (originalOpenStructureSheaf U) (J m)) (p : U) :
    ∃ (N : ℕ) (V : Opens U), p ∈ V ∧ ∀ m, N ≤ m → ∀ x : U, x ∈ V → J m x ≤ J N x := by
  obtain ⟨N, hN⟩ := exists_stalk_stationary U p J hasc
  obtain ⟨W, hpW, r, s, hs⟩ := hJ N p
  have htop : (⊤ : Opens (originalImageOpen U W)) ≤ imagePre U W W := by
    intro b _
    obtain ⟨u, hu, hub⟩ := b.property
    have h : u = originalImageInclusion U W b := Subtype.ext hub
    show originalImageInclusion U W b ∈ W
    exact h ▸ hu
  let g : Fin r → (originalOpenStructureSheaf (originalImageOpen U W)).presheaf.obj (op ⊤) :=
    fun i => (originalOpenStructureSheaf (originalImageOpen U W)).presheaf.map (homOfLE htop).op
      (imageSection U W W (s i))
  have hg (b : originalImageOpen U W) : imageFamily U W (J N) b = Ideal.span (range fun i =>
      (originalOpenStructureSheaf (originalImageOpen U W)).presheaf.germ ⊤ b (by trivial)
        (g i)) := by
    rw [imageFamily_span U W (J N) W s hs b (htop (by trivial))]
    exact congrArg Ideal.span (congrArg Set.range (funext fun i =>
      ((originalOpenStructureSheaf (originalImageOpen U W)).presheaf.germ_res_apply
        (homOfLE htop) b (by trivial) (imageSection U W W (s i))).symm))
  obtain ⟨V₂, hpV₂, hV₂⟩ := exists_stationary_of_global_generators (originalImageOpen U W)
    (fun m => imageFamily U W (J m))
    (fun m => imageFamily_isLocallyFinitelyGeneratedIn U W (J m) (hJ m))
    ⟨p.val, ⟨p, hpW, rfl⟩⟩ N (fun m hm => Ideal.map_mono (hN m hm)) g hg
  refine ⟨N, (cyclicImageFunctor U W).obj V₂, ⟨⟨p.val, ⟨p, hpW, rfl⟩⟩, hpV₂, rfl⟩, ?_⟩
  intro m hm x hx
  obtain ⟨b, hb, hbx⟩ : ∃ b ∈ V₂, cyclicImageTopMap U W b = x := hx
  subst hbx
  exact le_of_imageFamily_le U W (J m) (J N) b (hV₂ m hm b hb)

/-! ### The locally ringed spaces of original opens -/

open HironakaG10PNIdealFamily

/-- An original open as a locally ringed space; its structure sheaf is `originalOpenStructureSheaf`. -/
abbrev openSpace (U : Opens (ComplexModel n)) : LocallyRingedSpace.{0} :=
  (originalSpace n).restrict (Opens.isOpenEmbedding (X := TopCat.of (ComplexModel n)) U)

/-- **The local Noether property of an original open of `ℂⁿ`.** -/
theorem hasLocalNoetherProperty_openSpace (U : Opens (ComplexModel n)) :
    HasLocalNoetherProperty (openSpace U) := by
  intro J hasc hJ p
  obtain ⟨N, V, hpV, hV⟩ := exists_local_stationary U J hasc hJ p
  exact ⟨N, V, hpV, hV⟩

/-- **The local Noether property of an open of `ℂⁿ` as a complex manifold** (transport along
mathlib's restriction isomorphism). -/
theorem hasLocalNoetherProperty_manifoldOpen (U : Opens (ComplexModel n)) :
    HasLocalNoetherProperty (ChartedSpace.locallyRingedSpace 𝓘(ℂ, ComplexModel n) U) := by
  apply hasLocalNoetherProperty_of_openImmersions
  intro x
  let e := ChartedSpace.restrictLocallyRingedSpaceIso (IM := 𝓘(ℂ, ComplexModel n))
    (M := ComplexModel n) U
  refine ⟨_, e.hom, inferInstance, hasLocalNoetherProperty_openSpace U, e.inv.base x, ?_⟩
  exact congrArg (fun f => f.base x) e.inv_hom_id

end

end Hironaka.HironakaG10PNIdealNoetherOpen
