/-- The actual exponent sum is the genuine polynomial monomial degree. -/
theorem normalExponentDegree_eq_degree (t : ℕ) (α : Fin t →₀ ℕ) :
    normalExponentDegree α = α.degree := by
  exact (Finsupp.degree_eq_sum α).symm

/-- Every actual original normal monomial belongs to its true original ideal power. -/
theorem normalExponentMonomial_mem_pow (d t : ℕ) (α : Fin t →₀ ℕ) :
    normalExponentMonomial d t α ∈ normalIdeal d t ^ normalExponentDegree α := by
  have h : (∏ i : Fin t, normalCoordinate d t i ^ α i) ∈
      ∏ i : Fin t, normalIdeal d t ^ α i :=
    Ideal.prod_mem_prod (fun i _ => Ideal.pow_mem_pow (show normalCoordinate d t i ∈ normalIdeal d t from Ideal.subset_span ⟨i,rfl⟩) (α i))
  simpa only [normalExponentMonomial, Finset.prod_pow_eq_pow_sum, normalExponentDegree] using h

/-- Homogeneous normal polynomials evaluate into the WHOLE actual original normal power. -/
theorem normalPolynomialEval_mem_pow_of_homogeneous (d t q : ℕ)
    (P : MvPolynomial (Fin t) (HolGerm (ComplexModel d))) (hP : P.IsHomogeneous q) :
    normalPolynomialEval d t P ∈ normalIdeal d t ^ q := by
  classical
  rw [P.as_sum, map_sum]
  apply Ideal.sum_mem
  intro α hα
  have hd : normalExponentDegree α = q := by
    rw [normalExponentDegree_eq_degree]
    simpa only [Finsupp.degree_apply] using (hP.degree_eq_sum_deg_support hα).symm
  rw [normalPolynomialEval_monomial, ← hd]
  exact Ideal.mul_mem_left _ _ (normalExponentMonomial_mem_pow d t α)

/-- Internally produced genuine homogeneous representatives for every WHOLE original normal-power germ. -/
theorem exists_homogeneous_normal_polynomial_representative (d t q : ℕ)
    (g : HolGerm (ComplexModel (d+t))) (hg : g ∈ normalIdeal d t ^ q) :
    ∃ P : MvPolynomial (Fin t) (HolGerm (ComplexModel d)),
      P.IsHomogeneous q ∧ g-normalPolynomialEval d t P ∈ normalIdeal d t ^ (q+1) := by
  classical
  let := tangentAlgebra d t
  let := normalExponentFintype t (q+1)
  obtain ⟨a, ha⟩ := exists_normalMonomial_coefficient_representative d t (q+1) g
  let P := ∑ α : normalExponentIndex t (q+1), MvPolynomial.monomial α.val (a α)
  have hrem : g-normalPolynomialEval d t P ∈ normalIdeal d t ^ (q+1) := by
    simpa only [P, map_sum, normalPolynomialEval_monomial] using ha
  have hev : normalPolynomialEval d t P ∈ normalIdeal d t ^ q := by
    have hr : g-normalPolynomialEval d t P ∈ normalIdeal d t ^ q :=
      Ideal.pow_le_pow_right (by omega) hrem
    simpa only [sub_sub_cancel] using (normalIdeal d t ^ q).sub_mem hg hr
  refine ⟨P, ?_, hrem⟩
  apply MvPolynomial.IsHomogeneous.sum
  intro α _
  by_cases hd : normalExponentDegree α.val = q
  · exact MvPolynomial.isHomogeneous_monomial _ ((normalExponentDegree_eq_degree t α.val).symm.trans hd)
  · have hlt : normalExponentDegree α.val < q := by have := α.property; omega
    have hz := coefficient_eq_zero_of_normalPolynomialEval_mem d t q P α.val hlt hev
    have hc := coefficient_normalMonomialCombination_polynomial d t (q+1) a α
    change MvPolynomial.coeff α.val P = a α at hc
    rw [hc] at hz
    rw [hz, MvPolynomial.monomial_zero]
    exact MvPolynomial.isHomogeneous_zero (Fin t) (HolGerm (ComplexModel d)) q

/-- A literal original J-adic layer: the actual image of J^q in R/(I+J^(q+1)). -/
def originalNormalGradedPiece (d t : ℕ) (I : Ideal (HolGerm (ComplexModel (d+t)))) (q : ℕ) :
    letI := tangentAlgebra d t
    Submodule (HolGerm (ComplexModel d))
      (HolGerm (ComplexModel (d+t)) ⧸ (I ⊔ normalIdeal d t ^ (q+1))) :=
  letI := tangentAlgebra d t
  ((normalIdeal d t ^ q).restrictScalars (HolGerm (ComplexModel d))).map
    (Ideal.Quotient.mkₐ (HolGerm (ComplexModel d)) (I ⊔ normalIdeal d t ^ (q+1))).toLinearMap

/-- The true additive group on each literal original layer is inherited from its actual submodule. -/
instance originalNormalGradedPieceAddCommGroup (d t : ℕ)
    (I : Ideal (HolGerm (ComplexModel (d+t)))) (q : ℕ) :
    AddCommGroup (originalNormalGradedPiece d t I q) :=
  letI := tangentAlgebra d t
  Submodule.addCommGroup (originalNormalGradedPiece d t I q)

/-- The literal original associated graded B-module, with actual original power-image summands. -/
abbrev originalNormalAssociatedGraded (d t : ℕ) (I : Ideal (HolGerm (ComplexModel (d+t)))) :=
  letI := tangentAlgebra d t
  ⨁ q : ℕ, originalNormalGradedPiece d t I q

/-- True homogeneous normal polynomial evaluation into the literal original layer. -/
def homogeneousNormalSymbolMap (d t : ℕ) (I : Ideal (HolGerm (ComplexModel (d+t)))) (q : ℕ) :
    letI := tangentAlgebra d t
    MvPolynomial.homogeneousSubmodule (Fin t) (HolGerm (ComplexModel d)) q →ₗ[HolGerm (ComplexModel d)]
      originalNormalGradedPiece d t I q :=
  letI := tangentAlgebra d t
  (((Ideal.Quotient.mkₐ (HolGerm (ComplexModel d)) (I ⊔ normalIdeal d t ^ (q+1))).toLinearMap.comp
    (normalPolynomialEval d t).toLinearMap).comp
      (MvPolynomial.homogeneousSubmodule (Fin t) (HolGerm (ComplexModel d)) q).subtype).codRestrict
    (originalNormalGradedPiece d t I q) (fun P => ⟨normalPolynomialEval d t P.val,
      normalPolynomialEval_mem_pow_of_homogeneous d t q P.val P.property,rfl⟩)

/-- Every literal original layer is internally generated by true homogeneous normal polynomials. -/
theorem homogeneousNormalSymbolMap_surjective (d t : ℕ) (I : Ideal (HolGerm (ComplexModel (d+t))))
    (q : ℕ) : let := tangentAlgebra d t
    Function.Surjective (homogeneousNormalSymbolMap d t I q) := by
  let := tangentAlgebra d t
  dsimp only
  rintro ⟨x,hx⟩
  obtain ⟨g,hg,hgx⟩ := hx
  obtain ⟨P,hP,hrem⟩ := exists_homogeneous_normal_polynomial_representative d t q g hg
  refine ⟨⟨P,hP⟩,Subtype.ext ?_⟩
  change Ideal.Quotient.mk (I ⊔ normalIdeal d t ^ (q+1)) (normalPolynomialEval d t P) = x
  rw [← hgx]
  apply Ideal.Quotient.eq.mpr
  have hn := (I ⊔ normalIdeal d t ^ (q+1)).neg_mem ((show normalIdeal d t ^ (q+1) ≤ I ⊔ normalIdeal d t ^ (q+1) from le_sup_right) hrem)
  simpa only [neg_sub] using hn

/-- Actual polynomial homogeneous decomposition followed by actual original layer symbols. -/
def normalAssociatedSymbolMap (d t : ℕ) (I : Ideal (HolGerm (ComplexModel (d+t)))) :
    letI := tangentAlgebra d t
    MvPolynomial (Fin t) (HolGerm (ComplexModel d)) →ₗ[HolGerm (ComplexModel d)]
      originalNormalAssociatedGraded d t I :=
  letI := tangentAlgebra d t
  letI : DirectSum.Decomposition (MvPolynomial.homogeneousSubmodule (Fin t) (HolGerm (ComplexModel d))) :=
    MvPolynomial.decomposition
  (DirectSum.lmap (fun q => homogeneousNormalSymbolMap d t I q)).comp
    (DirectSum.decomposeLinearEquiv (MvPolynomial.homogeneousSubmodule (Fin t) (HolGerm (ComplexModel d)))).toLinearMap

/-- A genuine whole normal polynomial surjection onto the literal original associated graded module. -/
theorem normalAssociatedSymbolMap_surjective (d t : ℕ) (I : Ideal (HolGerm (ComplexModel (d+t)))) :
    let := tangentAlgebra d t
    Function.Surjective (normalAssociatedSymbolMap d t I) := by
  let := tangentAlgebra d t
  let : DirectSum.Decomposition (MvPolynomial.homogeneousSubmodule (Fin t) (HolGerm (ComplexModel d))) :=
    MvPolynomial.decomposition
  exact (DirectSum.lmap_surjective (fun q => homogeneousNormalSymbolMap d t I q)).mpr
    (fun q => homogeneousNormalSymbolMap_surjective d t I q) |>.comp
      (DirectSum.decomposeLinearEquiv (MvPolynomial.homogeneousSubmodule (Fin t) (HolGerm (ComplexModel d)))).surjective

/-- Actual degree-q symbol is the WHOLE original class of the true homogeneous component evaluation. -/
theorem normalAssociatedSymbolMap_component (d t : ℕ) (I : Ideal (HolGerm (ComplexModel (d+t))))
    (P : MvPolynomial (Fin t) (HolGerm (ComplexModel d))) (q : ℕ) :
    let := tangentAlgebra d t
    ((normalAssociatedSymbolMap d t I P) q).val =
      Ideal.Quotient.mk (I ⊔ normalIdeal d t ^ (q+1))
        (normalPolynomialEval d t (MvPolynomial.homogeneousComponent q P)) := by
  let := tangentAlgebra d t
  change Ideal.Quotient.mk (I ⊔ normalIdeal d t ^ (q+1))
      (normalPolynomialEval d t (MvPolynomial.decomposition.decompose' P q).val) = _
  rw [MvPolynomial.decomposition.decompose'_apply]

/-- The COMPLETE whole kernel dictionary uses entire homogeneous components and original power remainders. -/
theorem normalAssociatedSymbolMap_eq_zero_iff (d t : ℕ) (I : Ideal (HolGerm (ComplexModel (d+t))))
    (P : MvPolynomial (Fin t) (HolGerm (ComplexModel d))) :
    let := tangentAlgebra d t
    normalAssociatedSymbolMap d t I P = 0 ↔ ∀ q : ℕ,
      normalPolynomialEval d t (MvPolynomial.homogeneousComponent q P) ∈ I ⊔ normalIdeal d t ^ (q+1) := by
  let := tangentAlgebra d t
  constructor
  · intro h q
    have he := congrArg (fun x : originalNormalAssociatedGraded d t I => (x q).val) h
    rw [normalAssociatedSymbolMap_component] at he
    exact Ideal.Quotient.eq_zero_iff_mem.mp he
  · intro h
    ext q
    rw [normalAssociatedSymbolMap_component]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (h q)

/-- An actual homogeneous polynomial has zero literal original symbol precisely through its original whole remainder. -/
theorem normalAssociatedSymbolMap_eq_zero_of_homogeneous (d t q : ℕ)
    (I : Ideal (HolGerm (ComplexModel (d+t))))
    (P : MvPolynomial (Fin t) (HolGerm (ComplexModel d))) (hP : P.IsHomogeneous q)
    (hmem : normalPolynomialEval d t P ∈ I ⊔ normalIdeal d t ^ (q+1)) :
    let := tangentAlgebra d t
    normalAssociatedSymbolMap d t I P = 0 := by
  let := tangentAlgebra d t
  apply (normalAssociatedSymbolMap_eq_zero_iff d t I P).mpr
  intro n
  rw [MvPolynomial.homogeneousComponent_of_mem hP]
  split_ifs with hn
  · subst n; exact hmem
  · rw [map_zero]
    exact (I ⊔ normalIdeal d t ^ (n+1)).zero_mem

/-- Genuine homogeneous multiplication preserves the whole original J-adic remainder with the true summed degree. -/
theorem homogeneous_normalPolynomialEval_mul_mem_remainder (d t r q : ℕ)
    (I : Ideal (HolGerm (ComplexModel (d+t))))
    (P Q : MvPolynomial (Fin t) (HolGerm (ComplexModel d))) (hP : P.IsHomogeneous r)
    (hQ : normalPolynomialEval d t Q ∈ I ⊔ normalIdeal d t ^ (q+1)) :
    normalPolynomialEval d t (P*Q) ∈ I ⊔ normalIdeal d t ^ (r+q+1) := by
  rcases Submodule.mem_sup.mp hQ with ⟨a,ha,b,hb,he⟩
  rw [map_mul, ← he, mul_add]
  apply (I ⊔ normalIdeal d t ^ (r+q+1)).add_mem
  · exact (show I ≤ I ⊔ normalIdeal d t ^ (r+q+1) from le_sup_left) (I.mul_mem_left _ ha)
  · apply (show normalIdeal d t ^ (r+q+1) ≤ I ⊔ normalIdeal d t ^ (r+q+1) from le_sup_right)
    have hp := Ideal.mul_mem_mul (normalPolynomialEval_mem_pow_of_homogeneous d t r P hP) hb
    simpa only [← pow_add, Nat.add_assoc] using hp

/-- The COMPLETE actual symbol kernel is internally closed under arbitrary polynomial multiplication. -/
theorem normalAssociatedSymbolMap_mul_eq_zero (d t : ℕ)
    (I : Ideal (HolGerm (ComplexModel (d+t))))
    (P Q : MvPolynomial (Fin t) (HolGerm (ComplexModel d))) :
    let := tangentAlgebra d t
    normalAssociatedSymbolMap d t I Q = 0 → normalAssociatedSymbolMap d t I (P*Q) = 0 := by
  classical
  let := tangentAlgebra d t
  dsimp only
  intro hQ
  have hcomp := (normalAssociatedSymbolMap_eq_zero_iff d t I Q).mp hQ
  induction P using MvPolynomial.induction_on' with
  | monomial α a =>
    rw [← MvPolynomial.sum_homogeneousComponent Q, Finset.mul_sum, map_sum]
    apply Finset.sum_eq_zero
    intro q _
    have hP : (MvPolynomial.monomial α a).IsHomogeneous α.degree :=
      MvPolynomial.isHomogeneous_monomial a rfl
    exact normalAssociatedSymbolMap_eq_zero_of_homogeneous d t (α.degree+q) I _
      (hP.mul (MvPolynomial.homogeneousComponent_isHomogeneous q Q))
      (homogeneous_normalPolynomialEval_mul_mem_remainder d t α.degree q I _ _ hP (hcomp q))
  | add P P' hP hP' =>
    rw [add_mul, map_add, hP, hP', add_zero]

/-- The WHOLE original initial kernel ideal, internally produced by actual literal symbol evaluation. -/
def originalNormalInitialIdeal (d t : ℕ) (I : Ideal (HolGerm (ComplexModel (d+t)))) :
    Ideal (MvPolynomial (Fin t) (HolGerm (ComplexModel d))) := by
  let := tangentAlgebra d t
  exact {
    carrier := {P | normalAssociatedSymbolMap d t I P = 0}
    zero_mem' := map_zero _
    add_mem' := fun hP hQ => by
      change normalAssociatedSymbolMap d t I (_+_) = 0
      rw [map_add,hP,hQ,add_zero]
    smul_mem' := fun P _Q hQ => normalAssociatedSymbolMap_mul_eq_zero d t I P _Q hQ }

/-- The actual initial ideal is the complete original whole symbol-map kernel. -/
theorem originalNormalInitialIdeal_eq_ker (d t : ℕ) (I : Ideal (HolGerm (ComplexModel (d+t)))) :
    let := tangentAlgebra d t
    (originalNormalInitialIdeal d t I).restrictScalars (HolGerm (ComplexModel d)) =
      LinearMap.ker (normalAssociatedSymbolMap d t I) := by
  let := tangentAlgebra d t
  rfl

/-- True homogeneous whole normal polynomial representatives are unique modulo the NEXT original ideal power. -/
theorem homogeneous_normal_polynomial_unique (d t q : ℕ)
    (P Q : MvPolynomial (Fin t) (HolGerm (ComplexModel d)))
    (hP : P.IsHomogeneous q) (hQ : Q.IsHomogeneous q)
    (hrem : normalPolynomialEval d t P-normalPolynomialEval d t Q ∈ normalIdeal d t ^ (q+1)) :
    P = Q := by
  apply MvPolynomial.ext
  intro α
  by_cases hd : α.degree = q
  · have hlt : normalExponentDegree α < q+1 := by rw [normalExponentDegree_eq_degree,hd]; omega
    have hz := coefficient_eq_zero_of_normalPolynomialEval_mem d t (q+1) (P-Q) α hlt
      (by simpa only [map_sub] using hrem)
    simpa only [MvPolynomial.coeff_sub, sub_eq_zero] using hz
  · rw [hP.coeff_eq_zero hd,hQ.coeff_eq_zero hd]

/-- The actual normal initial symbol is internally chosen from genuine original homogeneous representatives. -/
def originalNormalInitialSymbol (d t q : ℕ) (g : HolGerm (ComplexModel (d+t)))
    (hg : g ∈ normalIdeal d t ^ q) : MvPolynomial (Fin t) (HolGerm (ComplexModel d)) :=
  Classical.choose (exists_homogeneous_normal_polynomial_representative d t q g hg)

/-- Each actual original initial symbol is truly homogeneous of its actual degree. -/
theorem originalNormalInitialSymbol_homogeneous (d t q : ℕ) (g : HolGerm (ComplexModel (d+t)))
    (hg : g ∈ normalIdeal d t ^ q) : (originalNormalInitialSymbol d t q g hg).IsHomogeneous q :=
  (Classical.choose_spec (exists_homogeneous_normal_polynomial_representative d t q g hg)).1

/-- Each actual original initial symbol has its true whole next-power remainder. -/
theorem originalNormalInitialSymbol_remainder (d t q : ℕ) (g : HolGerm (ComplexModel (d+t)))
    (hg : g ∈ normalIdeal d t ^ q) :
    g-normalPolynomialEval d t (originalNormalInitialSymbol d t q g hg) ∈ normalIdeal d t ^ (q+1) :=
  (Classical.choose_spec (exists_homogeneous_normal_polynomial_representative d t q g hg)).2

/-- The TRUE original germ family that supplies the homogeneous complete kernel relations. -/
abbrev originalNormalRelationIndex (d t : ℕ) (I : Ideal (HolGerm (ComplexModel (d+t)))) :=
  Σ q : ℕ, {g : HolGerm (ComplexModel (d+t)) // g ∈ I ∧ g ∈ normalIdeal d t ^ q}

/-- The actual homogeneous relation polynomial supplied by its ORIGINAL germ and degree. -/
def originalNormalRelation (d t : ℕ) (I : Ideal (HolGerm (ComplexModel (d+t))))
    (a : originalNormalRelationIndex d t I) : MvPolynomial (Fin t) (HolGerm (ComplexModel d)) :=
  originalNormalInitialSymbol d t a.1 a.2.val a.2.property.2

/-- Every actual original germ relation belongs to the internally produced WHOLE initial kernel ideal. -/
theorem originalNormalRelation_mem_initialIdeal (d t : ℕ)
    (I : Ideal (HolGerm (ComplexModel (d+t)))) (a : originalNormalRelationIndex d t I) :
    originalNormalRelation d t I a ∈ originalNormalInitialIdeal d t I := by
  let := tangentAlgebra d t
  apply normalAssociatedSymbolMap_eq_zero_of_homogeneous d t a.1 I _
    (originalNormalInitialSymbol_homogeneous d t a.1 a.2.val a.2.property.2)
  have hg : a.2.val ∈ I ⊔ normalIdeal d t ^ (a.1+1) :=
    (show I ≤ I ⊔ normalIdeal d t ^ (a.1+1) from le_sup_left) a.2.property.1
  have hr : a.2.val-normalPolynomialEval d t (originalNormalRelation d t I a) ∈
      I ⊔ normalIdeal d t ^ (a.1+1) :=
    (show normalIdeal d t ^ (a.1+1) ≤ I ⊔ normalIdeal d t ^ (a.1+1) from le_sup_right)
      (originalNormalInitialSymbol_remainder d t a.1 a.2.val a.2.property.2)
  simpa only [originalNormalRelation,sub_sub_cancel] using (I ⊔ normalIdeal d t ^ (a.1+1)).sub_mem hg hr

/-- Every true homogeneous original kernel relation comes from an ACTUAL original ideal germ. -/
theorem exists_original_germ_homogeneous_kernel_relation (d t q : ℕ)
    (I : Ideal (HolGerm (ComplexModel (d+t))))
    (P : MvPolynomial (Fin t) (HolGerm (ComplexModel d))) (hP : P.IsHomogeneous q)
    (hmem : normalPolynomialEval d t P ∈ I ⊔ normalIdeal d t ^ (q+1)) :
    ∃ a : originalNormalRelationIndex d t I, a.1=q ∧ originalNormalRelation d t I a=P := by
  rcases Submodule.mem_sup.mp hmem with ⟨g,hg,b,hb,he⟩
  have hbg : b ∈ normalIdeal d t ^ q := Ideal.pow_le_pow_right (by omega) hb
  have hgp : g ∈ normalIdeal d t ^ q := by
    have hsub := (normalIdeal d t ^ q).sub_mem
      (normalPolynomialEval_mem_pow_of_homogeneous d t q P hP) hbg
    simpa only [← he, add_sub_cancel_right] using hsub
  let a : originalNormalRelationIndex d t I := ⟨q,⟨g,hg,hgp⟩⟩
  refine ⟨a,rfl,?_⟩
  apply homogeneous_normal_polynomial_unique d t q _ P
    (originalNormalInitialSymbol_homogeneous d t q g hgp) hP
  have hr := originalNormalInitialSymbol_remainder d t q g hgp
  have hdiff : g-normalPolynomialEval d t P ∈ normalIdeal d t ^ (q+1) := by
    simpa only [← he, sub_add_cancel_left] using (normalIdeal d t ^ (q+1)).neg_mem hb
  have hn := (normalIdeal d t ^ (q+1)).sub_mem hdiff hr
  simpa only [sub_sub_sub_cancel_left] using hn

/-- Actual entire original homogeneous symbols generate the COMPLETE whole normal initial kernel. -/
theorem originalNormalInitialIdeal_eq_span_original_relations (d t : ℕ)
    (I : Ideal (HolGerm (ComplexModel (d+t)))) :
    originalNormalInitialIdeal d t I = Ideal.span (range (originalNormalRelation d t I)) := by
  let := tangentAlgebra d t
  apply le_antisymm
  · intro P hP
    have hcomp := (normalAssociatedSymbolMap_eq_zero_iff d t I P).mp hP
    rw [← MvPolynomial.sum_homogeneousComponent P]
    apply Ideal.sum_mem
    intro q _
    obtain ⟨a,_ha,he⟩ := exists_original_germ_homogeneous_kernel_relation d t q I _
      (MvPolynomial.homogeneousComponent_isHomogeneous q P) (hcomp q)
    rw [← he]
    exact Ideal.subset_span ⟨a,rfl⟩
  · exact Ideal.span_le.mpr (fun _ ⟨a,ha⟩ => ha ▸ originalNormalRelation_mem_initialIdeal d t I a)

/-- The actual whole original initial kernel ideal is homogeneous under the TRUE polynomial grading. -/
theorem originalNormalInitialIdeal_homogeneous (d t : ℕ)
    (I : Ideal (HolGerm (ComplexModel (d+t)))) :
    let := tangentAlgebra d t
    let := MvPolynomial.gradedAlgebra (σ := Fin t) (R := HolGerm (ComplexModel d))
    (originalNormalInitialIdeal d t I).IsHomogeneous
      (MvPolynomial.homogeneousSubmodule (Fin t) (HolGerm (ComplexModel d))) := by
  let := tangentAlgebra d t
  let := MvPolynomial.gradedAlgebra (σ := Fin t) (R := HolGerm (ComplexModel d))
  rw [originalNormalInitialIdeal_eq_span_original_relations]
  apply Ideal.homogeneous_span
  rintro _ ⟨a,rfl⟩
  exact ⟨a.1,originalNormalInitialSymbol_homogeneous d t a.1 a.2.val a.2.property.2⟩

/-- TRUE Noetherianity internally extracts a FINITE SUBSET of actual original homogeneous germ relations. -/
theorem exists_finite_originalNormalRelations (d t : ℕ)
    (I : Ideal (HolGerm (ComplexModel (d+t)))) :
    ∃ S : Finset (MvPolynomial (Fin t) (HolGerm (ComplexModel d))),
      (S : Set _) ⊆ range (originalNormalRelation d t I) ∧
      originalNormalInitialIdeal d t I = Ideal.span (S : Set (MvPolynomial (Fin t) (HolGerm (ComplexModel d)))) := by
  let := isNoetherianRing_holGerm_euclidean d
  have hf : (Ideal.span (range (originalNormalRelation d t I))).FG :=
    IsNoetherian.noetherian _
  obtain ⟨S,hS,hspan⟩ := (Submodule.fg_span_iff_fg_span_finset_subset
    (R := MvPolynomial (Fin t) (HolGerm (ComplexModel d))) (range (originalNormalRelation d t I))).mp hf
  exact ⟨S,hS,(originalNormalInitialIdeal_eq_span_original_relations d t I).trans hspan⟩

/-- The literal original associated graded module is the TRUE entire polynomial quotient by its complete actual initial ideal. -/
def originalNormalAssociatedGradedQuotientEquiv (d t : ℕ)
    (I : Ideal (HolGerm (ComplexModel (d+t)))) :
    letI := tangentAlgebra d t
    (MvPolynomial (Fin t) (HolGerm (ComplexModel d)) ⧸ originalNormalInitialIdeal d t I)
      ≃ₗ[HolGerm (ComplexModel d)] originalNormalAssociatedGraded d t I :=
  letI := tangentAlgebra d t
  (Submodule.quotEquivOfEq _ _ (originalNormalInitialIdeal_eq_ker d t I)).trans
    ((normalAssociatedSymbolMap d t I).quotKerEquivOfSurjective (normalAssociatedSymbolMap_surjective d t I))

/-- Actual FINITE HOMOGENEOUS original relations present the SAME literal associated graded, ALL degrees simultaneously. -/
theorem exists_finite_originalNormalAssociatedGraded_presentation (d t : ℕ)
    (I : Ideal (HolGerm (ComplexModel (d+t)))) :
    let := tangentAlgebra d t
    ∃ S : Finset (MvPolynomial (Fin t) (HolGerm (ComplexModel d))),
      (∀ P ∈ S, ∃ a : originalNormalRelationIndex d t I,
        P=originalNormalRelation d t I a ∧ P.IsHomogeneous a.1) ∧
      Nonempty ((MvPolynomial (Fin t) (HolGerm (ComplexModel d)) ⧸ Ideal.span (S : Set (MvPolynomial (Fin t) (HolGerm (ComplexModel d)))))
        ≃ₗ[HolGerm (ComplexModel d)] originalNormalAssociatedGraded d t I) := by
  let := tangentAlgebra d t
  obtain ⟨S,hS,hspan⟩ := exists_finite_originalNormalRelations d t I
  refine ⟨S,?_,?_⟩
  · intro P hP
    obtain ⟨a,ha⟩ := hS hP
    refine ⟨a,ha.symm,?_⟩
    rw [← ha]
    exact originalNormalInitialSymbol_homogeneous d t a.1 a.2.val a.2.property.2
  · exact ⟨(Submodule.quotEquivOfEq _ _ (congrArg
      (fun J : Ideal (MvPolynomial (Fin t) (HolGerm (ComplexModel d))) =>
        J.restrictScalars (HolGerm (ComplexModel d))) hspan.symm)).trans
      (originalNormalAssociatedGradedQuotientEquiv d t I)⟩

/-- The true J^q image in the literal ORIGINAL quotient R/I, before the graded-layer quotient. -/
def originalNormalPowerImage (d t : ℕ) (I : Ideal (HolGerm (ComplexModel (d+t)))) (q : ℕ) :
    letI := tangentAlgebra d t
    Submodule (HolGerm (ComplexModel d)) (HolGerm (ComplexModel (d+t)) ⧸ I) :=
  letI := tangentAlgebra d t
  ((normalIdeal d t ^ q).restrictScalars (HolGerm (ComplexModel d))).map
    (Ideal.Quotient.mkₐ (HolGerm (ComplexModel d)) I).toLinearMap

/-- Actual original quotient power images form the TRUE decreasing J-adic filtration. -/
theorem originalNormalPowerImage_succ_le (d t : ℕ) (I : Ideal (HolGerm (ComplexModel (d+t))))
    (q : ℕ) : let := tangentAlgebra d t
    originalNormalPowerImage d t I (q+1) ≤ originalNormalPowerImage d t I q := by
  let := tangentAlgebra d t
  dsimp only
  rintro x ⟨g,hg,he⟩
  exact ⟨g,Ideal.pow_le_pow_right (by omega) hg,he⟩

/-- Actual quotient factor sends the original J^q image to its literal graded layer. -/
def originalNormalGradedStepMap (d t : ℕ) (I : Ideal (HolGerm (ComplexModel (d+t)))) (q : ℕ) :
    letI := tangentAlgebra d t
    originalNormalPowerImage d t I q →ₗ[HolGerm (ComplexModel d)] originalNormalGradedPiece d t I q := by
  letI := tangentAlgebra d t
  let F := (Ideal.Quotient.factorₐ (HolGerm (ComplexModel d))
    (show I ≤ I ⊔ normalIdeal d t ^ (q+1) from le_sup_left)).toLinearMap
  exact (F.comp (originalNormalPowerImage d t I q).subtype).codRestrict
    (originalNormalGradedPiece d t I q) (fun x => by
      obtain ⟨g,hg,he⟩ := x.property
      refine ⟨g,hg,?_⟩
      change Ideal.Quotient.mk (I ⊔ normalIdeal d t ^ (q+1)) g = F x.val
      rw [← he]
      rfl)

/-- Every true original graded-layer class comes from the ACTUAL power image in R/I. -/
theorem originalNormalGradedStepMap_surjective (d t : ℕ)
    (I : Ideal (HolGerm (ComplexModel (d+t)))) (q : ℕ) :
    let := tangentAlgebra d t
    Function.Surjective (originalNormalGradedStepMap d t I q) := by
  let := tangentAlgebra d t
  dsimp only
  rintro ⟨x,hx⟩
  obtain ⟨g,hg,he⟩ := hx
  refine ⟨⟨Ideal.Quotient.mk I g,⟨g,hg,rfl⟩⟩,Subtype.ext ?_⟩
  exact he

/-- The true original graded-step kernel is EXACTLY the next actual power image in the original quotient. -/
theorem ker_originalNormalGradedStepMap (d t : ℕ)
    (I : Ideal (HolGerm (ComplexModel (d+t)))) (q : ℕ) :
    let := tangentAlgebra d t
    LinearMap.ker (originalNormalGradedStepMap d t I q) =
      (originalNormalPowerImage d t I (q+1)).comap (originalNormalPowerImage d t I q).subtype := by
  let := tangentAlgebra d t
  ext x
  obtain ⟨g,hg,he⟩ := x.property
  constructor
  · intro hx
    have hf := congrArg Subtype.val hx
    change Ideal.Quotient.factorₐ (HolGerm (ComplexModel d))
      (show I ≤ I ⊔ normalIdeal d t ^ (q+1) from le_sup_left) x.val = 0 at hf
    rw [← he] at hf
    have hmem : g ∈ I ⊔ normalIdeal d t ^ (q+1) := Ideal.Quotient.eq_zero_iff_mem.mp hf
    obtain ⟨a,ha,b,hb,hab⟩ := Submodule.mem_sup.mp hmem
    refine ⟨b,hb,?_⟩
    change Ideal.Quotient.mk I b = x.val
    rw [← he]
    apply Ideal.Quotient.eq.mpr
    have hn := I.neg_mem ha
    simpa only [← hab, sub_add_cancel_right] using hn
  · intro hx
    obtain ⟨b,hb,hbx⟩ := hx
    change Ideal.Quotient.mk I b = x.val at hbx
    apply Subtype.ext
    change Ideal.Quotient.factorₐ (HolGerm (ComplexModel d))
      (show I ≤ I ⊔ normalIdeal d t ^ (q+1) from le_sup_left) x.val = 0
    rw [← hbx]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr
      ((show normalIdeal d t ^ (q+1) ≤ I ⊔ normalIdeal d t ^ (q+1) from le_sup_right) hb)

/-- The LITERAL J-adic original quotient layer is truly its original power image modulo the NEXT power image. -/
def originalNormalGradedPieceQuotientEquiv (d t : ℕ)
    (I : Ideal (HolGerm (ComplexModel (d+t)))) (q : ℕ) :
    letI := tangentAlgebra d t
    (originalNormalPowerImage d t I q ⧸
      (originalNormalPowerImage d t I (q+1)).comap (originalNormalPowerImage d t I q).subtype)
      ≃ₗ[HolGerm (ComplexModel d)] originalNormalGradedPiece d t I q :=
  letI := tangentAlgebra d t
  (Submodule.quotEquivOfEq _ _ (ker_originalNormalGradedStepMap d t I q).symm).trans
    ((originalNormalGradedStepMap d t I q).quotKerEquivOfSurjective
      (originalNormalGradedStepMap_surjective d t I q))

end
end Hironaka.HironakaRelativeNormalAssociatedGraded
