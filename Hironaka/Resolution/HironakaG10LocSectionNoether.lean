import Hironaka.Resolution.HironakaG10PNIdealNoetherOpen

/-! # Ideal families generated by arbitrary families of sections are coherent (F2a, generic part)

Lane G10L, run 0080, round 2 (step F2a of `work/hironaka-resume-20261111/G10L/FLAT07-ROUTE.md`).
Frisch's non-reduced flattening ideal `H_K` (J. Frisch, *Points de platitude d'un morphisme
d'espaces analytiques complexes*, Invent. Math. 4 (1967), Lemmes 2–3) is generated by the
INFINITE family of scalar functions `s ↦ λ(Sch(s) m)` (`λ` a continuous functional, `m` a vector of
a Banach space).  Its coherence near a point does not need Douady's §7 Prop. 7: it follows from the
local Noether property alone (lane G10P's `HironakaG10PNIdealFamily.HasLocalNoetherProperty`, proved
for opens of `ℂⁿ` and for reduced complex spaces), on a first countable space.

For a locally ringed space `X`, a family `s : ι → 𝒪_X(X)` of global sections, and `F ⊆ ι`,
`spanFamily s F y` is the ideal of `𝒪_{X,y}` spanned by the germs of the `s i`, `i ∈ F`.

* `isLocallyFinitelyGenerated_spanFamily`: finite subfamilies give coherent ideal families;
* **`exists_finset_eventually_eq`**: if `X` is first countable and has the local Noether property,
  then near every point `p` finitely many of the sections generate the whole family:
  `spanFamily s univ = spanFamily s F` on a neighbourhood of `p` (directed union of the finite
  subfamilies; a strictly increasing chain along a sequence of bad points converging to `p`
  contradicts local stationarity);
* **`isLocallyFinitelyGenerated_spanFamily_univ`**: the ideal family generated by ALL the sections
  is locally finitely generated (a coherent ideal sheaf);
* `isLocallyFinitelyGenerated_spanFamily_openSpace`: the instance on an open `U ⊆ ℂⁿ` (G10P's
  `hasLocalNoetherProperty_openSpace`): any family of holomorphic functions on `U` generates a
  coherent ideal family.

No named input; generic sheaf theory over G10P's local Noether property.
BP: hironaka-g10-loc-section-noether.tex. -/

set_option autoImplicit false

open Set TopologicalSpace CategoryTheory Opposite AlgebraicGeometry Filter
open scoped Topology

namespace Hironaka.HironakaG10LocSectionNoether

open HironakaG10PNIdealFamily

noncomputable section

universe u

variable {X : LocallyRingedSpace.{u}} {ι : Type*}

/-- The ideal family spanned by the germs of the global sections `s i`, `i ∈ F`. -/
def spanFamily (s : ι → X.presheaf.obj (op ⊤)) (F : Set ι) (y : X) :
    Ideal (X.presheaf.stalk y) :=
  Ideal.span ((fun i => X.presheaf.germ ⊤ y trivial (s i)) '' F)

theorem spanFamily_mono (s : ι → X.presheaf.obj (op ⊤)) {F G : Set ι} (h : F ⊆ G) (y : X) :
    spanFamily s F y ≤ spanFamily s G y :=
  Ideal.span_mono (Set.image_mono h)

theorem germ_mem_spanFamily (s : ι → X.presheaf.obj (op ⊤)) {F : Set ι} {i : ι} (hi : i ∈ F)
    (y : X) : X.presheaf.germ ⊤ y trivial (s i) ∈ spanFamily s F y :=
  Ideal.subset_span ⟨i, hi, rfl⟩

theorem spanFamily_univ_le_iff (s : ι → X.presheaf.obj (op ⊤)) (y : X)
    (J : Ideal (X.presheaf.stalk y)) :
    spanFamily s univ y ≤ J ↔ ∀ i, X.presheaf.germ ⊤ y trivial (s i) ∈ J := by
  rw [spanFamily, Ideal.span_le, Set.image_univ, Set.range_subset_iff]
  rfl

/-- A finite subfamily as an indexed family of generators. -/
theorem spanFamily_finset_eq (s : ι → X.presheaf.obj (op ⊤)) (F : Finset ι) (y : X) :
    spanFamily s (F : Set ι) y =
      Ideal.span (Set.range fun k : Fin F.card => X.presheaf.germ ⊤ y trivial (s (F.equivFin.symm k))) := by
  unfold spanFamily
  congr 1
  ext g
  constructor
  · rintro ⟨i, hi, rfl⟩
    exact ⟨F.equivFin ⟨i, hi⟩, by simp⟩
  · rintro ⟨k, rfl⟩
    exact ⟨_, (F.equivFin.symm k).2, rfl⟩

/-- **Finite subfamilies span coherent ideal families.** -/
theorem isLocallyFinitelyGenerated_spanFamily (s : ι → X.presheaf.obj (op ⊤)) (F : Finset ι) :
    IsLocallyFinitelyGenerated X (spanFamily s (F : Set ι)) := by
  intro x
  refine ⟨⊤, trivial, F.card, fun k => s (F.equivFin.symm k), fun y _ => ?_⟩
  exact spanFamily_finset_eq s F y

/-- **Finitely many sections suffice near every point** (local Noether property, first countable
`X`). -/
theorem exists_finset_eventually_eq [FirstCountableTopology X] (hX : HasLocalNoetherProperty X)
    (s : ι → X.presheaf.obj (op ⊤)) (p : X) :
    ∃ F : Finset ι, ∀ᶠ y in 𝓝 p, spanFamily s univ y = spanFamily s (F : Set ι) y := by
  classical
  by_contra hcon
  obtain ⟨U, hU⟩ := (𝓝 p).exists_antitone_basis
  have hbad : ∀ (F : Finset ι) (k : ℕ), ∃ y ∈ U k, ∃ i,
      X.presheaf.germ ⊤ y trivial (s i) ∉ spanFamily s (F : Set ι) y := by
    intro F k
    have hfreq : ∃ᶠ y in 𝓝 p, ¬ spanFamily s univ y = spanFamily s (F : Set ι) y :=
      Filter.not_eventually.1 fun h => hcon ⟨F, h⟩
    obtain ⟨y, hne, hyU⟩ := (hfreq.and_eventually (hU.mem k)).exists
    refine ⟨y, hyU, ?_⟩
    by_contra hall
    exact hne (le_antisymm ((spanFamily_univ_le_iff s y _).2 fun j => not_not.1 (not_exists.1 hall j))
      (spanFamily_mono s (subset_univ _) y))
  choose y hyU i hi using hbad
  obtain ⟨F, hF⟩ : ∃ F : ℕ → Finset ι, ∀ k, F (k + 1) = insert (i (F k) k) (F k) :=
    ⟨fun n => Nat.rec (∅ : Finset ι) (fun k Fk => insert (i Fk k) Fk) n, fun k => rfl⟩
  obtain ⟨J, hJ⟩ : ∃ J : ℕ → ∀ x : X, Ideal (X.presheaf.stalk x),
      ∀ k, J k = spanFamily s (F k : Set ι) := ⟨fun k => spanFamily s (F k : Set ι), fun k => rfl⟩
  have hasc : IsAscending X J := by
    intro m x
    rw [hJ, hJ]
    refine spanFamily_mono s ?_ x
    rw [hF]
    exact Finset.coe_subset.2 (Finset.subset_insert _ _)
  have hfg : ∀ m, IsLocallyFinitelyGenerated X (J m) := fun m => by
    rw [hJ]
    exact isLocallyFinitelyGenerated_spanFamily s (F m)
  obtain ⟨N, V, hpV, hV⟩ := hX J hasc hfg p
  obtain ⟨k₀, -, hk₀⟩ := hU.toHasBasis.mem_iff.1 (V.isOpen.mem_nhds hpV)
  let m := max N k₀
  have hym : y (F m) m ∈ (V : Set X) :=
    hk₀ (hU.antitone (le_max_right N k₀) (hyU (F m) m))
  apply hi (F m) m
  rw [← hJ]
  have h1 : X.presheaf.germ ⊤ (y (F m) m) trivial (s (i (F m) m)) ∈ J (m + 1) (y (F m) m) := by
    rw [hJ]
    refine germ_mem_spanFamily s ?_ _
    rw [hF]
    exact Finset.mem_coe.2 (Finset.mem_insert_self _ _)
  exact hasc.le (le_max_left N k₀) _ (hV (m + 1) (by omega) _ hym h1)

/-- **The ideal family generated by any family of global sections is coherent** (locally finitely
generated) on a first countable locally ringed space with the local Noether property. -/
theorem isLocallyFinitelyGenerated_spanFamily_univ [FirstCountableTopology X]
    (hX : HasLocalNoetherProperty X) (s : ι → X.presheaf.obj (op ⊤)) :
    IsLocallyFinitelyGenerated X (spanFamily s univ) := by
  intro p
  obtain ⟨F, hF⟩ := exists_finset_eventually_eq hX s p
  obtain ⟨t, ht, hto, hpt⟩ := eventually_nhds_iff.1 hF
  let W : Opens X := ⟨t, hto⟩
  refine ⟨W, hpt, F.card, fun k => X.presheaf.map (homOfLE le_top).op (s (F.equivFin.symm k)),
    fun y hy => ?_⟩
  rw [ht y hy, spanFamily_finset_eq]
  congr 1
  ext g
  simp only [Set.mem_range, X.presheaf.germ_res_apply]

/-- **On an open of `ℂⁿ`**: the ideal family generated by any family of holomorphic functions on
`U` (global sections of `𝒪_U`) is coherent (lane G10P's `hasLocalNoetherProperty_openSpace`). -/
theorem isLocallyFinitelyGenerated_spanFamily_openSpace {n : ℕ}
    (U : Opens (Hironaka.ComplexModel n)) {κ : Type*}
    (s : κ → (HironakaG10PNIdealNoetherOpen.openSpace U).presheaf.obj (op ⊤)) :
    IsLocallyFinitelyGenerated (HironakaG10PNIdealNoetherOpen.openSpace U) (spanFamily s univ) := by
  have : FirstCountableTopology (HironakaG10PNIdealNoetherOpen.openSpace U) :=
    inferInstanceAs (FirstCountableTopology U)
  exact isLocallyFinitelyGenerated_spanFamily_univ
    (HironakaG10PNIdealNoetherOpen.hasLocalNoetherProperty_openSpace U) s

end

end Hironaka.HironakaG10LocSectionNoether
