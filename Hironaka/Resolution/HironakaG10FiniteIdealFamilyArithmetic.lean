import Hironaka.Resolution.HironakaG10HirIdealGerms

/-! # Local finite generation of sums of native ideal families -/

set_option autoImplicit false
open Set TopologicalSpace CategoryTheory Opposite AlgebraicGeometry

namespace Hironaka.HironakaG10FiniteIdealFamilyArithmetic

open HironakaG10HirIdealGerms

universe u

private theorem range_fin_append {α : Type*} {k l : ℕ} (a : Fin k → α) (b : Fin l → α) :
    Set.range (Fin.append a b) = Set.range a ∪ Set.range b := by
  ext z
  constructor
  · rintro ⟨i, rfl⟩
    refine Fin.addCases (motive := fun i => Fin.append a b i ∈ range a ∪ range b)
      (fun j => ?_) (fun j => ?_) i
    · exact Or.inl ⟨j, (Fin.append_left a b j).symm⟩
    · exact Or.inr ⟨j, (Fin.append_right a b j).symm⟩
  · rintro (⟨j, rfl⟩ | ⟨j, rfl⟩)
    · exact ⟨Fin.castAdd l j, Fin.append_left a b j⟩
    · exact ⟨Fin.natAdd k j, Fin.append_right a b j⟩

/-- The pointwise sum of two families locally generated on the same domain
is locally generated there by the union of the two actual section families. -/
theorem isLocallyFinitelyGeneratedOn_sup {X : LocallyRingedSpace.{u}} (V : Set X)
    (I K : ∀ x : X, Ideal (X.presheaf.stalk x))
    (hI : IsLocallyFinitelyGeneratedOn X V I) (hK : IsLocallyFinitelyGeneratedOn X V K) :
    IsLocallyFinitelyGeneratedOn X V (fun x => I x ⊔ K x) := by
  intro x hx
  obtain ⟨U,hxU,r,s,hs⟩ := hI x hx
  obtain ⟨W,hxW,t,q,hq⟩ := hK x hx
  let D : Opens X := U ⊓ W
  let a : Fin r → X.presheaf.obj (op D) := fun i => X.presheaf.map (homOfLE (show D ≤ U from inf_le_left)).op (s i)
  let b : Fin t → X.presheaf.obj (op D) := fun i => X.presheaf.map (homOfLE (show D ≤ W from inf_le_right)).op (q i)
  refine ⟨D,⟨hxU,hxW⟩,r+t,Fin.append a b,fun y hy hyV => ?_⟩
  change I y ⊔ K y = _
  rw [hs y hy.1 hyV, hq y hy.2 hyV, ← Ideal.span_union, ← range_fin_append]
  apply congrArg Ideal.span
  apply congrArg Set.range
  funext k
  symm
  refine Fin.addCases (motive := fun k =>
    X.presheaf.germ D y hy (Fin.append a b k) =
      Fin.append (fun i => X.presheaf.germ U y hy.1 (s i))
        (fun i => X.presheaf.germ W y hy.2 (q i)) k)
    (fun i => ?_) (fun i => ?_) k
  · rw [Fin.append_left, Fin.append_left]
    exact TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE (show D ≤ U from inf_le_left)) y hy (s i)
  · rw [Fin.append_right, Fin.append_right]
    exact TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE (show D ≤ W from inf_le_right)) y hy (q i)

/-- Products of locally generated ideal families are locally generated by
pairwise products of the same local section generators. -/
theorem isLocallyFinitelyGeneratedOn_mul {X : LocallyRingedSpace.{u}} (V : Set X)
    (I K : ∀ x : X, Ideal (X.presheaf.stalk x))
    (hI : IsLocallyFinitelyGeneratedOn X V I) (hK : IsLocallyFinitelyGeneratedOn X V K) :
    IsLocallyFinitelyGeneratedOn X V (fun x => I x * K x) := by
  intro x hx
  obtain ⟨U,hxU,r,s,hs⟩ := hI x hx
  obtain ⟨W,hxW,t,q,hq⟩ := hK x hx
  let D : Opens X := U ⊓ W
  let a : Fin r → X.presheaf.obj (op D) := fun i => X.presheaf.map (homOfLE (show D ≤ U from inf_le_left)).op (s i)
  let b : Fin t → X.presheaf.obj (op D) := fun i => X.presheaf.map (homOfLE (show D ≤ W from inf_le_right)).op (q i)
  let e : Fin (r*t) → Fin r × Fin t := finProdFinEquiv.symm
  refine ⟨D,⟨hxU,hxW⟩,r*t,fun k => a (e k).1 * b (e k).2,fun y hy hyV => ?_⟩
  change I y * K y = _
  rw [hs y hy.1 hyV, hq y hy.2 hyV, Ideal.span_mul_span]
  apply congrArg Ideal.span
  ext z
  have ha (i : Fin r) : X.presheaf.germ D y hy (a i) = X.presheaf.germ U y hy.1 (s i) :=
    TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE (show D ≤ U from inf_le_left)) y hy (s i)
  have hb (i : Fin t) : X.presheaf.germ D y hy (b i) = X.presheaf.germ W y hy.2 (q i) :=
    TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE (show D ≤ W from inf_le_right)) y hy (q i)
  constructor
  · rintro ⟨u,⟨i,rfl⟩,v,⟨j,rfl⟩,rfl⟩
    refine ⟨finProdFinEquiv (i,j), ?_⟩
    simp only [e, Equiv.symm_apply_apply, map_mul, ha, hb]
  · rintro ⟨k,rfl⟩
    refine ⟨_,⟨(e k).1,rfl⟩,_,⟨(e k).2,rfl⟩,?_⟩
    change X.presheaf.germ U y hy.1 (s (e k).1) * X.presheaf.germ W y hy.2 (q (e k).2) =
      X.presheaf.germ D y hy (a (e k).1 * b (e k).2)
    simp only [map_mul, ha, hb]

/-- Every natural power of a locally generated family is locally generated. -/
theorem isLocallyFinitelyGeneratedOn_pow {X : LocallyRingedSpace.{u}} (V : Set X)
    (I : ∀ x : X, Ideal (X.presheaf.stalk x))
    (hI : IsLocallyFinitelyGeneratedOn X V I) (m : ℕ) :
    IsLocallyFinitelyGeneratedOn X V (fun x => I x ^ m) := by
  induction m with
  | zero => simpa only [pow_zero, Ideal.one_eq_top] using isLocallyFinitelyGeneratedOn_top V
  | succ m ih =>
    simpa only [pow_succ] using isLocallyFinitelyGeneratedOn_mul V (fun x => I x ^ m) I ih hI

/-- Extend a family on a domain by the unit ideal outside that domain. -/
noncomputable def extendByUnit {X : LocallyRingedSpace.{u}} (V : Set X)
    (I : ∀ x : X, Ideal (X.presheaf.stalk x)) (x : X) : Ideal (X.presheaf.stalk x) := by
  classical
  exact if x ∈ V then I x else ⊤

/-- If the nonunit locus on an open domain is contained in a closed subset
of that domain, its unit extension remains locally finitely generated. -/
theorem isLocallyFinitelyGenerated_extendByUnit {X : LocallyRingedSpace.{u}}
    (V Q : Set X) (hV : IsOpen V) (hQ : IsClosed Q) (hQV : Q ⊆ V)
    (I : ∀ x : X, Ideal (X.presheaf.stalk x))
    (hI : IsLocallyFinitelyGeneratedOn X V I)
    (htop : ∀ x ∈ V, x ∉ Q → I x = ⊤) :
    HironakaG10PNIdealFamily.IsLocallyFinitelyGenerated X (extendByUnit V I) := by
  classical
  intro x
  by_cases hxV : x ∈ V
  · obtain ⟨W,hxW,r,s,hs⟩ := hI x hxV
    let D : Opens X := W ⊓ ⟨V,hV⟩
    have hDW : D ≤ W := inf_le_left
    refine ⟨D,⟨hxW,hxV⟩,r,fun i => X.presheaf.map (homOfLE hDW).op (s i),fun y hy => ?_⟩
    have hyV : y ∈ V := hy.2
    rw [extendByUnit, if_pos hyV, hs y hy.1 hyV]
    exact congrArg Ideal.span (congrArg Set.range (funext fun i =>
      (TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE hDW) y hy (s i)).symm))
  · have hxQ : x ∉ Q := fun h => hxV (hQV h)
    refine ⟨⟨Qᶜ,hQ.isOpen_compl⟩,hxQ,1,fun _ => 1,fun y hy => ?_⟩
    have hyTop : extendByUnit V I y = ⊤ := by
      by_cases hyV : y ∈ V
      · rw [extendByUnit, if_pos hyV, htop y hyV hy]
      · rw [extendByUnit, if_neg hyV]
    rw [hyTop, eq_comm, Ideal.eq_top_iff_one]
    exact Ideal.subset_span ⟨0,map_one _⟩

end Hironaka.HironakaG10FiniteIdealFamilyArithmetic
