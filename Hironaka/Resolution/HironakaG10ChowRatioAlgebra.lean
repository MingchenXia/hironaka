import Hironaka.Resolution.HironakaG10ChowFibreAlgebra

/-!
# Ratio generation and fibre-algebra surjectivity (route step N6, algebraic form)

Route step N6 of the global half of Hironaka's flattening theorem
(`work/hironaka-resume-20261111/G10C/GLOBAL-FLATTENING-ROUTE.md` §5): the fibre algebras of the
one-step strict transform are quotients of the original ones.  This file isolates the algebra in
the form in which the native data arrive, without the base ring `𝒪_{X,x}`:

* `HasRatioGeneration q 𝔞` — a local homomorphism `q : A → B` (the strict transform `Y' → Y` at a
  point) is *generated by ratios* over the ideal `𝔞 ⊆ A` (the pulled centre): there are generators
  `g_i` of `𝔞` with `q g_i = t_i · q g_j` (`j` a pivot), such that every element of `B` is congruent
  to an element of `q(A)` modulo the ideal of the `t_i - q a_i`, for ANY `a_i` with the same
  residues.  For the geometric blowup of a manifold along a submanifold, restricted to the strict
  transform of a closed subset, this is proved chart by chart in
  `HironakaG10ChowRatioGeneration.hasRatioGeneration_geoStrictTransform` (Hadamard's lemma with
  substitution in a monomial chart).
* `HasRatioGeneration.comp_bijective`, `HasRatioGeneration.of_comp_bijective` — transport along ring
  isomorphisms on either side (stalk isomorphisms of open immersions).
* `exists_sub_mem_fibreIdeal_of_hasRatioGeneration` — **N6, algebraic form**: if moreover `p : C → B`
  (the map to the blown-up base) satisfies `𝔞·B = (p ε)` with `p ε` a nonzerodivisor, and every
  element of `𝔞` maps to `c · p ε` with `c` congruent modulo the fibre ideal `m_C·B` to an element of
  `q(A)` (the ratios of the base blowup are constant modulo `m_C`), then `A → B / m_C B` is
  surjective.
* `exists_mul_of_mem_map` — the last hypothesis needs to be checked only on the image of a
  generating set.
-/

set_option autoImplicit false

open IsLocalRing

namespace Hironaka.HironakaG10ChowRatioAlgebra

open HironakaG10ChowFibreAlgebra

noncomputable section

section Ratio

variable {A B : Type*} [CommRing A] [CommRing B] [IsLocalRing B]

/-- `q : A → B` is **generated by ratios over `𝔞`**: generators `g_i` of `𝔞` with
`q g_i = t_i · q g_j`, such that every element of `B` is congruent to an element of `q(A)` modulo the
ideal generated by the `t_i - q a_i`, for any `a_i` with `t_i - q a_i` in the maximal ideal. -/
def HasRatioGeneration (q : A →+* B) (𝔞 : Ideal A) : Prop :=
  ∃ (κ : Type) (_ : Fintype κ) (g : κ → A) (t : κ → B) (j : κ),
    Ideal.span (Set.range g) = 𝔞 ∧ (∀ i, q (g i) = t i * q (g j)) ∧
      ∀ (β : B) (a : κ → A), (∀ i, t i - q (a i) ∈ maximalIdeal B) →
        ∃ a₀ : A, β - q a₀ ∈ Ideal.span (Set.range fun i => t i - q (a i))

/-- Transport of ratio generation along a ring isomorphism of the source. -/
theorem HasRatioGeneration.comp_bijective {A' : Type*} [CommRing A'] {q : A →+* B}
    (e : A' →+* A) (he : Function.Bijective e) {𝔞' : Ideal A'}
    (h : HasRatioGeneration q (Ideal.map e 𝔞')) : HasRatioGeneration (q.comp e) 𝔞' := by
  classical
  obtain ⟨κ, hκ, g, t, j, hspan, hrel, hgen⟩ := h
  let E := RingEquiv.ofBijective e he
  have hE : ∀ x, e (E.symm x) = x := fun x => E.apply_symm_apply x
  refine ⟨κ, hκ, fun i => E.symm (g i), t, j, ?_, ?_, ?_⟩
  · have h1 : Ideal.map e (Ideal.span (Set.range fun i => E.symm (g i))) = Ideal.map e 𝔞' := by
      rw [Ideal.map_span, ← Set.range_comp, ← hspan]
      congr 2
      funext i
      exact hE (g i)
    have h2 := congrArg (Ideal.comap e) h1
    rwa [Ideal.comap_map_of_bijective e he, Ideal.comap_map_of_bijective e he] at h2
  · intro i
    simp only [RingHom.comp_apply, hE]
    exact hrel i
  · intro β a ha
    obtain ⟨a₀, ha₀⟩ := hgen β (fun i => e (a i)) ha
    refine ⟨E.symm a₀, ?_⟩
    simpa only [RingHom.comp_apply, hE] using ha₀

/-- Ratio generation descends along a ring isomorphism of the target. -/
theorem HasRatioGeneration.of_comp_bijective {B' : Type*} [CommRing B'] [IsLocalRing B']
    {q : A →+* B} {𝔞 : Ideal A} (e : B →+* B') (he : Function.Bijective e)
    (h : HasRatioGeneration (e.comp q) 𝔞) : HasRatioGeneration q 𝔞 := by
  classical
  obtain ⟨κ, hκ, g, t, j, hspan, hrel, hgen⟩ := h
  let E := RingEquiv.ofBijective e he
  have hE : ∀ x, E.symm (e x) = x := fun x => E.symm_apply_apply x
  have hE' : ∀ x, e (E.symm x) = x := fun x => E.apply_symm_apply x
  refine ⟨κ, hκ, g, fun i => E.symm (t i), j, hspan, ?_, ?_⟩
  · intro i
    have h1 := congrArg E.symm (hrel i)
    simp only [RingHom.comp_apply, map_mul] at h1
    rwa [hE, hE] at h1
  · intro β a ha
    have hloc : ∀ x : B, x ∈ maximalIdeal B → e x ∈ maximalIdeal B' := by
      intro x hx hu
      apply hx
      have h1 := hu.map E.symm.toRingHom
      simpa only [RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom, hE] using h1
    obtain ⟨a₀, ha₀⟩ := hgen (e β) a fun i => by
      have h1 := hloc _ (ha i)
      rwa [map_sub, hE'] at h1
    refine ⟨a₀, ?_⟩
    have h1 := Ideal.mem_map_of_mem E.symm.toRingHom ha₀
    rw [Ideal.map_span] at h1
    have h2 : (E.symm.toRingHom : B' → B) '' (Set.range fun i => t i - (e.comp q) (a i)) =
        Set.range fun i => E.symm (t i) - q (a i) := by
      rw [← Set.range_comp]
      congr 1
      funext i
      simp only [Function.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom,
        map_sub, RingHom.comp_apply, hE]
    rw [h2] at h1
    simpa only [RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom, map_sub, RingHom.comp_apply,
      hE] using h1

end Ratio

section Fibre

variable {A C B : Type*} [CommRing A] [CommRing C] [CommRing B]

/-- The hypothesis "`q a = c · s` with `c` congruent to an element of `q(A)` modulo `𝔣`" passes from
a generating set to the ideal it generates. -/
theorem exists_mul_of_mem_map {D : Type*} [CommRing D] (q : A →+* B) (φ : D →+* A) (I : Ideal D)
    (s : B) (𝔣 : Ideal B)
    (h : ∀ d ∈ I, ∃ c : B, q (φ d) = c * s ∧ ∃ a' : A, c - q a' ∈ 𝔣) :
    ∀ a ∈ Ideal.map φ I, ∃ c : B, q a = c * s ∧ ∃ a' : A, c - q a' ∈ 𝔣 := by
  intro a ha
  rw [Ideal.map] at ha
  induction ha using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨d, hd, rfl⟩ := hx
    exact h d hd
  | zero => exact ⟨0, by simp, 0, by simp⟩
  | add x y _ _ hx hy =>
    obtain ⟨c₁, hc₁, a₁, ha₁⟩ := hx
    obtain ⟨c₂, hc₂, a₂, ha₂⟩ := hy
    refine ⟨c₁ + c₂, by rw [map_add, hc₁, hc₂]; ring, a₁ + a₂, ?_⟩
    have h1 : c₁ + c₂ - q (a₁ + a₂) = (c₁ - q a₁) + (c₂ - q a₂) := by rw [map_add]; ring
    rw [h1]
    exact Ideal.add_mem _ ha₁ ha₂
  | smul r x _ hx =>
    obtain ⟨c, hc, a', ha'⟩ := hx
    refine ⟨q r * c, by rw [smul_eq_mul, map_mul, hc]; ring, r * a', ?_⟩
    have h1 : q r * c - q (r * a') = q r * (c - q a') := by rw [map_mul]; ring
    rw [h1]
    exact Ideal.mul_mem_left _ _ ha'

variable [IsLocalRing C] [IsLocalRing B]

/-- **Fibre-algebra surjectivity from ratio generation** (route step N6, algebraic form). -/
theorem exists_sub_mem_fibreIdeal_of_hasRatioGeneration (q : A →+* B) (p : C →+* B)
    [IsLocalHom q] [IsLocalHom p] (𝔞 : Ideal A) (ε : C)
    (h0 : Ideal.map q 𝔞 = Ideal.span {p ε}) (hreg : IsRegular (p ε))
    (hx : ∀ a ∈ 𝔞, ∃ c : B, q a = c * p ε ∧ ∃ a' : A, c - q a' ∈ fibreIdeal p)
    (hR : HasRatioGeneration q 𝔞) (β : B) : ∃ a₀ : A, β - q a₀ ∈ fibreIdeal p := by
  classical
  obtain ⟨κ, hκ, g, t, j, hspan, hrel, hgen⟩ := hR
  have hspanq : Ideal.span (Set.range fun i => q (g i)) = Ideal.span {p ε} := by
    rw [← h0, ← hspan, Ideal.map_span, ← Set.range_comp]
    rfl
  -- `p ε = λ · q g_j` and `q g_j = μ · p ε`
  have hpe : p ε ∈ Ideal.span {q (g j)} := by
    have h1 : p ε ∈ Ideal.span (Set.range fun i => q (g i)) :=
      hspanq ▸ Ideal.mem_span_singleton_self (p ε)
    refine (Ideal.span_le.mpr ?_) h1
    rintro _ ⟨i, rfl⟩
    show q (g i) ∈ Ideal.span {q (g j)}
    rw [hrel i]
    exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
  obtain ⟨lam, hlam⟩ := Ideal.mem_span_singleton'.mp hpe
  have he : q (g j) ∈ Ideal.span {p ε} := hspanq ▸ Ideal.subset_span ⟨j, rfl⟩
  obtain ⟨mu, hmu⟩ := Ideal.mem_span_singleton'.mp he
  have hlm : lam * mu = 1 := by
    apply hreg.right
    change (lam * mu) * p ε = 1 * p ε
    rw [mul_assoc, hmu, hlam, one_mul]
  -- the ratios of the base
  choose c hc a' ha' using fun i => hx (g i) (hspan ▸ Ideal.subset_span ⟨i, rfl⟩)
  have hcj : c j = mu := by
    apply hreg.right
    change c j * p ε = mu * p ε
    rw [← hc j, hmu]
  have htc : ∀ i, t i = lam * c i := by
    intro i
    have h1 : (t i * mu) * p ε = c i * p ε := by rw [mul_assoc, hmu, ← hrel i, hc i]
    have h2 : t i * mu = c i := hreg.right h1
    calc t i = t i * (lam * mu) := by rw [hlm, mul_one]
      _ = lam * (t i * mu) := by ring
      _ = lam * c i := by rw [h2]
  have hlcj : lam * c j = 1 := by rw [hcj, hlm]
  -- the pivot residue is a unit
  have hcju : IsUnit (c j) := IsUnit.of_mul_eq_one lam (by rw [mul_comm]; exact hlcj)
  have hqa'j : IsUnit (q (a' j)) :=
    isUnit_of_sub_mem_maximalIdeal hcju (fibreIdeal_le_maximalIdeal p (ha' j))
  obtain ⟨w, hw⟩ := (isUnit_of_map_unit q (a' j) hqa'j).exists_right_inv
  have hqw : q (a' j) * q w = 1 := by rw [← map_mul, hw, map_one]
  -- the ratios are congruent to elements of `q(A)` modulo the fibre ideal
  have hta : ∀ i, t i - q (a' i * w) ∈ fibreIdeal p := by
    intro i
    have h1 : t i - q (a' i * w) =
        lam * q w * ((c i - q (a' i)) * q (a' j) - q (a' i) * (c j - q (a' j))) := by
      rw [map_mul]
      linear_combination htc i - lam * c i * hqw + q (a' i) * q w * hlcj
    rw [h1]
    exact Ideal.mul_mem_left _ _ (Ideal.sub_mem _ (Ideal.mul_mem_right _ _ (ha' i))
      (Ideal.mul_mem_left _ _ (ha' j)))
  obtain ⟨a₀, ha₀⟩ := hgen β (fun i => a' i * w) fun i => fibreIdeal_le_maximalIdeal p (hta i)
  refine ⟨a₀, (Ideal.span_le.mpr ?_) ha₀⟩
  rintro _ ⟨i, rfl⟩
  exact hta i

end Fibre

end

end Hironaka.HironakaG10ChowRatioAlgebra
