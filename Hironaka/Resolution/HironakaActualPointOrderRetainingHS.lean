variable {n : ℕ}
local notation "R" => MvPowerSeries (Fin n) ℂ
local notation "𝔪" => actualFormalCoordinateIdeal n univ

private theorem pointIdeal_eq_genuineVariables (n : ℕ) :
    actualFormalCoordinateIdeal n univ=genuineFormalVariables n := by
  simp [actualFormalCoordinateIdeal,genuineFormalVariables]

private theorem weight_point (α : Fin n →₀ ℕ) :
    Finsupp.weight (actualCoordinateWeight (univ : Set (Fin n))) α=normalExponentDegree α := by
  simp [Finsupp.weight_eq_sum,actualCoordinateWeight,normalExponentDegree]

private theorem reduced_mem_power (I : Ideal R) (a : actualInitialVertices MonomialOrder.degLex I) :
    actualReducedVertexSeries MonomialOrder.degLex I a∈genuineFormalVariables n^normalExponentDegree a.val := by
  have h := actualReducedVertexSeries_mem_point_power n I a
  rw [weight_point,pointIdeal_eq_genuineVariables] at h
  exact h

private theorem order_of_power (q : ℕ) (F : R) (hF : F∈genuineFormalVariables n^q) :
    (q : ℕ∞)≤F.order := by
  apply MvPowerSeries.nat_le_order
  intro α hα
  apply (mem_genuineFormalVariables_pow_iff_coefficients_zero n q F).mp hF α
  simpa only [normalExponentDegree,Finsupp.degree_eq_sum] using hα

attribute [local instance 2000] IsOrderedRing.toIsOrderedAddMonoid in
private theorem reduced_component_member_span (I : Ideal R) (q : ℕ) (F : R)
    (hI : F∈I) (hF : F∈genuineFormalVariables n^q) :
    MvPowerSeries.homogeneousComponent q F∈Ideal.span (range (fun a : actualInitialVertices MonomialOrder.degLex I =>
      MvPowerSeries.homogeneousComponent (normalExponentDegree a.val) (actualReducedVertexSeries MonomialOrder.degLex I a))) := by
  have hF' : F∈𝔪^q := by rwa [pointIdeal_eq_genuineVariables]
  obtain ⟨hDiv,hQ⟩ := actual_reduced_basis_entire_filtered_division MonomialOrder.degLex I univ q F hI hF'
    (actualReducedVertexSeries_mem_point_power n I)
  have he := congrArg (MvPowerSeries.homogeneousComponent q) hDiv
  rw [map_sum] at he
  rw [he]
  apply Ideal.sum_mem
  intro a _
  let Q := familyFormalQuotient MonomialOrder.degLex I (actualReducedVertexFamily MonomialOrder.degLex I) F a
  change MvPowerSeries.homogeneousComponent q (Q*actualReducedVertexSeries MonomialOrder.degLex I a)∈_
  by_cases ha : normalExponentDegree a.val≤q
  · have hQpow : Q∈genuineFormalVariables n^(q-normalExponentDegree a.val) := by
      have h := hQ a
      rw [weight_point,pointIdeal_eq_genuineVariables] at h
      exact h
    have hprod := MvPowerSeries.homogeneousComponent_mul_of_le_order
      (order_of_power _ Q hQpow) (order_of_power _ _ (reduced_mem_power I a))
    rw [Nat.sub_add_cancel ha] at hprod
    rw [hprod]
    exact Ideal.mul_mem_left _ _ (Ideal.mem_span_range_self (x := a))
  · have hG : actualReducedVertexSeries MonomialOrder.degLex I a∈genuineFormalVariables n^(q+1) :=
      Ideal.pow_le_pow_right (by omega) (reduced_mem_power I a)
    have hprod := order_of_power (q+1) _ ((genuineFormalVariables n^(q+1)).mul_mem_left Q hG)
    rw [MvPowerSeries.homogeneousComponent_of_lt_order_eq_zero
      (lt_of_lt_of_le (by exact_mod_cast Nat.lt_succ_self q) hprod)]
    exact Ideal.zero_mem _

attribute [local instance 2000] IsOrderedRing.toIsOrderedAddMonoid in
/-- The ENTIRE original initial ideal uses the SAME reduced canonical components. -/
theorem actualHomogeneousInitialIdeal_eq_reduced_component_span (I : Ideal R) :
    actualHomogeneousInitialIdeal I=Ideal.span (range (fun a : actualInitialVertices MonomialOrder.degLex I =>
      MvPowerSeries.homogeneousComponent (normalExponentDegree a.val) (actualReducedVertexSeries MonomialOrder.degLex I a))) := by
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro G ⟨F,rfl⟩
    change actualHomogeneousInitialForm F.val F.property.2∈_
    apply reduced_component_member_span I _ F.val F.property.1
    apply (mem_genuineFormalVariables_pow_iff_coefficients_zero n _ _).mpr
    intro α hα
    have ho := actualHomogeneousInitialDegree_eq_order F.val F.property.2
    apply MvPowerSeries.coeff_of_lt_order
    rw [←ho]
    exact_mod_cast (show Finsupp.degree α<actualHomogeneousInitialDegree F.val F.property.2 from
      by simpa only [normalExponentDegree,Finsupp.degree_eq_sum] using hα)
  · apply Ideal.span_le.mpr
    rintro G ⟨a,rfl⟩
    have he : MvPowerSeries.homogeneousComponent (normalExponentDegree a.val)
        (actualReducedVertexSeries MonomialOrder.degLex I a)=
        actualHomogeneousInitialForm (actualReducedVertexSeries MonomialOrder.degLex I a)
          (actualReducedVertexSeries_ne_zero MonomialOrder.degLex I a) := by
      rw [actualHomogeneousInitialForm,actualHomogeneousInitialDegree,actualReducedVertexSeries_initialExponent]
    change MvPowerSeries.homogeneousComponent (normalExponentDegree a.val)
      (actualReducedVertexSeries MonomialOrder.degLex I a)∈actualHomogeneousInitialIdeal I
    rw [he]
    exact Ideal.subset_span ⟨⟨actualReducedVertexSeries MonomialOrder.degLex I a,
      actualReducedVertexSeries_mem MonomialOrder.degLex I a,actualReducedVertexSeries_ne_zero MonomialOrder.degLex I a⟩,rfl⟩

/-- A true inverse linear shear identifies EVERY entire original quotient rank. -/
theorem genuineFormalHilbertSamuelValue_centerShear (I : Ideal R) (e : Fin n) (b : Fin n → ℂ) (ℓ : ℕ) :
    genuineFormalHilbertSamuelValue n I ℓ=
      genuineFormalHilbertSamuelValue n (Ideal.map (actualFormalCenterShear univ e b).toRingHom I) ℓ := by
  let E := actualFormalCenterShearAlgEquiv univ e b
  have hden : Ideal.map (actualFormalCenterShear univ e b).toRingHom I ⊔ genuineFormalVariables n^(ℓ+1)=
      Ideal.map E.toRingEquiv.toRingHom (I ⊔ genuineFormalVariables n^(ℓ+1)) := by
    change _=Ideal.map (actualFormalCenterShear univ e b).toRingHom _
    rw [Ideal.map_sup,←pointIdeal_eq_genuineVariables n,map_coordinate_power_centerShear univ e (mem_univ e)]
  exact (Ideal.quotientEquivAlg (I ⊔ genuineFormalVariables n^(ℓ+1))
    (Ideal.map (actualFormalCenterShear univ e b).toRingHom I ⊔ genuineFormalVariables n^(ℓ+1)) E hden).toLinearEquiv.finrank_eq

private theorem dehom_pivot_independent (e : Fin n) (b : Fin n → ℂ) (f : MvPolynomial (Fin n) ℂ)
    (α : Fin n →₀ ℕ) (hα : α∈(actualPointDehomogenization e b f).support) : α e=0 := by
  apply MvPolynomial.mem_support_notMem_vars_zero hα
  intro he
  change e∈(MvPolynomial.aeval (fun i => if i=e then 1 else MvPolynomial.C (b i)+MvPolynomial.X i) f).vars at he
  rw [MvPolynomial.aeval_eq_bind₁] at he
  obtain ⟨i,_hi,hvar⟩ := MvPolynomial.mem_vars_bind₁ _ _ he
  by_cases hie : i=e
  · simp [hie] at hvar
  · have hx : e∈(MvPolynomial.C (b i)+MvPolynomial.X i).vars := by simpa [hie] using hvar
    have heq : e=i := by simpa using MvPolynomial.vars_add_subset (MvPolynomial.C (b i)) (MvPolynomial.X i) hx
    exact hie heq.symm

private theorem dehom_zero_of_pivot_independent (e : Fin n) (p : MvPolynomial (Fin n) ℂ)
    (hp : ∀ α∈p.support,α e=0) : actualPointDehomogenization e (fun _ => 0) p=p := by
  conv_lhs => rw [←p.support_sum_monomial_coeff,map_sum]
  conv_rhs => rw [←p.support_sum_monomial_coeff]
  apply Finset.sum_congr rfl
  intro α hα
  rw [actualPointDehomogenization,MvPolynomial.aeval_monomial,MvPolynomial.monomial_eq]
  congr 1
  apply Finset.prod_congr rfl
  intro i hi
  have hie : i≠e := by
    intro h
    subst i
    exact (Finsupp.mem_support_iff.mp hi) (hp α hα)
  simp [hie]

/-- Literal homogeneous dehomogenization equals the genuine shear of the SAME source polynomial. -/
theorem centerShear_eq_dehom_of_homogeneous_dehom (e : Fin n) (b : Fin n → ℂ)
    (P : MvPolynomial (Fin n) ℂ) (d : ℕ) (hP : P.IsHomogeneous d)
    (hD : (actualPointDehomogenization e b P).IsHomogeneous d) :
    actualFormalCenterShear univ e b (P : R)=(actualPointDehomogenization e b P : R) := by
  apply actualFormalBlowup_injective univ e (mem_univ e) (fun _ => 0)
  rw [←actualFormalBlowup_eq_zero_comp_centerShear univ e (mem_univ e) b,
    actualFormalBlowup_homogeneous_polynomial e b P d hP,
    actualFormalBlowup_homogeneous_polynomial e (fun _ => 0) _ d hD,
    dehom_zero_of_pivot_independent e _ (dehom_pivot_independent e b P)]

private theorem dehom_totalDegree_le (e : Fin n) (b : Fin n → ℂ) (f : MvPolynomial (Fin n) ℂ) :
    (actualPointDehomogenization e b f).totalDegree≤f.totalDegree := by
  have hlin (i : Fin n) :
      (if i=e then (1 : MvPolynomial (Fin n) ℂ) else MvPolynomial.C (b i)+MvPolynomial.X i).totalDegree≤1 := by
    split_ifs
    · simp
    · exact (MvPolynomial.totalDegree_add _ _).trans (by simp)
  conv_lhs => rw [←f.support_sum_monomial_coeff,map_sum]
  apply MvPolynomial.totalDegree_finsetSum_le
  intro α hα
  change (MvPolynomial.aeval (fun i => if i=e then 1 else MvPolynomial.C (b i)+MvPolynomial.X i)
    (MvPolynomial.monomial α (MvPolynomial.coeff α f))).totalDegree≤_
  rw [MvPolynomial.aeval_monomial]
  apply (MvPolynomial.totalDegree_mul _ _).trans
  change (MvPolynomial.C (MvPolynomial.coeff α f)).totalDegree+_≤_
  rw [MvPolynomial.totalDegree_C,zero_add]
  apply (MvPolynomial.totalDegree_finsetProd _ _).trans
  apply le_trans (Finset.sum_le_sum (fun i _ => (MvPolynomial.totalDegree_pow _ _).trans
    (by simpa using Nat.mul_le_mul_left (α i) (hlin i))))
  exact MvPolynomial.le_totalDegree hα

open HolGerm HironakaActualOriginalFormalTaylor HironakaActualTaylorFaithfullyFlat
  HironakaActualPointNormalizedSaturation HironakaActualPointTangentCoefficientHSDrop
  HironakaActualOriginalReducedVertexBasis HironakaActualPointExceptionalInitialForm
  HironakaRelativeNormalIdeal HironakaRelativeNormalActualBaseJetDimension
  HironakaActualAnalyticBlowupTaylor HironakaActualCoefficientPresentationCentrePower
  HironakaActualAnalyticStrictGenerators HironakaHolomorphicJetMonomialSpan HironakaHolomorphicPointJets

private theorem canonical_shadow_eq_dehom
    (J : Ideal (HolGerm (ComplexModel (0+n))))
    (a : actualInitialVertices (MonomialOrder.degLex (σ := Fin n)) (Ideal.map (originalTaylorAlgHom n).toRingHom J))
    (j : Fin n) (b : Fin (0+n) → ℂ) (H : HolGerm (ComplexModel (0+n)))
    (hH : (coordinateGerm (j.natAdd 0))^(normalExponentDegree a.val)*H=
      actualAnalyticBlowupPullback (actualTangentCentreVariables 0 n) (j.natAdd 0) b (originalReducedVertexBasis J a)) :
    pivotZeroProjection j (originalTaylorAlgHom n H)=
      (actualPointDehomogenization j (fun i => b (i.natAdd 0))
        (actualPointHomogeneousPolynomial (normalExponentDegree a.val)
          (originalTaylorAlgHom n (originalReducedVertexBasis J a))) : R) := by
  apply MvPowerSeries.ext
  intro γ
  rw [pivotZeroProjection_coefficient,MvPolynomial.coeff_coe]
  split_ifs with hγ
  · exact canonical_point_quotient_pure_coefficient J a j b H hH γ hγ
  · symm
    by_contra hc
    exact hγ (dehom_pivot_independent j (fun i => b (i.natAdd 0)) _ γ
      (MvPolynomial.mem_support_iff.mpr hc))

private theorem canonical_dehom_homogeneous
    (J : Ideal (HolGerm (ComplexModel (0+n))))
    (a : actualInitialVertices (MonomialOrder.degLex (σ := Fin n)) (Ideal.map (originalTaylorAlgHom n).toRingHom J))
    (j : Fin n) (b : Fin (0+n) → ℂ) (H : HolGerm (ComplexModel (0+n)))
    (hH : (coordinateGerm (j.natAdd 0))^(normalExponentDegree a.val)*H=
      actualAnalyticBlowupPullback (actualTangentCentreVariables 0 n) (j.natAdd 0) b (originalReducedVertexBasis J a))
    (hOrd : H∈IsLocalRing.maximalIdeal (HolGerm (ComplexModel (0+n)))^(normalExponentDegree a.val)) :
    (actualPointDehomogenization j (fun i => b (i.natAdd 0))
      (actualPointHomogeneousPolynomial (normalExponentDegree a.val)
        (originalTaylorAlgHom n (originalReducedVertexBasis J a)))).IsHomogeneous (normalExponentDegree a.val) := by
  let f := actualPointHomogeneousPolynomial (normalExponentDegree a.val)
    (originalTaylorAlgHom n (originalReducedVertexBasis J a))
  let p := actualPointDehomogenization j (fun i => b (i.natAdd 0)) f
  have hEq : pivotZeroProjection j (originalTaylorAlgHom n H)=(p : R) := canonical_shadow_eq_dehom J a j b H hH
  have hBound : p.totalDegree≤normalExponentDegree a.val :=
    (dehom_totalDegree_le j (fun i => b (i.natAdd 0)) f).trans
      (actualPointHomogeneousPolynomial_isHomogeneous _ _).totalDegree_le
  have hPower : originalTaylorAlgHom n H∈𝔪^(normalExponentDegree a.val) := by
    rw [pointIdeal_eq_genuineVariables]
    apply (mem_genuineFormalVariables_pow_iff_coefficients_zero n _ _).mpr
    exact (mem_original_maximal_pow_iff_formal_coefficients_zero n _ H).mp hOrd
  have hShadow := pivotZeroProjection_mem_point_power j _ _ hPower
  intro γ hc
  have hUp : γ.degree≤normalExponentDegree a.val :=
    (MvPolynomial.le_totalDegree (MvPolynomial.mem_support_iff.mpr hc)).trans hBound
  have hLow : normalExponentDegree a.val≤γ.degree := by
    by_contra h
    have hc' : MvPowerSeries.coeff γ (pivotZeroProjection j (originalTaylorAlgHom n H))≠0 := by
      rw [hEq,MvPolynomial.coeff_coe]
      exact hc
    apply hc'
    have hm := (mem_genuineFormalVariables_pow_iff_coefficients_zero n _ _).mp
      (show pivotZeroProjection j (originalTaylorAlgHom n H)∈genuineFormalVariables n^normalExponentDegree a.val from
        by rwa [pointIdeal_eq_genuineVariables] at hShadow) γ
    exact hm (by simpa only [normalExponentDegree,Finsupp.degree_eq_sum] using (show γ.degree<normalExponentDegree a.val by omega))
  simpa only [Finsupp.degree_eq_weight_one,Pi.one_def] using le_antisymm hUp hLow

/-- Under genuine current orders, the actual shear identifies the ENTIRE source
initial ideal with literal shadows of the SAME chosen normalized family. -/
theorem canonical_point_order_retention_shadow_span
    (J : Ideal (HolGerm (ComplexModel (0+n)))) (j : Fin n) (b : Fin (0+n) → ℂ)
    (H : actualInitialVertices (MonomialOrder.degLex (σ := Fin n))
      (Ideal.map (originalTaylorAlgHom n).toRingHom J) → HolGerm (ComplexModel (0+n)))
    (hH : ∀ a,(coordinateGerm (j.natAdd 0))^(normalExponentDegree a.val)*H a=
      actualAnalyticBlowupPullback (actualTangentCentreVariables 0 n) (j.natAdd 0) b (originalReducedVertexBasis J a))
    (hOrder : ∀ a,H a∈IsLocalRing.maximalIdeal (HolGerm (ComplexModel (0+n)))^(normalExponentDegree a.val)) :
    Ideal.map (actualFormalCenterShear univ j (fun i => b (i.natAdd 0))).toRingHom
      (actualHomogeneousInitialIdeal (Ideal.map (originalTaylorAlgHom n).toRingHom J))=
      Ideal.span (range (fun a => pivotZeroProjection j (originalTaylorAlgHom n (H a)))) := by
  rw [actualHomogeneousInitialIdeal_eq_reduced_component_span,Ideal.map_span,←range_comp]
  apply congrArg Ideal.span
  apply congrArg Set.range
  funext a
  change actualFormalCenterShear univ j (fun i => b (i.natAdd 0))
    (MvPowerSeries.homogeneousComponent (normalExponentDegree a.val)
      (actualReducedVertexSeries MonomialOrder.degLex (Ideal.map (originalTaylorAlgHom n).toRingHom J) a))=_
  rw [←originalReducedVertexBasis_taylor J a,←actualPointHomogeneousPolynomial_coe]
  rw [centerShear_eq_dehom_of_homogeneous_dehom j (fun i => b (i.natAdd 0)) _ _
    (actualPointHomogeneousPolynomial_isHomogeneous _ _) (canonical_dehom_homogeneous J a j b (H a) (hH a) (hOrder a))]
  exact (canonical_shadow_eq_dehom J a j b (H a) (hH a)).symm

/-- ONE original canonical family precedes ALL current-order bounds and finite
orders; genuine all-vertex order retention preserves the ENTIRE original HS profile. -/
theorem exists_original_point_order_retaining_hs_family
    (J : Ideal (HolGerm (ComplexModel (0+n)))) (j : Fin n) (b : Fin (0+n) → ℂ) :
    ∃ H : actualInitialVertices (MonomialOrder.degLex (σ := Fin n))
        (Ideal.map (originalTaylorAlgHom n).toRingHom J) → HolGerm (ComplexModel (0+n)),
      (∀ a,(coordinateGerm (j.natAdd 0))^(normalExponentDegree a.val)*H a=
        actualAnalyticBlowupPullback (actualTangentCentreVariables 0 n) (j.natAdd 0) b (originalReducedVertexBasis J a)) ∧
      actualAnalyticNormalizedMemberIdeal J (actualTangentCentreVariables 0 n) (j.natAdd 0) b=Ideal.span (range H) ∧
      ∀ (_hOrder : ∀ a,H a∈IsLocalRing.maximalIdeal (HolGerm (ComplexModel (0+n)))^(normalExponentDegree a.val))
        (ℓ : ℕ),
        hilbertSamuelValue (actualAnalyticNormalizedMemberIdeal J (actualTangentCentreVariables 0 n) (j.natAdd 0) b) ℓ=
          hilbertSamuelValue J ℓ := by
  obtain ⟨H,hH,hNamed,hProfile⟩ := exists_original_point_order_retaining_fibre_hs_family J j b
  refine ⟨H,hH,hNamed,?_⟩
  intro hOrder ℓ
  rw [hProfile hOrder ℓ,hilbertSamuelValue_eq_genuine_formal_extension]
  have hSpan := canonical_point_order_retention_shadow_span J j b H hH hOrder
  rw [←hSpan]
  rw [←genuineFormalHilbertSamuelValue_centerShear]
  exact (genuineFormalHilbertSamuelValue_homogeneous_initial _ ℓ).symm

