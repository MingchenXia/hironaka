import Hironaka.Resolution.HironakaG10FlatExtensionStep

/-! # Presentations of subsheaves generated by sections (Oka)

For the extension step (`HironakaG10FlatExtensionStep.extension_step`) of Douady's §7 Th. 1: let
`𝓕 = coker A` and `T : L_t → L_a` sections of `L_a` generating the subsheaf `𝓕' = (im A + im T)/im A`.
If `X` has Oka's property, the module `{v | T v ∈ im A}` of germs at `x` is generated by the columns of a
holomorphic matrix `C'` with `T C' = A Q` (the `L_t`-part and the `L_b`-part of generators of the
relations of `[T | −A]`): **`exists_subPresentation`** produces exactly the hypotheses `hQ`, `hgen` of
the extension step, and `𝓕' ≅ coker C'`.
BP: hironaka-g10-flat-sub-presentation.tex. -/
set_option autoImplicit false
open Set Filter
open scoped Topology Matrix
namespace Hironaka.HironakaG10FlatSubPresentation
noncomputable section
open OkaRelationSheaf HironakaG10FlatResolutionStart HironakaG10FlatExtensionStep

variable {X : Type*} [NormedAddCommGroup X] [NormedSpace ℂ X]

/-- **Presentation of the subsheaf generated by `T`** (Oka): there are `C'`, `Q` holomorphic near `x`
with `A Q = T C'` near `x` such that every germ `v` with `T v ∈ im A` at `x` is a germ combination of
the columns of `C'`. -/
theorem exists_subPresentation (hX : OkaProperty X) {a b t : ℕ} {A : Fin a → Fin b → X → ℂ}
    {T : Fin a → Fin t → X → ℂ} {x : X} (hA : ∀ i j, HolAt (A i j) x) (hT : ∀ i j, HolAt (T i j) x) :
    ∃ (c : ℕ) (C' : Fin t → Fin c → X → ℂ) (Q : Fin b → Fin c → X → ℂ),
      (∀ i j, HolAt (C' i j) x) ∧ (∀ i j, HolAt (Q i j) x) ∧
      (∀ᶠ y in 𝓝 x, ∀ i j, ∑ l, A i l y * Q l j y = ∑ l, T i l y * C' l j y) ∧
      ∀ v : Fin t → X → ℂ, (∀ j, HolAt (v j) x) →
        IsCombinationAt (columns A) x (fun i y => ∑ l, T i l y * v l y) →
        IsCombinationAt (columns C') x v := by
  -- relations of `[T | −A]`
  set M : Fin a → Fin (t + b) → X → ℂ := catCols T (fun i j y => -A i j y) with hM
  have hMh : ∀ i j, HolAt (M i j) x := by
    intro i j
    show HolAt (Sum.elim (T i) (fun j y => -A i j y) (finSumFinEquiv.symm j)) x
    rcases finSumFinEquiv.symm j with j' | j'
    · exact hT i j'
    · exact (hA i j').neg
  obtain ⟨U, hU, hxU, c, G, hG⟩ := exists_exactStartOn hX M x hMh
  refine ⟨c, fun l j => G (finSumFinEquiv (Sum.inl l)) j, fun l j => G (finSumFinEquiv (Sum.inr l)) j,
    fun i j => holAt_of_differentiableOn hU (hG.holG _ j) hxU,
    fun i j => holAt_of_differentiableOn hU (hG.holG _ j) hxU, ?_, ?_⟩
  · filter_upwards [hU.mem_nhds hxU] with y hy i j
    have h := hG.comp i j y hy
    rw [← Equiv.sum_comp finSumFinEquiv, Fintype.sum_sum_type] at h
    simp only [hM, catCols, Equiv.symm_apply_apply, Sum.elim_inl, Sum.elim_inr, neg_mul,
      Finset.sum_neg_distrib] at h
    linear_combination (-1 : ℂ) * h
  · rintro v hv ⟨u, hu, hTu⟩
    -- `(v, u)` is a relation of `[T | −A]`
    have hrel : IsRelationAt M x (fun l => Sum.elim v u (finSumFinEquiv.symm l)) := by
      refine ⟨fun l => ?_, fun i => ?_⟩
      · show HolAt (Sum.elim v u (finSumFinEquiv.symm l)) x
        rcases finSumFinEquiv.symm l with l' | l'
        · exact hv l'
        · exact hu l'
      · filter_upwards [hTu i] with y hy
        rw [← Equiv.sum_comp finSumFinEquiv, Fintype.sum_sum_type]
        simp only [hM, catCols, Equiv.symm_apply_apply, Sum.elim_inl, Sum.elim_inr, mul_neg,
          Finset.sum_neg_distrib]
        have hy' : ∑ l, v l y * T i l y = ∑ k, u k y * A i k y := by
          rw [Finset.sum_congr rfl fun l _ => mul_comm (v l y) (T i l y)]
          exact hy
        rw [hy', add_neg_cancel]
    obtain ⟨d, hd, hdv⟩ := hG.exact x hxU _ hrel
    refine ⟨d, hd, fun j => ?_⟩
    filter_upwards [hdv (finSumFinEquiv (Sum.inl j))] with y hy
    simp only [Equiv.symm_apply_apply, Sum.elim_inl] at hy
    exact hy

end
end Hironaka.HironakaG10FlatSubPresentation
