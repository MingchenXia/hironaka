import Mathlib.RingTheory.Ideal.KrullsHeightTheorem
import Mathlib.RingTheory.Ideal.GoingDown
import Mathlib.RingTheory.TensorProduct.Quotient
import Mathlib.RingTheory.KrullDimension.NonZeroDivisors
import Mathlib.RingTheory.LocalRing.ResidueField.Basic
import Mathlib.RingTheory.Flat.Stability
import Mathlib.RingTheory.RingHom.Flat

/-!
# Fibre parameters of flat local homomorphisms

Blueprint `hironaka-g10-chowside-flat-open.tex` (node `g10c:flat-fibre-parameters`).
Pure commutative algebra behind the openness of flat morphisms of complex spaces.

Let `A → B` be a flat local homomorphism of Noetherian local rings and let
`f = dim B ⧸ m_A B` be the dimension of the closed fibre.  A *system of fibre parameters* is a
finite set `s ⊆ m_B` of at most `f` elements with `m_B ⊆ √(s B + m_A B)` (it exists:
lift a system of parameters of the fibre ring, `exists_fibre_parameters`).

* `ringKrullDim_quotient_map_eq` (Matsumura 15.1 after base change to `A ⧸ P`): for a prime
  `P` of `A`, `dim B ⧸ P B = dim A ⧸ P + dim B ⧸ m_A B` (going-down for the flat base change
  `A ⧸ P → B ⧸ P B`).
* `ringKrullDim_quotient_le_of_le_radical` (no flatness): if `m_B ⊆ √(J + m_A B)` for an ideal
  `J` of `B`, then `dim B ⧸ J ≤ dim A ⧸ (J ∩ A)`.
* `mem_of_algebraMap_mem_radical` (**the key lemma**): for a system of fibre parameters `s`,
  every prime `P` of `A` and every `h ∈ A`, if the image of `h` lies in `√(P B + s B)` then
  `h ∈ P`.  Geometrically: the slice `{s = 0}` of the preimage of the subgerm `V(P)` maps onto a
  set which is not contained in any hypersurface of `V(P)`.

Sorry-free.
-/

set_option autoImplicit false

open IsLocalRing

namespace Hironaka.HironakaG10ChowFlatFibreParameters

noncomputable section

/-! ### Generalities on Krull dimension -/

section General

variable {R : Type*} [CommRing R]

/-- Quotients by ideals with the same radical have the same Krull dimension. -/
theorem ringKrullDim_quotient_eq_of_radical_eq {I J : Ideal R} (h : I.radical = J.radical) :
    ringKrullDim (R ⧸ I) = ringKrullDim (R ⧸ J) := by
  rw [ringKrullDim_quotient, ringKrullDim_quotient, ← PrimeSpectrum.zeroLocus_radical I, h,
    PrimeSpectrum.zeroLocus_radical]

/-- The Krull dimension of a quotient decreases when the ideal grows. -/
theorem ringKrullDim_quotient_anti {I J : Ideal R} (h : I ≤ J) :
    ringKrullDim (R ⧸ J) ≤ ringKrullDim (R ⧸ I) :=
  ringKrullDim_le_of_surjective (Ideal.Quotient.factor h) (Ideal.Quotient.factor_surjective h)

/-- In a local ring, if the maximal ideal is contained in `√I` and `I` is proper, the maximal
ideal is minimal over `I`. -/
theorem maximalIdeal_mem_minimalPrimes_of_le_radical [IsLocalRing R]
    {I : Ideal R} (hI : I ≤ maximalIdeal R) (h : maximalIdeal R ≤ I.radical) :
    maximalIdeal R ∈ I.minimalPrimes := by
  refine ⟨⟨IsLocalRing.maximalIdeal.isMaximal R |>.isPrime, hI⟩, ?_⟩
  rintro P ⟨hP, hIP⟩ -
  exact h.trans ((Ideal.radical_mono hIP).trans hP.radical.le)

/-- In a local ring, if the maximal ideal is minimal over `I` then it is the radical of `I`. -/
theorem maximalIdeal_le_radical_of_mem_minimalPrimes [IsLocalRing R]
    {I : Ideal R} (h : maximalIdeal R ∈ I.minimalPrimes) : maximalIdeal R ≤ I.radical := by
  rw [Ideal.radical_eq_sInf]
  refine le_sInf ?_
  rintro P ⟨hIP, hP⟩
  exact h.2 ⟨hP, hIP⟩ (IsLocalRing.le_maximalIdeal hP.ne_top)

/-- **Krull's bound.**  In a Noetherian local ring, if the maximal ideal is contained in the
radical of the ideal generated by a finite set `T`, then `dim R ≤ #T`. -/
theorem ringKrullDim_le_card_of_le_radical [IsLocalRing R] [IsNoetherianRing R] (T : Finset R)
    (hTm : ∀ t ∈ T, t ∈ maximalIdeal R)
    (h : maximalIdeal R ≤ (Ideal.span (T : Set R)).radical) : ringKrullDim R ≤ T.card := by
  have hT : Ideal.span (T : Set R) ≤ maximalIdeal R := by
    rw [Ideal.span_le]
    exact fun t ht => hTm t ht
  have hmin := maximalIdeal_mem_minimalPrimes_of_le_radical hT h
  rw [← IsLocalRing.maximalIdeal_height_eq_ringKrullDim]
  exact_mod_cast Ideal.height_le_card_of_mem_minimalPrimes_span_finset hmin

/-- A nontrivial quotient of a local ring is local. -/
theorem isLocalRing_quotient [IsLocalRing R] {I : Ideal R} (hI : I ≠ ⊤) : IsLocalRing (R ⧸ I) :=
  have : Nontrivial (R ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hI
  IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective

/-- The Krull dimension of a nontrivial Noetherian local ring is a natural number. -/
theorem exists_ringKrullDim_eq_natCast [IsLocalRing R] [IsNoetherianRing R] :
    ∃ d : ℕ, ringKrullDim R = d := by
  obtain ⟨s, -, hs⟩ := Ideal.exists_finset_card_eq_height_of_isNoetherianRing (maximalIdeal R)
  exact ⟨s.card, by rw [← IsLocalRing.maximalIdeal_height_eq_ringKrullDim, ← hs]; rfl⟩

end General

/-! ### Local homomorphisms -/

section Local

variable {A B : Type*} [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
  [IsNoetherianRing A] [IsNoetherianRing B] [Algebra A B] [IsLocalHom (algebraMap A B)]

omit [IsNoetherianRing A] [IsNoetherianRing B] in
/-- `m_A B` is contained in `m_B`. -/
theorem map_maximalIdeal_le :
    (maximalIdeal A).map (algebraMap A B) ≤ maximalIdeal B := by
  rw [Ideal.map_le_iff_le_comap, IsLocalRing.maximalIdeal_comap]

/-- **Quasi-finite quotients have small dimension** (no flatness).  If `m_B ⊆ √(J + m_A B)`,
then `dim B ⧸ J ≤ dim A ⧸ (J ∩ A)`. -/
theorem ringKrullDim_quotient_le_of_le_radical (J : Ideal B)
    (hJ : maximalIdeal B ≤ (J ⊔ (maximalIdeal A).map (algebraMap A B)).radical) :
    ringKrullDim (B ⧸ J) ≤ ringKrullDim (A ⧸ J.comap (algebraMap A B)) := by
  classical
  by_cases hJt : J = ⊤
  · subst hJt
    have : Subsingleton (B ⧸ (⊤ : Ideal B)) := Ideal.Quotient.subsingleton_iff.mpr rfl
    rw [ringKrullDim_eq_bot_of_subsingleton]
    exact bot_le
  set I := J.comap (algebraMap A B) with hIdef
  have hIt : I ≠ ⊤ := by
    intro h
    apply hJt
    rw [Ideal.eq_top_iff_one]
    have h1 : (1 : A) ∈ I := by rw [h]; trivial
    have h2 := Ideal.mem_comap.mp h1
    rwa [map_one] at h2
  have : IsLocalRing (A ⧸ I) := isLocalRing_quotient hIt
  have : IsLocalRing (B ⧸ J) := isLocalRing_quotient hJt
  obtain ⟨t, htmin, htcard⟩ :=
    Ideal.exists_finset_card_eq_height_of_isNoetherianRing (maximalIdeal (A ⧸ I))
  -- lift the parameters of `A ⧸ I` to `A`
  let σ : A ⧸ I → A := Function.surjInv Ideal.Quotient.mk_surjective
  have hσ : ∀ x, Ideal.Quotient.mk I (σ x) = x := Function.surjInv_eq Ideal.Quotient.mk_surjective
  let t₀ : Finset A := t.image σ
  have hspan : Ideal.span (t : Set (A ⧸ I)) = (Ideal.span (t₀ : Set A)).map (Ideal.Quotient.mk I) := by
    rw [Ideal.map_span]
    congr 1
    ext x
    simp [t₀, hσ]
  -- `m_A ⊆ √(I + t₀)`
  have hmA : maximalIdeal A ≤ (I ⊔ Ideal.span (t₀ : Set A)).radical := by
    have h1 : maximalIdeal (A ⧸ I) ≤ (Ideal.span (t : Set (A ⧸ I))).radical :=
      maximalIdeal_le_radical_of_mem_minimalPrimes htmin
    have : IsLocalHom (Ideal.Quotient.mk I) :=
      IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
    rw [← IsLocalRing.maximalIdeal_comap (Ideal.Quotient.mk I)]
    refine (Ideal.comap_mono h1).trans ?_
    rw [Ideal.comap_radical, hspan, Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective,
      ← RingHom.ker_eq_comap_bot, Ideal.mk_ker, sup_comm]
  -- the images of `t₀` in `B ⧸ J`
  let u : Finset (B ⧸ J) := t₀.image fun a => Ideal.Quotient.mk J (algebraMap A B a)
  have hu : maximalIdeal (B ⧸ J) ≤ (Ideal.span (u : Set (B ⧸ J))).radical := by
    have hsurj : Function.Surjective (Ideal.Quotient.mk J) := Ideal.Quotient.mk_surjective
    rw [← IsLocalRing.map_maximalIdeal_of_surjective (Ideal.Quotient.mk J) hsurj]
    have hspanu : Ideal.span (u : Set (B ⧸ J)) =
        (J ⊔ Ideal.span ((t₀.image (algebraMap A B) : Finset B) : Set B)).map
          (Ideal.Quotient.mk J) := by
      rw [Ideal.map_sup, Ideal.map_quotient_self, bot_sup_eq, Ideal.map_span]
      congr 1
      ext x
      simp [u]
    rw [hspanu]
    refine (Ideal.map_mono ?_).trans (Ideal.map_radical_le _)
    refine hJ.trans ?_
    rw [Ideal.radical_le_radical_iff]
    refine sup_le (le_sup_left.trans Ideal.le_radical) ?_
    -- `m_A B ≤ √(J + t₀ B)`
    have h2 : (maximalIdeal A).map (algebraMap A B) ≤
        ((I ⊔ Ideal.span (t₀ : Set A)).radical).map (algebraMap A B) := Ideal.map_mono hmA
    refine h2.trans ((Ideal.map_radical_le _).trans (Ideal.radical_mono ?_))
    rw [Ideal.map_sup]
    refine sup_le_sup Ideal.map_comap_le ?_
    rw [Ideal.map_span]
    simp
  have hum : ∀ x ∈ u, x ∈ maximalIdeal (B ⧸ J) := by
    intro x hx
    obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hx
    obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp ha
    have hy' : y ∈ maximalIdeal (A ⧸ I) := htmin.1.2 (Ideal.subset_span hy)
    have : IsLocalHom (Ideal.Quotient.mk I) :=
      IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
    have hσy : σ y ∈ maximalIdeal A := by
      rw [← IsLocalRing.maximalIdeal_comap (Ideal.Quotient.mk I), Ideal.mem_comap, hσ]
      exact hy'
    have hB : algebraMap A B (σ y) ∈ maximalIdeal B := by
      rw [← IsLocalRing.maximalIdeal_comap (algebraMap A B)] at hσy
      exact hσy
    rw [← IsLocalRing.map_maximalIdeal_of_surjective (Ideal.Quotient.mk J)
      Ideal.Quotient.mk_surjective]
    exact Ideal.mem_map_of_mem _ hB
  have hdim := ringKrullDim_le_card_of_le_radical u hum hu
  refine hdim.trans ?_
  rw [← IsLocalRing.maximalIdeal_height_eq_ringKrullDim, ← htcard]
  exact_mod_cast (Finset.card_image_le.trans Finset.card_image_le)

omit [IsNoetherianRing A] in
/-- **Fibre parameters exist**: lifts of a system of parameters of the closed fibre ring. -/
theorem exists_fibre_parameters :
    ∃ s : Finset B, (∀ b ∈ s, b ∈ maximalIdeal B) ∧
      (s.card : WithBot ℕ∞) ≤ ringKrullDim (B ⧸ (maximalIdeal A).map (algebraMap A B)) ∧
      maximalIdeal B ≤ (Ideal.span (s : Set B) ⊔ (maximalIdeal A).map (algebraMap A B)).radical := by
  classical
  set K := (maximalIdeal A).map (algebraMap A B) with hK
  have hKt : K ≠ ⊤ := ne_top_of_le_ne_top (IsLocalRing.maximalIdeal.isMaximal B).ne_top
    map_maximalIdeal_le
  have : IsLocalRing (B ⧸ K) := isLocalRing_quotient hKt
  have : IsLocalHom (Ideal.Quotient.mk K) := IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
  obtain ⟨t, htmin, htcard⟩ :=
    Ideal.exists_finset_card_eq_height_of_isNoetherianRing (maximalIdeal (B ⧸ K))
  let σ : B ⧸ K → B := Function.surjInv Ideal.Quotient.mk_surjective
  have hσ : ∀ x, Ideal.Quotient.mk K (σ x) = x := Function.surjInv_eq Ideal.Quotient.mk_surjective
  refine ⟨t.image σ, ?_, ?_, ?_⟩
  · intro b hb
    obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hb
    have hxm : x ∈ maximalIdeal (B ⧸ K) := htmin.1.2 (Ideal.subset_span hx)
    rw [← IsLocalRing.maximalIdeal_comap (Ideal.Quotient.mk K), Ideal.mem_comap, hσ]
    exact hxm
  · rw [← IsLocalRing.maximalIdeal_height_eq_ringKrullDim, ← htcard]
    exact_mod_cast Finset.card_image_le
  · have h1 : maximalIdeal (B ⧸ K) ≤ (Ideal.span (t : Set (B ⧸ K))).radical :=
      maximalIdeal_le_radical_of_mem_minimalPrimes htmin
    have hspan : Ideal.span (t : Set (B ⧸ K)) =
        (Ideal.span ((t.image σ : Finset B) : Set B)).map (Ideal.Quotient.mk K) := by
      rw [Ideal.map_span]
      congr 1
      ext x
      simp [hσ]
    rw [← IsLocalRing.maximalIdeal_comap (Ideal.Quotient.mk K)]
    refine (Ideal.comap_mono h1).trans ?_
    rw [Ideal.comap_radical, hspan, Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective,
      ← RingHom.ker_eq_comap_bot, Ideal.mk_ker]

end Local

/-! ### Flat base change to `A ⧸ P` -/

section Flat

variable {A B : Type*} [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
  [IsNoetherianRing A] [IsNoetherianRing B] [Algebra A B] [IsLocalHom (algebraMap A B)]
  [Module.Flat A B]

/-- **Dimension formula after base change** (Matsumura 15.1): for a prime `P` of `A`,
`dim B ⧸ P B = dim A ⧸ P + dim B ⧸ m_A B`. -/
theorem ringKrullDim_quotient_map_eq (P : Ideal A) [P.IsPrime] :
    ringKrullDim (B ⧸ P.map (algebraMap A B)) =
      ringKrullDim (A ⧸ P) + ringKrullDim (B ⧸ (maximalIdeal A).map (algebraMap A B)) := by
  have hPm : P ≤ maximalIdeal A := IsLocalRing.le_maximalIdeal (Ideal.IsPrime.ne_top ‹_›)
  have hPB : P.map (algebraMap A B) ≤ maximalIdeal B :=
    (Ideal.map_mono hPm).trans map_maximalIdeal_le
  have hPBt : P.map (algebraMap A B) ≠ ⊤ :=
    ne_top_of_le_ne_top (IsLocalRing.maximalIdeal.isMaximal B).ne_top hPB
  have hPt : P ≠ ⊤ := Ideal.IsPrime.ne_top ‹_›
  have : IsLocalRing (A ⧸ P) := isLocalRing_quotient hPt
  have : IsLocalRing (B ⧸ P.map (algebraMap A B)) := isLocalRing_quotient hPBt
  -- local homomorphism
  have hloc : IsLocalHom (algebraMap (A ⧸ P) (B ⧸ P.map (algebraMap A B))) := by
    refine ⟨fun a ha => ?_⟩
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective a
    have h1 : algebraMap (A ⧸ P) (B ⧸ P.map (algebraMap A B)) (Ideal.Quotient.mk P a) =
        Ideal.Quotient.mk _ (algebraMap A B a) := rfl
    rw [h1] at ha
    have h2 : IsUnit (algebraMap A B a) := by
      by_contra hn
      have hm : algebraMap A B a ∈ maximalIdeal B := (IsLocalRing.mem_maximalIdeal _).mpr hn
      have : Ideal.Quotient.mk (P.map (algebraMap A B)) (algebraMap A B a) ∈
          maximalIdeal (B ⧸ P.map (algebraMap A B)) := by
        rw [← IsLocalRing.map_maximalIdeal_of_surjective _ Ideal.Quotient.mk_surjective]
        exact Ideal.mem_map_of_mem _ hm
      exact (IsLocalRing.mem_maximalIdeal _).mp this ha
    exact (isUnit_of_map_unit (algebraMap A B) a h2).map _
  -- flatness of the base change
  have hflat : Module.Flat (A ⧸ P) (B ⧸ P.map (algebraMap A B)) :=
    Module.Flat.of_linearEquiv
      (Algebra.TensorProduct.quotIdealMapEquivQuotTensor B P).toLinearEquiv
  have hform := Ideal.height_eq_height_add_of_liesOver_of_hasGoingDown
    (maximalIdeal (A ⧸ P)) (maximalIdeal (B ⧸ P.map (algebraMap A B)))
  -- the fibre ring of the base change is the fibre ring of `A → B`
  set K := (maximalIdeal (A ⧸ P)).map (algebraMap (A ⧸ P) (B ⧸ P.map (algebraMap A B))) with hK
  have hKeq : K = ((maximalIdeal A).map (algebraMap A B)).map
      (Ideal.Quotient.mk (P.map (algebraMap A B))) := by
    rw [hK, ← IsLocalRing.map_maximalIdeal_of_surjective (Ideal.Quotient.mk P)
      Ideal.Quotient.mk_surjective, Ideal.map_map, Ideal.map_map]
    rfl
  have hKt : K ≠ ⊤ := by
    have : K ≤ maximalIdeal (B ⧸ P.map (algebraMap A B)) := by
      rw [hK, Ideal.map_le_iff_le_comap, IsLocalRing.maximalIdeal_comap]
    exact ne_top_of_le_ne_top (IsLocalRing.maximalIdeal.isMaximal _).ne_top this
  have : IsLocalRing ((B ⧸ P.map (algebraMap A B)) ⧸ K) := isLocalRing_quotient hKt
  have hsup : P.map (algebraMap A B) ⊔ (maximalIdeal A).map (algebraMap A B) =
      (maximalIdeal A).map (algebraMap A B) := sup_eq_right.mpr (Ideal.map_mono hPm)
  let e : ((B ⧸ P.map (algebraMap A B)) ⧸ K) ≃+* B ⧸ (maximalIdeal A).map (algebraMap A B) :=
    (Ideal.quotEquivOfEq hKeq).trans ((DoubleQuot.quotQuotEquivQuotSup _ _).trans
      (Ideal.quotEquivOfEq hsup))
  have hfib : ((maximalIdeal (B ⧸ P.map (algebraMap A B))).map (Ideal.Quotient.mk K)).height =
      (maximalIdeal ((B ⧸ P.map (algebraMap A B)) ⧸ K)).height := by
    rw [IsLocalRing.map_maximalIdeal_of_surjective _ Ideal.Quotient.mk_surjective]
  rw [← IsLocalRing.maximalIdeal_height_eq_ringKrullDim,
    ← IsLocalRing.maximalIdeal_height_eq_ringKrullDim,
    ← ringKrullDim_eq_of_ringEquiv e, ← IsLocalRing.maximalIdeal_height_eq_ringKrullDim,
    hform, hfib]
  rfl

/-- **Key lemma.**  Let `s ⊆ m_B` be a system of fibre parameters: `#s ≤ dim B ⧸ m_A B` and
`m_B ⊆ √(s B + m_A B)`.  For every prime `P` of `A` and every `h ∈ A`, if the image of `h` lies
in `√(P B + s B)`, then `h ∈ P`. -/
theorem mem_of_algebraMap_mem_radical (s : Finset B) (hsm : ∀ b ∈ s, b ∈ maximalIdeal B)
    (hcard : (s.card : WithBot ℕ∞) ≤ ringKrullDim (B ⧸ (maximalIdeal A).map (algebraMap A B)))
    (hrad : maximalIdeal B ≤
      (Ideal.span (s : Set B) ⊔ (maximalIdeal A).map (algebraMap A B)).radical)
    (P : Ideal A) [P.IsPrime] {h : A}
    (hh : algebraMap A B h ∈ (P.map (algebraMap A B) ⊔ Ideal.span (s : Set B)).radical) :
    h ∈ P := by
  classical
  by_contra hP
  have hPm : P ≤ maximalIdeal A := IsLocalRing.le_maximalIdeal (Ideal.IsPrime.ne_top ‹_›)
  set PB := P.map (algebraMap A B) with hPBdef
  set S := Ideal.span (s : Set B) with hSdef
  set J := PB ⊔ S ⊔ Ideal.span {algebraMap A B h} with hJdef
  -- (1) `J` and `PB + S` have the same radical
  have hJrad : J.radical = (PB ⊔ S).radical := by
    refine le_antisymm ?_ (Ideal.radical_mono le_sup_left)
    rw [Ideal.radical_le_radical_iff]
    refine sup_le Ideal.le_radical ?_
    rw [Ideal.span_le, Set.singleton_subset_iff]
    exact hh
  have hdimJ : ringKrullDim (B ⧸ J) = ringKrullDim (B ⧸ (PB ⊔ S)) :=
    ringKrullDim_quotient_eq_of_radical_eq hJrad
  -- (2) Krull: `dim B ⧸ P B ≤ dim B ⧸ (P B + s B) + #s`
  have hPBm : PB ≤ maximalIdeal B := (Ideal.map_mono hPm).trans map_maximalIdeal_le
  have hPBt : PB ≠ ⊤ := ne_top_of_le_ne_top (IsLocalRing.maximalIdeal.isMaximal B).ne_top hPBm
  have : IsLocalRing (B ⧸ PB) := isLocalRing_quotient hPBt
  let s' : Finset (B ⧸ PB) := s.image (Ideal.Quotient.mk PB)
  have hs'jac : (s' : Set (B ⧸ PB)) ⊆ Ring.jacobson (B ⧸ PB) := by
    rw [IsLocalRing.ringJacobson_eq_maximalIdeal]
    intro x hx
    obtain ⟨b, hb, rfl⟩ := Finset.mem_image.mp hx
    rw [← IsLocalRing.map_maximalIdeal_of_surjective _ Ideal.Quotient.mk_surjective]
    exact Ideal.mem_map_of_mem _ (hsm b hb)
  have hKrull := ringKrullDim_le_ringKrullDim_quotient_add_card s' hs'jac
  have hspan' : Ideal.span (s' : Set (B ⧸ PB)) = S.map (Ideal.Quotient.mk PB) := by
    rw [hSdef, Ideal.map_span]
    simp [s']
  have e : ((B ⧸ PB) ⧸ Ideal.span (s' : Set (B ⧸ PB))) ≃+* B ⧸ (PB ⊔ S) :=
    (Ideal.quotEquivOfEq hspan').trans (DoubleQuot.quotQuotEquivQuotSup PB S)
  rw [ringKrullDim_eq_of_ringEquiv e] at hKrull
  -- (3) the dimension formula
  have hdimPB : ringKrullDim (B ⧸ PB) = ringKrullDim (A ⧸ P) +
      ringKrullDim (B ⧸ (maximalIdeal A).map (algebraMap A B)) := ringKrullDim_quotient_map_eq P
  rw [hdimPB] at hKrull
  -- (4) quasi-finiteness: `dim B ⧸ J ≤ dim A ⧸ (J ∩ A)`
  have hJm : maximalIdeal B ≤ (J ⊔ (maximalIdeal A).map (algebraMap A B)).radical := by
    refine hrad.trans (Ideal.radical_mono (sup_le_sup_right ?_ _))
    exact le_sup_right.trans le_sup_left
  have hqf := ringKrullDim_quotient_le_of_le_radical J hJm
  -- (5) `J ∩ A ⊇ P + (h)`
  have hcomap : P ⊔ Ideal.span {h} ≤ J.comap (algebraMap A B) := by
    refine sup_le ?_ ?_
    · refine (Ideal.le_comap_map).trans (Ideal.comap_mono ?_)
      exact le_sup_left.trans le_sup_left
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      exact le_sup_right (a := PB ⊔ S) (Ideal.subset_span (Set.mem_singleton _))
  have hmono := ringKrullDim_quotient_anti hcomap
  -- (6) cutting the domain `A ⧸ P` by the nonzero element `h`
  have hne : Ideal.Quotient.mk P h ≠ 0 := by
    rwa [ne_eq, Ideal.Quotient.eq_zero_iff_mem]
  have hnzd : Ideal.Quotient.mk P h ∈ nonZeroDivisors (A ⧸ P) := mem_nonZeroDivisors_of_ne_zero hne
  have hcut := ringKrullDim_quotient_succ_le_of_nonZeroDivisor hnzd
  have hspanh : Ideal.span {Ideal.Quotient.mk P h} = (Ideal.span {h}).map (Ideal.Quotient.mk P) := by
    rw [Ideal.map_span, Set.image_singleton]
  have e' : ((A ⧸ P) ⧸ Ideal.span {Ideal.Quotient.mk P h}) ≃+* A ⧸ (P ⊔ Ideal.span {h}) :=
    (Ideal.quotEquivOfEq hspanh).trans (DoubleQuot.quotQuotEquivQuotSup P (Ideal.span {h}))
  rw [ringKrullDim_eq_of_ringEquiv e'] at hcut
  -- assemble: `dim A ⧸ P + f ≤ dim B ⧸ J + #s ≤ dim A ⧸ (P + (h)) + f` with `f ≥ #s`
  have hPt : P ≠ ⊤ := Ideal.IsPrime.ne_top ‹_›
  have : IsLocalRing (A ⧸ P) := isLocalRing_quotient hPt
  obtain ⟨a, ha⟩ := exists_ringKrullDim_eq_natCast (R := A ⧸ P)
  have hKt : (maximalIdeal A).map (algebraMap A B) ≠ ⊤ :=
    ne_top_of_le_ne_top (IsLocalRing.maximalIdeal.isMaximal B).ne_top map_maximalIdeal_le
  have : IsLocalRing (B ⧸ (maximalIdeal A).map (algebraMap A B)) := isLocalRing_quotient hKt
  obtain ⟨f, hf⟩ := exists_ringKrullDim_eq_natCast (R := B ⧸ (maximalIdeal A).map (algebraMap A B))
  rw [ha, hf] at hKrull
  rw [hf] at hcard
  rw [ha] at hcut
  have hc : s'.card ≤ s.card := Finset.card_image_le
  have hcf : s.card ≤ f := by exact_mod_cast hcard
  -- `dim B ⧸ J ≥ a`
  have hBJ : (a : WithBot ℕ∞) ≤ ringKrullDim (B ⧸ J) := by
    rw [hdimJ]
    have hcases : ∀ y : WithBot ℕ∞, y = ⊥ ∨ ∃ x : ℕ∞, y = x := by
      intro y
      induction y using WithBot.recBotCoe with
      | bot => exact Or.inl rfl
      | coe x => exact Or.inr ⟨x, rfl⟩
    rcases hcases (ringKrullDim (B ⧸ (PB ⊔ S))) with hb | ⟨x, hx⟩
    · rw [hb] at hKrull
      simp at hKrull
    · rw [hx] at hKrull ⊢
      have h1 : ((a + f : ℕ) : WithBot ℕ∞) ≤ ((x + (f : ℕ∞) : ℕ∞) : WithBot ℕ∞) := by
        refine le_trans (le_of_eq (by push_cast; rfl)) (hKrull.trans ?_)
        have : (s'.card : WithBot ℕ∞) ≤ (f : WithBot ℕ∞) := by exact_mod_cast hc.trans hcf
        calc (x : WithBot ℕ∞) + (s'.card : WithBot ℕ∞) ≤ (x : WithBot ℕ∞) + (f : WithBot ℕ∞) := by
              gcongr
          _ = ((x + (f : ℕ∞) : ℕ∞) : WithBot ℕ∞) := by push_cast; rfl
      have h2 : ((a + f : ℕ) : ℕ∞) ≤ x + (f : ℕ∞) := WithBot.coe_le_coe.mp (by exact_mod_cast h1)
      have h3 : (a : ℕ∞) ≤ x := by
        have : (a : ℕ∞) + f ≤ x + f := by exact_mod_cast h2
        exact (ENat.add_le_add_iff_right (ENat.natCast_ne_top f)).mp this
      exact_mod_cast h3
  -- contradiction
  have hall : ((a : WithBot ℕ∞)) + 1 ≤ (a : WithBot ℕ∞) := by
    refine le_trans ?_ hcut
    gcongr
    exact hBJ.trans (hqf.trans hmono)
  have : ((a + 1 : ℕ) : WithBot ℕ∞) ≤ (a : WithBot ℕ∞) := by exact_mod_cast hall
  have : a + 1 ≤ a := by exact_mod_cast this
  omega

/-- **Fibre parameters of a flat local homomorphism.**  There is a finite set `s ⊆ m_B` with
`m_B ⊆ √(s B + m_A B)` such that, for every prime `P` of `A`, `√(P B + s B) ∩ A = P`. -/
theorem exists_flat_fibre_parameters :
    ∃ s : Finset B, (∀ b ∈ s, b ∈ maximalIdeal B) ∧
      maximalIdeal B ≤ (Ideal.span (s : Set B) ⊔ (maximalIdeal A).map (algebraMap A B)).radical ∧
      ∀ (P : Ideal A), P.IsPrime → ∀ h : A,
        algebraMap A B h ∈ (P.map (algebraMap A B) ⊔ Ideal.span (s : Set B)).radical → h ∈ P := by
  obtain ⟨s, hsm, hcard, hrad⟩ := exists_fibre_parameters (A := A) (B := B)
  exact ⟨s, hsm, hrad, fun P _ h hh => mem_of_algebraMap_mem_radical s hsm hcard hrad P hh⟩

end Flat

/-- **Fibre parameters of a flat local ring homomorphism** (ring-hom form). -/
theorem exists_flat_fibre_parameters_of_ringHom {A B : Type*} [CommRing A] [CommRing B]
    [IsLocalRing A] [IsLocalRing B] [IsNoetherianRing A] [IsNoetherianRing B]
    (φ : A →+* B) [IsLocalHom φ] (hφ : φ.Flat) :
    ∃ s : Finset B, (∀ b ∈ s, b ∈ maximalIdeal B) ∧
      maximalIdeal B ≤ (Ideal.span (s : Set B) ⊔ (maximalIdeal A).map φ).radical ∧
      ∀ (P : Ideal A), P.IsPrime → ∀ h : A,
        φ h ∈ (P.map φ ⊔ Ideal.span (s : Set B)).radical → h ∈ P := by
  let := φ.toAlgebra
  have : Module.Flat A B := hφ
  have : IsLocalHom (algebraMap A B) := ‹IsLocalHom φ›
  exact exists_flat_fibre_parameters (A := A) (B := B)

end

end Hironaka.HironakaG10ChowFlatFibreParameters
