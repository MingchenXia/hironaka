import Hironaka.Resolution.HironakaSingularSubspaceBlowupCartierChartLift

/-!
# The actual singular chart lift consumes the whole original centre ideal

The original Hadamard normal coordinates generate the WHOLE actual centre
ideal, and the actual native stalk map sends them to the original composed
functions. Consequently the singular chart lift accepts the SAME canonical
whole restricted pulled ideal, without a finite-coordinate-span premise.

Blueprint: `hironaka-singular-subspace-blowup-cartier-centre-ideal.tex`.
-/

set_option autoImplicit false

open Set Filter TopologicalSpace CategoryTheory Opposite AlgebraicGeometry
open scoped Topology Manifold ContDiff

namespace Hironaka.HironakaSingularSubspaceBlowupCartierCentreIdeal

open Hironaka.HolomorphicIdealSheaves Hironaka.BlowupSequences
  HironakaSmoothCentreRealDomainActualSheafStalk HironakaHolomorphicJetRankLoci
  HironakaActualAnalyticSubspace HironakaActualAnalyticSubspaceMaps
  HironakaActualAnalyticSubspaceOpenRestriction HironakaActualWholeStalkHolomorphicPullback
  HironakaSingularSubspaceBlowupCartier HironakaSingularSubspaceBlowupCartierChartLift
  BlowupFlatCoordinates VanishingIdealCoherent

noncomputable section

section Centre

variable {n : ℕ} {M : Type} [TopologicalSpace M]
  [ChartedSpace (ComplexModel n) M] [IsComplexManifold n M]
  {C : Set M} {y₀ : M} {k : ℕ}
  {Φ : LocalHolomorphicEquivAt (n := n) (chartAt (ComplexModel n) y₀ y₀)}

/-- The whole original actual centre ideal, at EVERY point of the genuine
flattening domain, is generated by the original normal coordinate germs. -/
theorem actualWholeSheafCentreIdeal_eq_span_normal_coordinates
    (hΦsrc : Φ.source ⊆ (chartAt (ComplexModel n) y₀).target)
    (hflat : ∀ {y : M}, y ∈ (chartAt (ComplexModel n) y₀).source →
      chartAt (ComplexModel n) y₀ y ∈ Φ.source →
      (y ∈ C ↔ Φ.toFun (chartAt (ComplexModel n) y₀ y) ∈ complexCoordinatePlane n k))
    (y : M) (hydom : y ∈ flatDomain Φ) :
    actualWholeSheafStalkIdeal (vanishingIdeal (n := n) C) y =
      Ideal.span (Set.range fun i : {i : Fin n // k ≤ i.val} =>
        actualOriginalFunctionGerm y (flatCoord Φ i.val) (holomorphicAt_flatCoord Φ i.val hydom)) := by
  classical
  let s : Fin n → M → ℂ := fun i => if k ≤ i.val then flatCoord Φ i else 0
  have hs : ∀ i, HolomorphicAt n (s i) y := by
    intro i
    dsimp only [s]
    split_ifs
    · exact holomorphicAt_flatCoord Φ i hydom
    · exact holomorphicAt_const 0
  have hgen : ∀ f, (vanishingIdeal (n := n) C).mem y f ↔
      IsInSpanAt (n := n) (· ∈ Set.range s) y f := by
    intro f
    constructor
    · intro hf
      obtain ⟨b, hb0, hbhol, hbeq⟩ := exists_eq_sum_flatCoord Φ hΦsrc hflat hydom hf
      refine ⟨hf.1, n, s, b, fun i => ⟨i, rfl⟩, hbhol, ?_⟩
      filter_upwards [hbeq] with z hz
      rw [hz]
      refine Finset.sum_congr rfl fun i _ => ?_
      by_cases hi : k ≤ i.val
      · simp only [s, if_pos hi]
      · rw [hb0 i (Nat.lt_of_not_le hi)]
        simp
    · intro hf
      apply mem_vanishingIdeal_of_isInSpanAt (g := s) _ hf
      intro i
      dsimp only [s]
      split_ifs with hi
      · exact flatCoord_mem_vanishingIdeal Φ hflat hi hydom
      · exact ⟨holomorphicAt_const 0, Eventually.of_forall fun _ _ => rfl⟩
  let E := actualStalkChartEquiv (n := n) y
  have hmasked : actualWholeSheafStalkIdeal (vanishingIdeal (n := n) C) y =
      Ideal.span (Set.range fun i => actualOriginalFunctionGerm y (s i) (hs i)) := by
    apply E.idealComapOrderIso.symm.injective
    change Ideal.map E.toRingHom (actualWholeSheafStalkIdeal (vanishingIdeal (n := n) C) y) =
      Ideal.map E.toRingHom (Ideal.span (Set.range fun i => actualOriginalFunctionGerm y (s i) (hs i)))
    rw [map_actualWholeSheafStalkIdeal, Ideal.map_span, ← Set.range_comp]
    change wholeChartStalkIdeal (vanishingIdeal (n := n) C) y y (mem_chart_source _ y) =
      Ideal.span (Set.range fun i => actualStalkChartEquiv (n := n) y
        (actualOriginalFunctionGerm y (s i) (hs i)))
    simp_rw [actualOriginalFunctionGerm_chart]
    exact wholeChartStalkIdeal_eq_actual_generator_span (vanishingIdeal (n := n) C) y s hs hgen
  rw [hmasked]
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro _ ⟨i, rfl⟩
    change actualOriginalFunctionGerm y (s i) (hs i) ∈ _
    by_cases hi : k ≤ i.val
    · have heq : actualOriginalFunctionGerm y (s i) (hs i) =
          actualOriginalFunctionGerm y (flatCoord Φ i) (holomorphicAt_flatCoord Φ i hydom) := by
        simp only [s, if_pos hi]
      rw [heq]
      exact Ideal.subset_span ⟨⟨i, hi⟩, rfl⟩
    · have hzero : actualOriginalFunctionGerm y (s i) (hs i) = 0 := by
        apply E.injective
        rw [actualOriginalFunctionGerm_chart, map_zero]
        simp only [s, if_neg hi]
        rfl
      rw [hzero]
      exact Ideal.zero_mem _
  · apply Ideal.span_le.mpr
    rintro _ ⟨i, rfl⟩
    have hm := Ideal.subset_span (s := Set.range fun j => actualOriginalFunctionGerm y (s j) (hs j))
      ⟨i.val, rfl⟩
    simpa only [s, if_pos i.property] using hm

end Centre

section Pullback

variable {n m : ℕ} {M N : Type} [TopologicalSpace M] [TopologicalSpace N]
  [ChartedSpace (ComplexModel n) M] [IsComplexManifold n M]
  [ChartedSpace (ComplexModel m) N] [IsComplexManifold m N]
  {C : Set M} {G : N → M} {y₀ : M} {k : ℕ}
  {Φ : LocalHolomorphicEquivAt (n := n) (chartAt (ComplexModel n) y₀ y₀)}

private theorem native_stalk_original_function
    (hG : ContMDiff 𝓘(ℂ, ComplexModel m) 𝓘(ℂ, ComplexModel n) ∞ G)
    (x : N) (f : M → ℂ) (hf : HolomorphicAt n f (G x)) :
    ((ChartedSpace.locallyRingedSpaceMap G hG).stalkMap x)
      (actualOriginalFunctionGerm (G x) f hf) =
    actualOriginalFunctionGerm x (f ∘ G)
      (hf.comp_contMDiff (Eventually.of_forall fun z => hG z)) := by
  apply (actualStalkChartEquiv (n := m) x).injective
  rw [actualNativeStalk_chart_pullback, actualOriginalFunctionGerm_chart,
    actualHolomorphicGermPullback_original_function, actualOriginalFunctionGerm_chart]

/-- The SAME canonical whole actual pulled centre ideal on the singular
source is exactly the finite actual original normal-coordinate span. -/
theorem actualRestrictedPulledCentreIdeal_eq_span_normal_coordinates
    (hC : IsClosedSubmanifold n C)
    (hG : ContMDiff 𝓘(ℂ, ComplexModel m) 𝓘(ℂ, ComplexModel n) ∞ G)
    (hΦsrc : Φ.source ⊆ (chartAt (ComplexModel n) y₀).target)
    (hflat : ∀ {y : M}, y ∈ (chartAt (ComplexModel n) y₀).source →
      chartAt (ComplexModel n) y₀ y ∈ Φ.source →
      (y ∈ C ↔ Φ.toFun (chartAt (ComplexModel n) y₀ y) ∈ complexCoordinatePlane n k))
    (S : Set N) (x : S) (hxdom : G x.val ∈ flatDomain Φ) :
    Ideal.map ((actualSubspaceInclusion (n := m) S).stalkMap x).hom
      (actualWholeSheafStalkIdeal
        (GermIdeal.pullback (m := m) G (vanishingIdeal (n := n) C)) x.val) =
    Ideal.span (Set.range fun i : {i : Fin n // k ≤ i.val} =>
      ((actualSubspaceInclusion (n := m) S).stalkMap x)
        (actualOriginalFunctionGerm x.val (flatCoord Φ i.val ∘ G)
          ((holomorphicAt_flatCoord Φ i.val hxdom).comp_contMDiff
            (Eventually.of_forall fun z => hG z)))) := by
  let F : actualComplexStructureStalk (n := n) (G x.val) →+*
      actualComplexStructureStalk (n := m) x.val :=
    ((ChartedSpace.locallyRingedSpaceMap G hG).stalkMap x.val).hom
  let Q : actualComplexStructureStalk (n := m) x.val →+*
      ((actualSubspaceSheaf (n := m) S).presheaf.stalk x).carrier :=
    ((actualSubspaceInclusion (n := m) S).stalkMap x).hom
  have hwhole : Ideal.map F (actualWholeSheafStalkIdeal (vanishingIdeal (n := n) C) (G x.val)) =
      actualWholeSheafStalkIdeal
        (GermIdeal.pullback (m := m) G (vanishingIdeal (n := n) C)) x.val :=
    map_actualWholeSheafStalkIdeal_native_pullback hG _ (isCoherent_vanishingIdeal hC) x.val
  change Ideal.map Q _ = _
  rw [← hwhole, actualWholeSheafCentreIdeal_eq_span_normal_coordinates hΦsrc hflat _ hxdom,
    Ideal.map_span, ← Set.range_comp, Ideal.map_span, ← Set.range_comp]
  congr 1
  apply congrArg Set.range
  funext i
  change Q (F (actualOriginalFunctionGerm (G x.val) (flatCoord Φ i.val)
    (holomorphicAt_flatCoord Φ i.val hxdom))) = _
  exact congrArg Q (native_stalk_original_function hG x.val (flatCoord Φ i.val)
    (holomorphicAt_flatCoord Φ i.val hxdom))

end Pullback

section Lift

variable {n m : ℕ} {M Y N : Type} [TopologicalSpace M] [TopologicalSpace Y]
  [TopologicalSpace N] [ChartedSpace (ComplexModel n) M] [IsComplexManifold n M]
  [ChartedSpace (ComplexModel n) Y] [IsComplexManifold n Y]
  [ChartedSpace (ComplexModel m) N] [IsComplexManifold m N]
  {C : Set M} {π : Y → M} {G : N → M} {y₀ : M} {k : ℕ}
  {Φ : LocalHolomorphicEquivAt (n := n) (chartAt (ComplexModel n) y₀ y₀)}

/-- The entire original actual Cartier ideal, rather than a finite-span or
ambient invertibility premise, internally produces a local singular lift. -/
theorem exists_local_holomorphic_blowup_lift_of_actual_cartier_ideal
    (hπ : IsBlowupAlong n C π)
    (hG : ContMDiff 𝓘(ℂ, ComplexModel m) 𝓘(ℂ, ComplexModel n) ∞ G)
    (hΦsrc : Φ.source ⊆ (chartAt (ComplexModel n) y₀).target)
    (hflat : ∀ {y : M}, y ∈ (chartAt (ComplexModel n) y₀).source →
      chartAt (ComplexModel n) y₀ y ∈ Φ.source →
      (y ∈ C ↔ Φ.toFun (chartAt (ComplexModel n) y₀ y) ∈ complexCoordinatePlane n k))
    (S : Set N) (x : S) (hxdom : G x.val ∈ flatDomain Φ)
    {alpha : ((actualSubspaceSheaf (n := m) S).presheaf.stalk x).carrier}
    (halpha : IsRegular alpha)
    (hCart : Ideal.map ((actualSubspaceInclusion (n := m) S).stalkMap x).hom
      (actualWholeSheafStalkIdeal
        (GermIdeal.pullback (m := m) G (vanishingIdeal (n := n) C)) x.val) = Ideal.span {alpha}) :
    ∃ (U : Opens N) (_hxU : x.val ∈ U) (L : U → Y)
      (_hL : ContMDiff 𝓘(ℂ, ComplexModel m) 𝓘(ℂ, ComplexModel n) ∞ L),
      ∀ z : U, z.val ∈ S → π (L z) = G z.val := by
  have hspan := (actualRestrictedPulledCentreIdeal_eq_span_normal_coordinates
    hπ.1 hG hΦsrc hflat S x hxdom).symm.trans hCart
  exact exists_local_holomorphic_blowup_lift_of_actual_cartier_coordinates
    hπ hG hΦsrc hflat S x hxdom halpha hspan

/-- The SAME whole actual Cartier ideal also internally produces the WHOLE
actual quotient-sheaf local square, without a target factorization input. -/
theorem exists_local_actual_blowup_square_of_actual_cartier_ideal
    (hπ : IsBlowupAlong n C π)
    (hG : ContMDiff 𝓘(ℂ, ComplexModel m) 𝓘(ℂ, ComplexModel n) ∞ G)
    (hΦsrc : Φ.source ⊆ (chartAt (ComplexModel n) y₀).target)
    (hflat : ∀ {y : M}, y ∈ (chartAt (ComplexModel n) y₀).source →
      chartAt (ComplexModel n) y₀ y ∈ Φ.source →
      (y ∈ C ↔ Φ.toFun (chartAt (ComplexModel n) y₀ y) ∈ complexCoordinatePlane n k))
    (S : Set N) (x : S) (hxdom : G x.val ∈ flatDomain Φ)
    {alpha : ((actualSubspaceSheaf (n := m) S).presheaf.stalk x).carrier}
    (halpha : IsRegular alpha)
    (hCart : Ideal.map ((actualSubspaceInclusion (n := m) S).stalkMap x).hom
      (actualWholeSheafStalkIdeal
        (GermIdeal.pullback (m := m) G (vanishingIdeal (n := n) C)) x.val) = Ideal.span {alpha}) :
    ∃ (U : Opens N) (_hxU : x.val ∈ U) (L : U → Y)
      (hL : ContMDiff 𝓘(ℂ, ComplexModel m) 𝓘(ℂ, ComplexModel n) ∞ L),
      actualSubspaceMap hL
          (C := (Subtype.val : U → N) ⁻¹' S) (D := Set.univ) (fun _ _ => Set.mem_univ _) ≫
        actualSubspaceMap hπ.contMDiff
          (C := Set.univ) (D := Set.univ) (fun _ _ => Set.mem_univ _) =
      actualSubspaceMap (hG.comp contMDiff_subtype_val)
        (C := (Subtype.val : U → N) ⁻¹' S) (D := Set.univ) (fun _ _ => Set.mem_univ _) := by
  have hspan := (actualRestrictedPulledCentreIdeal_eq_span_normal_coordinates
    hπ.1 hG hΦsrc hflat S x hxdom).symm.trans hCart
  exact exists_local_actual_blowup_square_of_actual_cartier_coordinates
    hπ hG hΦsrc hflat S x hxdom halpha hspan

end Lift

end

