import Hironaka.Blowup.BlowupExistenceOriginIdeal

set_option autoImplicit false
set_option linter.unusedSectionVars false

/-!
# The exceptional divisor of the model blowup

The pullback `originProj* 𝓘_0` of the ideal of the origin to `OriginBlowup d` is invertible:
on the `j`-th chart domain it is generated by the single function
`originGen j p = (originCoord j p) j`, whose zero set is the exceptional divisor.  This is the
fourth clause of `Hironaka.BlowupSequences.IsBlowupAlong` for the model blowup; the universal
property itself is `Hironaka.BlowupExistenceOriginUniversal`.
-/

open Set Filter
open scoped Topology Manifold ContDiff

namespace Hironaka.BlowupExistenceOriginGenerator

open Hironaka.HolomorphicIdealSheaves Hironaka.BlowupSequences
  BlowupExistenceOriginModel BlowupExistenceOriginIdeal

noncomputable section

variable {d : ℕ}

/-! ### Multiples stay in an ideal -/

variable {n : ℕ} {M : Type*} [TopologicalSpace M] [ChartedSpace (ComplexModel n) M]

/-- An ideal of germs is closed under multiplication by holomorphic germs. -/
theorem IsInSpanAt.mul_left {S : (M → ℂ) → Prop} {x : M} {f a h : M → ℂ}
    (hh : IsInSpanAt (n := n) S x h) (ha : HolomorphicAt n a x) (hf : HolomorphicAt n f x)
    (heq : f =ᶠ[𝓝 x] fun y => a y * h y) : IsInSpanAt (n := n) S x f := by
  obtain ⟨-, N, s, b, hs, hb, hsum⟩ := hh
  refine ⟨hf, N, s, fun t y => a y * b t y, hs, fun t => ha.mul (hb t), ?_⟩
  filter_upwards [heq, hsum] with y hy hy'
  rw [hy, hy', Finset.mul_sum]
  exact Finset.sum_congr rfl fun t _ => by ring

/-! ### Charts of the model blowup are smooth -/

theorem contMDiffAt_originCoord {j : Fin d} {p : OriginBlowup d} (hp : p ∈ originSource j) :
    ContMDiffAt 𝓘(ℂ, ComplexModel d) 𝓘(ℂ, ComplexModel d) ∞ (originCoord j) p :=
  (contMDiffOn_of_mem_maximalAtlas (IsManifold.subset_maximalAtlas (n := ∞)
    (originHomeomorph_mem_atlas j))).contMDiffAt ((isOpen_originSource j).mem_nhds hp)

theorem contMDiff_originMk (j : Fin d) :
    ContMDiff 𝓘(ℂ, ComplexModel d) 𝓘(ℂ, ComplexModel d) ∞ (originMk (d := d) j) := by
  rw [← contMDiffOn_univ]
  exact contMDiffOn_symm_of_mem_maximalAtlas (IsManifold.subset_maximalAtlas (n := ∞)
    (originHomeomorph_mem_atlas j))

theorem continuous_originMk (j : Fin d) : Continuous (originMk (d := d) j) :=
  (contMDiff_originMk j).continuous

/-- A holomorphic function of the chart coordinates is a holomorphic germ on the blowup. -/
theorem holomorphicAt_comp_originCoord {F : ComplexModel d → ℂ} (hF : Differentiable ℂ F)
    {j : Fin d} {p : OriginBlowup d} (hp : p ∈ originSource j) :
    HolomorphicAt d (fun q => F (originCoord j q)) p := by
  filter_upwards [(isOpen_originSource j).mem_nhds hp] with q hq
  exact (hF (originCoord j q)).mdifferentiableAt.comp q
    ((contMDiffAt_originCoord hq).mdifferentiableAt (by simp))

/-- The local generator of the exceptional divisor on the `j`-th chart. -/
def originGen (j : Fin d) (p : OriginBlowup d) : ℂ := originCoord j p j

theorem holomorphicAt_originGen {j : Fin d} {p : OriginBlowup d} (hp : p ∈ originSource j) :
    HolomorphicAt d (originGen j) p :=
  holomorphicAt_comp_originCoord
    (F := fun z : ComplexModel d => z j)
    ((EuclideanSpace.proj j : ComplexModel d →L[ℂ] ℂ).differentiable) hp

@[simp] theorem originGen_originMk (j : Fin d) (z : ComplexModel d) :
    originGen j (originMk j z) = z j := by
  rw [originGen, originCoord_originMk]

/-- On the `j`-th chart, the projection factors through the generator. -/
theorem originProj_apply_eq {j : Fin d} {p : OriginBlowup d} (hp : p ∈ originSource j)
    (i : Fin d) : originProj p i = originGen j p * gen j (originCoord j p) i := by
  conv_lhs => rw [show p = originMk j (originCoord j p) from (originMk_originCoord hp).symm]
  rfl

theorem originProj_eq_zero_iff {j : Fin d} {p : OriginBlowup d} (hp : p ∈ originSource j) :
    originProj p = 0 ↔ originGen j p = 0 := by
  constructor
  · intro h
    have := congrArg (fun z : ComplexModel d => z j) h
    rw [originProj_apply_eq hp j] at this
    simpa using this
  · intro h
    ext i
    rw [originProj_apply_eq hp i, h, zero_mul]
    simp

/-! ### The generator vanishes on no nonempty open set -/

/-- In `ℂᵈ` no nonempty open set is contained in a coordinate hyperplane. -/
theorem exists_coord_ne_zero_of_isOpen {V : Set (ComplexModel d)} (hV : IsOpen V)
    (hne : V.Nonempty) (j : Fin d) : ∃ z ∈ V, z j ≠ 0 := by
  obtain ⟨z₀, hz₀⟩ := hne
  by_cases h : z₀ j ≠ 0
  · exact ⟨z₀, hz₀, h⟩
  rw [not_not] at h
  set e : ComplexModel d := EuclideanSpace.single j (1 : ℂ) with he
  have hcont : Continuous fun t : ℂ => z₀ + t • e := by fun_prop
  have hmem : (fun t : ℂ => z₀ + t • e) ⁻¹' V ∈ 𝓝 (0 : ℂ) := by
    refine hcont.continuousAt.preimage_mem_nhds ?_
    simpa using hV.mem_nhds hz₀
  obtain ⟨t, htV, ht0⟩ : ∃ t : ℂ, (z₀ + t • e) ∈ V ∧ t ≠ 0 := by
    have hev : ∀ᶠ t : ℂ in 𝓝[≠] (0 : ℂ), z₀ + t • e ∈ V := nhdsWithin_le_nhds hmem
    have hev2 : ∀ᶠ t : ℂ in 𝓝[≠] (0 : ℂ), t ≠ 0 := self_mem_nhdsWithin
    exact (hev.and hev2).exists
  refine ⟨z₀ + t • e, htV, ?_⟩
  have : (z₀ + t • e) j = t := by
    change z₀ j + t * e j = t
    rw [h, he]
    simp
  rw [this]
  exact ht0

theorem exists_originGen_ne_zero {j : Fin d} {W : Set (OriginBlowup d)} (hW : IsOpen W)
    (hWsub : W ⊆ originSource j) (hne : W.Nonempty) : ∃ q ∈ W, originGen j q ≠ 0 := by
  obtain ⟨z, hzV, hzj⟩ := exists_coord_ne_zero_of_isOpen
    (hW.preimage (continuous_originMk j))
    (by
      obtain ⟨q, hq⟩ := hne
      exact ⟨originCoord j q, by simpa [originMk_originCoord (hWsub hq)] using hq⟩) j
  exact ⟨originMk j z, hzV, by rwa [originGen_originMk]⟩

/-! ### Invertibility of the pullback ideal -/

theorem isInvertible_pullback_originProj :
    (GermIdeal.pullback (m := d) (originProj (d := d))
      (vanishingIdeal (n := d) ({0} : Set (ComplexModel d)))).IsInvertible := by
  intro p
  obtain ⟨j, hj⟩ := exists_mem_originSource p
  refine ⟨originSource j, isOpen_originSource j, hj, originGen j,
    fun q hq => (holomorphicAt_originGen hq).mdifferentiableAt.mdifferentiableWithinAt,
    fun W hW hWsub hne => exists_originGen_ne_zero hW hWsub hne, fun q hq f => ?_⟩
  constructor
  · intro hf
    by_cases hz : originProj q = 0
    · obtain ⟨c, hc, hceq⟩ :=
        exists_eq_sum_compFun_of_mem_pullback contMDiff_originProj hz hf
      refine isInSpanAt_eq_iff.mpr ⟨hf.1,
        fun y => ∑ i, gen j (originCoord j y) i * c i y,
        HolomorphicAt.sum _ fun i _ =>
          (holomorphicAt_comp_originCoord
            (F := fun z : ComplexModel d => gen j z i)
            ((contDiff_gen_coord j i).differentiable (by simp)) hq).mul (hc i), ?_⟩
      filter_upwards [hceq, (isOpen_originSource j).mem_nhds hq] with y hy hy'
      rw [hy, Finset.sum_mul]
      refine Finset.sum_congr rfl fun i _ => ?_
      change originProj y i * c i y = _
      rw [originProj_apply_eq hy' i]
      ring
    · have hgen : originGen j q ≠ 0 := fun h => hz ((originProj_eq_zero_iff hq).mpr h)
      refine isInSpanAt_eq_iff.mpr ⟨hf.1, fun y => f y * (originGen j y)⁻¹,
        hf.1.mul (BlowupFlatCoordinates.HolomorphicAt.inv (holomorphicAt_originGen hq) hgen), ?_⟩
      filter_upwards [(holomorphicAt_originGen hq).continuousAt.eventually
        (isOpen_ne.mem_nhds hgen)] with y hy
      field_simp
  · intro hf
    obtain ⟨-, a, ha, heq⟩ := isInSpanAt_eq_iff.mp hf
    refine IsInSpanAt.mul_left
      (S := fun s => ∃ b, (vanishingIdeal (n := d) ({0} : Set (ComplexModel d))).mem
        (originProj q) b ∧ s = b ∘ originProj) ?_ ha hf.1 heq
    -- the generator is the `j`-th component of the projection near `q`
    have hcomp : (GermIdeal.pullback (m := d) (originProj (d := d))
        (vanishingIdeal (n := d) ({0} : Set (ComplexModel d)))).mem q
        (compFun (originProj (d := d)) j) :=
      compFun_mem_pullback contMDiff_originProj j q
    refine IsInSpanAt.mul_left hcomp (holomorphicAt_const 1) (holomorphicAt_originGen hq) ?_
    filter_upwards [(isOpen_originSource j).mem_nhds hq] with y hy
    change originGen j y = 1 * originProj y j
    rw [one_mul, originProj_apply_eq hy j]
    simp

end

end Hironaka.BlowupExistenceOriginGenerator
