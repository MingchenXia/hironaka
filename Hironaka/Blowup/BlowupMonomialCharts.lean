import Hironaka.Blowup.BlowupFlatCoordinates
import Hironaka.Blowup.LiftedOpenModel
import Mathlib.Analysis.Calculus.ContDiff.WithLp
import Hironaka.Analytic.ComplexAnalyticSubvarieties
import Hironaka.Manifold.ComplexManifold
import Hironaka.Manifold.HolomorphicContDiff
import Hironaka.Analytic.HolomorphicIdealSheaves
import Hironaka.Analytic.CoordinatePlaneDivision
import Hironaka.Analytic.HolomorphicGermAlgebra
set_option autoImplicit false
set_option linter.unusedSectionVars false

/-!
# The monomial charts of a blowup along a smooth centre

Let `C` be flattened near `y₀` onto `ℂᵏ × 0` by `Φ ∘ e`.  For `j ≥ k` the monomial map
`σⱼ(w)ᵢ = wᵢ wⱼ` (`i ≥ k`, `i ≠ j`), `σⱼ(w)ᵢ = wᵢ` otherwise, is the `j`-th affine chart of the
blowup of `ℂⁿ` along `ℂᵏ × 0`.  On `Tⱼ = σⱼ⁻¹(Φ.target)` (lifted to the universe of `M`),
`γⱼ = e⁻¹ ∘ Φ⁻¹ ∘ σⱼ : Tⱼ → M` is holomorphic, and the ideal `𝓘_C` pulls back along `γⱼ` to
the invertible ideal generated by `wⱼ`:

* `contMDiff_monomialChart`;
* `isInvertible_pullback_monomialChart`.

So by the universal property every blowup `π : Z → M` along `C` has holomorphic lifts
`ℓⱼ : Tⱼ → Z` with `π ∘ ℓⱼ = γⱼ` (`exists_monomialLift`).
-/

open Set Filter
open scoped Topology Manifold ContDiff

universe u

namespace Hironaka.BlowupMonomialCharts

open Hironaka.HolomorphicIdealSheaves Hironaka.BlowupSequences BlowupFlatCoordinates

noncomputable section

variable {n : ℕ}

/-- The monomial map `σⱼ`. -/
def monomial (k : ℕ) (j : Fin n) (w : ComplexModel n) : ComplexModel n :=
  WithLp.toLp 2 fun i => if k ≤ i.1 ∧ i ≠ j then w i * w j else w i

@[simp] theorem monomial_apply (k : ℕ) (j i : Fin n) (w : ComplexModel n) :
    monomial k j w i = if k ≤ i.1 ∧ i ≠ j then w i * w j else w i := rfl

theorem contDiff_monomial (k : ℕ) (j : Fin n) : ContDiff ℂ ∞ (monomial k j) := by
  refine (contDiff_piLp 2).2 fun i => ?_
  have hp : ∀ l : Fin n, ContDiff ℂ ∞ fun w : ComplexModel n => w l := fun l =>
    (EuclideanSpace.proj l : ComplexModel n →L[ℂ] ℂ).contDiff
  simp only [monomial]
  split_ifs
  · exact (hp i).mul (hp j)
  · exact hp i

variable {M : Type u} [TopologicalSpace M] [ChartedSpace (ComplexModel n) M]
  [IsComplexManifold n M]
  {y₀ : M} (Φ : LocalHolomorphicEquivAt (n := n) (chartAt (ComplexModel n) y₀ y₀))
  (k : ℕ) (j : Fin n)

/-- The domain `σⱼ⁻¹(Φ.target)` of the `j`-th monomial chart. -/
def monomialDomain : TopologicalSpace.Opens (ComplexModel n) :=
  ⟨monomial k j ⁻¹' Φ.target, Φ.isOpen_target.preimage (contDiff_monomial k j).continuous⟩

/-- The `j`-th monomial chart `e⁻¹ ∘ Φ⁻¹ ∘ σⱼ`, as a map on a test manifold in the universe
of `M`. -/
def monomialChart : LiftedOpen.{u} (monomialDomain Φ k j) → M := fun p =>
  (chartAt (ComplexModel n) y₀).symm (Φ.invFun (monomial k j (LiftedOpen.toModel _ p)))

variable {Φ k j}

theorem monomialChart_mem_flatDomain (hΦsrc : Φ.source ⊆ (chartAt (ComplexModel n) y₀).target)
    (p : LiftedOpen.{u} (monomialDomain Φ k j)) :
    monomialChart Φ k j p ∈ flatDomain Φ :=
  (flatInverse_mem Φ (LiftedOpen.toModel_mem _ p) hΦsrc).1

theorem flatCoord_monomialChart (hΦsrc : Φ.source ⊆ (chartAt (ComplexModel n) y₀).target)
    (p : LiftedOpen.{u} (monomialDomain Φ k j)) (i : Fin n) :
    flatCoord Φ i (monomialChart Φ k j p) = monomial k j (LiftedOpen.toModel _ p) i := by
  simp only [flatCoord, monomialChart]
  rw [(flatInverse_mem Φ (LiftedOpen.toModel_mem _ p) hΦsrc).2]

theorem contMDiff_monomialChart (hΦsrc : Φ.source ⊆ (chartAt (ComplexModel n) y₀).target) :
    ContMDiff 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel n) ∞ (monomialChart.{u} Φ k j) := by
  intro p
  set w := LiftedOpen.toModel _ p
  have hw : monomial k j w ∈ Φ.target := LiftedOpen.toModel_mem _ p
  have h1 : ContMDiffAt 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel n) ∞ Φ.invFun (monomial k j w) :=
    (contDiffAt_of_differentiableOn_complex Φ.invFun_holomorphic Φ.isOpen_target hw).contMDiffAt
  have h2 : ContMDiffAt 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel n) ∞
      (chartAt (ComplexModel n) y₀).symm (Φ.invFun (monomial k j w)) :=
    (contMDiffOn_chart_symm (n := ∞)).contMDiffAt
      ((chartAt (ComplexModel n) y₀).open_target.mem_nhds (hΦsrc (Φ.mapsTo_invFun hw)))
  exact h2.comp p (h1.comp p ((contDiff_monomial k j).contMDiff.contMDiffAt.comp p
    (LiftedOpen.contMDiff_toModel _ p)))

/-- The coordinate `wⱼ` on the `j`-th monomial chart. -/
def monomialGenerator (k : ℕ) (j : Fin n) (Φ : LocalHolomorphicEquivAt (n := n)
    (chartAt (ComplexModel n) y₀ y₀)) : LiftedOpen.{u} (monomialDomain Φ k j) → ℂ :=
  fun p => LiftedOpen.toModel _ p j

theorem holomorphicAt_coord_toModel (S : TopologicalSpace.Opens (ComplexModel n)) (i : Fin n)
    (p : LiftedOpen.{u} S) : HolomorphicAt n (fun p : LiftedOpen.{u} S => LiftedOpen.toModel S p i) p :=
  Eventually.of_forall fun _ => LiftedOpen.mdifferentiableAt_comp_toModel S (f := fun w => w i)
    (EuclideanSpace.proj i : ComplexModel n →L[ℂ] ℂ).differentiableAt

theorem exists_ne_zero_of_isOpen (S : TopologicalSpace.Opens (ComplexModel n)) (i : Fin n)
    (W : Set (LiftedOpen.{u} S)) (hW : IsOpen W) (hne : W.Nonempty) :
    ∃ p ∈ W, LiftedOpen.toModel S p i ≠ 0 := by
  obtain ⟨p, hp⟩ := hne
  by_cases h0 : LiftedOpen.toModel S p i ≠ 0
  · exact ⟨p, hp, h0⟩
  simp only [ne_eq, not_not] at h0
  set v := LiftedOpen.toModel S p
  have hV : LiftedOpen.toModel S '' W ∈ 𝓝 v :=
    (LiftedOpen.isOpenEmbedding_toModel S).isOpenMap W hW |>.mem_nhds ⟨p, hp, rfl⟩
  have hc : Continuous fun t : ℂ => CoordinatePlaneDivision.setCoord v i t :=
    (CoordinatePlaneDivision.differentiable_setCoord i).continuous.comp
      (continuous_const.prodMk continuous_id)
  have hc0 : Tendsto (fun t : ℂ => CoordinatePlaneDivision.setCoord v i t) (𝓝[≠] 0) (𝓝 v) := by
    have h00 : CoordinatePlaneDivision.setCoord v i 0 = v := by
      conv_lhs => rw [← h0]
      exact CoordinatePlaneDivision.setCoord_self v i
    have := hc.tendsto 0
    rw [h00] at this
    exact this.mono_left nhdsWithin_le_nhds
  obtain ⟨t, ⟨q, hq, hqt⟩, ht⟩ :=
    ((hc0.eventually hV).and self_mem_nhdsWithin).exists
  refine ⟨q, hq, ?_⟩
  rw [hqt]
  simpa using ht

/-- **The ideal of the centre pulls back to an invertible ideal on a monomial chart**,
generated by `wⱼ`. -/
theorem isInvertible_pullback_monomialChart {C : Set M}
    (hΦsrc : Φ.source ⊆ (chartAt (ComplexModel n) y₀).target)
    (hflat : ∀ {y : M}, y ∈ (chartAt (ComplexModel n) y₀).source →
      chartAt (ComplexModel n) y₀ y ∈ Φ.source →
        (y ∈ C ↔ Φ.toFun (chartAt (ComplexModel n) y₀ y) ∈ complexCoordinatePlane n k))
    (hj : k ≤ j.1) :
    (GermIdeal.pullback (m := n) (monomialChart.{u} Φ k j)
      (vanishingIdeal (n := n) C)).IsInvertible := by
  classical
  intro x
  refine ⟨univ, isOpen_univ, mem_univ x, monomialGenerator k j Φ, fun p _ =>
    (holomorphicAt_coord_toModel _ j p).mdifferentiableAt.mdifferentiableWithinAt,
    fun W hW _ hne => exists_ne_zero_of_isOpen _ j W hW hne, fun p _ g => ?_⟩
  have hγ := contMDiff_monomialChart (k := k) (j := j) hΦsrc
  show IsInSpanAt (n := n) (fun s => ∃ a, (vanishingIdeal (n := n) C).mem
    (monomialChart Φ k j p) a ∧ s = a ∘ monomialChart Φ k j) p g ↔ _
  constructor
  · intro hg
    refine IsInSpanAt.of_forall_eq_mul ?_ hg
    rintro s ⟨a, ha, rfl⟩
    obtain ⟨b, hb0, hbh, hbeq⟩ := exists_eq_sum_flatCoord Φ hΦsrc hflat
      (monomialChart_mem_flatDomain hΦsrc p) ha
    refine ⟨fun p' => ∑ i, b i (monomialChart Φ k j p') *
      (if k ≤ i.1 ∧ i ≠ j then LiftedOpen.toModel _ p' i else 1), ?_, ?_⟩
    · refine HolomorphicAt.sum _ fun i _ => ?_
      refine HolomorphicAt.mul ((hbh i).comp_contMDiff (Eventually.of_forall fun p' => hγ p')) ?_
      split_ifs
      · exact holomorphicAt_coord_toModel _ i p
      · exact holomorphicAt_const 1
    · filter_upwards [hγ.continuous.continuousAt.eventually hbeq] with p' hp'
      simp only [Function.comp_apply, hp', flatCoord_monomialChart hΦsrc, monomialGenerator,
        Finset.sum_mul]
      refine Finset.sum_congr rfl fun i _ => ?_
      by_cases hik : k ≤ i.1
      · by_cases hij : i = j
        · subst hij; simp
        · simp only [monomial_apply, hik, ne_eq, hij, not_false_eq_true, and_self, if_true]
          ring
      · simp [hb0 i (by omega)]
  · intro hg
    obtain ⟨hgh, a, ha, heq⟩ := isInSpanAt_eq_iff.mp hg
    refine isInSpanAt_of_eq_mul (s := flatCoord Φ j ∘ monomialChart Φ k j)
      ⟨flatCoord Φ j, flatCoord_mem_vanishingIdeal Φ hflat hj
        (monomialChart_mem_flatDomain hΦsrc p), rfl⟩ hgh ha ?_
    filter_upwards [heq] with p' hp'
    rw [hp']
    simp [flatCoord_monomialChart hΦsrc, monomialGenerator]

end

end Hironaka.BlowupMonomialCharts
