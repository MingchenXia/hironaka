/-!
# The blowup satisfies the universal property

Last module of the construction of the blowup. For a nowhere dense closed submanifold `C` of `X`, `blowupProj:
BlowupSpace n C → X` (Demailly's blowup, `BlowupSpaceManifold`) is a blowup of `X` along `C` in the sense of
`Hironaka.BlowupSequences.IsBlowupAlong` (`isBlowupAlong_blowupProj`):

* `isInvertible_pullback_blowupProj`: `π*𝓘_C` is invertible -- on a monomial chart `τ̃ⱼ` it is
  generated by `τⱼ ∘ π`, the coordinate `wⱼ` (every germ of `𝓘_C` is `∑ bᵢτᵢ` by Hadamard, and
  `τᵢ ∘ π = wᵢwⱼ` or `wⱼ`), and off `C` it is the unit ideal;
* `exists_not_mem_of_isOpen`, `lift_eqOn`: for a holomorphic `g : W → X` with `g*𝓘_C` invertible,
  `g⁻¹(X \ C)` is dense, so two continuous lifts agree (over `X \ C` the blowup has one point
  over each point, and the blowup is Hausdorff);
* `exists_local_lift`: a lift exists near each point -- writing `τᵢ ∘ g = aᵢu` for a local generator `u`, some `aⱼ`
  does not vanish, and `w = (τᵢ ∘ g (i < k or i = j), aᵢ/aⱼ)` lands in the target of `τ̃ⱼ` with `σⱼ(w) = Φ(e₀(g))`;
  the lift is `τ̃ⱼ⁻¹ ∘ w`;
* `exists_lift`: the local lifts glue, uniquely.
-/

open Set Filter
open scoped Topology Manifold ContDiff

universe u

namespace Hironaka.BlowupConstruction

open Hironaka.HolomorphicIdealSheaves Hironaka.BlowupSequences BlowupFlatCoordinates BlowupMonomialCharts BlowupSpaceTangent BlowupSpace

noncomputable section

variable {n : ℕ} {X : Type u} [TopologicalSpace X] [ChartedSpace (ComplexModel n) X]
  [IsComplexManifold n X] {C : Set X}

/-- A neighbourhood of a point of `ℂⁿ` contains a point with nonzero `j`-th coordinate. -/
theorem exists_coord_ne_zero_of_mem_nhds {w₀ : ComplexModel n} {N : Set (ComplexModel n)}
    (hN : N ∈ 𝓝 w₀) (j : Fin n) : ∃ w ∈ N, w j ≠ 0 := by
  by_cases h0 : w₀ j ≠ 0
  · exact ⟨w₀, mem_of_mem_nhds hN, h0⟩
  push Not at h0
  have hc : Continuous fun t : ℂ => CoordinatePlaneDivision.setCoord w₀ j t :=
    (CoordinatePlaneDivision.differentiable_setCoord j).continuous.comp
      (continuous_const.prodMk continuous_id)
  have hc0 : Tendsto (fun t : ℂ => CoordinatePlaneDivision.setCoord w₀ j t) (𝓝[≠] 0) (𝓝 w₀) := by
    have h00 : CoordinatePlaneDivision.setCoord w₀ j 0 = w₀ := by
      conv_lhs => rw [← h0]
      exact CoordinatePlaneDivision.setCoord_self w₀ j
    have := hc.tendsto 0
    rw [h00] at this
    exact this.mono_left nhdsWithin_le_nhds
  obtain ⟨t, htN, ht⟩ := ((hc0.eventually hN).and self_mem_nhdsWithin).exists
  exact ⟨_, htN, by simpa using ht⟩

section Universal

variable [hC : Fact (IsClosedSubmanifold n C)]

/-! ### The exceptional divisor: `π*𝓘_C` is invertible -/

/-- A germ holomorphic at `π p` pulls back to a germ holomorphic at `p`. -/
theorem holomorphicAt_comp_blowupProj {f : X → ℂ} {p : BlowupSpace n C}
    (hf : HolomorphicAt n f p.base) : HolomorphicAt n (f ∘ blowupProj n C) p :=
  hf.comp_contMDiff (Eventually.of_forall fun q => contMDiff_blowupProj q)

/-- The coordinates of a monomial chart `τ̃ⱼ` are holomorphic on its domain. -/
theorem FlatChart.holomorphicAt_coord (c : FlatChart n C) {p : BlowupSpace n C} (hp : p ∈ c.source)
    (i : Fin n) : HolomorphicAt n (fun q => c.toFun q i) p := by
  have hmax := IsManifold.subset_maximalAtlas (I := 𝓘(ℂ, ComplexModel n)) (n := ∞)
    (atlasHomeo_mem_atlas c.toPartialEquiv (Or.inl ⟨c, rfl⟩))
  have hon := contMDiffOn_of_mem_maximalAtlas hmax
  filter_upwards [c.isOpen_source.mem_nhds hp] with q hq
  have h1 : ContMDiffAt 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel n) ∞ c.homeo q :=
    hon.contMDiffAt (c.isOpen_source.mem_nhds hq)
  exact ((EuclideanSpace.proj i : ComplexModel n →L[ℂ] ℂ).differentiableAt.mdifferentiableAt).comp q
    (h1.mdifferentiableAt (by simp))

/-- On the domain of `τ̃ⱼ`, `τᵢ ∘ π = σⱼ(τ̃ⱼ)ᵢ` (`wᵢwⱼ` or `wᵢ`). -/
theorem FlatChart.τ_base_eq (c : FlatChart n C) {q : BlowupSpace n C} (hq : q ∈ c.source) (i : Fin n) :
    c.τ i q.base = monomial c.k c.j (c.toFun q) i := by
  rw [c.monomial_toFun hq]; rfl

/-- **`π*𝓘_C` is invertible**. -/
theorem isInvertible_pullback_blowupProj :
    (GermIdeal.pullback (m := n) (blowupProj n C) (vanishingIdeal (n := n) C)).IsInvertible := by
  classical
  intro p
  by_cases hpC : p.base ∈ C
  · -- a monomial chart: generator `τⱼ ∘ π`
    obtain ⟨j, hj, hp⟩ := exists_mem_flatSource hpC (mem_flatDomain_self (flatΦ n hpC)) hpC
    set c := mkFlat hpC j hj
    refine ⟨c.source, c.isOpen_source, hp, c.τ c.j ∘ blowupProj n C, fun q hq =>
      (holomorphicAt_comp_blowupProj (c.holomorphicAt_τ c.j hq.1)).mdifferentiableAt.mdifferentiableWithinAt,
      fun W hW hWsub ⟨q₀, hq₀⟩ => ?_, fun q hq g => ?_⟩
    · -- the generator vanishes on no nonempty open set
      have hN : c.homeo '' W ∈ 𝓝 (c.homeo q₀) :=
        c.homeo.image_mem_nhds (hWsub hq₀) (hW.mem_nhds hq₀)
      obtain ⟨w, ⟨q, hqW, rfl⟩, hwj⟩ := exists_coord_ne_zero_of_mem_nhds hN c.j
      refine ⟨q, hqW, ?_⟩
      show c.τ c.j q.base ≠ 0
      rw [c.τ_base_eq (hWsub hqW), c.monomial_apply_j]
      exact hwj
    · show IsInSpanAt (n := n) (fun s => ∃ a, (vanishingIdeal (n := n) C).mem (blowupProj n C q) a ∧
        s = a ∘ blowupProj n C) q g ↔ _
      constructor
      · intro hg
        refine IsInSpanAt.of_forall_eq_mul ?_ hg
        rintro s ⟨a, ha, rfl⟩
        obtain ⟨b, hb0, hbh, hbeq⟩ := exists_eq_sum_flatCoord c.Φ c.hsrc c.hflat hq.1 ha
        refine ⟨fun q' => ∑ i, b i (blowupProj n C q') *
          (if c.k ≤ i.1 ∧ i ≠ c.j then c.toFun q' i else 1), ?_, ?_⟩
        · refine HolomorphicAt.sum _ fun i _ => ?_
          refine HolomorphicAt.mul (holomorphicAt_comp_blowupProj (hbh i)) ?_
          split_ifs
          · exact c.holomorphicAt_coord hq i
          · exact holomorphicAt_const 1
        · have hcont : ContinuousAt (blowupProj n C) q := continuous_blowupProj.continuousAt
          filter_upwards [hcont.eventually hbeq, c.isOpen_source.mem_nhds hq] with q' hq' hq's
          simp only [Function.comp_apply, Finset.sum_mul]
          rw [hq']
          refine Finset.sum_congr rfl fun i _ => ?_
          show b i q'.base * c.τ i q'.base =
            (b i q'.base * (if c.k ≤ i.1 ∧ i ≠ c.j then c.toFun q' i else 1)) * c.τ c.j q'.base
          rw [c.τ_base_eq hq's i, c.τ_base_eq hq's c.j, monomial_apply, c.monomial_apply_j]
          by_cases hik : c.k ≤ i.1
          · by_cases hij : i = c.j
            · have h1 : ¬ (c.k ≤ i.1 ∧ i ≠ c.j) := fun h => h.2 hij
              rw [if_neg h1, if_neg h1, hij]
              ring
            · simp only [hik, ne_eq, hij, not_false_eq_true, and_self, if_true]
              ring
          · simp [hb0 i (by omega)]
      · intro hg
        obtain ⟨hgh, a, ha, heq⟩ := isInSpanAt_eq_iff.mp hg
        exact isInSpanAt_of_eq_mul ⟨c.τ c.j, c.τ_mem_vanishingIdeal hq.1 c.hj, rfl⟩ hgh ha heq
  · -- off the centre: the unit ideal
    have hU : IsOpen (blowupProj n C ⁻¹' Cᶜ) :=
      (isClosed_centre (n := n)).isOpen_compl.preimage continuous_blowupProj
    refine ⟨blowupProj n C ⁻¹' Cᶜ, hU, hpC, fun _ => 1, fun _ _ =>
      mdifferentiableAt_const.mdifferentiableWithinAt, fun W _ _ ⟨y, hy⟩ => ⟨y, hy, one_ne_zero⟩,
      fun q hq g => ?_⟩
    have hqC : blowupProj n C q ∉ C := hq
    have hone : (vanishingIdeal (n := n) C).mem (blowupProj n C q) (fun _ => 1) := by
      refine ⟨holomorphicAt_const 1, ?_⟩
      filter_upwards [(isClosed_centre (n := n)).isOpen_compl.mem_nhds hqC] with z hz hzC
      exact absurd hzC hz
    constructor
    · intro hg
      exact isInSpanAt_of_eq_mul rfl hg.1 hg.1 (Eventually.of_forall fun _ => by simp)
    · intro hg
      exact isInSpanAt_of_eq_mul (s := (fun _ => (1 : ℂ)) ∘ blowupProj n C)
        (S := fun s => ∃ a, (vanishingIdeal (n := n) C).mem (blowupProj n C q) a ∧
          s = a ∘ blowupProj n C) ⟨fun _ => 1, hone, rfl⟩ hg.1 hg.1
        (Eventually.of_forall fun _ => by simp)

/-! ### Uniqueness of lifts -/

variable {m : ℕ} {W : Type*} [TopologicalSpace W] [ChartedSpace (ComplexModel m) W]
  [IsComplexManifold m W] {g : W → X}

/-- If `g*𝓘_C` is invertible, `g` maps no nonempty open set into `C`. -/
theorem exists_not_mem_of_isOpen (hg : ContMDiff 𝓘(ℂ, ComplexModel m) 𝓘(ℂ, ComplexModel n) ∞ g)
    (hinv : (GermIdeal.pullback (m := m) g (vanishingIdeal (n := n) C)).IsInvertible)
    {V : Set W} (hV : IsOpen V) (hne : V.Nonempty) : ∃ y ∈ V, g y ∉ C := by
  obtain ⟨z₀, hz₀⟩ := hne
  obtain ⟨U, hU, hzU, u, hu, hune, hmem⟩ := hinv z₀
  by_contra hall
  push Not at hall
  have huhol : HolomorphicAt m u z₀ := by
    filter_upwards [hU.mem_nhds hzU] with y hy
    exact (hu y hy).mdifferentiableAt (hU.mem_nhds hy)
  have huI := (hmem z₀ hzU u).mpr (isInSpanAt_eq_iff.mpr ⟨huhol, fun _ => 1, holomorphicAt_const 1,
    Eventually.of_forall fun _ => (one_mul _).symm⟩)
  obtain ⟨-, N, s, a, hs, -, hsum⟩ := huI
  choose b hb hsb using hs
  have hvan : ∀ᶠ y in 𝓝 z₀, ∀ i, g y ∈ C → b i (g y) = 0 :=
    eventually_all.mpr fun i => hg.continuous.continuousAt.eventually (hb i).2
  obtain ⟨O, hOsub, hO, hzO⟩ := mem_nhds_iff.mp (hsum.and hvan)
  obtain ⟨y, hy, huy⟩ := hune (O ∩ V ∩ U) ((hO.inter hV).inter hU) inter_subset_right
    ⟨z₀, ⟨hzO, hz₀⟩, hzU⟩
  apply huy
  obtain ⟨hsumy, hvany⟩ := hOsub hy.1.1
  rw [hsumy]
  refine Finset.sum_eq_zero fun i _ => ?_
  rw [hsb i, Function.comp_apply, hvany i (hall y hy.1.2), mul_zero]

/-- **Uniqueness of lifts.** -/
theorem lift_eqOn (hg : ContMDiff 𝓘(ℂ, ComplexModel m) 𝓘(ℂ, ComplexModel n) ∞ g)
    (hinv : (GermIdeal.pullback (m := m) g (vanishingIdeal (n := n) C)).IsInvertible)
    {V : Set W} (hV : IsOpen V) {h₁ h₂ : W → BlowupSpace n C}
    (hc₁ : ∀ y ∈ V, ContinuousAt h₁ y) (hc₂ : ∀ y ∈ V, ContinuousAt h₂ y)
    (he₁ : ∀ y ∈ V, blowupProj n C (h₁ y) = g y) (he₂ : ∀ y ∈ V, blowupProj n C (h₂ y) = g y) :
    EqOn h₁ h₂ V := by
  by_contra hcon
  obtain ⟨y₀, hy₀V, hy₀⟩ : ∃ y, y ∈ V ∧ h₁ y ≠ h₂ y := by
    by_contra hall
    exact hcon fun y hy => by
      by_contra hne
      exact hall ⟨y, hy, hne⟩
  have hSopen : IsOpen {y | y ∈ V ∧ h₁ y ≠ h₂ y} := by
    rw [isOpen_iff_mem_nhds]
    rintro y ⟨hyV, hy⟩
    obtain ⟨A, B, hA, hB, hyA, hyB, hAB⟩ := t2_separation hy
    filter_upwards [hV.mem_nhds hyV, (hc₁ y hyV).eventually (hA.mem_nhds hyA),
      (hc₂ y hyV).eventually (hB.mem_nhds hyB)] with y' h1 h2 h3
    exact ⟨h1, fun hEq => Set.disjoint_left.mp hAB h2 (by rw [← hEq] at h3; exact h3)⟩
  obtain ⟨y, hy, hgy⟩ := exists_not_mem_of_isOpen hg hinv hSopen ⟨y₀, hy₀V, hy₀⟩
  refine hy.2 (eq_of_base_eq_of_not_mem ((he₁ y hy.1).trans (he₂ y hy.1).symm) ?_)
  show blowupProj n C (h₁ y) ∉ C
  rw [he₁ y hy.1]; exact hgy

/-! ### Local existence of lifts -/

/-- A map into the blowup is holomorphic at `y` if it stays in a chart near `y` and is holomorphic
in that chart. -/
theorem contMDiffAt_of_mem_chart {a : PartialEquiv (BlowupSpace n C) (ComplexModel n)}
    (ha : a ∈ blowupAtlas n C) {φ : W → BlowupSpace n C} {y : W}
    (hy : ∀ᶠ y' in 𝓝 y, φ y' ∈ a.source)
    (h : ContMDiffAt 𝓘(ℂ, ComplexModel m) 𝓘(ℂ, ComplexModel n) ∞ (fun y' => a (φ y')) y) :
    ContMDiffAt 𝓘(ℂ, ComplexModel m) 𝓘(ℂ, ComplexModel n) ∞ φ y := by
  have hmax := IsManifold.subset_maximalAtlas (I := 𝓘(ℂ, ComplexModel n)) (n := ∞)
    (atlasHomeo_mem_atlas a ha)
  have hsymm := contMDiffOn_symm_of_mem_maximalAtlas hmax
  have hT : (atlasHomeo a ha).target ∈ 𝓝 (a (φ y)) :=
    (atlasHomeo a ha).open_target.mem_nhds (a.map_source hy.self_of_nhds)
  have h1 := (hsymm.contMDiffAt hT).comp y h
  refine h1.congr_of_eventuallyEq ?_
  filter_upwards [hy] with y' hy'
  exact (a.left_inv hy').symm

/-- Off the centre the lift is `y ↦ (g y, 0)`. -/
theorem exists_local_lift_of_not_mem
    (hg : ContMDiff 𝓘(ℂ, ComplexModel m) 𝓘(ℂ, ComplexModel n) ∞ g) {z₀ : W} (hz : g z₀ ∉ C) :
    ∃ U : Set W, IsOpen U ∧ z₀ ∈ U ∧ ∃ φ : W → BlowupSpace n C,
      (∀ y ∈ U, ContMDiffAt 𝓘(ℂ, ComplexModel m) 𝓘(ℂ, ComplexModel n) ∞ φ y) ∧
      ∀ y ∈ U, blowupProj n C (φ y) = g y := by
  classical
  let φ : W → BlowupSpace n C := fun y =>
    if h : g y ∈ C then offPoint (g z₀) hz else offPoint (g y) h
  have hφ : ∀ y (h : g y ∉ C), φ y = offPoint (g y) h := fun y h => by simp only [φ, dif_neg h]
  have hU : IsOpen (g ⁻¹' Cᶜ) := (isClosed_centre (n := n)).isOpen_compl.preimage hg.continuous
  refine ⟨g ⁻¹' Cᶜ, hU, hz, φ, fun y hy => ?_, fun y hy => by rw [hφ y hy]; rfl⟩
  have hyC : g y ∉ C := hy
  set o : OffChart n C := ⟨g y, hyC⟩
  have hsrc : ∀ᶠ y' in 𝓝 y, φ y' ∈ o.toPartialEquiv.source := by
    filter_upwards [hU.mem_nhds hy, hg.continuous.continuousAt.eventually
      ((chartAt (ComplexModel n) (g y)).open_source.mem_nhds (mem_chart_source _ (g y)))]
      with y' hy'C hy'src
    rw [hφ y' hy'C]
    exact ⟨hy'src, hy'C⟩
  refine contMDiffAt_of_mem_chart (Or.inr ⟨o, rfl⟩) hsrc ?_
  have hev : (fun y' => o.toPartialEquiv (φ y')) =ᶠ[𝓝 y]
      fun y' => chartAt (ComplexModel n) (g y) (g y') := by
    filter_upwards [hU.mem_nhds hy] with y' hy'C
    rw [hφ y' hy'C]; rfl
  refine ContMDiffAt.congr_of_eventuallyEq ?_ hev
  exact ((contMDiffOn_chart (n := ∞)).contMDiffAt
    ((chartAt (ComplexModel n) (g y)).open_source.mem_nhds (mem_chart_source _ (g y)))).comp y (hg y)

/-- Over the centre: if `τᵢ ∘ g = aᵢu` with `aⱼ(z₀) ≠ 0`, the lift is `τ̃ⱼ⁻¹ ∘ w` with
`w = (τᵢ ∘ g (i < k or i = j), aᵢ/aⱼ (k ≤ i ≠ j))`. -/
theorem exists_local_lift_of_mem
    (hg : ContMDiff 𝓘(ℂ, ComplexModel m) 𝓘(ℂ, ComplexModel n) ∞ g)
    (hinv : (GermIdeal.pullback (m := m) g (vanishingIdeal (n := n) C)).IsInvertible)
    {z₀ : W} (hz : g z₀ ∈ C) :
    ∃ U : Set W, IsOpen U ∧ z₀ ∈ U ∧ ∃ φ : W → BlowupSpace n C,
      (∀ y ∈ U, ContMDiffAt 𝓘(ℂ, ComplexModel m) 𝓘(ℂ, ComplexModel n) ∞ φ y) ∧
      ∀ y ∈ U, blowupProj n C (φ y) = g y := by
  classical
  obtain ⟨U₀, hU₀, hzU₀, u, hu, hune, hmem⟩ := hinv z₀
  set Φ := flatΦ n hz with hΦ
  set k := flatK n hz with hk
  obtain ⟨hsrc, hflat⟩ := flatΦ_spec (n := n) hz
  have hdom : g z₀ ∈ flatDomain Φ := mem_flatDomain_self Φ
  have huhol : ∀ y ∈ U₀, HolomorphicAt m u y := fun y hy => by
    filter_upwards [hU₀.mem_nhds hy] with y' hy'
    exact (hu y' hy').mdifferentiableAt (hU₀.mem_nhds hy')
  have hτg : ∀ i, HolomorphicAt m (fun y => flatCoord Φ i (g y)) z₀ := fun i =>
    (holomorphicAt_flatCoord Φ i hdom).comp_contMDiff (Eventually.of_forall fun y => hg y)
  -- the normal flat coordinates of `g` are multiples of the generator
  have hcomp : ∀ i : Fin n, ∃ a : W → ℂ, HolomorphicAt m a z₀ ∧
      (k ≤ i.1 → (fun y => flatCoord Φ i (g y)) =ᶠ[𝓝 z₀] fun y => a y * u y) := by
    intro i
    by_cases hi : k ≤ i.1
    · have hmemi : (GermIdeal.pullback (m := m) g (vanishingIdeal (n := n) C)).mem z₀
          (fun y => flatCoord Φ i (g y)) :=
        isInSpanAt_of_eq_mul (s := flatCoord Φ i ∘ g)
          (S := fun s => ∃ a, (vanishingIdeal (n := n) C).mem (g z₀) a ∧ s = a ∘ g)
          ⟨flatCoord Φ i, flatCoord_mem_vanishingIdeal Φ hflat hi hdom, rfl⟩ (hτg i)
          (holomorphicAt_const 1) (Eventually.of_forall fun _ => (one_mul _).symm)
      obtain ⟨-, a, ha, heq⟩ := isInSpanAt_eq_iff.mp ((hmem z₀ hzU₀ _).mp hmemi)
      exact ⟨a, ha, fun _ => heq⟩
    · exact ⟨fun _ => 0, holomorphicAt_const 0, fun h => absurd h hi⟩
  choose a ha haeq using hcomp
  -- the generator is a combination of the normal flat coordinates of `g` (Hadamard)
  have huI := (hmem z₀ hzU₀ u).mpr (isInSpanAt_eq_iff.mpr ⟨huhol z₀ hzU₀, fun _ => 1,
    holomorphicAt_const 1, Eventually.of_forall fun _ => (one_mul _).symm⟩)
  obtain ⟨-, N, s, c, hs, hc, hsum⟩ := huI
  choose b hb hsb using hs
  have hhad : ∀ l, ∃ β : Fin n → X → ℂ, (∀ i : Fin n, i.1 < k → β i = 0) ∧
      (∀ i, HolomorphicAt n (β i) (g z₀)) ∧
      b l =ᶠ[𝓝 (g z₀)] fun x => ∑ i, β i x * flatCoord Φ i x :=
    fun l => exists_eq_sum_flatCoord Φ hsrc hflat hdom (hb l)
  choose β hβ0 hβh hβeq using hhad
  set γ : Fin n → W → ℂ := fun i y => ∑ l, c l y * β l i (g y) with hγdef
  have hγ : ∀ i, HolomorphicAt m (γ i) z₀ := fun i =>
    HolomorphicAt.sum _ fun l _ =>
      (hc l).mul ((hβh l i).comp_contMDiff (Eventually.of_forall fun y => hg y))
  have hγ0 : ∀ i : Fin n, i.1 < k → ∀ y, γ i y = 0 := fun i hi y => by
    simp [hγdef, hβ0 _ i hi]
  have hueq : u =ᶠ[𝓝 z₀] fun y => ∑ i, γ i y * flatCoord Φ i (g y) := by
    filter_upwards [hsum, hg.continuous.continuousAt.eventually (eventually_all.mpr fun l => hβeq l)]
      with y hy hy'
    rw [hy]
    calc ∑ l, c l y * s l y = ∑ l, c l y * ∑ i, β l i (g y) * flatCoord Φ i (g y) := by
          refine Finset.sum_congr rfl fun l _ => ?_
          rw [hsb l, Function.comp_apply, hy' l]
      _ = ∑ i, γ i y * flatCoord Φ i (g y) := by
          simp only [hγdef, Finset.mul_sum, Finset.sum_mul]
          rw [Finset.sum_comm]
          exact Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun l _ => by ring
  have hnormal : ∀ᶠ y in 𝓝 z₀, ∀ i : Fin n, k ≤ i.1 → flatCoord Φ i (g y) = a i y * u y :=
    eventually_all.mpr fun i => by
      by_cases hi : k ≤ i.1
      · exact (haeq i hi).mono fun y hy _ => hy
      · exact Eventually.of_forall fun y h => absurd h hi
  -- some multiplier does not vanish at `z₀`
  have hexists : ∃ j : Fin n, k ≤ j.1 ∧ a j z₀ ≠ 0 := by
    by_contra hall
    push Not at hall
    set F : W → ℂ := fun y => ∑ i, γ i y * a i y with hFdef
    have hFc : ContinuousAt (fun y => 1 - F y) z₀ :=
      continuousAt_const.sub (HolomorphicAt.sum _ fun i _ => (hγ i).mul (ha i)).continuousAt
    have hF0 : (1 : ℂ) - F z₀ ≠ 0 := by
      have : F z₀ = 0 := Finset.sum_eq_zero fun i _ => by
        by_cases hi : k ≤ i.1
        · rw [hall i hi, mul_zero]
        · rw [hγ0 i (by omega), zero_mul]
      rw [this, sub_zero]; exact one_ne_zero
    have hzero : ∀ᶠ y in 𝓝 z₀, u y * (1 - F y) = 0 := by
      filter_upwards [hueq, hnormal] with y hy hy'
      have hsplit : ∑ i, γ i y * flatCoord Φ i (g y) = F y * u y := by
        rw [hFdef, Finset.sum_mul]
        refine Finset.sum_congr rfl fun i _ => ?_
        by_cases hi : k ≤ i.1
        · rw [hy' i hi]; ring
        · rw [hγ0 i (by omega)]; ring
      linear_combination hy + hsplit
    obtain ⟨V, hVsub, hVopen, hzV⟩ := mem_nhds_iff.mp
      ((hFc.eventually (isOpen_ne.mem_nhds hF0)).and (hzero.and (hU₀.mem_nhds hzU₀)))
    obtain ⟨y, hyV, huy⟩ := hune V hVopen (fun y hy => (hVsub hy).2.2) ⟨z₀, hzV⟩
    obtain ⟨hF1, hF2, -⟩ := hVsub hyV
    rcases mul_eq_zero.mp hF2 with h | h
    · exact huy h
    · exact hF1 h
  obtain ⟨j, hj, haj⟩ := hexists
  set cc := mkFlat hz j hj with hcc
  set zc : W → ComplexModel n := fun y => WithLp.toLp 2 fun i =>
    if k ≤ i.1 ∧ i ≠ j then a i y * (a j y)⁻¹ else flatCoord Φ i (g y) with hzc
  have hev : {y | a j y ≠ 0 ∧ g y ∈ flatDomain Φ ∧
      (∀ i : Fin n, k ≤ i.1 → flatCoord Φ i (g y) = a i y * u y) ∧
      (∀ i, HolomorphicAt m (a i) y) ∧ (∀ i, HolomorphicAt m (fun y => flatCoord Φ i (g y)) y)}
      ∈ 𝓝 z₀ :=
    ((ha j).continuousAt.eventually (isOpen_ne.mem_nhds haj)).and
      ((hg.continuous.continuousAt.eventually ((isOpen_flatDomain Φ).mem_nhds hdom)).and
        (hnormal.and ((eventually_all.mpr fun i => (ha i).eventually).and
          (eventually_all.mpr fun i => (hτg i).eventually))))
  obtain ⟨U, hUsub, hUopen, hzU⟩ := mem_nhds_iff.mp hev
  have hmono : ∀ y ∈ U, monomial k j (zc y) = Φ.toFun (chartAt (ComplexModel n) (g z₀) (g y)) := by
    intro y hy
    obtain ⟨hajy, -, hrel, -, -⟩ := hUsub hy
    ext i
    rw [monomial_apply]
    simp only [hzc, PiLp.toLp_apply]
    by_cases hi : k ≤ i.1 ∧ i ≠ j
    · have hjj : ¬ (k ≤ j.1 ∧ j ≠ j) := fun h => h.2 rfl
      rw [if_pos hi, if_pos hi, if_neg hjj, hrel j hj]
      show a i y * (a j y)⁻¹ * (a j y * u y) = flatCoord Φ i (g y)
      rw [hrel i hi.1]
      field_simp
    · rw [if_neg hi, if_neg hi]
      rfl
  have htarget : ∀ y ∈ U, zc y ∈ cc.target := fun y hy => by
    show monomial k j (zc y) ∈ Φ.target
    rw [hmono y hy]
    exact Φ.mapsTo_toFun (hUsub hy).2.1.2
  refine ⟨U, hUopen, hzU, fun y => cc.invFun (zc y), fun y hy => ?_, fun y hy => ?_⟩
  · refine contMDiffAt_of_mem_chart (Or.inl ⟨cc, rfl⟩) ?_ ?_
    · filter_upwards [hUopen.mem_nhds hy] with y' hy'
      exact cc.map_target (htarget y' hy')
    · have hev2 : (fun y' => cc.toPartialEquiv (cc.invFun (zc y'))) =ᶠ[𝓝 y] zc := by
        filter_upwards [hUopen.mem_nhds hy] with y' hy'
        exact cc.right_inv (htarget y' hy')
      refine ContMDiffAt.congr_of_eventuallyEq ?_ hev2
      obtain ⟨hajy, -, -, hah, hτh⟩ := hUsub hy
      refine BlowupExistenceOriginIdeal.contMDiffAt_toLp fun i => ?_
      by_cases hi : k ≤ i.1 ∧ i ≠ j
      · simp only [if_pos hi]
        exact BlowupExistenceOriginIdeal.HolomorphicAt.contMDiffAt
          ((hah i).mul (BlowupFlatCoordinates.HolomorphicAt.inv (hah j) hajy))
      · simp only [if_neg hi]
        exact BlowupExistenceOriginIdeal.HolomorphicAt.contMDiffAt (hτh i)
  · rw [cc.blowupProj_invFun (htarget y hy)]
    show (chartAt (ComplexModel n) (g z₀)).symm (Φ.invFun (monomial k j (zc y))) = g y
    rw [hmono y hy]
    exact flatInverse_flat Φ (hUsub hy).2.1

/-- **Local existence of lifts.** -/
theorem exists_local_lift (hg : ContMDiff 𝓘(ℂ, ComplexModel m) 𝓘(ℂ, ComplexModel n) ∞ g)
    (hinv : (GermIdeal.pullback (m := m) g (vanishingIdeal (n := n) C)).IsInvertible) (z₀ : W) :
    ∃ U : Set W, IsOpen U ∧ z₀ ∈ U ∧ ∃ φ : W → BlowupSpace n C,
      (∀ y ∈ U, ContMDiffAt 𝓘(ℂ, ComplexModel m) 𝓘(ℂ, ComplexModel n) ∞ φ y) ∧
      ∀ y ∈ U, blowupProj n C (φ y) = g y := by
  by_cases hz : g z₀ ∈ C
  · exact exists_local_lift_of_mem hg hinv hz
  · exact exists_local_lift_of_not_mem hg hz

/-! ### The universal property -/

/-- **The universal property**: `g` lifts uniquely and holomorphically through `π`. -/
theorem exists_lift (hg : ContMDiff 𝓘(ℂ, ComplexModel m) 𝓘(ℂ, ComplexModel n) ∞ g)
    (hinv : (GermIdeal.pullback (m := m) g (vanishingIdeal (n := n) C)).IsInvertible) :
    ∃! h : W → BlowupSpace n C,
      ContMDiff 𝓘(ℂ, ComplexModel m) 𝓘(ℂ, ComplexModel n) ∞ h ∧ blowupProj n C ∘ h = g := by
  classical
  choose U hU hzU φ hφsmooth hφproj using exists_local_lift hg hinv
  set Ψ : W → BlowupSpace n C := fun z => φ z z with hΨ
  have key : ∀ z, ∀ y ∈ U z, Ψ y = φ z y := by
    intro z y hy
    have := lift_eqOn hg hinv ((hU y).inter (hU z))
      (fun y' hy' => (hφsmooth y y' hy'.1).continuousAt)
      (fun y' hy' => (hφsmooth z y' hy'.2).continuousAt)
      (fun y' hy' => hφproj y y' hy'.1) (fun y' hy' => hφproj z y' hy'.2)
    exact this ⟨hzU y, hy⟩
  have hproj : ∀ z, blowupProj n C (Ψ z) = g z := fun z => hφproj z z (hzU z)
  have hsmooth : ContMDiff 𝓘(ℂ, ComplexModel m) 𝓘(ℂ, ComplexModel n) ∞ Ψ := by
    intro z
    refine (hφsmooth z z (hzU z)).congr_of_eventuallyEq ?_
    filter_upwards [(hU z).mem_nhds (hzU z)] with y hy
    exact key z y hy
  refine ⟨Ψ, ⟨hsmooth, funext hproj⟩, ?_⟩
  rintro h ⟨hhs, hhp⟩
  refine funext fun z => ?_
  exact lift_eqOn hg hinv isOpen_univ (fun y _ => (hhs y).continuousAt)
    (fun y _ => (hsmooth y).continuousAt)
    (fun y _ => congrFun hhp y) (fun y _ => hproj y) (mem_univ z)

end Universal

/-- **The blowup along a nowhere dense closed submanifold exists** (Demailly, CADG VII.12):
`blowupProj : BlowupSpace n C → X` satisfies the universal property of
`Hironaka.BlowupSequences.IsBlowupAlong`. -/
theorem isBlowupAlong_blowupProj [hC : Fact (IsClosedSubmanifold n C)] (hCint : interior C = ∅) :
    IsBlowupAlong n C (blowupProj n C) :=
  ⟨hC.out, hCint, contMDiff_blowupProj, isInvertible_pullback_blowupProj,
    fun _ _ _ _ _ _ hg hinv => exists_lift hg hinv⟩

end

end Hironaka.BlowupConstruction
