import Hironaka.Resolution.StrictTransformComposition
import Hironaka.Blowup.BlowupSequences
import Hironaka.Manifold.ComplexManifold
import Hironaka.Analytic.HolomorphicIdealSheaves
import Hironaka.Blowup.BlowupIsomorphismOff
set_option autoImplicit false

/-!
# Fibres of a blowup through non-exceptional points

Source: CT22, Section 4; Griffiths--Harris, Ch. 1 §4 (blowups).

Let `π : Z → M` be the blowup of `M` along a nowhere dense closed submanifold `C`
(`IsBlowupAlong`, a universal property).

* `interior_preimage_eq_empty`: `π⁻¹ C` has empty interior.  Locally the pulled-back ideal
  of `C` is generated by one function `h` that vanishes on no nonempty open set, and `h` is
  a combination of pullbacks of functions vanishing on `C`, so `π⁻¹ C ⊆ {h = 0}` there.
* `eq_of_apply_eq_of_not_mem_exceptionalLocus`: the fibre through a point with bijective
  differential is that point.  If `π z' = π z` with `z' ≠ z`, separate them by disjoint open
  sets `U ∋ z`, `U' ∋ z'`.  As `π` is open at `z`, `π(U)` is a neighbourhood of `π z`, so
  `U' ∩ π⁻¹(interior π(U))` is a nonempty open set; it is not inside `π⁻¹ C`, and a point of
  it over `M \ C` has a second preimage in `U`, contradicting injectivity over `M \ C`.
* `preimage_image_exceptionalLocus`: `π⁻¹ (π (Exc π)) = Exc π`.
* `isClosed_image_exceptionalLocus`, `image_exceptionalLocus_subset`: for compact `M`,
  `π (Exc π)` is a closed subset of `C`.
-/

open Set Filter
open scoped Topology Manifold ContDiff

universe u

namespace Hironaka.ExceptionalFibres

open Hironaka.HolomorphicIdealSheaves Hironaka.BlowupSequences

noncomputable section

variable {n : ℕ} {M : Type u} [TopologicalSpace M] [ChartedSpace (ComplexModel n) M]
  [IsComplexManifold n M]
  {Z : Type u} [TopologicalSpace Z] [ChartedSpace (ComplexModel n) Z] [IsComplexManifold n Z]
  {C : Set M} {π : Z → M}

omit [IsComplexManifold n M] [IsComplexManifold n Z] in
/-- The preimage of the centre has empty interior. -/
theorem interior_preimage_eq_empty (hπ : IsBlowupAlong n C π) : interior (π ⁻¹' C) = ∅ := by
  refine eq_empty_iff_forall_notMem.mpr fun z hz => ?_
  obtain ⟨U, hU, hzU, h, hhol, hne, hmem⟩ := hπ.2.2.2.1 z
  obtain ⟨y, ⟨hyi, hyU⟩, hy⟩ :=
    hne (interior (π ⁻¹' C) ∩ U) (isOpen_interior.inter hU) inter_subset_right ⟨z, hz, hzU⟩
  have hhy : HolomorphicAt n h y :=
    eventually_of_mem (hU.mem_nhds hyU) fun y' hy' =>
      (hhol y' hy').mdifferentiableAt (hU.mem_nhds hy')
  have hspan : IsInSpanAt (n := n) (· = h) y h :=
    ⟨hhy, 1, fun _ => h, fun _ _ => 1, fun _ => rfl, fun _ => eventually_of_mem univ_mem
      fun y' _ => mdifferentiableAt_const,
      Eventually.of_forall fun y' => by simp⟩
  obtain ⟨-, N, s, a, hs, -, heq⟩ := (hmem y hyU h).mpr hspan
  apply hy
  rw [heq.self_of_nhds]
  refine Finset.sum_eq_zero fun i _ => ?_
  obtain ⟨b, ⟨-, hb⟩, hsb⟩ := hs i
  simp [hsb, hb.self_of_nhds (interior_subset hyi : y ∈ π ⁻¹' C)]

/-- **Fibres through non-exceptional points are singletons.** -/
theorem eq_of_apply_eq_of_not_mem_exceptionalLocus (hπ : IsBlowupAlong n C π) {z z' : Z}
    (hz : z ∉ exceptionalLocus n π) (h : π z' = π z) : z' = z := by
  by_contra hne
  obtain ⟨U', U, hU', hU, hz'U', hzU, hdisj⟩ := t2_separation hne
  have himg : π '' U ∈ 𝓝 (π z) := by
    rw [← StrictTransformComposition.map_nhds_eq_of_not_mem_exceptionalLocus hπ.contMDiff hz]
    exact image_mem_map (hU.mem_nhds hzU)
  have hO : IsOpen (U' ∩ π ⁻¹' interior (π '' U)) :=
    hU'.inter (isOpen_interior.preimage hπ.contMDiff.continuous)
  have hz'O : z' ∈ U' ∩ π ⁻¹' interior (π '' U) :=
    ⟨hz'U', by rw [mem_preimage, h]; exact mem_interior_iff_mem_nhds.mpr himg⟩
  have hnot : ¬ U' ∩ π ⁻¹' interior (π '' U) ⊆ π ⁻¹' C := fun hsub => by
    have := interior_maximal hsub hO hz'O
    rw [interior_preimage_eq_empty hπ] at this
    exact this
  obtain ⟨u, ⟨huU', hu⟩, huC⟩ := not_subset.mp hnot
  obtain ⟨u₁, hu₁U, hu₁⟩ := interior_subset hu
  have hinj := (BlowupIsomorphismOff.isIsomorphismOver_compl_of_isBlowupAlong hπ).1.injOn
  have heq : u₁ = u := hinj (show π u₁ ∈ Cᶜ by rw [hu₁]; exact huC) huC hu₁
  exact disjoint_left.mp hdisj huU' (heq ▸ hu₁U)

/-- The exceptional locus is the full preimage of its image. -/
theorem preimage_image_exceptionalLocus (hπ : IsBlowupAlong n C π) :
    π ⁻¹' (π '' exceptionalLocus n π) = exceptionalLocus n π := by
  refine Subset.antisymm ?_ (subset_preimage_image _ _)
  rintro z ⟨z', hz', hzz'⟩
  by_contra hz
  exact hz (eq_of_apply_eq_of_not_mem_exceptionalLocus hπ hz hzz' ▸ hz')

theorem image_exceptionalLocus_subset (hπ : IsBlowupAlong n C π) :
    π '' exceptionalLocus n π ⊆ C := by
  rintro _ ⟨z, hz, rfl⟩
  exact BlowupIsomorphismOff.exceptionalLocus_subset_preimage hπ hz

end

end Hironaka.ExceptionalFibres
