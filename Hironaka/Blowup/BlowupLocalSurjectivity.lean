import Hironaka.Blowup.BlowupMonomialCharts
import Hironaka.Blowup.BlowupSequences
import Hironaka.Analytic.ComplexAnalyticSubvarieties
import Hironaka.Manifold.ComplexManifold
import Hironaka.Analytic.HolomorphicIdealSheaves
import Hironaka.Blowup.BlowupFlatCoordinates
import Hironaka.Analytic.HolomorphicGermAlgebra
import Hironaka.Blowup.LiftedOpenModel
set_option autoImplicit false
set_option linter.unusedSectionVars false

/-!
# Every point of a blowup lies in a bounded part of a monomial chart

Let `π : Z → M` be a blowup along `C` (`IsBlowupAlong`, a universal property) and let `C` be
flattened near `y₀` by `Φ ∘ e` onto `ℂᵏ × 0`.  By the universal property each monomial chart
`γⱼ` (`BlowupMonomialCharts`) lifts uniquely to `ℓⱼ` with `π ∘ ℓⱼ = γⱼ`.

`exists_monomialLift_eq`: every `z` with `π z` in the flattening domain is `ℓⱼ w` for some
`j ≥ k` and some `w` with `‖wᵢ‖ ≤ 1` for all `i ≥ k`, `i ≠ j`.

Proof.  Near `z` the pulled-back ideal is generated by one `h`, so `(Φ ∘ e ∘ π)ᵢ = αᵢ h`
(`i ≥ k`).  Writing `h` back in terms of the generators `(Φ ∘ e)ᵢ` of `𝓘_C` (Hadamard) gives
`h = G h` with `G = ∑ᵢ cᵢ αᵢ`, and since `h` vanishes on no open set, `G(z) = 1`; so some
`αᵢ(z) ≠ 0`.  Take `j` with `‖αⱼ(z)‖` maximal and `ω = (αᵢ/αⱼ for i ≥ k, i ≠ j;
(Φ ∘ e ∘ π)ᵢ otherwise)`.  Then `σⱼ ∘ ω = Φ ∘ e ∘ π` near `z`, so `ℓⱼ ∘ ω` and the inclusion
are two lifts of `π` on a neighbourhood of `z`, hence equal by uniqueness.
-/

open Set Filter
open scoped Topology Manifold ContDiff

universe u

namespace Hironaka.BlowupLocalSurjectivity

open Hironaka.HolomorphicIdealSheaves Hironaka.BlowupSequences BlowupFlatCoordinates BlowupMonomialCharts

noncomputable section

variable {n : ℕ} {M : Type u} [TopologicalSpace M] [ChartedSpace (ComplexModel n) M]
  [IsComplexManifold n M]
  {Z : Type u} [TopologicalSpace Z] [ChartedSpace (ComplexModel n) Z] [IsComplexManifold n Z]

instance (O : TopologicalSpace.Opens Z) : IsComplexManifold n O where

variable {C : Set M} {π : Z → M} {y₀ : M}
  {Φ : LocalHolomorphicEquivAt (n := n) (chartAt (ComplexModel n) y₀ y₀)} {k : ℕ}

/-- The lift of the `j`-th monomial chart through a blowup. -/
theorem existsUnique_monomialLift (hπ : IsBlowupAlong n C π)
    (hΦsrc : Φ.source ⊆ (chartAt (ComplexModel n) y₀).target)
    (hflat : ∀ {y : M}, y ∈ (chartAt (ComplexModel n) y₀).source →
      chartAt (ComplexModel n) y₀ y ∈ Φ.source →
        (y ∈ C ↔ Φ.toFun (chartAt (ComplexModel n) y₀ y) ∈ complexCoordinatePlane n k))
    {j : Fin n} (hj : k ≤ j.1) :
    ∃! ℓ : LiftedOpen.{u} (monomialDomain Φ k j) → Z,
      ContMDiff 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel n) ∞ ℓ ∧ π ∘ ℓ = monomialChart Φ k j :=
  hπ.2.2.2.2 n _ _ (contMDiff_monomialChart hΦsrc)
    (isInvertible_pullback_monomialChart hΦsrc hflat hj)

/-- Near a point over the flattening domain, the flattening coordinates pulled back to the
blowup are multiples `αᵢ h` of one generator, and some `αᵢ` with `i ≥ k` is a unit. -/
theorem exists_coeff_ne_zero (hπ : IsBlowupAlong n C π)
    (hΦsrc : Φ.source ⊆ (chartAt (ComplexModel n) y₀).target)
    (hflat : ∀ {y : M}, y ∈ (chartAt (ComplexModel n) y₀).source →
      chartAt (ComplexModel n) y₀ y ∈ Φ.source →
        (y ∈ C ↔ Φ.toFun (chartAt (ComplexModel n) y₀ y) ∈ complexCoordinatePlane n k))
    {z : Z} (hz : π z ∈ flatDomain Φ) :
    ∃ α : Fin n → Z → ℂ, (∀ i, HolomorphicAt n (α i) z) ∧ ∃ h : Z → ℂ,
      (∀ᶠ z' in 𝓝 z, ∀ i : Fin n, k ≤ i.1 → flatCoord Φ i (π z') = α i z' * h z') ∧
      ∃ i : Fin n, k ≤ i.1 ∧ α i z ≠ 0 := by
  classical
  obtain ⟨U, hU, hzU, h, hhd, hnon, hiff⟩ := hπ.2.2.2.1 z
  have hπs : ∀ z', ContMDiffAt 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel n) ∞ π z' :=
    fun z' => hπ.contMDiff z'
  have hhol : HolomorphicAt n h z := by
    filter_upwards [hU.mem_nhds hzU] with z' hz'
    exact (hhd z' hz').mdifferentiableAt (hU.mem_nhds hz')
  have hcoord : ∀ i : Fin n, ∃ a : Z → ℂ, HolomorphicAt n a z ∧
      (k ≤ i.1 → (fun z' => flatCoord Φ i (π z')) =ᶠ[𝓝 z] fun z' => a z' * h z') := by
    intro i
    by_cases hi : k ≤ i.1
    · have hmem : (GermIdeal.pullback (m := n) π (vanishingIdeal (n := n) C)).mem z
          (flatCoord Φ i ∘ π) :=
        isInSpanAt_of_eq_mul (S := fun s => ∃ a, (vanishingIdeal (n := n) C).mem (π z) a ∧
          s = a ∘ π) (s := flatCoord Φ i ∘ π) ⟨flatCoord Φ i,
          flatCoord_mem_vanishingIdeal Φ hflat hi hz, rfl⟩
          ((holomorphicAt_flatCoord Φ i hz).comp_contMDiff (Eventually.of_forall hπs))
          (holomorphicAt_const 1) (Eventually.of_forall fun _ => by simp)
      obtain ⟨-, a, ha, heq⟩ := isInSpanAt_eq_iff.mp ((hiff z hzU _).mp hmem)
      exact ⟨a, ha, fun _ => heq⟩
    · exact ⟨0, holomorphicAt_const 0, fun h' => absurd h' hi⟩
  choose α hα hαeq using hcoord
  have hαev : ∀ᶠ z' in 𝓝 z, ∀ i : Fin n, k ≤ i.1 → flatCoord Φ i (π z') = α i z' * h z' := by
    refine eventually_all.2 fun i => ?_
    by_cases hi : k ≤ i.1
    · exact (hαeq i hi).mono fun _ h' _ => h'
    · exact Eventually.of_forall fun _ h' => absurd h' hi
  refine ⟨α, hα, h, hαev, ?_⟩
  have hmemh : IsInSpanAt (n := n) (fun s => ∃ a, (vanishingIdeal (n := n) C).mem (π z) a ∧
      s = a ∘ π) z h :=
    (hiff z hzU h).mpr (isInSpanAt_of_eq_mul rfl hhol (holomorphicAt_const 1)
      (Eventually.of_forall fun _ => by simp))
  obtain ⟨-, N, s, β, hs, hβ, hsum⟩ := hmemh
  choose a ha hsa using hs
  choose b hb0 hbh hbeq using fun l => exists_eq_sum_flatCoord Φ hΦsrc hflat hz (ha l)
  set G : Z → ℂ := fun z' => ∑ i, (∑ l, β l z' * b l i (π z')) * α i z' with hG
  have hGhol : HolomorphicAt n G z :=
    HolomorphicAt.sum _ fun i _ => (HolomorphicAt.sum _ fun l _ => (hβ l).mul
      ((hbh l i).comp_contMDiff (Eventually.of_forall hπs))).mul (hα i)
  have hGeq : ∀ᶠ z' in 𝓝 z, h z' = G z' * h z' := by
    have hbev : ∀ᶠ z' in 𝓝 z, ∀ l, a l (π z') = ∑ i, b l i (π z') * flatCoord Φ i (π z') :=
      hπ.contMDiff.continuous.continuousAt.eventually (eventually_all.2 hbeq)
    filter_upwards [hsum, hbev, hαev] with z' h1 h2 h3
    have e1 : ∀ l, s l z' = ∑ i, b l i (π z') * (α i z' * h z') := by
      intro l
      rw [hsa l, Function.comp_apply, h2 l]
      refine Finset.sum_congr rfl fun i _ => ?_
      by_cases hi : k ≤ i.1
      · rw [h3 i hi]
      · rw [hb0 l i (by omega)]; simp
    conv_lhs => rw [h1]
    simp only [e1, hG, Finset.mul_sum, Finset.sum_mul]
    conv_lhs => rw [Finset.sum_comm]
    exact Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun l _ => by ring
  have hG1 : G z = 1 := by
    by_contra hne
    have hev : ∀ᶠ z' in 𝓝 z, z' ∈ U ∧ h z' = G z' * h z' ∧ G z' ≠ 1 :=
      Filter.Eventually.and (hU.mem_nhds hzU : ∀ᶠ z' in 𝓝 z, z' ∈ U) (hGeq.and (hGhol.continuousAt.eventually (isOpen_ne.mem_nhds hne)))
    obtain ⟨W, hWsub, hWopen, hzW⟩ := mem_nhds_iff.mp hev
    obtain ⟨y, hyW, hy⟩ := hnon W hWopen (fun y hy => (hWsub hy).1) ⟨z, hzW⟩
    obtain ⟨-, h1, h2⟩ := hWsub hyW
    have : (1 - G y) * h y = 0 := by rw [sub_mul, one_mul, ← h1, sub_self]
    rcases mul_eq_zero.mp this with h' | h'
    · exact h2 (sub_eq_zero.mp h').symm
    · exact hy h'
  by_contra hall
  push Not at hall
  have : G z = 0 := by
    refine Finset.sum_eq_zero fun i _ => ?_
    by_cases hi : k ≤ i.1
    · rw [hall i hi, mul_zero]
    · simp [hb0 _ i (by omega)]
  rw [hG1] at this
  exact one_ne_zero this

/-- **Local inverses of the monomial lifts.**  Every point `z` of the blowup over the
flattening domain has a neighbourhood `O` and a holomorphic `W : O → ℂⁿ` with
`σⱼ ∘ W = Φ ∘ e ∘ π` on `O`, such that the lift `ℓⱼ` of the `j`-th monomial chart satisfies
`ℓⱼ ∘ W = id` on `O`; moreover `‖W(z)ᵢ‖ ≤ 1` for `i ≥ k`, `i ≠ j`. -/
theorem exists_monomialLocalInverse (hπ : IsBlowupAlong n C π)
    (hΦsrc : Φ.source ⊆ (chartAt (ComplexModel n) y₀).target)
    (hflat : ∀ {y : M}, y ∈ (chartAt (ComplexModel n) y₀).source →
      chartAt (ComplexModel n) y₀ y ∈ Φ.source →
        (y ∈ C ↔ Φ.toFun (chartAt (ComplexModel n) y₀ y) ∈ complexCoordinatePlane n k))
    {z : Z} (hz : π z ∈ flatDomain Φ) :
    ∃ j : Fin n, k ≤ j.1 ∧ ∃ O : Set Z, IsOpen O ∧ z ∈ O ∧ ∃ W : Z → ComplexModel n,
      (∀ z' ∈ O, ContMDiffAt 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel n) ∞ W z') ∧
      (∀ z' ∈ O, π z' ∈ flatDomain Φ ∧
        monomial k j (W z') = Φ.toFun (chartAt (ComplexModel n) y₀ (π z'))) ∧
      (∀ ℓ : LiftedOpen.{u} (monomialDomain Φ k j) → Z,
        ContMDiff 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel n) ∞ ℓ →
          π ∘ ℓ = monomialChart Φ k j → ∀ z' ∈ O, ∀ hw : W z' ∈ monomialDomain Φ k j,
            ℓ (LiftedOpen.mk _ (W z') hw) = z') ∧
      ∀ i : Fin n, k ≤ i.1 → i ≠ j → ‖W z i‖ ≤ 1 := by
  classical
  obtain ⟨α, hα, h, hαev, i₁, hi₁, hαi₁⟩ := exists_coeff_ne_zero hπ hΦsrc hflat hz
  have hπs : ∀ z', ContMDiffAt 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel n) ∞ π z' :=
    fun z' => hπ.contMDiff z'
  obtain ⟨j, hjmem, hjmax⟩ := Finset.exists_max_image
    (Finset.univ.filter fun i : Fin n => k ≤ i.1) (fun i => ‖α i z‖) ⟨i₁, by simp [hi₁]⟩
  have hj : k ≤ j.1 := by simpa using hjmem
  have hαj : α j z ≠ 0 := by
    have := hjmax i₁ (by simp [hi₁])
    exact norm_pos_iff.mp ((norm_pos_iff.mpr hαi₁).trans_le this)
  set wc : Fin n → Z → ℂ := fun i z' =>
    if k ≤ i.1 ∧ i ≠ j then α i z' * (α j z')⁻¹ else flatCoord Φ i (π z') with hwc_def
  set wmap : Z → ComplexModel n := fun z' => WithLp.toLp 2 fun i => wc i z' with hwmap_def
  have hwc : ∀ i, ∀ z', α j z' ≠ 0 → π z' ∈ flatDomain Φ → HolomorphicAt n (α i) z' →
      HolomorphicAt n (α j) z' → HolomorphicAt n (wc i) z' := by
    intro i z' h0 hz' hi hj'
    simp only [hwc_def]
    split_ifs
    · exact hi.mul (HolomorphicAt.inv hj' h0)
    · exact (holomorphicAt_flatCoord Φ i hz').comp_contMDiff (Eventually.of_forall hπs)
  -- the neighbourhood of `z` on which everything holds
  set P : Z → Prop := fun z' => α j z' ≠ 0 ∧ π z' ∈ flatDomain Φ ∧
    (∀ i : Fin n, k ≤ i.1 → flatCoord Φ i (π z') = α i z' * h z') ∧
    ∀ i, HolomorphicAt n (wc i) z' with hP_def
  have hP : ∀ᶠ z' in 𝓝 z, P z' := by
    have h1 := (hα j).continuousAt.eventually (isOpen_ne.mem_nhds hαj)
    have h2 := hπ.contMDiff.continuous.continuousAt.eventually
      ((isOpen_flatDomain Φ).mem_nhds hz)
    have h3 : ∀ᶠ z' in 𝓝 z, ∀ i, HolomorphicAt n (α i) z' :=
      eventually_all.2 fun i => (hα i).eventually
    filter_upwards [h1, h2, hαev, h3] with z' h1' h2' h3' h4'
    exact ⟨h1', h2', h3', fun i => hwc i z' h1' h2' (h4' i) (h4' j)⟩
  have hkey : ∀ z', P z' → monomial k j (wmap z') = Φ.toFun (chartAt (ComplexModel n) y₀ (π z')) := by
    intro z' hz'
    ext i
    simp only [monomial_apply, hwmap_def, hwc_def]
    by_cases hij : k ≤ i.1 ∧ i ≠ j
    · rw [if_pos hij, if_pos hij, if_neg (by simp), hz'.2.2.1 j hj,
        show (Φ.toFun (chartAt (ComplexModel n) y₀ (π z'))) i = flatCoord Φ i (π z') from rfl,
        hz'.2.2.1 i hij.1]
      field_simp [hz'.1]
    · rw [if_neg hij, if_neg hij]
      rfl
  set O : TopologicalSpace.Opens Z := ⟨interior {z' | P z'}, isOpen_interior⟩
  have hzO : z ∈ O := mem_interior_iff_mem_nhds.mpr hP
  have hPO : ∀ x : O, P x.1 := fun x =>
    (interior_subset (s := {z' | P z'}) (x.2 : x.1 ∈ interior {z' | P z'}) : x.1 ∈ {z' | P z'})
  have hwmapmem : ∀ x : O, wmap x.1 ∈ monomialDomain Φ k j := fun x => by
    show monomial k j (wmap x.1) ∈ Φ.target
    rw [hkey _ (hPO x)]
    exact Φ.mapsTo_toFun (hPO x).2.1.2
  set wmap' : O → LiftedOpen.{u} (monomialDomain Φ k j) := fun x =>
    LiftedOpen.mk _ (wmap x.1) (hwmapmem x)
  have hwmapsmooth : ∀ z', P z' →
      ContMDiffAt 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel n) ∞ wmap z' := by
    intro z' hz'
    have hpi : ContMDiffAt 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, Fin n → ℂ) ∞ (fun z'' i => wc i z'') z' :=
      contMDiffAt_pi_space.2 fun i =>
        contMDiffAt_of_eventually_mdifferentiableAt ((hz'.2.2.2 i).mono fun _ h' => h')
    exact (PiLp.continuousLinearEquiv 2 ℂ (fun _ : Fin n => ℂ)).symm.toContinuousLinearMap
      |>.contMDiff.contMDiffAt.comp z' hpi
  have hwmap'smooth : ContMDiff 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel n) ∞ wmap' := fun x =>
    LiftedOpen.contMDiffAt_of_toModel _
      (contMDiffAt_subtype_iff.mpr (hwmapsmooth x.1 (hPO x)) :
        ContMDiffAt 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel n) ∞ (fun x : O => wmap x.1) x)
  have huniq := hπ.2.2.2.2 n O (π ∘ Subtype.val) (hπ.contMDiff.comp contMDiff_subtype_val)
    (IsInvertible.pullback_comp_val O hπ.2.2.2.1)
  refine ⟨j, hj, interior {z' | P z'}, isOpen_interior, hzO, wmap,
    fun z' hz' => hwmapsmooth z' (interior_subset (s := {z' | P z'}) hz' : z' ∈ {z' | P z'}),
    fun z' hz' => ⟨(interior_subset (s := {z' | P z'}) hz' : z' ∈ {z' | P z'}).2.1,
      hkey z' (interior_subset (s := {z' | P z'}) hz' : z' ∈ {z' | P z'})⟩,
    fun ℓ hℓs hℓπ z' hz' hw => ?_, fun i hi hij => ?_⟩
  · have hlift : π ∘ (ℓ ∘ wmap') = π ∘ Subtype.val := by
      funext x
      have := congrFun hℓπ (wmap' x)
      simp only [Function.comp_apply] at this ⊢
      rw [this]
      show (chartAt (ComplexModel n) y₀).symm (Φ.invFun (monomial k j (wmap x.1))) = π x.1
      rw [hkey _ (hPO x)]
      exact flatInverse_flat Φ (hPO x).2.1
    have heq := huniq.unique ⟨hℓs.comp hwmap'smooth, hlift⟩ ⟨contMDiff_subtype_val, rfl⟩
    exact congrFun heq ⟨z', hz'⟩
  · show ‖wc i z‖ ≤ 1
    simp only [hwc_def, if_pos (And.intro hi hij), norm_mul, norm_inv]
    rw [← div_eq_mul_inv, div_le_one (norm_pos_iff.mpr hαj)]
    exact hjmax i (by simp [hi])

/-- **Local surjectivity of the monomial lifts.**  Every point of the blowup over the
flattening domain is the image, under the lift of some monomial chart `j ≥ k`, of a point
whose coordinates `wᵢ` (`i ≥ k`, `i ≠ j`) have norm at most `1`. -/
theorem exists_monomialLift_eq (hπ : IsBlowupAlong n C π)
    (hΦsrc : Φ.source ⊆ (chartAt (ComplexModel n) y₀).target)
    (hflat : ∀ {y : M}, y ∈ (chartAt (ComplexModel n) y₀).source →
      chartAt (ComplexModel n) y₀ y ∈ Φ.source →
        (y ∈ C ↔ Φ.toFun (chartAt (ComplexModel n) y₀ y) ∈ complexCoordinatePlane n k))
    {z : Z} (hz : π z ∈ flatDomain Φ) :
    ∃ j : Fin n, k ≤ j.1 ∧ ∃ w : LiftedOpen.{u} (monomialDomain Φ k j),
      (∀ ℓ : LiftedOpen.{u} (monomialDomain Φ k j) → Z,
        ContMDiff 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel n) ∞ ℓ →
          π ∘ ℓ = monomialChart Φ k j → ℓ w = z) ∧
      ∀ i : Fin n, k ≤ i.1 → i ≠ j → ‖LiftedOpen.toModel _ w i‖ ≤ 1 := by
  obtain ⟨j, hj, O, -, hzO, W, -, hW, hℓ, hbound⟩ := exists_monomialLocalInverse hπ hΦsrc hflat hz
  have hw : W z ∈ monomialDomain Φ k j := by
    show monomial k j (W z) ∈ Φ.target
    rw [(hW z hzO).2]
    exact Φ.mapsTo_toFun (hW z hzO).1.2
  exact ⟨j, hj, LiftedOpen.mk _ (W z) hw, fun ℓ hℓs hℓπ => hℓ ℓ hℓs hℓπ z hzO hw, hbound⟩
end

end Hironaka.BlowupLocalSurjectivity
