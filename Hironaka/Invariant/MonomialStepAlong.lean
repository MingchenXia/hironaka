/-!
# Resolution of monomial marked ideals along a submanifold

Let `𝔪 = (X, N, E, 𝔞, d)` be a well-formed marked ideal (`N` a closed submanifold, `E` simple normal crossings and
transverse to `N`, `𝔞` coherent), with `𝔞|_N` nonzero near every point of `N` and monomial along `N`
(`MonomialPartAlong.IsMonomialAlong`); `γ = MonomialCaseAlong.gammaAlong` its invariant, `C` the maximum locus of `γ` on
the cosupport (an admissible centre, `MonomialCaseAlong.isAdmissibleCentre_maxLocus_gammaAlong`) and `π : Y → X` the
blowup along `C`.

* `IsPrincipalAlongAt N 𝔞 E z a`: in centred coordinates at `z` adapted to `N` and `E`, the restriction of `𝔞_z` to
  `N` is generated by `∏_{z ∈ E_i} u_{σ i}^{a_i}`; then `γ(z)` is read off `a` (`IsPrincipalAlongAt.gammaAlong_eq`).
  A monomial ideal along `N` is principal in this sense at every point of `N`
  (`isPrincipalAlongAt_of_isMonomialAlong`; the adapted coordinates of `SimultaneousNormalCrossings` are centred by
  `RegularPatchPullback.subConst`).
* The maximum locus near one of its points `x` (`mem_maxLocusA_iff`, `eventually_mem_maxLocusA_iff`): `N ∩ ⋂_{i ∈ I} E_i`,
  `I` the top set of `γ(x)`, and the members containing it near `x` are exactly those of `I`
  (`filter_eventually_subset_eq_topIdx_along`).
* Over the centre: `MonomialBlowupAlongChart.exists_snc_chart_geoTransform_along_of_flat` gives
  `isPrincipalAlongAt_geoTransform_of_mem` (exceptional exponent `∑_I a - d`), and with
  `BoundaryCountAlong.card_filter_mem_geoStrictTransform_lt_along` and `MonomialInvariant.inv_lt_of_blowup`,
  `gammaAlong_geoTransform_lt_of_mem`: `γ'(z) < γ(π z)` at the points `z ∈ N'` over `C`.
* Off the centre: `exists_snc_chart_geoTransform_along_of_notMem` gives `isPrincipalAlongAt_geoTransform_of_notMem`
  and `gammaAlong_geoTransform_eq_of_notMem`: `γ'(z) = γ(π z)`.
* `towerInvAlong`: over a compact base, iterating the blowup of the maximum locus of `γ` resolves `(X, N, E, 𝔞, d)`
  for `d ≥ 1` (`hir:monomial-case` (3) along `N`).
-/

open Set Filter Finset
open scoped Topology Manifold ContDiff

universe u

namespace Hironaka.MonomialStepAlong

open Hironaka.HolomorphicIdealSheaves Hironaka.BlowupSequences
open Hironaka.IdealWeightPowers Hironaka.GermIdealOrder Hironaka.BlowupFlatCoordinates Hironaka.GiraudAlong Hironaka.DivisorExponentAlong Hironaka.MemberPullback Hironaka.MonomialPart Hironaka.MonomialPartAlong Hironaka.NormalCrossings Hironaka.MonomialInvariant Hironaka.BoundaryCount Hironaka.MonomialCase Hironaka.MonomialCaseAlong Hironaka.BlowupStrictSubmanifold Hironaka.BlowupSNCTransform Hironaka.MarkedIdeals Hironaka.MarkedIdeals.MarkedIdeal Hironaka.BlowupTowers Hironaka.RelativePrincipalizationSpan

noncomputable section

variable {n : ℕ}

/-! ### Principal monomial ideals along `N` in centred coordinates -/

section Principal

variable {M : Type*} [TopologicalSpace M] [ChartedSpace (ComplexModel n) M] [IsComplexManifold n M]

open Classical in
/-- **A principal monomial ideal along `N` at `z`, with exponents `a`**: in centred coordinates `Φ` at `z` in which
`N = ℂ^k × 0` and every member `E_i` through `z` is the hyperplane `{Φ_{σ i} = 0}` (`σ i < k`, `σ` injective on these
members), the restriction of `𝔞_z` to `N` is generated by `∏_{z ∈ E_i} Φ_{σ i}^{a_i}`. -/
def IsPrincipalAlongAt (N : Set M) (𝔞 : GermIdeal n M) (E : List (Set M)) (z : M) (a : Fin E.length → ℕ) : Prop :=
  ∃ (k : ℕ) (Φ : LocalHolomorphicEquivAt (n := n) (chartAt (ComplexModel n) z z)) (σ : Fin E.length → Fin n),
    Φ.source ⊆ (chartAt (ComplexModel n) z).target ∧ Φ.toFun (chartAt (ComplexModel n) z z) = 0 ∧
    (∀ {y : M}, y ∈ (chartAt (ComplexModel n) z).source → chartAt (ComplexModel n) z y ∈ Φ.source →
      (y ∈ N ↔ Φ.toFun (chartAt (ComplexModel n) z y) ∈ complexCoordinatePlane n k)) ∧
    (∀ i, z ∈ E.get i → (σ i).1 < k) ∧ Set.InjOn σ {i | z ∈ E.get i} ∧
    (∀ i, z ∈ E.get i → ∀ {y : M}, y ∈ (chartAt (ComplexModel n) z).source →
      chartAt (ComplexModel n) z y ∈ Φ.source → (y ∈ E.get i ↔ Φ.toFun (chartAt (ComplexModel n) z y) (σ i) = 0)) ∧
    ∀ g, IsInSpanOnAt (n := n) N (𝔞.mem z) z g ↔
      IsInSpanOnAt (n := n) N (· = fun y => ∏ i ∈ Finset.univ.filter (fun i => z ∈ E.get i),
        flatCoord Φ (σ i) y ^ a i) z g

variable {N : Set M} {𝔞 : GermIdeal n M} {E : List (Set M)} {z : M} {a : Fin E.length → ℕ}

/-- Forgetting the exponents and the centring. -/
theorem IsPrincipalAlongAt.isPrincipalMonomialAlongAt (h : IsPrincipalAlongAt N 𝔞 E z a) :
    IsPrincipalMonomialAlongAt n N 𝔞 E z := by
  obtain ⟨k, Φ, σ, hΦsrc, -, hNflat, hσk, hσinj, hA, hgen⟩ := h
  exact ⟨k, Φ, σ, a, hΦsrc, hNflat, hσk, hσinj, hA, hgen⟩

open Classical in
/-- **The invariant along `N` of a principal monomial ideal** at `z ∈ N` is that of its exponents. -/
theorem IsPrincipalAlongAt.gammaAlong_eq (h𝔞 : 𝔞.IsCoherent) (hz : z ∈ N) (h : IsPrincipalAlongAt N 𝔞 E z a)
    (d : ℕ) : gammaAlong n N 𝔞 E d z = inv n (memberIdx E z) (MonomialResolution.extExp E a) d := by
  obtain ⟨k, Φ, σ, hΦsrc, -, hNflat, hσk, hσinj, hA, hgen⟩ := h
  exact gammaAlong_eq_of_principal hΦsrc hNflat
    (fun i hi j hj hij => hσinj (Finset.mem_filter.mp hi).2 (Finset.mem_filter.mp hj).2 hij)
    (fun i hi => hσk i (Finset.mem_filter.mp hi).2)
    (fun i hi _ hy1 hy2 => hA i (Finset.mem_filter.mp hi).2 hy1 hy2) a
    (eventually_isInSpanOnAt_iff_of_isCoherent h𝔞 hgen)
    (fun _ _ hg => GermIdeal.IsCoherent.holomorphicAt_mem h𝔞 hg) hz (fun i => by simp) d

open Classical in
/-- **Centring the coordinates**: principal data at a point `z ∈ N` in coordinates which need not be centred give
principal data in centred coordinates (post-compose with the translation by `-Φ(z)`, which lies in `ℂ^k × 0` and has
vanishing `σ i`-th coordinates for the members through `z`). -/
theorem isPrincipalAlongAt_of_data (hz : z ∈ N) {k : ℕ}
    {Φ : LocalHolomorphicEquivAt (n := n) (chartAt (ComplexModel n) z z)} {σ : Fin E.length → Fin n}
    (hΦsrc : Φ.source ⊆ (chartAt (ComplexModel n) z).target)
    (hNflat : ∀ {y : M}, y ∈ (chartAt (ComplexModel n) z).source → chartAt (ComplexModel n) z y ∈ Φ.source →
      (y ∈ N ↔ Φ.toFun (chartAt (ComplexModel n) z y) ∈ complexCoordinatePlane n k))
    (hσk : ∀ i, z ∈ E.get i → (σ i).1 < k) (hσinj : Set.InjOn σ {i | z ∈ E.get i})
    (hA : ∀ i, z ∈ E.get i → ∀ {y : M}, y ∈ (chartAt (ComplexModel n) z).source →
      chartAt (ComplexModel n) z y ∈ Φ.source → (y ∈ E.get i ↔ Φ.toFun (chartAt (ComplexModel n) z y) (σ i) = 0))
    (hgen : ∀ g, IsInSpanOnAt (n := n) N (𝔞.mem z) z g ↔
      IsInSpanOnAt (n := n) N (· = fun y => ∏ i ∈ Finset.univ.filter (fun i => z ∈ E.get i),
        flatCoord Φ (σ i) y ^ a i) z g) :
    IsPrincipalAlongAt N 𝔞 E z a := by
  set c : ComplexModel n := Φ.toFun (chartAt (ComplexModel n) z z) with hc
  have hzs : z ∈ (chartAt (ComplexModel n) z).source := mem_chart_source _ z
  have hck : c ∈ complexCoordinatePlane n k := (hNflat hzs Φ.center_mem_source).mp hz
  have hcσ : ∀ i, z ∈ E.get i → c (σ i) = 0 := fun i hi => (hA i hi hzs Φ.center_mem_source).mp hi
  set Φ' := RegularPatchPullback.subConst Φ c with hΦ'
  have hΦ'apply : ∀ u, Φ'.toFun u = Φ.toFun u - c := fun _ => rfl
  have hsub : ∀ w : ComplexModel n, w - c ∈ complexCoordinatePlane n k ↔ w ∈ complexCoordinatePlane n k := by
    intro w
    simp only [complexCoordinatePlane, mem_ofPred_eq]
    refine forall_congr' fun i => imp_congr_right fun hi => ?_
    rw [PiLp.sub_apply, hck i hi, sub_zero]
  have hgfun : (fun y => ∏ i ∈ Finset.univ.filter (fun i => z ∈ E.get i), flatCoord Φ' (σ i) y ^ a i) =
      fun y => ∏ i ∈ Finset.univ.filter (fun i => z ∈ E.get i), flatCoord Φ (σ i) y ^ a i := by
    funext y
    refine Finset.prod_congr rfl fun i hi => ?_
    simp only [flatCoord, hΦ'apply, PiLp.sub_apply, hcσ i (Finset.mem_filter.mp hi).2, sub_zero]
  refine ⟨k, Φ', σ, hΦsrc, by rw [hΦ'apply, sub_self], fun hy1 hy2 => ?_, hσk, hσinj,
    fun i hi y hy1 hy2 => ?_, fun g => ?_⟩
  · rw [hΦ'apply, hsub]
    exact hNflat hy1 hy2
  · rw [hΦ'apply, PiLp.sub_apply, hcσ i hi, sub_zero]
    exact hA i hi hy1 hy2
  · rw [hgfun]
    exact hgen g

/-- **A monomial ideal along `N` is principal at every point of `N`**, with the exponents along `N`, in centred
coordinates adapted to `N` and `E`. -/
theorem isPrincipalAlongAt_of_isMonomialAlong (hn : 0 < n) (hN : IsClosedSubmanifold n N) (hE : IsSNCDivisor n E)
    (hT : IsTransverse n N E) (h𝔞 : 𝔞.IsCoherent) (hne : ∀ y ∈ N, IsNonzeroAlongAt N 𝔞 y)
    (hmono : IsMonomialAlong n N 𝔞 E) {x : M} (hx : x ∈ N) :
    IsPrincipalAlongAt N 𝔞 E x (fun i => divExpAlong n N 𝔞 (E.get i) x) := by
  obtain ⟨kC, kN, Φ, σ, hΦsrc, hσk, hσinj, hflat⟩ :=
    SimultaneousNormalCrossings.isAdaptedAt_of_hasNormalCrossings hn subset_rfl hE hT hT.hasNormalCrossings hx
  have hNflat : ∀ {y : M}, y ∈ (chartAt (ComplexModel n) x).source → chartAt (ComplexModel n) x y ∈ Φ.source →
      (y ∈ N ↔ Φ.toFun (chartAt (ComplexModel n) x y) ∈ complexCoordinatePlane n kN) :=
    fun hy1 hy2 => (hflat hy1 hy2).2.1
  have hA : ∀ i, x ∈ E.get i → ∀ {y : M}, y ∈ (chartAt (ComplexModel n) x).source →
      chartAt (ComplexModel n) x y ∈ Φ.source →
        (y ∈ E.get i ↔ Φ.toFun (chartAt (ComplexModel n) x y) (σ i) = 0) :=
    fun i hi _ hy1 hy2 => (hflat hy1 hy2).2.2 i hi
  exact isPrincipalAlongAt_of_data hx hΦsrc hNflat hσk hσinj hA fun g =>
    isInSpanOnAt_iff_generator_of_isMonomialAlong hΦsrc hNflat hA hn hN hE hT h𝔞 hne hmono hx hσk hσinj g

end Principal

/-! ### The maximum locus near one of its points -/

section MaxLocus

variable {M : Type*} [TopologicalSpace M] [ChartedSpace (ComplexModel n) M] [IsComplexManifold n M]
  {𝔪 : MarkedIdeal n M}

/-- The maximum locus of the invariant along `N` on the cosupport of a monomial marked ideal along `N`. -/
abbrev maxLocusA (𝔪 : MarkedIdeal n M) : Set M :=
  ResolutionDriver.maxLocus (gammaAlong n 𝔪.N 𝔪.ideal 𝔪.E 𝔪.d) 𝔪.cosupp

variable (hn : 0 < n) (h𝔪 : 𝔪.IsWellFormed) (hne : ∀ y ∈ 𝔪.N, IsNonzeroAlongAt 𝔪.N 𝔪.ideal y)
  (hmono : IsMonomialAlong n 𝔪.N 𝔪.ideal 𝔪.E)

include hn h𝔪 hne hmono in
/-- **The maximum locus is a level set on `N`**: if `x` lies on it, a point lies on it iff it is in `N` with the invariant
of `x`. -/
theorem mem_maxLocusA_iff {x : M} (hx : x ∈ maxLocusA 𝔪) (y : M) :
    y ∈ maxLocusA 𝔪 ↔ y ∈ 𝔪.N ∧ gammaAlong n 𝔪.N 𝔪.ideal 𝔪.E 𝔪.d y = gammaAlong n 𝔪.N 𝔪.ideal 𝔪.E 𝔪.d x := by
  have hbot := fun y (hy : y ∈ 𝔪.N) => gammaAlong_eq_bot_iff_of_isMonomialAlong hn h𝔪.isClosedSubmanifold_N
    h𝔪.isSNCDivisor h𝔪.isTransverse h𝔪.isCoherent hne hmono 𝔪.d hy
  have hxN : x ∈ 𝔪.N := 𝔪.cosupp_subset_N hx.1
  have hmax : ∀ y ∈ 𝔪.N, gammaAlong n 𝔪.N 𝔪.ideal 𝔪.E 𝔪.d y ≤ gammaAlong n 𝔪.N 𝔪.ideal 𝔪.E 𝔪.d x := by
    intro y hyN
    by_cases hy : y ∈ 𝔪.cosupp
    · exact hx.2 y hy
    · rw [(hbot y hyN).mpr hy]
      exact bot_le
  constructor
  · intro hy
    have hyN : y ∈ 𝔪.N := 𝔪.cosupp_subset_N hy.1
    exact ⟨hyN, le_antisymm (hmax y hyN) (hy.2 x hx.1)⟩
  · rintro ⟨hyN, hy⟩
    refine ⟨?_, fun y' hy' => hy ▸ hmax y' (𝔪.cosupp_subset_N hy')⟩
    by_contra hyc
    have h1 := (hbot y hyN).mpr hyc
    exact (hbot x hxN).not.mpr (not_not.mpr hx.1) (hy ▸ h1)

include hn h𝔪 hne hmono in
/-- **Near one of its points, the maximum locus is `N ∩ ⋂_{i ∈ I} E_i`**, `I` the top set. -/
theorem eventually_mem_maxLocusA_iff {x : M} (hx : x ∈ maxLocusA 𝔪) {v : Val}
    (hv : gammaAlong n 𝔪.N 𝔪.ideal 𝔪.E 𝔪.d x = v) :
    ∀ᶠ y in 𝓝 x, y ∈ maxLocusA 𝔪 ↔ y ∈ 𝔪.N ∧ y ∈ memberInter 𝔪.E (topIdx 𝔪.E v) := by
  filter_upwards [eventually_gammaAlong_eq_iff_mem_memberInter hn h𝔪.isClosedSubmanifold_N h𝔪.isSNCDivisor
    h𝔪.isTransverse h𝔪.isCoherent hne (𝔪.cosupp_subset_N hx.1) hv] with y hy
  rw [mem_maxLocusA_iff hn h𝔪 hne hmono hx, hv]
  exact ⟨fun ⟨hyN, h⟩ => ⟨hyN, (hy hyN).mp h⟩, fun ⟨hyN, h⟩ => ⟨hyN, (hy hyN).mpr h⟩⟩

open Classical in
include hn h𝔪 hne hmono in
/-- **The members containing the maximum locus near one of its points are exactly those of the top set** (they are
distinct coordinate hyperplanes of coordinates adapted to `N`: moving along the coordinate of a member outside the top
set stays in `N` and in the intersection of the top members, and leaves that member). -/
theorem filter_eventually_subset_eq_topIdx_along {x : M} (hx : x ∈ maxLocusA 𝔪) {v : Val}
    (hv : gammaAlong n 𝔪.N 𝔪.ideal 𝔪.E 𝔪.d x = v) :
    Finset.univ.filter (fun i => x ∈ 𝔪.E.get i ∧ ∀ᶠ y in 𝓝 x, y ∈ maxLocusA 𝔪 → y ∈ 𝔪.E.get i) =
      topIdx 𝔪.E v := by
  have hxN : x ∈ 𝔪.N := 𝔪.cosupp_subset_N hx.1
  have hloc := eventually_mem_maxLocusA_iff hn h𝔪 hne hmono hx hv
  have htopx : ∀ j ∈ topIdx 𝔪.E v, x ∈ 𝔪.E.get j := fun j hj =>
    mem_memberInter_of_gammaAlong_eq hn h𝔪.isClosedSubmanifold_N h𝔪.isSNCDivisor h𝔪.isTransverse h𝔪.isCoherent
      hne hxN hv j hj
  ext i
  simp only [Finset.mem_filter, Finset.mem_univ, true_and]
  constructor
  · rintro ⟨hxi, hCi⟩
    by_contra hi
    obtain ⟨kC, kN, Φ, σ, hΦsrc, hσk, hσinj, hflat⟩ :=
      SimultaneousNormalCrossings.isAdaptedAt_of_hasNormalCrossings hn subset_rfl h𝔪.isSNCDivisor h𝔪.isTransverse
        h𝔪.isTransverse.hasNormalCrossings hxN
    have hxD : x ∈ flatDomain Φ := mem_flatDomain_self Φ
    obtain ⟨y, ⟨hyD, hyne, hyeq⟩, hyC, hyloc⟩ :=
      ((frequently_flatMap_ne_zero hΦsrc hxD {σ i}).and_eventually (hCi.and hloc)).exists
    have hyN : y ∈ 𝔪.N := by
      refine ((hflat hyD.1 hyD.2).2.1).mpr fun l hl => ?_
      have hli : l ∉ ({σ i} : Finset (Fin n)) := by
        rw [Finset.mem_singleton]
        intro h
        have := hσk i hxi
        rw [← h] at this
        omega
      change flatMap Φ y l = 0
      rw [hyeq l hli]
      exact ((hflat hxD.1 hxD.2).2.1).mp hxN l hl
    have hyI : y ∈ memberInter 𝔪.E (topIdx 𝔪.E v) := by
      intro j hj
      have hxj := htopx j hj
      have hji : σ j ≠ σ i := by
        intro h
        have := hσinj hxj hxi h
        exact hi (this ▸ hj)
      refine ((hflat hyD.1 hyD.2).2.2 j hxj).mpr ?_
      have := hyeq (σ j) (by simpa using hji)
      rw [show Φ.toFun (chartAt (ComplexModel n) x y) (σ j) = flatMap Φ y (σ j) from rfl, this]
      exact ((hflat hxD.1 hxD.2).2.2 j hxj).mp hxj
    have hyi := hyC (hyloc.mpr ⟨hyN, hyI⟩)
    exact hyne (σ i) (Finset.mem_singleton_self _) (((hflat hyD.1 hyD.2).2.2 i hxi).mp hyi)
  · intro hi
    refine ⟨htopx i hi, ?_⟩
    filter_upwards [hloc] with y hy hyC
    exact (hy.mp hyC).2 i hi

/-- The exponent sum over the members of the top set, two ways. -/
theorem sum_topIdx_eq_along {x : M} {v : Val} {d : ℕ} (hv : gammaAlong n 𝔪.N 𝔪.ideal 𝔪.E d x = v) :
    ∑ i ∈ topIdx 𝔪.E v, divExpAlong n 𝔪.N 𝔪.ideal (𝔪.E.get i) x =
      ∑ i ∈ topSet v, expDataAlong n 𝔪.N 𝔪.ideal 𝔪.E x i := by
  obtain ⟨hI, -⟩ := top_of_gammaAlong_eq hv
  have hlt : ∀ i ∈ topSet v, i < 𝔪.E.length := fun i hi =>
    ((mem_memberIdx 𝔪.E).mp ((mem_feasible.mp hI).1 hi)).1
  have hmap : (topIdx 𝔪.E v).map Fin.valEmbedding = topSet v := by
    ext i
    simp only [topIdx, Finset.mem_map, Finset.mem_filter, Finset.mem_univ, true_and, Fin.valEmbedding_apply]
    exact ⟨fun ⟨j, hj, hji⟩ => hji ▸ hj, fun hi => ⟨⟨i, hlt i hi⟩, hi, rfl⟩⟩
  rw [← hmap, Finset.sum_map]
  refine Finset.sum_congr rfl fun i _ => ?_
  simp only [Fin.valEmbedding_apply, expDataAlong, dif_pos i.2, Fin.eta]

end MaxLocus

/-! ### One blowup of the maximum locus -/

section Step

variable {X : Type u} [TopologicalSpace X] [ChartedSpace (ComplexModel n) X] [IsComplexManifold n X]
  {Y : Type u} [TopologicalSpace Y] [ChartedSpace (ComplexModel n) Y] [IsComplexManifold n Y]
  {π : Y → X} {𝔪 : MarkedIdeal n X}
  (hn : 0 < n) (h𝔪 : 𝔪.IsWellFormed) (hne : ∀ y ∈ 𝔪.N, IsNonzeroAlongAt 𝔪.N 𝔪.ideal y)
  (hmono : IsMonomialAlong n 𝔪.N 𝔪.ideal 𝔪.E)

include hn h𝔪 hne hmono in
/-- The maximum locus is an admissible centre. -/
theorem isAdmissibleCentre_maxLocusA : 𝔪.IsAdmissibleCentre (maxLocusA 𝔪) :=
  (isAdmissibleCentre_maxLocus_gammaAlong hn h𝔪.isClosedSubmanifold_N h𝔪.isSNCDivisor h𝔪.isTransverse
    h𝔪.isCoherent hne 𝔪 rfl rfl rfl hmono).1

open Classical in
include hn h𝔪 hne hmono in
/-- **Over the centre the transform is principal monomial along `N'`** (`hir:monomial-blowup` along `N`, at the blowup
of the maximum locus): at `z ∈ N'` over `x = π z`, with the exponents of `x` on the strict transforms and `∑_I a -
d` on the exceptional member (`I` the top set of `γ(x)`). `exists_snc_chart_geoTransform_along_of_flat`, fed with
the monomial generator at `x` (`isPrincipalAlongAt_of_isMonomialAlong`) and `e = ∑_I a`
(`filter_eventually_subset_eq_topIdx_along`). -/
theorem isPrincipalAlongAt_geoTransform_of_mem (hπ : IsBlowupAlong n (maxLocusA 𝔪) π) {z : Y}
    (hzN : z ∈ (𝔪.geoTransform (maxLocusA 𝔪) π).N) (hz : π z ∈ maxLocusA 𝔪) {v : Val}
    (hv : gammaAlong n 𝔪.N 𝔪.ideal 𝔪.E 𝔪.d (π z) = v) :
    ∃ a' : Fin (𝔪.geoTransform (maxLocusA 𝔪) π).E.length → ℕ,
      IsPrincipalAlongAt (𝔪.geoTransform (maxLocusA 𝔪) π).N (𝔪.geoTransform (maxLocusA 𝔪) π).ideal
        (𝔪.geoTransform (maxLocusA 𝔪) π).E z a' ∧
      (∀ i (hi : i.1 < 𝔪.E.length), a' i = divExpAlong n 𝔪.N 𝔪.ideal (𝔪.E.get ⟨i.1, hi⟩) (π z)) ∧
      ∀ i, ¬ i.1 < 𝔪.E.length → a' i + 𝔪.d = ∑ i ∈ topSet v, expDataAlong n 𝔪.N 𝔪.ideal 𝔪.E (π z) i := by
  have hC := isAdmissibleCentre_maxLocusA hn h𝔪 hne hmono
  have hπzN : π z ∈ 𝔪.N := 𝔪.cosupp_subset_N hz.1
  obtain ⟨k, Φ, σ, hΦsrc, -, hNflat, hσk, hσinj, hA, hgen⟩ :=
    isPrincipalAlongAt_of_isMonomialAlong hn h𝔪.isClosedSubmanifold_N h𝔪.isSNCDivisor h𝔪.isTransverse
      h𝔪.isCoherent hne hmono hπzN
  have hfilter := filter_eventually_subset_eq_topIdx_along hn h𝔪 hne hmono hz hv
  have hsum := sum_topIdx_eq_along (𝔪 := 𝔪) hv
  obtain ⟨hI, -⟩ := top_of_gammaAlong_eq hv
  have hdI := (mem_feasible.mp hI).2
  have hd : 𝔪.d ≤ ∑ i ∈ Finset.univ.filter (fun i => π z ∈ 𝔪.E.get i ∧
      ∀ᶠ y in 𝓝 (π z), y ∈ maxLocusA 𝔪 → y ∈ 𝔪.E.get i), divExpAlong n 𝔪.N 𝔪.ideal (𝔪.E.get i) (π z) := by
    rw [hfilter, hsum]
    exact hdI
  obtain ⟨k', Θ, σ', a', hΘt, hΘ0, hΘN, hσ'k, hσ'inj, hA', ha', hlast, hgen'⟩ :=
    MonomialBlowupAlongChart.exists_snc_chart_geoTransform_along_of_flat hπ h𝔪.isClosedSubmanifold_N
      h𝔪.isCoherent hC h𝔪.isSNCDivisor h𝔪.isTransverse hzN hz
      (T := Finset.univ.filter fun i => π z ∈ 𝔪.E.get i) (by simp)
      (fun i hi => hA i (Finset.mem_filter.mp hi).2) _ hgen hd
  refine ⟨a', ⟨k', Θ, σ', hΘt, hΘ0, hΘN, hσ'k, hσ'inj, hA', hgen'⟩, ha', fun i hi => ?_⟩
  rw [hlast i hi, ← hsum, ← hfilter]
  rw [hfilter, hsum] at hd ⊢
  omega

open Classical in
include hn h𝔪 hne hmono in
/-- **The invariant drops over the centre** (`hir:monomial-case` (2) along `N`): at every point `z ∈ N'` over the
maximum locus, `γ'(z) < γ(π z)`. The data at `z` arise from those at `x = π z` by deleting members (among them a
member of the top set whose strict transform misses `z`, `card_filter_mem_geoStrictTransform_lt_along`) and adding
the exceptional member with exponent `∑_I a - d`; then `MonomialInvariant.inv_lt_of_blowup`. -/
theorem gammaAlong_geoTransform_lt_of_mem (hπ : IsBlowupAlong n (maxLocusA 𝔪) π)
    (h𝔞' : (𝔪.geoTransform (maxLocusA 𝔪) π).ideal.IsCoherent) {z : Y}
    (hzN : z ∈ (𝔪.geoTransform (maxLocusA 𝔪) π).N) (hz : π z ∈ maxLocusA 𝔪) :
    gammaAlong n (𝔪.geoTransform (maxLocusA 𝔪) π).N (𝔪.geoTransform (maxLocusA 𝔪) π).ideal
        (𝔪.geoTransform (maxLocusA 𝔪) π).E 𝔪.d z <
      gammaAlong n 𝔪.N 𝔪.ideal 𝔪.E 𝔪.d (π z) := by
  have hE := h𝔪.isSNCDivisor
  have hπzN : π z ∈ 𝔪.N := 𝔪.cosupp_subset_N hz.1
  have hne' : gammaAlong n 𝔪.N 𝔪.ideal 𝔪.E 𝔪.d (π z) ≠ ⊥ := fun h =>
    (gammaAlong_eq_bot_iff_of_isMonomialAlong hn h𝔪.isClosedSubmanifold_N hE h𝔪.isTransverse h𝔪.isCoherent hne
      hmono 𝔪.d hπzN).mp h hz.1
  obtain ⟨v, hv⟩ := WithBot.ne_bot_iff_exists.mp hne'
  have hv' : gammaAlong n 𝔪.N 𝔪.ideal 𝔪.E 𝔪.d (π z) = v := hv.symm
  obtain ⟨a', hP, ha', hlast⟩ := isPrincipalAlongAt_geoTransform_of_mem hn h𝔪 hne hmono hπ hzN hz hv'
  rw [hP.gammaAlong_eq h𝔞' hzN 𝔪.d]
  obtain ⟨hI, htop⟩ := top_of_gammaAlong_eq hv'
  have hC := isAdmissibleCentre_maxLocusA hn h𝔪 hne hmono
  have hloc := eventually_mem_maxLocusA_iff hn h𝔪 hne hmono hz hv'
  have hcard' := BoundaryCountAlong.card_filter_mem_geoStrictTransform_lt_along hπ hC.subset_N hE
    h𝔪.isTransverse hC.2.2 (topIdx 𝔪.E v) (hz) hzN
    (hloc.mono fun y hy hyN hyI => hy.mpr ⟨hyN, hyI⟩)
  obtain ⟨j₀, hj₀, hzj₀⟩ : ∃ j₀ ∈ topIdx 𝔪.E v, z ∉ geoStrictTransform π (maxLocusA 𝔪) (𝔪.E.get j₀) := by
    by_contra h
    push Not at h
    rw [Finset.filter_true_of_mem h] at hcard'
    exact lt_irrefl _ hcard'
  have hj₀' : (j₀ : ℕ) ∈ topSet v := (Finset.mem_filter.mp hj₀).2
  have hlen : (𝔪.geoTransform (maxLocusA 𝔪) π).E.length = 𝔪.E.length + 1 := length_E_geoTransform _ _ _
  change inv n _ _ 𝔪.d < inv n (memberIdx 𝔪.E (π z)) (expDataAlong n 𝔪.N 𝔪.ideal 𝔪.E (π z)) 𝔪.d
  refine inv_lt_of_blowup (card_memberIdx_le 𝔪.E hE (π z)) hI htop (m := 𝔪.E.length) hj₀' ?_ ?_ ?_
  · intro i hi
    obtain ⟨hi', hzi⟩ := (mem_memberIdx _).mp hi
    have hget : (𝔪.geoTransform (maxLocusA 𝔪) π).E.get ⟨i, hi'⟩ =
        if h : i < 𝔪.E.length then geoStrictTransform π (maxLocusA 𝔪) (𝔪.E.get ⟨i, h⟩) else π ⁻¹' maxLocusA 𝔪 :=
      get_map_append_singleton 𝔪.E (geoStrictTransform π (maxLocusA 𝔪)) (π ⁻¹' maxLocusA 𝔪) ⟨i, hi'⟩
    by_cases hil : i < 𝔪.E.length
    · rw [hget, dif_pos hil] at hzi
      have hxi : π z ∈ 𝔪.E.get ⟨i, hil⟩ :=
        geoStrictTransform_subset_preimage hπ.contMDiff.continuous (hE.1 _ (List.get_mem _ _)) hzi
      refine Finset.mem_insert_of_mem (Finset.mem_erase.mpr ⟨fun h => hzj₀ ?_, (mem_memberIdx _).mpr ⟨hil, hxi⟩⟩)
      have : (⟨i, hil⟩ : Fin 𝔪.E.length) = j₀ := Fin.ext h
      rw [← this]
      exact hzi
    · have : i = 𝔪.E.length := by omega
      rw [this]
      exact Finset.mem_insert_self _ _
  · intro i hi
    obtain ⟨hil, -⟩ := (mem_memberIdx _).mp hi
    have hil' : i < (𝔪.geoTransform (maxLocusA 𝔪) π).E.length := by omega
    simp only [MonomialResolution.extExp, dif_pos hil', expDataAlong, dif_pos hil]
    exact ha' ⟨i, hil'⟩ hil
  · have hl : 𝔪.E.length < (𝔪.geoTransform (maxLocusA 𝔪) π).E.length := by omega
    simp only [MonomialResolution.extExp, dif_pos hl]
    exact hlast ⟨𝔪.E.length, hl⟩ (lt_irrefl _)

open Classical in
include hn h𝔪 hne hmono in
/-- **Off the centre the transform is principal monomial along `N'`**, with the exponents along `N` of `π z` on the
strict transforms of the members through `π z` (`exists_snc_chart_geoTransform_along_of_notMem`, fed with centred
coordinates at `π z`, `isPrincipalAlongAt_of_isMonomialAlong`). -/
theorem isPrincipalAlongAt_geoTransform_of_notMem {C : Set X} (hπ : IsBlowupAlong n C π) {z : Y}
    (hzN : z ∈ (𝔪.geoTransform C π).N) (hz : π z ∉ C) :
    IsPrincipalAlongAt (𝔪.geoTransform C π).N (𝔪.geoTransform C π).ideal (𝔪.geoTransform C π).E z
      (fun i => if h : i.1 < 𝔪.E.length then divExpAlong n 𝔪.N 𝔪.ideal (𝔪.E.get ⟨i.1, h⟩) (π z) else 0) := by
  have hπzN : π z ∈ 𝔪.N :=
    geoStrictTransform_subset_preimage hπ.contMDiff.continuous h𝔪.isClosedSubmanifold_N.1 hzN
  obtain ⟨k, Φ, σ, hΦsrc, hΦ0, hNflat, hσk, hσinj, hA, hgen⟩ :=
    isPrincipalAlongAt_of_isMonomialAlong hn h𝔪.isClosedSubmanifold_N h𝔪.isSNCDivisor h𝔪.isTransverse
      h𝔪.isCoherent hne hmono hπzN
  obtain ⟨Θ, σ', a', hΘt, hΘ0, hΘN, hσ'k, hσ'inj, hA', ha', hgen'⟩ :=
    MonomialBlowupAlongChart.exists_snc_chart_geoTransform_along_of_notMem hn hπ (𝔪 := 𝔪)
      h𝔪.isClosedSubmanifold_N.1 h𝔪.isCoherent h𝔪.isSNCDivisor hz hΦ0 hNflat hσk hσinj hA _ hgen
  refine ⟨k, Θ, σ', hΘt, hΘ0, hΘN, hσ'k, hσ'inj, hA', fun g => ?_⟩
  rw [hgen' g]
  have hfun : (fun y => ∏ i ∈ Finset.univ.filter (fun i => z ∈ (𝔪.geoTransform C π).E.get i),
      flatCoord Θ (σ' i) y ^ a' i) =
      fun y => ∏ i ∈ Finset.univ.filter (fun i => z ∈ (𝔪.geoTransform C π).E.get i),
        flatCoord Θ (σ' i) y ^ (if h : i.1 < 𝔪.E.length then
          divExpAlong n 𝔪.N 𝔪.ideal (𝔪.E.get ⟨i.1, h⟩) (π z) else 0) := by
    funext y
    refine Finset.prod_congr rfl fun i hi => ?_
    obtain ⟨hil, -⟩ := (MonomialResolution.mem_get_geoTransform_iff_of_notMem hπ 𝔪 h𝔪.isSNCDivisor hz i).mp
      (Finset.mem_filter.mp hi).2
    rw [dif_pos hil, ha' i hil]
  rw [hfun]

include hn h𝔪 hne hmono in
/-- **Off the centre the invariant does not change** (`hir:monomial-case` (2) along `N`, second half). -/
theorem gammaAlong_geoTransform_eq_of_notMem {C : Set X} (hπ : IsBlowupAlong n C π)
    (h𝔞' : (𝔪.geoTransform C π).ideal.IsCoherent) {z : Y} (hzN : z ∈ (𝔪.geoTransform C π).N) (hz : π z ∉ C)
    (d : ℕ) :
    gammaAlong n (𝔪.geoTransform C π).N (𝔪.geoTransform C π).ideal (𝔪.geoTransform C π).E d z =
      gammaAlong n 𝔪.N 𝔪.ideal 𝔪.E d (π z) := by
  rw [(isPrincipalAlongAt_geoTransform_of_notMem hn h𝔪 hne hmono hπ hzN hz).gammaAlong_eq h𝔞' hzN d, gammaAlong]
  have hE := h𝔪.isSNCDivisor
  have hidx : memberIdx (𝔪.geoTransform C π).E z = memberIdx 𝔪.E (π z) := by
    ext i
    rw [mem_memberIdx, mem_memberIdx]
    constructor
    · rintro ⟨hi, hzi⟩
      obtain ⟨hil, h⟩ := (MonomialResolution.mem_get_geoTransform_iff_of_notMem hπ 𝔪 hE hz ⟨i, hi⟩).mp hzi
      exact ⟨hil, h⟩
    · rintro ⟨hil, h⟩
      refine ⟨by rw [length_E_geoTransform]; omega, ?_⟩
      exact (MonomialResolution.mem_get_geoTransform_iff_of_notMem hπ 𝔪 hE hz _).mpr ⟨hil, h⟩
  rw [hidx]
  refine inv_congr fun i hi => ?_
  obtain ⟨hil, -⟩ := (mem_memberIdx 𝔪.E).mp hi
  have hil' : i < (𝔪.geoTransform C π).E.length := by rw [length_E_geoTransform]; omega
  simp only [MonomialResolution.extExp, expDataAlong, dif_pos hil', dif_pos hil]

end Step

/-! ### The monomial case along `N`: iterating the blowup of the maximum locus -/

section Tower

variable {X : CMfd.{u} n}

/-- **The invariant along towers**: `γ` along `N_T` of the transform at the last stage of a tower. -/
def towerInvAlong (𝔪 : MarkedIdeal n X) {Y : CMfd.{u} n} (T : BlowupTower X Y) : Y → WithBot Val :=
  gammaAlong n (geoTransformAlong 𝔪 T).N (geoTransformAlong 𝔪 T).ideal (geoTransformAlong 𝔪 T).E
    (geoTransformAlong 𝔪 T).d

end Tower

end

end Hironaka.MonomialStepAlong
