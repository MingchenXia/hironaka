/-!
# Order and derivatives; Giraud's lemma

Sources: Włodarczyk 2005 §2.1 (`ord_x`) and §2.6 (Lemma `le:Vi1`: `supp(𝓘, μ) = supp(𝓓^i 𝓘, μ - i)`),
Bierstone--Milman 2008 §3.2.

## Main results

* `iterChartDeriv e L g` -- the iterated partial derivative `∂_{v₁} ⋯ ∂_{v_m} g` in an atlas chart `e` along the
  list `L = [v₁, …, v_m]`; `iterChartDeriv_eq_iterDeriv` identifies it with `HolomorphicTaylorTail.iterDeriv` of `g
  ∘ e⁻¹`.
* **Order and derivatives** (`mem_idealPow_pointIdeal_iff`): for `x` in the domain of an atlas chart `e` and `g`
  holomorphic at `x`, `g ∈ 𝔪_x^q` if and only if every iterated partial derivative of order `< q` of `g` in `e`
  vanishes at `x`. The forward half iterates `chartDeriv_mem_idealPow`; the converse is
  `inNormalPow_of_iterDeriv_eq_zero` (with `k = 0`) transported to `M` by `mem_idealPow_of_inNormalPow`.
* `mem_idealPow_of_inNormalPow`: if `ψ : M → ℂⁿ` is holomorphic near `x`, its coordinates `ψᵢ`, `i ≥ k`,
  lie in an ideal `I` at `x`, and `f = F ∘ ψ` near `x` with `F` in the `μ`-th power of the ideal of
  the normal coordinates at `ψ x` (`InNormalPow k (ψ x) μ F`), then `f ∈ I^μ` at `x`.  (Also used
  by the Hadamard bridge, with `ψ` flattening coordinates.)
* **Giraud--Villamayor** (`N = M`): `cosupp(𝓓𝔞, μ) ⊆ cosupp(𝔞, μ+1)` for `μ ≥ 1`, hence `cosupp(𝔞, μ + i) =
  cosupp(𝓓^i 𝔞, μ)` for `μ ≥ 1`, `cosupp(𝔞, j + 1) = V(𝓓^j 𝔞)`, and the cosupport of a coherent ideal is closed.
-/

open Set Filter
open scoped Topology Manifold ContDiff

namespace Hironaka.OrderTaylor

open Hironaka.HolomorphicIdealSheaves
open Hironaka.IdealWeightPowers Hironaka.GermIdealOrder Hironaka.DerivativeIdeal Hironaka.HolomorphicTaylorTail

noncomputable section

variable {n : ℕ} {M : Type*} [TopologicalSpace M] [ChartedSpace (ComplexModel n) M]
  [IsComplexManifold n M]

/-! ### Powers of an ideal: closure properties at one point -/

section IdealPowers

variable {I : GermIdeal n M} {x : M} {f g : M → ℂ}

/-- Membership in `I^m` at `x` only depends on the germ at `x`. -/
theorem mem_idealPow_congr : ∀ {m : ℕ}, (idealPow I m).mem x f → f =ᶠ[𝓝 x] g →
    (idealPow I m).mem x g
  | 0, hf, h => HolomorphicAt.congr hf h
  | _ + 1, hf, h => mem_idealPow_succ_iff.mpr (isInSpanAt_congr (mem_idealPow_succ_iff.mp hf) h)

/-- `I^m` at `x` is closed under finite sums. -/
theorem mem_idealPow_sum {ι : Type*} (s : Finset ι) {F : ι → M → ℂ} :
    ∀ {m : ℕ}, (∀ i ∈ s, (idealPow I m).mem x (F i)) →
      (idealPow I m).mem x (fun p => ∑ i ∈ s, F i p)
  | 0, h => HolomorphicAt.sum s h
  | _ + 1, h => mem_idealPow_succ_iff.mpr (RelativePrincipalizationSpan.IsInSpanAt.sum s
      fun i hi => mem_idealPow_succ_iff.mp (h i hi))

/-- A product `a b` with `a ∈ I^m` and `b ∈ I` lies in `I^{m+1}`. -/
theorem mul_mem_idealPow_succ {a b : M → ℂ} {m : ℕ} (ha : (idealPow I m).mem x a) (hb : I.mem x b)
    (hab : HolomorphicAt n (fun p => a p * b p) x) :
    (idealPow I (m + 1)).mem x (fun p => a p * b p) :=
  mem_idealPow_succ_iff.mpr (isInSpanAt_of_eq_mul ⟨a, b, ha, hb, rfl⟩ hab (holomorphicAt_const 1)
    (Eventually.of_forall fun p => by simp))

end IdealPowers

/-! ### Holomorphic functions of holomorphic coordinates -/

/-- A function holomorphic near `ψ x` composed with a map `ψ : M → ℂⁿ` holomorphic near `x` is
holomorphic at `x`. -/
theorem holomorphicAt_comp {x : M} {ψ : M → ComplexModel n} {H : ComplexModel n → ℂ}
    (hψ : ∀ᶠ p in 𝓝 x, MDifferentiableAt 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel n) ψ p)
    (hH : ∀ᶠ u in 𝓝 (ψ x), DifferentiableAt ℂ H u) : HolomorphicAt n (fun p => H (ψ p)) x := by
  filter_upwards [hψ, hψ.self_of_nhds.continuousAt.eventually hH.eventually_nhds] with p hp hHp
  exact (mdifferentiableAt_iff_differentiableAt.mpr hHp.self_of_nhds).comp p hp

/-- **From normal powers on `ℂⁿ` to powers of an ideal on `M`.**  Let `ψ : M → ℂⁿ` be holomorphic near
`x`, with `ψ x = q` and with coordinates `ψᵢ`, `k ≤ i`, in the ideal `I` at `x`.  If `F` lies in the
`μ`-th power of the ideal generated by the coordinates `uᵢ`, `k ≤ i`, near `q`, and `f = F ∘ ψ` near `x`,
then `f ∈ I^μ` at `x`. -/
theorem mem_idealPow_of_inNormalPow {I : GermIdeal n M} {x : M} {k : ℕ} {ψ : M → ComplexModel n}
    {q : ComplexModel n} (hψx : ψ x = q)
    (hψ : ∀ᶠ p in 𝓝 x, MDifferentiableAt 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel n) ψ p)
    (hψI : ∀ i : Fin n, k ≤ i.1 → I.mem x (fun p => ψ p i)) :
    ∀ (μ : ℕ) {F : ComplexModel n → ℂ} {f : M → ℂ}, InNormalPow k q μ F →
      f =ᶠ[𝓝 x] (fun p => F (ψ p)) → (idealPow I μ).mem x f
  | 0, F, f, hF, hf => (holomorphicAt_comp hψ (hψx ▸ hF)).congr hf.symm
  | μ + 1, F, f, ⟨H, hH0, hH, hFeq⟩, hf => by
    classical
    have hcont : ContinuousAt ψ x := hψ.self_of_nhds.continuousAt
    have hFeq' : ∀ᶠ u in 𝓝 (ψ x), F u = ∑ i, u i * H i u := hψx ▸ hFeq
    have hfeq : f =ᶠ[𝓝 x] fun p => ∑ i ∈ Finset.univ.filter (fun i : Fin n => k ≤ i.1),
        H i (ψ p) * ψ p i := by
      filter_upwards [hf, hcont.eventually hFeq'] with p hp hp'
      rw [hp, hp', Finset.sum_filter]
      refine Finset.sum_congr rfl fun i _ => ?_
      split_ifs with hi
      · ring
      · rw [hH0 i (not_le.mp hi)]
        simp
    refine mem_idealPow_congr ?_ hfeq.symm
    refine mem_idealPow_sum _ fun i hi => ?_
    have hik : k ≤ i.1 := (Finset.mem_filter.mp hi).2
    have hHi : HolomorphicAt n (fun p => H i (ψ p)) x :=
      holomorphicAt_comp hψ (hψx ▸ (hH i).eventually_differentiableAt)
    have hψi : HolomorphicAt n (fun p => ψ p i) x :=
      holomorphicAt_comp (H := fun u => u i) hψ
        (Eventually.of_forall fun _ => (EuclideanSpace.proj i : ComplexModel n →L[ℂ] ℂ).differentiableAt)
    exact mul_mem_idealPow_succ (mem_idealPow_of_inNormalPow hψx hψ hψI μ (hH i) EventuallyEq.rfl)
      (hψI i hik) (hHi.mul hψi)

/-! ### Iterated partial derivatives in a chart -/

/-- **Iterated partial derivatives in a chart**: `iterChartDeriv e [v₁, …, v_m] g = ∂_{v₁} ⋯ ∂_{v_m} g`
(innermost derivative last), with `∂_v = chartDeriv e v`. -/
def iterChartDeriv (e : ComplexChart n M) : List (ComplexModel n) → (M → ℂ) → M → ℂ
  | [], g => g
  | v :: L, g => chartDeriv e v (iterChartDeriv e L g)

@[simp] theorem iterChartDeriv_nil (e : ComplexChart n M) (g : M → ℂ) :
    iterChartDeriv e [] g = g := rfl

@[simp] theorem iterChartDeriv_cons (e : ComplexChart n M) (v : ComplexModel n)
    (L : List (ComplexModel n)) (g : M → ℂ) :
    iterChartDeriv e (v :: L) g = chartDeriv e v (iterChartDeriv e L g) := rfl

/-- In the domain of the chart, the iterated partial derivatives of `g` in `e` are the iterated
directional derivatives of `g ∘ e⁻¹` (`HolomorphicTaylorTail.iterDeriv`) at `e p`. -/
theorem iterChartDeriv_eq_iterDeriv (e : ComplexChart n M) (g : M → ℂ) :
    ∀ (L : List (ComplexModel n)) {p : M}, p ∈ e.val.source →
      iterChartDeriv e L g p = iterDeriv L (g ∘ e.val.symm) (e.val p)
  | [], p, hp => by simp [e.val.left_inv hp]
  | v :: L, p, hp => by
    simp only [iterChartDeriv_cons, iterDeriv_cons, chartDeriv, dirDeriv]
    congr 1
    apply Filter.EventuallyEq.fderiv_eq
    filter_upwards [e.val.open_target.mem_nhds (e.val.map_source hp)] with z hz
    simp only [Function.comp_apply]
    rw [iterChartDeriv_eq_iterDeriv e g L (e.val.map_target hz), e.val.right_inv hz]

/-- Iterated directional derivatives commute with translations. -/
theorem iterDeriv_comp_add_right (F : ComplexModel n → ℂ) (c : ComplexModel n) :
    ∀ (L : List (ComplexModel n)) (u : ComplexModel n),
      iterDeriv L (fun w => F (w + c)) u = iterDeriv L F (u + c)
  | [], u => rfl
  | v :: L, u => by
    simp only [iterDeriv_cons, dirDeriv]
    have : iterDeriv L (fun w => F (w + c)) = fun w => iterDeriv L F (w + c) :=
      funext (iterDeriv_comp_add_right F c L)
    rw [this, fderiv_comp_add_right]

/-! ### Order and derivatives (`hir:order-taylor`) -/

section OrderTaylor

variable {e : ComplexChart n M} {x : M} {g : M → ℂ}

/-- Each partial derivative lowers the power of `𝔪_x` by at most one, so `m` of them map `𝔪_x^{q+m}`
into `𝔪_x^q`. -/
theorem iterChartDeriv_mem_idealPow (hx : x ∈ e.val.source) :
    ∀ (L : List (ComplexModel n)) (q : ℕ) (g : M → ℂ),
      (idealPow (pointIdeal n x) (q + L.length)).mem x g →
        (idealPow (pointIdeal n x) q).mem x (iterChartDeriv e L g)
  | [], q, g, hg => hg
  | v :: L, q, g, hg => by
    have h : q + (v :: L).length = (q + 1) + L.length := by simp; omega
    exact chartDeriv_mem_idealPow hx q _ (iterChartDeriv_mem_idealPow hx L (q + 1) g (h ▸ hg))

/-- **Order and derivatives, forward half**: the iterated partial derivatives of order `< q` of a germ
of `𝔪_x^q` vanish at `x`. -/
theorem iterChartDeriv_eq_zero_of_mem_idealPow (hx : x ∈ e.val.source) {q : ℕ}
    (hg : (idealPow (pointIdeal n x) q).mem x g) (L : List (ComplexModel n)) (hL : L.length < q) :
    iterChartDeriv e L g x = 0 := by
  obtain ⟨r, rfl⟩ : ∃ r, q = (r + 1) + L.length := ⟨q - L.length - 1, by omega⟩
  exact apply_eq_zero_of_mem_idealPow_pointIdeal (by omega)
    (iterChartDeriv_mem_idealPow hx L (r + 1) g hg)

/-- **Order and derivatives, converse half**: a function holomorphic at `x` whose iterated partial
derivatives of order `< q` in a chart vanish at `x` is a germ of `𝔪_x^q`. -/
theorem mem_idealPow_of_iterChartDeriv_eq_zero (hx : x ∈ e.val.source) (hg : HolomorphicAt n g x)
    (q : ℕ) (hvan : ∀ L : List (ComplexModel n), L.length < q → iterChartDeriv e L g x = 0) :
    (idealPow (pointIdeal n x) q).mem x g := by
  set c : ComplexModel n := e.val x
  set G : ComplexModel n → ℂ := fun u => (g ∘ e.val.symm) (u + c)
  have hT : Tendsto (fun u : ComplexModel n => u + c) (𝓝 0) (𝓝 c) := by
    simpa using (continuous_add_const c).tendsto (0 : ComplexModel n)
  have hGd : ∀ᶠ u in 𝓝 (0 : ComplexModel n), DifferentiableAt ℂ G u := by
    filter_upwards [hT.eventually (eventually_differentiableAt_comp_symm e hx hg)] with u hu
    exact DifferentiableAt.comp (g := g ∘ e.val.symm) (f := fun w : ComplexModel n => w + c) u hu
      (differentiableAt_id.add_const c)
  have hplane : (0 : ComplexModel n) ∈ complexCoordinatePlane n 0 := fun i _ => rfl
  have hGvan : ∀ᶠ y in 𝓝 (0 : ComplexModel n), y ∈ complexCoordinatePlane n 0 →
      ∀ L : List (ComplexModel n), L.length < q → iterDeriv L G y = 0 := by
    refine Eventually.of_forall fun y hy L hL => ?_
    have hy0 : y = 0 := by
      ext i
      exact hy i (Nat.zero_le _)
    subst hy0
    rw [iterDeriv_comp_add_right (g ∘ e.val.symm) c L 0, zero_add,
      ← iterChartDeriv_eq_iterDeriv e g L hx]
    exact hvan L hL
  have hG : InNormalPow 0 (0 : ComplexModel n) q G :=
    inNormalPow_of_iterDeriv_eq_zero q hplane hGd hGvan
  -- the translated chart `ψ = e - e x`
  set ψ : M → ComplexModel n := fun p => e.val p - c
  have hψx : ψ x = 0 := sub_self c
  have hψ : ∀ᶠ p in 𝓝 x, MDifferentiableAt 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel n) ψ p := by
    filter_upwards [e.val.open_source.mem_nhds hx] with p hp
    have h1 := mdifferentiableAt_atlas (I := 𝓘(ℂ, ComplexModel n)) e.property hp
    have h2 : MDifferentiableAt 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel n)
        (fun z : ComplexModel n => z - c) (e.val p) :=
      (differentiableAt_id.sub_const c).mdifferentiableAt
    exact h2.comp p h1
  have hψI : ∀ i : Fin n, 0 ≤ i.1 → (pointIdeal n x).mem x (fun p => ψ p i) := by
    intro i _
    refine mem_pointIdeal_of_apply_eq_zero ?_ (by simp [ψ, c])
    exact holomorphicAt_comp (H := fun u => u i) hψ
      (Eventually.of_forall fun _ => (EuclideanSpace.proj i : ComplexModel n →L[ℂ] ℂ).differentiableAt)
  refine mem_idealPow_of_inNormalPow hψx hψ hψI q hG ?_
  filter_upwards [e.val.open_source.mem_nhds hx] with p hp
  simp [G, ψ, c, e.val.left_inv hp]

/-- **Order and derivatives** (`hir:order-taylor`): for `x` in the domain of an atlas chart `e` and `g`
holomorphic at `x`, `g ∈ 𝔪_x^q` if and only if all iterated partial derivatives of order `< q` of `g` in
`e` vanish at `x`. -/
theorem mem_idealPow_pointIdeal_iff (hx : x ∈ e.val.source) (hg : HolomorphicAt n g x) (q : ℕ) :
    (idealPow (pointIdeal n x) q).mem x g ↔
      ∀ L : List (ComplexModel n), L.length < q → iterChartDeriv e L g x = 0 :=
  ⟨fun h L hL => iterChartDeriv_eq_zero_of_mem_idealPow hx h L hL,
    mem_idealPow_of_iterChartDeriv_eq_zero hx hg q⟩

end OrderTaylor

/-! ### Giraud--Villamayor (`hir:giraud-support`, `N = M`) -/

section Giraud

variable {𝔞 : GermIdeal n M}

/-- Vanishing to order `q` along `M` itself is membership in `𝔪_x^q` up to germ equality. -/
theorem mem_idealPow_of_vanishesToOrderOn_univ {x : M} {q : ℕ} {g : M → ℂ}
    (hg : VanishesToOrderOn n univ x q g) : (idealPow (pointIdeal n x) q).mem x g := by
  obtain ⟨h, hh, hgh⟩ := hg
  exact mem_idealPow_congr hh (hgh.mono fun y hy => (hy (mem_univ y)).symm)

end Giraud

end

end Hironaka.OrderTaylor
