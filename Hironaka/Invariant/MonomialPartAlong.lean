noncomputable section

variable {n : ℕ} {M : Type*} [TopologicalSpace M] [ChartedSpace (ComplexModel n) M]
  [IsComplexManifold n M]

/-! ### The flat retraction in adapted coordinates -/

section FlatRetract

variable {x : M} {Φ : LocalHolomorphicEquivAt (n := n) (chartAt (ComplexModel n) x x)}
  (hΦsrc : Φ.source ⊆ (chartAt (ComplexModel n) x).target) {N : Set M} {kN : ℕ}
  (hNflat : ∀ {y : M}, y ∈ (chartAt (ComplexModel n) x).source → chartAt (ComplexModel n) x y ∈ Φ.source →
    (y ∈ N ↔ Φ.toFun (chartAt (ComplexModel n) x y) ∈ complexCoordinatePlane n kN))

variable (Φ kN) in
/-- **The flat retraction** `φ ∘ P ∘ ψ` onto `ℂ^{k_N} × 0`, read in the flat coordinates `ψ = Φ ∘ e`. -/
def flatRetract : M → M := fun p => flatInv Φ (planeRetract kN (flatMap Φ p))

/-- The flat coordinates `ψ = Φ ∘ e` are holomorphic on the flat domain.  Duplicate of
`ExceptionalPushforwardAlong.mdifferentiableAt_flatMap` (the same statement, proved earlier), kept per the no-delete rule. -/
theorem mdifferentiableAt_flatMap {y : M} (hy : y ∈ flatDomain Φ) :
    MDifferentiableAt 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel n) (flatMap Φ) y :=
  (Φ.toFun_holomorphic.differentiableAt (Φ.isOpen_source.mem_nhds hy.2)).mdifferentiableAt.comp y
    (mdifferentiableAt_chart (y₀ := x) hy.1)

/-- Near a point of `N` in the flat domain, the retracted flat coordinates stay in the target. -/
theorem eventually_planeRetract_flatMap_mem_target {y : M} (hy : y ∈ flatDomain Φ)
    (hyk : flatMap Φ y ∈ complexCoordinatePlane n kN) :
    ∀ᶠ p in 𝓝 y, planeRetract kN (flatMap Φ p) ∈ Φ.target := by
  have hc : ContinuousAt (fun p => planeRetract kN (flatMap Φ p)) y :=
    (planeRetract kN).continuous.continuousAt.comp (mdifferentiableAt_flatMap hy).continuousAt
  refine hc.preimage_mem_nhds (Φ.isOpen_target.mem_nhds ?_)
  rw [planeRetract_of_mem hyk]
  exact flatMap_mem_target hy

include hΦsrc hNflat in
/-- **The flat retraction is a local retraction onto `N`** at every point of `N` in the flat domain. -/
theorem isLocalRetraction_flatRetract {y : M} (hy : y ∈ flatDomain Φ) (hyN : y ∈ N) :
    IsLocalRetraction n N (flatRetract Φ kN) y := by
  have hyk : flatMap Φ y ∈ complexCoordinatePlane n kN := (hNflat hy.1 hy.2).mp hyN
  have hT := eventually_planeRetract_flatMap_mem_target hy hyk
  refine ⟨?_, ?_, ?_, ?_⟩
  · show flatInv Φ (planeRetract kN (flatMap Φ y)) = y
    rw [planeRetract_of_mem hyk, flatInv_flatMap hy]
  · filter_upwards [hT, (isOpen_flatDomain Φ).mem_nhds hy] with p hpT hp
    have hφd : MDifferentiableAt 𝓘(ℂ, ComplexModel n) 𝓘(ℂ, ComplexModel n)
        (fun w => (chartAt (ComplexModel n) x).symm (Φ.invFun w)) (planeRetract kN (flatMap Φ p)) :=
      (mdifferentiableAt_chart_symm (y₀ := x) (hΦsrc (Φ.mapsTo_invFun hpT))).comp _
        (Φ.invFun_holomorphic.differentiableAt (Φ.isOpen_target.mem_nhds hpT)).mdifferentiableAt
    exact hφd.comp p ((planeRetract kN).differentiableAt.mdifferentiableAt.comp p (mdifferentiableAt_flatMap hp))
  · filter_upwards [hT] with p hpT
    exact flatInv_mem hΦsrc hNflat hpT (planeRetract_mem kN _)
  · filter_upwards [(isOpen_flatDomain Φ).mem_nhds hy] with p hp hpN
    have hpk : flatMap Φ p ∈ complexCoordinatePlane n kN := (hNflat hp.1 hp.2).mp hpN
    show flatInv Φ (planeRetract kN (flatMap Φ p)) = p
    rw [planeRetract_of_mem hpk, flatInv_flatMap hp]

include hΦsrc hNflat in
/-- **The flat retraction keeps the coordinates of index `< k_N`.** -/
theorem eventually_flatMap_flatRetract {y : M} (hy : y ∈ flatDomain Φ) (hyN : y ∈ N) {j : Fin n}
    (hj : j.1 < kN) : ∀ᶠ p in 𝓝 y, flatRetract Φ kN p ∈ flatDomain Φ ∧
      flatMap Φ (flatRetract Φ kN p) j = flatMap Φ p j := by
  have hyk : flatMap Φ y ∈ complexCoordinatePlane n kN := (hNflat hy.1 hy.2).mp hyN
  filter_upwards [eventually_planeRetract_flatMap_mem_target hy hyk] with p hpT
  refine ⟨flatInv_mem_flatDomain hpT hΦsrc, ?_⟩
  show flatMap Φ (flatInv Φ (planeRetract kN (flatMap Φ p))) j = _
  rw [flatMap_flatInv hpT hΦsrc, planeRetract_apply, if_pos hj]

include hΦsrc hNflat in
/-- **The flat retraction maps a coordinate hyperplane `{w_t = 0}` (`t < k_N`) into itself.** -/
theorem eventually_flatRetract_mem {y : M} (hy : y ∈ flatDomain Φ) (hyN : y ∈ N) {A : Set M} {t : Fin n}
    (ht : t.1 < kN)
    (hA : ∀ {y : M}, y ∈ (chartAt (ComplexModel n) x).source → chartAt (ComplexModel n) x y ∈ Φ.source →
      (y ∈ A ↔ Φ.toFun (chartAt (ComplexModel n) x y) t = 0)) :
    ∀ᶠ p in 𝓝 y, p ∈ A → flatRetract Φ kN p ∈ A := by
  filter_upwards [eventually_flatMap_flatRetract hΦsrc hNflat hy hyN ht, (isOpen_flatDomain Φ).mem_nhds hy]
    with p ⟨hrD, hrt⟩ hp hpA
  refine (hA hrD.1 hrD.2).mpr ?_
  change flatMap Φ (flatRetract Φ kN p) t = 0
  rw [hrt]
  exact (hA hp.1 hp.2).mp hpA

end FlatRetract

/-! ### Simultaneous divisibility along `N` -/

section Factorization

variable {x : M} {Φ : LocalHolomorphicEquivAt (n := n) (chartAt (ComplexModel n) x x)}
  (hΦsrc : Φ.source ⊆ (chartAt (ComplexModel n) x).target) {N : Set M} {kN : ℕ}
  (hNflat : ∀ {y : M}, y ∈ (chartAt (ComplexModel n) x).source → chartAt (ComplexModel n) x y ∈ Φ.source →
    (y ∈ N ↔ Φ.toFun (chartAt (ComplexModel n) x y) ∈ complexCoordinatePlane n kN))
  {ι : Type*} [DecidableEq ι] {A : ι → Set M} {σ : ι → Fin n}

include hΦsrc hNflat in
/-- **Simultaneous divisibility along `N`** (`hir:monomial-factorization-along`): in coordinates in which
`N = ℂ^{k_N} × 0` and the sets `A i` (`i ∈ T`) are the coordinate hyperplanes `{w_{σ i} = 0}` with `σ i < k_N`
(submanifolds at their points, `σ` injective on `T`), a germ at a point `y ∈ N` of the chart whose restriction to `N` is
divisible by each `u_i^{a_i}` (`u_i = w_{σ i}`) is divisible on `N` by `∏_{i ∈ T} u_i^{a_i}`. -/
theorem exists_eq_mul_prod_of_forall_along (a : ι → ℕ) {y : M} (hy : y ∈ flatDomain Φ) (hyN : y ∈ N)
    (T : Finset ι)
    (hA : ∀ i ∈ T, ∀ {y : M}, y ∈ (chartAt (ComplexModel n) x).source → chartAt (ComplexModel n) x y ∈ Φ.source →
      (y ∈ A i ↔ Φ.toFun (chartAt (ComplexModel n) x y) (σ i) = 0))
    (hreg : ∀ i ∈ T, ∀ y ∈ A i, ∃ k, RegularAtDim (n := n) (A i) y k) (hσ : Set.InjOn σ T)
    (hσk : ∀ i ∈ T, (σ i).1 < kN) {g : M → ℂ} (hg : HolomorphicAt n g y)
    (hdiv : ∀ i ∈ T, ∃ c, HolomorphicAt n c y ∧ ∀ᶠ z in 𝓝 y, z ∈ N → g z = c z * flatMap Φ z (σ i) ^ a i) :
    ∃ c, HolomorphicAt n c y ∧ ∀ᶠ z in 𝓝 y, z ∈ N → g z = c z * ∏ i ∈ T, flatMap Φ z (σ i) ^ a i := by
  set r := flatRetract Φ kN
  have hr : IsLocalRetraction n N r y := isLocalRetraction_flatRetract hΦsrc hNflat hy hyN
  -- the retracted germ is divisible ambiently
  have hdiv' : ∀ i ∈ T, ∃ c, HolomorphicAt n c y ∧ (g ∘ r) =ᶠ[𝓝 y] fun z => c z * flatMap Φ z (σ i) ^ a i := by
    intro i hi
    obtain ⟨c, hc, hgc⟩ := hdiv i hi
    refine ⟨c ∘ r, hr.holomorphicAt_comp hc, ?_⟩
    filter_upwards [hr.mem, hr.tendsto.eventually hgc,
      eventually_flatMap_flatRetract hΦsrc hNflat hy hyN (hσk i hi)] with z hz1 hz2 hz3
    simp only [Function.comp]
    rw [hz2 hz1, hz3.2]
  obtain ⟨c, hc, hgc⟩ := exists_eq_mul_prod_of_forall hΦsrc a hy T hA hreg hσ (hr.holomorphicAt_comp hg) hdiv'
  refine ⟨c, hc, ?_⟩
  filter_upwards [hgc, hr.eventually_eq_comp g] with z h1 h2 hzN
  rw [h2 hzN, h1]

end Factorization

/-! ### Retractions preserving the members -/

section Members

open NormalCrossings BlowupSNCTransform

variable {N : Set M} {E : List (Set M)}

/-- **A local retraction onto `N` preserving the members**: for `E` simple normal crossings and transverse to `N`
(`n > 0`), at every `y ∈ N` there is a local retraction onto `N` mapping each member through `y` into itself near
`y`. -/
theorem exists_isLocalRetraction_preserving (hn : 0 < n) (hE : IsSNCDivisor n E) (hT : IsTransverse n N E) {y : M}
    (hy : y ∈ N) : ∃ r, IsLocalRetraction n N r y ∧
      ∀ i, y ∈ E.get i → ∀ᶠ z in 𝓝 y, z ∈ E.get i → r z ∈ E.get i := by
  obtain ⟨kC, kN, Φ, s, hΦsrc, hsk, -, hflat⟩ :=
    SimultaneousNormalCrossings.isAdaptedAt_of_hasNormalCrossings hn subset_rfl hE hT hT.hasNormalCrossings hy
  have hNflat : ∀ {z : M}, z ∈ (chartAt (ComplexModel n) y).source → chartAt (ComplexModel n) y z ∈ Φ.source →
      (z ∈ N ↔ Φ.toFun (chartAt (ComplexModel n) y z) ∈ complexCoordinatePlane n kN) :=
    fun hz1 hz2 => (hflat hz1 hz2).2.1
  refine ⟨flatRetract Φ kN, isLocalRetraction_flatRetract hΦsrc hNflat (mem_flatDomain_self Φ) hy,
    fun i hyi => ?_⟩
  exact eventually_flatRetract_mem hΦsrc hNflat (mem_flatDomain_self Φ) hy (hsk i hyi)
    fun hz1 hz2 => (hflat hz1 hz2).2.2 i hyi

end Members

/-! ### Restricted spans of one function -/

/-- Membership in the restricted span of a single function. -/
theorem isInSpanOnAt_eq_iff {W : Set M} {h g : M → ℂ} {y : M} :
    IsInSpanOnAt (n := n) W (· = h) y g ↔
      ∃ a, HolomorphicAt n a y ∧ ∀ᶠ z in 𝓝 y, z ∈ W → g z = a z * h z := by
  constructor
  · rintro ⟨K, s, a, hs, ha, hsum⟩
    refine ⟨fun z => ∑ i, a i z, HolomorphicAt.sum _ fun i _ => ha i, ?_⟩
    filter_upwards [hsum] with z hz hzW
    rw [hz hzW, Finset.sum_mul]
    exact Finset.sum_congr rfl fun i _ => by rw [hs i]
  · rintro ⟨a, ha, heq⟩
    exact ⟨1, fun _ => h, fun _ => a, fun _ => rfl, fun _ => ha, by simpa using heq⟩

/-! ### The monomial part along `N` and its local generator -/

section Generator

open NormalCrossings BlowupSNCTransform

variable {N : Set M} {𝔞 : GermIdeal n M} {E : List (Set M)}

variable (n) in
/-- **The monomial part along `N`** `𝓜_N(𝔞)` (`hir:monomial-part-along`): at `y ∈ N`, the germs whose restriction to `N`
lies in `(𝓘_{E_i}^{e_i(y)})|_N` for every member `E_i` through `y`, where `e_i = divExpAlong 𝔞 N E_i` is the exponent
along `N`; off `N`, every holomorphic germ. -/
def monomialPartAlong (N : Set M) (𝔞 : GermIdeal n M) (E : List (Set M)) : GermIdeal n M where
  mem y g := HolomorphicAt n g y ∧ ∀ i : Fin E.length, y ∈ N → y ∈ E.get i →
    IsInSpanOnAt (n := n) N
      ((idealPow (vanishingIdeal (n := n) (E.get i)) (divExpAlong n N 𝔞 (E.get i) y)).mem y) y g

variable (n) in
/-- **The nonmonomial part along `N`** `𝓝_N(𝔞) = (Res_N 𝔞 : 𝓜_N(𝔞))`, realised ambiently as the colon of the extension
`restrictOn N 𝔞` by `𝓜_N(𝔞)` (`RestrictedIdealQuotient.colonAlong`). -/
def nonmonomialPartAlong (N : Set M) (𝔞 : GermIdeal n M) (E : List (Set M)) : GermIdeal n M :=
  colonAlong n N 𝔞 (monomialPartAlong n N 𝔞 E)

/-- **`𝔞 ⊆ 𝓜_N(𝔞)`**: for `E` simple normal crossings and transverse to `N` (`n > 0`), every germ of `𝔞` restricts on
`N` into `(𝓘_{E_i}^{e_i})|_N` (with the retraction preserving the members, `g ∘ r ∈ 𝓘_{E_i}^{e_i}` and `g = g ∘ r` on
`N`). -/
theorem le_monomialPartAlong (hn : 0 < n) (hE : IsSNCDivisor n E) (hT : IsTransverse n N E) (h𝔞 : 𝔞.IsCoherent) :
    𝔞.Le (monomialPartAlong n N 𝔞 E) := by
  have hhol : ∀ x g, 𝔞.mem x g → HolomorphicAt n g x := fun _ _ hg =>
    GermIdeal.IsCoherent.holomorphicAt_mem h𝔞 hg
  intro y g hg
  refine ⟨hhol y g hg, fun i hyN hyi => ?_⟩
  obtain ⟨r, hr, hpres⟩ := exists_isLocalRetraction_preserving hn hE hT hyN
  obtain ⟨k, hk⟩ := (isClosedSubmanifold_get hn hE i).2 y hyi
  have hmem := hr.mem_idealPow_vanishingIdeal_comp h𝔞 hk (hpres i hyi) (isDivNearAlong_divExpAlong hhol y) hg
  refine ⟨1, fun _ => g ∘ r, fun _ => fun _ => 1, fun _ => hmem, fun _ => holomorphicAt_const 1, ?_⟩
  filter_upwards [hr.eventually_eq_comp g] with z hz hzN
  simp [hz hzN]

variable {x : M} {Φ : LocalHolomorphicEquivAt (n := n) (chartAt (ComplexModel n) x x)}
  (hΦsrc : Φ.source ⊆ (chartAt (ComplexModel n) x).target) {kN : ℕ}
  (hNflat : ∀ {y : M}, y ∈ (chartAt (ComplexModel n) x).source → chartAt (ComplexModel n) x y ∈ Φ.source →
    (y ∈ N ↔ Φ.toFun (chartAt (ComplexModel n) x y) ∈ complexCoordinatePlane n kN))
  {σ : Fin E.length → Fin n}
  (hA : ∀ i, x ∈ E.get i → ∀ {y : M}, y ∈ (chartAt (ComplexModel n) x).source →
    chartAt (ComplexModel n) x y ∈ Φ.source →
      (y ∈ E.get i ↔ Φ.toFun (chartAt (ComplexModel n) x y) (σ i) = 0))

/-- The monomial generator is holomorphic on the flat domain. -/
theorem holomorphicAt_generator (T : Finset (Fin E.length)) (e : Fin E.length → ℕ) {y : M}
    (hy : y ∈ flatDomain Φ) : HolomorphicAt n (fun z => ∏ i ∈ T, flatCoord Φ (σ i) z ^ e i) y :=
  holomorphicAt_finset_prod T fun i _ =>
    CompanionReduction.holomorphicAt_pow_of (holomorphicAt_flatCoord Φ (σ i) hy) (e i)

include hA in
/-- **The monomial generator lies in `𝓘_{E_i}^{e_i}`** at the points of the flat domain, for a member `E_i` through
`x`. -/
theorem mem_idealPow_generator {T : Finset (Fin E.length)} (hT : ∀ i ∈ T, x ∈ E.get i)
    (e : Fin E.length → ℕ) {y : M} (hy : y ∈ flatDomain Φ) {i : Fin E.length} (hi : i ∈ T) :
    (idealPow (vanishingIdeal (n := n) (E.get i)) (e i)).mem y
      (fun z => ∏ j ∈ T, flatCoord Φ (σ j) z ^ e j) := by
  have hu : (vanishingIdeal (n := n) (E.get i)).mem y (flatCoord Φ (σ i)) := by
    refine ⟨holomorphicAt_flatCoord Φ (σ i) hy, ?_⟩
    filter_upwards [(isOpen_flatDomain Φ).mem_nhds hy] with z hz hzi
    exact (hA i (hT i hi) hz.1 hz.2).mp hzi
  have hpow := pow_mem_idealPow hu (holomorphicAt_flatCoord Φ (σ i) hy) (e i)
  refine mem_idealPow_congr (mul_mem_idealPow (holomorphicAt_generator (σ := σ) (T.erase i) e hy) hpow) ?_
  filter_upwards with z
  rw [← Finset.mul_prod_erase T (fun j => flatCoord Φ (σ j) z ^ e j) hi]
  ring

include hΦsrc hNflat in
/-- **The monomial generator vanishes identically on no relatively open subset of `N`**: at a point `y ∈ N` of the
flat domain, points of `N` where it does not vanish accumulate. -/
theorem frequently_generator_ne_zero {T : Finset (Fin E.length)} (hσk : ∀ i ∈ T, (σ i).1 < kN)
    (e : Fin E.length → ℕ) {y : M} (hy : y ∈ flatDomain Φ) (hyN : y ∈ N) :
    ∃ᶠ z in 𝓝 y, z ∈ N ∧ (∏ i ∈ T, flatCoord Φ (σ i) z ^ e i) ≠ 0 := by
  refine (frequently_flatMap_ne_zero hΦsrc hy (T.image σ)).mono fun z ⟨hzD, hzne, hzeq⟩ => ⟨?_, ?_⟩
  · refine (hNflat hzD.1 hzD.2).mpr fun l hl => ?_
    have hlT : l ∉ T.image σ := fun h => by
      obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp h
      have := hσk i hi
      omega
    change flatMap Φ z l = 0
    rw [hzeq l hlT]
    exact (hNflat hy.1 hy.2).mp hyN l hl
  · exact Finset.prod_ne_zero_iff.mpr fun i hi => pow_ne_zero _ (hzne (σ i) (Finset.mem_image_of_mem σ hi))

open Classical in
include hΦsrc hNflat hA in
/-- **The monomial part along `N` is generated on `N` by the monomial** (`hir:monomial-part-along`): in coordinates at
`x ∈ N` adapted to `N` and `E` (`N = ℂ^{k_N} × 0`, the members through `x` the hyperplanes `{w_{σ i} = 0}`,
`σ i < k_N`), for `y` near `x` a germ lies in `𝓜_N(𝔞)_y` iff its restriction to `N` is a multiple of
`m = ∏_{x ∈ E_i} w_{σ i}^{e_i(x)}`.  This is the `hgen` form of
`MonomialBlowupAlongChart.exists_snc_chart_geoTransform_along_of_flat`. -/
theorem monomialPartAlong_mem_iff (hn : 0 < n) (hN : IsClosedSubmanifold n N) (hE : IsSNCDivisor n E)
    (hT : IsTransverse n N E) (h𝔞 : 𝔞.IsCoherent) (hne : ∀ y ∈ N, IsNonzeroAlongAt N 𝔞 y) (hx : x ∈ N)
    (hσk : ∀ i, x ∈ E.get i → (σ i).1 < kN) (hσinj : Set.InjOn σ {i | x ∈ E.get i}) :
    ∀ᶠ y in 𝓝 x, ∀ g, (monomialPartAlong n N 𝔞 E).mem y g ↔ HolomorphicAt n g y ∧
      IsInSpanOnAt (n := n) N (· = fun z => ∏ i ∈ Finset.univ.filter (fun i => x ∈ E.get i),
        flatCoord Φ (σ i) z ^ divExpAlong n N 𝔞 (E.get i) x) y g := by
  classical
  set T : Finset (Fin E.length) := Finset.univ.filter fun i => x ∈ E.get i with hT_def
  set e : Fin E.length → ℕ := fun i => divExpAlong n N 𝔞 (E.get i) x with he_def
  have hmemT : ∀ i, i ∈ T ↔ x ∈ E.get i := fun i => by simp [T]
  have hA' : ∀ i ∈ T, ∀ {y : M}, y ∈ (chartAt (ComplexModel n) x).source →
      chartAt (ComplexModel n) x y ∈ Φ.source →
        (y ∈ E.get i ↔ Φ.toFun (chartAt (ComplexModel n) x y) (σ i) = 0) :=
    fun i hi => hA i ((hmemT i).mp hi)
  have hreg : ∀ i ∈ T, ∀ y ∈ E.get i, ∃ k, RegularAtDim (n := n) (E.get i) y k :=
    fun i _ y hy => (isClosedSubmanifold_get hn hE i).2 y hy
  have hσ : Set.InjOn σ T := fun i hi j hj hij => hσinj ((hmemT i).mp hi) ((hmemT j).mp hj) hij
  have hσk' : ∀ i ∈ T, (σ i).1 < kN := fun i hi => hσk i ((hmemT i).mp hi)
  have hev : ∀ᶠ y in 𝓝 x, y ∈ flatDomain Φ ∧ (∀ i, y ∈ E.get i → i ∈ T) ∧
      ∀ i ∈ T, y ∈ N → y ∈ E.get i → divExpAlong n N 𝔞 (E.get i) y = e i := by
    have hD : ∀ᶠ y in 𝓝 x, y ∈ flatDomain Φ := (isOpen_flatDomain Φ).mem_nhds (mem_flatDomain_self Φ)
    refine hD.and ((eventually_all.mpr fun i => ?_).and ((eventually_all_finset T).mpr fun i hi => ?_))
    · by_cases hxi : x ∈ E.get i
      · exact Eventually.of_forall fun _ _ => (hmemT i).mpr hxi
      · filter_upwards [(hE.1 _ (List.get_mem E i)).isOpen_compl.mem_nhds hxi] with y hy hyi
        exact absurd hyi hy
    · exact eventually_divExpAlong_get_eq hn hN hE hT h𝔞 hne i hx ((hmemT i).mp hi)
  filter_upwards [hev] with y ⟨hyD, hyT, hye⟩ g
  constructor
  · rintro ⟨hgh, hgi⟩
    refine ⟨hgh, ?_⟩
    by_cases hyN : y ∈ N
    · have hdiv : ∀ i ∈ T, ∃ c, HolomorphicAt n c y ∧
          ∀ᶠ z in 𝓝 y, z ∈ N → g z = c z * flatCoord Φ (σ i) z ^ e i := by
        intro i hi
        by_cases hyi : y ∈ E.get i
        · have h1 := hgi i hyN hyi
          rw [hye i hi hyN hyi] at h1
          obtain ⟨K, s, a, hs, ha, hsum⟩ := h1
          choose d hd hsd using fun k => exists_eq_mul_pow_of_mem_idealPow
            (fun g hg => (vanishingIdeal_mem_iff_flatCoord Φ (hA' i hi) hyD g).mp hg) (hs k)
          refine ⟨fun z => ∑ k, a k z * d k z, HolomorphicAt.sum _ fun k _ => (ha k).mul (hd k), ?_⟩
          filter_upwards [hsum, eventually_all.mpr hsd] with z hz hz' hzN
          rw [hz hzN, Finset.sum_mul]
          exact Finset.sum_congr rfl fun k _ => by rw [hz' k]; ring
        · have huy : flatCoord Φ (σ i) y ≠ 0 := fun h => hyi ((hA' i hi hyD.1 hyD.2).mpr h)
          obtain ⟨c, hc, hgc⟩ :=
            exists_eq_mul_pow_of_ne_zero (holomorphicAt_flatCoord Φ (σ i) hyD) huy hgh (e i)
          exact ⟨c, hc, hgc.mono fun z hz _ => hz⟩
      obtain ⟨c, hc, hgc⟩ :=
        exists_eq_mul_prod_of_forall_along hΦsrc hNflat e hyD hyN T hA' hreg hσ hσk' hgh hdiv
      exact isInSpanOnAt_eq_iff.mpr ⟨c, hc, hgc⟩
    · exact MarkedIdealOperationsAlong.isInSpanOnAt_of_notMem hN.1 hyN g
  · rintro ⟨hgh, hgm⟩
    refine ⟨hgh, fun i hyN hyi => ?_⟩
    have hi := hyT i hyi
    rw [hye i hi hyN hyi]
    obtain ⟨a, ha, hga⟩ := isInSpanOnAt_eq_iff.mp hgm
    exact ⟨1, fun _ => fun z => ∏ j ∈ T, flatCoord Φ (σ j) z ^ e j, fun _ => a,
      fun _ => mem_idealPow_generator hA (fun j hj => (hmemT j).mp hj) e hyD hi, fun _ => ha,
      by simpa [he_def] using hga⟩

/-- **The local generator of the monomial part along `N`**, in abstract form: near every `x ∈ N` there is a function
`m`, holomorphic near `x`, lying in `(𝓘_{E_i}^{e_i(x)})_x` for the members through `x`, which generates `𝓜_N(𝔞)` on
`N` at the points near `x`, and vanishes identically on no relatively open subset of `N` near `x`. -/
theorem exists_generator_monomialPartAlong (hn : 0 < n) (hN : IsClosedSubmanifold n N) (hE : IsSNCDivisor n E)
    (hT : IsTransverse n N E) (h𝔞 : 𝔞.IsCoherent) (hne : ∀ y ∈ N, IsNonzeroAlongAt N 𝔞 y) {x : M} (hx : x ∈ N) :
    ∃ m : M → ℂ, (∀ᶠ y in 𝓝 x, HolomorphicAt n m y) ∧
      (∀ i, x ∈ E.get i → (idealPow (vanishingIdeal (n := n) (E.get i)) (divExpAlong n N 𝔞 (E.get i) x)).mem x m) ∧
      (∀ᶠ y in 𝓝 x, ∀ g, (monomialPartAlong n N 𝔞 E).mem y g ↔
        HolomorphicAt n g y ∧ IsInSpanOnAt (n := n) N (· = m) y g) ∧
      ∀ᶠ y in 𝓝 x, y ∈ N → ∃ᶠ z in 𝓝 y, z ∈ N ∧ m z ≠ 0 := by
  classical
  obtain ⟨kC, kN, Φ, σ, hΦsrc, hσk, hσinj, hflat⟩ :=
    SimultaneousNormalCrossings.isAdaptedAt_of_hasNormalCrossings hn subset_rfl hE hT hT.hasNormalCrossings hx
  have hNflat : ∀ {z : M}, z ∈ (chartAt (ComplexModel n) x).source → chartAt (ComplexModel n) x z ∈ Φ.source →
      (z ∈ N ↔ Φ.toFun (chartAt (ComplexModel n) x z) ∈ complexCoordinatePlane n kN) :=
    fun hz1 hz2 => (hflat hz1 hz2).2.1
  have hA : ∀ i, x ∈ E.get i → ∀ {z : M}, z ∈ (chartAt (ComplexModel n) x).source →
      chartAt (ComplexModel n) x z ∈ Φ.source →
        (z ∈ E.get i ↔ Φ.toFun (chartAt (ComplexModel n) x z) (σ i) = 0) :=
    fun i hi _ hz1 hz2 => (hflat hz1 hz2).2.2 i hi
  set T : Finset (Fin E.length) := Finset.univ.filter fun i => x ∈ E.get i with hT_def
  have hmemT : ∀ i, i ∈ T ↔ x ∈ E.get i := fun i => by simp [T]
  have hD : ∀ᶠ y in 𝓝 x, y ∈ flatDomain Φ := (isOpen_flatDomain Φ).mem_nhds (mem_flatDomain_self Φ)
  refine ⟨fun z => ∏ i ∈ T, flatCoord Φ (σ i) z ^ divExpAlong n N 𝔞 (E.get i) x,
    hD.mono fun y hy => holomorphicAt_generator T _ hy, fun i hi => ?_,
    monomialPartAlong_mem_iff hΦsrc hNflat hA hn hN hE hT h𝔞 hne hx hσk hσinj, ?_⟩
  · exact mem_idealPow_generator hA (fun j hj => (hmemT j).mp hj) (fun j => divExpAlong n N 𝔞 (E.get j) x)
      (mem_flatDomain_self Φ) ((hmemT i).mpr hi)
  · filter_upwards [hD] with y hy hyN
    exact frequently_generator_ne_zero hΦsrc hNflat (fun i hi => hσk i ((hmemT i).mp hi)) _ hy hyN

variable (n) in
/-- **`𝔞` is monomial along `N`**: `Res_N 𝓜_N(𝔞) ⊆ Res_N 𝔞` (with `le_monomialPartAlong`, `Res_N 𝔞 = Res_N 𝓜_N(𝔞)`; for
`N = M` this is `(monomialPart 𝔞 E).Le 𝔞`). -/
def IsMonomialAlong (N : Set M) (𝔞 : GermIdeal n M) (E : List (Set M)) : Prop :=
  RestrictLe N (monomialPartAlong n N 𝔞 E) 𝔞

open Classical in
include hΦsrc hNflat hA in
/-- **A monomial ideal along `N` is generated on `N` by its monomial at every point** (`hir:monomial-part-along`): in
coordinates at `x ∈ N` adapted to `N` and `E`, the restriction of `𝔞_x` to `N` is generated by
`∏_{x ∈ E_i} w_{σ i}^{e_i(x)}` -- exactly the hypothesis `hgen` of
`MonomialBlowupAlongChart.exists_snc_chart_geoTransform_along_of_flat`, with the exponents `a i = e_i(x)`. -/
theorem isInSpanOnAt_iff_generator_of_isMonomialAlong (hn : 0 < n) (hN : IsClosedSubmanifold n N)
    (hE : IsSNCDivisor n E) (hT : IsTransverse n N E) (h𝔞 : 𝔞.IsCoherent) (hne : ∀ y ∈ N, IsNonzeroAlongAt N 𝔞 y)
    (hmono : IsMonomialAlong n N 𝔞 E) (hx : x ∈ N) (hσk : ∀ i, x ∈ E.get i → (σ i).1 < kN)
    (hσinj : Set.InjOn σ {i | x ∈ E.get i}) (g : M → ℂ) :
    IsInSpanOnAt (n := n) N (𝔞.mem x) x g ↔
      IsInSpanOnAt (n := n) N (· = fun z => ∏ i ∈ Finset.univ.filter (fun i => x ∈ E.get i),
        flatCoord Φ (σ i) z ^ divExpAlong n N 𝔞 (E.get i) x) x g := by
  have hgen := (monomialPartAlong_mem_iff hΦsrc hNflat hA hn hN hE hT h𝔞 hne hx hσk hσinj).self_of_nhds
  constructor
  · exact IsInSpanOnAt.trans fun f hf => ((hgen f).mp (le_monomialPartAlong hn hE hT h𝔞 x f hf)).2
  · refine IsInSpanOnAt.trans fun f hf => ?_
    rw [hf]
    refine hmono x hx _ ((hgen _).mpr ⟨holomorphicAt_generator _ _ (mem_flatDomain_self Φ), ?_⟩)
    exact isInSpanOnAt_eq_iff.mpr ⟨fun _ => 1, holomorphicAt_const 1,
      Eventually.of_forall fun z _ => (one_mul _).symm⟩

end Generator

/-! ### The factorization `Res_N 𝔞 = Res_N (𝓜_N 𝓝_N)` -/

section Factor

open NormalCrossings

variable {N : Set M} {𝔞 : GermIdeal n M} {E : List (Set M)}

/-- **Factorization of a germ of `𝔞` along `N`**: at `y ∈ N`, every `g ∈ 𝔞_y` is `m · c` on `N` near `y`, with `m` the
local generator of `𝓜_N(𝔞)` at `y` (in `𝓜_N(𝔞)_y` and in `(𝓘_{E_i}^{e_i(y)})_y` for the members through `y`) and
`c ∈ 𝓝_N(𝔞)_y`. -/
theorem exists_mem_nonmonomialPartAlong_mul (hn : 0 < n) (hN : IsClosedSubmanifold n N) (hE : IsSNCDivisor n E)
    (hT : IsTransverse n N E) (h𝔞 : 𝔞.IsCoherent) (hne : ∀ y ∈ N, IsNonzeroAlongAt N 𝔞 y) {y : M} (hyN : y ∈ N)
    {g : M → ℂ} (hg : 𝔞.mem y g) :
    ∃ m c, HolomorphicAt n m y ∧ (monomialPartAlong n N 𝔞 E).mem y m ∧
      (∀ i, y ∈ E.get i →
        (idealPow (vanishingIdeal (n := n) (E.get i)) (divExpAlong n N 𝔞 (E.get i) y)).mem y m) ∧
      (nonmonomialPartAlong n N 𝔞 E).mem y c ∧ ∀ᶠ z in 𝓝 y, z ∈ N → g z = m z * c z := by
  obtain ⟨m, hmh, hmI, hgen, -⟩ := exists_generator_monomialPartAlong hn hN hE hT h𝔞 hne hyN
  have hgen0 := hgen.self_of_nhds
  have hmM : (monomialPartAlong n N 𝔞 E).mem y m :=
    (hgen0 m).mpr ⟨hmh.self_of_nhds, isInSpanOnAt_eq_iff.mpr
      ⟨fun _ => 1, holomorphicAt_const 1, Eventually.of_forall fun z _ => (one_mul _).symm⟩⟩
  obtain ⟨-, hgm⟩ := (hgen0 g).mp (le_monomialPartAlong hn hE hT h𝔞 y g hg)
  obtain ⟨c, hc, hgc⟩ := isInSpanOnAt_eq_iff.mp hgm
  refine ⟨m, c, hmh.self_of_nhds, hmM, hmI, ⟨hc, fun g' hg' => ?_⟩, ?_⟩
  · obtain ⟨hg'h, hg'm⟩ := (hgen0 g').mp hg'
    obtain ⟨b, hb, hg'b⟩ := isInSpanOnAt_eq_iff.mp hg'm
    refine restrictOn_congr (restrictOn_mul_left hb (le_restrictOn h𝔞 y g hg)) (hg'h.mul hc) ?_
    filter_upwards [hgc, hg'b] with z h1 h2 hzN
    show g' z * c z = b z * g z
    rw [h2 hzN, h1 hzN]
    ring
  · filter_upwards [hgc] with z hz hzN
    rw [hz hzN, mul_comm]

/-- **`Res_N 𝔞 ⊆ Res_N (𝓜_N 𝓝_N)`** (`hir:monomial-part-along`). -/
theorem restrictLe_mul_along (hn : 0 < n) (hN : IsClosedSubmanifold n N) (hE : IsSNCDivisor n E)
    (hT : IsTransverse n N E) (h𝔞 : 𝔞.IsCoherent) (hne : ∀ y ∈ N, IsNonzeroAlongAt N 𝔞 y) :
    RestrictLe N 𝔞 ((monomialPartAlong n N 𝔞 E).mul (nonmonomialPartAlong n N 𝔞 E)) := by
  intro y hyN g hg
  obtain ⟨m, c, hmh, hmM, -, hcN, hgmc⟩ := exists_mem_nonmonomialPartAlong_mul hn hN hE hT h𝔞 hne hyN hg
  refine ⟨1, fun _ => m * c, fun _ => fun _ => 1, fun _ => ?_, fun _ => holomorphicAt_const 1, ?_⟩
  · exact InvertibleIdealQuotient.mem_mul_iff.mpr (isInSpanAt_of_eq_mul (s := m * c) ⟨m, c, hmM, hcN, rfl⟩
      (hmh.mul hcN.1) (holomorphicAt_const 1) (Eventually.of_forall fun z => (one_mul _).symm))
  · filter_upwards [hgmc] with z hz hzN
    simp [hz hzN]

/-- **`Res_N (𝓜_N 𝓝_N) ⊆ Res_N 𝔞`** (`RestrictedIdealQuotient.restrictLe_mul_colon'`). -/
theorem restrictLe_mul_along' (hN : IsClosedSubmanifold n N) (h𝔞 : 𝔞.IsCoherent) :
    RestrictLe N ((monomialPartAlong n N 𝔞 E).mul (nonmonomialPartAlong n N 𝔞 E)) 𝔞 :=
  restrictLe_mul_colon' h𝔞 (VanishingIdealCoherent.isCoherent_vanishingIdeal hN)

/-- **The nonmonomial part along `N` restricts into the ideal of no member** (`hir:monomial-part-along`): at a point
`y` of `N ∩ E_i`, some germ of `𝓝_N(𝔞)_y` does not restrict on `N` into `(𝓘_{E_i})|_N`. -/
theorem exists_mem_nonmonomialPartAlong_not (hn : 0 < n) (hN : IsClosedSubmanifold n N) (hE : IsSNCDivisor n E)
    (hT : IsTransverse n N E) (h𝔞 : 𝔞.IsCoherent) (hne : ∀ y ∈ N, IsNonzeroAlongAt N 𝔞 y) {y : M} (hyN : y ∈ N)
    {i : Fin E.length} (hyi : y ∈ E.get i) :
    ∃ h, (nonmonomialPartAlong n N 𝔞 E).mem y h ∧
      ¬ IsInSpanOnAt (n := n) N ((vanishingIdeal (n := n) (E.get i)).mem y) y h := by
  have hhol : ∀ x g, 𝔞.mem x g → HolomorphicAt n g x := fun _ _ hg =>
    GermIdeal.IsCoherent.holomorphicAt_mem h𝔞 hg
  obtain ⟨k, hk⟩ := hN.2 y hyN
  obtain ⟨r, hr⟩ := exists_isLocalRetraction hk
  set e := divExpAlong n N 𝔞 (E.get i) y
  have hnot := not_isDivNearAlong_divExpAlong_succ (H := E.get i) hr hyi (hne y hyN) hhol
  obtain ⟨g, hg, hgnot⟩ : ∃ g, 𝔞.mem y g ∧ ¬ ∃ h, (idealPow (vanishingIdeal (n := n) (E.get i)) (e + 1)).mem y h ∧
      ∀ᶠ z in 𝓝 y, z ∈ N → g z = h z := by
    by_contra! hall
    exact hnot (isDivNearAlong_of_forall_mem h𝔞 (A := E.get i) (fun _ _ hz => hz) hall)
  obtain ⟨m, c, hmh, -, hmI, hcN, hgmc⟩ := exists_mem_nonmonomialPartAlong_mul hn hN hE hT h𝔞 hne hyN hg
  refine ⟨c, hcN, fun hcI => hgnot ?_⟩
  obtain ⟨K, t, a, ht, ha, hsum⟩ := hcI
  refine ⟨fun z => ∑ k, a k z * (m z * t k z), mem_idealPow_sum _ fun k _ =>
    mul_mem_idealPow (ha k) (mul_mem_idealPow_succ (hmI i hyi) (ht k) (hmh.mul (ht k).1)), ?_⟩
  filter_upwards [hgmc, hsum] with z h1 h2 hzN
  rw [h1 hzN, h2 hzN, Finset.mul_sum]
  exact Finset.sum_congr rfl fun k _ => by ring

end Factor

/-! ### Coherence -/

section Coherence

open NormalCrossings IdealWeightComparison

variable {N : Set M} {𝔞 : GermIdeal n M} {E : List (Set M)}

/-- Off `N` the monomial part along `N` is every holomorphic germ. -/
theorem monomialPartAlong_mem_of_notMem {y : M} (hy : y ∉ N) {g : M → ℂ} :
    (monomialPartAlong n N 𝔞 E).mem y g ↔ HolomorphicAt n g y :=
  ⟨fun h => h.1, fun h => ⟨h, fun _ hyN => absurd hyN hy⟩⟩

/-- A holomorphic germ is in the span of the constant `1`. -/
theorem isInSpanAt_range_one_of_holomorphicAt {y : M} {g : M → ℂ} (hg : HolomorphicAt n g y) :
    IsInSpanAt (n := n) (· ∈ range fun _ : Fin 1 => (fun _ => (1 : ℂ) : M → ℂ)) y g :=
  isInSpanAt_of_eq_mul ⟨0, rfl⟩ hg hg (Eventually.of_forall fun _ => (mul_one _).symm)

/-- **The monomial part along `N` is coherent**: near a point of `N` it is generated by the local generator `m` and
generators of `𝓘_N`; off `N` by `1`. -/
theorem isCoherent_monomialPartAlong (hn : 0 < n) (hN : IsClosedSubmanifold n N) (hE : IsSNCDivisor n E)
    (hT : IsTransverse n N E) (h𝔞 : 𝔞.IsCoherent) (hne : ∀ y ∈ N, IsNonzeroAlongAt N 𝔞 y) :
    (monomialPartAlong n N 𝔞 E).IsCoherent := by
  intro x
  by_cases hxN : x ∈ N
  · obtain ⟨m, hmh, -, hgen, -⟩ := exists_generator_monomialPartAlong hn hN hE hT h𝔞 hne hxN
    obtain ⟨U₀, hU₀sub, hU₀o, hxU₀⟩ := eventually_nhds_iff.mp (hmh.and hgen)
    obtain ⟨U₃, hU₃o, hxU₃, P, w, hwdiff, hwgen⟩ := VanishingIdealCoherent.isCoherent_vanishingIdeal hN x
    refine ⟨U₀ ∩ U₃, hU₀o.inter hU₃o, ⟨hxU₀, hxU₃⟩, 1 + P,
      RestrictedIdealExtension.sumFamily (fun _ : Fin 1 => m) w, ?_, fun y hy g => ?_⟩
    · intro k
      refine Fin.addCases (fun j z hz => ?_) (fun j z hz => ?_) k
      · simpa [RestrictedIdealExtension.sumFamily] using
          ((hU₀sub z hz.1).1.mdifferentiableAt).mdifferentiableWithinAt
      · simpa [RestrictedIdealExtension.sumFamily] using (hwdiff j z hz.2).mono inter_subset_right
    obtain ⟨hy₀, hy₃⟩ := hy
    rw [(hU₀sub y hy₀).2 g]
    constructor
    · rintro ⟨hgh, hgm⟩
      obtain ⟨a, ha, hga⟩ := isInSpanOnAt_eq_iff.mp hgm
      have hmy : HolomorphicAt n m y := (hU₀sub y hy₀).1
      have hrem : (vanishingIdeal (n := n) N).mem y (fun z => g z - a z * m z) := by
        refine ⟨holomorphicAt_sub hgh (ha.mul hmy), ?_⟩
        filter_upwards [hga] with z hz hzN
        rw [hz hzN, sub_self]
      have h1 : IsInSpanAt (n := n) (· ∈ range (RestrictedIdealExtension.sumFamily (fun _ : Fin 1 => m) w)) y
          (fun z => g z - a z * m z) :=
        IsInSpanAt.mono (fun _ => RestrictedIdealExtension.range_right_subset_sumFamily)
          ((hwgen y hy₃ _).mp hrem)
      have h2 : IsInSpanAt (n := n) (· ∈ range (RestrictedIdealExtension.sumFamily (fun _ : Fin 1 => m) w)) y
          (fun z => a z * m z) :=
        isInSpanAt_of_eq_mul (RestrictedIdealExtension.range_left_subset_sumFamily ⟨0, rfl⟩) (ha.mul hmy) ha
          (Eventually.of_forall fun _ => rfl)
      exact isInSpanAt_congr (IsInSpanAt.add h1 h2) (Eventually.of_forall fun z => by ring)
    · intro hg
      refine ⟨hg.1, IsInSpanOnAt.trans (fun s hs => ?_) (IsInSpanAt.restrict hg)⟩
      rcases RestrictedIdealExtension.mem_range_sumFamily hs with ⟨_, rfl⟩ | ⟨j, rfl⟩
      · exact isInSpanOnAt_eq_iff.mpr ⟨fun _ => 1, holomorphicAt_const 1,
          Eventually.of_forall fun z _ => (one_mul _).symm⟩
      · have hwj := mem_of_isPresentation hU₃o hy₃ hwdiff hwgen j
        refine isInSpanOnAt_eq_iff.mpr ⟨fun _ => 0, holomorphicAt_const 0, ?_⟩
        filter_upwards [hwj.2] with z hz hzN
        rw [hz hzN, zero_mul]
  · refine ⟨Nᶜ, hN.1.isOpen_compl, hxN, 1, fun _ => fun _ => (1 : ℂ), fun _ => ?_, fun y hy g => ?_⟩
    · exact (contMDiff_const (n := ∞)).contMDiffOn.mdifferentiableOn (by simp)
    · rw [monomialPartAlong_mem_of_notMem hy]
      exact ⟨isInSpanAt_range_one_of_holomorphicAt, fun h => h.1⟩

/-- **The nonmonomial part along `N` is coherent**: near a point of `N` it is generated by the quotients `t_k` of
generators `s_k = m t_k` (on `N`) of `𝔞` by the local generator `m`, together with generators of `𝓘_N`; off `N` by
`1`.  The inclusion that needs an argument cancels `m` along `N`
(`RestrictedIdealQuotient.eventuallyEq_within_of_mul_eventuallyEq_within`). -/
theorem isCoherent_nonmonomialPartAlong (hn : 0 < n) (hN : IsClosedSubmanifold n N) (hE : IsSNCDivisor n E)
    (hT : IsTransverse n N E) (h𝔞 : 𝔞.IsCoherent) (hne : ∀ y ∈ N, IsNonzeroAlongAt N 𝔞 y) :
    (nonmonomialPartAlong n N 𝔞 E).IsCoherent := by
  have h𝓜 := isCoherent_monomialPartAlong hn hN hE hT h𝔞 hne
  intro x
  by_cases hxN : x ∈ N
  · obtain ⟨m, hmh, -, hgen, hmne⟩ := exists_generator_monomialPartAlong hn hN hE hT h𝔞 hne hxN
    obtain ⟨U₁, hU₁o, hxU₁, K, s, hsdiff, hsgen⟩ := h𝔞 x
    obtain ⟨U₃, hU₃o, hxU₃, P, w, hwdiff, hwgen⟩ := VanishingIdealCoherent.isCoherent_vanishingIdeal hN x
    have hsmem : ∀ k, ∀ z ∈ U₁, 𝔞.mem z (s k) := fun k z hz => mem_of_isPresentation hU₁o hz hsdiff hsgen k
    -- the quotients `t_k` of the generators by `m`, on `N`
    have hdiv : ∀ k, ∃ t, HolomorphicAt n t x ∧ ∀ᶠ z in 𝓝 x, z ∈ N → s k z = t z * m z := fun k =>
      isInSpanOnAt_eq_iff.mp ((hgen.self_of_nhds (s k)).mp
        (le_monomialPartAlong hn hE hT h𝔞 x (s k) (hsmem k x hxU₁))).2
    choose t ht hst using hdiv
    have hev : ∀ᶠ z in 𝓝 x, z ∈ U₁ ∧ z ∈ U₃ ∧ HolomorphicAt n m z ∧
        (∀ g, (monomialPartAlong n N 𝔞 E).mem z g ↔ HolomorphicAt n g z ∧ IsInSpanOnAt (n := n) N (· = m) z g) ∧
        (z ∈ N → ∃ᶠ y in 𝓝 z, y ∈ N ∧ m y ≠ 0) ∧
        ∀ k, HolomorphicAt n (t k) z ∧ ∀ᶠ y in 𝓝 z, y ∈ N → s k y = t k y * m y := by
      have h1 : ∀ᶠ z in 𝓝 x, z ∈ U₁ := hU₁o.mem_nhds hxU₁
      have h3 : ∀ᶠ z in 𝓝 x, z ∈ U₃ := hU₃o.mem_nhds hxU₃
      filter_upwards [h1, h3, hmh, hgen, hmne, eventually_all.mpr fun k => (ht k).eventually_nhds,
        eventually_all.mpr fun k => (hst k).eventually_nhds] with z hz1 hz3 hzm hzg hzne hzt hzst
      exact ⟨hz1, hz3, hzm, hzg, hzne, fun k => ⟨hzt k, hzst k⟩⟩
    obtain ⟨V, hVsub, hVo, hxV⟩ := eventually_nhds_iff.mp hev
    refine ⟨V, hVo, hxV, K + P, RestrictedIdealExtension.sumFamily t w, ?_, fun y hy h => ?_⟩
    · intro k
      refine Fin.addCases (fun j z hz => ?_) (fun j z hz => ?_) k
      · simpa [RestrictedIdealExtension.sumFamily] using
          (((hVsub z hz).2.2.2.2.2 j).1.mdifferentiableAt).mdifferentiableWithinAt
      · simpa [RestrictedIdealExtension.sumFamily] using
          ((hwdiff j z (hVsub z hz).2.1).mdifferentiableAt (hU₃o.mem_nhds (hVsub z hz).2.1)).mdifferentiableWithinAt
    obtain ⟨hy₁, hy₃, hmy, hgeny, hmney, hty⟩ := hVsub y hy
    have hmM : (monomialPartAlong n N 𝔞 E).mem y m := (hgeny m).mpr ⟨hmy, isInSpanOnAt_eq_iff.mpr
      ⟨fun _ => 1, holomorphicAt_const 1, Eventually.of_forall fun z _ => (one_mul _).symm⟩⟩
    -- the generators lie in `𝓝_N`
    have htmem : ∀ k, (nonmonomialPartAlong n N 𝔞 E).mem y (t k) := by
      intro k
      refine ⟨(hty k).1, fun g' hg' => ?_⟩
      obtain ⟨hg'h, hg'm⟩ := (hgeny g').mp hg'
      obtain ⟨b, hb, hg'b⟩ := isInSpanOnAt_eq_iff.mp hg'm
      refine restrictOn_congr (restrictOn_mul_left hb (le_restrictOn h𝔞 y (s k) (hsmem k y hy₁)))
        (hg'h.mul (hty k).1) ?_
      filter_upwards [(hty k).2, hg'b] with z h1 h2 hzN
      show g' z * t k z = b z * s k z
      rw [h2 hzN, h1 hzN]
      ring
    have hwmem : ∀ j, (nonmonomialPartAlong n N 𝔞 E).mem y (w j) := by
      intro j
      have hwj := mem_of_isPresentation hU₃o hy₃ hwdiff hwgen j
      refine ⟨hwj.1, fun g' hg' => vanishingIdeal_le_restrictOn y _ ⟨hg'.1.mul hwj.1, ?_⟩⟩
      filter_upwards [hwj.2] with z hz hzN
      rw [hz hzN, mul_zero]
    constructor
    · intro hh
      obtain ⟨hhh, hhm⟩ := hh
      -- `m h` restricts into the span of the generators `s_k`
      have hmh' : IsInSpanOnAt (n := n) N (· ∈ range s) y (fun z => m z * h z) :=
        IsInSpanOnAt.trans (fun f hf => IsInSpanAt.restrict ((hsgen y hy₁ f).mp hf)) (hhm m hmM).2
      obtain ⟨K', r, a, hr, ha, hsum⟩ := hmh'
      choose ρ hρ using hr
      set τ : M → ℂ := fun z => ∑ j, a j z * t (ρ j) z
      have hτ : HolomorphicAt n τ y := HolomorphicAt.sum _ fun j _ => (ha j).mul (hty (ρ j)).1
      -- `m h = m τ` on `N`, cancel `m`
      have hcan : ∀ᶠ z in 𝓝 y, z ∈ N → h z = τ z := by
        refine eventuallyEq_within_of_mul_eventuallyEq_within (W := N) hVo (h := m) ?_ hy hhh hτ ?_
        · intro V' hV'o hV'sub ⟨z₀, hz₀V', hz₀N⟩
          obtain ⟨-, -, -, -, hz₀ne, -⟩ := hVsub z₀ (hV'sub hz₀V')
          obtain ⟨z, ⟨hzN, hzm⟩, hzV'⟩ := ((hz₀ne hz₀N).and_eventually (hV'o.mem_nhds hz₀V')).exists
          exact ⟨z, ⟨hzV', hzN⟩, hzm⟩
        · filter_upwards [hsum, eventually_all.mpr fun j => (hty (ρ j)).2] with z hz hz' hzN
          rw [hz hzN, Finset.mul_sum]
          refine Finset.sum_congr rfl fun j _ => ?_
          rw [← hρ j, hz' j hzN]
          ring
      have hrem : (vanishingIdeal (n := n) N).mem y (fun z => h z - τ z) := by
        refine ⟨holomorphicAt_sub hhh hτ, ?_⟩
        filter_upwards [hcan] with z hz hzN
        rw [hz hzN, sub_self]
      have h1 : IsInSpanAt (n := n) (· ∈ range (RestrictedIdealExtension.sumFamily t w)) y
          (fun z => h z - τ z) :=
        IsInSpanAt.mono (fun _ => RestrictedIdealExtension.range_right_subset_sumFamily)
          ((hwgen y hy₃ _).mp hrem)
      have h2 : IsInSpanAt (n := n) (· ∈ range (RestrictedIdealExtension.sumFamily t w)) y τ :=
        ⟨hτ, K', fun j => t (ρ j), a,
          fun j => RestrictedIdealExtension.range_left_subset_sumFamily ⟨ρ j, rfl⟩, ha,
          Eventually.of_forall fun _ => rfl⟩
      exact isInSpanAt_congr (IsInSpanAt.add h1 h2) (Eventually.of_forall fun z => by ring)
    · intro hh
      refine mem_colonAlong_of_isInSpanAt h𝓜 (IsInSpanAt.mono (fun f hf => ?_) hh)
      rcases RestrictedIdealExtension.mem_range_sumFamily hf with ⟨k, rfl⟩ | ⟨j, rfl⟩
      · exact htmem k
      · exact hwmem j
  · refine ⟨Nᶜ, hN.1.isOpen_compl, hxN, 1, fun _ => fun _ => (1 : ℂ), fun _ => ?_, fun y hy h => ?_⟩
    · exact (contMDiff_const (n := ∞)).contMDiffOn.mdifferentiableOn (by simp)
    · refine ⟨fun hh => isInSpanAt_range_one_of_holomorphicAt hh.1, fun hh => ⟨hh.1, fun g' hg' => ?_⟩⟩
      exact restrictOn_eq_top_of_disjoint hN.1.isOpen_compl hy (compl_inter_self N)
        ((monomialPartAlong_mem_of_notMem hy).mp hg' |>.mul hh.1)

end Coherence

end

