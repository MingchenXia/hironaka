/-!
# The invariant of a monomial marked ideal along a submanifold at one stage

Let `N` be a closed submanifold, `E` a simple normal crossings divisor transverse to `N` (`n > 0`), `𝔞` coherent
with `𝔞|_N` nonzero near every point of `N`. The exponents along `N` are `expDataAlong 𝔞 N E x i = divExpAlong 𝔞 N
E_i x` (`DivisorExponentAlong`), and the invariant is `gammaAlong N 𝔞 E d x = MonomialInvariant.inv n (memberIdx E
x) (expDataAlong N 𝔞 E x) d`.

* `eventually_gammaAlong_le` (**upper semicontinuity on `N`**), `eventually_gammaAlong_eq_iff_mem_memberInter` (near a point
  of `N` of value `v`, the points of `N` of value `v` are those on the members of the top set);
* `mem_cosupport_iff_of_isMonomialAlong` (**the cosupport of a monomial ideal along `N`**): for `𝔞` monomial along `N`
  (`MonomialPartAlong.IsMonomialAlong`) and `x ∈ N`, `x ∈ cosupp(𝔞|_N, d) ↔ d ≤ ∑_{x ∈ E_i} e_i(x)`; the generator
  `m = ∏ w_{σ i}^{e_i(x)}` of the monomial part has order `∑ e_i(x)` along `N` (the flat retraction does not change it);
* `isAdmissibleCentre_maxLocus_gammaAlong` (**the maximum locus is an admissible centre**): for a monomial marked
  ideal `(M, N, E, 𝔞, d)` the maximum locus of `gammaAlong` on the cosupport is, near each of its points, `N ∩ ⋂_{i
  ∈ I} E_i` (`MemberInterAlong`), with empty interior when `d ≥ 1`
* **principal monomial ideals along `N`** (the consumer side of `MonomialBlowupAlongChart`): if the restriction of
  `𝔞_x` to `N` is generated by `∏_{i ∈ T} u_{σ i}^{a_i}` in coordinates adapted to `N` and `E`, then the same holds
  near `x` (`eventually_isInSpanOnAt_iff_of_isCoherent`), `𝔞|_N` is nonzero near `x`
  (`isNonzeroAlongAt_of_principal`), the exponents along `N` are the `a_i` (`divExpAlong_eq_of_principal`), and the
  invariant is read off them (`gammaAlong_eq_of_principal`); `IsPrincipalMonomialAlongAt` packages the output form
  of `MonomialBlowupAlongChart.exists_snc_chart_geoTransform_along`, and
  `isNonzeroAlongAt_and_isMonomialAlong_of_principal` turns it, at every point of `N`, into the hypotheses of the
  next stage (nonvanishing along `N`, monomial along `N`).
-/

open Set Filter Finset
open scoped Topology Manifold

namespace Hironaka.MonomialCaseAlong

open Hironaka.HolomorphicIdealSheaves Hironaka.BlowupSequences
open Hironaka.IdealWeightPowers Hironaka.GermIdealOrder Hironaka.OrderTaylor Hironaka.HadamardBridge Hironaka.BlowupFlatCoordinates Hironaka.GiraudAlong Hironaka.DivisorExponent Hironaka.DivisorExponentAlong Hironaka.GermOrderProduct Hironaka.MemberPullback Hironaka.MonomialPart Hironaka.MonomialPartAlong Hironaka.NormalCrossings Hironaka.MonomialInvariant Hironaka.BoundaryCount Hironaka.RegularPointDimension Hironaka.MarkedIdeals Hironaka.MarkedIdeals.MarkedIdeal Hironaka.MonomialCase Hironaka.IdealOrderArithmetic Hironaka.RelativePrincipalizationSpan

noncomputable section

variable {n : ℕ} {M : Type*} [TopologicalSpace M] [ChartedSpace (ComplexModel n) M]
  [IsComplexManifold n M]

/-! ### Exponent data along `N` and the invariant -/

section Gamma

variable (n) in
/-- The exponents along `N` of `𝔞` along the members of `E` at `x` (`0` beyond the length of `E`). -/
def expDataAlong (N : Set M) (𝔞 : GermIdeal n M) (E : List (Set M)) (x : M) (i : ℕ) : ℕ :=
  if h : i < E.length then divExpAlong n N 𝔞 (E.get ⟨i, h⟩) x else 0

variable (n) in
/-- **The invariant of a monomial marked ideal along `N`** at `x`. -/
def gammaAlong (N : Set M) (𝔞 : GermIdeal n M) (E : List (Set M)) (d : ℕ) (x : M) : WithBot Val :=
  inv n (memberIdx E x) (expDataAlong n N 𝔞 E x) d

variable {N : Set M} {𝔞 : GermIdeal n M} {E : List (Set M)}

/-- **Near `x ∈ N`, the members through a point `y ∈ N` carry the exponents along `N` they have at `x`.** -/
theorem eventually_expDataAlong_eq (hn : 0 < n) (hN : IsClosedSubmanifold n N) (hE : IsSNCDivisor n E)
    (hT : IsTransverse n N E) (h𝔞 : 𝔞.IsCoherent) (hne : ∀ y ∈ N, IsNonzeroAlongAt N 𝔞 y) {x : M} (hx : x ∈ N) :
    ∀ᶠ y in 𝓝 x, y ∈ N → ∀ i ∈ memberIdx E y, expDataAlong n N 𝔞 E y i = expDataAlong n N 𝔞 E x i := by
  have h : ∀ᶠ y in 𝓝 x, ∀ i : Fin E.length, y ∈ N → y ∈ E.get i →
      divExpAlong n N 𝔞 (E.get i) y = divExpAlong n N 𝔞 (E.get i) x := by
    refine eventually_all.mpr fun i => ?_
    by_cases hxi : x ∈ E.get i
    · exact eventually_divExpAlong_get_eq hn hN hE hT h𝔞 hne i hx hxi
    · filter_upwards [(hE.1 _ (List.get_mem E i)).isOpen_compl.mem_nhds hxi] with y hy _ hyi
      exact absurd hyi hy
  filter_upwards [h] with y hy hyN i hi
  obtain ⟨hlt, hyi⟩ := (mem_memberIdx E).mp hi
  simp only [expDataAlong, dif_pos hlt]
  exact hy ⟨i, hlt⟩ hyN hyi

/-- **Upper semicontinuity of the invariant on `N`** (`hir:monomial-case` (1) along `N`). -/
theorem eventually_gammaAlong_le (hn : 0 < n) (hN : IsClosedSubmanifold n N) (hE : IsSNCDivisor n E)
    (hT : IsTransverse n N E) (h𝔞 : 𝔞.IsCoherent) (hne : ∀ y ∈ N, IsNonzeroAlongAt N 𝔞 y) (d : ℕ) {x : M}
    (hx : x ∈ N) : ∀ᶠ y in 𝓝 x, y ∈ N → gammaAlong n N 𝔞 E d y ≤ gammaAlong n N 𝔞 E d x := by
  filter_upwards [eventually_memberIdx_subset E hE.1 x, eventually_expDataAlong_eq hn hN hE hT h𝔞 hne hx]
    with y hsub hexp hyN
  unfold gammaAlong
  rw [inv_congr (hexp hyN)]
  exact inv_mono hsub

/-- **The locus of the value of `x` near `x` on `N`** is cut out by the members of a top set of `x`. -/
theorem eventually_gammaAlong_eq_iff (hn : 0 < n) (hN : IsClosedSubmanifold n N) (hE : IsSNCDivisor n E)
    (hT : IsTransverse n N E) (h𝔞 : 𝔞.IsCoherent) (hne : ∀ y ∈ N, IsNonzeroAlongAt N 𝔞 y) {d : ℕ} {x : M}
    (hx : x ∈ N) {I : Finset ℕ} (hI : I ∈ feasible (memberIdx E x) (expDataAlong n N 𝔞 E x) d)
    (htop : ∀ K ∈ feasible (memberIdx E x) (expDataAlong n N 𝔞 E x) d,
      key n (expDataAlong n N 𝔞 E x) K ≤ key n (expDataAlong n N 𝔞 E x) I) :
    ∀ᶠ y in 𝓝 x, y ∈ N → (gammaAlong n N 𝔞 E d y = gammaAlong n N 𝔞 E d x ↔ I ⊆ memberIdx E y) := by
  filter_upwards [eventually_memberIdx_subset E hE.1 x, eventually_expDataAlong_eq hn hN hE hT h𝔞 hne hx]
    with y hsub hexp hyN
  unfold gammaAlong
  rw [inv_congr (hexp hyN)]
  exact inv_eq_iff_subset hsub hI htop

end Gamma

/-! ### The cosupport of a monomial ideal along `N` -/

section Cosupport

open BlowupSNCTransform

variable {N : Set M} {𝔞 : GermIdeal n M} {E : List (Set M)}

open Classical in
/-- **The cosupport of a monomial ideal along `N`** (`hir:monomial-case` (1) along `N`): if `𝔞` is monomial along `N`,
then for `x ∈ N`, `x ∈ cosupp(𝔞|_N, d)` iff the exponents along `N` of the members through `x` add up to at least `d`.
The generator `m` of the monomial part has order `∑ e_i(x)` along `N`: the flat retraction does not change it, and its
ambient order is `MonomialCase.prod_flatCoord_pow_order`. -/
theorem mem_cosupport_iff_of_isMonomialAlong (hn : 0 < n) (hN : IsClosedSubmanifold n N) (hE : IsSNCDivisor n E)
    (hT : IsTransverse n N E) (h𝔞 : 𝔞.IsCoherent) (hne : ∀ y ∈ N, IsNonzeroAlongAt N 𝔞 y)
    (hmono : IsMonomialAlong n N 𝔞 E) (d : ℕ) {x : M} (hx : x ∈ N) :
    x ∈ cosupport n N 𝔞 d ↔ d ≤ ∑ i ∈ memberIdx E x, expDataAlong n N 𝔞 E x i := by
  obtain ⟨kC, kN, Φ, σ, hΦsrc, hσk, hσinj, hflat⟩ :=
    SimultaneousNormalCrossings.isAdaptedAt_of_hasNormalCrossings hn subset_rfl hE hT hT.hasNormalCrossings hx
  have hNflat : ∀ {z : M}, z ∈ (chartAt (ComplexModel n) x).source → chartAt (ComplexModel n) x z ∈ Φ.source →
      (z ∈ N ↔ Φ.toFun (chartAt (ComplexModel n) x z) ∈ complexCoordinatePlane n kN) :=
    fun hz1 hz2 => (hflat hz1 hz2).2.1
  have hA : ∀ i, x ∈ E.get i → ∀ {z : M}, z ∈ (chartAt (ComplexModel n) x).source →
      chartAt (ComplexModel n) x z ∈ Φ.source →
        (z ∈ E.get i ↔ Φ.toFun (chartAt (ComplexModel n) x z) (σ i) = 0) :=
    fun i hi _ hz1 hz2 => (hflat hz1 hz2).2.2 i hi
  set T : Finset (Fin E.length) := Finset.univ.filter fun i => x ∈ E.get i with hT_def
  set e : Fin E.length → ℕ := fun i => divExpAlong n N 𝔞 (E.get i) x with he_def
  set m : M → ℂ := fun z => ∏ i ∈ T, flatCoord Φ (σ i) z ^ e i with hm_def
  have hxD : x ∈ flatDomain Φ := mem_flatDomain_self Φ
  have hsum : ∑ i ∈ memberIdx E x, expDataAlong n N 𝔞 E x i = ∑ i ∈ T, e i := by
    rw [memberIdx, Finset.sum_map]
    refine Finset.sum_congr rfl fun i _ => ?_
    simp only [Fin.valEmbedding_apply, expDataAlong, dif_pos i.2, Fin.eta]
    rfl
  rw [hsum]
  have hzero : ∀ i ∈ T, flatCoord Φ (σ i) x = 0 := fun i hi =>
    (hA i (Finset.mem_filter.mp hi).2 hxD.1 hxD.2).mp (Finset.mem_filter.mp hi).2
  obtain ⟨hmem, hnotmem⟩ := prod_flatCoord_pow_order Φ σ e hxD T hzero
  have hgen := (monomialPartAlong_mem_iff hΦsrc hNflat hA hn hN hE hT h𝔞 hne hx hσk hσinj).self_of_nhds
  -- the order of `m` along `N` is its ambient order
  have hr : IsLocalRetraction n N (flatRetract Φ kN) x := isLocalRetraction_flatRetract hΦsrc hNflat hxD hx
  have hmr : m ∘ flatRetract Φ kN =ᶠ[𝓝 x] m := by
    have h := (eventually_all_finset T).mpr fun i hi =>
      eventually_flatMap_flatRetract hΦsrc hNflat hxD hx (hσk i (Finset.mem_filter.mp hi).2)
    filter_upwards [h] with z hz
    simp only [Function.comp, hm_def]
    exact Finset.prod_congr rfl fun i hi => by rw [show flatCoord Φ (σ i) (flatRetract Φ kN z) =
      flatMap Φ (flatRetract Φ kN z) (σ i) from rfl, (hz i hi).2]; rfl
  have hord : ∀ q, VanishesToOrderOn n N x q m ↔ (idealPow (pointIdeal n x) q).mem x m := fun q =>
    hr.vanishesToOrderOn_iff.trans ⟨fun h => mem_idealPow_congr h hmr, fun h => mem_idealPow_congr h hmr.symm⟩
  have hmh : HolomorphicAt n m x := holomorphicAt_generator T e hxD
  constructor
  · intro hxc
    by_contra hlt
    push Not at hlt
    have hmM : (monomialPartAlong n N 𝔞 E).mem x m :=
      (hgen m).mpr ⟨hmh, isInSpanOnAt_eq_iff.mpr ⟨fun _ => 1, holomorphicAt_const 1,
        Eventually.of_forall fun z _ => (one_mul _).symm⟩⟩
    obtain ⟨K, s, a, hs, ha, hsum'⟩ := hmono x hx m hmM
    obtain ⟨h, hh, hsh⟩ := vanishesToOrderOn_sum_mul (N := N) ha fun k => hxc.2 (s k) (hs k)
    have hmd : VanishesToOrderOn n N x d m := ⟨h, hh, by
      filter_upwards [hsum', hsh] with z h1 h2 hzN
      rw [h1 hzN, h2 hzN]⟩
    exact hnotmem (idealPow_le_of_le (fun _ _ hg => holomorphicAt_of_mem_pointIdeal hg) (by omega) x _
      ((hord d).mp hmd))
  · intro hle
    refine ⟨hx, fun g hg => ?_⟩
    obtain ⟨-, hgm⟩ := (hgen g).mp (le_monomialPartAlong hn hE hT h𝔞 x g hg)
    obtain ⟨c, hc, hgc⟩ := isInSpanOnAt_eq_iff.mp hgm
    exact ⟨fun z => c z * m z, idealPow_le_of_le (fun _ _ hg => holomorphicAt_of_mem_pointIdeal hg) hle x _
      (mul_mem_idealPow hc hmem), hgc⟩

/-- **The invariant vanishes exactly off the cosupport** at the points of `N`, for a monomial ideal along `N`. -/
theorem gammaAlong_eq_bot_iff_of_isMonomialAlong (hn : 0 < n) (hN : IsClosedSubmanifold n N)
    (hE : IsSNCDivisor n E) (hT : IsTransverse n N E) (h𝔞 : 𝔞.IsCoherent) (hne : ∀ y ∈ N, IsNonzeroAlongAt N 𝔞 y)
    (hmono : IsMonomialAlong n N 𝔞 E) (d : ℕ) {x : M} (hx : x ∈ N) :
    gammaAlong n N 𝔞 E d x = ⊥ ↔ x ∉ cosupport n N 𝔞 d := by
  rw [gammaAlong, inv_eq_bot_iff, mem_cosupport_iff_of_isMonomialAlong hn hN hE hT h𝔞 hne hmono d hx, not_le]

end Cosupport

/-! ### The maximum locus -/

section MaxLocus

variable {N : Set M} {𝔞 : GermIdeal n M} {E : List (Set M)} {d : ℕ}

/-- At a point of value `v`, the top set `topSet v` is feasible and dominates every feasible set. -/
theorem top_of_gammaAlong_eq {x : M} {v : Val} (hx : gammaAlong n N 𝔞 E d x = v) :
    topSet v ∈ feasible (memberIdx E x) (expDataAlong n N 𝔞 E x) d ∧
      ∀ K ∈ feasible (memberIdx E x) (expDataAlong n N 𝔞 E x) d,
        key n (expDataAlong n N 𝔞 E x) K ≤ key n (expDataAlong n N 𝔞 E x) (topSet v) := by
  have hne : inv n (memberIdx E x) (expDataAlong n N 𝔞 E x) d ≠ ⊥ := by
    change gammaAlong n N 𝔞 E d x ≠ ⊥
    rw [hx]
    exact WithBot.coe_ne_bot
  rw [Ne, inv_eq_bot_iff, not_lt] at hne
  obtain ⟨I, hI, hinv, htop⟩ := exists_top (n := n) hne
  have hv : ((key n (expDataAlong n N 𝔞 E x) I : Val) : WithBot Val) = v := by
    rw [← hinv]
    exact hx
  rw [← WithBot.coe_inj.mp hv, topSet_key]
  exact ⟨hI, htop⟩

variable (hn : 0 < n) (hN : IsClosedSubmanifold n N) (hE : IsSNCDivisor n E) (hT : IsTransverse n N E)
  (h𝔞 : 𝔞.IsCoherent) (hne : ∀ y ∈ N, IsNonzeroAlongAt N 𝔞 y)

include hn hN hE hT h𝔞 hne in
/-- **The locus of a value near a point of `N` of that value**: near `x`, a point of `N` has value `v` iff it lies on the
members of the top set of `v`. -/
theorem eventually_gammaAlong_eq_iff_mem_memberInter {x : M} (hx : x ∈ N) {v : Val}
    (hxv : gammaAlong n N 𝔞 E d x = v) :
    ∀ᶠ y in 𝓝 x, y ∈ N → (gammaAlong n N 𝔞 E d y = v ↔ y ∈ memberInter E (topIdx E v)) := by
  obtain ⟨hI, htop⟩ := top_of_gammaAlong_eq hxv
  have hlt : ∀ i ∈ topSet v, i < E.length := fun i hi =>
    ((mem_memberIdx E).mp ((mem_feasible.mp hI).1 hi)).1
  filter_upwards [eventually_gammaAlong_eq_iff hn hN hE hT h𝔞 hne hx hI htop] with y hy hyN
  rw [← hxv, hy hyN, mem_memberInter_topIdx_iff hlt]

include hn hN hE hT h𝔞 hne in
/-- The points of `N` of value `v` lie on the members of the top set of `v`. -/
theorem mem_memberInter_of_gammaAlong_eq {x : M} (hx : x ∈ N) {v : Val} (hxv : gammaAlong n N 𝔞 E d x = v) :
    x ∈ memberInter E (topIdx E v) :=
  ((eventually_gammaAlong_eq_iff_mem_memberInter hn hN hE hT h𝔞 hne hx hxv).self_of_nhds hx).mp hxv

include hn hN hE hT h𝔞 hne in
/-- If `v` bounds the invariant on `N`, the points of `N` of value `v` form a closed set. -/
theorem isClosed_gammaAlong_eq {v : WithBot Val} (hmax : ∀ y ∈ N, gammaAlong n N 𝔞 E d y ≤ v) :
    IsClosed {y | y ∈ N ∧ gammaAlong n N 𝔞 E d y = v} := by
  refine isClosed_iff_frequently.mpr fun x hx => ?_
  have hxN : x ∈ N := by
    by_contra hxN
    obtain ⟨y, ⟨hyN, -⟩, hyN'⟩ := (hx.and_eventually (hN.1.isOpen_compl.mem_nhds hxN)).exists
    exact hyN' hyN
  obtain ⟨y, ⟨hyN, hy⟩, hyle⟩ := (hx.and_eventually (eventually_gammaAlong_le hn hN hE hT h𝔞 hne d hxN)).exists
  have hyle' := hyle hyN
  rw [hy] at hyle'
  exact ⟨hxN, le_antisymm (hmax x hxN) hyle'⟩

include hn hN hE hT h𝔞 hne in
/-- **The locus of a maximal value is an admissible centre** (`hir:monomial-case` (1) along `N`): if `v` bounds the
invariant on `N` of a monomial ideal along `N`, the points of `N` of value `v` form a closed submanifold inside the
cosupport with only normal crossings with `E` (near each of its points it is `N ∩ ⋂_{i ∈ I} E_i`, `I` the top set of
`v`, `MemberInterAlong`). -/
theorem isAdmissibleCentre_gammaAlong_eq (𝔪 : MarkedIdeal n M) (h𝔪N : 𝔪.N = N) (h𝔪E : 𝔪.E = E)
    (h𝔪a : 𝔪.ideal = 𝔞) (h𝔪d : 𝔪.d = d) (hmono : IsMonomialAlong n N 𝔞 E) {v : Val}
    (hmax : ∀ y ∈ N, gammaAlong n N 𝔞 E d y ≤ v) :
    𝔪.IsAdmissibleCentre {y | y ∈ N ∧ gammaAlong n N 𝔞 E d y = v} := by
  subst h𝔪N h𝔪E h𝔪a h𝔪d
  have hloc : ∀ x ∈ 𝔪.N, gammaAlong n 𝔪.N 𝔪.ideal 𝔪.E 𝔪.d x = v → ∃ W : Set M, IsOpen W ∧ x ∈ W ∧
      (𝔪.N ∩ memberInter 𝔪.E (topIdx 𝔪.E v)) ∩ W =
        {y | y ∈ 𝔪.N ∧ gammaAlong n 𝔪.N 𝔪.ideal 𝔪.E 𝔪.d y = v} ∩ W := by
    intro x hxN hx
    obtain ⟨W, hWsub, hWo, hxW⟩ :=
      mem_nhds_iff.mp (eventually_gammaAlong_eq_iff_mem_memberInter hn hN hE hT h𝔞 hne hxN hx)
    refine ⟨W, hWo, hxW, ?_⟩
    ext y
    exact ⟨fun hy => ⟨⟨hy.1.1, (hWsub hy.2 hy.1.1).mpr hy.1.2⟩, hy.2⟩,
      fun hy => ⟨⟨hy.1.1, (hWsub hy.2 hy.1.1).mp hy.1.2⟩, hy.2⟩⟩
  refine ⟨⟨isClosed_gammaAlong_eq hn hN hE hT h𝔞 hne hmax, fun x hx => ?_⟩, fun x hx => ?_, fun x hx => ?_⟩
  · obtain ⟨k, hk⟩ := (MemberInterAlong.isClosedSubmanifold_inter_memberInter hn hN.1 hE hT (topIdx 𝔪.E v)).2 x
      ⟨hx.1, mem_memberInter_of_gammaAlong_eq hn hN hE hT h𝔞 hne hx.1 hx.2⟩
    obtain ⟨W, hWo, hxW, hW⟩ := hloc x hx.1 hx.2
    exact ⟨k, regularAtDim_of_inter_eq hWo hxW hW hk⟩
  · by_contra hc
    have h' := (gammaAlong_eq_bot_iff_of_isMonomialAlong hn hN hE hT h𝔞 hne hmono 𝔪.d hx.1).mpr hc
    rw [hx.2] at h'
    exact WithBot.coe_ne_bot h'
  · obtain ⟨S₀, S, hfam, hcard⟩ := MemberInterAlong.hasNormalCrossings_inter_memberInter hT (topIdx 𝔪.E v) x
      ⟨hx.1, mem_memberInter_of_gammaAlong_eq hn hN hE hT h𝔞 hne hx.1 hx.2⟩
    obtain ⟨W, hWo, hxW, hW⟩ := hloc x hx.1 hx.2
    refine ⟨S₀, S, isCoordinateFamilyAt_of_inter_eq hWo hxW (fun o => ?_) hfam, hcard⟩
    cases o with
    | none => exact hW
    | some i => rfl

include hn hN hE hT h𝔞 hne in
/-- **The maximum locus of the invariant on the cosupport** (`hir:monomial-case` (1) along `N`, in the form of the
resolution driver): for a monomial marked ideal `(M, N, E, 𝔞, d)` it is an admissible centre, with empty interior when
`d ≥ 1`. -/
theorem isAdmissibleCentre_maxLocus_gammaAlong (𝔪 : MarkedIdeal n M) (h𝔪N : 𝔪.N = N) (h𝔪E : 𝔪.E = E)
    (h𝔪a : 𝔪.ideal = 𝔞) (hmono : IsMonomialAlong n N 𝔞 E) :
    𝔪.IsAdmissibleCentre (ResolutionDriver.maxLocus (gammaAlong n N 𝔞 E 𝔪.d) 𝔪.cosupp) ∧
      (1 ≤ 𝔪.d → interior (ResolutionDriver.maxLocus (gammaAlong n N 𝔞 E 𝔪.d) 𝔪.cosupp) = ∅) := by
  have hcs : 𝔪.cosupp = cosupport n N 𝔞 𝔪.d := by
    change cosupport n 𝔪.N 𝔪.ideal 𝔪.d = _
    rw [h𝔪N, h𝔪a]
  rcases (ResolutionDriver.maxLocus (gammaAlong n N 𝔞 E 𝔪.d) 𝔪.cosupp).eq_empty_or_nonempty with h | ⟨x₀, hx₀⟩
  · rw [h]
    exact ⟨isAdmissibleCentre_empty 𝔪, fun _ => interior_empty⟩
  have hx₀c : x₀ ∈ cosupport n N 𝔞 𝔪.d := hcs ▸ hx₀.1
  have hx₀N : x₀ ∈ N := hx₀c.1
  have hne₀ : gammaAlong n N 𝔞 E 𝔪.d x₀ ≠ ⊥ := fun h =>
    (gammaAlong_eq_bot_iff_of_isMonomialAlong hn hN hE hT h𝔞 hne hmono 𝔪.d hx₀N).mp h hx₀c
  obtain ⟨v, hv⟩ := WithBot.ne_bot_iff_exists.mp hne₀
  have hmax : ∀ y ∈ N, gammaAlong n N 𝔞 E 𝔪.d y ≤ v := by
    intro y hyN
    by_cases hy : y ∈ 𝔪.cosupp
    · rw [hv]
      exact hx₀.2 y hy
    · have h' : gammaAlong n N 𝔞 E 𝔪.d y = ⊥ :=
        (gammaAlong_eq_bot_iff_of_isMonomialAlong hn hN hE hT h𝔞 hne hmono 𝔪.d hyN).mpr (hcs ▸ hy)
      rw [h']
      exact bot_le
  have heq : ResolutionDriver.maxLocus (gammaAlong n N 𝔞 E 𝔪.d) 𝔪.cosupp =
      {y | y ∈ N ∧ gammaAlong n N 𝔞 E 𝔪.d y = v} := by
    ext y
    constructor
    · rintro ⟨hyc, hymax⟩
      have hyN : y ∈ N := (hcs ▸ hyc : y ∈ cosupport n N 𝔞 𝔪.d).1
      have h' := hymax x₀ hx₀.1
      rw [← hv] at h'
      exact ⟨hyN, le_antisymm (hmax y hyN) h'⟩
    · rintro ⟨hyN, hy⟩
      have hyc : y ∈ 𝔪.cosupp := by
        rw [hcs]
        by_contra hyc
        have h' := (gammaAlong_eq_bot_iff_of_isMonomialAlong hn hN hE hT h𝔞 hne hmono 𝔪.d hyN).mpr hyc
        rw [hy] at h'
        exact WithBot.coe_ne_bot h'
      refine ⟨hyc, fun y' hy' => ?_⟩
      rw [hy]
      exact hmax y' (hcs ▸ hy' : y' ∈ cosupport n N 𝔞 𝔪.d).1
  rw [heq]
  refine ⟨isAdmissibleCentre_gammaAlong_eq hn hN hE hT h𝔞 hne 𝔪 h𝔪N h𝔪E h𝔪a rfl hmono hmax, fun hd => ?_⟩
  -- the top set is nonempty (its exponents add up to at least `d ≥ 1`), so the locus lies on a member
  obtain ⟨hI, -⟩ := top_of_gammaAlong_eq (N := N) (𝔞 := 𝔞) (E := E) (d := 𝔪.d) hv.symm
  have hIne : (topSet v).Nonempty := by
    rw [Finset.nonempty_iff_ne_empty]
    intro h
    have h' := (mem_feasible.mp hI).2
    rw [h, Finset.sum_empty] at h'
    omega
  obtain ⟨i, hi⟩ := hIne
  have hlt : i < E.length := ((mem_memberIdx E).mp ((mem_feasible.mp hI).1 hi)).1
  refine Set.eq_empty_of_subset_empty ((interior_mono fun y hy => ?_).trans
    (interior_get_eq_empty hn hE ⟨i, hlt⟩).subset)
  classical
  exact mem_memberInter_of_gammaAlong_eq hn hN hE hT h𝔞 hne hy.1 hy.2 ⟨i, hlt⟩
    (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hi⟩)

end MaxLocus

/-! ### Principal monomial ideals along `N` -/

section Principal

variable {N : Set M} {𝔞 : GermIdeal n M} {E : List (Set M)}

/-- **A restricted stalk generator of a coherent ideal generates the nearby restricted stalks**: if `Res_N 𝔞_z = (m)|_N`
with `m` holomorphic at `z`, then `Res_N 𝔞_y = (m)|_N` for `y` near `z`. -/
theorem eventually_isInSpanOnAt_iff_of_isCoherent (h𝔞 : 𝔞.IsCoherent) {z : M} {m : M → ℂ}
    (hz : ∀ g, IsInSpanOnAt (n := n) N (𝔞.mem z) z g ↔ IsInSpanOnAt (n := n) N (· = m) z g) :
    ∀ᶠ y in 𝓝 z, ∀ g, IsInSpanOnAt (n := n) N (𝔞.mem y) y g ↔ IsInSpanOnAt (n := n) N (· = m) y g := by
  obtain ⟨U, hU, hzU, K, s, hs, hgen⟩ := h𝔞 z
  have hshol : ∀ k, ∀ y ∈ U, HolomorphicAt n (s k) y := fun k _ hy =>
    holomorphicAt_of_mdifferentiableOn_open hU (hs k) hy
  have hsmem : ∀ k, ∀ y ∈ U, 𝔞.mem y (s k) := fun k y hy => (hgen y hy (s k)).mpr
    (isInSpanAt_of_eq_mul ⟨k, rfl⟩ (hshol k y hy) (holomorphicAt_const 1)
      (Eventually.of_forall fun _ => (one_mul _).symm))
  have hsz : ∀ k, ∃ c, HolomorphicAt n c z ∧ ∀ᶠ w in 𝓝 z, w ∈ N → s k w = c w * m w := fun k =>
    isInSpanOnAt_eq_iff.mp ((hz (s k)).mp (IsInSpanAt.restrict (isInSpanAt_of_eq_mul (hsmem k z hzU)
      (hshol k z hzU) (holomorphicAt_const 1) (Eventually.of_forall fun _ => (one_mul _).symm))))
  choose c hc hsc using hsz
  obtain ⟨J, g, b, hg, hb, hmsum⟩ := (hz m).mpr (isInSpanOnAt_eq_iff.mpr
    ⟨fun _ => 1, holomorphicAt_const 1, Eventually.of_forall fun _ _ => (one_mul _).symm⟩)
  filter_upwards [hU.mem_nhds hzU, eventually_all.mpr fun k => (hc k).eventually_nhds,
    eventually_all.mpr fun k => (hsc k).eventually_nhds,
    eventually_all.mpr fun j => eventually_mem_of_isCoherent h𝔞 (hg j),
    eventually_all.mpr fun j => (hb j).eventually_nhds, hmsum.eventually_nhds] with y hyU hcy hscy hgy hby hmy f
  constructor
  · intro hf
    refine IsInSpanOnAt.trans (fun t ht => ?_) hf
    refine IsInSpanOnAt.trans (fun u hu => ?_) (IsInSpanAt.restrict ((hgen y hyU t).mp ht))
    obtain ⟨k, rfl⟩ := hu
    exact isInSpanOnAt_eq_iff.mpr ⟨c k, hcy k, hscy k⟩
  · intro hf
    refine IsInSpanOnAt.trans (fun t ht => ?_) hf
    rw [ht]
    exact ⟨J, g, b, hgy, hby, hmy⟩

open Classical in
variable (n) in
/-- **`𝔞` is principal monomial along `N` at `x`**: in coordinates at `x` adapted to `N` and `E` (`N = ℂ^{k} × 0`, the
members through `x` the hyperplanes `{w_{σ i} = 0}` with `σ i < k`), the restriction of `𝔞_x` to `N` is generated by
`∏_{x ∈ E_i} w_{σ i}^{a_i}` -- the form produced by `MonomialBlowupAlongChart.exists_snc_chart_geoTransform_along`. -/
def IsPrincipalMonomialAlongAt (N : Set M) (𝔞 : GermIdeal n M) (E : List (Set M)) (x : M) : Prop :=
  ∃ (k : ℕ) (Φ : LocalHolomorphicEquivAt (n := n) (chartAt (ComplexModel n) x x)) (σ : Fin E.length → Fin n)
    (a : Fin E.length → ℕ),
    Φ.source ⊆ (chartAt (ComplexModel n) x).target ∧
    (∀ {y : M}, y ∈ (chartAt (ComplexModel n) x).source → chartAt (ComplexModel n) x y ∈ Φ.source →
      (y ∈ N ↔ Φ.toFun (chartAt (ComplexModel n) x y) ∈ complexCoordinatePlane n k)) ∧
    (∀ i, x ∈ E.get i → (σ i).1 < k) ∧ Set.InjOn σ {i | x ∈ E.get i} ∧
    (∀ i, x ∈ E.get i → ∀ {y : M}, y ∈ (chartAt (ComplexModel n) x).source →
      chartAt (ComplexModel n) x y ∈ Φ.source → (y ∈ E.get i ↔ Φ.toFun (chartAt (ComplexModel n) x y) (σ i) = 0)) ∧
    ∀ g, IsInSpanOnAt (n := n) N (𝔞.mem x) x g ↔
      IsInSpanOnAt (n := n) N (· = fun z => ∏ i ∈ Finset.univ.filter (fun i => x ∈ E.get i),
        flatCoord Φ (σ i) z ^ a i) x g

variable {x : M} {Φ : LocalHolomorphicEquivAt (n := n) (chartAt (ComplexModel n) x x)}
  (hΦsrc : Φ.source ⊆ (chartAt (ComplexModel n) x).target) {kN : ℕ}
  (hNflat : ∀ {y : M}, y ∈ (chartAt (ComplexModel n) x).source → chartAt (ComplexModel n) x y ∈ Φ.source →
    (y ∈ N ↔ Φ.toFun (chartAt (ComplexModel n) x y) ∈ complexCoordinatePlane n kN))
  {σ : Fin E.length → Fin n} {T : Finset (Fin E.length)}
  (hσ : Set.InjOn σ T) (hσk : ∀ i ∈ T, (σ i).1 < kN)
  (hA : ∀ i ∈ T, ∀ {y : M}, y ∈ (chartAt (ComplexModel n) x).source →
    chartAt (ComplexModel n) x y ∈ Φ.source → (y ∈ E.get i ↔ Φ.toFun (chartAt (ComplexModel n) x y) (σ i) = 0))
  (a : Fin E.length → ℕ)
  (hgen : ∀ᶠ y in 𝓝 x, ∀ g, IsInSpanOnAt (n := n) N (𝔞.mem y) y g ↔
    IsInSpanOnAt (n := n) N (· = fun z => ∏ i ∈ T, flatCoord Φ (σ i) z ^ a i) y g)

include hΦsrc hNflat hσk hgen in
/-- **A principal monomial ideal along `N` is nonzero along `N`** at every point of `N` near `x`. -/
theorem eventually_isNonzeroAlongAt_of_principal : ∀ᶠ y in 𝓝 x, y ∈ N → IsNonzeroAlongAt N 𝔞 y := by
  filter_upwards [hgen, (isOpen_flatDomain Φ).mem_nhds (mem_flatDomain_self Φ)] with y hy hyD hyN
  obtain ⟨J, g, b, hg, hb, hmsum⟩ := (hy _).mpr (isInSpanOnAt_eq_iff.mpr
    ⟨fun _ => 1, holomorphicAt_const 1, Eventually.of_forall fun _ _ => (one_mul _).symm⟩)
  by_contra hcon
  have hzero : ∀ j, ∀ᶠ z in 𝓝 y, z ∈ N → g j z = 0 := by
    intro j
    by_contra hj
    refine hcon ⟨g j, hg j, ?_⟩
    rw [Filter.not_eventually] at hj
    exact hj.mono fun z hz => by push Not at hz; exact hz
  have hm0 : ∀ᶠ z in 𝓝 y, z ∈ N → (∏ i ∈ T, flatCoord Φ (σ i) z ^ a i) = 0 := by
    filter_upwards [hmsum, eventually_all.mpr hzero] with z h1 h2 hzN
    rw [h1 hzN]
    exact Finset.sum_eq_zero fun j _ => by rw [h2 j hzN, mul_zero]
  obtain ⟨z, ⟨hzN, hzne⟩, hz0⟩ :=
    ((frequently_generator_ne_zero hΦsrc hNflat hσk a hyD hyN).and_eventually hm0).exists
  exact hzne (hz0 hzN)

include hΦsrc hNflat hσ hσk hA hgen in
/-- **The exponents along `N` of a principal monomial ideal** (`hir:monomial-case` (2) along `N`, consumer side of
`MonomialBlowupAlongChart`): if near `x ∈ N` the restriction of `𝔞` to `N` is generated by `∏_{i ∈ T} u_{σ i}^{a_i}` in
coordinates adapted to `N` and to the members `E_i`, `i ∈ T`, then the exponent along `N` of a member `E_i` through `x` is
`a_i`. -/
theorem divExpAlong_eq_of_principal (h𝔞 : ∀ y g, 𝔞.mem y g → HolomorphicAt n g y) (hx : x ∈ N)
    {i : Fin E.length} (hi : i ∈ T) (hxi : x ∈ E.get i) : divExpAlong n N 𝔞 (E.get i) x = a i := by
  have hxD : x ∈ flatDomain Φ := mem_flatDomain_self Φ
  set m : M → ℂ := fun z => ∏ i ∈ T, flatCoord Φ (σ i) z ^ a i with hm_def
  have hne : IsNonzeroAlongAt N 𝔞 x :=
    (eventually_isNonzeroAlongAt_of_principal hΦsrc hNflat hσk a hgen).self_of_nhds hx
  have hr : IsLocalRetraction n N (flatRetract Φ kN) x := isLocalRetraction_flatRetract hΦsrc hNflat hxD hx
  have hmI := flatMonomial_mem_idealPow_vanishingIdeal hA a hi
  -- `𝔞|_N` is divisible by `𝓘_{N ∩ E_i}^{a_i}` near `x`
  have hdiv : IsDivNearAlong n N 𝔞 (E.get i) (a i) x := by
    filter_upwards [hgen, eventually_mem_idealPow_vanishingIdeal hmI] with z hz hzm hzN hzi
    refine ⟨hzN, fun f hf => ?_⟩
    obtain ⟨c, hc, hfc⟩ := isInSpanOnAt_eq_iff.mp ((hz f).mp (IsInSpanAt.restrict
      (isInSpanAt_of_eq_mul hf (h𝔞 z f hf) (holomorphicAt_const 1)
        (Eventually.of_forall fun _ => (one_mul _).symm))))
    exact ⟨fun w => c w * m w,
      mul_mem_idealPow hc (mem_idealPow_pointIdeal_of_mem_idealPow_vanishingIdeal hzi hzm), hfc⟩
  -- and not by `𝓘_{N ∩ E_i}^{a_i + 1}`: at the points of `N ∩ E_i` off the other hyperplanes `m` has order `a_i`
  have hndiv : ¬ IsDivNearAlong n N 𝔞 (E.get i) (a i + 1) x := by
    intro hd
    have hfreq := frequently_flatMap_ne_zero hΦsrc hxD ((T.erase i).image σ)
    obtain ⟨z, ⟨hzD, hzne, hzeq⟩, hzd, hzgen⟩ := (hfreq.and_eventually (hd.and hgen)).exists
    have hσi : σ i ∉ (T.erase i).image σ := by
      intro h
      obtain ⟨j, hj, hji⟩ := Finset.mem_image.mp h
      exact (Finset.mem_erase.mp hj).1 (hσ (Finset.mem_erase.mp hj).2 hi hji)
    have hzN : z ∈ N := by
      refine (hNflat hzD.1 hzD.2).mpr fun l hl => ?_
      have hlT : l ∉ (T.erase i).image σ := fun h => by
        obtain ⟨j, hj, rfl⟩ := Finset.mem_image.mp h
        have := hσk j (Finset.mem_erase.mp hj).2
        omega
      change flatMap Φ z l = 0
      rw [hzeq l hlT]
      exact (hNflat hxD.1 hxD.2).mp hx l hl
    have hu0 : flatCoord Φ (σ i) z = 0 := by
      rw [show flatCoord Φ (σ i) z = flatMap Φ z (σ i) from rfl, hzeq _ hσi]
      exact (hA i hi hxD.1 hxD.2).mp hxi
    have hzi : z ∈ E.get i := (hA i hi hzD.1 hzD.2).mpr hu0
    -- `m|_N` lies in `Res_N 𝔞_z`, hence has order `≥ a_i + 1` along `N` at `z`
    obtain ⟨J, g, b, hg, hb, hmsum⟩ := (hzgen m).mpr (isInSpanOnAt_eq_iff.mpr
      ⟨fun _ => 1, holomorphicAt_const 1, Eventually.of_forall fun _ _ => (one_mul _).symm⟩)
    obtain ⟨h, hh, hsh⟩ := vanishesToOrderOn_sum_mul (N := N) hb fun j => (hzd hzN hzi).2 (g j) (hg j)
    have hmN : VanishesToOrderOn n N z (a i + 1) m := ⟨h, hh, by
      filter_upwards [hmsum, hsh] with w h1 h2 hwN
      rw [h1 hwN, h2 hwN]⟩
    -- the order along `N` of `m` is its ambient order (the flat retraction keeps the coordinates `< k_N`)
    have hrz : IsLocalRetraction n N (flatRetract Φ kN) z := isLocalRetraction_flatRetract hΦsrc hNflat hzD hzN
    have hmr : m ∘ flatRetract Φ kN =ᶠ[𝓝 z] m := by
      have h := (eventually_all_finset T).mpr fun j hj =>
        eventually_flatMap_flatRetract hΦsrc hNflat hzD hzN (hσk j hj)
      filter_upwards [h] with w hw
      simp only [Function.comp, hm_def]
      exact Finset.prod_congr rfl fun j hj => by rw [show flatCoord Φ (σ j) (flatRetract Φ kN w) =
        flatMap Φ (flatRetract Φ kN w) (σ j) from rfl, (hw j hj).2]; rfl
    have hord : (idealPow (pointIdeal n z) (a i + 1)).mem z m :=
      mem_idealPow_congr (hrz.vanishesToOrderOn_iff.mp hmN) hmr
    have huh : HolomorphicAt n (flatCoord Φ (σ i)) z := holomorphicAt_flatCoord Φ (σ i) hzD
    have hrest : HolomorphicAt n (fun w => ∏ j ∈ T.erase i, flatCoord Φ (σ j) w ^ a j) z :=
      holomorphicAt_finset_prod _ fun j _ =>
        CompanionReduction.holomorphicAt_pow_of (holomorphicAt_flatCoord Φ (σ j) hzD) (a j)
    have hrest0 : ¬ (idealPow (pointIdeal n z) (0 + 1)).mem z
        (fun w => ∏ j ∈ T.erase i, flatCoord Φ (σ j) w ^ a j) := by
      intro h
      have h' := apply_eq_zero_of_mem_idealPow_pointIdeal (le_refl 1) h
      refine Finset.prod_ne_zero_iff.mpr (fun j hj => pow_ne_zero _ ?_) h'
      exact hzne (σ j) (Finset.mem_image_of_mem σ hj)
    have hpow : ¬ (idealPow (pointIdeal n z) (a i + 1)).mem z (fun w => flatCoord Φ (σ i) w ^ a i) := by
      have := CompanionReduction.pow_notMem_idealPow huh (flatCoord_notMem_idealPow_two Φ (σ i) hzD) (a i)
      simpa using this
    have hprod := mul_notMem_idealPow hrest (CompanionReduction.holomorphicAt_pow_of huh (a i)) hrest0 hpow
    refine hprod (mem_idealPow_congr (by simpa using hord) (Eventually.of_forall fun w => ?_))
    change ∏ j ∈ T, flatCoord Φ (σ j) w ^ a j =
      (∏ j ∈ T.erase i, flatCoord Φ (σ j) w ^ a j) * flatCoord Φ (σ i) w ^ a i
    rw [mul_comm, Finset.mul_prod_erase T (fun j => flatCoord Φ (σ j) w ^ a j) hi]
  have h1 := (isDivNearAlong_iff_le_divExpAlong hr hxi hne h𝔞).mp hdiv
  have h2 : ¬ a i + 1 ≤ divExpAlong n N 𝔞 (E.get i) x := fun h =>
    hndiv ((isDivNearAlong_iff_le_divExpAlong hr hxi hne h𝔞).mpr h)
  omega

include hΦsrc hNflat hσ hσk hA hgen in
/-- **The invariant along `N` of a principal monomial ideal** at `x ∈ N` is read off its exponents (`T` the members
through `x`). -/
theorem gammaAlong_eq_of_principal (h𝔞 : ∀ y g, 𝔞.mem y g → HolomorphicAt n g y) (hx : x ∈ N)
    (hT : ∀ i, i ∈ T ↔ x ∈ E.get i) (d : ℕ) :
    gammaAlong n N 𝔞 E d x = inv n (memberIdx E x) (fun i => if h : i < E.length then a ⟨i, h⟩ else 0) d := by
  unfold gammaAlong
  refine inv_congr fun i hi => ?_
  obtain ⟨hlt, hxi⟩ := (mem_memberIdx E).mp hi
  simp only [expDataAlong, dif_pos hlt]
  exact divExpAlong_eq_of_principal hΦsrc hNflat hσ hσk hA a hgen h𝔞 hx ((hT _).mpr hxi) hxi

end Principal

/-! ### Principal monomial at every point: the hypotheses of the next stage -/

section Global

variable {N : Set M} {𝔞 : GermIdeal n M} {E : List (Set M)}

/-- **Principal monomial at every point of `N` gives the hypotheses of the monomial case along `N`**: `𝔞|_N` is nonzero
near every point of `N`, and `𝔞` is monomial along `N` (for `E` simple normal crossings transverse to the closed
submanifold `N`, `n > 0`). -/
theorem isNonzeroAlongAt_and_isMonomialAlong_of_principal (hn : 0 < n) (hN : IsClosedSubmanifold n N)
    (hE : IsSNCDivisor n E) (hT : IsTransverse n N E) (h𝔞 : 𝔞.IsCoherent)
    (hloc : ∀ x ∈ N, IsPrincipalMonomialAlongAt n N 𝔞 E x) :
    (∀ y ∈ N, IsNonzeroAlongAt N 𝔞 y) ∧ IsMonomialAlong n N 𝔞 E := by
  classical
  have hhol : ∀ y g, 𝔞.mem y g → HolomorphicAt n g y := fun _ _ hg =>
    GermIdeal.IsCoherent.holomorphicAt_mem h𝔞 hg
  have hne : ∀ y ∈ N, IsNonzeroAlongAt N 𝔞 y := by
    intro y hy
    obtain ⟨k, Φ, σ, a, hΦsrc, hNflat, hσk, -, -, hgen0⟩ := hloc y hy
    exact (eventually_isNonzeroAlongAt_of_principal hΦsrc hNflat
      (fun i hi => hσk i (Finset.mem_filter.mp hi).2) a
      (eventually_isInSpanOnAt_iff_of_isCoherent h𝔞 hgen0)).self_of_nhds hy
  refine ⟨hne, fun x hx g hg => ?_⟩
  obtain ⟨k, Φ, σ, a, hΦsrc, hNflat, hσk, hσinj, hA, hgen0⟩ := hloc x hx
  have hexp : ∀ i, x ∈ E.get i → divExpAlong n N 𝔞 (E.get i) x = a i := fun i hxi =>
    divExpAlong_eq_of_principal hΦsrc hNflat
      (fun i hi j hj hij => hσinj (Finset.mem_filter.mp hi).2 (Finset.mem_filter.mp hj).2 hij)
      (fun i hi => hσk i (Finset.mem_filter.mp hi).2)
      (fun i hi _ hy1 hy2 => hA i (Finset.mem_filter.mp hi).2 hy1 hy2) a
      (eventually_isInSpanOnAt_iff_of_isCoherent h𝔞 hgen0) hhol hx
      (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hxi⟩) hxi
  obtain ⟨-, hgm⟩ :=
    ((monomialPartAlong_mem_iff hΦsrc hNflat hA hn hN hE hT h𝔞 hne hx hσk hσinj).self_of_nhds g).mp hg
  have hfun : (fun z => ∏ i ∈ Finset.univ.filter (fun i => x ∈ E.get i),
      flatCoord Φ (σ i) z ^ divExpAlong n N 𝔞 (E.get i) x) =
      fun z => ∏ i ∈ Finset.univ.filter (fun i => x ∈ E.get i), flatCoord Φ (σ i) z ^ a i := by
    funext z
    exact Finset.prod_congr rfl fun i hi => by rw [hexp i (Finset.mem_filter.mp hi).2]
  rw [hfun] at hgm
  refine IsInSpanOnAt.trans (fun t ht => ?_) hgm
  rw [ht]
  exact (hgen0 _).mpr (isInSpanOnAt_eq_iff.mpr
    ⟨fun _ => 1, holomorphicAt_const 1, Eventually.of_forall fun _ _ => (one_mul _).symm⟩)

end Global

end

end Hironaka.MonomialCaseAlong
