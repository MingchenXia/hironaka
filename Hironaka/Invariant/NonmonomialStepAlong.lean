/-!
# One blowup of a product with a monomial factor, inside a submanifold

Let `N` be a closed submanifold of `X`, `E` a simple normal crossings divisor transverse to `N`, `𝓜` coherent, nonzero
and monomial along `N` (`MonomialPartAlong.IsMonomialAlong`), `𝔟` coherent, nonzero along `N` and, at the points of `N`,
restricted to `N` contained in the ideal of no member.  Let `π` be the blowup along `C`, where `C` has normal crossings with
`E`, `C ⊆ cosupp(𝔟|_N, o) ∩ cosupp((𝔟𝓜)|_N, d)`, and `ord(𝔟|_N) ≤ o` on `C`.  Write `N' = closure(π⁻¹(N \ C))`,
`E' = (E_1', …, E_s', π⁻¹ C)`, `𝔩 = π^*𝓘_C`, and `𝔞'`, `𝔟'`, `𝓜''` for the transforms of `(N, E, 𝔟𝓜, d)`, `(N, E, 𝔟, o)`,
`(N, E, 𝓜, d - o)`.

## Main results

* restricted generators: `isInSpanOnAt_self_eq`, `isInSpanOnAt_iff_of_ambient` (an ambient generator restricts),
  `isInSpanOnAt_mul_iff_of_generators` (restricted generators multiply), `isNonzeroAlongAt_of_isInSpanOnAt`;
* `le_sum_divExpAlong_of_subset_cosupport`: the generic-point argument along `N` -- if `C ⊆ cosupp(𝓜|_N, μ)` for a
  monomial `𝓜`, then `μ ≤ ∑_{C ⊆ E_i near x} e_i(x)` at `x ∈ C`;
* `monomialFactor`, `restrictLe_geoTransform_mul`: `Res_{N'} 𝔞' = Res_{N'} (𝔟' · 𝓜')` with
  `𝓜' = 𝔩^{o - d} · 𝓜''` (cancellation of `𝔩^d`, invertible along `N'`);
* `isPrincipalAlongAt_monomialFactor`: `𝓜'` is principal monomial along `N'` for `E'` at every point of `N'`
  (`MonomialBlowupAlongChart.exists_snc_chart_geoTransform_along_of_flat` over `C`, `_of_notMem` off `C`; at points
  of `D = π⁻¹ C` the ideal `𝔩` is generated by the coordinate of `D`);
* `exists_not_isInSpanOnAt_geoTransform`: `𝔟'|_{N'}` is contained in the ideal of no member of `E'` at the points of
  `N'` (`ExceptionalPushforwardAlong` clauses 1 and 2 along `N'` and `MemberTraceIdealAlong`);
* `isNonzeroAlongAt_geoTransform`: `𝔟'` is nonzero along `N'`;
* `step_along`: the assembly.
-/

open Set Filter
open scoped Topology Manifold ContDiff

universe u

namespace Hironaka.NonmonomialStepAlong

open Hironaka.HolomorphicIdealSheaves Hironaka.BlowupSequences
open Hironaka.IdealWeightPowers Hironaka.GermIdealOrder Hironaka.BlowupFlatCoordinates Hironaka.DivisorExponentAlong Hironaka.MemberPullback Hironaka.MonomialPartAlong Hironaka.NormalCrossings Hironaka.MonomialCase Hironaka.MonomialCaseAlong Hironaka.MonomialStepAlong Hironaka.BlowupStrictSubmanifold Hironaka.BlowupSNCTransform Hironaka.BlowupExceptionalDivisor Hironaka.MarkedIdeals Hironaka.MarkedIdeals.MarkedIdeal Hironaka.RelativePrincipalizationSpan Hironaka.RestrictedIdealWeight Hironaka.InvertibleIdealQuotient

noncomputable section

variable {n : ℕ}

/-! ### Restricted generators -/

section Generators

variable {M : Type*} [TopologicalSpace M] [ChartedSpace (ComplexModel n) M] [IsComplexManifold n M] {W : Set M}

/-- A function lies in its own restricted principal ideal. -/
theorem isInSpanOnAt_self_eq {z : M} {p : M → ℂ} : IsInSpanOnAt (n := n) W (· = p) z p :=
  isInSpanOnAt_eq_iff.mpr ⟨fun _ => 1, holomorphicAt_const 1, Eventually.of_forall fun _ _ => (one_mul _).symm⟩

/-- **An ambient generator restricts**: if `𝔩_z = (p)`, then `Res_W 𝔩_z = Res_W (p)`. -/
theorem isInSpanOnAt_iff_of_ambient {𝔩 : GermIdeal n M} {z : M} {p : M → ℂ} (hp : HolomorphicAt n p z)
    (hgen : ∀ g, 𝔩.mem z g ↔ IsInSpanAt (n := n) (· = p) z g) (g : M → ℂ) :
    IsInSpanOnAt (n := n) W (𝔩.mem z) z g ↔ IsInSpanOnAt (n := n) W (· = p) z g := by
  constructor
  · intro hg
    exact IsInSpanOnAt.trans (fun s hs => IsInSpanAt.restrict ((hgen s).mp hs)) hg
  · intro hg
    refine IsInSpanOnAt.trans (fun s hs => ?_) hg
    rw [hs]
    exact IsInSpanAt.restrict (isInSpanAt_self ((hgen p).mpr (isInSpanAt_self rfl hp)) hp)

/-- **Restricted generators multiply**: if `Res_W A_z = Res_W (p)` and `Res_W B_z = Res_W (q)`, then
`Res_W (AB)_z = Res_W (pq)`. -/
theorem isInSpanOnAt_mul_iff_of_generators {A B : GermIdeal n M} (hA : ∀ y g, A.mem y g → HolomorphicAt n g y)
    (hB : ∀ y g, B.mem y g → HolomorphicAt n g y) {z : M} {p q : M → ℂ}
    (hAg : ∀ g, IsInSpanOnAt (n := n) W (A.mem z) z g ↔ IsInSpanOnAt (n := n) W (· = p) z g)
    (hBg : ∀ g, IsInSpanOnAt (n := n) W (B.mem z) z g ↔ IsInSpanOnAt (n := n) W (· = q) z g) (g : M → ℂ) :
    IsInSpanOnAt (n := n) W ((A.mul B).mem z) z g ↔ IsInSpanOnAt (n := n) W (· = fun y => p y * q y) z g := by
  constructor
  · intro hg
    refine IsInSpanOnAt.trans (fun t ht => ?_) hg
    refine IsInSpanOnAt.trans ?_ (IsInSpanAt.restrict (InvertibleIdealQuotient.mem_mul_iff.mp ht))
    rintro s ⟨a, b, ha, hb, rfl⟩
    have h1 := (hAg a).mp (IsInSpanAt.restrict (isInSpanAt_self ha (hA z a ha)))
    have h2 := (hBg b).mp (IsInSpanAt.restrict (isInSpanAt_self hb (hB z b hb)))
    refine IsInSpanOnAt.mono ?_ (MarkedIdealOperationsAlong.IsInSpanOnAt.mul h1 h2)
    rintro _ ⟨s, s', rfl, rfl, rfl⟩
    rfl
  · intro hg
    refine IsInSpanOnAt.trans (fun t ht => ?_) hg
    rw [ht]
    have h1 := (hAg p).mpr isInSpanOnAt_self_eq
    have h2 := (hBg q).mpr isInSpanOnAt_self_eq
    refine IsInSpanOnAt.mono ?_ (MarkedIdealOperationsAlong.IsInSpanOnAt.mul h1 h2)
    rintro _ ⟨a, b, ha, hb, rfl⟩
    exact IdealOrderArithmetic.mul_mem_mul ha hb ((hA z a ha).mul (hB z b hb))

/-- **A function vanishing on `W` near `z` lies in every restricted ideal.** -/
theorem isInSpanOnAt_of_eventually_eq_zero {S : (M → ℂ) → Prop} {z : M} {g : M → ℂ}
    (hg : ∀ᶠ y in 𝓝 z, y ∈ W → g y = 0) : IsInSpanOnAt (n := n) W S z g :=
  ⟨0, Fin.elim0, Fin.elim0, fun i => i.elim0, fun i => i.elim0, hg.mono fun y hy hyW => by simp [hy hyW]⟩

/-- **Nonzero along `W` from a restricted combination**: if `f` agrees on `W` near `z` with a combination of germs of
`𝔞_z` and `f` does not vanish identically on `W` near `z`, then `𝔞` is nonzero along `W` at `z`. -/
theorem isNonzeroAlongAt_of_isInSpanOnAt {𝔞 : GermIdeal n M} {z : M} {f : M → ℂ}
    (hf : IsInSpanOnAt (n := n) W (𝔞.mem z) z f) (hfreq : ∃ᶠ y in 𝓝 z, y ∈ W ∧ f y ≠ 0) :
    IsNonzeroAlongAt W 𝔞 z := by
  obtain ⟨K, s, c, hs, -, hsum⟩ := hf
  by_contra hcon
  have hzero : ∀ k, ∀ᶠ y in 𝓝 z, y ∈ W → s k y = 0 := by
    intro k
    by_contra hk
    refine hcon ⟨s k, hs k, ?_⟩
    rw [Filter.not_eventually] at hk
    exact hk.mono fun y hy => by push Not at hy; exact hy
  have hf0 : ∀ᶠ y in 𝓝 z, y ∈ W → f y = 0 := by
    filter_upwards [hsum, eventually_all.mpr hzero] with y h1 h2 hyW
    rw [h1 hyW]
    exact Finset.sum_eq_zero fun k _ => by rw [h2 k hyW, mul_zero]
  obtain ⟨y, ⟨hyW, hyne⟩, hy0⟩ := (hfreq.and_eventually hf0).exists
  exact hyne (hy0 hyW)

end Generators

/-! ### The generic-point argument along `N` -/

section Generic

variable {M : Type*} [TopologicalSpace M] [ChartedSpace (ComplexModel n) M] [IsComplexManifold n M]
  {N : Set M} {E : List (Set M)} {C : Set M}

open Classical in
/-- **The exponents along `N` of the members containing a centre in the cosupport of a monomial ideal** (the generic-point
argument of `hir:nonmonomial-transform`, along `N`): if `𝓜` is nonzero and monomial along `N`, `C ⊆ N` has normal
crossings with `E` and `C ⊆ cosupp(𝓜|_N, μ)`, then at `x ∈ C` the exponents along `N` of the members containing `C` near
`x` add up to at least `μ`.  Points of `C` on no member through `x` that does not contain `C` near `x` accumulate at `x`
(`NonmonomialTransformTower.frequently_mem_notMem_of_hasNormalCrossings`); at such a point `y` near `x` the members through
`y` carry the exponents they have at `x` (`MonomialCaseAlong.eventually_expDataAlong_eq`), and `y ∈ cosupp(𝓜|_N, μ)`
gives `μ ≤ ∑_{y ∈ E_i} e_i` (`MonomialCaseAlong.mem_cosupport_iff_of_isMonomialAlong`). -/
theorem le_sum_divExpAlong_of_subset_cosupport (hn : 0 < n) (hN : IsClosedSubmanifold n N) (hE : IsSNCDivisor n E)
    (hT : IsTransverse n N E) {𝓜 : GermIdeal n M} (h𝓜 : 𝓜.IsCoherent) (hne : ∀ y ∈ N, IsNonzeroAlongAt N 𝓜 y)
    (hmono : IsMonomialAlong n N 𝓜 E) (hnc : HasNormalCrossings n C E) (hCN : C ⊆ N) {μ : ℕ}
    (hCμ : C ⊆ cosupport n N 𝓜 μ) {x : M} (hx : x ∈ C) :
    μ ≤ ∑ i ∈ Finset.univ.filter (fun i => x ∈ E.get i ∧ ∀ᶠ y in 𝓝 x, y ∈ C → y ∈ E.get i),
      divExpAlong n N 𝓜 (E.get i) x := by
  obtain ⟨y, ⟨hyC, hyE⟩, hsub, hexp⟩ :=
    ((NonmonomialTransformTower.frequently_mem_notMem_of_hasNormalCrossings hnc hx).and_eventually
      ((eventually_memberIdx_subset E hE.1 x).and
        (eventually_expDataAlong_eq hn hN hE hT h𝓜 hne (hCN hx)))).exists
  have hyN : y ∈ N := hCN hyC
  have h1 := (mem_cosupport_iff_of_isMonomialAlong hn hN hE hT h𝓜 hne hmono μ hyN).mp (hCμ hyC)
  rw [Finset.sum_congr rfl (hexp hyN)] at h1
  have h2 : ∑ i ∈ memberIdx E y, expDataAlong n N 𝓜 E x i =
      ∑ i ∈ Finset.univ.filter (fun i : Fin E.length => y ∈ E.get i), divExpAlong n N 𝓜 (E.get i) x := by
    rw [memberIdx, Finset.sum_map]
    refine Finset.sum_congr rfl fun i _ => ?_
    simp only [Fin.valEmbedding_apply, expDataAlong, dif_pos i.2, Fin.eta]
  rw [h2] at h1
  refine h1.trans (Finset.sum_le_sum_of_subset fun i hi => ?_)
  have hyi : y ∈ E.get i := (Finset.mem_filter.mp hi).2
  have hxi : x ∈ E.get i := by
    obtain ⟨_, h⟩ := (mem_memberIdx E).mp (hsub ((mem_memberIdx E).mpr ⟨i.2, hyi⟩))
    exact h
  refine Finset.mem_filter.mpr ⟨Finset.mem_univ _, hxi, ?_⟩
  by_contra hnot
  exact hyE i hxi hnot hyi

end Generic

/-! ### One blowup -/

section Step

variable {X : Type u} [TopologicalSpace X] [ChartedSpace (ComplexModel n) X] [IsComplexManifold n X]
  {Y : Type u} [TopologicalSpace Y] [ChartedSpace (ComplexModel n) Y] [IsComplexManifold n Y]
  {C : Set X} {π : Y → X}

variable (n) in
/-- **The monomial factor after one blowup**: `𝓜' = (π^*𝓘_C)^{o - d} · 𝓜''`, `𝓜''` the transform of `(N, E, 𝓜, d - o)`
(truncated differences). -/
def monomialFactor (π : Y → X) (C N : Set X) (E : List (Set X)) (𝓜 : GermIdeal n X) (o d : ℕ) : GermIdeal n Y :=
  (idealPow (GermIdeal.pullback (m := n) π (vanishingIdeal (n := n) C)) (o - d)).mul
    ((⟨N, E, 𝓜, d - o⟩ : MarkedIdeal n X).geoTransform C π).ideal

/-- The monomial factor is coherent (admissible centre for `(N, E, 𝓜, d - o)`). -/
theorem isCoherent_monomialFactor (hπ : IsBlowupAlong n C π) {N : Set X} (hN : IsClosedSubmanifold n N)
    (E : List (Set X)) {𝓜 : GermIdeal n X} (h𝓜 : 𝓜.IsCoherent) {o d : ℕ}
    (hCM : (⟨N, E, 𝓜, d - o⟩ : MarkedIdeal n X).IsAdmissibleCentre C) :
    (monomialFactor n π C N E 𝓜 o d).IsCoherent :=
  IdealWeightPowers.isCoherent_mul
    (GermIdealPullbackCalculus.isCoherent_idealPow
      (GermIdealPullbackCalculus.isCoherent_pullback hπ.contMDiff (isCoherent_vanishingIdeal_centre hπ)) _)
    (HadamardBridgeAlong.isCoherent_geoTransform_ideal_of_isAdmissibleCentre (𝔪 := ⟨N, E, 𝓜, d - o⟩) hN h𝓜 hCM hπ)

/-- **The factorization after one blowup, along `N'`**: `Res_{N'} 𝔞' = Res_{N'} (𝔟' · 𝓜')`, where `𝔞'`, `𝔟'` are the
transforms of `(N, E, 𝔟𝓜, d)`, `(N, E, 𝔟, o)` and `𝓜' = (π^*𝓘_C)^{o - d} 𝓜''`.  From
`Res_{N'} π^*𝔢 = Res_{N'} ((π^*𝓘_C)^μ 𝔢')` for the three marked ideals, `π^*(𝔟𝓜) = π^*𝔟 · π^*𝓜`,
`o + (d - o) = d + (o - d)`, and cancellation of `(π^*𝓘_C)^d`, invertible along `N'`. -/
theorem restrictLe_geoTransform_mul (hπ : IsBlowupAlong n C π) {N : Set X} (hN : IsClosedSubmanifold n N)
    (E : List (Set X)) {𝔟 𝓜 : GermIdeal n X} (h𝔟 : 𝔟.IsCoherent) (h𝓜 : 𝓜.IsCoherent) {o d : ℕ}
    (hCb : (⟨N, E, 𝔟, o⟩ : MarkedIdeal n X).IsAdmissibleCentre C)
    (hCM : (⟨N, E, 𝓜, d - o⟩ : MarkedIdeal n X).IsAdmissibleCentre C)
    (hCa : (⟨N, E, 𝔟.mul 𝓜, d⟩ : MarkedIdeal n X).IsAdmissibleCentre C) :
    RestrictLe (geoStrictTransform π C N) ((⟨N, E, 𝔟.mul 𝓜, d⟩ : MarkedIdeal n X).geoTransform C π).ideal
        (((⟨N, E, 𝔟, o⟩ : MarkedIdeal n X).geoTransform C π).ideal.mul (monomialFactor n π C N E 𝓜 o d)) ∧
      RestrictLe (geoStrictTransform π C N)
        (((⟨N, E, 𝔟, o⟩ : MarkedIdeal n X).geoTransform C π).ideal.mul (monomialFactor n π C N E 𝓜 o d))
        ((⟨N, E, 𝔟.mul 𝓜, d⟩ : MarkedIdeal n X).geoTransform C π).ideal := by
  set 𝔫 : MarkedIdeal n X := ⟨N, E, 𝔟, o⟩ with h𝔫
  set 𝔪M : MarkedIdeal n X := ⟨N, E, 𝓜, d - o⟩ with h𝔪M
  set 𝔪 : MarkedIdeal n X := ⟨N, E, 𝔟.mul 𝓜, d⟩ with h𝔪
  set W := geoStrictTransform π C N with hW
  set 𝔩 := GermIdeal.pullback (m := n) π (vanishingIdeal (n := n) C) with h𝔩def
  have h𝔩 : 𝔩.IsCoherent :=
    GermIdealPullbackCalculus.isCoherent_pullback hπ.contMDiff (isCoherent_vanishingIdeal_centre hπ)
  have hP : ∀ k, (idealPow 𝔩 k).IsCoherent := fun k => GermIdealPullbackCalculus.isCoherent_idealPow h𝔩 k
  have h𝔪coh : 𝔪.ideal.IsCoherent := IdealWeightPowers.isCoherent_mul h𝔟 h𝓜
  have h𝔟' := HadamardBridgeAlong.isCoherent_geoTransform_ideal_of_isAdmissibleCentre (𝔪 := 𝔫) hN h𝔟 hCb hπ
  have h𝓜'' := HadamardBridgeAlong.isCoherent_geoTransform_ideal_of_isAdmissibleCentre (𝔪 := 𝔪M) hN h𝓜 hCM hπ
  have h𝔞' := HadamardBridgeAlong.isCoherent_geoTransform_ideal_of_isAdmissibleCentre (𝔪 := 𝔪) hN h𝔪coh hCa hπ
  obtain ⟨a1, a2⟩ := MarkedIdealOperationsAlong.MarkedIdeal.restrictLe_pullback_geoTransform (𝔪 := 𝔫) hN h𝔟 hCb hπ
  obtain ⟨b1, b2⟩ := MarkedIdealOperationsAlong.MarkedIdeal.restrictLe_pullback_geoTransform (𝔪 := 𝔪M) hN h𝓜 hCM hπ
  obtain ⟨p1, p2⟩ := MarkedIdealOperationsAlong.MarkedIdeal.restrictLe_pullback_geoTransform (𝔪 := 𝔪) hN h𝔪coh hCa hπ
  set 𝔟' := (𝔫.geoTransform C π).ideal with h𝔟'def
  set 𝓜'' := (𝔪M.geoTransform C π).ideal with h𝓜''def
  set 𝔞' := (𝔪.geoTransform C π).ideal with h𝔞'def
  have a1' : RestrictLe W (GermIdeal.pullback (m := n) π 𝔟) ((idealPow 𝔩 o).mul 𝔟') := a1
  have a2' : RestrictLe W ((idealPow 𝔩 o).mul 𝔟') (GermIdeal.pullback (m := n) π 𝔟) := a2
  have b1' : RestrictLe W (GermIdeal.pullback (m := n) π 𝓜) ((idealPow 𝔩 (d - o)).mul 𝓜'') := b1
  have b2' : RestrictLe W ((idealPow 𝔩 (d - o)).mul 𝓜'') (GermIdeal.pullback (m := n) π 𝓜) := b2
  have p1' : RestrictLe W (GermIdeal.pullback (m := n) π (𝔟.mul 𝓜)) ((idealPow 𝔩 d).mul 𝔞') := p1
  have p2' : RestrictLe W ((idealPow 𝔩 d).mul 𝔞') (GermIdeal.pullback (m := n) π (𝔟.mul 𝓜)) := p2
  set Y' := 𝔟'.mul (monomialFactor n π C N E 𝓜 o d) with hY'
  have hYcoh : Y'.IsCoherent :=
    IdealWeightPowers.isCoherent_mul h𝔟' (isCoherent_monomialFactor hπ hN E h𝓜 hCM)
  have e1 : GermIdeal.pullback (m := n) π (𝔟.mul 𝓜) =
      (GermIdeal.pullback (m := n) π 𝔟).mul (GermIdeal.pullback (m := n) π 𝓜) :=
    GermIdealTotalTransform.pullback_mul hπ.contMDiff h𝔟 h𝓜
  have e2 : ((idealPow 𝔩 o).mul 𝔟').mul ((idealPow 𝔩 (d - o)).mul 𝓜'') = Y'.mul (idealPow 𝔩 d) := by
    rw [BlowupControlledTransform.mul_mul_mul_comm (hP o) h𝔟' (hP (d - o)) h𝓜'',
      ← RestrictLeCalculus.idealPow_add h𝔩, show o + (d - o) = d + (o - d) by omega,
      RestrictLeCalculus.idealPow_add h𝔩,
      BlowupControlledTransform.mul_mul_mul_comm (hP d) (hP (o - d)) h𝔟' h𝓜'',
      GermIdealTotalTransform.mul_assoc (hP d) h𝔟' (IdealWeightPowers.isCoherent_mul (hP (o - d)) h𝓜''),
      RestrictLeCalculus.mul_comm' (idealPow 𝔩 d)]
    rfl
  have fwd : RestrictLe W (𝔞'.mul (idealPow 𝔩 d)) (Y'.mul (idealPow 𝔩 d)) := by
    rw [RestrictLeCalculus.mul_comm' 𝔞' (idealPow 𝔩 d), ← e2]
    refine RestrictLeCalculus.RestrictLe.trans p2' ?_
    rw [e1]
    exact MarkedIdealOperationsAlong.restrictLe_mul
      (MarkedIdealOperationsAlong.MarkedIdeal.hol_of_isCoherent (IdealWeightPowers.isCoherent_mul (hP o) h𝔟'))
      (MarkedIdealOperationsAlong.MarkedIdeal.hol_of_isCoherent (IdealWeightPowers.isCoherent_mul (hP _) h𝓜''))
      a1' b1'
  have bwd : RestrictLe W (Y'.mul (idealPow 𝔩 d)) (𝔞'.mul (idealPow 𝔩 d)) := by
    rw [RestrictLeCalculus.mul_comm' 𝔞' (idealPow 𝔩 d), ← e2]
    refine RestrictLeCalculus.RestrictLe.trans ?_ p1'
    rw [e1]
    exact MarkedIdealOperationsAlong.restrictLe_mul
      (MarkedIdealOperationsAlong.MarkedIdeal.hol_of_isCoherent
        (GermIdealPullbackCalculus.isCoherent_pullback hπ.contMDiff h𝔟))
      (MarkedIdealOperationsAlong.MarkedIdeal.hol_of_isCoherent
        (GermIdealPullbackCalculus.isCoherent_pullback hπ.contMDiff h𝓜)) a2' b2'
  have hinv : RestrictedIdealQuotient.IsInvertibleAlong n W (idealPow 𝔩 d) :=
    isInvertibleAlong_geoStrictTransform hπ N d
  exact ⟨RestrictLeCalculus.restrictLe_of_restrictLe_mul_mul h𝔞' hYcoh hinv fwd,
    RestrictLeCalculus.restrictLe_of_restrictLe_mul_mul hYcoh h𝔞' hinv bwd⟩

open Classical in
/-- **The monomial factor is principal monomial along `N'`** for `E' = (E_1', …, E_s', π⁻¹ C)` at every point `z ∈ N'`
(`hir:nonmonomial-step-along`). Over the centre: `exists_snc_chart_geoTransform_along_of_flat` for `(N, E, 𝓜, d -
o)`, fed with centred coordinates adapted to `N` and `E` at `π z` (`isPrincipalAlongAt_of_isMonomialAlong`) and the
generic-point bound `le_sum_divExpAlong_of_subset_cosupport`; `π^*𝓘_C` is generated at `z` by the coordinate `Θ_D`
of `D = π⁻¹ C` (`π^*𝓘_C ⊆ 𝓘_D ⊆ 𝒪(-D)`, `NonmonomialTransformTower.exceptionalDivisor_mem_of_vanishingIdeal_mem`),
so the exponent on `D` rises by `o - d`. Off the centre: `exists_snc_chart_geoTransform_along_of_notMem`, and
`π^*𝓘_C` is the unit ideal at `z`. -/
theorem isPrincipalAlongAt_monomialFactor (hn : 0 < n) (hπ : IsBlowupAlong n C π) {N : Set X}
    (hN : IsClosedSubmanifold n N) {E : List (Set X)} (hE : IsSNCDivisor n E) (hT : IsTransverse n N E)
    {𝓜 : GermIdeal n X} (h𝓜 : 𝓜.IsCoherent) (hne : ∀ y ∈ N, IsNonzeroAlongAt N 𝓜 y)
    (hmono : IsMonomialAlong n N 𝓜 E) {o d : ℕ} (hnc : HasNormalCrossings n C E)
    (hCM : C ⊆ cosupport n N 𝓜 (d - o)) {z : Y} (hz : z ∈ geoStrictTransform π C N) :
    ∃ b, IsPrincipalAlongAt (geoStrictTransform π C N) (monomialFactor n π C N E 𝓜 o d)
      (E.map (geoStrictTransform π C) ++ [π ⁻¹' C]) z b := by
  set 𝔪M : MarkedIdeal n X := ⟨N, E, 𝓜, d - o⟩ with h𝔪M
  have hCN : C ⊆ N := fun x hx => (hCM hx).1
  have hCadm : 𝔪M.IsAdmissibleCentre C := ⟨hπ.1, hCM, hnc⟩
  set 𝔩 := GermIdeal.pullback (m := n) π (vanishingIdeal (n := n) C) with h𝔩def
  have h𝔩 : 𝔩.IsCoherent :=
    GermIdealPullbackCalculus.isCoherent_pullback hπ.contMDiff (isCoherent_vanishingIdeal_centre hπ)
  have hPhol : ∀ y g, (idealPow 𝔩 (o - d)).mem y g → HolomorphicAt n g y := fun _ _ hg =>
    holomorphicAt_of_mem_idealPow hg
  have h𝓜''hol : ∀ y g, (𝔪M.geoTransform C π).ideal.mem y g → HolomorphicAt n g y :=
    MarkedIdealOperationsAlong.MarkedIdeal.hol_of_isCoherent
      (HadamardBridgeAlong.isCoherent_geoTransform_ideal_of_isAdmissibleCentre (𝔪 := 𝔪M) hN h𝓜 hCadm hπ)
  have hπzN : π z ∈ N := geoStrictTransform_subset_preimage hπ.contMDiff.continuous hN.1 hz
  obtain ⟨k, Φ, σ₀, hΦsrc, hΦ0, hNflat, hσk, hσinj, hA, hgen⟩ :=
    isPrincipalAlongAt_of_isMonomialAlong hn hN hE hT h𝓜 hne hmono hπzN
  by_cases hzC : π z ∈ C
  · have hd' := le_sum_divExpAlong_of_subset_cosupport hn hN hE hT h𝓜 hne hmono hnc hCN hCM hzC
    obtain ⟨k', Θ, σ, a', hΘt, hΘ0, hΘN, hσk', hσinj', hA', -, -, hgen'⟩ :=
      MonomialBlowupAlongChart.exists_snc_chart_geoTransform_along_of_flat hπ (𝔪 := 𝔪M) hN h𝓜 hCadm hE hT hz hzC
        (T := Finset.univ.filter fun i => π z ∈ E.get i) (fun i => by simp [h𝔪M])
        (fun i hi => hA i (Finset.mem_filter.mp hi).2) _ hgen hd'
    set E' : List (Set Y) := E.map (geoStrictTransform π C) ++ [π ⁻¹' C] with hE'
    set iD : Fin E'.length := ⟨E.length, by simp [hE']⟩ with hiD
    have hE'D : E'.get iD = π ⁻¹' C := by
      have h := get_map_append_singleton E (geoStrictTransform π C) (π ⁻¹' C) iD
      rw [dif_neg (show ¬ (iD : ℕ) < E.length from by simp [hiD])] at h
      exact h
    have hzD : z ∈ E'.get iD := by rw [hE'D]; exact hzC
    have hzΘ : z ∈ flatDomain Θ := mem_flatDomain_self Θ
    have hflat : ∀ {y : Y}, y ∈ (chartAt (ComplexModel n) z).source → chartAt (ComplexModel n) z y ∈ Θ.source →
        (y ∈ π ⁻¹' C ↔ Θ.toFun (chartAt (ComplexModel n) z y) (σ iD) = 0) := fun hy1 hy2 => by
      rw [← hE'D]; exact hA' iD hzD hy1 hy2
    have hDgen : ∀ g, 𝔩.mem z g ↔ IsInSpanAt (n := n) (· = flatCoord Θ (σ iD)) z g := by
      intro g
      rw [← vanishingIdeal_mem_iff_flatCoord Θ hflat hzΘ g]
      exact ⟨fun hg => BlowupStrictIdeal.pullback_vanishingIdeal_le hπ.contMDiff.continuous C z g hg,
        fun hg => NonmonomialTransformTower.exceptionalDivisor_mem_of_vanishingIdeal_mem hπ hE hnc hzC hg⟩
    have hΘD : HolomorphicAt n (flatCoord Θ (σ iD)) z := holomorphicAt_flatCoord Θ (σ iD) hzΘ
    have hIk := NonmonomialTransformTower.idealPow_mem_iff_of_generator hΘD hDgen (o - d)
    have hIkW := isInSpanOnAt_iff_of_ambient (W := geoStrictTransform π C N)
      (CompanionReduction.holomorphicAt_pow_of hΘD _) hIk
    set F : Finset (Fin E'.length) := Finset.univ.filter fun i => z ∈ E'.get i with hF
    have hiDF : iD ∈ F := Finset.mem_filter.mpr ⟨Finset.mem_univ _, hzD⟩
    set a'' : Fin E'.length → ℕ := fun i => if i = iD then a' i + (o - d) else a' i with ha''
    have hprod : ∀ y, flatCoord Θ (σ iD) y ^ (o - d) * ∏ i ∈ F, flatCoord Θ (σ i) y ^ a' i =
        ∏ i ∈ F, flatCoord Θ (σ i) y ^ a'' i := by
      intro y
      rw [← Finset.mul_prod_erase F (fun i => flatCoord Θ (σ i) y ^ a' i) hiDF,
        ← Finset.mul_prod_erase F (fun i => flatCoord Θ (σ i) y ^ a'' i) hiDF]
      have h1 : ∏ i ∈ F.erase iD, flatCoord Θ (σ i) y ^ a'' i =
          ∏ i ∈ F.erase iD, flatCoord Θ (σ i) y ^ a' i :=
        Finset.prod_congr rfl fun i hi => by simp only [ha'', if_neg (Finset.ne_of_mem_erase hi)]
      rw [h1]
      simp only [ha'', if_pos rfl, pow_add]
      ring
    refine ⟨a'', k', Θ, σ, hΘt, hΘ0, hΘN, hσk', hσinj', hA', fun g => ?_⟩
    exact (isInSpanOnAt_mul_iff_of_generators hPhol h𝓜''hol hIkW hgen' g).trans
      (MonomialBlowupAlongChart.isInSpanOnAt_eq_congr (Eventually.of_forall fun y => hprod y) g)
  · obtain ⟨Θ, σ, a', hΘt, hΘ0, hΘN, hσk', hσinj', hA', -, hgen'⟩ :=
      MonomialBlowupAlongChart.exists_snc_chart_geoTransform_along_of_notMem hn hπ (𝔪 := 𝔪M) hN.1 h𝓜 hE hzC hΦ0
        hNflat hσk hσinj hA _ hgen
    have h1 : 𝔩.mem z (fun _ => (1 : ℂ)) := one_mem_pullback_vanishingIdeal hzC hπ.1.1
    have hIp : (idealPow 𝔩 (o - d)).IsCoherent := GermIdealPullbackCalculus.isCoherent_idealPow h𝔩 _
    have hIk : ∀ g, (idealPow 𝔩 (o - d)).mem z g ↔ IsInSpanAt (n := n) (· = fun _ => (1 : ℂ)) z g := by
      intro g
      rw [isInSpanAt_one_iff]
      refine ⟨fun hg => holomorphicAt_of_mem_idealPow hg, fun hg => ?_⟩
      refine MonomialPart.mem_congr_of_isCoherent hIp
        (CompanionReduction.mul_mem_of_isCoherent hIp hg (one_mem_idealPow h1 (o - d))) ?_
      exact Eventually.of_forall fun p => mul_one _
    have hIkW := isInSpanOnAt_iff_of_ambient (W := geoStrictTransform π C N) (holomorphicAt_const 1) hIk
    refine ⟨a', k, Θ, σ, hΘt, hΘ0, hΘN, hσk', hσinj', hA', fun g => ?_⟩
    exact (isInSpanOnAt_mul_iff_of_generators hPhol h𝓜''hol hIkW hgen' g).trans
      (MonomialBlowupAlongChart.isInSpanOnAt_eq_congr (Eventually.of_forall fun p => one_mul _) g)

/-- **The transform of `𝔟` is, along `N'`, contained in the ideal of no member of `E'`** at the points of `N'`.  For a
strict transform `H'` of a member `H` (`H' ∩ N' = (H ∩ N)'`, `ExceptionalPushforwardAlong.geoStrictTransform_inter_eq`):
clause 2 of `bcalc:controlled-not-exceptional` along `N'` (`exists_not_mem_vanishingIdeal_of_geoTransform` with
`A = H ∩ N`), the hypothesis on `𝔟` read through `𝓘_{N∩H} = 𝓘_H + 𝓘_N` (`MemberTraceIdealAlong`).  For `D = π⁻¹ C`:
clause 1 along `N'` (`exists_not_isInSpanOnAt_exceptionalDivisor`, from `ord(𝔟|_N) ≤ o` on `C`) and
`Res_{N'} (π^*𝓘_C) = Res_{N'} 𝓘_{D ∩ N'}` (`MemberTraceIdealAlong.isInSpanOnAt_exceptionalDivisor_iff_mem`). -/
theorem exists_not_isInSpanOnAt_geoTransform (hπ : IsBlowupAlong n C π) {N : Set X}
    (hN : IsClosedSubmanifold n N) {E : List (Set X)} (hE : IsSNCDivisor n E) (hT : IsTransverse n N E)
    {𝔟 : GermIdeal n X} (h𝔟 : 𝔟.IsCoherent) {o : ℕ} (hnc : HasNormalCrossings n C E)
    (hCb : C ⊆ cosupport n N 𝔟 o) (hbd : ∀ x ∈ C, x ∉ cosupport n N 𝔟 (o + 1))
    (hnd : ∀ y ∈ N, ∀ i, y ∈ E.get i → ∃ a, 𝔟.mem y a ∧
      ¬ IsInSpanOnAt (n := n) N ((vanishingIdeal (n := n) (E.get i)).mem y) y a)
    {y : Y} (hy : y ∈ geoStrictTransform π C N) (i : Fin (E.map (geoStrictTransform π C) ++ [π ⁻¹' C]).length)
    (hyi : y ∈ (E.map (geoStrictTransform π C) ++ [π ⁻¹' C]).get i) :
    ∃ a, ((⟨N, E, 𝔟, o⟩ : MarkedIdeal n X).geoTransform C π).ideal.mem y a ∧
      ¬ IsInSpanOnAt (n := n) (geoStrictTransform π C N)
        ((vanishingIdeal (n := n) ((E.map (geoStrictTransform π C) ++ [π ⁻¹' C]).get i)).mem y) y a := by
  set 𝔫 : MarkedIdeal n X := ⟨N, E, 𝔟, o⟩ with h𝔫
  set W := geoStrictTransform π C N with hW
  have hCN : C ⊆ N := fun x hx => (hCb hx).1
  have hCadm : 𝔫.IsAdmissibleCentre C := ⟨hπ.1, hCb, hnc⟩
  have h𝔫wf : 𝔫.IsWellFormed := ⟨hN, h𝔟, hE, hT⟩
  have h𝔫'wf := GeoTransformWellFormed.isWellFormed_geoTransform_of_isAdmissibleCentre h𝔫wf hCadm hπ
  have h𝔟hol := MarkedIdealOperationsAlong.MarkedIdeal.hol_of_isCoherent h𝔟
  have h𝔟'hol : ∀ y g, (𝔫.geoTransform C π).ideal.mem y g → HolomorphicAt n g y :=
    MarkedIdealOperationsAlong.MarkedIdeal.hol_of_isCoherent h𝔫'wf.isCoherent
  have hget := get_map_append_singleton E (geoStrictTransform π C) (π ⁻¹' C) i
  by_cases hi : (i : ℕ) < E.length
  · rw [dif_pos hi] at hget
    set H := E.get ⟨i, hi⟩ with hH
    have hinter := ExceptionalPushforwardAlong.geoStrictTransform_inter_eq hπ hN.1 hCN hE hT hnc ⟨i, hi⟩
    have hyH : y ∈ geoStrictTransform π C H := by rw [← hget]; exact hyi
    have hyA : y ∈ geoStrictTransform π C (H ∩ N) := by rw [hinter]; exact ⟨hyH, hy⟩
    have hnot : ∀ᶠ y' in 𝓝 (π y), y' ∈ (H ∩ N) \ C →
        ∃ a, 𝔫.ideal.mem y' a ∧ ¬ (vanishingIdeal (n := n) (H ∩ N)).mem y' a := by
      refine Eventually.of_forall fun y' hy' => ?_
      obtain ⟨a, ha, hna⟩ := hnd y' hy'.1.2 ⟨i, hi⟩ hy'.1.1
      refine ⟨a, ha, fun hmem => hna ?_⟩
      rw [MemberTraceIdealAlong.isInSpanOnAt_vanishingIdeal_iff_mem hE hT hy'.1.2 ⟨i, hi⟩ (h𝔟hol y' a ha),
        Set.inter_comm]
      exact hmem
    obtain ⟨g, hg, hng⟩ := ExceptionalPushforwardAlong.exists_not_mem_vanishingIdeal_of_geoTransform hπ (𝔪 := 𝔫)
      hN h𝔟 hCb (A := H ∩ N) inter_subset_right hyA hnot
    refine ⟨g, hg, fun hspan => hng ?_⟩
    have h1 := (MemberTraceIdealAlong.isInSpanOnAt_vanishingIdeal_iff_mem_of_isWellFormed h𝔫'wf hy i
      (h𝔟'hol y g hg)).mp hspan
    change (vanishingIdeal (n := n) (W ∩ (E.map (geoStrictTransform π C) ++ [π ⁻¹' C]).get i)).mem y g at h1
    rw [hget, Set.inter_comm] at h1
    rw [hinter]
    exact h1
  · rw [dif_neg hi] at hget
    have hyC : π y ∈ C := by rw [hget] at hyi; exact hyi
    obtain ⟨g, hg, hng⟩ := ExceptionalPushforwardAlong.exists_not_isInSpanOnAt_exceptionalDivisor hπ (𝔪 := 𝔫) hN h𝔟
      hCb hyC hy (hbd _ hyC)
    refine ⟨g, hg, fun hspan => hng ?_⟩
    have hghol := h𝔟'hol y g hg
    rw [MemberTraceIdealAlong.isInSpanOnAt_exceptionalDivisor_iff_mem hπ hN hCN hyC hy hghol]
    rw [hget] at hspan
    refine MemberTraceIdealAlong.mem_vanishingIdeal_of_isInSpanOnAt inter_subset_left hghol ?_
    exact IsInSpanOnAt.mono (fun s hs => ⟨hs.1, hs.2.mono fun p hp hpWD => hp hpWD.2⟩) hspan

/-- **The transform of `𝔟` is nonzero along `N'`**: over the centre a germ of `𝔟'` outside `π^*𝓘_C` on `N'` (clause 1
along `N'`) does not vanish identically on `N'`; off the centre `a ∘ π` lies, on `N'`, in the span of `𝔟'`
(`MonomialBlowupAlongChart.isInSpanOnAt_geoTransform_iff_pullback_of_notMem`) and does not vanish identically on `N'`
near `z`, along the holomorphic section of `π` over `X \ C`. -/
theorem isNonzeroAlongAt_geoTransform (hπ : IsBlowupAlong n C π) {N : Set X} (hN : IsClosedSubmanifold n N)
    (E : List (Set X)) {𝔟 : GermIdeal n X} (h𝔟 : 𝔟.IsCoherent) {o : ℕ} (hCb : C ⊆ cosupport n N 𝔟 o)
    (hbd : ∀ x ∈ C, x ∉ cosupport n N 𝔟 (o + 1)) (hnz : ∀ y ∈ N, IsNonzeroAlongAt N 𝔟 y)
    {y : Y} (hy : y ∈ geoStrictTransform π C N) :
    IsNonzeroAlongAt (geoStrictTransform π C N) ((⟨N, E, 𝔟, o⟩ : MarkedIdeal n X).geoTransform C π).ideal y := by
  set 𝔫 : MarkedIdeal n X := ⟨N, E, 𝔟, o⟩ with h𝔫
  by_cases hyC : π y ∈ C
  · obtain ⟨g, hg, hng⟩ := ExceptionalPushforwardAlong.exists_not_isInSpanOnAt_exceptionalDivisor hπ (𝔪 := 𝔫) hN h𝔟
      hCb hyC hy (hbd _ hyC)
    refine ⟨g, hg, ?_⟩
    by_contra hcon
    refine hng (isInSpanOnAt_of_eventually_eq_zero ?_)
    rw [Filter.not_frequently] at hcon
    exact hcon.mono fun p hp hpW => by
      by_contra h
      exact hp ⟨hpW, h⟩
  · have hπyN : π y ∈ N := geoStrictTransform_subset_preimage hπ.contMDiff.continuous hN.1 hy
    obtain ⟨a, ha, hfreq⟩ := hnz (π y) hπyN
    have hmem : (GermIdeal.pullback (m := n) π 𝔟).mem y (a ∘ π) := CompanionReduction.comp_mem_pullback' hπ h𝔟 ha
    have hahol : HolomorphicAt n (a ∘ π) y :=
      (MarkedIdealOperationsAlong.MarkedIdeal.hol_of_isCoherent h𝔟 _ _ ha).comp_contMDiff
        (Eventually.of_forall fun q => hπ.contMDiff q)
    have hspan : IsInSpanOnAt (n := n) (geoStrictTransform π C N) ((𝔫.geoTransform C π).ideal.mem y) y (a ∘ π) :=
      (MonomialBlowupAlongChart.isInSpanOnAt_geoTransform_iff_pullback_of_notMem hπ 𝔫 hyC (a ∘ π)).mpr
        (IsInSpanAt.restrict (isInSpanAt_self hmem hahol))
    refine isNonzeroAlongAt_of_isInSpanOnAt hspan ?_
    obtain ⟨s, hs, hsπ, hsz⟩ := BlowupIsomorphismOff.exists_section_compl hπ
    have hO : IsOpen Cᶜ := hπ.1.1.isOpen_compl
    have hcont : Tendsto s (𝓝 ⟨π y, hyC⟩) (𝓝 y) := by
      have h := hs.continuous.continuousAt (x := ⟨π y, hyC⟩)
      rwa [ContinuousAt, hsz y hyC] at h
    have hfreq' : ∃ᶠ p : ↥(Cᶜ : Set X) in 𝓝 ⟨π y, hyC⟩, p.1 ∈ N ∧ a p.1 ≠ 0 := by
      rw [nhds_subtype_eq_comap, Filter.frequently_comap]
      exact (hfreq.and_eventually (hO.mem_nhds hyC)).mono fun x ⟨hx, hxC⟩ => ⟨⟨x, hxC⟩, rfl, hx⟩
    refine hcont.frequently (hfreq'.mono fun p hp => ⟨?_, ?_⟩)
    · have hps : π (s p) = p.1 := congrFun hsπ p
      exact subset_closure (show π (s p) ∈ N \ C by rw [hps]; exact ⟨hp.1, p.2⟩)
    · have hps : π (s p) = p.1 := congrFun hsπ p
      simpa [Function.comp_apply, hps] using hp.2

open Classical in
/-- **One blowup of a product with a monomial factor, inside a submanifold** (`hir:nonmonomial-step-along`). Let `N` be
a closed submanifold, `E` simple normal crossings and transverse to `N`, `𝓜` coherent, nonzero and monomial along
`N`, `𝔟` coherent, nonzero along `N` and, restricted to `N`, contained in the ideal of no member at the points of
`N`; let the centre `C` of `π` have normal crossings with `E`, `C ⊆ cosupp(𝔟|_N, o) ∩ cosupp((𝔟𝓜)|_N, d)`,
`ord(𝔟|_N) ≤ o` on `C`. Then, with `N' = geoStrictTransform π C N` and `E' = (E_1', …, E_s', π⁻¹ C)`: `𝓜' =
(π^*𝓘_C)^{o - d} 𝓜''` is coherent, `Res_{N'} 𝔞' = Res_{N'} (𝔟' 𝓜')`, `𝓜'` is principal monomial along `N'` for `E'`
at every point of `N'`, and `𝔟'` is nonzero along `N'` and, restricted to `N'`, contained in the ideal of no member
of `E'` at the points of `N'`. -/
theorem step_along (hn : 0 < n) (hπ : IsBlowupAlong n C π) {N : Set X} (hN : IsClosedSubmanifold n N)
    {E : List (Set X)} (hE : IsSNCDivisor n E) (hT : IsTransverse n N E) {𝔟 𝓜 : GermIdeal n X}
    (h𝔟 : 𝔟.IsCoherent) (h𝓜 : 𝓜.IsCoherent) (hne𝓜 : ∀ y ∈ N, IsNonzeroAlongAt N 𝓜 y)
    (hmono : IsMonomialAlong n N 𝓜 E)
    (hnd : ∀ y ∈ N, ∀ i, y ∈ E.get i → ∃ a, 𝔟.mem y a ∧
      ¬ IsInSpanOnAt (n := n) N ((vanishingIdeal (n := n) (E.get i)).mem y) y a)
    (hnz : ∀ y ∈ N, IsNonzeroAlongAt N 𝔟 y) {o d : ℕ} (hnc : HasNormalCrossings n C E)
    (hCb : C ⊆ cosupport n N 𝔟 o) (hCa : C ⊆ cosupport n N (𝔟.mul 𝓜) d)
    (hbd : ∀ x ∈ C, x ∉ cosupport n N 𝔟 (o + 1)) :
    (monomialFactor n π C N E 𝓜 o d).IsCoherent ∧
      RestrictLe (geoStrictTransform π C N) ((⟨N, E, 𝔟.mul 𝓜, d⟩ : MarkedIdeal n X).geoTransform C π).ideal
        (((⟨N, E, 𝔟, o⟩ : MarkedIdeal n X).geoTransform C π).ideal.mul (monomialFactor n π C N E 𝓜 o d)) ∧
      RestrictLe (geoStrictTransform π C N)
        (((⟨N, E, 𝔟, o⟩ : MarkedIdeal n X).geoTransform C π).ideal.mul (monomialFactor n π C N E 𝓜 o d))
        ((⟨N, E, 𝔟.mul 𝓜, d⟩ : MarkedIdeal n X).geoTransform C π).ideal ∧
      (∀ z ∈ geoStrictTransform π C N, ∃ b, IsPrincipalAlongAt (geoStrictTransform π C N)
        (monomialFactor n π C N E 𝓜 o d) (E.map (geoStrictTransform π C) ++ [π ⁻¹' C]) z b) ∧
      (∀ y ∈ geoStrictTransform π C N, ∀ i, y ∈ (E.map (geoStrictTransform π C) ++ [π ⁻¹' C]).get i →
        ∃ a, ((⟨N, E, 𝔟, o⟩ : MarkedIdeal n X).geoTransform C π).ideal.mem y a ∧
          ¬ IsInSpanOnAt (n := n) (geoStrictTransform π C N)
            ((vanishingIdeal (n := n) ((E.map (geoStrictTransform π C) ++ [π ⁻¹' C]).get i)).mem y) y a) ∧
      ∀ y ∈ geoStrictTransform π C N,
        IsNonzeroAlongAt (geoStrictTransform π C N) ((⟨N, E, 𝔟, o⟩ : MarkedIdeal n X).geoTransform C π).ideal y := by
  have hhol𝔟 := MarkedIdealOperationsAlong.MarkedIdeal.hol_of_isCoherent h𝔟
  have hhol𝓜 := MarkedIdealOperationsAlong.MarkedIdeal.hol_of_isCoherent h𝓜
  have hCM : C ⊆ cosupport n N 𝓜 (d - o) := by
    intro x hx
    by_cases hod : o ≤ d
    · exact CompanionReductionAlong.mem_cosupport_of_mem_cosupport_mul_along hN.2 hhol𝔟 hhol𝓜 hod (hCa hx)
        (hbd x hx)
    · rw [show d - o = 0 by omega, cosupport_zero hhol𝓜]
      exact (hCb hx).1
  have hCadmM : (⟨N, E, 𝓜, d - o⟩ : MarkedIdeal n X).IsAdmissibleCentre C := ⟨hπ.1, hCM, hnc⟩
  obtain ⟨f1, f2⟩ := restrictLe_geoTransform_mul hπ hN E h𝔟 h𝓜 ⟨hπ.1, hCb, hnc⟩ hCadmM ⟨hπ.1, hCa, hnc⟩
  exact ⟨isCoherent_monomialFactor hπ hN E h𝓜 hCadmM, f1, f2,
    fun z hz => isPrincipalAlongAt_monomialFactor hn hπ hN hE hT h𝓜 hne𝓜 hmono hnc hCM hz,
    fun y hy i hyi => exists_not_isInSpanOnAt_geoTransform hπ hN hE hT h𝔟 hnc hCb hbd hnd hy i hyi,
    fun y hy => isNonzeroAlongAt_geoTransform hπ hN E h𝔟 hCb hbd hnz hy⟩

end Step

end

end Hironaka.NonmonomialStepAlong
