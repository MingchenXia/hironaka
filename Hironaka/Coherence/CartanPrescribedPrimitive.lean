/-!
# Primitive elements on the moment curve, and parametrization data for a prescribed one

Step 3 of the plan for Cartan's theorem on an irreducible germ (Demailly, *Complex analytic and differential
geometry*, II.4.13 and II.4.29).

Let `Q ⊆ 𝒪_n` be prime and in Noether position over `𝒪_d`, `K = Frac 𝒪_d`,
`L = Frac(𝒪_n / Q)`.  Demailly notes (II.4.13) that `u_c = ∑_{k ≥ d} c_k z_k` is a primitive
element of `L / K` unless `c` lies in finitely many proper subspaces.  We need this along the
moment curve `c(t)_k = t^k`:

* `finite_setOf_not_forall_mem_adjoin` (fields): if `L = K(x_0, …, x_{N-1})` is separable
  algebraic over `K ⊇ ℂ`, then `θ_t = ∑_j t^j x_j` generates `L` for all but finitely many
  `t ∈ ℂ`.  There are finitely many intermediate fields (primitive element theorem + Steinitz),
  and a proper one contains `θ_t` for at most `N - 1` values of `t` (Vandermonde).
* `IsDenomForm Q d c`: every fibre coordinate is, up to a nonzero factor of `𝒪_d`, a
  polynomial over `𝒪_d` in `u_c` modulo `Q` -- the form in which primitivity is consumed.
  `finite_setOf_not_isDenomForm`: it holds for `c = c(t)` for all but finitely many `t`.
* `exists_algebraicParametrization_of_isDenomForm`: for such a PRESCRIBED `c` (and prescribed
  minimal polynomials of the fibre coordinates) there is an `AlgebraicParametrization Q d`
  with `coef = c` (the tree's `exists_algebraicParametrization` chooses `c` itself).
-/

open Polynomial IntermediateField

namespace Hironaka.CartanPrescribedPrimitive

section Field

variable {K L : Type*} [Field K] [Field L] [Algebra K L]

/-- **Vandermonde step.**  If `∑_j t_i^j x_j ∈ M` for `N` distinct `t_i`, then every
`x_j ∈ M`. -/
theorem mem_of_forall_sum_pow_mem (ι : ℂ →+* K) {N : ℕ} (x : Fin N → L)
    (M : IntermediateField K L) (t : Fin N → ℂ) (ht : Function.Injective t)
    (hM : ∀ i, ∑ j : Fin N, algebraMap K L (ι (t i ^ j.1)) * x j ∈ M) (l : Fin N) : x l ∈ M := by
  classical
  set V : Matrix (Fin N) (Fin N) ℂ := Matrix.vandermonde t with hV
  have hdet : IsUnit V.det := isUnit_iff_ne_zero.2 (Matrix.det_vandermonde_ne_zero_iff.2 ht)
  have hinv : V⁻¹ * V = 1 := Matrix.nonsing_inv_mul V hdet
  have key : x l = ∑ i, algebraMap K L (ι (V⁻¹ l i)) *
      ∑ j : Fin N, algebraMap K L (ι (t i ^ j.1)) * x j := by
    simp_rw [Finset.mul_sum, ← mul_assoc, ← map_mul]
    rw [Finset.sum_comm]
    have hcoef : ∀ j : Fin N, ∑ i, algebraMap K L (ι (V⁻¹ l i * t i ^ j.1)) * x j =
        algebraMap K L (ι ((1 : Matrix (Fin N) (Fin N) ℂ) l j)) * x j := by
      intro j
      rw [← Finset.sum_mul, ← map_sum, ← map_sum, ← hinv, Matrix.mul_apply]
      simp only [hV, Matrix.vandermonde_apply]
    simp_rw [hcoef, Matrix.one_apply]
    simp
  rw [key]
  exact sum_mem fun i _ => M.mul_mem (M.algebraMap_mem _) (hM i)

/-- **Primitive elements along the moment curve.**  If `L` is separable algebraic over
`K ⊇ ℂ` and generated by `x_0, …, x_{N-1}`, then `θ_t = ∑_j t^j x_j` generates every `x_j` for
all but finitely many `t ∈ ℂ`. -/
theorem finite_setOf_not_forall_mem_adjoin [Algebra.IsAlgebraic K L] [Algebra.IsSeparable K L]
    (ι : ℂ →+* K) {N : ℕ} (x : Fin N → L)
    (hx : IntermediateField.adjoin K (Set.range x) = ⊤) :
    {t : ℂ | ¬ ∀ l, x l ∈ K⟮∑ j : Fin N, algebraMap K L (ι (t ^ j.1)) * x j⟯}.Finite := by
  classical
  -- a primitive element exists, hence finitely many intermediate fields
  obtain ⟨c, hc⟩ := GermPrimitiveElement.exists_forall_mem_adjoin_sum ι x
  have htop : K⟮∑ j, ι (c j) • x j⟯ = ⊤ := by
    rw [eq_top_iff, ← hx, IntermediateField.adjoin_le_iff]
    rintro _ ⟨l, rfl⟩
    exact hc l
  have : Finite (IntermediateField K L) :=
    Field.finite_intermediateField_of_exists_primitive_element K L ⟨_, htop⟩
  set θ : ℂ → L := fun t => ∑ j : Fin N, algebraMap K L (ι (t ^ j.1)) * x j with hθ
  -- a proper intermediate field contains `θ_t` for finitely many `t`
  have hfin : ∀ M : IntermediateField K L, M ≠ ⊤ → {t : ℂ | θ t ∈ M}.Finite := by
    intro M hM
    by_contra hinf
    obtain ⟨s, hs, hcard⟩ := Set.Infinite.exists_subset_card_eq hinf N
    let e : Fin N ≃ s := (Finset.equivFinOfCardEq hcard).symm
    have hall : ∀ l, x l ∈ M := mem_of_forall_sum_pow_mem ι x M (fun i => (e i : ℂ))
      (fun a b hab => e.injective (Subtype.ext hab)) (fun i => hs (e i).2)
    apply hM
    rw [eq_top_iff, ← hx, IntermediateField.adjoin_le_iff]
    rintro _ ⟨l, rfl⟩
    exact hall l
  refine (Set.Finite.biUnion (Set.toFinite {M : IntermediateField K L | M ≠ ⊤})
    fun M hM => hfin M hM).subset ?_
  intro t ht
  refine Set.mem_biUnion (x := K⟮θ t⟯) ?_ (mem_adjoin_simple_self K (θ t))
  intro htop'
  exact ht fun l => htop'.symm ▸ IntermediateField.mem_top

end Field

section Ring

variable {R S : Type*} [CommRing R] [IsDomain R] [CommRing S] [IsDomain S] [Algebra R S]
  {K L : Type*} [Field K] [Field L] [Algebra R K] [IsFractionRing R K] [Algebra S L]
  [IsFractionRing S L] [Algebra K L] [Algebra R L] [IsScalarTower R K L] [IsScalarTower R S L]

omit [IsDomain S] in
/-- An element of `S` lying in `K(θ)` is, up to a nonzero factor of `R`, a polynomial over `R`
in `θ`. -/
theorem exists_denom_of_mem_adjoin [Algebra.IsAlgebraic K L] {θ y : S}
    (hy : algebraMap S L y ∈ K⟮algebraMap S L θ⟯) :
    ∃ b : R, b ≠ 0 ∧ ∃ G : R[X], algebraMap R S b * y = aeval θ G := by
  rw [← IntermediateField.mem_toSubalgebra,
    IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic
      (Algebra.IsAlgebraic.isAlgebraic _),
    Algebra.adjoin_singleton_eq_range_aeval] at hy
  obtain ⟨g, hg⟩ := hy
  change aeval _ g = _ at hg
  obtain ⟨b, hbM, hb⟩ := IsLocalization.integerNormalization_spec (nonZeroDivisors R) g
  refine ⟨b, nonZeroDivisors.ne_zero hbM,
    IsLocalization.integerNormalization (nonZeroDivisors R) g, IsFractionRing.injective S L ?_⟩
  rw [← aeval_algebraMap_apply, ← aeval_map_algebraMap K, hb, Algebra.smul_def,
    Polynomial.algebraMap_apply, map_mul (aeval _), aeval_C, hg, map_mul,
    ← IsScalarTower.algebraMap_apply, ← IsScalarTower.algebraMap_apply]

omit [IsDomain R] [IsDomain S] [IsFractionRing R K] in
/-- If `S` is generated by the `x_i` over `R`, then `L` is generated by them over `K`. -/
theorem adjoin_range_eq_top {m : Type*} (x : m → S)
    (hgen : ∀ s : S, s ∈ Algebra.adjoin R (Set.range x)) :
    IntermediateField.adjoin K (Set.range fun i => algebraMap S L (x i)) = ⊤ := by
  rw [eq_top_iff]
  intro y _
  obtain ⟨a, b, -, rfl⟩ := IsFractionRing.div_surjective S y
  have hS : ∀ s : S, algebraMap S L s ∈
      IntermediateField.adjoin K (Set.range fun i => algebraMap S L (x i)) := by
    intro s
    induction (hgen s) using Algebra.adjoin_induction with
    | mem z hz =>
      obtain ⟨i, rfl⟩ := hz
      exact IntermediateField.subset_adjoin _ _ ⟨i, rfl⟩
    | algebraMap r =>
      rw [← IsScalarTower.algebraMap_apply R S L, IsScalarTower.algebraMap_apply R K L]
      exact IntermediateField.algebraMap_mem _ _
    | add a b _ _ ha hb =>
      rw [map_add]
      exact add_mem ha hb
    | mul a b _ _ ha hb =>
      rw [map_mul]
      exact mul_mem ha hb
  exact div_mem (hS a) (hS b)

omit [IsDomain S] in
/-- **Denominator form along the moment curve.**  If `S` is generated by `x_0, …, x_{N-1}` over
`R ⊇ ℂ` and `L / K` is separable algebraic, then for all but finitely many `t ∈ ℂ` every `x_l`
is, up to a nonzero factor of `R`, a polynomial over `R` in `θ_t = ∑_j t^j x_j`. -/
theorem finite_setOf_not_exists_denom [Algebra.IsAlgebraic K L] [Algebra.IsSeparable K L]
    (ι : ℂ →+* R) {N : ℕ} (x : Fin N → S)
    (hgen : ∀ s : S, s ∈ Algebra.adjoin R (Set.range x)) :
    {t : ℂ | ¬ ∀ l, ∃ b : R, b ≠ 0 ∧ ∃ G : R[X],
      algebraMap R S b * x l = aeval (∑ j : Fin N, algebraMap R S (ι (t ^ j.1)) * x j) G}.Finite := by
  refine (finite_setOf_not_forall_mem_adjoin (K := K) ((algebraMap R K).comp ι)
    (fun i => algebraMap S L (x i)) (adjoin_range_eq_top x hgen)).subset ?_
  intro t ht hmem
  apply ht
  intro l
  refine exists_denom_of_mem_adjoin (K := K) (L := L) ?_
  convert hmem l using 3
  simp only [map_sum, map_mul, RingHom.comp_apply]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [← IsScalarTower.algebraMap_apply R K L, IsScalarTower.algebraMap_apply R S L]

end Ring

section Germ

open Hironaka Hironaka.RegularLocusDense
open HolGerm GermAlgebraicParametrization

variable {n d : ℕ} {Q : Ideal (HolGerm (ComplexModel n))}

/-- The `𝒪_d`-algebra structure of `𝒪_n / Q` (local instance). -/
noncomputable abbrev quotientAlgebra (Q : Ideal (HolGerm (ComplexModel n))) (d : ℕ) :
    Algebra (HolGerm (ComplexModel d)) (HolGerm (ComplexModel n) ⧸ Q) :=
  (quotientStructureMap Q d).toAlgebra

attribute [local instance] quotientAlgebra

/-- The point `c(t) = (t^k)_k` of the moment curve. -/
def momentCoef (n : ℕ) (t : ℂ) : Fin n → ℂ := fun k => t ^ k.1

/-- **Denominator form of primitivity**: every fibre coordinate `z_k` (`d ≤ k`) is, up to a
nonzero factor `b ∈ 𝒪_d`, a polynomial over `𝒪_d` in `u_c = ∑_{k ≥ d} c_k z_k`, modulo `Q`. -/
def IsDenomForm (Q : Ideal (HolGerm (ComplexModel n))) (d : ℕ) (c : Fin n → ℂ) : Prop :=
  ∀ k : Fin n, d ≤ k.1 → ∃ b : HolGerm (ComplexModel d), b ≠ 0 ∧
    ∃ G : (HolGerm (ComplexModel d))[X],
      projGerm n d b * coord k - evalGerm n G (linearFormGerm n d c) ∈ Q

/-- The fibre coordinates modulo `Q` (zero for `k < d`). -/
noncomputable def fibreCoord (Q : Ideal (HolGerm (ComplexModel n))) (d : ℕ) (k : Fin n) :
    HolGerm (ComplexModel n) ⧸ Q :=
  if d ≤ k.1 then Ideal.Quotient.mk Q (coord k) else 0

theorem quotient_mk_evalGerm (F : (HolGerm (ComplexModel d))[X]) (g : HolGerm (ComplexModel n)) :
    Ideal.Quotient.mk Q (evalGerm n F g) = aeval (Ideal.Quotient.mk Q g) F := by
  rw [aeval_def, Polynomial.hom_eval₂]
  rfl

theorem quotient_mk_linearFormGerm (c : Fin n → ℂ) :
    Ideal.Quotient.mk Q (linearFormGerm n d c) =
      ∑ j, algebraMap (HolGerm (ComplexModel d)) _ (constHom (c j)) * fibreCoord Q d j := by
  simp only [linearFormGerm, map_sum]
  refine Finset.sum_congr rfl fun j _ => ?_
  by_cases hj : d ≤ j.1
  · simp only [fibreCoord, if_pos hj, map_mul]
    rfl
  · simp only [fibreCoord, if_neg hj, map_zero, mul_zero]

/-- Modulo `Q`, `𝒪_n` is generated over `𝒪_d` by the fibre coordinates (Demailly II.4.13). -/
theorem mem_adjoin_fibreCoord [Q.IsPrime] (hQ : IsNoetherNormalization Q d)
    (s : HolGerm (ComplexModel n) ⧸ Q) :
    s ∈ Algebra.adjoin (HolGerm (ComplexModel d)) (Set.range (fibreCoord Q d)) := by
  classical
  have hcoord : ∀ k : Fin n, ∃ p : Polynomial (HolGerm (ComplexModel d)),
      IsWeierstrass p ∧ evalGerm n p (coord k) ∈ Q := fun k => by
    have h0 : HolGerm.eval (coord k) = 0 := by
      simp [coord, coordGerm, HolGerm.eval_mk]
    obtain ⟨p, hp, -, hpm, -⟩ := GermMinimalPolynomial.exists_minpoly_isWeierstrass hQ _ h0
    exact ⟨p, hp, hpm⟩
  choose p hp hpm using hcoord
  obtain ⟨g, rfl⟩ := Ideal.Quotient.mk_surjective s
  obtain ⟨Rp, q, -, hg⟩ := GermMinimalPolynomial.exists_reduce hQ.le p (fun k _ => hp k) g
  have hsum : Ideal.Quotient.mk Q (∑ k : Fin n, if d ≤ k.1 then q k * evalGerm n (p k) (coord k)
      else 0) = 0 := by
    rw [Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.sum_mem _ fun k _ => by
      split_ifs
      · exact Ideal.mul_mem_left _ _ (hpm k)
      · exact Q.zero_mem
  rw [hg, map_add, hsum, add_zero]
  have hev : Ideal.Quotient.mk Q (MvPolynomial.eval₂ (projGerm n d) coord Rp) =
      MvPolynomial.aeval (fun i => Ideal.Quotient.mk Q (coord i)) Rp := by
    rw [MvPolynomial.aeval_def, MvPolynomial.hom_eval₂]
    rfl
  rw [hev]
  have hle : Algebra.adjoin (HolGerm (ComplexModel d))
      (Set.range fun i => Ideal.Quotient.mk Q (coord i)) ≤
      Algebra.adjoin (HolGerm (ComplexModel d)) (Set.range (fibreCoord Q d)) := by
    refine Algebra.adjoin_le ?_
    rintro _ ⟨i, rfl⟩
    by_cases hi : d ≤ i.1
    · exact Algebra.subset_adjoin ⟨i, by simp [fibreCoord, if_pos hi]⟩
    · have : coord i = projGerm n d (coordGerm d i.1 (not_le.1 hi)) := by
        rw [projGerm_coordGerm (not_le.1 hi) hQ.le]
      show Ideal.Quotient.mk Q (coord i) ∈ _
      rw [this]
      exact Subalgebra.algebraMap_mem _ (coordGerm d i.1 (not_le.1 hi))
  refine hle ?_
  rw [← MvPolynomial.aeval_range]
  exact ⟨Rp, rfl⟩

/-- **Primitive elements on the moment curve** (Demailly II.4.13): `u_{c(t)}` is primitive, in
denominator form, for all but finitely many `t ∈ ℂ`. -/
theorem finite_setOf_not_isDenomForm [Q.IsPrime] (hQ : IsNoetherNormalization Q d) :
    {t : ℂ | ¬ IsDenomForm Q d (momentCoef n t)}.Finite := by
  classical
  have : FaithfulSMul (HolGerm (ComplexModel d)) (HolGerm (ComplexModel n) ⧸ Q) :=
    (faithfulSMul_iff_algebraMap_injective _ _).2 hQ.injective
  have : Algebra.IsIntegral (HolGerm (ComplexModel d)) (HolGerm (ComplexModel n) ⧸ Q) :=
    ⟨hQ.isIntegral⟩
  let R := HolGerm (ComplexModel d)
  let S := HolGerm (ComplexModel n) ⧸ Q
  let K := FractionRing R
  let L := FractionRing S
  have : FaithfulSMul R L := (faithfulSMul_iff_algebraMap_injective R L).2
    GermPrimitiveElement.injective_algebraMap_fractionRing
  let _ : Algebra K L := FractionRing.liftAlgebra R L
  have : IsScalarTower R K L := FractionRing.isScalarTower_liftAlgebra R L
  have : CharZero K :=
    (RingHom.charZero_iff ((algebraMap R K).comp (constHom : ℂ →+* R)).injective).1 inferInstance
  have : Algebra.IsAlgebraic R L := (IsFractionRing.isAlgebraic_iff' R S L).1 inferInstance
  have : Algebra.IsAlgebraic K L :=
    ⟨fun y => (IsFractionRing.isAlgebraic_iff R K L).1 (Algebra.IsAlgebraic.isAlgebraic y)⟩
  refine (finite_setOf_not_exists_denom (K := K) (L := L) (constHom : ℂ →+* R) (fibreCoord Q d)
    (mem_adjoin_fibreCoord hQ)).subset ?_
  intro t ht hbad
  apply ht
  intro k hk
  obtain ⟨b, hb, G, hG⟩ := hbad k
  refine ⟨b, hb, G, ?_⟩
  rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, quotient_mk_evalGerm,
    quotient_mk_linearFormGerm, map_mul]
  have hx : Ideal.Quotient.mk Q (coord k) = fibreCoord Q d k := by
    simp [fibreCoord, if_pos hk]
  rw [hx]
  exact sub_eq_zero.2 hG

/-- **Primitive element data for a PRESCRIBED `c`** (Demailly II.4.13, II.4.15): the conclusion
of `GermPrimitiveElement.exists_primitiveElement` with `c` given, assuming primitivity of `u_c`
in denominator form. -/
theorem exists_primitiveData_of_isDenomForm [Q.IsPrime] (hQ : IsNoetherNormalization Q d)
    {c : Fin n → ℂ} (hc : IsDenomForm Q d c) :
    ∃ (W : (HolGerm (ComplexModel d))[X]) (δ : HolGerm (ComplexModel d))
      (B : Fin n → (HolGerm (ComplexModel d))[X]),
      IsWeierstrass W ∧ 0 < W.natDegree ∧ evalGerm n W (linearFormGerm n d c) ∈ Q ∧
      (∀ F : (HolGerm (ComplexModel d))[X], evalGerm n F (linearFormGerm n d c) ∈ Q → W ∣ F) ∧
      δ ≠ 0 ∧ (∀ k, (B k).natDegree < W.natDegree) ∧
      (∀ k : Fin n, d ≤ k.1 →
        projGerm n d δ * coord k - evalGerm n (B k) (linearFormGerm n d c) ∈ Q) ∧
      W ∣ (∑ k : Fin n, if d ≤ k.1 then C (constHom (c k)) * B k else 0) - C δ * X ∧
      ∃ a b : (HolGerm (ComplexModel d))[X], a * W + b * derivative W = C δ := by
  classical
  have : FaithfulSMul (HolGerm (ComplexModel d)) (HolGerm (ComplexModel n) ⧸ Q) :=
    (faithfulSMul_iff_algebraMap_injective _ _).2 hQ.injective
  have : Algebra.IsIntegral (HolGerm (ComplexModel d)) (HolGerm (ComplexModel n) ⧸ Q) :=
    ⟨hQ.isIntegral⟩
  have hev : ∀ (F : (HolGerm (ComplexModel d))[X]) (g : HolGerm (ComplexModel n)),
      Ideal.Quotient.mk Q (evalGerm n F g) = aeval (Ideal.Quotient.mk Q g) F :=
    fun F g => quotient_mk_evalGerm F g
  have hmem : ∀ (F : (HolGerm (ComplexModel d))[X]) (g : HolGerm (ComplexModel n)),
      evalGerm n F g ∈ Q ↔ aeval (Ideal.Quotient.mk Q g) F = 0 := fun F g => by
    rw [← hev, Ideal.Quotient.eq_zero_iff_mem]
  have halg : ∀ r, algebraMap (HolGerm (ComplexModel d)) (HolGerm (ComplexModel n) ⧸ Q) r =
      Ideal.Quotient.mk Q (projGerm n d r) := fun r => rfl
  set x : Fin n → HolGerm (ComplexModel n) ⧸ Q := fibreCoord Q d with hxdef
  have hu : Ideal.Quotient.mk Q (linearFormGerm n d c) =
      ∑ j, algebraMap (HolGerm (ComplexModel d)) _ (constHom (c j)) * x j :=
    quotient_mk_linearFormGerm c
  have hc' : ∀ i, ∃ b : HolGerm (ComplexModel d), b ≠ 0 ∧ ∃ G : (HolGerm (ComplexModel d))[X],
      algebraMap _ (HolGerm (ComplexModel n) ⧸ Q) b * x i =
        aeval (∑ j, algebraMap (HolGerm (ComplexModel d)) _ (constHom (c j)) * x j) G := by
    intro i
    by_cases hi : d ≤ i.1
    · obtain ⟨b, hb, G, hG⟩ := hc i hi
      refine ⟨b, hb, G, ?_⟩
      have h := Ideal.Quotient.eq_zero_iff_mem.2 hG
      rw [map_sub, map_mul, hev, hu] at h
      rw [halg, ← sub_eq_zero, ← h]
      simp [hxdef, fibreCoord, if_pos hi]
    · exact ⟨1, one_ne_zero, 0, by simp [hxdef, fibreCoord, if_neg hi]⟩
  have hu0 : HolGerm.eval (linearFormGerm n d c) = 0 := by
    rw [linearFormGerm, map_sum]
    refine Finset.sum_eq_zero fun k _ => ?_
    split_ifs
    · rw [map_mul, coord, coordGerm, eval_mk, map_zero, mul_zero]
    · exact map_zero _
  obtain ⟨W, hW, hWdeg, hWmem, hWdvd⟩ :=
    GermMinimalPolynomial.exists_minpoly_isWeierstrass hQ (linearFormGerm n d c) hu0
  obtain ⟨δ₁, hδ₁, a, b, hab⟩ := GermPrimitiveElement.exists_mul_add_mul_derivative_eq_C
    (constHom : ℂ →+* HolGerm (ComplexModel d)) hW.1 ((hmem W _).1 hWmem)
    fun F hF => hWdvd F ((hmem F _).2 hF)
  choose e he G hG using hc'
  obtain ⟨B, hBdef⟩ : ∃ B : Fin n → (HolGerm (ComplexModel d))[X], ∀ k,
      B k = (C (δ₁ * ∏ j ∈ Finset.univ.erase k, e j) * G k) %ₘ W := ⟨_, fun _ => rfl⟩
  have hW1 : W ≠ 1 := by
    rintro rfl
    simp at hWdeg
  have hB : ∀ k, aeval (Ideal.Quotient.mk Q (linearFormGerm n d c)) (B k) =
      algebraMap _ _ (δ₁ * ∏ j, e j) * x k := by
    intro k
    have h := congrArg (aeval (Ideal.Quotient.mk Q (linearFormGerm n d c)))
      (modByMonic_add_div (C (δ₁ * ∏ j ∈ Finset.univ.erase k, e j) * G k) W)
    rw [map_add, map_mul (aeval _) W, (hmem W _).1 hWmem, zero_mul, add_zero,
      map_mul (aeval _) (C _), aeval_C, hu,
      ← hG k] at h
    rw [hBdef, hu, h, ← mul_assoc, ← map_mul, mul_assoc,
      Finset.prod_erase_mul _ _ (Finset.mem_univ k)]
  refine ⟨W, δ₁ * ∏ j, e j, B, hW, hWdeg, hWmem, hWdvd,
    mul_ne_zero hδ₁ (Finset.prod_ne_zero_iff.2 fun k _ => he k),
    fun k => hBdef k ▸ natDegree_modByMonic_lt _ hW.1 hW1, fun k hk => ?_, hWdvd _ ?_,
    C (∏ j, e j) * a, C (∏ j, e j) * b, ?_⟩
  · rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, hev, hB, map_mul, halg]
    simp only [hxdef, fibreCoord, if_pos hk, sub_self]
  · rw [hmem]
    have hterm : ∀ k, aeval (Ideal.Quotient.mk Q (linearFormGerm n d c))
        (if d ≤ k.1 then C (constHom (c k) : HolGerm (ComplexModel d)) * B k else 0) =
        algebraMap (HolGerm (ComplexModel d)) _ (constHom (c k)) *
          (algebraMap (HolGerm (ComplexModel d)) _ (δ₁ * ∏ j, e j) * x k) := by
      intro k
      by_cases hk : d ≤ k.1
      · rw [if_pos hk, map_mul, aeval_C, hB]
      · simp only [hxdef, fibreCoord, if_neg hk, map_zero, mul_zero]
    rw [map_sub, map_sum, Finset.sum_congr rfl fun k _ => hterm k, map_mul (aeval _) (C _) X,
      aeval_C, aeval_X, hu,
      Finset.mul_sum, ← Finset.sum_sub_distrib]
    exact Finset.sum_eq_zero fun k _ => by ring
  · rw [C_mul]
    linear_combination C (∏ j, e j) * hab

/-- **Algebraic parametrization with a prescribed primitive element** and prescribed minimal
polynomials of the fibre coordinates. -/
theorem exists_algebraicParametrization_of_isDenomForm [Q.IsPrime]
    (hQ : IsNoetherNormalization Q d) (p : Fin n → (HolGerm (ComplexModel d))[X])
    (hp : ∀ k : Fin n, d ≤ k.1 → IsWeierstrass (p k))
    (hpm : ∀ k : Fin n, d ≤ k.1 → evalGerm n (p k) (coord k) ∈ Q)
    {c : Fin n → ℂ} (hc : IsDenomForm Q d c) :
    ∃ P : AlgebraicParametrization Q d, P.coef = c ∧ P.coordPoly = p := by
  obtain ⟨W, δ, B, hW, hWdeg, hWmem, hWdvd, hδ, hBdeg, hBmem, hrec, hbez⟩ :=
    exists_primitiveData_of_isDenomForm hQ hc
  exact ⟨{ le := hQ.le
           eq_zero_of_mem := hQ.eq_zero_of_mem
           coordPoly := p
           isWeierstrass_coordPoly := hp
           coordPoly_mem := hpm
           coef := c
           minpoly := W
           isWeierstrass_minpoly := hW
           natDegree_minpoly_pos := hWdeg
           minpoly_mem := hWmem
           dvd_of_mem := hWdvd
           disc := δ
           disc_ne_zero := hδ
           B := B
           natDegree_B_lt := hBdeg
           disc_mul_sub_mem := hBmem
           dvd_recover := hrec
           bezout := hbez
           exists_eqn := fun f hf => GermMinimalPolynomial.exists_eqn_of_not_mem hQ hf
           reduce := GermMinimalPolynomial.exists_reduce hQ.le p hp }, rfl, rfl⟩

/-- Weierstrass minimal polynomials of the fibre coordinates (chosen once, shared by all
primitive elements). -/
theorem exists_coordPoly [Q.IsPrime] (hQ : IsNoetherNormalization Q d) :
    ∃ p : Fin n → (HolGerm (ComplexModel d))[X], (∀ k, IsWeierstrass (p k)) ∧
      ∀ k, evalGerm n (p k) (coord k) ∈ Q := by
  have hcoord : ∀ k : Fin n, ∃ p : Polynomial (HolGerm (ComplexModel d)),
      IsWeierstrass p ∧ evalGerm n p (coord k) ∈ Q := fun k => by
    have h0 : HolGerm.eval (coord k) = 0 := by
      simp [coord, coordGerm, HolGerm.eval_mk]
    obtain ⟨p, hp, -, hpm, -⟩ := GermMinimalPolynomial.exists_minpoly_isWeierstrass hQ _ h0
    exact ⟨p, hp, hpm⟩
  choose p hp hpm using hcoord
  exact ⟨p, hp, hpm⟩

end Germ

