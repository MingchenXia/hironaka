section Generic

variable {X : Type*} [NormedAddCommGroup X] [NormedSpace ℂ X]

/-- Finitely many positive numbers have a positive lower bound. -/
theorem exists_pos_le {ι : Type*} [Finite ι] (f : ι → ℝ) (hf : ∀ i, 0 < f i) :
    ∃ ρ > 0, ∀ i, ρ ≤ f i := by
  rcases isEmpty_or_nonempty ι with hι | hι
  · exact ⟨1, one_pos, fun i => isEmptyElim i⟩
  · obtain ⟨i₀, hi₀⟩ := Finite.exists_min f
    exact ⟨f i₀, hf i₀, hi₀⟩

/-- The ideal generated by functions holomorphic near `x₀` is finitely generated near `x₀`. -/
theorem idealFGAt_inSpanAt {μ : Type} [Fintype μ] {s : μ → X → ℂ} {U : Set X} (hU : IsOpen U)
    {x₀ : X} (hx₀ : x₀ ∈ U) (hs : ∀ k, DifferentiableOn ℂ (s k) U) :
    IdealFGAt (fun y g => InSpanAt s y g) x₀ :=
  ⟨U, hU, hx₀, μ, inferInstance, s, hs, fun _ _ _ => Iff.rfl⟩

/-- **Finite sums** of finitely generated ideals are finitely generated. -/
theorem IdealFGAt.finSum {K : ℕ} {S : Fin K → X → (X → ℂ) → Prop} {x₀ : X}
    (h : ∀ i, IdealFGAt (S i) x₀) :
    IdealFGAt (fun y g => HolAt g y ∧ ∃ gs : Fin K → X → ℂ, (∀ i, S i y (gs i)) ∧
      g =ᶠ[𝓝 y] fun x => ∑ i, gs i x) x₀ := by
  classical
  choose U hU hx₀U μ hμ s hsd hsI using h
  refine ⟨⋂ i, U i, isOpen_iInter_of_finite hU, mem_iInter.2 hx₀U, Σ i, μ i, inferInstance,
    fun ik => s ik.1 ik.2, fun ik => (hsd ik.1 ik.2).mono (iInter_subset _ _), fun y hy g => ?_⟩
  have hyU : ∀ i, y ∈ U i := mem_iInter.1 hy
  have hsy : ∀ i k, HolAt (s i k) y := fun i k =>
    holAt_of_differentiableOn (hU i) (hsd i k) (hyU i)
  constructor
  · rintro ⟨hg, gs, hgs, hgsum⟩
    have hc : ∀ i, ∃ c : μ i → X → ℂ, (∀ k, HolAt (c k) y) ∧
        gs i =ᶠ[𝓝 y] fun x => ∑ k, c k x * s i k x := fun i =>
      ((hsI i y (hyU i) (gs i)).1 (hgs i)).2
    choose c hc hcs using hc
    refine ⟨hg, fun ik => c ik.1 ik.2, fun ik => hc ik.1 ik.2, ?_⟩
    filter_upwards [hgsum, eventually_all.2 hcs] with x hx hxc
    rw [hx, Fintype.sum_sigma]
    exact Finset.sum_congr rfl fun i _ => hxc i
  · rintro ⟨hg, c, hc, hgc⟩
    refine ⟨hg, fun i x => ∑ k, c ⟨i, k⟩ x * s i k x, fun i => (hsI i y (hyU i) _).2
      ⟨HolAt.fintype_sum fun k => (hc _).mul (hsy i k), fun k => c ⟨i, k⟩, fun k => hc _,
        EventuallyEq.rfl⟩, ?_⟩
    filter_upwards [hgc] with x hx
    rw [hx, Fintype.sum_sigma]

section Linear

variable (T : X ≃L[ℂ] X)

theorem eventually_comp_iff {p : X → Prop} (y : X) :
    (∀ᶠ w in 𝓝 (T.symm y), p (T w)) ↔ ∀ᶠ v in 𝓝 y, p v := by
  have h : Filter.map T (𝓝 (T.symm y)) = 𝓝 y := by
    rw [T.map_nhds_eq, T.apply_symm_apply]
  rw [← h, eventually_map]

theorem holAt_comp_iff {g : X → ℂ} (y : X) :
    HolAt (fun w => g (T w)) (T.symm y) ↔ HolAt g y := by
  constructor
  · intro h
    have h' := HolAt.comp (φ := fun v => T.symm v) (y := y) h T.symm.continuous
      (fun _ => T.symm.differentiableAt)
    have e : ((fun w => g (T w)) ∘ fun v => T.symm v) = g := funext fun v => by simp
    rwa [e] at h'
  · intro h
    have h1 : HolAt g ((fun w => T w) (T.symm y)) := by simpa using h
    exact HolAt.comp (φ := fun w => T w) h1 T.continuous fun _ => T.differentiableAt

theorem inSpanAt_comp_iff {μ : Type*} [Fintype μ] (s : μ → X → ℂ) (g : X → ℂ) (y : X) :
    InSpanAt s (T.symm y) (fun w => g (T w)) ↔ InSpanAt (fun k v => s k (T.symm v)) y g := by
  constructor
  · rintro ⟨hg, c, hc, hgc⟩
    refine ⟨(holAt_comp_iff T y).1 hg, fun k v => c k (T.symm v), fun k => ?_, ?_⟩
    · have h1 : HolAt (fun w => (fun v => c k (T.symm v)) (T w)) (T.symm y) := by
        simpa using hc k
      exact (holAt_comp_iff T y).1 h1
    · apply (eventually_comp_iff T (p := fun v =>
        g v = ∑ k, c k (T.symm v) * s k (T.symm v)) y).1
      filter_upwards [hgc] with w hw
      simpa using hw
  · rintro ⟨hg, c, hc, hgc⟩
    refine ⟨(holAt_comp_iff T y).2 hg, fun k w => c k (T w),
      fun k => (holAt_comp_iff T y).2 (hc k), ?_⟩
    have := (eventually_comp_iff T (p := fun v => g v = ∑ k, c k v * s k (T.symm v)) y).2 hgc
    filter_upwards [this] with w hw
    simpa using hw

/-- **Linear changes of coordinates**: if the vanishing ideal of `T⁻¹ A` is finitely generated
near `0`, so is that of `A`. -/
theorem idealFGAt_vanishingIdealF_of_linearEquiv {A : Set X}
    (h : IdealFGAt (vanishingIdealF (T ⁻¹' A)) 0) : IdealFGAt (vanishingIdealF A) 0 := by
  obtain ⟨U, hU, h0U, μ, _, s, hsd, hsI⟩ := h
  refine ⟨T.symm ⁻¹' U, hU.preimage T.symm.continuous, by simpa using h0U, μ, inferInstance,
    fun k v => s k (T.symm v), fun k => ?_, fun y hy g => ?_⟩
  · intro v hv
    exact (((hsd k).differentiableAt (hU.mem_nhds hv)).comp v
      T.symm.differentiableAt).differentiableWithinAt
  rw [← inSpanAt_comp_iff T s g y, ← hsI (T.symm y) hy]
  constructor
  · rintro ⟨hg, hgA⟩
    exact ⟨(holAt_comp_iff T y).2 hg,
      (eventually_comp_iff T (p := fun v => v ∈ A → g v = 0) y).2 hgA⟩
  · rintro ⟨hg, hgA⟩
    exact ⟨(holAt_comp_iff T y).1 hg,
      (eventually_comp_iff T (p := fun v => v ∈ A → g v = 0) y).1 hgA⟩

end Linear

end Generic

section Main

variable {n : ℕ} {A : Set (ComplexModel n)}

/-- **Colon elements vanish on `A`** (first inclusion of (4.30)): if `δ^m g` lies in the ideal of
the generators near `y`, then `g` vanishes on `A` near `y`, by density of `A ∖ {δ = 0}`. -/
theorem vanishingIdealF_of_colon (P : ParametrizationData A) {ρ₀ r₂ : ℝ}
    (hdense : A ∩ polydisc n P.dim ρ₀ r₂ ⊆ closure (A ∩ polydisc n P.dim ρ₀ r₂ ∩
      coordinateProjection n P.dim ⁻¹' {x | P.disc x ≠ 0}))
    {y : ComplexModel n} (hy : y ∈ polydisc n P.dim ρ₀ r₂ ∩ ball 0 P.rad)
    {g : ComplexModel n → ℂ}
    (hg : colonIdeal (fun y g => InSpanAt (gen P) y g)
      (fun z => P.disc (coordinateProjection n P.dim z) ^ colonExp P) y g) :
    vanishingIdealF A y g := by
  obtain ⟨hgh, -, c, -, hgc⟩ := hg
  have hopen : IsOpen (polydisc n P.dim ρ₀ r₂ ∩ ball (0 : ComplexModel n) P.rad) :=
    (isOpen_polydisc _ _ _ _).inter isOpen_ball
  have hev := (hgc.and hgh).and (hopen.mem_nhds hy)
  obtain ⟨N, hN, hNo, hyN⟩ := _root_.eventually_nhds_iff.1 hev
  refine ⟨hgh, eventually_of_mem (hNo.mem_nhds hyN) fun z hzN hzA => ?_⟩
  by_contra hgz
  have hcz : ContinuousAt g z := (hN z hzN).1.2.continuousAt
  have hev2 : ∀ᶠ w in 𝓝 z, g w ≠ 0 ∧ w ∈ N :=
    (hcz.eventually_ne hgz).and (hNo.mem_nhds hzN)
  have hzcl := hdense ⟨hzA, (hN z hzN).2.1⟩
  obtain ⟨w, ⟨hgw, hwN⟩, ⟨⟨hwA, -⟩, hwδ⟩⟩ := mem_closure_iff_nhds.1 hzcl _ hev2
  obtain ⟨⟨hid, -⟩, -, hwb⟩ := hN w hwN
  have hid' : g w * P.disc (coordinateProjection n P.dim w) ^ colonExp P =
      ∑ k, c k w * gen P k w := hid
  have h0 : g w * P.disc (coordinateProjection n P.dim w) ^ colonExp P = 0 := by
    rw [hid']
    exact Finset.sum_eq_zero fun k _ => by rw [gen_eq_zero P k hwA hwb, mul_zero]
  exact hgw ((mul_eq_zero.1 h0).resolve_right (pow_ne_zero _ hwδ))

theorem eq_zero_of_mem_closure {f : ComplexModel n → ℂ} {s : Set (ComplexModel n)}
    {y : ComplexModel n} (hf : ContinuousAt f y) (hy : y ∈ closure s) (hs : ∀ z ∈ s, f z = 0) :
    f y = 0 := by
  by_contra h
  obtain ⟨z, hz, hzs⟩ := mem_closure_iff_nhds.1 hy _ (hf.eventually_ne h)
  exact hz (hs z hzs)

theorem coordinateProjection_eq_of_forall (P : ParametrizationData A) {x y : ComplexModel n}
    (h : ∀ k : Fin n, k.1 < P.dim → y k = x k) :
    coordinateProjection n P.dim y = coordinateProjection n P.dim x := by
  ext a
  have ha : a.1 < n := lt_of_lt_of_le a.2 P.dim_le
  simp only [coordinateProjection_apply, dif_pos ha]
  exact h ⟨a.1, ha⟩ a.2

/-- **Fibre bound**: the points of `closure (A ∩ Δ)` agreeing with `x ∈ Δ` in the base
coordinates lie in a finite set with at most `∏_k (deg E_k + 1)` elements (their fibre
coordinates are roots of the `E_k(π x; ·)`). -/
theorem exists_finset_fibre (P : ParametrizationData A) {r₁ r₂ : ℝ} (hR : P.GoodRadii r₁ r₂)
    {x : ComplexModel n} (hx : x ∈ polydisc n P.dim r₁ r₂) :
    ∃ F : Finset (ComplexModel n), F.card ≤ ∏ k : Fin n, (P.s k + 1) ∧
      ∀ y ∈ closure (A ∩ polydisc n P.dim r₁ r₂), (∀ k : Fin n, k.1 < P.dim → y k = x k) →
        y ∈ F := by
  classical
  set x' := coordinateProjection n P.dim x with hx'
  have hx'b : x' ∈ ball (0 : ComplexModel P.dim) P.rad :=
    mem_ball_zero_iff.2 (hx.1.trans_le hR.r₁_le)
  set R : Fin n → Finset ℂ := fun k => if P.dim ≤ k.1 then
    (monicPoly (P.s k) (P.e k) x').roots.toFinset else {x k} with hRdef
  refine ⟨(Fintype.piFinset R).image (WithLp.toLp 2), ?_, fun y hy hyx => ?_⟩
  · refine Finset.card_image_le.trans ?_
    rw [Fintype.card_piFinset]
    refine Finset.prod_le_prod' fun k _ => ?_
    simp only [hRdef]
    split_ifs
    · refine (Multiset.toFinset_card_le _).trans ((card_roots' _).trans ?_)
      rw [(CartanKeyLemma.monicPoly_monic _ _ _).2]
      exact Nat.le_succ _
    · simp
  · have hπ := coordinateProjection_eq_of_forall P hyx
    refine Finset.mem_image.2 ⟨fun k => y k, Fintype.mem_piFinset.2 fun k => ?_, rfl⟩
    simp only [hRdef]
    split_ifs with hk
    · have hU : IsOpen (coordinateProjection n P.dim ⁻¹' ball (0 : ComplexModel P.dim) P.rad) :=
        isOpen_ball.preimage (coordinateProjection n P.dim).continuous
      have hyU : y ∈ coordinateProjection n P.dim ⁻¹' ball (0 : ComplexModel P.dim) P.rad := by
        show coordinateProjection n P.dim y ∈ ball (0 : ComplexModel P.dim) P.rad
        rw [hπ]
        exact hx'b
      have hcont : ContinuousAt (fun z => monicEval (P.s k) (P.e k)
          (coordinateProjection n P.dim z) (z k)) y :=
        ((differentiableOn_monicEval (a := fun j z => P.e k j (coordinateProjection n P.dim z))
          (P.s k) (fun j => differentiableOn_comp_proj P (P.differentiableOn_e k j))
          ((EuclideanSpace.proj (𝕜 := ℂ) k).differentiable.differentiableOn)).continuousOn
          ).continuousAt (hU.mem_nhds hyU)
      have h0 := eq_zero_of_mem_closure hcont hy fun z hz =>
        P.e_eq_zero z hz.1 (hR.polydisc_subset hz.2) k hk
      rw [Multiset.mem_toFinset, mem_roots (CartanKeyLemma.monicPoly_monic _ _ _).1.ne_zero,
        IsRoot.def, eval_monicPoly]
      rw [hπ] at h0
      exact h0
    · exact Finset.mem_singleton.2 (hyx k (not_le.1 hk))

/-- **General position on the moment curve**: with `K > M (n - 1)` distinct values `t_i`, for
every `x ∈ Δ` some `u_{t_i}` separates `x` from the other points of `closure (A ∩ Δ)` over `π x`. -/
theorem exists_separating (P : ParametrizationData A) {r₁ r₂ : ℝ} (hR : P.GoodRadii r₁ r₂)
    {K : ℕ} (t : Fin K → ℂ) (ht : Function.Injective t)
    (hK : (∏ k : Fin n, (P.s k + 1)) * (n - 1) < K) {x : ComplexModel n}
    (hx : x ∈ polydisc n P.dim r₁ r₂) :
    ∃ i : Fin K, ∀ y ∈ closure (A ∩ polydisc n P.dim r₁ r₂),
      (∀ k : Fin n, k.1 < P.dim → y k = x k) → y ≠ x →
        ∑ l : Fin n, (if P.dim ≤ l.1 then y l - x l else 0) * t i ^ l.1 ≠ 0 := by
  classical
  obtain ⟨F, hFcard, hF⟩ := exists_finset_fibre P hR hx
  set Y := F.filter fun y => (∀ k : Fin n, k.1 < P.dim → y k = x k) ∧ y ≠ x with hYdef
  set e := Y.equivFin.symm with he
  set lam : Fin Y.card → Fin n → ℂ := fun j l =>
    if P.dim ≤ l.1 then (e j : ComplexModel n) l - x l else 0 with hlam
  have hlam0 : ∀ j, lam j ≠ 0 := by
    intro j h0
    obtain ⟨-, hagree, hne⟩ := Finset.mem_filter.1 (e j).2
    apply hne
    ext l
    by_cases hl : P.dim ≤ l.1
    · have := congrFun h0 l
      simp only [hlam, if_pos hl, Pi.zero_apply] at this
      exact sub_eq_zero.1 this
    · exact hagree l (not_le.1 hl)
  have hcard : Y.card * (n - 1) < K :=
    lt_of_le_of_lt (Nat.mul_le_mul_right _ ((Finset.card_filter_le _ _).trans hFcard)) hK
  obtain ⟨i, hi⟩ := CartanGeneralPosition.exists_forall_sum_mul_pow_ne_zero lam hlam0 t ht hcard
  refine ⟨i, fun y hy hyx hne => ?_⟩
  have hyY : y ∈ Y := Finset.mem_filter.2 ⟨hF y hy hyx, hyx, hne⟩
  have := hi (e.symm ⟨y, hyY⟩)
  simp only [hlam, Equiv.apply_symm_apply] at this
  convert this using 2 with l

/-- The separation hypothesis of `CartanLocalInclusion.inSpanAt_gen` from the general-position
statement. -/
theorem sep_of (P : ParametrizationData A) {c : Fin n → ℂ} (hc : P.coef = fun k _ => c k)
    {r₁ r₂ : ℝ} {x : ComplexModel n}
    (h : ∀ y ∈ closure (A ∩ polydisc n P.dim r₁ r₂), (∀ k : Fin n, k.1 < P.dim → y k = x k) →
      y ≠ x → ∑ l : Fin n, (if P.dim ≤ l.1 then y l - x l else 0) * c l ≠ 0) :
    ∀ y ∈ closure (A ∩ polydisc n P.dim r₁ r₂),
      coordinateProjection n P.dim y = coordinateProjection n P.dim x →
      fibreForm P.dim P.coef y = fibreForm P.dim P.coef x → y = x := by
  intro y hy hπ hu
  by_contra hne
  have hagree : ∀ k : Fin n, k.1 < P.dim → y k = x k := by
    intro k hk
    have := congrArg (fun w : ComplexModel P.dim => w ⟨k.1, hk⟩) hπ
    simpa [coordinateProjection_apply, k.2] using this
  apply h y hy hagree hne
  rw [hc] at hu
  simp only [fibreForm] at hu
  rw [← sub_eq_zero, ← Finset.sum_sub_distrib] at hu
  rw [← hu]
  refine Finset.sum_congr rfl fun l _ => ?_
  split_ifs <;> ring

/-- Good radii common to finitely many parametrizations on one ball. -/
theorem exists_goodRadii_family {K : ℕ} (P : Fin K → ParametrizationData A) {ρ : ℝ}
    (hρ : 0 < ρ) (hPρ : ∀ i, (P i).rad = ρ) : ∃ r₁ r₂, ∀ i, (P i).GoodRadii r₁ r₂ := by
  set r₂ := ρ / (n + 1) with hr₂
  have hr₂0 : 0 < r₂ := div_pos hρ (by positivity)
  have hroot := fun i => (P i).exists_root_bound hr₂0
  choose η hη hηs using hroot
  obtain ⟨η₀, hη₀, hη₀le⟩ := exists_pos_le η hη
  have hr₂le : r₂ ≤ ρ := div_le_self hρ.le (by linarith [(n.cast_nonneg : (0 : ℝ) ≤ n)])
  refine ⟨min η₀ r₂, r₂, fun i => ⟨lt_min hη₀ hr₂0, hr₂0,
    (min_le_right _ _).trans (hr₂le.trans (hPρ i).ge), ?_,
    fun x hx => hηs i x (hx.trans_le ((min_le_left _ _).trans (hη₀le i)))⟩⟩
  refine (polydisc_mono (min_le_right _ _)).trans ((polydisc_subset_ball hr₂0).trans ?_)
  refine ball_subset_ball (le_of_eq ?_)
  rw [hPρ i, hr₂]
  field_simp

end Main

section Assembly

variable {n : ℕ} {A : Set (ComplexModel n)}

/-- **Cartan's theorem for an irreducible germ in Noether position** (Demailly II.4.29). -/
theorem idealFGAt_vanishingIdealF_of_isNoetherNormalization (hA : IsAnalyticGerm A)
    [(vanishingIdeal A).IsPrime] {d : ℕ} (hN : IsNoetherNormalization (vanishingIdeal A) d) :
    IdealFGAt (vanishingIdealF A) 0 := by
  classical
  obtain ⟨p, hp, hpm⟩ := exists_coordPoly hN
  set M := ∏ k : Fin n, ((p k).natDegree + 1) with hM
  set K := M * (n - 1) + 1 with hK
  -- `K` primitive elements on the moment curve
  have hinf : ({t : ℂ | ¬ IsDenomForm (vanishingIdeal A) d (momentCoef n t)}ᶜ).Infinite :=
    (finite_setOf_not_isDenomForm hN).infinite_compl
  set emb := hinf.natEmbedding with hemb
  set t : Fin K → ℂ := fun i => (emb i.1 : ℂ) with htdef
  have ht : Function.Injective t := fun i j h => Fin.ext (emb.injective (Subtype.ext h))
  have htgood : ∀ i, IsDenomForm (vanishingIdeal A) d (momentCoef n (t i)) := fun i => by
    have h := (emb i.1).2
    rw [Set.mem_compl_iff, Set.mem_ofPred_eq, not_not] at h
    exact h
  have hAP : ∀ i : Fin K, ∃ AP : AlgebraicParametrization (vanishingIdeal A) d,
      AP.coef = momentCoef n (t i) ∧ AP.coordPoly = p := fun i =>
    exists_algebraicParametrization_of_isDenomForm hN p (fun k _ => hp k) (fun k _ => hpm k)
      (htgood i)
  choose AP hAPc hAPp using hAP
  -- parametrization data on one ball
  have hrad := fun i => exists_radius_parametrizationData hA (AP i)
  choose ρ₀ hρ₀ hρ₀s using hrad
  obtain ⟨ρ, hρ, hρle⟩ := exists_pos_le ρ₀ hρ₀
  have hPD := fun i => hρ₀s i ρ hρ (hρle i)
  choose P hPdim hPrad hPcoef hPs using hPD
  obtain ⟨r₁, r₂, hR⟩ := exists_goodRadii_family P hρ hPrad
  -- density radii
  have hD : ∀ i, ∃ ρD > 0, ∃ rD > 0, A ∩ polydisc n (P i).dim ρD rD ⊆
      closure (A ∩ polydisc n (P i).dim ρD rD ∩
        coordinateProjection n (P i).dim ⁻¹' {x | (P i).disc x ≠ 0}) := fun i => by
    obtain ⟨S⟩ := nonempty_setsData (P i)
    obtain ⟨ρD, hρD, hdense⟩ := exists_dense (P i) S
    exact ⟨ρD, hρD, S.r₂, S.r₂_pos, hdense⟩
  choose ρD hρD rD hrD hdense using hD
  -- the colon ideals `(G_i : δ_i^{m_i})`
  set S : Fin K → ComplexModel n → (ComplexModel n → ℂ) → Prop := fun i =>
    colonIdeal (fun y g => InSpanAt (gen (P i)) y g)
      (fun z => (P i).disc (coordinateProjection n (P i).dim z) ^ colonExp (P i)) with hSdef
  have hS : ∀ i, IdealFGAt (S i) 0 := fun i => by
    have hU : IsOpen (coordinateProjection n (P i).dim ⁻¹' ball (0 : ComplexModel (P i).dim)
        (P i).rad) := isOpen_ball.preimage (coordinateProjection n _).continuous
    have h0U : (0 : ComplexModel n) ∈ coordinateProjection n (P i).dim ⁻¹'
        ball (0 : ComplexModel (P i).dim) (P i).rad := by
      simp [(P i).rad_pos]
    exact IdealFGAt.colon (OkaCoherence.okaProperty_euclidean n)
      (idealFGAt_inSpanAt hU h0U (differentiableOn_gen (P i)))
      (holAt_of_differentiableOn hU
        ((differentiableOn_comp_proj (P i) (P i).differentiableOn_disc).pow _) h0U)
  refine (IdealFGAt.finSum hS).congr ?_
  -- the common neighbourhood
  have hK0 : 0 < K := Nat.succ_pos _
  set i₀ : Fin K := ⟨0, hK0⟩ with hi₀
  have hV : ∀ᶠ y in 𝓝 (0 : ComplexModel n), y ∈ polydisc n d r₁ r₂ ∧
      ∀ i, y ∈ polydisc n (P i).dim (ρD i) (rD i) ∩ ball 0 (P i).rad := by
    refine Filter.Eventually.and (show ∀ᶠ y in 𝓝 (0 : ComplexModel n), y ∈ polydisc n d r₁ r₂ from
      (isOpen_polydisc n d r₁ r₂).mem_nhds
        (zero_mem_polydisc (hR i₀).r₁_pos (hR i₀).r₂_pos)) (eventually_all.2 fun i => ?_)
    exact ((isOpen_polydisc _ _ _ _).inter isOpen_ball).mem_nhds
      ⟨zero_mem_polydisc (hρD i) (hrD i), mem_ball_self (P i).rad_pos⟩
  filter_upwards [hV] with y hy g
  obtain ⟨hyΔ, hyi⟩ := hy
  constructor
  · -- `∑ S_i ⊆ I_A`
    rintro ⟨hg, gs, hgs, hgsum⟩
    have hv : ∀ i, vanishingIdealF A y (gs i) := fun i =>
      vanishingIdealF_of_colon (P i) (hdense i) (hyi i) (hgs i)
    refine ⟨hg, ?_⟩
    filter_upwards [hgsum, eventually_all.2 fun i => (hv i).2] with z hz hzi hzA
    rw [hz]
    exact Finset.sum_eq_zero fun i _ => hzi i hzA
  · -- `I_A ⊆ ∑ S_i`: a separating primitive element
    intro hg
    have hMs : (∏ k : Fin n, ((P i₀).s k + 1)) * (n - 1) < K := by
      rw [hPs i₀]
      simp only [hAPp i₀]
      exact Nat.lt_succ_self _
    have hyΔ₀ : y ∈ polydisc n (P i₀).dim r₁ r₂ := by
      rw [hPdim i₀]
      exact hyΔ
    obtain ⟨i, hi⟩ := exists_separating (P i₀) (hR i₀) t ht hMs hyΔ₀
    have hi' : ∀ y' ∈ closure (A ∩ polydisc n (P i).dim r₁ r₂),
        (∀ k : Fin n, k.1 < (P i).dim → y' k = y k) → y' ≠ y →
          ∑ l : Fin n, (if (P i).dim ≤ l.1 then y' l - y l else 0) * momentCoef n (t i) l ≠ 0 := by
      rw [hPdim i]
      rw [hPdim i₀] at hi
      exact hi
    have hc : (P i).coef = fun k _ => momentCoef n (t i) k :=
      funext fun k => funext fun x => by rw [hPcoef i k x, hAPc i]
    have hyΔi : y ∈ polydisc n (P i).dim r₁ r₂ := by
      rw [hPdim i]
      exact hyΔ
    have hin := inSpanAt_gen (P i) hc (hR i) hyΔi (sep_of (P i) hc hi') hg
    refine ⟨hg.1, fun j => if j = i then g else 0, fun j => ?_,
      Eventually.of_forall fun z => ?_⟩
    swap
    · show g z = ∑ j, (if j = i then g else 0) z
      rw [Finset.sum_eq_single i (fun j _ hj => by simp [hj]) (by simp)]
      simp
    by_cases hj : j = i
    · subst hj
      simp only [if_true]
      refine ⟨hg.1, ?_⟩
      have e : (fun x => g x * (P j).disc (coordinateProjection n (P j).dim x) ^ colonExp (P j)) =
          fun z => (P j).disc (coordinateProjection n (P j).dim z) ^ colonExp (P j) * g z :=
        funext fun _ => mul_comm _ _
      show InSpanAt (gen (P j)) y _
      rw [e]
      exact hin
    · simp only [hj, if_false]
      refine ⟨holAt_const 0 y, ?_⟩
      have e : (fun x => (0 : ComplexModel n → ℂ) x *
          (P j).disc (coordinateProjection n (P j).dim x) ^ colonExp (P j)) = fun _ => 0 :=
        funext fun _ => by simp
      show InSpanAt (gen (P j)) y _
      rw [e]
      exact ⟨holAt_const 0 y, fun _ _ => 0, fun _ => holAt_const 0 y,
        Eventually.of_forall fun _ => by simp⟩

/-- **Cartan's theorem for irreducible germs** (`IrreducibleLocalCartan n`): the vanishing ideal
of an irreducible analytic germ at `0 ∈ ℂⁿ` is finitely generated near `0`. -/
theorem irreducibleLocalCartan (n : ℕ) : CartanIrreducibleReduction.IrreducibleLocalCartan n := by
  intro B hB
  have hprime : (vanishingIdeal B).IsPrime := (isIrreducibleGerm_iff_isPrime hB.1).1 hB
  obtain ⟨d, L, hN⟩ := exists_isNoetherNormalization (vanishingIdeal B)
  rw [GermParametrization.map_vanishingIdeal_comapEquiv] at hN
  have : (vanishingIdeal (L ⁻¹' B)).IsPrime := by
    rw [← GermParametrization.map_vanishingIdeal_comapEquiv]
    exact Ideal.map_isPrime_of_equiv _
  exact idealFGAt_vanishingIdealF_of_linearEquiv L
    (idealFGAt_vanishingIdealF_of_isNoetherNormalization
      (GermParametrization.isAnalyticGerm_preimage L hB.1) hN)

/-- **Cartan's coherence theorem** (H. Cartan 1950; Demailly II.4.29) on every complex manifold:
the ideal sheaf of every analytic subset is coherent. -/
theorem cartanCoherence {n : ℕ} {X : Type*} [TopologicalSpace X]
    [ChartedSpace (ComplexModel n) X] [IsComplexManifold n X] :
    CartanComponentIdeal.CartanCoherence n X :=
  CartanIrreducibleReduction.cartanCoherence_of_irreducibleLocalCartan (irreducibleLocalCartan n)

