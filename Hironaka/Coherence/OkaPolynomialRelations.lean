import Mathlib.Algebra.Polynomial.Div
import Mathlib.Algebra.BigOperators.Option
import Mathlib.Algebra.Polynomial.BigOperators
import Mathlib.Tactic.LinearCombination
set_option autoImplicit false

/-!
# Oka's key lemma, algebraic form: relations are generated by polynomial relations

Source: Oka's coherence theorem, the step "relations of a Weierstrass system are generated by
polynomial relations" (Grauert--Remmert, *Coherent analytic sheaves*, Ch. 2 §5; Demailly,
*Complex analytic and differential geometry*, II.3.19--3.20; Gunning--Rossi, IV.C).

Let `Φ : R[X] →+* S` be an injective ring homomorphism into a domain (in the application
`R = 𝒪_{E,z₀}`, `S = 𝒪_{E×ℂ,(z₀,t₀)}` and `Φ` evaluates a polynomial in `t` at the germ of
`t`).  Let `W ∈ R[X]` be monic, and suppose that at the point under consideration `W` splits
as `W = W' W''` with `W'` monic, `Φ W''` a unit, and division by `Φ W'` with polynomial
remainder of degree `< deg W'` (existence and uniqueness of the remainder).  This is the local
Weierstrass picture of a Weierstrass polynomial at an arbitrary point `(z₀, t₀)`: `W'` collects
the roots near `t₀`.

`exists_eq_sum_polynomialRelations`: if `g_1, …, g_q ∈ R[X]` have degree `≤ D` and
`g_{j₀} = W` (indexed by any finite type `ι`), every relation `∑ a_j Φ(g_j) = 0` with `a_j ∈ S`
is an `S`-combination of the images of `|ι| + 1` polynomial relations `∑ P_j g_j = 0` with
`deg P_j ≤ 2D` (indexed by `Option ι`).

## Proof

Write `u = Φ W''` (a unit) and divide: `a_j = c_j Φ W' + Φ ρ_j`, `deg ρ_j < deg W'`.  With the
trivial relations `κ_j = g_j e_{j₀} - W e_j`, the relation `b = u a + ∑ c_j Φ κ_j` has
`b_i = Φ(W'' ρ_i)` for `i ≠ j₀`, hence `b_{j₀} Φ W = Φ P` with
`P = -∑_{i ≠ j₀} W'' ρ_i g_i`.  Divide `P = W Q + R₁` and `R₁ = W' Q' + R'` (monic divisions in
`R[X]`); then `Φ R' = Φ W' · (u (b_{j₀} - Φ Q) - Φ Q')`, so `R' = 0` by uniqueness and
`u b_{j₀} = Φ(W'' Q + Q')` after cancelling `Φ W' ≠ 0`.  Hence `u b = Φ π` for the polynomial
vector `π = (W'' Q + Q' at j₀, W''² ρ_i at i ≠ j₀)`, which is a relation since `Φ` is
injective, and `a = u⁻² Φ π - u⁻¹ ∑ c_j Φ κ_j`.  All degrees are `≤ 2D`.
-/

open Polynomial

namespace Hironaka.OkaPolynomialRelations

noncomputable section

variable {R S : Type*} [CommRing R] [CommRing S]

/-- The trivial relation `κ_j = g_j e_{j₀} - g_{j₀} e_j` among `g_1, …, g_q`. -/
def trivialRelation {ι : Type*} [DecidableEq ι] (g : ι → R[X]) (j₀ j : ι) : ι → R[X] :=
  fun i => (if i = j₀ then g j else 0) - (if i = j then g j₀ else 0)

theorem sum_trivialRelation_mul {ι : Type*} [Fintype ι] [DecidableEq ι] (g : ι → R[X])
    (j₀ j : ι) :
    ∑ i, trivialRelation g j₀ j i * g i = 0 := by
  simp only [trivialRelation, sub_mul, ite_mul, zero_mul, Finset.sum_sub_distrib,
    Finset.sum_ite_eq', Finset.mem_univ, if_true]
  ring

theorem natDegree_trivialRelation_le {ι : Type*} [DecidableEq ι] (g : ι → R[X]) (j₀ j : ι)
    {D : ℕ} (hgD : ∀ j, (g j).natDegree ≤ D) (i : ι) : (trivialRelation g j₀ j i).natDegree ≤ D := by
  refine (natDegree_sub_le _ _).trans (max_le ?_ ?_)
  · split_ifs
    · exact hgD j
    · simp
  · split_ifs
    · exact hgD j₀
    · simp

/-- **Oka's key lemma, algebraic form.**  Relations among `Φ g_1, …, Φ g_q` (with
`g_{j₀} = W` monic and `deg g_j ≤ D`) are generated by the images of polynomial relations of
degree `≤ 2D`, given the local splitting `W = W' W''` with `Φ W''` a unit and Weierstrass
division (existence and uniqueness of the remainder) by `Φ W'`. -/
theorem exists_eq_sum_polynomialRelations [IsDomain S] (Φ : R[X] →+* S)
    (hΦ : Function.Injective Φ) {W W' W'' : R[X]} (hW : W.Monic) (hW' : W'.Monic)
    (hfac : W = W' * W'') (hu : IsUnit (Φ W''))
    (hdiv : ∀ h : S, ∃ (c : S) (ρ : R[X]), ρ.degree < W'.degree ∧ h = c * Φ W' + Φ ρ)
    (huniq : ∀ (ρ : R[X]) (c : S), ρ.degree < W'.degree → Φ ρ = c * Φ W' → ρ = 0)
    {ι : Type*} [Fintype ι] [DecidableEq ι] (g : ι → R[X]) (j₀ : ι) (hg₀ : g j₀ = W) {D : ℕ}
    (hgD : ∀ j, (g j).natDegree ≤ D) (a : ι → S) (ha : ∑ j, a j * Φ (g j) = 0) :
    ∃ (c : Option ι → S) (P : Option ι → ι → R[X]),
      (∀ l j, (P l j).natDegree ≤ 2 * D) ∧ (∀ l, ∑ j, P l j * g j = 0) ∧
        ∀ j, a j = ∑ l, c l * Φ (P l j) := by
  have hRnt : Nontrivial R := by
    by_contra h
    rw [not_nontrivial_iff_subsingleton] at h
    have h1 : (1 : R[X]) = 0 := Subsingleton.elim _ _
    have h2 := congrArg Φ h1
    rw [map_one, map_zero] at h2
    exact one_ne_zero h2
  set u := Φ W'' with hudef
  obtain ⟨v, hv⟩ : ∃ v, v * u = 1 := hu.exists_left_inv
  choose c ρ hρ hdivj using fun j => hdiv (a j)
  have hW'ne : W' ≠ 0 := hW'.ne_zero
  have hΦW'ne : Φ W' ≠ 0 := fun h => hW'ne (hΦ (by rw [h, map_zero]))
  have hΦW : Φ W = Φ W' * u := by rw [hfac, map_mul]
  -- the relation `b = u a + ∑ c_j Φ κ_j`
  set κ := trivialRelation g j₀ with hκ
  set b : ι → S := fun i => u * a i + ∑ j, c j * Φ (κ j i) with hbdef
  have hb_rel : ∑ i, b i * Φ (g i) = 0 := by
    have hκrel : ∀ j, ∑ i, Φ (κ j i) * Φ (g i) = 0 := fun j => by
      simpa only [map_sum, map_mul, map_zero] using congrArg Φ (sum_trivialRelation_mul g j₀ j)
    calc ∑ i, b i * Φ (g i)
        = u * ∑ i, a i * Φ (g i) + ∑ j, c j * ∑ i, Φ (κ j i) * Φ (g i) := by
          simp only [hbdef, add_mul, Finset.sum_add_distrib, Finset.mul_sum, Finset.sum_mul]
          rw [Finset.sum_comm (f := fun i j => c j * Φ (κ j i) * Φ (g i))]
          congr 1
          · exact Finset.sum_congr rfl fun i _ => by ring
          · exact Finset.sum_congr rfl fun j _ => Finset.sum_congr rfl fun i _ => by ring
      _ = 0 := by simp [ha, hκrel]
  have hκ_ne : ∀ i, i ≠ j₀ → ∑ j, c j * Φ (κ j i) = -(c i * Φ W) := by
    intro i hi
    simp only [hκ, trivialRelation, if_neg hi, zero_sub, map_neg, mul_neg, Finset.sum_neg_distrib,
      apply_ite Φ, map_zero, mul_ite, mul_zero, Finset.sum_ite_eq, Finset.mem_univ, if_true, hg₀]
  have hb_ne : ∀ i, i ≠ j₀ → b i = Φ (W'' * ρ i) := by
    intro i hi
    simp only [hbdef, hκ_ne i hi, hdivj i, hΦW, map_mul]
    ring
  -- the polynomial `P = -∑_{i ≠ j₀} W'' ρ_i g_i` and the divisions
  set P : R[X] := -∑ i ∈ Finset.univ.erase j₀, W'' * ρ i * g i with hPdef
  have hbP : b j₀ * Φ W = Φ P := by
    have hsplit := Finset.add_sum_erase Finset.univ (fun i => b i * Φ (g i)) (Finset.mem_univ j₀)
    rw [hb_rel, hg₀] at hsplit
    rw [hPdef, map_neg, map_sum, eq_neg_iff_add_eq_zero, ← hsplit]
    congr 1
    refine Finset.sum_congr rfl fun i hi => ?_
    rw [hb_ne i (Finset.ne_of_mem_erase hi)]
    simp only [map_mul]
  set Q := P /ₘ W with hQ
  set R₁ := P %ₘ W with hR₁
  set Q' := R₁ /ₘ W' with hQ'
  set R' := R₁ %ₘ W' with hR'
  have hPdiv : R₁ + W * Q = P := modByMonic_add_div P W
  have hR₁div : R' + W' * Q' = R₁ := modByMonic_add_div R₁ W'
  have h1 : Φ R' + Φ W' * Φ Q' = Φ R₁ := by
    have := congrArg Φ hR₁div
    simpa only [map_add, map_mul] using this
  have h2 : Φ R₁ + Φ W * Φ Q = Φ P := by
    have := congrArg Φ hPdiv
    simpa only [map_add, map_mul] using this
  have hR'zero : R' = 0 :=
    huniq R' (u * (b j₀ - Φ Q) - Φ Q') (degree_modByMonic_lt R₁ hW')
      (by linear_combination h1 + h2 - hbP + (b j₀ - Φ Q) * hΦW)
  have hbj₀ : u * b j₀ = Φ (W'' * Q + Q') := by
    have h3 : Φ W' * (u * (b j₀ - Φ Q) - Φ Q') = 0 := by
      have h0 : Φ R' = 0 := by rw [hR'zero, map_zero]
      linear_combination -(h1 + h2 - hbP + (b j₀ - Φ Q) * hΦW) + h0
    have h4 := (mul_eq_zero.1 h3).resolve_left hΦW'ne
    rw [map_add, map_mul, ← hudef]
    linear_combination h4
  -- the polynomial relation `π` with `u b = Φ π`
  set π : ι → R[X] := fun i => if i = j₀ then W'' * Q + Q' else W'' * W'' * ρ i with hπdef
  have hπ : ∀ i, u * b i = Φ (π i) := by
    intro i
    by_cases hi : i = j₀
    · subst hi
      simp only [hπdef, if_true]
      exact hbj₀
    · simp only [hπdef, if_neg hi, hb_ne i hi, map_mul, ← hudef]
      ring
  have hπrel : ∑ i, π i * g i = 0 := by
    refine hΦ ?_
    rw [map_sum, map_zero]
    calc ∑ i, Φ (π i * g i) = u * ∑ i, b i * Φ (g i) := by
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [map_mul, ← hπ i]
          ring
      _ = 0 := by rw [hb_rel, mul_zero]
  -- degree bounds
  have hWne : W ≠ 0 := hW.ne_zero
  have hW''ne : W'' ≠ 0 := by
    rintro h
    exact hWne (by rw [hfac, h, mul_zero])
  have hdeg : W'.natDegree + W''.natDegree = W.natDegree := by
    rw [hfac, hW'.natDegree_mul' hW''ne]
  have hdD : W.natDegree ≤ D := hg₀ ▸ hgD j₀
  have hρdeg : ∀ i, (ρ i).natDegree ≤ W'.natDegree := fun i =>
    natDegree_le_natDegree (hρ i).le
  have hPdeg : P.natDegree ≤ W.natDegree + D := by
    rw [hPdef, natDegree_neg]
    refine natDegree_sum_le_of_forall_le _ _ fun i _ => ?_
    refine (natDegree_mul_le).trans ?_
    have h1 := natDegree_mul_le (p := W'') (q := ρ i)
    have h2 := hρdeg i
    have h3 := hgD i
    omega
  have hQdeg : Q.natDegree ≤ D := by
    rw [hQ, natDegree_divByMonic _ hW]
    omega
  have hQ'deg : Q'.natDegree ≤ W.natDegree + D := by
    rw [hQ', natDegree_divByMonic _ hW']
    have := natDegree_modByMonic_le P hW
    rw [← hR₁] at this
    omega
  have hπdeg : ∀ i, (π i).natDegree ≤ 2 * D := by
    intro i
    by_cases hi : i = j₀
    · simp only [hπdef, if_pos hi]
      refine (natDegree_add_le _ _).trans (max_le ?_ ?_)
      · refine natDegree_mul_le.trans ?_
        omega
      · omega
    · simp only [hπdef, if_neg hi]
      refine natDegree_mul_le.trans ?_
      have := (natDegree_mul_le (p := W'') (q := W'')).trans (le_refl _)
      have := hρdeg i
      omega
  refine ⟨fun o => o.elim (v * v) fun j => -(v * c j), fun o => o.elim π κ, ?_, ?_, ?_⟩
  · intro l j
    cases l with
    | none => exact hπdeg j
    | some k => exact (natDegree_trivialRelation_le g j₀ k hgD j).trans (by omega)
  · intro l
    cases l with
    | none => exact hπrel
    | some k => exact sum_trivialRelation_mul g j₀ k
  · intro j
    rw [Fintype.sum_option]
    simp only [Option.elim]
    rw [← hπ j]
    simp only [hbdef, neg_mul, Finset.sum_neg_distrib]
    have hs : ∑ k, v * c k * Φ (κ k j) = v * ∑ k, c k * Φ (κ k j) := by
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl fun k _ => by ring
    rw [hs]
    linear_combination (-(a j) * (1 + v * u) - v * ∑ k, c k * Φ (κ k j)) * hv

end

end Hironaka.OkaPolynomialRelations
