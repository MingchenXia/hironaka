set_option autoImplicit false
set_option linter.unusedSectionVars false

/-!
# Cartan's theorem: reduction to irreducible germs at the origin

Source: Demailly, *Complex analytic and differential geometry*, II.4.29, first paragraph of the
proof: "If `(A, 0)` is not irreducible, there exists a neighborhood `Ω` such that
`A ∩ Ω = A_1 ∪ … ∪ A_N` where `A_k` are analytic sets in `Ω` and `(A_k, 0)` is irreducible.  We
have `𝓘_{A∩Ω} = ⋂ 𝓘_{A_k}`, so by Cor. 3.15 we may assume that `(A, 0)` is irreducible."

`IrreducibleLocalCartan n`: the vanishing ideal of an irreducible analytic germ at `0 ∈ ℂⁿ` is
finitely generated near `0` (`OkaIdealOperations.IdealFGAt`).

`localCartan_of_irreducibleLocalCartan`: `IrreducibleLocalCartan n` implies
`CartanLocalReduction.LocalCartan n`, hence (`CartanLocalReduction.cartanCoherence_of_localCartan`)
Cartan's theorem on every complex manifold of dimension `n`
(`cartanCoherence_of_irreducibleLocalCartan`).  Steps: translate the point to `0`
(`idealFGAt_vanishingIdealF_of_translate`); decompose the germ into finitely many irreducible germs
(`AnalyticGermDecomposition.exists_irreducible_decomposition_euclidean`); the vanishing ideal of the
union is the intersection of the vanishing ideals, finitely generated by Oka
(`CoherentIdealColon.idealFGAt_iInter`).

What remains for Cartan's theorem is `IrreducibleLocalCartan n`.
-/

open Set Filter
open scoped Topology

universe u

namespace Hironaka.CartanIrreducibleReduction

open OkaRelationSheaf OkaIdealOperations CartanLocalReduction CoherentIdealColon AnalyticGermDecomposition

/-- **Cartan's theorem for irreducible germs at the origin.** -/
def IrreducibleLocalCartan (n : ℕ) : Prop :=
  ∀ B : Set (ComplexModel n), IsIrreducibleGerm B → IdealFGAt (vanishingIdealF B) 0

section Translate

variable {X : Type*} [NormedAddCommGroup X] [NormedSpace ℂ X]

theorem eventually_nhds_sub_iff {p : X → Prop} (x₀ y : X) :
    (∀ᶠ w in 𝓝 (y - x₀), p (x₀ + w)) ↔ ∀ᶠ v in 𝓝 y, p v := by
  have h : Filter.map (fun w => x₀ + w) (𝓝 (y - x₀)) = 𝓝 y := by
    rw [map_add_left_nhds, add_sub_cancel]
  rw [← h, eventually_map]

theorem holAt_translate_iff {g : X → ℂ} (x₀ y : X) :
    HolAt (fun w => g (x₀ + w)) (y - x₀) ↔ HolAt g y := by
  constructor
  · intro h
    have h' : HolAt ((fun w => g (x₀ + w)) ∘ fun v => v - x₀) y :=
      HolAt.comp (φ := fun w => w - x₀) (y := y) h (continuous_id.sub continuous_const)
        (fun x => differentiableAt_id.sub (differentiableAt_const x₀))
    have e : ((fun w => g (x₀ + w)) ∘ fun v => v - x₀) = g := funext fun v => by
      simp only [Function.comp_apply, add_sub_cancel]
    rwa [e] at h'
  · intro h
    have h1 : HolAt g ((fun w => x₀ + w) (y - x₀)) := by
      simpa only [add_sub_cancel] using h
    exact HolAt.comp (φ := fun w => x₀ + w) (y := y - x₀) h1 (continuous_const.add continuous_id)
      (fun x => (differentiableAt_const x₀).add differentiableAt_id)

theorem inSpanAt_translate_iff {μ : Type*} [Fintype μ] (s : μ → X → ℂ) (g : X → ℂ) (x₀ y : X) :
    InSpanAt s (y - x₀) (fun w => g (x₀ + w)) ↔ InSpanAt (fun k v => s k (v - x₀)) y g := by
  constructor
  · rintro ⟨hg, c, hc, hgc⟩
    refine ⟨(holAt_translate_iff x₀ y).1 hg, fun k v => c k (v - x₀), fun k => ?_, ?_⟩
    · have h1 : HolAt (fun w => (fun v => c k (v - x₀)) (x₀ + w)) (y - x₀) := by
        simpa only [add_sub_cancel_left] using hc k
      exact (holAt_translate_iff x₀ y).1 h1
    · have := (eventually_nhds_sub_iff (p := fun v =>
        g v = ∑ k, c k (v - x₀) * s k (v - x₀)) x₀ y).1
      apply this
      filter_upwards [hgc] with w hw
      simpa only [add_sub_cancel_left] using hw
  · rintro ⟨hg, c, hc, hgc⟩
    refine ⟨(holAt_translate_iff x₀ y).2 hg, fun k w => c k (x₀ + w),
      fun k => (holAt_translate_iff x₀ y).2 (hc k), ?_⟩
    have := (eventually_nhds_sub_iff (p := fun v =>
      g v = ∑ k, c k v * s k (v - x₀)) x₀ y).2 hgc
    filter_upwards [this] with w hw
    simpa only [add_sub_cancel_left] using hw

/-- **Translation**: if the vanishing ideal of the translate `A - x₀` is finitely generated
near `0`, the vanishing ideal of `A` is finitely generated near `x₀`. -/
theorem idealFGAt_vanishingIdealF_of_translate {A : Set X} {x₀ : X}
    (h : IdealFGAt (vanishingIdealF ((fun w => x₀ + w) ⁻¹' A)) 0) :
    IdealFGAt (vanishingIdealF A) x₀ := by
  obtain ⟨U, hU, h0U, μ, _, s, hsd, hsI⟩ := h
  refine ⟨(fun y => y - x₀) ⁻¹' U, hU.preimage (continuous_id.sub continuous_const),
    by simpa using h0U, μ, inferInstance, fun k v => s k (v - x₀), fun k => ?_,
    fun y hy g => ?_⟩
  · intro v hv
    exact ((hsd k).differentiableAt (hU.mem_nhds hv)).comp v
      (differentiableAt_id.sub (differentiableAt_const x₀)) |>.differentiableWithinAt
  rw [← inSpanAt_translate_iff s g x₀ y, ← hsI (y - x₀) hy]
  constructor
  · rintro ⟨hg, hgA⟩
    refine ⟨(holAt_translate_iff x₀ y).2 hg, ?_⟩
    exact (eventually_nhds_sub_iff (p := fun v => v ∈ A → g v = 0) x₀ y).2 hgA
  · rintro ⟨hg, hgA⟩
    exact ⟨(holAt_translate_iff x₀ y).1 hg,
      (eventually_nhds_sub_iff (p := fun v => v ∈ A → g v = 0) x₀ y).1 hgA⟩

end Translate

/-- The vanishing ideal only depends on the germ of the set (near points close to `0`). -/
theorem vanishingIdealF_congr_eventually {X : Type*} [NormedAddCommGroup X] [NormedSpace ℂ X]
    {A B : Set X} (hAB : A =ᶠ[𝓝 (0 : X)] B) :
    ∀ᶠ y in 𝓝 (0 : X), ∀ g, vanishingIdealF A y g ↔ vanishingIdealF B y g := by
  filter_upwards [hAB.eventually_nhds] with y hy g
  constructor
  · rintro ⟨hg, h⟩
    refine ⟨hg, ?_⟩
    filter_upwards [h, hy] with x hx hxe hxB
    exact hx (hxe.mpr hxB)
  · rintro ⟨hg, h⟩
    refine ⟨hg, ?_⟩
    filter_upwards [h, hy] with x hx hxe hxA
    exact hx (hxe.mp hxA)

theorem vanishingIdealF_iUnion {X : Type*} [NormedAddCommGroup X] [NormedSpace ℂ X] {r : ℕ}
    (B : Fin r → Set X) (y : X) (g : X → ℂ) :
    vanishingIdealF (⋃ i, B i) y g ↔ HolAt g y ∧ ∀ i, vanishingIdealF (B i) y g := by
  constructor
  · rintro ⟨hg, h⟩
    exact ⟨hg, fun i => ⟨hg, h.mono fun x hx hxB => hx (mem_iUnion.2 ⟨i, hxB⟩)⟩⟩
  · rintro ⟨hg, h⟩
    refine ⟨hg, ?_⟩
    filter_upwards [eventually_all.2 fun i => (h i).2] with x hx hxB
    obtain ⟨i, hi⟩ := mem_iUnion.1 hxB
    exact hx i hi

variable {n : ℕ}

/-- **Reduction to irreducible germs.** -/
theorem localCartan_of_irreducibleLocalCartan (h : IrreducibleLocalCartan n) :
    LocalCartan n := by
  intro Ω hΩ N f hf x₀ hx₀
  refine idealFGAt_vanishingIdealF_of_translate ?_
  set A' : Set (ComplexModel n) := (fun w => x₀ + w) ⁻¹' {w | ∀ i, f i w = 0} with hA'def
  have hA' : IsAnalyticGerm A' := by
    refine ⟨N, fun i w => f i (x₀ + w), fun i => ?_, Eventually.of_forall fun z => Iff.rfl⟩
    have h1 : HolAt (f i) x₀ := holAt_of_differentiableOn hΩ (hf i) hx₀
    have h2 := (holAt_translate_iff (g := f i) x₀ x₀).2 h1
    rwa [sub_self] at h2
  obtain ⟨r, B, hB, -, hAB, -⟩ := exists_irreducible_decomposition_euclidean hA'
  have hI : IdealFGAt (fun y g => HolAt g y ∧ ∀ i, vanishingIdealF (B i) y g) 0 :=
    idealFGAt_iInter (OkaCoherence.okaProperty_euclidean n) r _ fun i => h (B i) (hB i)
  refine hI.congr ?_
  filter_upwards [vanishingIdealF_congr_eventually hAB] with y hy g
  rw [hy g, vanishingIdealF_iUnion]

/-- **Cartan's theorem on manifolds from the irreducible case at the origin.** -/
theorem cartanCoherence_of_irreducibleLocalCartan (h : IrreducibleLocalCartan n)
    {M : Type u} [TopologicalSpace M] [ChartedSpace (ComplexModel n) M]
    [IsComplexManifold n M] : CartanComponentIdeal.CartanCoherence n M :=
  cartanCoherence_of_localCartan (localCartan_of_irreducibleLocalCartan h)

end Hironaka.CartanIrreducibleReduction
