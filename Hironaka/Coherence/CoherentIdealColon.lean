import Hironaka.Coherence.CartanLocalReduction
import Hironaka.MarkedIdeal.InvertibleIdealQuotient
import Hironaka.Coherence.OkaIdealOperations
import Hironaka.Coherence.OkaRelationSheaf
set_option autoImplicit false
set_option linter.unusedSectionVars false

/-!
# The colon of two coherent ideal sheaves is coherent (Oka)

Source: Grauert--Remmert, *Coherent analytic sheaves*, Ch. 2 §4; Demailly, *Complex analytic and
differential geometry*, II.3.15--3.20: kernels and quotients of morphisms of coherent sheaves are
coherent, hence so is `(𝔞 : 𝔩) = ker(𝒪 → Hom(𝔩, 𝒪/𝔞))`.

(The tree had this only for invertible `𝔩`, `InvertibleIdealQuotient.isCoherent_colon`.)

## Proof

In the preferred chart `e` at `x`, with generators `a_i` of `𝔞` and `l_j` of `𝔩` near `x`:
`f ∈ (𝔞 : 𝔩)_y` iff `f l_j ∈ 𝔞_y` for every `j`, iff `f ∘ e⁻¹` lies at `e y` in the intersection
over `j` of the colon ideals `(A : l_j ∘ e⁻¹)` of the ideal `A` generated by the `a_i ∘ e⁻¹`.
These are finitely generated near `e x` by Oka's theorem (`OkaIdealOperations.IdealFGAt.colon`,
`IdealFGAt.inter`), and generators `s_k` near `e x` give generators `s_k ∘ e` near `x`.
-/

open Set Filter
open scoped Topology Manifold

namespace Hironaka.CoherentIdealColon

open Hironaka.HolomorphicIdealSheaves OkaRelationSheaf OkaIdealOperations CartanLocalReduction InvertibleIdealQuotient

variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (ComplexModel n) M] [IsComplexManifold n M]

/-! ### Finite intersections -/

/-- The unit ideal of holomorphic germs is generated by `1`. -/
theorem idealFGAt_unit {X : Type*} [NormedAddCommGroup X] [NormedSpace ℂ X] (x₀ : X) :
    IdealFGAt (fun y g => HolAt g y) x₀ := by
  refine ⟨univ, isOpen_univ, mem_univ _, Unit, inferInstance, fun _ _ => 1,
    fun _ => differentiableOn_const _, fun y _ g => ⟨fun hg => ⟨hg, fun _ => g, fun _ => hg,
      Eventually.of_forall fun x => by simp⟩, fun h => h.1⟩⟩

/-- **Finite intersections** of finitely generated ideals (with Oka's property). -/
theorem idealFGAt_iInter {X : Type*} [NormedAddCommGroup X] [NormedSpace ℂ X]
    (hX : OkaProperty X) {x₀ : X} :
    ∀ (L : ℕ) (C : Fin L → X → (X → ℂ) → Prop), (∀ j, IdealFGAt (C j) x₀) →
      IdealFGAt (fun y g => HolAt g y ∧ ∀ j, C j y g) x₀
  | 0, C, _ => (idealFGAt_unit x₀).congr (Eventually.of_forall fun y g =>
      ⟨fun hg => ⟨hg, fun j => j.elim0⟩, fun h => h.1⟩)
  | L + 1, C, hC => by
      have ih := idealFGAt_iInter hX L (fun j => C j.succ) fun j => hC j.succ
      refine (IdealFGAt.inter hX (hC 0) ih).congr (Eventually.of_forall fun y g => ?_)
      obtain ⟨U, hU, hx₀U, μ, _, s, hsd, hsI⟩ := hC 0
      constructor
      · rintro ⟨h0, hg, hs⟩
        exact ⟨hg, Fin.cases h0 hs⟩
      · rintro ⟨hg, h⟩
        exact ⟨h 0, hg, fun j => h j.succ⟩

end Hironaka.CoherentIdealColon
