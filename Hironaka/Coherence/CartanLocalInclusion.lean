/-!
# Cartan's theorem for an irreducible germ: the inclusion `I_{A,x} ⊆ (G : δ^m)_x`

Demailly, *Complex analytic and differential geometry*, proof of II.4.29, the inclusion
`I_{A,x} ⊆ {f : δ^m f ∈ (G_1, …, G_N)_x}` of (4.30), at every point `x` of the polydisc `Δ`
whose fibre is separated by the primitive element `u`.

For `P : ParametrizationData A` with constant coefficients `c` of `u = ∑_{k ≥ d} c_k z_k`, the
generators `gen P` are `W(z'; u)`, `δ(z') z_k - B_k(z'; u)` and `E_k(z'; z_k)` (`d ≤ k`); they
vanish on `A`.  `inSpanAt_gen`: if `x ∈ Δ`, `u` separates `x` from the other points of
`closure (A ∩ Δ)` over `π x`, and `g` vanishes on `A` near `x`, then `δ(z')^m g` lies in the
ideal generated by `gen P` at `x`, with `m = ∑_k deg E_k` independent of `x`.

Proof: translate to germs at `x` (`OkaGermBridge.germAt`), apply Demailly's Lemma 4.18 at `x`
(`CartanLocalAlgebra.exists_local_division`): `δ^m g ≡ r(u - u(x))` with `deg r` smaller than the
local Weierstrass factor `W'` of `W(u(x) + T)`; then `r(u - u(x))` vanishes on `(A, x)`, so
`r = 0` by the key step `CartanKeyLemma.eventually_eq_zero_of_vanishing`.
-/

open Set Filter Metric Polynomial
open scoped Topology

namespace Hironaka.CartanLocalInclusion

open RegularLocusDense HolGerm GermAlgebraicParametrization GermParametrizationData GermParametrizationFunctions OkaRelationSheaf OkaIdealOperations OkaGermBridge AnalyticGermDecomposition

noncomputable section

section Bridge

variable {Z : Type*} [NormedAddCommGroup Z] [NormedSpace ℂ Z]

theorem toGerm_germAt {f : Z → ℂ} {y : Z} (hf : HolAt f y) :
    toGerm (germAt y f) = ((fun v => f (y + v) : Z → ℂ) : Germ (𝓝 (0 : Z)) ℂ) := by
  rw [germAt_of_holAt hf]
  rfl

/-- Membership of the germ in the span of the germs of the generators gives `InSpanAt`. -/
theorem inSpanAt_of_germAt_mem_span {μ : Type*} [Fintype μ] {s : μ → Z → ℂ} {y : Z}
    (hs : ∀ i, HolAt (s i) y) {g : Z → ℂ} (hg : HolAt g y)
    (h : germAt y g ∈ Ideal.span (Set.range fun i => germAt y (s i))) : InSpanAt s y g := by
  classical
  obtain ⟨c, hc⟩ := (Ideal.mem_span_range_iff_exists_fun).1 h
  choose cf hcf hcfeq using fun i => exists_germAt_eq (c i) y
  refine ⟨hg, cf, hcf, ?_⟩
  have hsum : HolAt (fun x => ∑ i, cf i x * s i x) y :=
    HolAt.fintype_sum fun i => (hcf i).mul (hs i)
  rw [← germAt_eq_germAt_iff hg hsum,
    germAt_sum Finset.univ (f := fun i x => cf i x * s i x) (fun i _ => (hcf i).mul (hs i)), ← hc]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [germAt_mul (hcf i) (hs i), hcfeq]

end Bridge

section Poly

variable {n d : ℕ}

/-- `∑_{j<q} C (germ of a_j at x') X^j`. -/
def lowGermPoly (x' : ComplexModel d) (q : ℕ) (a : ℕ → ComplexModel d → ℂ) :
    (HolGerm (ComplexModel d))[X] :=
  ∑ j ∈ Finset.range q, C (germAt x' (a j)) * X ^ j

/-- `X^q + ∑_{j<q} C (germ of a_j at x') X^j`. -/
def monicGermPoly (x' : ComplexModel d) (q : ℕ) (a : ℕ → ComplexModel d → ℂ) :
    (HolGerm (ComplexModel d))[X] :=
  X ^ q + lowGermPoly x' q a

theorem monicGermPoly_monic (x' : ComplexModel d) (q : ℕ) (a : ℕ → ComplexModel d → ℂ) :
    (monicGermPoly x' q a).Monic :=
  (AnalyticProjectionWeierstrass.monic_X_pow_add_sum q fun j => germAt x' (a j)).1

theorem natDegree_monicGermPoly (x' : ComplexModel d) (q : ℕ) (a : ℕ → ComplexModel d → ℂ) :
    (monicGermPoly x' q a).natDegree = q :=
  (AnalyticProjectionWeierstrass.monic_X_pow_add_sum q fun j => germAt x' (a j)).2

theorem coordinateProjection_add (x v : ComplexModel n) :
    coordinateProjection n d (x + v) = coordinateProjection n d x + coordinateProjection n d v :=
  map_add _ x v

theorem toGerm_projGerm_germAt {x' : ComplexModel d} {f : ComplexModel d → ℂ} (hf : HolAt f x') :
    toGerm (projGerm n d (germAt x' f)) =
      ((fun v => f (x' + coordinateProjection n d v) : ComplexModel n → ℂ) :
        Germ (𝓝 (0 : ComplexModel n)) ℂ) := by
  rw [GermParametrizationFunctions.toGerm_projGerm, toGerm_germAt hf]
  rfl

/-- The germ at `x` of `z ↦ ∑_{j<q} a_j(π z) h(z)^j`. -/
theorem toGerm_evalGerm_lowGermPoly (x : ComplexModel n) (q : ℕ) (a : ℕ → ComplexModel d → ℂ)
    (ha : ∀ j < q, HolAt (a j) (coordinateProjection n d x)) {γ : HolGerm (ComplexModel n)}
    {h : ComplexModel n → ℂ} (hγ : toGerm γ = (h : Germ (𝓝 (0 : ComplexModel n)) ℂ)) :
    toGerm (evalGerm n (lowGermPoly (coordinateProjection n d x) q a) γ) =
      ((fun v => lowEval q a (coordinateProjection n d (x + v)) (h v) : ComplexModel n → ℂ) :
        Germ _ ℂ) := by
  simp only [lowGermPoly, evalGerm, eval₂_finsetSum, eval₂_mul, eval₂_C, eval₂_X_pow, map_sum,
    map_mul, map_pow]
  unfold lowEval
  simp_rw [coordinateProjection_add]
  rw [germ_coe_sum]
  refine Finset.sum_congr rfl fun j hj => ?_
  rw [toGerm_projGerm_germAt (ha j (Finset.mem_range.1 hj)), hγ]
  rfl

/-- The germ at `x` of `z ↦ h(z)^q + ∑_{j<q} a_j(π z) h(z)^j`. -/
theorem toGerm_evalGerm_monicGermPoly (x : ComplexModel n) (q : ℕ) (a : ℕ → ComplexModel d → ℂ)
    (ha : ∀ j < q, HolAt (a j) (coordinateProjection n d x)) {γ : HolGerm (ComplexModel n)}
    {h : ComplexModel n → ℂ} (hγ : toGerm γ = (h : Germ (𝓝 (0 : ComplexModel n)) ℂ)) :
    toGerm (evalGerm n (monicGermPoly (coordinateProjection n d x) q a) γ) =
      ((fun v => monicEval q a (coordinateProjection n d (x + v)) (h v) : ComplexModel n → ℂ) :
        Germ _ ℂ) := by
  have h1 : evalGerm n (monicGermPoly (coordinateProjection n d x) q a) γ =
      γ ^ q + evalGerm n (lowGermPoly (coordinateProjection n d x) q a) γ := by
    simp only [monicGermPoly, evalGerm, eval₂_add, eval₂_X_pow]
  rw [h1, map_add, map_pow, toGerm_evalGerm_lowGermPoly x q a ha hγ, hγ]
  rfl

/-- Pointwise form of `W(u₀ + T)` for `W = monicGermPoly x' q a`. -/
theorem polyGerm_monicGermPoly_comp (x' : ComplexModel d) (q : ℕ) (a : ℕ → ComplexModel d → ℂ)
    (ha : ∀ j < q, HolAt (a j) x') (t : ℂ) :
    polyGerm ((monicGermPoly x' q a).comp (X + C (constHom t))) =
      ((fun w => (monicPoly q (fun j w => a j (x' + w)) w).comp (X + C t) :
        ComplexModel d → ℂ[X]) : Germ (𝓝 (0 : ComplexModel d)) ℂ[X]) := by
  have h1 : (monicGermPoly x' q a).comp (X + C (constHom t)) = (X + C (constHom t)) ^ q +
      ∑ j ∈ Finset.range q, C (germAt x' (a j)) * (X + C (constHom t)) ^ j := by
    simp only [monicGermPoly, lowGermPoly, add_comp, pow_comp, X_comp, sum_comp, mul_comp,
      C_comp]
  have hX : polyGerm (X + C (constHom t) : (HolGerm (ComplexModel d))[X]) =
      ((fun _ => X + C t : ComplexModel d → ℂ[X]) : Germ (𝓝 (0 : ComplexModel d)) ℂ[X]) := by
    rw [map_add, polyGerm_X, polyGerm_C]
    rfl
  have hterm : ∀ j ∈ Finset.range q, polyGerm (C (germAt x' (a j)) * (X + C (constHom t)) ^ j) =
      ((fun w => C (a j (x' + w)) * (X + C t) ^ j : ComplexModel d → ℂ[X]) :
        Germ (𝓝 (0 : ComplexModel d)) ℂ[X]) := by
    intro j hj
    rw [map_mul, map_pow, hX, polyGerm_C, toGerm_germAt (ha j (Finset.mem_range.1 hj))]
    rfl
  rw [h1, map_add, map_pow, map_sum, hX, Finset.sum_congr rfl hterm, ← germ_coe_sum]
  have h2 : ((fun w => (monicPoly q (fun j w => a j (x' + w)) w).comp (X + C t) :
      ComplexModel d → ℂ[X])) = (fun _ => X + C t) ^ q +
        fun w => ∑ j ∈ Finset.range q, C (a j (x' + w)) * (X + C t) ^ j := by
    funext w
    simp only [monicPoly, add_comp, pow_comp, X_comp, sum_comp, mul_comp, C_comp, Pi.add_apply,
      Pi.pow_apply]
  rw [h2]
  rfl

end Poly

section Generators

variable {n : ℕ} {A : Set (ComplexModel n)}

/-- The generators `W(z'; u)`, `δ(z') z_k - B_k(z'; u)`, `E_k(z'; z_k)` (`d ≤ k`). -/
def gen (P : ParametrizationData A) : Option (Bool × Fin n) → ComplexModel n → ℂ
  | none => fun z => monicEval P.deg P.w (coordinateProjection n P.dim z)
      (fibreForm P.dim P.coef z)
  | some (false, k) => fun z => if P.dim ≤ k.1 then
      P.disc (coordinateProjection n P.dim z) * z k -
        lowEval P.deg (P.b k) (coordinateProjection n P.dim z) (fibreForm P.dim P.coef z)
      else 0
  | some (true, k) => fun z => if P.dim ≤ k.1 then
      monicEval (P.s k) (P.e k) (coordinateProjection n P.dim z) (z k) else 0

/-- The exponent `m = ∑_k deg E_k` of the colon ideal. -/
def colonExp (P : ParametrizationData A) : ℕ := ∑ k : Fin n, P.s k

theorem differentiableOn_comp_proj (P : ParametrizationData A) {f : ComplexModel P.dim → ℂ}
    (hf : DifferentiableOn ℂ f (ball 0 P.rad)) :
    DifferentiableOn ℂ (fun z => f (coordinateProjection n P.dim z))
      (coordinateProjection n P.dim ⁻¹' ball 0 P.rad) :=
  hf.comp (coordinateProjection n P.dim).differentiable.differentiableOn fun _ hz => hz

theorem differentiableOn_fibreForm (P : ParametrizationData A) :
    DifferentiableOn ℂ (fibreForm P.dim P.coef) (coordinateProjection n P.dim ⁻¹' ball 0 P.rad) := by
  unfold fibreForm
  refine DifferentiableOn.fun_sum fun k _ => ?_
  by_cases hk : P.dim ≤ k.1
  · simp only [hk, if_true]
    exact (differentiableOn_comp_proj P (P.differentiableOn_coef k)).mul
      ((EuclideanSpace.proj (𝕜 := ℂ) k).differentiable.differentiableOn)
  · simp only [hk, if_false]
    exact differentiableOn_const _

theorem differentiableOn_monicEval {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    {U : Set E} (q : ℕ) {a : ℕ → E → ℂ} (ha : ∀ j, DifferentiableOn ℂ (a j) U) {h : E → ℂ}
    (hh : DifferentiableOn ℂ h U) : DifferentiableOn ℂ (fun z => monicEval q a z (h z)) U := by
  unfold monicEval
  exact (hh.pow q).add (DifferentiableOn.fun_sum fun j _ => (ha j).mul (hh.pow j))

theorem differentiableOn_lowEval {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    {U : Set E} (q : ℕ) {a : ℕ → E → ℂ} (ha : ∀ j, DifferentiableOn ℂ (a j) U) {h : E → ℂ}
    (hh : DifferentiableOn ℂ h U) : DifferentiableOn ℂ (fun z => lowEval q a z (h z)) U := by
  unfold lowEval
  exact DifferentiableOn.fun_sum fun j _ => (ha j).mul (hh.pow j)

/-- The generators are holomorphic over the ball. -/
theorem differentiableOn_gen (P : ParametrizationData A) (i : Option (Bool × Fin n)) :
    DifferentiableOn ℂ (gen P i) (coordinateProjection n P.dim ⁻¹' ball 0 P.rad) := by
  have hw : ∀ j, DifferentiableOn ℂ (fun z => P.w j (coordinateProjection n P.dim z))
      (coordinateProjection n P.dim ⁻¹' ball 0 P.rad) :=
    fun j => differentiableOn_comp_proj P (P.differentiableOn_w j)
  rcases i with _ | ⟨_ | _, k⟩
  · exact differentiableOn_monicEval (a := fun j z => P.w j (coordinateProjection n P.dim z))
      P.deg hw (differentiableOn_fibreForm P)
  · simp only [gen]
    split_ifs
    · exact ((differentiableOn_comp_proj P P.differentiableOn_disc).mul
        ((EuclideanSpace.proj (𝕜 := ℂ) k).differentiable.differentiableOn)).sub
        (differentiableOn_lowEval (a := fun j z => P.b k j (coordinateProjection n P.dim z))
          P.deg (fun j => differentiableOn_comp_proj P (P.differentiableOn_b k j))
          (differentiableOn_fibreForm P))
    · exact differentiableOn_const _
  · simp only [gen]
    split_ifs
    · exact differentiableOn_monicEval
        (a := fun j z => P.e k j (coordinateProjection n P.dim z)) (P.s k)
        (fun j => differentiableOn_comp_proj P (P.differentiableOn_e k j))
        ((EuclideanSpace.proj (𝕜 := ℂ) k).differentiable.differentiableOn)
    · exact differentiableOn_const _

/-- The generators vanish on `A` over the ball. -/
theorem gen_eq_zero (P : ParametrizationData A) (i : Option (Bool × Fin n)) {z : ComplexModel n}
    (hzA : z ∈ A) (hz : z ∈ ball 0 P.rad) : gen P i z = 0 := by
  rcases i with _ | ⟨_ | _, k⟩
  · exact P.w_eq_zero z hzA hz
  · simp only [gen]
    split_ifs with hk
    · rw [P.disc_mul_eq z hzA hz k hk, sub_self]
    · rfl
  · simp only [gen]
    split_ifs with hk
    · exact P.e_eq_zero z hzA hz k hk
    · rfl

end Generators

section Inclusion

variable {n : ℕ} {A : Set (ComplexModel n)}

theorem germ_congr {α β : Type*} {l : Filter α} {f g : α → β} (h : ∀ v, f v = g v) :
    (f : Germ l β) = g := by
  rw [funext h]

theorem fibreForm_add_const {d : ℕ} (c : Fin n → ℂ) (x v : ComplexModel n) :
    fibreForm d (fun k _ => c k) (x + v) =
      fibreForm d (fun k _ => c k) x + fibreForm d (fun k _ => c k) v := by
  simp only [fibreForm, PiLp.add_apply, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun k _ => ?_
  split_ifs <;> ring

/-- **The inclusion `I_{A,x} ⊆ (G : δ^m)_x`** (Demailly II.4.29, (4.30)) at a point `x ∈ Δ`
whose fibre is separated by `u`. -/
theorem inSpanAt_gen (P : ParametrizationData A) {c : Fin n → ℂ}
    (hc : P.coef = fun k _ => c k) {r₁ r₂ : ℝ} (hR : P.GoodRadii r₁ r₂) {x : ComplexModel n}
    (hx : x ∈ polydisc n P.dim r₁ r₂)
    (hsep : ∀ y ∈ closure (A ∩ polydisc n P.dim r₁ r₂),
      coordinateProjection n P.dim y = coordinateProjection n P.dim x →
      fibreForm P.dim P.coef y = fibreForm P.dim P.coef x → y = x)
    {g : ComplexModel n → ℂ} (hg : vanishingIdealF A x g) :
    InSpanAt (gen P) x
      (fun z => P.disc (coordinateProjection n P.dim z) ^ colonExp P * g z) := by
  classical
  set d := P.dim with hd
  set x' := coordinateProjection n d x with hx'
  set u₀ := fibreForm d P.coef x with hu₀
  have hxball : x ∈ ball (0 : ComplexModel n) P.rad := hR.polydisc_subset hx
  have hx'b : x' ∈ ball (0 : ComplexModel d) P.rad :=
    mem_ball_zero_iff.2 (hx.1.trans_le hR.r₁_le)
  have hU : IsOpen (coordinateProjection n d ⁻¹' ball (0 : ComplexModel d) P.rad) :=
    isOpen_ball.preimage (coordinateProjection n d).continuous
  have hxU : x ∈ coordinateProjection n d ⁻¹' ball (0 : ComplexModel d) P.rad := hx'b
  have hholb : ∀ {f : ComplexModel d → ℂ}, DifferentiableOn ℂ f (ball 0 P.rad) → HolAt f x' :=
    fun hf => holAt_of_differentiableOn isOpen_ball hf hx'b
  have hgen : ∀ i, HolAt (gen P i) x := fun i =>
    holAt_of_differentiableOn hU (differentiableOn_gen P i) hxU
  -- germ data at `x`
  set W := monicGermPoly x' P.deg P.w with hW
  set E : Fin n → (HolGerm (ComplexModel d))[X] := fun k => monicGermPoly x' (P.s k) (P.e k)
    with hE
  set B : Fin n → (HolGerm (ComplexModel d))[X] := fun k => lowGermPoly x' P.deg (P.b k)
    with hB
  set δ := germAt x' P.disc with hδ
  set I := Ideal.span (Set.range fun i => germAt x (gen P i)) with hI
  set ℓ := linearFormGerm n d c with hℓ
  have hu : ∀ v, fibreForm d P.coef (x + v) = u₀ + fibreForm d (fun k _ => c k) v := by
    intro v
    rw [hu₀, hc, fibreForm_add_const]
  have hUgerm : toGerm (constHom u₀ + ℓ) = ((fun v => u₀ + fibreForm d (fun k _ => c k) v :
      ComplexModel n → ℂ) : Germ (𝓝 (0 : ComplexModel n)) ℂ) := by
    rw [map_add, hℓ, toGerm_linearFormGerm]
    rfl
  have hZ : ∀ k : Fin n, toGerm (constHom (x k) + coord k) =
      ((fun v => (x + v) k : ComplexModel n → ℂ) : Germ (𝓝 (0 : ComplexModel n)) ℂ) := by
    intro k
    rw [map_add, toGerm_coord]
    rfl
  -- the generators at `x`
  have hWI : evalGerm n W (constHom u₀ + ℓ) ∈ I := by
    have h : germAt x (gen P none) = evalGerm n W (constHom u₀ + ℓ) := by
      apply toGerm_injective
      rw [toGerm_germAt (hgen none), hW, toGerm_evalGerm_monicGermPoly x P.deg P.w
        (fun j _ => hholb (P.differentiableOn_w j)) hUgerm]
      exact germ_congr fun v => by simp only [gen]; rw [hu]
    rw [← h]
    exact Ideal.subset_span ⟨none, rfl⟩
  have hBI : ∀ k : Fin n, d ≤ k.1 → projGerm n d δ * (constHom (x k) + coord k) -
      evalGerm n (B k) (constHom u₀ + ℓ) ∈ I := by
    intro k hk
    have h : germAt x (gen P (some (false, k))) =
        projGerm n d δ * (constHom (x k) + coord k) - evalGerm n (B k) (constHom u₀ + ℓ) := by
      apply toGerm_injective
      rw [toGerm_germAt (hgen _), map_sub, map_mul, hδ,
        toGerm_projGerm_germAt (hholb P.differentiableOn_disc), hZ k, hB,
        toGerm_evalGerm_lowGermPoly x P.deg (P.b k)
          (fun j _ => hholb (P.differentiableOn_b k j)) hUgerm, ← Germ.coe_mul, ← Germ.coe_sub]
      refine germ_congr fun v => ?_
      simp only [gen, Pi.mul_apply, Pi.sub_apply]
      rw [if_pos (show P.dim ≤ k.1 from hk), hu, coordinateProjection_add]
    rw [← h]
    exact Ideal.subset_span ⟨some (false, k), rfl⟩
  have hEI : ∀ k : Fin n, d ≤ k.1 → evalGerm n (E k) (constHom (x k) + coord k) ∈ I := by
    intro k hk
    have h : germAt x (gen P (some (true, k))) = evalGerm n (E k) (constHom (x k) + coord k) := by
      apply toGerm_injective
      rw [toGerm_germAt (hgen _), hE, toGerm_evalGerm_monicGermPoly x (P.s k) (P.e k)
        (fun j _ => hholb (P.differentiableOn_e k j)) (hZ k)]
      exact germ_congr fun v => by
        simp only [gen]
        rw [if_pos (show P.dim ≤ k.1 from hk)]
    rw [← h]
    exact Ideal.subset_span ⟨some (true, k), rfl⟩
  -- Demailly's Lemma 4.18 at `x`
  obtain ⟨W', Q', hW', hfac, -, hdiv⟩ := CartanLocalAlgebra.exists_local_division P.dim_le c
    (fun k => x k) u₀ (monicGermPoly_monic _ _ _) (fun k _ => monicGermPoly_monic _ _ _) B δ I
    hWI hBI hEI
  obtain ⟨r, hrdeg, hrI⟩ := hdiv (germAt x g)
  -- everything in `I` vanishes on `A` near `x`
  set Ax := (fun v => x + v) ⁻¹' A with hAx
  have hIle : I ≤ vanishingIdeal Ax := by
    rw [hI, Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    show germAt x (gen P i) ∈ vanishingIdeal Ax
    rw [germAt_of_holAt (hgen i), mem_vanishingIdeal_mk]
    have hb : ∀ᶠ v in 𝓝 (0 : ComplexModel n), x + v ∈ ball (0 : ComplexModel n) P.rad :=
      (eventually_nhds_iff_translate x).1 (isOpen_ball.mem_nhds hxball)
    exact hb.mono fun v hv hvA => gen_eq_zero P i hvA hv
  have hγ : germAt x g ∈ vanishingIdeal Ax := by
    rw [germAt_of_holAt hg.1, mem_vanishingIdeal_mk]
    exact (eventually_nhds_iff_translate x).1 hg.2
  have hr : evalGerm n r ℓ ∈ vanishingIdeal Ax := by
    have h1 := hIle hrI
    have h2 : projGerm n d δ ^ (∑ k, (E k).natDegree) * germAt x g ∈ vanishingIdeal Ax :=
      Ideal.mul_mem_left _ _ hγ
    have h3 := Ideal.sub_mem _ h2 h1
    rwa [sub_sub_cancel] at h3
  -- `r = 0` by the key step
  have hr0 : r = 0 := by
    set a := W'.natDegree with ha
    have hW'deg : W'.degree = a := degree_eq_natDegree hW'.1.ne_zero
    rcases Nat.eq_zero_or_pos a with ha0 | ha0
    · rw [hW'deg, ha0] at hrdeg
      by_contra hne
      exact absurd hrdeg (not_lt.2 (zero_le_degree_iff.2 hne))
    have hrnat : r.natDegree < a := by
      by_cases hr0 : r = 0
      · rw [hr0, natDegree_zero]
        exact ha0
      · exact (natDegree_lt_iff_degree_lt hr0).2 (hW'deg ▸ hrdeg)
    have hF : ∀ᶠ z in 𝓝 x, z ∈ A → ∑ j ∈ Finset.range a,
        coeffFun r a j (coordinateProjection n P.dim z - coordinateProjection n P.dim x) *
          (fibreForm P.dim P.coef z - fibreForm P.dim P.coef x) ^ j = 0 := by
      have h1 := eventually_of_mem_vanishingIdeal hr
        (toGerm_evalGerm_low r hrnat (toGerm_linearFormGerm c))
      rw [eventually_nhds_iff_translate x]
      refine h1.mono fun v hv hvA => ?_
      have h2 := hv hvA
      unfold lowEval at h2
      rw [← h2]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [coordinateProjection_add, add_sub_cancel_left, hu, add_sub_cancel_left]
    have hdvd : ∀ᶠ w in 𝓝 (0 : ComplexModel P.dim), monicPoly a (coeffFun W' a) w ∣
        (monicPoly P.deg P.w (coordinateProjection n P.dim x + w)).comp
          (X + C (fibreForm P.dim P.coef x)) :=
      eventually_dvd ⟨Q', hfac⟩ (polyGerm_monicGermPoly_comp x' P.deg P.w
        (fun j _ => hholb (P.differentiableOn_w j)) u₀) (polyGerm_monic hW'.1)
    have hkey := CartanKeyLemma.eventually_eq_zero_of_vanishing P hR hx hsep (a := a)
      (ω := coeffFun W' a)
      (fun j _ => ((eventually_differentiableAt_coeffFun W' a).self_of_nhds j).continuousAt)
      (fun j _ => coeffFun_zero hW'.2 j) hdvd (f := coeffFun r a)
      (fun j _ => (eventually_differentiableAt_coeffFun r a).mono fun w hw => (hw j).continuousAt)
      hF
    refine Polynomial.ext fun j => ?_
    rw [coeff_zero]
    by_cases hj : j < a
    · apply toGerm_injective
      rw [toGerm_coeff_of_lt r hj, map_zero]
      exact (Germ.coe_eq.2 (hkey j hj)).trans rfl
    · exact coeff_eq_zero_of_natDegree_lt (by omega)
  -- conclusion
  have hmem : projGerm n d δ ^ (∑ k, (E k).natDegree) * germAt x g ∈ I := by
    rw [hr0] at hrI
    simpa [evalGerm] using hrI
  have hexp : ∑ k, (E k).natDegree = colonExp P := by
    simp only [hE, natDegree_monicGermPoly, colonExp]
  have hδπ : HolAt (fun z => P.disc (coordinateProjection n d z)) x :=
    holAt_of_differentiableOn hU (differentiableOn_comp_proj P P.differentiableOn_disc) hxU
  have hδpow : HolAt (fun z => P.disc (coordinateProjection n d z) ^ colonExp P) x :=
    Filter.Eventually.mono hδπ fun z hz => hz.pow _
  have hgerm : germAt x (fun z => P.disc (coordinateProjection n d z)) = projGerm n d δ := by
    apply toGerm_injective
    rw [toGerm_germAt hδπ, hδ, toGerm_projGerm_germAt (hholb P.differentiableOn_disc)]
    exact germ_congr fun v => by rw [coordinateProjection_add]
  refine inSpanAt_of_germAt_mem_span hgen (hδpow.mul hg.1) ?_
  rw [germAt_mul hδpow hg.1, germAt_pow hδπ, hgerm, ← hexp]
  exact hmem

end Inclusion

end

