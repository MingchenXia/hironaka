import Hironaka.Coherence.OkaCoherence
import Hironaka.Coherence.OkaRelationSheaf
set_option autoImplicit false
set_option linter.unusedSectionVars false

/-!
# Consequences of Oka's theorem: colon ideals, intersections and sums are coherent

Source: Grauert--Remmert, *Coherent analytic sheaves*, Ch. 2 §§4--5; Demailly, *Complex
analytic and differential geometry*, II.3.15--3.20 (kernels, intersections and quotients of
coherent sheaves are coherent).

An *ideal* on a complex normed space `X` is recorded, as in `Hironaka.HolomorphicIdealSheaves`,
by membership of germs: `I y g` says that the germ at `y` of `g` lies in `I_y`.  It is
*finitely generated near `x₀`* (`IdealFGAt`) if finitely many functions holomorphic on an open
`U ∋ x₀` generate `I_y` at EVERY `y ∈ U`; this is coherence of an ideal subsheaf of `𝒪`.

If `X` has Oka's property (e.g. `ℂⁿ`, `OkaCoherence.okaProperty_euclidean`):

* `IdealFGAt.colon`: the colon ideal `(I : h) = {g : g h ∈ I}` of a finitely generated ideal by
  a holomorphic function is finitely generated (its generators are the first components of
  generators of the relations of `(h, s_1, …, s_N)`);
* `IdealFGAt.inter`: the intersection of two finitely generated ideals is finitely generated
  (relations of `(s, t)`);

`vanishingIdealF A` is the ideal of germs vanishing on `A`.
-/

open Filter Topology Set

namespace Hironaka.OkaIdealOperations

open OkaRelationSheaf

section Defs

variable {X : Type*} [NormedAddCommGroup X] [NormedSpace ℂ X]

/-- The germ of `g` at `y` lies in the ideal generated by the `s_k`. -/
def InSpanAt {μ : Type*} [Fintype μ] (s : μ → X → ℂ) (y : X) (g : X → ℂ) : Prop :=
  HolAt g y ∧ ∃ c : μ → X → ℂ, (∀ k, HolAt (c k) y) ∧ g =ᶠ[𝓝 y] fun x => ∑ k, c k x * s k x

/-- The ideal `I` is finitely generated near `x₀`: finitely many functions holomorphic on an
open `U ∋ x₀` generate `I_y` at every `y ∈ U`. -/
def IdealFGAt (I : X → (X → ℂ) → Prop) (x₀ : X) : Prop :=
  ∃ U : Set X, IsOpen U ∧ x₀ ∈ U ∧ ∃ (μ : Type) (_ : Fintype μ) (s : μ → X → ℂ),
    (∀ k, DifferentiableOn ℂ (s k) U) ∧ ∀ y ∈ U, ∀ g, I y g ↔ InSpanAt s y g

/-- The colon ideal `(I : h) = {g : g h ∈ I}`. -/
def colonIdeal (I : X → (X → ℂ) → Prop) (h : X → ℂ) : X → (X → ℂ) → Prop :=
  fun y g => HolAt g y ∧ I y fun x => g x * h x

/-- The ideal of germs vanishing on `A`. -/
def vanishingIdealF (A : Set X) : X → (X → ℂ) → Prop :=
  fun y g => HolAt g y ∧ ∀ᶠ x in 𝓝 y, x ∈ A → g x = 0

end Defs

section Lemmas

variable {X : Type*} [NormedAddCommGroup X] [NormedSpace ℂ X]

/-- A generator lies in the span. -/
theorem inSpanAt_self {μ : Type*} [Fintype μ] [DecidableEq μ] {s : μ → X → ℂ} {y : X}
    (hs : ∀ k, HolAt (s k) y) (k : μ) : InSpanAt s y (s k) :=
  ⟨hs k, fun l _ => if l = k then 1 else 0, fun l => holAt_const _ y,
    Eventually.of_forall fun x => by simp⟩

/-- Two ideals agreeing near `x₀` are finitely generated together. -/
theorem IdealFGAt.congr {I J : X → (X → ℂ) → Prop} {x₀ : X} (hI : IdealFGAt I x₀)
    (hIJ : ∀ᶠ y in 𝓝 x₀, ∀ g, I y g ↔ J y g) : IdealFGAt J x₀ := by
  obtain ⟨U, hU, hx₀U, μ, _, s, hsd, hsI⟩ := hI
  obtain ⟨V, hVIJ, hV, hx₀V⟩ := eventually_nhds_iff.1 hIJ
  exact ⟨U ∩ V, hU.inter hV, ⟨hx₀U, hx₀V⟩, μ, inferInstance, s,
    fun k => (hsd k).mono inter_subset_left,
    fun y hy g => (hVIJ y hy.2 g).symm.trans (hsI y hy.1 g)⟩

/-- **Colon ideals.**  If `X` has Oka's property, `I` is finitely generated near `x₀` and `h` is
holomorphic near `x₀`, then `(I : h)` is finitely generated near `x₀`. -/
theorem IdealFGAt.colon (hX : OkaProperty X) {I : X → (X → ℂ) → Prop} {x₀ : X}
    (hI : IdealFGAt I x₀) {h : X → ℂ} (hh : HolAt h x₀) : IdealFGAt (colonIdeal I h) x₀ := by
  classical
  obtain ⟨U, hU, hx₀U, μ, _, s, hsd, hsI⟩ := hI
  obtain ⟨V₀, hV₀, hx₀V₀, hhV₀⟩ := hh.exists_isOpen
  set F : Unit → Option μ → X → ℂ := fun _ o => o.elim h s with hFdef
  have hF : ∀ i o, HolAt (F i o) x₀ := by
    intro i o
    cases o with
    | none => exact hh
    | some k => exact holAt_of_differentiableOn hU (hsd k) hx₀U
  obtain ⟨V, hV, hx₀V, ν, _, σ, hσd, hσrel, hσgen⟩ := hX Unit (Option μ) F x₀ hF
  refine ⟨U ∩ V ∩ V₀, (hU.inter hV).inter hV₀, ⟨⟨hx₀U, hx₀V⟩, hx₀V₀⟩, ν, inferInstance,
    fun m => σ m none, fun m => (hσd m none).mono fun x hx => hx.1.2, ?_⟩
  intro y hy g
  have hyU := hy.1.1
  have hyV := hy.1.2
  have hrel : ∀ m, ∀ x ∈ V, σ m none x * h x + ∑ k, σ m (some k) x * s k x = 0 := by
    intro m x hx
    have := hσrel m () x hx
    rwa [Fintype.sum_option] at this
  constructor
  · rintro ⟨hg, hgh⟩
    obtain ⟨-, c, hc, hgc⟩ := (hsI y hyU _).1 hgh
    have ha : IsRelationAt F y fun o => o.elim g fun k x => -c k x := by
      refine ⟨fun o => ?_, fun _ => ?_⟩
      · cases o with
        | none => exact hg
        | some k => exact (hc k).neg
      · filter_upwards [hgc] with x hx
        simp only [hFdef, Fintype.sum_option, Option.elim, neg_mul, Finset.sum_neg_distrib]
        rw [hx]
        ring
    obtain ⟨e, he, hea⟩ := hσgen y hyV _ ha
    exact ⟨hg, e, he, hea none⟩
  · rintro ⟨hg, e, he, hge⟩
    refine ⟨hg, (hsI y hyU _).2 ⟨hg.mul (holAt_of_differentiableOn hV₀ hhV₀ hy.2),
      fun k x => -∑ m, e m x * σ m (some k) x, fun k => (HolAt.fintype_sum fun m =>
        (he m).mul (holAt_of_differentiableOn hV (hσd m (some k)) hyV)).neg, ?_⟩⟩
    filter_upwards [hge, hV.mem_nhds hyV] with x hx hxV
    rw [hx, Finset.sum_mul]
    have : ∀ m, e m x * σ m none x * h x = -∑ k, e m x * σ m (some k) x * s k x := by
      intro m
      have := hrel m x hxV
      rw [Finset.sum_congr rfl fun k _ => mul_assoc (e m x) _ _, ← Finset.mul_sum, mul_assoc,
        eq_neg_iff_add_eq_zero, ← mul_add, this, mul_zero]
    rw [Finset.sum_congr rfl fun m _ => this m, Finset.sum_neg_distrib]
    simp only [neg_mul, Finset.sum_neg_distrib, Finset.sum_mul]
    rw [Finset.sum_comm]

/-- **Intersections.**  If `X` has Oka's property and `I`, `J` are finitely generated near
`x₀`, so is `I ∩ J`. -/
theorem IdealFGAt.inter (hX : OkaProperty X) {I J : X → (X → ℂ) → Prop} {x₀ : X}
    (hI : IdealFGAt I x₀) (hJ : IdealFGAt J x₀) : IdealFGAt (fun y g => I y g ∧ J y g) x₀ := by
  obtain ⟨U, hU, hx₀U, μ, _, s, hsd, hsI⟩ := hI
  obtain ⟨U', hU', hx₀U', μ', _, t, htd, htJ⟩ := hJ
  set F : Unit → μ ⊕ μ' → X → ℂ := fun _ o => Sum.elim s t o with hFdef
  have hF : ∀ i o, HolAt (F i o) x₀ := by
    intro i o
    cases o with
    | inl k => exact holAt_of_differentiableOn hU (hsd k) hx₀U
    | inr l => exact holAt_of_differentiableOn hU' (htd l) hx₀U'
  obtain ⟨V, hV, hx₀V, ν, _, σ, hσd, hσrel, hσgen⟩ := hX Unit (μ ⊕ μ') F x₀ hF
  refine ⟨U ∩ U' ∩ V, (hU.inter hU').inter hV, ⟨⟨hx₀U, hx₀U'⟩, hx₀V⟩, ν, inferInstance,
    fun m x => ∑ k, σ m (Sum.inl k) x * s k x, fun m => ?_, ?_⟩
  · exact DifferentiableOn.fun_sum fun k _ =>
      ((hσd m _).mono fun x hx => hx.2).mul ((hsd k).mono fun x hx => hx.1.1)
  intro y hy g
  have hyU := hy.1.1
  have hyU' := hy.1.2
  have hyV := hy.2
  have hrel : ∀ m, ∀ x ∈ V,
      ∑ k, σ m (Sum.inl k) x * s k x = -∑ l, σ m (Sum.inr l) x * t l x := by
    intro m x hx
    have := hσrel m () x hx
    rw [Fintype.sum_sum_type] at this
    exact eq_neg_of_add_eq_zero_left this
  have hσy : ∀ m o, HolAt (σ m o) y := fun m o => holAt_of_differentiableOn hV (hσd m o) hyV
  have hsy : ∀ k, HolAt (s k) y := fun k => holAt_of_differentiableOn hU (hsd k) hyU
  have hty : ∀ l, HolAt (t l) y := fun l => holAt_of_differentiableOn hU' (htd l) hyU'
  constructor
  · rintro ⟨hIg, hJg⟩
    obtain ⟨hg, a, ha, hga⟩ := (hsI y hyU g).1 hIg
    obtain ⟨-, b, hb, hgb⟩ := (htJ y hyU' g).1 hJg
    have hr : IsRelationAt F y fun o => Sum.elim a (fun l x => -b l x) o := by
      refine ⟨fun o => ?_, fun _ => ?_⟩
      · cases o with
        | inl k => exact ha k
        | inr l => exact (hb l).neg
      · filter_upwards [hga, hgb] with x hxa hxb
        simp only [hFdef, Fintype.sum_sum_type, Sum.elim_inl, Sum.elim_inr, neg_mul,
          Finset.sum_neg_distrib]
        rw [← hxa, ← hxb]
        ring
    obtain ⟨e, he, hea⟩ := hσgen y hyV _ hr
    refine ⟨hg, e, he, ?_⟩
    have hall : ∀ᶠ x in 𝓝 y, ∀ k, a k x = ∑ m, e m x * σ m (Sum.inl k) x :=
      eventually_all.2 fun k => hea (Sum.inl k)
    filter_upwards [hga, hall] with x hx hxa
    rw [hx]
    simp only [hxa, Finset.sum_mul, Finset.mul_sum]
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl fun m _ => Finset.sum_congr rfl fun k _ => by ring
  · rintro ⟨hg, e, he, hge⟩
    refine ⟨(hsI y hyU g).2 ⟨hg, fun k x => ∑ m, e m x * σ m (Sum.inl k) x,
      fun k => HolAt.fintype_sum fun m => (he m).mul (hσy m _), ?_⟩,
      (htJ y hyU' g).2 ⟨hg, fun l x => -∑ m, e m x * σ m (Sum.inr l) x,
      fun l => (HolAt.fintype_sum fun m => (he m).mul (hσy m _)).neg, ?_⟩⟩
    · filter_upwards [hge] with x hx
      rw [hx]
      simp only [Finset.sum_mul, Finset.mul_sum]
      rw [Finset.sum_comm]
      exact Finset.sum_congr rfl fun m _ => Finset.sum_congr rfl fun k _ => by ring
    · filter_upwards [hge, hV.mem_nhds hyV] with x hx hxV
      rw [hx]
      simp only [Finset.mul_sum, hrel _ x hxV, mul_neg, Finset.sum_neg_distrib, neg_mul,
        Finset.sum_mul]
      rw [Finset.sum_comm]
      exact congrArg Neg.neg (Finset.sum_congr rfl fun l _ =>
        Finset.sum_congr rfl fun m _ => by ring)

end Lemmas

end Hironaka.OkaIdealOperations
